### HD_compile
  (REPEAT GEN_TAC THEN
   MP_TAC (SPECL [`m:(mlstring option) list`; `[x:flatLang_exp]`]
     LENGTH_compile) THEN
   SPEC_TAC (`flat_to_clos_compile m [x]`,`l:closLang_exp list`) THEN
   LIST_INDUCT_TAC THEN REWRITE_TAC[LENGTH; NOT_SUC; SUC_INJ;
     LENGTH_EQ_NIL] THEN
   SIMP_TAC[HD])
