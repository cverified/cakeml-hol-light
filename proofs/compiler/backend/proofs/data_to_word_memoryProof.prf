### update_ref_thm
  (* the steps that this proof and the three after it take are
     above the statement (tools/overrides.py).  The roots split
     where the pointer of the reference is, the store writes the
     new values into its element, and the heap and the references
     are then as good as they were; of the reference written the
     invariant is the array of the new values and of any other one
     its element, which the store did not touch *)
  (STRIP_TAC THEN
   (* what the invariant says of the stack with the pointer in it *)
   FIRST_X_ASSUM (fun inv ->
     if not (hd_is "abs_ml_inv" (concl inv)) then fail() else
     STRIP_ASSUME_TAC (REWRITE_RULE[abs_ml_inv_def;
                                    bc_stack_ref_inv_def] inv)) THEN
   (* the roots split where the pointer is *)
   FIRST_ASSUM (fun lr ->
     if not (hd_is "ALL2" (concl lr)) then fail() else
     STRIP_ASSUME_TAC (MATCH_MP EVERY2_APPEND_CONS lr)) THEN
   RULE_ASSUM_TRY (CONV_RULE(TOP_DEPTH_CONV BETA_CONV)) THEN
   (* and the root of the pointer is the address of its reference *)
   FIRST_ASSUM (fun vr ->
     let c = concl vr in
     if not (hd_is "v_inv" c) ||
        not (hd_is "dataSem_RefPtr"
               (el 1 (snd (strip_comb c))))
        then fail()
     else STRIP_ASSUME_TAC (REWRITE_RULE[v_inv_def] vr)) THEN
   RULE_ASSUM_TRY (REWRITE_RULE ref_rws) THEN
   ASM_FS_TAC THEN
   RULE_ASSUM_TRY (REWRITE_RULE ref_rws) THEN
   TRY (FIRST_ASSUM CONTR_TAC) THEN
   SPLIT_ASM_TAC THEN
   (* the reference has an address, and it is reachable, so the
      invariant holds of it *)
   SUBGOAL_THEN (cake_as_vars (fun () ->
     `FLOOKUP (f:(num,num)fmap) (ptr:num) = SOME (FAPPLY f ptr:num)`))
     ASSUME_TAC THENL
    [ASM_REWRITE_TAC[FLOOKUP_DEF]; ALL_TAC] THEN
   SUBGOAL_THEN (cake_as_vars (fun () ->
     `reachable_refs (xs ++ (RefPtr b ptr :: stack)) refs ptr`))
     ASSUME_TAC THENL
    [FIRST
      [SOLVED (MATCH_MP_TAC (GEN_ALL reach_refptr) THEN
               REWRITE_TAC[MEM_APPEND; MEM]);
       SOLVED (MATCH_MP_TAC (GEN_ALL reach_refptr) THEN
               EXISTS_TAC `b:bool` THEN
               REWRITE_TAC[MEM_APPEND; MEM]);
       SOLVED (REWRITE_TAC[reachable_refs_def] THEN
               EXISTS_TAC (cake_as_vars (fun () ->
                 `RefPtr b ptr:dataSem_v`)) THEN
               EXISTS_TAC `ptr:num` THEN
               REWRITE_TAC[MEM_APPEND; MEM; get_refs_def] THEN
               MESON_TAC[RTC_RULES])];
     ALL_TAC] THEN
   FIRST_ASSUM (fun bri ->
     let bd = snd (strip_forall (concl bri)) in
     if not (is_imp bd) || not (hd_is "bc_ref_inv" (rand bd))
     then fail() else MP_TAC (SPEC `ptr:num` bri)) THEN
   (ANTS_TAC THENL
     [CONJ_TAC THEN FIRST_ASSUM ACCEPT_TAC; ALL_TAC]) THEN
   (* which is the arm of a ValueArray *)
   W(fun gl ->
     let lk1 = the_asm (fun c -> is_eq c &&
                 hd_is "FLOOKUP" (lhand c)) gl in
     let lk2 = the_asm (fun c -> is_eq c &&
                 hd_is "sptree_lookup" (lhand c)) gl in
     DISCH_THEN (fun inv ->
       STRIP_ASSUME_TAC
         (REWRITE_RULE[MATCH_MP arm_VA (CONJ lk1 lk2)] inv))) THEN
   (* the lengths of the array, of its values and of their roots *)
   ASSUM_LIST (fun l -> MAP_EVERY ASSUME_TAC
     (mapfilter (MATCH_MP LIST_REL_LENGTH) l)) THEN
   (* the store of the new values into the reference *)
   W(fun gl ->
     let sp = the_asm (fun c -> is_eq c &&
                hd_is "APPEND" (rand c)) gl in
     let t1 = lhand (rand (concl sp)) in
     let hl = the_asm (fun c -> is_eq c &&
                hd_is "heap_lookup" (lhand c) &&
                can (fun t -> hd_is "RefBlock" (rand t)) (rand c)) gl in
     let zs = rand (rand (rand (concl hl))) in
     SUBGOAL_THEN (mk_eq (list_mk_icomb "LENGTH" [zs],
                          list_mk_icomb "LENGTH" [t1]))
       (fun le -> STRIP_ASSUME_TAC
         (MATCH_MP heap_store_RefBlock (CONJ le hl)) THEN
         ASSUME_TAC le THEN ASSUME_TAC (SYM le)) THENL
      [POP_ASSUM_LIST (fun l -> MAP_EVERY ASSUME_TAC (filter
         (fun t -> let c = concl t in
            is_eq c && (hd_is "LENGTH" (lhand c) ||
                        hd_is "LENGTH" (rand c))) l)) THEN
       ASM_ARITH_TAC;
       ALL_TAC]) THEN
   (* the witnesses: the address of the reference, the roots of the
      new values, the rest of the roots and the new heap *)
   W(fun gl ->
     let sp = the_asm (fun c -> is_eq c &&
                hd_is "APPEND" (rand c)) gl in
     let t1 = lhand (rand (concl sp)) in
     let t2 = rand (rand (rand (concl sp))) in
     let pt = the_asm (fun c -> is_eq c &&
                hd_is "gc_shared_Pointer" (rand c)) gl in
     let p = lhand (rand (concl pt)) in
     let u = rand (rand (concl pt)) in
     let st = the_asm (fun c -> is_eq c &&
                hd_is "heap_store" (lhand c)) gl in
     let h2 = lhand (rand (concl st)) in
     MAP_EVERY EXISTS_TAC [p; t1; t2; h2; u]) THEN
   REPEAT CONJ_TAC THEN
   TRY (SOLVED (ASM_REWRITE_TAC[])) THEN
   (* and the invariant of the new heap and references *)
   REWRITE_TAC[abs_ml_inv_def; bc_stack_ref_inv_def] THEN
   REPEAT CONJ_TAC THEN TRY (SOLVED (ASM_REWRITE_TAC[])) THEN
   (* the roots and the heap are as good as they were *)
   (* the roots are the ones of the split *)
   W(fun gl ->
     let sp = the_asm (fun c -> is_eq c &&
                hd_is "APPEND" (rand c)) gl in
     ONCE_REWRITE_TAC[sp]) THEN
   TRY (SOLVED
         (W(fun gl ->
            let iso = the_asm (fun c ->
              let bd = snd (strip_forall c) in
              is_eq bd && hd_is "isSomeDataElement" (lhand bd)) gl in
            let ro = the_asm (hd_is "roots_ok") gl in
            ACCEPT_TAC (MATCH_MP roots_ok_iso (CONJ ro iso))))) THEN
   TRY (SOLVED
         (W(fun gl ->
            let sp = the_asm (fun c -> is_eq c &&
                       hd_is "APPEND" (rand c)) gl in
            let iso = the_asm (fun c ->
              let bd = snd (strip_forall c) in
              is_eq bd && hd_is "isSomeDataElement" (lhand bd)) gl in
            let ro = REWRITE_RULE[sp] (the_asm (hd_is "roots_ok") gl) in
            let ho = the_asm (hd_is "heap_ok") gl in
            let hlen = the_asm (fun c -> is_eq c &&
                         hd_is "heap_length" (lhand c)) gl in
            let flt = the_asm (fun c -> is_eq c &&
                        hd_is "FILTER" (lhand c)) gl in
            let mm = the_asm (fun c ->
              let bd = snd (strip_forall c) in
              is_imp bd && is_disj (rand bd)) gl in
            ACCEPT_TAC (MATCH_MP heap_ok_store_ref
              (CONJ ho (CONJ ro (CONJ iso (CONJ hlen
                (CONJ flt mm))))))))) THEN
   (* and the unused space is where it was *)
   TRY (SOLVED
         (W(fun gl ->
            let us = the_asm (hd_is "unused_space_inv") gl in
            let ri = the_asm (hd_is "RefBlock_inv") gl in
            let hlen = the_asm (fun c -> is_eq c &&
                         hd_is "heap_length" (lhand c)) gl in
            let st = the_asm (fun c -> is_eq c &&
                       hd_is "heap_store" (lhand c)) gl in
            ACCEPT_TAC (MATCH_MP unused_store_ref
              (CONJ us (CONJ ri (CONJ hlen st))))))) THEN
   (* the kind of the collection: the store is above the nursery and
      writes a reference where one was (gc_kind_store_ref) *)
   TRY (SOLVED
         (W(fun gl ->
            let gk = the_asm (hd_is "gc_kind_inv") gl in
            let st = the_asm (fun c -> is_eq c &&
                       hd_is "heap_store" (lhand c)) gl in
            let hl = the_asm (fun c -> is_eq c &&
                       hd_is "heap_lookup" (lhand c) &&
                       can (fun t -> hd_is "RefBlock" (rand t))
                         (rand c) &&
                       el 1 (snd (strip_comb (lhand c))) =
                         el 2 (snd (strip_comb
                                  (lhand (concl st))))) gl in
            let zs = rand (rand (rand (concl hl))) in
            let len = the_asm (fun c -> is_eq c &&
                        hd_is "LENGTH" (lhand c) &&
                        rand c = list_mk_icomb "LENGTH" [zs]) gl in
            MATCH_ACCEPT_TAC (MATCH_MP gc_kind_store_ref
              (CONJ gk (CONJ st (CONJ hl len))))))) THEN
   (* the maps of the new invariant: the addresses are the ones they
      were, and the timestamps are cut to the ones of the new
      references and stack *)
   W(fun (asl,w as gl) ->
     if not (is_exists w) then ALL_TAC else
     (let sub p = rand (lhand (concl (the_asm (fun c ->
        hd_is "SUBSET" c && hd_is p (rand c)) gl))) in
      let ats = find_term (hd_is "all_ts") w in
      EXISTS_TAC (sub "domain") THEN
      EXISTS_TAC (list_mk_icomb "DRESTRICT" [sub "all_ts"; ats]))) THEN
   REPEAT CONJ_TAC THEN TRY (SOLVED (FIRST_ASSUM ACCEPT_TAC)) THEN
   (* the addresses of the maps are the ones of the old heap *)
   TRY (SOLVED
         (W(fun gl ->
            let iso = the_asm (fun c ->
              let bd = snd (strip_forall c) in
              is_eq bd && hd_is "isSomeDataElement" (lhand bd)) gl in
            ONCE_REWRITE_TAC[iso]) THEN
          FIRST [SOLVED (FIRST_ASSUM ACCEPT_TAC);
                 SOLVED (W(fun (asl,w as gl) ->
                   let dr = find_term (hd_is "DRESTRICT") w in
                   let inj = the_asm (fun c -> hd_is "INJ" c &&
                     rand (el 0 (snd (strip_comb c))) = lhand dr) gl in
                   MATCH_ACCEPT_TAC
                     (MATCH_MP INJ_DRESTRICT inj)))])) THEN
   (* the domain of the references has the key in it *)
   TRY (SOLVED
         (REWRITE_TAC[domain_insert] THEN
          MATCH_MP_TAC SUBSET_TRANS THEN
          W(fun gl ->
            let su = the_asm (fun c -> hd_is "SUBSET" c &&
                       hd_is "domain" (rand c)) gl in
            EXISTS_TAC (rand (concl su))) THEN
          CONJ_TAC THEN TRY (FIRST_ASSUM ACCEPT_TAC) THEN
          SET_TAC[])) THEN
   (* the timestamps of the restricted map are of the stack, and
      below the counter *)
   TRY (SOLVED
         (REWRITE_TAC[(CONJUNCT1 o SPEC_ALL) DRESTRICT_DEF] THEN
          FIRST [SOLVED (REWRITE_TAC[INTER_SUBSET]);
                 SOLVED (MATCH_MP_TAC SUBSET_TRANS THEN
                         W(fun gl ->
                           let su = the_asm (fun c ->
                             hd_is "SUBSET" c &&
                             hd_is "FDOM" (lhand c)) gl in
                           EXISTS_TAC (lhand (concl su))) THEN
                         CONJ_TAC THEN
                         TRY (FIRST_ASSUM ACCEPT_TAC) THEN
                         REWRITE_TAC[INTER_SUBSET])])) THEN
   (* the blocks of the stack stay unique *)
   TRY (SOLVED
         (W(fun gl ->
            let bu = the_asm (hd_is "blocks_unique") gl in
            ACCEPT_TAC (MATCH_MP blocks_unique_update_ref bu)))) THEN
   (* the values of the stack: the update of the reference and the
      cut of the timestamps leave what the invariant says of them
      (v_inv_update_ref) *)
   W(fun (asl,w) -> if not (hd_is "ALL2" w) then ALL_TAC else
         (MATCH_MP_TAC EVERY2_MEM_MONO THEN
          W(fun (asl,w as gl) ->
            let bod = snd (strip_exists w) in
            let l1 = el 1 (snd (strip_comb (last (conjuncts bod)))) in
            let old = the_asm (fun c -> hd_is "ALL2" c &&
                        el 1 (snd (strip_comb c)) = l1) gl in
            EXISTS_TAC (el 0 (snd (strip_comb (concl old))))) THEN
          CONJ_TAC THENL
           [REPEAT GEN_TAC THEN
            CONV_TAC(TOP_DEPTH_CONV BETA_CONV) THEN
            STRIP_TAC THEN
            W(fun (asl,w as gl) ->
              let gargs = snd (strip_comb w) in
              let x = el 1 gargs in
              let y = el 0 (tparts (el 3 gargs)) in
              let vi = the_asm (fun c -> hd_is "v_inv" c &&
                         el 1 (snd (strip_comb c)) = x &&
                         el 0 (tparts (el 3 (snd (strip_comb c))))
                           = y) gl in
              let ri = the_asm (hd_is "RefBlock_inv") gl in
              let lk = the_asm (fun c -> is_eq c &&
                         hd_is "sptree_lookup" (lhand c)) gl in
              let mz = the_asm (fun c -> hd_is "MEM" c &&
                         hd_is "ZIP" (rand c)) gl in
              let l1 = el 0 (snd (strip_comb (rand (concl mz)))) in
              let le = the_asm (fun c -> is_eq c &&
                         lhand c = list_mk_icomb "LENGTH" [l1]) gl in
              MATCH_ACCEPT_TAC (MATCH_MP v_inv_update_ref
                (CONJ ri (CONJ lk (CONJ vi
                  (MATCH_MP mem_zip_left (CONJ le mz)))))));
            FIRST_ASSUM ACCEPT_TAC])) THEN
   (* and the invariant of each reference that the stack reaches:
      it was reachable before the update (reachable_refs_UPDATE) *)
   W(fun (asl,w) -> if not (is_forall w) then ALL_TAC else
     (REPEAT STRIP_TAC THEN
      FIRST_X_ASSUM (fun rr ->
        if not (hd_is "reachable_refs" (concl rr)) then fail() else
        ASSUME_TAC (MATCH_MP reachable_refs_UPDATE rr)) THEN
      (* what the old invariant says of it *)
      W(fun (asl,w as gl) ->
        let n = el 1 (snd (strip_comb w)) in
        let bri = the_asm (fun c ->
          let vs,bd = strip_forall c in
          length vs = 1 && is_imp bd &&
          hd_is "bc_ref_inv" (rand bd)) gl in
        let rr = the_asm (fun c -> hd_is "reachable_refs" c &&
          not (hd_is "sptree_insert"
                 (el 1 (snd (strip_comb c))))) gl in
        let nin = the_asm (fun c -> hd_is "IN" c &&
          hd_is "FDOM" (rand c) &&
          el 0 (snd (strip_comb c)) = n) gl in
        ASSUME_TAC (MP (SPEC n bri) (CONJ rr nin))) THEN
      (* the reference written, or another one *)
      W(fun (asl,w as gl) ->
        ASM_CASES_TAC (mk_eq (el 1 (snd (strip_comb w)),
                              g_ptr gl))) THEN
      TRY VAR_EQ_TAC THEN
      (* the one written: its values are the new ones
         (bc_ref_inv_update_ref_at) *)
      TRY (SOLVED
            (W(fun gl ->
               let lk1 = the_asm (fun c -> is_eq c &&
                           hd_is "FLOOKUP" (lhand c)) gl in
               let hl2 = a_hlnew gl in
               let rs = rand (rand (rand (concl hl2))) in
               let ev = CONV_RULE(TOP_DEPTH_CONV BETA_CONV)
                          (MATCH_MP EVERY2_SWAP
                            (the_asm (fun c -> hd_is "ALL2" c &&
                               el 2 (snd (strip_comb c)) = rs) gl)) in
               MATCH_ACCEPT_TAC (MATCH_MP bc_ref_inv_update_ref_at
                 (CONJ (a_ri gl) (CONJ lk1 (CONJ hl2
                   (CONJ (a_lkptr gl) ev)))))))) THEN
      (* another one: its element did not move, because the store
         only touched the address of the one written
         (bc_ref_inv_update_ref_other) *)
      TRY (SOLVED
            (W(fun (asl,w as gl) ->
               let fm = el 0 (tparts (el 3 (snd (strip_comb w)))) in
               let inj = the_asm (fun c -> hd_is "INJ" c &&
                           rand (el 0 (snd (strip_comb c))) = fm) gl in
               let pin = the_asm (fun c -> hd_is "IN" c &&
                           hd_is "FDOM" (rand c) &&
                           el 0 (snd (strip_comb c)) = g_ptr gl) gl in
               let neq = the_asm (fun c -> is_neg c && is_eq (rand c) &&
                           rand (rand c) = g_ptr gl) gl in
               let inv = the_asm (fun c -> hd_is "bc_ref_inv" c) gl in
               MATCH_ACCEPT_TAC (MATCH_MP bc_ref_inv_update_ref_other
                 (CONJ inj (CONJ pin (CONJ neq (CONJ (a_ri gl)
                   (CONJ (a_tr gl) (CONJ (a_lkptr gl) inv)))))))))) THEN
      ALL_TAC)))
### update_ref_thm1
  (* the steps are above the statement and above update_ref_thm
     (tools/overrides.py).  The proof is the one of update_ref_thm
     with the store of one value in place of the store of the whole
     array: the element keeps its values but the one written, whose
     root is the head of the roots of the stack's values, and the
     array of the new references keeps its values but that one *)
  (STRIP_TAC THEN
   (* what the invariant says of the stack with the pointer in it *)
   FIRST_X_ASSUM (fun inv ->
     if not (hd_is "abs_ml_inv" (concl inv)) then fail() else
     STRIP_ASSUME_TAC (REWRITE_RULE[abs_ml_inv_def;
                                    bc_stack_ref_inv_def] inv)) THEN
   (* the roots split where the pointer is *)
   FIRST_ASSUM (fun lr ->
     if not (hd_is "ALL2" (concl lr)) then fail() else
     STRIP_ASSUME_TAC (MATCH_MP EVERY2_APPEND_CONS lr)) THEN
   RULE_ASSUM_TRY (CONV_RULE(TOP_DEPTH_CONV BETA_CONV)) THEN
   (* and the root of the pointer is the address of its reference *)
   FIRST_ASSUM (fun vr ->
     let c = concl vr in
     if not (hd_is "v_inv" c) ||
        not (hd_is "dataSem_RefPtr"
               (el 1 (snd (strip_comb c))))
        then fail()
     else STRIP_ASSUME_TAC (REWRITE_RULE[v_inv_def] vr)) THEN
   RULE_ASSUM_TRY (REWRITE_RULE ref_rws) THEN
   ASM_FS_TAC THEN
   RULE_ASSUM_TRY (REWRITE_RULE ref_rws) THEN
   TRY (FIRST_ASSUM CONTR_TAC) THEN
   SPLIT_ASM_TAC THEN
   (* the reference has an address, and it is reachable, so the
      invariant holds of it *)
   SUBGOAL_THEN (cake_as_vars (fun () ->
     `FLOOKUP (f:(num,num)fmap) (ptr:num) = SOME (FAPPLY f ptr:num)`))
     ASSUME_TAC THENL
    [ASM_REWRITE_TAC[FLOOKUP_DEF]; ALL_TAC] THEN
   SUBGOAL_THEN (cake_as_vars (fun () ->
     `reachable_refs (xs ++ (RefPtr b ptr :: stack)) refs ptr`))
     ASSUME_TAC THENL
    [FIRST
      [SOLVED (MATCH_MP_TAC (GEN_ALL reach_refptr) THEN
               REWRITE_TAC[MEM_APPEND; MEM]);
       SOLVED (MATCH_MP_TAC (GEN_ALL reach_refptr) THEN
               EXISTS_TAC `b:bool` THEN
               REWRITE_TAC[MEM_APPEND; MEM]);
       SOLVED (REWRITE_TAC[reachable_refs_def] THEN
               EXISTS_TAC (cake_as_vars (fun () ->
                 `RefPtr b ptr:dataSem_v`)) THEN
               EXISTS_TAC `ptr:num` THEN
               REWRITE_TAC[MEM_APPEND; MEM; get_refs_def] THEN
               MESON_TAC[RTC_RULES])];
     ALL_TAC] THEN
   FIRST_ASSUM (fun bri ->
     let bd = snd (strip_forall (concl bri)) in
     if not (is_imp bd) || not (hd_is "bc_ref_inv" (rand bd))
     then fail() else MP_TAC (SPEC `ptr:num` bri)) THEN
   (ANTS_TAC THENL
     [CONJ_TAC THEN FIRST_ASSUM ACCEPT_TAC; ALL_TAC]) THEN
   (* which is the arm of a ValueArray *)
   W(fun gl ->
     let lk1 = the_asm (fun c -> is_eq c &&
                 hd_is "FLOOKUP" (lhand c)) gl in
     let lk2 = the_asm (fun c -> is_eq c &&
                 hd_is "sptree_lookup" (lhand c)) gl in
     DISCH_THEN (fun inv ->
       STRIP_ASSUME_TAC
         (REWRITE_RULE[MATCH_MP arm_VA (CONJ lk1 lk2)] inv))) THEN
   (* the lengths of the array, of its values and of their roots *)
   ASSUM_LIST (fun l -> MAP_EVERY ASSUME_TAC
     (mapfilter (MATCH_MP LIST_REL_LENGTH) l)) THEN
   (* the roots of the stack's values are not empty either *)
   W(fun gl ->
     let sp = the_asm (fun c -> is_eq c &&
                hd_is "APPEND" (rand c)) gl in
     let t1 = lhand (rand (concl sp)) in
     SUBGOAL_THEN (list_mk_icomb "<"
                     [`0`; list_mk_icomb "LENGTH" [t1]])
       ASSUME_TAC THENL
      [POP_ASSUM_LIST (fun l -> MAP_EVERY ASSUME_TAC (filter
         (fun t -> let c = concl t in
            (is_eq c && (hd_is "LENGTH" (lhand c) ||
                         hd_is "LENGTH" (rand c))) ||
            hd_is "<" c) l)) THEN
       ASM_ARITH_TAC;
       ALL_TAC]) THEN
   (* the store of the new value into its place in the element *)
   W(fun (asl,w as gl) ->
     let sp = the_asm (fun c -> is_eq c &&
                hd_is "APPEND" (rand c)) gl in
     let t1 = lhand (rand (concl sp)) in
     let hl = the_asm (fun c -> is_eq c &&
                hd_is "heap_lookup" (lhand c) &&
                can (fun t -> hd_is "RefBlock" (rand t)) (rand c)) gl in
     let zs = rand (rand (rand (concl hl))) in
     let i = el 1 (snd (strip_comb
               (find_term (hd_is "LUPDATE") w))) in
     let ws = list_mk_icomb "LUPDATE"
                [list_mk_icomb "HD" [t1]; i; zs] in
     SUBGOAL_THEN (mk_eq (list_mk_icomb "LENGTH" [zs],
                          list_mk_icomb "LENGTH" [ws]))
       (fun le -> STRIP_ASSUME_TAC
         (MATCH_MP heap_store_RefBlock (CONJ le hl)) THEN
         ASSUME_TAC le THEN ASSUME_TAC (SYM le)) THENL
      [REWRITE_TAC[LENGTH_LUPDATE];
       ALL_TAC]) THEN
   (* the witnesses: the address of the reference, the roots of the
      new values, the rest of the roots and the new heap *)
   W(fun gl ->
     let sp = the_asm (fun c -> is_eq c &&
                hd_is "APPEND" (rand c)) gl in
     let t1 = lhand (rand (concl sp)) in
     let t2 = rand (rand (rand (concl sp))) in
     let pt = the_asm (fun c -> is_eq c &&
                hd_is "gc_shared_Pointer" (rand c)) gl in
     let p = lhand (rand (concl pt)) in
     let u = rand (rand (concl pt)) in
     let st = the_asm (fun c -> is_eq c &&
                hd_is "heap_store" (lhand c)) gl in
     let h2 = lhand (rand (concl st)) in
     let zs = rand (rand (rand (concl (a_hlold gl)))) in
     MAP_EVERY EXISTS_TAC [p; t1; t2; zs; h2; u]) THEN
   REPEAT CONJ_TAC THEN
   TRY (SOLVED (FIRST_ASSUM ACCEPT_TAC)) THEN
   TRY (SOLVED (ASM_REWRITE_TAC[])) THEN
   (* the values of the element are the ones the heap holds there *)
   TRY (SOLVED
         (W(fun gl ->
            REWRITE_TAC[heap_deref_def; a_hlold gl; RefBlock_def]) THEN
          MATCH_REDUCE_TAC THEN REWRITE_TAC[])) THEN
   (* and the invariant of the new heap and references *)
   REWRITE_TAC[abs_ml_inv_def; bc_stack_ref_inv_def] THEN
   REPEAT CONJ_TAC THEN
   TRY (SOLVED (FIRST_ASSUM ACCEPT_TAC)) THEN
   TRY (SOLVED (ASM_REWRITE_TAC[])) THEN
   (* the roots and the heap are as good as they were *)
   (* the roots are the ones of the split *)
   W(fun gl ->
     let sp = the_asm (fun c -> is_eq c &&
                hd_is "APPEND" (rand c)) gl in
     ONCE_REWRITE_TAC[sp]) THEN
   TRY (SOLVED
         (W(fun gl ->
            let iso = the_asm (fun c ->
              let bd = snd (strip_forall c) in
              is_eq bd && hd_is "isSomeDataElement" (lhand bd)) gl in
            let ro = the_asm (hd_is "roots_ok") gl in
            ACCEPT_TAC (MATCH_MP roots_ok_iso (CONJ ro iso))))) THEN
   TRY (SOLVED
         (W(fun gl ->
            let sp = the_asm (fun c -> is_eq c &&
                       hd_is "APPEND" (rand c)) gl in
            let iso = the_asm (fun c ->
              let bd = snd (strip_forall c) in
              is_eq bd && hd_is "isSomeDataElement" (lhand bd)) gl in
            let ro = REWRITE_RULE[sp] (the_asm (hd_is "roots_ok") gl) in
            let ho = the_asm (hd_is "heap_ok") gl in
            let hlen = the_asm (fun c -> is_eq c &&
                         hd_is "heap_length" (lhand c)) gl in
            let flt = the_asm (fun c -> is_eq c &&
                        hd_is "FILTER" (lhand c)) gl in
            let mm = the_asm (fun c ->
              let bd = snd (strip_forall c) in
              is_imp bd && is_disj (rand bd)) gl in
            let rs = lhand (el 0 (snd (strip_comb (concl ro)))) in
            let i = el 1 (snd (strip_comb (find_term
                      (hd_is "LUPDATE") (concl mm)))) in
            let pw = INST [i,`i:num`]
                       (MATCH_MP ptrs_store_LUPDATE
                         (CONJ ho (CONJ ro (CONJ (a_pos rs gl)
                           (a_hlold gl))))) in
            ACCEPT_TAC (MATCH_MP heap_ok_store_ws
              (CONJ ho (CONJ pw (CONJ iso (CONJ hlen
                (CONJ flt mm))))))))) THEN
   (* and the unused space is where it was *)
   TRY (SOLVED
         (W(fun gl ->
            let us = the_asm (hd_is "unused_space_inv") gl in
            let ri = the_asm (hd_is "RefBlock_inv") gl in
            let hlen = the_asm (fun c -> is_eq c &&
                         hd_is "heap_length" (lhand c)) gl in
            let st = the_asm (fun c -> is_eq c &&
                       hd_is "heap_store" (lhand c)) gl in
            ACCEPT_TAC (MATCH_MP unused_store_ref
              (CONJ us (CONJ ri (CONJ hlen st))))))) THEN
   (* the kind of the collection: the store is above the nursery and
      writes a reference where one was (gc_kind_store_ref) *)
   TRY (SOLVED
         (W(fun gl ->
            let gk = the_asm (hd_is "gc_kind_inv") gl in
            let st = the_asm (fun c -> is_eq c &&
                       hd_is "heap_store" (lhand c)) gl in
            let hl = the_asm (fun c -> is_eq c &&
                       hd_is "heap_lookup" (lhand c) &&
                       can (fun t -> hd_is "RefBlock" (rand t))
                         (rand c) &&
                       el 1 (snd (strip_comb (lhand c))) =
                         el 2 (snd (strip_comb
                                  (lhand (concl st))))) gl in
            let zs = rand (rand (rand (concl hl))) in
            let len = the_asm (fun c -> is_eq c &&
                        hd_is "LENGTH" (lhand c) &&
                        rand c = list_mk_icomb "LENGTH" [zs]) gl in
            MATCH_ACCEPT_TAC (MATCH_MP gc_kind_store_ref
              (CONJ gk (CONJ st (CONJ hl len))))))) THEN
   (* the maps of the new invariant: the addresses are the ones they
      were, and the timestamps are cut to the ones of the new
      references and stack *)
   W(fun (asl,w as gl) ->
     if not (is_exists w) then ALL_TAC else
     (let sub p = rand (lhand (concl (the_asm (fun c ->
        hd_is "SUBSET" c && hd_is p (rand c)) gl))) in
      let ats = find_term (hd_is "all_ts") w in
      EXISTS_TAC (sub "domain") THEN
      EXISTS_TAC (list_mk_icomb "DRESTRICT" [sub "all_ts"; ats]))) THEN
   REPEAT CONJ_TAC THEN TRY (SOLVED (FIRST_ASSUM ACCEPT_TAC)) THEN
   (* the addresses of the maps are the ones of the old heap *)
   TRY (SOLVED
         (W(fun gl ->
            let iso = the_asm (fun c ->
              let bd = snd (strip_forall c) in
              is_eq bd && hd_is "isSomeDataElement" (lhand bd)) gl in
            ONCE_REWRITE_TAC[iso]) THEN
          FIRST [SOLVED (FIRST_ASSUM ACCEPT_TAC);
                 SOLVED (W(fun (asl,w as gl) ->
                   let dr = find_term (hd_is "DRESTRICT") w in
                   let inj = the_asm (fun c -> hd_is "INJ" c &&
                     rand (el 0 (snd (strip_comb c))) = lhand dr) gl in
                   MATCH_ACCEPT_TAC
                     (MATCH_MP INJ_DRESTRICT inj)))])) THEN
   (* the domain of the references has the key in it *)
   TRY (SOLVED
         (REWRITE_TAC[domain_insert] THEN
          MATCH_MP_TAC SUBSET_TRANS THEN
          W(fun gl ->
            let su = the_asm (fun c -> hd_is "SUBSET" c &&
                       hd_is "domain" (rand c)) gl in
            EXISTS_TAC (rand (concl su))) THEN
          CONJ_TAC THEN TRY (FIRST_ASSUM ACCEPT_TAC) THEN
          SET_TAC[])) THEN
   (* the timestamps of the restricted map are of the stack, and
      below the counter *)
   TRY (SOLVED
         (REWRITE_TAC[(CONJUNCT1 o SPEC_ALL) DRESTRICT_DEF] THEN
          FIRST [SOLVED (REWRITE_TAC[INTER_SUBSET]);
                 SOLVED (MATCH_MP_TAC SUBSET_TRANS THEN
                         W(fun gl ->
                           let su = the_asm (fun c ->
                             hd_is "SUBSET" c &&
                             hd_is "FDOM" (lhand c)) gl in
                           EXISTS_TAC (lhand (concl su))) THEN
                         CONJ_TAC THEN
                         TRY (FIRST_ASSUM ACCEPT_TAC) THEN
                         REWRITE_TAC[INTER_SUBSET])])) THEN
   (* the blocks of the stack stay unique *)
   TRY (SOLVED
         (W(fun (asl,w as gl) ->
            let bu = the_asm (hd_is "blocks_unique") gl in
            let le = a_pos (rand (el 0 (snd (strip_comb
                       (find_term (hd_is "LUPDATE") w))))) gl in
            ACCEPT_TAC (MATCH_MP blocks_unique_update_ref1
              (CONJ le (CONJ (a_lkptr gl) bu)))))) THEN
   (* the values of the stack: the update of the reference and the
      cut of the timestamps leave what the invariant says of them
      (v_inv_update_ref) *)
   W(fun (asl,w) -> if not (hd_is "ALL2" w) then ALL_TAC else
         (MATCH_MP_TAC EVERY2_MEM_MONO THEN
          W(fun (asl,w as gl) ->
            let bod = snd (strip_exists w) in
            let l1 = el 1 (snd (strip_comb (last (conjuncts bod)))) in
            let old = the_asm (fun c -> hd_is "ALL2" c &&
                        el 1 (snd (strip_comb c)) = l1) gl in
            EXISTS_TAC (el 0 (snd (strip_comb (concl old))))) THEN
          CONJ_TAC THENL
           [REPEAT GEN_TAC THEN
            CONV_TAC(TOP_DEPTH_CONV BETA_CONV) THEN
            STRIP_TAC THEN
            W(fun (asl,w as gl) ->
              let gargs = snd (strip_comb w) in
              let x = el 1 gargs in
              let y = el 0 (tparts (el 3 gargs)) in
              let vi = the_asm (fun c -> hd_is "v_inv" c &&
                         el 1 (snd (strip_comb c)) = x &&
                         el 0 (tparts (el 3 (snd (strip_comb c))))
                           = y) gl in
              let ri = the_asm (hd_is "RefBlock_inv") gl in
              let lk = the_asm (fun c -> is_eq c &&
                         hd_is "sptree_lookup" (lhand c)) gl in
              let mz = the_asm (fun c -> hd_is "MEM" c &&
                         hd_is "ZIP" (rand c)) gl in
              let l1 = el 0 (snd (strip_comb (rand (concl mz)))) in
              let le = the_asm (fun c -> is_eq c &&
                         lhand c = list_mk_icomb "LENGTH" [l1]) gl in
              MATCH_ACCEPT_TAC (MATCH_MP v_inv_update_ref
                (CONJ ri (CONJ lk (CONJ vi
                  (MATCH_MP mem_zip_left (CONJ le mz)))))));
            FIRST_ASSUM ACCEPT_TAC])) THEN
   (* and the invariant of each reference that the stack reaches:
      it was reachable before the update (reachable_refs_UPDATE) *)
   W(fun (asl,w) -> if not (is_forall w) then ALL_TAC else
     (REPEAT STRIP_TAC THEN
      W(fun gl ->
        let rr = the_asm (fun c -> hd_is "reachable_refs" c &&
                   hd_is "sptree_insert"
                     (el 1 (snd (strip_comb c)))) gl in
        let le = a_pos (rand (el 0 (snd (strip_comb (find_term
                   (hd_is "LUPDATE") (concl rr)))))) gl in
        ASSUME_TAC (MATCH_MP reach_refs_update_ref1
          (CONJ rr (CONJ (a_lkptr gl) le)))) THEN
      (* what the old invariant says of it *)
      W(fun (asl,w as gl) ->
        let n = el 1 (snd (strip_comb w)) in
        let bri = the_asm (fun c ->
          let vs,bd = strip_forall c in
          length vs = 1 && is_imp bd &&
          hd_is "bc_ref_inv" (rand bd)) gl in
        let rr = the_asm (fun c -> hd_is "reachable_refs" c &&
          not (hd_is "sptree_insert"
                 (el 1 (snd (strip_comb c))))) gl in
        let nin = the_asm (fun c -> hd_is "IN" c &&
          hd_is "FDOM" (rand c) &&
          el 0 (snd (strip_comb c)) = n) gl in
        ASSUME_TAC (MP (SPEC n bri) (CONJ rr nin))) THEN
      (* the reference written, or another one *)
      W(fun (asl,w as gl) ->
        ASM_CASES_TAC (mk_eq (el 1 (snd (strip_comb w)),
                              g_ptr gl))) THEN
      TRY VAR_EQ_TAC THEN
      (* the one written: its values are the new ones
         (bc_ref_inv_update_ref_at) *)
      TRY (SOLVED
            (W(fun gl ->
               let lk1 = the_asm (fun c -> is_eq c &&
                           hd_is "FLOOKUP" (lhand c)) gl in
               let hl2 = a_hlnew gl in
               let largs = snd (strip_comb
                             (rand (rand (rand (concl hl2))))) in
               let t1 = rand (el 0 largs) in
               let zs = el 2 largs in
               let old = the_asm (fun c -> hd_is "ALL2" c &&
                           el 1 (snd (strip_comb c)) = zs) gl in
               let spl = the_asm (fun c -> hd_is "ALL2" c &&
                           el 2 (snd (strip_comb c)) = t1) gl in
               let ev = CONV_RULE(TOP_DEPTH_CONV BETA_CONV)
                          (MATCH_MP EVERY2_HD
                            (CONJ spl (a_pos
                               (el 1 (snd (strip_comb (concl spl))))
                               gl))) in
               MATCH_ACCEPT_TAC (MATCH_MP bc_ref_inv_update_ref_at1
                 (CONJ (a_ri gl) (CONJ lk1 (CONJ hl2
                   (CONJ (a_lkptr gl) (CONJ old ev))))))))) THEN
      (* another one: its element did not move, because the store
         only touched the address of the one written
         (bc_ref_inv_update_ref_other) *)
      TRY (SOLVED
            (W(fun (asl,w as gl) ->
               let fm = el 0 (tparts (el 3 (snd (strip_comb w)))) in
               let inj = the_asm (fun c -> hd_is "INJ" c &&
                           rand (el 0 (snd (strip_comb c))) = fm) gl in
               let pin = the_asm (fun c -> hd_is "IN" c &&
                           hd_is "FDOM" (rand c) &&
                           el 0 (snd (strip_comb c)) = g_ptr gl) gl in
               let neq = the_asm (fun c -> is_neg c && is_eq (rand c) &&
                           rand (rand c) = g_ptr gl) gl in
               let inv = the_asm (fun c -> hd_is "bc_ref_inv" c) gl in
               MATCH_ACCEPT_TAC (MATCH_MP bc_ref_inv_update_ref_other
                 (CONJ inj (CONJ pin (CONJ neq (CONJ (a_ri gl)
                   (CONJ (a_tr gl) (CONJ (a_lkptr gl) inv)))))))))) THEN
      ALL_TAC)))
### update_thunk_thm
  (* the steps are above the statement and above update_ref_thm
     (tools/overrides.py).  The two roots in front of the rest are
     the root of the value and the address of the reference, which
     the relation of the pointer gives together with the thunk in
     the heap and the relation of its value; the store writes the
     new thunk into that element, and the heap and the references
     are then as good as they were.  Of the reference written the
     invariant is the thunk stored and of any other one its
     element, which the store did not touch *)
  (STRIP_TAC THEN
    (* what the invariant says of the stack with the thunk and the
       pointer on it *)
    FIRST_X_ASSUM (fun inv ->
      if not (hd_is "abs_ml_inv" (concl inv)) then fail() else
      STRIP_ASSUME_TAC (REWRITE_RULE[abs_ml_inv_def;
                                     bc_stack_ref_inv_def] inv)) THEN
    (* the roots are the two of the values in front and the rest *)
    SPLIT_ROOTS_TAC THEN SPLIT_ROOTS_TAC THEN
    (* and the root of the pointer is the address of its reference *)
    FIRST_ASSUM (fun vr ->
      let c = concl vr in
      if not (hd_is "v_inv" c) ||
         not (hd_is "dataSem_RefPtr" (el 1 (snd (strip_comb c))))
      then fail()
      else STRIP_ASSUME_TAC (REWRITE_RULE[v_inv_def] vr)) THEN
    (* of the three ways a pointer is related -- the reference is no
       thunk, it is one and the root is its address, or it is an
       evaluated one and the root is its value's -- only the second
       is left, because the reference holds a thunk that was not
       evaluated *)
    (let rws = distinctness "thunk_mode" :: ref_rws in
     RULE_ASSUM_TRY (REWRITE_RULE rws) THEN
     TRY (FIRST_ASSUM CONTR_TAC) THEN
     (* the reference is a thunk, so the first way is out *)
     TRY (SOLVED
           (W(fun gl ->
              let nt = the_asm (fun c ->
                         length (fst (strip_forall c)) = 2 &&
                         is_neg (snd (strip_forall c))) gl in
              let lk = the_asm (fun c -> is_eq c &&
                         hd_is "sptree_lookup" (lhand c) &&
                         hd_is "SOME" (rand c)) gl in
              let args = snd (strip_comb (rand (rand (concl lk)))) in
              CONTR_TAC (MP (NOT_ELIM
                (SPECL [el 0 args; el 1 args] nt)) lk)))) THEN
     (* and the two lookups of the key agree, which leaves the
        second way and puts the third out *)
     TRY (W(fun (asl,_) ->
       let lks = mapfilter (fun (_,th) ->
                   let c = concl th in
                   if is_eq c && hd_is "sptree_lookup" (lhand c) &&
                      hd_is "SOME" (rand c) then th else fail()) asl in
       if length lks < 2 then fail() else
       MP_TAC (TRANS (SYM (el 0 lks)) (el 1 lks)) THEN
       REWRITE_TAC (injectivity "option" ::
                    injectivity "bvlSem_ref" :: rws) THEN
       STRIP_TAC)) THEN
     SPLIT_ASM_TAC THEN
     TRY VAR_EQ_TAC) THEN
    (* the reference has an address *)
    (SUBGOAL_THEN (cake_as_vars (fun () ->
       `FLOOKUP (f:(num,num)fmap) (ptr:num) = SOME (FAPPLY f ptr:num)`))
       ASSUME_TAC THENL
      [ASM_REWRITE_TAC[FLOOKUP_DEF]; ALL_TAC]) THEN
    (* the root of the value on the stack and the element that the
       reference holds are what the pointer's relation gives: the
       thunk that was not evaluated is in the heap and its value is
       related (v_inv_def, the second of the three ways) *)
    (* the store of the new thunk into the element *)
    W(fun (asl,w as gl) ->
      let rts = lhand (hd (conjuncts (snd (strip_exists w)))) in
      let r = el 0 (snd (strip_comb rts)) in
      let hl = the_asm (fun c -> is_eq c &&
                 hd_is "heap_lookup" (lhand c) &&
                 can (fun t -> hd_is "ThunkBlock" (rand t))
                   (rand c)) gl in
      let th0 = MATCH_MP heap_store_ThunkBlock hl in
      let hv = find_term (fun t -> is_var t &&
                 fst (dest_var t) = "h") (concl th0) in
      STRIP_ASSUME_TAC (INST [r,hv] th0)) THEN
    (* the witnesses: the root of the value, the address of the
       reference, the rest of the roots, the value the element held
       and the new heap *)
    W(fun (asl,w as gl) ->
      let rts = lhand (hd (conjuncts (snd (strip_exists w)))) in
      let rargs = snd (strip_comb rts) in
      let r = el 0 rargs in
      let targs = snd (strip_comb (el 1 rargs)) in
      let pargs = snd (strip_comb (el 0 targs)) in
      let p = el 0 pargs in
      let u = el 1 pargs in
      let roots2 = el 1 targs in
      let st = the_asm (fun c -> is_eq c &&
                 hd_is "heap_store" (lhand c)) gl in
      let heap = el 2 (snd (strip_comb (lhand (concl st)))) in
      let h2 = lhand (rand (concl st)) in
      let hl = the_asm (fun c -> is_eq c &&
                 hd_is "heap_lookup" (lhand c) &&
                 el 1 (snd (strip_comb (lhand c))) = heap &&
                 can (fun t -> hd_is "ThunkBlock" (rand t))
                   (rand c)) gl in
      let hlD = REWRITE_RULE[ThunkBlock_def] hl in
      let lst = el 0 (snd (strip_comb (rand (rand (concl hlD))))) in
      MAP_EVERY EXISTS_TAC [p; r; roots2; lst; h2; u]) THEN
    REPEAT CONJ_TAC THEN
    TRY (SOLVED (FIRST_ASSUM ACCEPT_TAC)) THEN
    TRY (SOLVED (ASM_REWRITE_TAC[])) THEN
    (* the value that the element held *)
    TRY (SOLVED
          (W(fun gl ->
             let st = the_asm (fun c -> is_eq c &&
                        hd_is "heap_store" (lhand c)) gl in
             let heap = el 2 (snd (strip_comb (lhand (concl st)))) in
             let hl = the_asm (fun c -> is_eq c &&
                        hd_is "heap_lookup" (lhand c) &&
                        el 1 (snd (strip_comb (lhand c))) = heap &&
                        can (fun t -> hd_is "ThunkBlock" (rand t))
                          (rand c)) gl in
             REWRITE_TAC[thunk_deref_def; hl; ThunkBlock_def]) THEN
           MATCH_REDUCE_TAC THEN REWRITE_TAC[])) THEN
    (* and the invariant of the new heap and references *)
    REWRITE_TAC[abs_ml_inv_def; bc_stack_ref_inv_def] THEN
    REPEAT CONJ_TAC THEN
    TRY (SOLVED (FIRST_ASSUM ACCEPT_TAC)) THEN
    TRY (SOLVED (ASM_REWRITE_TAC[])) THEN
    (* the roots are the ones they were, of a heap as good *)
    TRY (SOLVED
          (W(fun gl ->
             let iso = the_asm (fun c ->
               let bd = snd (strip_forall c) in
               is_eq bd && hd_is "isSomeDataElement" (lhand bd)) gl in
             let ro = the_asm (hd_is "roots_ok") gl in
             ACCEPT_TAC (MATCH_MP roots_ok_iso (CONJ ro iso))))) THEN
    (* the heap is good: the pointer written is a root *)
    TRY (SOLVED
          (W(fun gl ->
             let ho = the_asm (hd_is "heap_ok") gl in
             let ro = REWRITE_RULE[roots_ok_def]
                        (the_asm (hd_is "roots_ok") gl) in
             let iso = the_asm (fun c ->
               let bd = snd (strip_forall c) in
               is_eq bd && hd_is "isSomeDataElement" (lhand bd)) gl in
             let hlen = the_asm (fun c -> is_eq c &&
                          hd_is "heap_length" (lhand c)) gl in
             let flt = the_asm (fun c -> is_eq c &&
                         hd_is "FILTER" (lhand c)) gl in
             let mm = REWRITE_RULE[ThunkBlock_def] (the_asm (fun c ->
                        let bd = snd (strip_forall c) in
                        is_imp bd && is_disj (rand bd)) gl) in
             let dj = hd (disjuncts
                        (rand (snd (strip_forall (concl mm))))) in
             let ws = el 0 (snd (strip_comb (rand dj))) in
             let vs,bd = strip_forall (concl ro) in
             let pw = list_mk_forall(vs,
                        mk_imp(list_mk_icomb "MEM"
                                 [lhand (lhand bd); ws], rand bd)) in
             SUBGOAL_THEN pw (fun pwt ->
               ACCEPT_TAC (MATCH_MP heap_ok_store_el
                 (CONJ ho (CONJ pwt (CONJ iso (CONJ hlen
                   (CONJ flt mm))))))) THEN
             MP_TAC ro THEN POP_ASSUM_LIST (K ALL_TAC) THEN
             REWRITE_TAC[MEM] THEN MESON_TAC[]))) THEN
    (* the kind of the collection survives the store *)
    TRY (SOLVED
          (W(fun gl ->
             let gk = the_asm (hd_is "gc_kind_inv") gl in
             let st = the_asm (fun c -> is_eq c &&
                        hd_is "heap_store" (lhand c)) gl in
             let heap = el 2 (snd (strip_comb (lhand (concl st)))) in
             let hl = the_asm (fun c -> is_eq c &&
                        hd_is "heap_lookup" (lhand c) &&
                        el 1 (snd (strip_comb (lhand c))) = heap &&
                        can (fun t -> hd_is "ThunkBlock" (rand t))
                          (rand c)) gl in
             MATCH_ACCEPT_TAC (MATCH_MP gc_kind_store_thunk
               (CONJ gk (CONJ st hl)))))) THEN
    (* and the unused space is where it was: the unused element is
       not a data element, so it is not the thunk written *)
    TRY (SOLVED
          (W(fun gl ->
             let us = the_asm (hd_is "unused_space_inv") gl in
             let hlen = the_asm (fun c -> is_eq c &&
                          hd_is "heap_length" (lhand c)) gl in
             let st = the_asm (fun c -> is_eq c &&
                        hd_is "heap_store" (lhand c)) gl in
             let heap = el 2 (snd (strip_comb (lhand (concl st)))) in
             let el2 = lhand (el 1 (snd (strip_comb
                         (lhand (concl st))))) in
             let hl = the_asm (fun c -> is_eq c &&
                        hd_is "heap_lookup" (lhand c) &&
                        el 1 (snd (strip_comb (lhand c))) = heap &&
                        can (fun t -> hd_is "ThunkBlock" (rand t))
                          (rand c)) gl in
             let el1 = rand (rand (concl hl)) in
             SUBGOAL_THEN (list_mk_icomb "isDataElement" [el1])
               (fun isd1 ->
                  SUBGOAL_THEN (list_mk_icomb "isDataElement" [el2])
                    (fun isd2 -> ACCEPT_TAC (MATCH_MP unused_store_el
                      (CONJ us (CONJ hlen (CONJ hl (CONJ isd1
                        (CONJ isd2 (CONJ (a_tr gl) st)))))))) THEN
                  REWRITE_TAC[isDataElement_def; ThunkBlock_def] THEN
                  MESON_TAC[]) THEN
             REWRITE_TAC[isDataElement_def; ThunkBlock_def] THEN
             MESON_TAC[]))) THEN
    (* the maps of the new invariant: the addresses are the ones they
       were, and the timestamps are cut to the ones of the new
       references and stack *)
    W(fun (asl,w as gl) ->
      if not (is_exists w) then ALL_TAC else
      (let sub p = rand (lhand (concl (the_asm (fun c ->
         hd_is "SUBSET" c && hd_is p (rand c)) gl))) in
       let ats = find_term (hd_is "all_ts") w in
       EXISTS_TAC (sub "domain") THEN
       EXISTS_TAC (list_mk_icomb "DRESTRICT" [sub "all_ts"; ats]))) THEN
    REPEAT CONJ_TAC THEN TRY (SOLVED (FIRST_ASSUM ACCEPT_TAC)) THEN
    (* the addresses of the maps are the ones of the old heap *)
    TRY (SOLVED
          (W(fun gl ->
             let iso = the_asm (fun c ->
               let bd = snd (strip_forall c) in
               is_eq bd && hd_is "isSomeDataElement" (lhand bd)) gl in
             ONCE_REWRITE_TAC[iso]) THEN
           FIRST [SOLVED (FIRST_ASSUM ACCEPT_TAC);
                  SOLVED (W(fun (asl,w as gl) ->
                    let dr = find_term (hd_is "DRESTRICT") w in
                    let inj = the_asm (fun c -> hd_is "INJ" c &&
                      rand (el 0 (snd (strip_comb c))) = lhand dr) gl in
                    MATCH_ACCEPT_TAC
                      (MATCH_MP INJ_DRESTRICT inj)))])) THEN
    (* the domain of the references has the key in it *)
    TRY (SOLVED
          (REWRITE_TAC[domain_insert] THEN
           MATCH_MP_TAC SUBSET_TRANS THEN
           W(fun gl ->
             let su = the_asm (fun c -> hd_is "SUBSET" c &&
                        hd_is "domain" (rand c)) gl in
             EXISTS_TAC (rand (concl su))) THEN
           CONJ_TAC THEN TRY (FIRST_ASSUM ACCEPT_TAC) THEN
           SET_TAC[])) THEN
    (* the timestamps of the restricted map are of the stack, and
       below the counter *)
    TRY (SOLVED
          (REWRITE_TAC[(CONJUNCT1 o SPEC_ALL) DRESTRICT_DEF] THEN
           FIRST [SOLVED (REWRITE_TAC[INTER_SUBSET]);
                  SOLVED (MATCH_MP_TAC SUBSET_TRANS THEN
                          W(fun gl ->
                            let su = the_asm (fun c ->
                              hd_is "SUBSET" c &&
                              hd_is "FDOM" (lhand c)) gl in
                            EXISTS_TAC (lhand (concl su))) THEN
                          CONJ_TAC THEN
                          TRY (FIRST_ASSUM ACCEPT_TAC) THEN
                          REWRITE_TAC[INTER_SUBSET])])) THEN
    (* the blocks of the stack stay unique *)
    TRY (SOLVED
          (W(fun gl ->
             let bu = the_asm (hd_is "blocks_unique") gl in
             MATCH_ACCEPT_TAC
               (MATCH_MP blocks_unique_update_thunk bu)))) THEN
    (* the transfers that the update of the thunk leaves: what the
       invariant says of a value, what a value says of a thunk, and
       what the references hold at another key (TH_trans) *)
    W(fun (asl,w as gl) ->
      let st = the_asm (fun c -> is_eq c &&
                 hd_is "heap_store" (lhand c)) gl in
      let heap = el 2 (snd (strip_comb (lhand (concl st)))) in
      let hl = the_asm (fun c -> is_eq c &&
                 hd_is "heap_lookup" (lhand c) &&
                 el 1 (snd (strip_comb (lhand c))) = heap &&
                 can (fun t -> hd_is "ThunkBlock" (rand t))
                   (rand c)) gl in
      let hl2 = the_asm (fun c -> is_eq c &&
                  hd_is "heap_lookup" (lhand c) &&
                  not (el 1 (snd (strip_comb (lhand c))) = heap) &&
                  can (fun t -> hd_is "ThunkBlock" (rand t))
                    (rand c)) gl in
      let y = el 1 (snd (strip_comb (rand (rand (concl hl))))) in
      let q = el 1 (snd (strip_comb (rand (rand (concl hl2))))) in
      let lk = the_asm (fun c -> is_eq c &&
                 hd_is "sptree_lookup" (lhand c) &&
                 not (hd_is "sptree_insert" (rand (lhand c)))) gl in
      let ptr = el 0 (snd (strip_comb (lhand (concl lk)))) in
      let fm = el 0 (snd (strip_comb (lhand (concl
                 (the_asm (fun c -> is_eq c &&
                    hd_is "FLOOKUP" (lhand c)) gl))))) in
      let inj = the_asm (fun c -> hd_is "INJ" c &&
                  rand (el 0 (snd (strip_comb c))) = fm) gl in
      let pin = the_asm (fun c -> hd_is "IN" c &&
                  hd_is "FDOM" (rand c) &&
                  el 0 (snd (strip_comb c)) = ptr) gl in
      let viy = the_asm (fun c -> hd_is "v_inv" c &&
                  el 0 (tparts (el 3 (snd (strip_comb c)))) = y) gl in
      let viq = the_asm (fun c -> hd_is "v_inv" c &&
                  el 0 (tparts (el 3 (snd (strip_comb c)))) = q) gl in
      let hv = el 1 (snd (strip_comb (concl viq))) in
      let dt = the_asm (fun c -> is_imp c &&
                 (try hd_is "dataSem_dest_thunk" (lhand (rand c)) &&
                      el 0 (snd (strip_comb (lhand (rand c)))) = hv
                  with Failure _ -> false)) gl in
      MAP_EVERY ASSUME_TAC (CONJUNCTS (MATCH_MP TH_trans
        (CONJ inj (CONJ pin (CONJ lk (CONJ hl (CONJ viy
          (CONJ dt (CONJ st (CONJ hl2
            (CONJ (a_tr gl) viq)))))))))))) THEN
    (* the values of the stack: the thunk's value and the pointer in
       front of it, and the rest *)
    W(fun (asl,w) -> if not (hd_is "ALL2" w) then ALL_TAC else
      (REWRITE_TAC[ALL2] THEN
       CONV_TAC(TOP_DEPTH_CONV BETA_CONV) THEN
       REPEAT CONJ_TAC THEN
       TRY (SOLVED
             (W(fun (asl,w as gl) ->
                let args = snd (strip_comb w) in
                let v1 = el 1 args in
                let ats = find_term (hd_is "all_ts") w in
                let vi = the_asm (fun c -> hd_is "v_inv" c &&
                           el 1 (snd (strip_comb c)) = v1 &&
                           not (el 2 (snd (strip_comb c)) =
                                  lhand ats)) gl in
                SUBGOAL_THEN
                  (list_mk_icomb "MEM" [v1; rand ats])
                  (fun mm -> MATCH_ACCEPT_TAC (MATCH_MP
                     v_inv_update_gen
                     (CONJ (a_vtr gl) (CONJ vi
                       (MP (SPECL [v1; rand ats; lhand ats]
                             MEM_stack_all_vs) mm))))) THEN
                REWRITE_TAC[MEM]))) THEN
       W(fun (asl,w as gl) ->
         let old = the_asm (fun c -> hd_is "ALL2" c &&
                     el 1 (snd (strip_comb c)) =
                       el 1 (snd (strip_comb w))) gl in
         let ats = find_term (hd_is "all_ts") w in
         let vs = el 1 (snd (strip_comb w)) in
         let v = genvar (hd (snd (dest_type (type_of (rand ats))))) in
         SUBGOAL_THEN
           (mk_forall(v, mk_imp(list_mk_icomb "MEM" [v; vs],
              list_mk_icomb "IN"
                [v; list_mk_icomb "all_vs" [lhand ats; rand ats]])))
           (fun mem -> ACCEPT_TAC (MATCH_MP EVERY2_v_inv_update_stack
              (CONJ (a_vtr gl) (CONJ mem old)))) THEN
         REPEAT STRIP_TAC THEN
         W(fun gl ->
           let mm = the_asm (hd_is "MEM") gl in
           let v1 = el 0 (snd (strip_comb (concl mm))) in
           SUBGOAL_THEN (list_mk_icomb "MEM" [v1; rand ats])
             (fun m2 -> MATCH_ACCEPT_TAC (MP (SPECL [v1; rand ats;
                          lhand ats] MEM_stack_all_vs) m2)) THEN
           ASM_REWRITE_TAC[MEM])))) THEN
    (* and the invariant of each reference that the stack reaches:
       it was reachable before the update
       (reachable_refs_Thunk_UPDATE) *)
    W(fun (asl,w) -> if not (is_forall w) then ALL_TAC else
      (REPEAT STRIP_TAC THEN
       W(fun gl ->
         let rr = the_asm (fun c -> hd_is "reachable_refs" c &&
                    hd_is "sptree_insert"
                      (el 1 (snd (strip_comb c)))) gl in
         ASSUME_TAC (MATCH_MP reachable_refs_Thunk_UPDATE rr)) THEN
       W(fun (asl,w as gl) ->
         let n = el 1 (snd (strip_comb w)) in
         let bri = the_asm (fun c ->
           let vs,bd = strip_forall c in
           length vs = 1 && is_imp bd &&
           hd_is "bc_ref_inv" (rand bd)) gl in
         let rr = the_asm (fun c -> hd_is "reachable_refs" c &&
           not (hd_is "sptree_insert"
                  (el 1 (snd (strip_comb c))))) gl in
         let nin = the_asm (fun c -> hd_is "IN" c &&
           hd_is "FDOM" (rand c) &&
           el 0 (snd (strip_comb c)) = n) gl in
         ASSUME_TAC (MP (SPEC n bri) (CONJ rr nin))) THEN
       (* the reference written, or another one *)
       W(fun (asl,w as gl) ->
         ASM_CASES_TAC (mk_eq (el 1 (snd (strip_comb w)),
                               g_ptr gl))) THEN
       TRY VAR_EQ_TAC THEN
       (* the one written: the thunk that the update stored *)
       TRY (SOLVED
             (W(fun (asl,w as gl) ->
                let lk1 = the_asm (fun c -> is_eq c &&
                            hd_is "FLOOKUP" (lhand c)) gl in
                let p = rand (rand (concl lk1)) in
                let hl2 = the_asm (fun c -> is_eq c &&
                            hd_is "heap_lookup" (lhand c) &&
                            el 0 (snd (strip_comb (lhand c))) = p &&
                            can (fun t -> hd_is "ThunkBlock" (rand t))
                              (rand c)) gl in
                let q = el 1 (snd (strip_comb
                          (rand (rand (concl hl2))))) in
                let viq = the_asm (fun c -> hd_is "v_inv" c &&
                            el 0 (tparts (el 3 (snd (strip_comb c))))
                              = q) gl in
                let hv = el 1 (snd (strip_comb (concl viq))) in
                let dt = the_asm (fun c -> is_imp c &&
                           (try hd_is "dataSem_dest_thunk"
                                  (lhand (rand c)) &&
                                el 0 (snd (strip_comb
                                  (lhand (rand c)))) = hv
                            with Failure _ -> false)) gl in
                let ats = find_term (hd_is "all_ts") w in
                SUBGOAL_THEN (list_mk_icomb "MEM" [hv; rand ats])
                  (fun mm -> MATCH_ACCEPT_TAC (MATCH_MP
                     bc_ref_inv_update_thunk_at
                     (CONJ lk1 (CONJ hl2 (CONJ dt (CONJ viq
                       (CONJ mm (CONJ (a_vtr gl) (a_dtr gl))))))))) THEN
                REWRITE_TAC[MEM]))) THEN
       (* another one: its element did not move *)
       TRY (SOLVED
             (W(fun (asl,w as gl) ->
                let fm = el 0 (tparts (el 3 (snd (strip_comb w)))) in
                let inj = the_asm (fun c -> hd_is "INJ" c &&
                            rand (el 0 (snd (strip_comb c))) = fm) gl in
                let pin = the_asm (fun c -> hd_is "IN" c &&
                            hd_is "FDOM" (rand c) &&
                            el 0 (snd (strip_comb c)) = g_ptr gl) gl in
                let neq = the_asm (fun c -> is_neg c &&
                            is_eq (rand c) &&
                            rand (rand c) = g_ptr gl) gl in
                let inv = the_asm (hd_is "bc_ref_inv") gl in
                MATCH_ACCEPT_TAC (MATCH_MP bc_ref_inv_update_other_gen
                  (CONJ inj (CONJ pin (CONJ neq (CONJ (a_vtr gl)
                    (CONJ (a_dtr gl) (CONJ (a_ltr gl)
                      (CONJ (a_tr gl) inv))))))))))))) THEN
    ALL_TAC)
### update_mutblock_thm
  (* the steps are above the statement and above update_ref_thm
     (tools/overrides.py).  The two roots in front of the rest are
     the root of the value and the address of the reference, which
     v_inv of the pointer gives in the first of its three ways,
     because the reference holds a mutable block; the invariant of
     that reference gives the element of the heap and the values it
     holds, the store writes the value into the place of the hole
     (LUPDATE), and the heap and the references are then as good as
     they were.  Of the reference written the invariant is the
     block with the hole filled and of any other one its element,
     which the store did not touch *)
  (STRIP_TAC THEN
    (* what the invariant says of the stack with the value and the
       pointer on it *)
    FIRST_X_ASSUM (fun inv ->
      if not (hd_is "abs_ml_inv" (concl inv)) then fail() else
      STRIP_ASSUME_TAC (REWRITE_RULE[abs_ml_inv_def;
                                     bc_stack_ref_inv_def] inv)) THEN
    (* the roots are the two of the values in front and the rest *)
    SPLIT_ROOTS_TAC THEN SPLIT_ROOTS_TAC THEN
    (* and the root of the pointer is the address of its reference *)
    FIRST_ASSUM (fun vr ->
      let c = concl vr in
      if not (hd_is "v_inv" c) ||
         not (hd_is "dataSem_RefPtr" (el 1 (snd (strip_comb c))))
      then fail()
      else STRIP_ASSUME_TAC (REWRITE_RULE[v_inv_def] vr)) THEN
    (* of the three ways a pointer is related only the first is
       left, because the reference holds a mutable block: the two
       that are about a thunk say the reference holds one *)
    (let rws = distinctness "thunk_mode" :: ref_rws in
     RULE_ASSUM_TRY (REWRITE_RULE rws) THEN
     TRY (FIRST_ASSUM CONTR_TAC) THEN
     (* the reference is no thunk, so the first way is the one *)
     TRY (SOLVED
           (W(fun gl ->
              let nt = the_asm (fun c ->
                         length (fst (strip_forall c)) = 2 &&
                         is_neg (snd (strip_forall c))) gl in
              let lk = the_asm (fun c -> is_eq c &&
                         hd_is "sptree_lookup" (lhand c) &&
                         hd_is "SOME" (rand c)) gl in
              let args = snd (strip_comb (rand (rand (concl lk)))) in
              CONTR_TAC (MP (NOT_ELIM
                (SPECL [el 0 args; el 1 args] nt)) lk)))) THEN
     (* and the two lookups of the key agree, which leaves the
        second way and puts the third out *)
     TRY (W(fun (asl,_) ->
       let lks = mapfilter (fun (_,th) ->
                   let c = concl th in
                   if is_eq c && hd_is "sptree_lookup" (lhand c) &&
                      hd_is "SOME" (rand c) then th else fail()) asl in
       if length lks < 2 then fail() else
       MP_TAC (TRANS (SYM (el 0 lks)) (el 1 lks)) THEN
       REWRITE_TAC (injectivity "option" ::
                    injectivity "bvlSem_ref" :: rws) THEN
       STRIP_TAC)) THEN
     SPLIT_ASM_TAC THEN
     TRY VAR_EQ_TAC) THEN
    (* the reference has an address *)
    (SUBGOAL_THEN (cake_as_vars (fun () ->
       `FLOOKUP (f:(num,num)fmap) (ptr:num) = SOME (FAPPLY f ptr:num)`))
       ASSUME_TAC THENL
      [ASM_REWRITE_TAC[FLOOKUP_DEF]; ALL_TAC]) THEN
    (* and it is reachable, so the invariant holds of it *)
    (SUBGOAL_THEN (cake_as_vars (fun () ->
       `reachable_refs (h :: RefPtr F ptr :: stack) refs ptr`))
       ASSUME_TAC THENL
      [MATCH_MP_TAC (GEN_ALL reach_refptr) THEN
       FIRST [EXISTS_TAC `F`; ALL_TAC] THEN
       REWRITE_TAC[MEM];
       ALL_TAC]) THEN
    W(fun (asl,w as gl) ->
      let bri = the_asm (fun c ->
        let vs,bd = strip_forall c in
        length vs = 1 && is_imp bd &&
        hd_is "bc_ref_inv" (rand bd)) gl in
      let rr = the_asm (hd_is "reachable_refs") gl in
      let n = el 2 (snd (strip_comb (concl rr))) in
      let nin = the_asm (fun c -> hd_is "IN" c &&
                  hd_is "FDOM" (rand c) &&
                  el 0 (snd (strip_comb c)) = n) gl in
      ASSUME_TAC (MP (SPEC n bri) (CONJ rr nin))) THEN
    (* which is the arm of a mutable block: the element of the heap,
       the values it holds, and that no timestamp points at it *)
    W(fun gl ->
      let lk1 = the_asm (fun c -> is_eq c &&
                  hd_is "FLOOKUP" (lhand c)) gl in
      let lk2 = the_asm (fun c -> is_eq c &&
                  hd_is "sptree_lookup" (lhand c)) gl in
      FIRST_X_ASSUM (fun inv ->
        if not (hd_is "bc_ref_inv" (concl inv)) then fail() else
        STRIP_ASSUME_TAC
          (REWRITE_RULE[MATCH_MP arm_MB (CONJ lk1 lk2)] inv))) THEN
    RULE_ASSUM_TRY (REWRITE_RULE[]) THEN
    (* the store of the value into the hole of the block *)
    W(fun (asl,w as gl) ->
      let hl = the_asm (fun c -> is_eq c &&
                 hd_is "heap_lookup" (lhand c) &&
                 can (fun t -> hd_is "BlockRep" (rand t))
                   (rand c)) gl in
      let zs = rand (rand (rand (concl hl))) in
      let rts = lhand (hd (conjuncts (snd (strip_exists w)))) in
      let rr = el 0 (snd (strip_comb rts)) in
      let i = el 1 (snd (strip_comb
                (find_term (hd_is "LUPDATE") w))) in
      let ws = list_mk_icomb "LUPDATE" [rr; i; zs] in
      SUBGOAL_THEN (mk_eq (list_mk_icomb "LENGTH" [zs],
                           list_mk_icomb "LENGTH" [ws]))
        (fun le -> STRIP_ASSUME_TAC
          (MATCH_MP heap_store_BlockRep (CONJ le hl)) THEN
          ASSUME_TAC le THEN ASSUME_TAC (SYM le)) THENL
       [REWRITE_TAC[LENGTH_LUPDATE];
        ALL_TAC]) THEN
    (* the witnesses: the address of the reference, the root of the
       value, the rest of the roots, the values the element held and
       the new heap *)
    W(fun (asl,w as gl) ->
      let rts = lhand (hd (conjuncts (snd (strip_exists w)))) in
      let rargs = snd (strip_comb rts) in
      let rr = el 0 rargs in
      let targs = snd (strip_comb (el 1 rargs)) in
      let pargs = snd (strip_comb (el 0 targs)) in
      let st = the_asm (fun c -> is_eq c &&
                 hd_is "heap_store" (lhand c)) gl in
      let heap = el 2 (snd (strip_comb (lhand (concl st)))) in
      let hl = the_asm (fun c -> is_eq c &&
                 hd_is "heap_lookup" (lhand c) &&
                 el 1 (snd (strip_comb (lhand c))) = heap &&
                 can (fun t -> hd_is "BlockRep" (rand t))
                   (rand c)) gl in
      MAP_EVERY EXISTS_TAC
        [el 0 pargs; rr; el 1 targs;
         rand (rand (rand (concl hl))); lhand (rand (concl st));
         el 1 pargs]) THEN
    REPEAT CONJ_TAC THEN
    TRY (SOLVED (FIRST_ASSUM ACCEPT_TAC)) THEN
    (* the number of the values of the element, which a rewrite with
       the assumptions cannot be let at: the lengths of the element
       and of the list stored are each other's *)
    TRY (SOLVED
          (W(fun gl ->
             let old = the_asm (fun c -> hd_is "ALL2" c &&
                         hd_is "APPEND"
                           (el 2 (snd (strip_comb c)))) gl in
             MP_TAC (MATCH_MP LIST_REL_LENGTH old)) THEN
           REWRITE_TAC[LENGTH_APPEND; LENGTH] THEN ARITH_TAC)) THEN
    TRY (SOLVED (ASM_REWRITE_TAC[])) THEN
    (* and the invariant of the new heap and references *)
    REWRITE_TAC[abs_ml_inv_def; bc_stack_ref_inv_def] THEN
    REPEAT CONJ_TAC THEN
    TRY (SOLVED (FIRST_ASSUM ACCEPT_TAC)) THEN
    TRY (SOLVED (ASM_REWRITE_TAC[])) THEN
    (* the roots are the ones they were, of a heap as good *)
    TRY (SOLVED
          (W(fun gl ->
             let iso = the_asm (fun c ->
               let bd = snd (strip_forall c) in
               is_eq bd && hd_is "isSomeDataElement" (lhand bd)) gl in
             let ro = the_asm (hd_is "roots_ok") gl in
             ACCEPT_TAC (MATCH_MP roots_ok_iso (CONJ ro iso))))) THEN
    (* the heap is good: the pointers of the element written are the
       root put in and the ones it had (ptrs_store_el) *)
    TRY (SOLVED
          (W(fun gl ->
             let ho = the_asm (hd_is "heap_ok") gl in
             let ro = REWRITE_RULE[roots_ok_def]
                        (the_asm (hd_is "roots_ok") gl) in
             let iso = the_asm (fun c ->
               let bd = snd (strip_forall c) in
               is_eq bd && hd_is "isSomeDataElement" (lhand bd)) gl in
             let hlen = the_asm (fun c -> is_eq c &&
                          hd_is "heap_length" (lhand c)) gl in
             let flt = the_asm (fun c -> is_eq c &&
                         hd_is "FILTER" (lhand c)) gl in
             let mm = REWRITE_RULE[BlockRep_def] (the_asm (fun c ->
                        let bd = snd (strip_forall c) in
                        is_imp bd && is_disj (rand bd)) gl) in
             let dj = hd (disjuncts
                        (rand (snd (strip_forall (concl mm))))) in
             let ws = el 0 (snd (strip_comb (rand dj))) in
             let st = the_asm (fun c -> is_eq c &&
                        hd_is "heap_store" (lhand c)) gl in
             let heap = el 2 (snd (strip_comb (lhand (concl st)))) in
             let hl = REWRITE_RULE[BlockRep_def] (the_asm (fun c ->
                        is_eq c && hd_is "heap_lookup" (lhand c) &&
                        el 1 (snd (strip_comb (lhand c))) = heap &&
                        can (fun t -> hd_is "BlockRep" (rand t))
                          (rand c)) gl) in
             let w0 = el 0 (snd (strip_comb ws)) in
             let vs,bd = strip_forall (concl ro) in
             let pt = list_mk_forall(vs,
                        mk_imp(mk_eq (w0, lhand (lhand bd)),
                               rand bd)) in
             SUBGOAL_THEN pt (fun ptt ->
               let p1 = MATCH_MP ptrs_store_el
                          (CONJ ho (CONJ ptt hl)) in
               let iv = find_term (fun t -> is_var t &&
                          fst (dest_var t) = "i") (concl p1) in
               ACCEPT_TAC (MATCH_MP heap_ok_store_el
                 (CONJ ho (CONJ (INST [el 1 (snd (strip_comb ws)),iv]
                                   p1)
                   (CONJ iso (CONJ hlen (CONJ flt mm))))))) THEN
             MP_TAC ro THEN POP_ASSUM_LIST (K ALL_TAC) THEN
             REWRITE_TAC[MEM] THEN MESON_TAC[]))) THEN
    (* the kind of the collection: a mutable block is not in a heap
       that a generational collection goes through (gc_kind_not_gen) *)
    TRY (SOLVED
          (W(fun gl ->
             let gk = the_asm (hd_is "gc_kind_inv") gl in
             let ng = the_asm (fun c ->
                        let vs,bd = strip_forall c in
                        length vs = 1 && is_neg bd) gl in
             MATCH_ACCEPT_TAC (MATCH_MP gc_kind_not_gen
               (CONJ gk ng))))) THEN
    (* and the unused space is where it was: the unused element is
       not a data element, so it is not the block written *)
    TRY (SOLVED
          (W(fun gl ->
             let us = the_asm (hd_is "unused_space_inv") gl in
             let hlen = the_asm (fun c -> is_eq c &&
                          hd_is "heap_length" (lhand c)) gl in
             let st = the_asm (fun c -> is_eq c &&
                        hd_is "heap_store" (lhand c)) gl in
             let heap = el 2 (snd (strip_comb (lhand (concl st)))) in
             let el2 = lhand (el 1 (snd (strip_comb
                         (lhand (concl st))))) in
             let hl = the_asm (fun c -> is_eq c &&
                        hd_is "heap_lookup" (lhand c) &&
                        el 1 (snd (strip_comb (lhand c))) = heap &&
                        can (fun t -> hd_is "BlockRep" (rand t))
                          (rand c)) gl in
             let el1 = rand (rand (concl hl)) in
             SUBGOAL_THEN (list_mk_icomb "isDataElement" [el1])
               (fun isd1 ->
                  SUBGOAL_THEN (list_mk_icomb "isDataElement" [el2])
                    (fun isd2 -> ACCEPT_TAC (MATCH_MP unused_store_el
                      (CONJ us (CONJ hlen (CONJ hl (CONJ isd1
                        (CONJ isd2 (CONJ (a_tr gl) st)))))))) THEN
                  REWRITE_TAC[isDataElement_def; BlockRep_def] THEN
                  MESON_TAC[]) THEN
             REWRITE_TAC[isDataElement_def; BlockRep_def] THEN
             MESON_TAC[]))) THEN
    (* the maps of the new invariant: the addresses are the ones they
       were, and the timestamps are cut to the ones of the new
       references and stack *)
    W(fun (asl,w as gl) ->
      if not (is_exists w) then ALL_TAC else
      (let sub p = rand (lhand (concl (the_asm (fun c ->
         hd_is "SUBSET" c && hd_is p (rand c)) gl))) in
       let ats = find_term (hd_is "all_ts") w in
       EXISTS_TAC (sub "domain") THEN
       EXISTS_TAC (list_mk_icomb "DRESTRICT" [sub "all_ts"; ats]))) THEN
    REPEAT CONJ_TAC THEN TRY (SOLVED (FIRST_ASSUM ACCEPT_TAC)) THEN
    (* the addresses of the maps are the ones of the old heap *)
    TRY (SOLVED
          (W(fun gl ->
             let iso = the_asm (fun c ->
               let bd = snd (strip_forall c) in
               is_eq bd && hd_is "isSomeDataElement" (lhand bd)) gl in
             ONCE_REWRITE_TAC[iso]) THEN
           FIRST [SOLVED (FIRST_ASSUM ACCEPT_TAC);
                  SOLVED (W(fun (asl,w as gl) ->
                    let dr = find_term (hd_is "DRESTRICT") w in
                    let inj = the_asm (fun c -> hd_is "INJ" c &&
                      rand (el 0 (snd (strip_comb c))) = lhand dr) gl in
                    MATCH_ACCEPT_TAC
                      (MATCH_MP INJ_DRESTRICT inj)))])) THEN
    (* the domain of the references has the key in it *)
    TRY (SOLVED
          (REWRITE_TAC[domain_insert] THEN
           MATCH_MP_TAC SUBSET_TRANS THEN
           W(fun gl ->
             let su = the_asm (fun c -> hd_is "SUBSET" c &&
                        hd_is "domain" (rand c)) gl in
             EXISTS_TAC (rand (concl su))) THEN
           CONJ_TAC THEN TRY (FIRST_ASSUM ACCEPT_TAC) THEN
           SET_TAC[])) THEN
    (* the timestamps of the restricted map are of the stack, and
       below the counter *)
    TRY (SOLVED
          (REWRITE_TAC[(CONJUNCT1 o SPEC_ALL) DRESTRICT_DEF] THEN
           FIRST [SOLVED (REWRITE_TAC[INTER_SUBSET]);
                  SOLVED (MATCH_MP_TAC SUBSET_TRANS THEN
                          W(fun gl ->
                            let su = the_asm (fun c ->
                              hd_is "SUBSET" c &&
                              hd_is "FDOM" (lhand c)) gl in
                            EXISTS_TAC (lhand (concl su))) THEN
                          CONJ_TAC THEN
                          TRY (FIRST_ASSUM ACCEPT_TAC) THEN
                          REWRITE_TAC[INTER_SUBSET])])) THEN
    (* the blocks of the stack stay unique *)
    TRY (SOLVED
          (W(fun gl ->
             let bu = the_asm (hd_is "blocks_unique") gl in
             MATCH_ACCEPT_TAC (MATCH_MP blocks_unique_update_mutblock
               (CONJ (a_lkptr gl) bu))))) THEN
    (* the transfers that the update of the hole leaves: what the
       invariant says of a value, what a value says of a thunk, and
       what the references hold at another key (MB_trans) *)
    W(fun (asl,w as gl) ->
      let st = the_asm (fun c -> is_eq c &&
                 hd_is "heap_store" (lhand c)) gl in
      let heap = el 2 (snd (strip_comb (lhand (concl st)))) in
      let hl = the_asm (fun c -> is_eq c &&
                 hd_is "heap_lookup" (lhand c) &&
                 el 1 (snd (strip_comb (lhand c))) = heap &&
                 can (fun t -> hd_is "BlockRep" (rand t))
                   (rand c)) gl in
      let nim = the_asm (fun c -> is_neg c &&
                  hd_is "IN" (rand c)) gl in
      let trs = CONJUNCTS (MATCH_MP MB_trans
                  (CONJ hl (CONJ (MATCH_MP IMAGE_NOT_point nim)
                    (CONJ (a_tr gl) (a_lkptr gl))))) in
      (* the block that the update puts in is as unfinalised as the
         one it replaces, which only the conclusion of MB_trans
         says, so the transfers have to be told (entry 55) *)
      let fv = find_term (fun t -> is_var t &&
                 fst (dest_var t) = "fin2") (concl (hd trs)) in
      let fin = el 1 (snd (strip_comb
                  (rand (rand (concl (a_lkptr gl)))))) in
      MAP_EVERY ASSUME_TAC (map (INST [fin,fv]) trs)) THEN
    (* the values of the stack: the value put in the hole and the
       pointer in front of it, and the rest *)
    W(fun (asl,w) -> if not (hd_is "ALL2" w) then ALL_TAC else
      (REWRITE_TAC[ALL2] THEN
       CONV_TAC(TOP_DEPTH_CONV BETA_CONV) THEN
       REPEAT CONJ_TAC THEN
       TRY (SOLVED
             (W(fun (asl,w as gl) ->
                let args = snd (strip_comb w) in
                let v1 = el 1 args in
                let ats = find_term (hd_is "all_ts") w in
                let vi = the_asm (fun c -> hd_is "v_inv" c &&
                           el 1 (snd (strip_comb c)) = v1 &&
                           not (el 2 (snd (strip_comb c)) =
                                  lhand ats)) gl in
                SUBGOAL_THEN
                  (list_mk_icomb "MEM" [v1; rand ats])
                  (fun mm -> MATCH_ACCEPT_TAC (MATCH_MP
                     v_inv_update_gen
                     (CONJ (a_vtr gl) (CONJ vi
                       (MP (SPECL [v1; rand ats; lhand ats]
                             MEM_stack_all_vs) mm))))) THEN
                REWRITE_TAC[MEM]))) THEN
       W(fun (asl,w as gl) ->
         let old = the_asm (fun c -> hd_is "ALL2" c &&
                     el 1 (snd (strip_comb c)) =
                       el 1 (snd (strip_comb w))) gl in
         let ats = find_term (hd_is "all_ts") w in
         let vs = el 1 (snd (strip_comb w)) in
         let v = genvar (hd (snd (dest_type (type_of (rand ats))))) in
         SUBGOAL_THEN
           (mk_forall(v, mk_imp(list_mk_icomb "MEM" [v; vs],
              list_mk_icomb "IN"
                [v; list_mk_icomb "all_vs" [lhand ats; rand ats]])))
           (fun mem -> ACCEPT_TAC (MATCH_MP EVERY2_v_inv_update_stack
              (CONJ (a_vtr gl) (CONJ mem old)))) THEN
         REPEAT STRIP_TAC THEN
         W(fun gl ->
           let mm = the_asm (hd_is "MEM") gl in
           let v1 = el 0 (snd (strip_comb (concl mm))) in
           SUBGOAL_THEN (list_mk_icomb "MEM" [v1; rand ats])
             (fun m2 -> MATCH_ACCEPT_TAC (MP (SPECL [v1; rand ats;
                          lhand ats] MEM_stack_all_vs) m2)) THEN
           ASM_REWRITE_TAC[MEM])))) THEN
    (* and the invariant of each reference that the stack reaches:
       it was reachable before the update
       (reachable_refs_MutBlock_UPDATE) *)
    W(fun (asl,w) -> if not (is_forall w) then ALL_TAC else
      (REPEAT STRIP_TAC THEN
       W(fun gl ->
         let rr = the_asm (fun c -> hd_is "reachable_refs" c &&
                    hd_is "sptree_insert"
                      (el 1 (snd (strip_comb c)))) gl in
         ASSUME_TAC (MATCH_MP reachable_refs_MutBlock_UPDATE
           (CONJ (a_lkptr gl) rr))) THEN
       W(fun (asl,w as gl) ->
         let n = el 1 (snd (strip_comb w)) in
         let bri = the_asm (fun c ->
           let vs,bd = strip_forall c in
           length vs = 1 && is_imp bd &&
           hd_is "bc_ref_inv" (rand bd)) gl in
         let rr = the_asm (fun c -> hd_is "reachable_refs" c &&
           not (hd_is "sptree_insert"
                  (el 1 (snd (strip_comb c))))) gl in
         let nin = the_asm (fun c -> hd_is "IN" c &&
           hd_is "FDOM" (rand c) &&
           el 0 (snd (strip_comb c)) = n) gl in
         ASSUME_TAC (MP (SPEC n bri) (CONJ rr nin))) THEN
       (* the reference written, or another one *)
       W(fun (asl,w as gl) ->
         ASM_CASES_TAC (mk_eq (el 1 (snd (strip_comb w)),
                               g_ptr gl))) THEN
       TRY VAR_EQ_TAC THEN
       (* the one written: the block with the hole filled *)
       TRY (SOLVED
             (W(fun (asl,w as gl) ->
                let lk1 = the_asm (fun c -> is_eq c &&
                            hd_is "FLOOKUP" (lhand c)) gl in
                let p = rand (rand (concl lk1)) in
                let hl2 = the_asm (fun c -> is_eq c &&
                            hd_is "heap_lookup" (lhand c) &&
                            el 0 (snd (strip_comb (lhand c))) = p &&
                            can (fun t -> hd_is "BlockRep" (rand t))
                              (rand c) &&
                            can (find_term (hd_is "LUPDATE"))
                              (rand c)) gl in
                let lup = find_term (hd_is "LUPDATE") (concl hl2) in
                let old = the_asm (fun c -> hd_is "ALL2" c &&
                            el 1 (snd (strip_comb c)) =
                              el 2 (snd (strip_comb lup))) gl in
                let vi = the_asm (fun c -> hd_is "v_inv" c &&
                           el 0 (tparts (el 3 (snd (strip_comb c)))) =
                             el 0 (snd (strip_comb lup))) gl in
                let gk = the_asm (fun c ->
                           length (fst (strip_forall c)) = 1 &&
                           is_neg (snd (strip_forall c))) gl in
                let nim = the_asm (fun c -> is_neg c &&
                            hd_is "IN" (rand c)) gl in
                let ats = find_term (hd_is "all_ts") w in
                let ins = lhand ats in
                let bargs = snd (strip_comb
                              (el 1 (snd (strip_comb ins)))) in
                let vls = list_mk_icomb "APPEND"
                            [el 2 bargs; list_mk_icomb "APPEND"
                              [mk_flist [el 3 bargs]; el 4 bargs]] in
                let v = genvar (type_of (el 3 bargs)) in
                SUBGOAL_THEN
                  (mk_forall(v, mk_imp(list_mk_icomb "MEM" [v; vls],
                     list_mk_icomb "IN"
                       [v; list_mk_icomb "all_vs" [ins; rand ats]])))
                  (fun mem -> MATCH_ACCEPT_TAC (MATCH_MP
                     bc_ref_inv_update_mutblock_at
                     (CONJ lk1 (CONJ hl2 (CONJ (a_lkptr gl)
                       (CONJ old (CONJ vi (CONJ gk (CONJ nim
                         (CONJ (a_vtr gl) mem)))))))))) THEN
                REPEAT STRIP_TAC THEN
                W(fun (asl,w as gl) ->
                  let iargs = snd (strip_comb
                                (find_term (hd_is "sptree_insert")
                                   w)) in
                  let mm = the_asm (hd_is "MEM") gl in
                  SUBGOAL_THEN
                    (mk_eq (list_mk_icomb "sptree_lookup"
                              [el 0 iargs;
                               find_term (hd_is "sptree_insert") w],
                            list_mk_icomb "SOME" [el 1 iargs]))
                    (fun lkn -> MATCH_ACCEPT_TAC
                       (MATCH_MP MEM_mutblock_all_vs
                         (CONJ lkn mm))) THEN
                  REWRITE_TAC[lookup_insert])))) THEN
       (* another one: its element did not move *)
       TRY (SOLVED
             (W(fun (asl,w as gl) ->
                let fm = el 0 (tparts (el 3 (snd (strip_comb w)))) in
                let inj = the_asm (fun c -> hd_is "INJ" c &&
                            rand (el 0 (snd (strip_comb c))) = fm) gl in
                let pin = the_asm (fun c -> hd_is "IN" c &&
                            hd_is "FDOM" (rand c) &&
                            el 0 (snd (strip_comb c)) = g_ptr gl) gl in
                let neq = the_asm (fun c -> is_neg c &&
                            is_eq (rand c) &&
                            rand (rand c) = g_ptr gl) gl in
                let inv = the_asm (hd_is "bc_ref_inv") gl in
                MATCH_ACCEPT_TAC (MATCH_MP bc_ref_inv_update_other_gen
                  (CONJ inj (CONJ pin (CONJ neq (CONJ (a_vtr gl)
                    (CONJ (a_dtr gl) (CONJ (a_ltr gl)
                      (CONJ (a_tr gl) inv))))))))))))) THEN
    ALL_TAC)
### update_byte_ref_thm
  (* the steps are above the statement (tools/overrides.py).  The
     root of the pointer is the address of its reference, which
     v_inv of a pointer gives in the first of its three ways,
     because the reference holds an array of bytes, and the
     annotation that such a root carries is zero; the invariant of
     the reference gives the element of the heap that holds the
     bytes, and heap_lookup_SPLIT cuts the heap at it.  The store
     writes an element of the length it replaces, so the heap, the
     roots and the unused space are as good as they were, and of
     the reference written the invariant is the element with the
     bytes put in while of any other one it is the element it had,
     which the store did not touch *)
  (STRIP_TAC THEN
    (* what the invariant says of the stack with the pointer on it *)
    FIRST_X_ASSUM (fun inv ->
      if not (hd_is "abs_ml_inv" (concl inv)) then fail() else
      STRIP_ASSUME_TAC (REWRITE_RULE[abs_ml_inv_def;
                                     bc_stack_ref_inv_def] inv)) THEN
    (* the roots are the one of the pointer and the rest *)
    SPLIT_ROOTS_TAC THEN
    (* and the root of the pointer is the address of its reference *)
    FIRST_ASSUM (fun vr ->
      let c = concl vr in
      if not (hd_is "v_inv" c) ||
         not (hd_is "dataSem_RefPtr" (el 1 (snd (strip_comb c))))
      then fail()
      else STRIP_ASSUME_TAC (REWRITE_RULE[v_inv_def] vr)) THEN
    (* of the three ways a pointer is related only the first is left,
       because the reference holds an array of bytes: the two that
       are about a thunk say the reference holds one *)
    (let rws = distinctness "thunk_mode" :: ref_rws in
     RULE_ASSUM_TRY (REWRITE_RULE rws) THEN
     TRY (FIRST_ASSUM CONTR_TAC) THEN
     TRY (W(fun (asl,_) ->
       let lks = mapfilter (fun (_,th) ->
                   let c = concl th in
                   if is_eq c && hd_is "sptree_lookup" (lhand c) &&
                      hd_is "SOME" (rand c) then th else fail()) asl in
       if length lks < 2 then fail() else
       MP_TAC (TRANS (SYM (el 0 lks)) (el 1 lks)) THEN
       REWRITE_TAC (injectivity "option" ::
                    injectivity "bvlSem_ref" :: rws) THEN
       STRIP_TAC)) THEN
     SPLIT_ASM_TAC THEN
     TRY VAR_EQ_TAC) THEN
    (* the annotation that the root of an array of bytes carries is
       zero *)
    W(fun gl ->
      let lk = the_asm (fun c -> is_eq c &&
                 hd_is "sptree_lookup" (lhand c) &&
                 hd_is "SOME" (rand c)) gl in
      let an = MATCH_MP ref_ptr_annot_ByteArray lk in
      RULE_ASSUM_TRY (REWRITE_RULE[an]) THEN REWRITE_TAC[an]) THEN
    (* the reference has an address *)
    (SUBGOAL_THEN (cake_as_vars (fun () ->
       `FLOOKUP (f:(num,num)fmap) (ptr:num) = SOME (FAPPLY f ptr:num)`))
       ASSUME_TAC THENL
      [ASM_REWRITE_TAC[FLOOKUP_DEF]; ALL_TAC]) THEN
    (* and it is reachable, so the invariant holds of it *)
    (SUBGOAL_THEN (cake_as_vars (fun () ->
       `reachable_refs (RefPtr b ptr :: stack) refs ptr`))
       ASSUME_TAC THENL
      [MATCH_MP_TAC (GEN_ALL reach_refptr) THEN
       FIRST [EXISTS_TAC (cake_as_vars (fun () -> `b:bool`));
              ALL_TAC] THEN
       REWRITE_TAC[MEM];
       ALL_TAC]) THEN
    W(fun (asl,w as gl) ->
      let bri = the_asm (fun c ->
        let vs,bd = strip_forall c in
        length vs = 1 && is_imp bd &&
        hd_is "bc_ref_inv" (rand bd)) gl in
      let rr = the_asm (hd_is "reachable_refs") gl in
      let n = el 2 (snd (strip_comb (concl rr))) in
      let nin = the_asm (fun c -> hd_is "IN" c &&
                  hd_is "FDOM" (rand c) &&
                  el 0 (snd (strip_comb c)) = n) gl in
      ASSUME_TAC (MP (SPEC n bri) (CONJ rr nin))) THEN
    (* which is the arm of an array of bytes: the element of the heap
       that holds the bytes *)
    W(fun gl ->
      let lk1 = the_asm (fun c -> is_eq c &&
                  hd_is "FLOOKUP" (lhand c)) gl in
      let lk2 = the_asm (fun c -> is_eq c &&
                  hd_is "sptree_lookup" (lhand c) &&
                  hd_is "SOME" (rand c)) gl in
      FIRST_X_ASSUM (fun inv ->
        if not (hd_is "bc_ref_inv" (concl inv)) then fail() else
        ASSUME_TAC (CONV_RULE(TOP_DEPTH_CONV let_CONV)
          (REWRITE_RULE[MATCH_MP arm_BA (CONJ lk1 lk2)] inv)))) THEN
    (* so the heap is the element and what is around it *)
    W(fun gl ->
      let hl = the_asm (fun c -> is_eq c &&
                 hd_is "heap_lookup" (lhand c) &&
                 hd_is "SOME" (rand c)) gl in
      STRIP_ASSUME_TAC (ONCE_REWRITE_RULE[APPEND_SINGLE]
        (MATCH_MP heap_lookup_SPLIT hl))) THEN
    FIRST_X_ASSUM (fun e ->
      let c = concl e in
      if not (is_eq c) || not (is_var (lhand c)) ||
         not (hd_is "APPEND" (rand c)) then fail() else
      SUBST_ALL_TAC e) THEN
    (* the witnesses: the rest of the roots, the heap around the
       element, and the bytes that the element holds *)
    W(fun (asl,w as gl) ->
      let hl = the_asm (fun c -> is_eq c &&
                 hd_is "heap_lookup" (lhand c) &&
                 hd_is "SOME" (rand c)) gl in
      let old = el 1 (snd (strip_comb (lhand (concl hl)))) in
      let u = lhand (lhand (rand old)) in
      let rts = lhand (hd (conjuncts (snd (strip_exists w)))) in
      let rts = if not (is_var rts) then rts else
                rand (concl (the_asm (fun c -> is_eq c &&
                               lhand c = rts) gl)) in
      MAP_EVERY EXISTS_TAC
        [rand rts; lhand old; rand (rand old);
         el 3 (snd (strip_comb u))]) THEN
    REPEAT CONJ_TAC THEN
    TRY (SOLVED (ASM_REWRITE_TAC[])) THEN
    TRY (SOLVED (REWRITE_TAC[LENGTH_REPLICATE])) THEN
    (* the addresses that hold data are the ones that held data *)
    (W(fun (asl,w as gl) ->
       let nw = byte_heap w in
       let old = byte_heap (concl (the_asm (hd_is "heap_ok") gl)) in
       let n = genvar `:num` in
       let iso h = list_mk_icomb "isSomeDataElement"
                     [list_mk_icomb "heap_lookup" [n; h]] in
       SUBGOAL_THEN (mk_forall(n, mk_eq (iso nw, iso old)))
         ASSUME_TAC) THENL
     [MATCH_ACCEPT_TAC isSomeDataElement_byte_update; ALL_TAC]) THEN
    (* the elements that the store did not write are where they were
       (heap_lookup_byte_other), and what the invariant, a thunk and
       the other references say is what they said (BA_trans) *)
    W(fun gl ->
      let hl = the_asm (fun c -> is_eq c &&
                 hd_is "heap_lookup" (lhand c) &&
                 hd_is "SOME" (rand c)) gl in
      let pe = the_asm (fun c -> is_eq c &&
                 hd_is "fmap_apply" (lhand c) &&
                 hd_is "heap_length" (rand c)) gl in
      let le = the_asm (fun c -> is_eq c &&
                 hd_is "LENGTH" (lhand c)) gl in
      let lk = the_asm (fun c -> is_eq c &&
                 hd_is "sptree_lookup" (lhand c) &&
                 hd_is "SOME" (rand c)) gl in
      MAP_EVERY ASSUME_TAC
        (MATCH_MP heap_lookup_byte_other (CONJ hl (CONJ pe le)) ::
         CONJUNCTS (MATCH_MP BA_trans (CONJ lk (CONJ hl le))))) THEN
    (* and the invariant of the new heap and references *)
    REWRITE_TAC[abs_ml_inv_def; bc_stack_ref_inv_def] THEN
    REPEAT CONJ_TAC THEN
    TRY (SOLVED (FIRST_ASSUM ACCEPT_TAC)) THEN
    (* the roots are the ones they were, of a heap as good *)
    TRY (SOLVED
          (W(fun gl ->
             let iso = the_asm (fun c ->
               let bd = snd (strip_forall c) in
               is_eq bd && hd_is "isSomeDataElement" (lhand bd)) gl in
             let ro = the_asm (hd_is "roots_ok") gl in
             ACCEPT_TAC (MATCH_MP roots_ok_iso (CONJ ro iso))))) THEN
    (* the heap stays good (heap_ok_byte_update) *)
    TRY (SOLVED
          (W(fun gl ->
             let ho = the_asm (hd_is "heap_ok") gl in
             let le = the_asm (fun c -> is_eq c &&
                        hd_is "LENGTH" (lhand c)) gl in
             MATCH_ACCEPT_TAC (MATCH_MP heap_ok_byte_update
               (CONJ ho le))))) THEN
    (* the kind of the collection (gc_kind_byte_update) *)
    TRY (SOLVED
          (W(fun gl ->
             let gk = the_asm (hd_is "gc_kind_inv") gl in
             let le = the_asm (fun c -> is_eq c &&
                        hd_is "LENGTH" (lhand c)) gl in
             MATCH_ACCEPT_TAC (MATCH_MP gc_kind_byte_update
               (CONJ gk le))))) THEN
    (* and the unused space (unused_space_inv_byte_update) *)
    TRY (SOLVED
          (W(fun gl ->
             let us = the_asm (hd_is "unused_space_inv") gl in
             MATCH_ACCEPT_TAC (MATCH_MP unused_space_inv_byte_update
               us)))) THEN
    (* the maps of the new invariant: the addresses are the ones they
       were, and the timestamps are cut to the ones of the new
       references and stack *)
    W(fun (asl,w as gl) ->
      if not (is_exists w) then ALL_TAC else
      (let sub p = rand (lhand (concl (the_asm (fun c ->
         hd_is "SUBSET" c && hd_is p (rand c)) gl))) in
       let ats = find_term (hd_is "all_ts") w in
       EXISTS_TAC (sub "domain") THEN
       EXISTS_TAC (list_mk_icomb "DRESTRICT" [sub "all_ts"; ats]))) THEN
    REPEAT CONJ_TAC THEN TRY (SOLVED (FIRST_ASSUM ACCEPT_TAC)) THEN
    (* the addresses of the maps are the ones of the old heap *)
    TRY (SOLVED
          (W(fun gl ->
             let iso = the_asm (fun c ->
               let bd = snd (strip_forall c) in
               is_eq bd && hd_is "isSomeDataElement" (lhand bd)) gl in
             ONCE_REWRITE_TAC[iso]) THEN
           FIRST [SOLVED (FIRST_ASSUM ACCEPT_TAC);
                  SOLVED (W(fun (asl,w as gl) ->
                    let dr = find_term (hd_is "DRESTRICT") w in
                    let inj = the_asm (fun c -> hd_is "INJ" c &&
                      rand (el 0 (snd (strip_comb c))) = lhand dr) gl in
                    MATCH_ACCEPT_TAC
                      (MATCH_MP INJ_DRESTRICT inj)))])) THEN
    (* the domain of the references has the key in it *)
    TRY (SOLVED
          (REWRITE_TAC[domain_insert] THEN
           MATCH_MP_TAC SUBSET_TRANS THEN
           W(fun gl ->
             let su = the_asm (fun c -> hd_is "SUBSET" c &&
                        hd_is "domain" (rand c)) gl in
             EXISTS_TAC (rand (concl su))) THEN
           CONJ_TAC THEN TRY (FIRST_ASSUM ACCEPT_TAC) THEN
           SET_TAC[])) THEN
    (* the timestamps of the restricted map are of the stack, and
       below the counter *)
    TRY (SOLVED
          (REWRITE_TAC[(CONJUNCT1 o SPEC_ALL) DRESTRICT_DEF] THEN
           FIRST [SOLVED (REWRITE_TAC[INTER_SUBSET]);
                  SOLVED (MATCH_MP_TAC SUBSET_TRANS THEN
                          W(fun gl ->
                            let su = the_asm (fun c ->
                              hd_is "SUBSET" c &&
                              hd_is "FDOM" (lhand c)) gl in
                            EXISTS_TAC (lhand (concl su))) THEN
                          CONJ_TAC THEN
                          TRY (FIRST_ASSUM ACCEPT_TAC) THEN
                          REWRITE_TAC[INTER_SUBSET])])) THEN
    (* the blocks of the stack stay unique *)
    TRY (SOLVED
          (W(fun gl ->
             let bu = the_asm (hd_is "blocks_unique") gl in
             MATCH_ACCEPT_TAC (MATCH_MP blocks_unique_insert_ByteArray
               bu)))) THEN
    (* the values of the stack: the pointer in front and the rest *)
    W(fun (asl,w) -> if not (hd_is "ALL2" w) then ALL_TAC else
      (REWRITE_TAC[ALL2] THEN
       CONV_TAC(TOP_DEPTH_CONV BETA_CONV) THEN
       REPEAT CONJ_TAC THEN
       TRY (SOLVED
             (W(fun (asl,w as gl) ->
                let args = snd (strip_comb w) in
                let v1 = el 1 args in
                let ats = find_term (hd_is "all_ts") w in
                let vi = the_asm (fun c -> hd_is "v_inv" c &&
                           el 1 (snd (strip_comb c)) = v1 &&
                           not (el 2 (snd (strip_comb c)) =
                                  lhand ats)) gl in
                SUBGOAL_THEN
                  (list_mk_icomb "MEM" [v1; rand ats])
                  (fun mm -> MATCH_ACCEPT_TAC (MATCH_MP
                     v_inv_update_gen
                     (CONJ (a_vtr gl) (CONJ vi
                       (MP (SPECL [v1; rand ats; lhand ats]
                             MEM_stack_all_vs) mm))))) THEN
                REWRITE_TAC[MEM]))) THEN
       W(fun (asl,w as gl) ->
         let old = the_asm (fun c -> hd_is "ALL2" c &&
                     el 1 (snd (strip_comb c)) =
                       el 1 (snd (strip_comb w))) gl in
         let ats = find_term (hd_is "all_ts") w in
         let vs = el 1 (snd (strip_comb w)) in
         let v = genvar (hd (snd (dest_type (type_of (rand ats))))) in
         SUBGOAL_THEN
           (mk_forall(v, mk_imp(list_mk_icomb "MEM" [v; vs],
              list_mk_icomb "IN"
                [v; list_mk_icomb "all_vs" [lhand ats; rand ats]])))
           (fun mem -> ACCEPT_TAC (MATCH_MP EVERY2_v_inv_update_stack
              (CONJ (a_vtr gl) (CONJ mem old)))) THEN
         REPEAT STRIP_TAC THEN
         W(fun gl ->
           let mm = the_asm (hd_is "MEM") gl in
           let v1 = el 0 (snd (strip_comb (concl mm))) in
           SUBGOAL_THEN (list_mk_icomb "MEM" [v1; rand ats])
             (fun m2 -> MATCH_ACCEPT_TAC (MP (SPECL [v1; rand ats;
                          lhand ats] MEM_stack_all_vs) m2)) THEN
           ASM_REWRITE_TAC[MEM])))) THEN
    (* and the invariant of each reference that the stack reaches: it
       was reachable before the store (reach_refs_update_byte) *)
    W(fun (asl,w) -> if not (is_forall w) then ALL_TAC else
      (REPEAT STRIP_TAC THEN
       W(fun gl ->
         let rr = the_asm (fun c -> hd_is "reachable_refs" c &&
                    hd_is "sptree_insert"
                      (el 1 (snd (strip_comb c)))) gl in
         ASSUME_TAC (MATCH_MP reach_refs_update_byte
           (CONJ rr (a_lkptr gl)))) THEN
       W(fun (asl,w as gl) ->
         let n = el 1 (snd (strip_comb w)) in
         let bri = the_asm (fun c ->
           let vs,bd = strip_forall c in
           length vs = 1 && is_imp bd &&
           hd_is "bc_ref_inv" (rand bd)) gl in
         let rr = the_asm (fun c -> hd_is "reachable_refs" c &&
           not (hd_is "sptree_insert"
                  (el 1 (snd (strip_comb c))))) gl in
         let nin = the_asm (fun c -> hd_is "IN" c &&
           hd_is "FDOM" (rand c) &&
           el 0 (snd (strip_comb c)) = n) gl in
         ASSUME_TAC (MP (SPEC n bri) (CONJ rr nin))) THEN
       (* the reference written, or another one *)
       W(fun (asl,w as gl) ->
         ASM_CASES_TAC (mk_eq (el 1 (snd (strip_comb w)),
                               g_ptr gl))) THEN
       TRY VAR_EQ_TAC THEN
       (* the one written: the element holds the bytes put in *)
       TRY (SOLVED
             (W(fun gl ->
                let lk1 = the_asm (fun c -> is_eq c &&
                            hd_is "FLOOKUP" (lhand c)) gl in
                let hl = the_asm (fun c -> is_eq c &&
                           hd_is "heap_lookup" (lhand c) &&
                           hd_is "SOME" (rand c)) gl in
                let pe = the_asm (fun c -> is_eq c &&
                           hd_is "fmap_apply" (lhand c) &&
                           hd_is "heap_length" (rand c)) gl in
                let le = the_asm (fun c -> is_eq c &&
                           hd_is "LENGTH" (lhand c)) gl in
                let ws = el 3 (snd (strip_comb
                           (rand (rand (concl hl))))) in
                MATCH_ACCEPT_TAC (MATCH_MP bc_ref_inv_update_byte_at
                  (CONJ lk1 (CONJ hl (CONJ pe (CONJ (a_lkptr gl)
                    (CONJ le (REFL ws)))))))))) THEN
       (* another one: its element did not move *)
       TRY (SOLVED
             (W(fun (asl,w as gl) ->
                let fm = el 0 (tparts (el 3 (snd (strip_comb w)))) in
                let inj = the_asm (fun c -> hd_is "INJ" c &&
                            rand (el 0 (snd (strip_comb c))) = fm) gl in
                let pin = the_asm (fun c -> hd_is "IN" c &&
                            hd_is "FDOM" (rand c) &&
                            el 0 (snd (strip_comb c)) = g_ptr gl) gl in
                let neq = the_asm (fun c -> is_neg c &&
                            is_eq (rand c) &&
                            rand (rand c) = g_ptr gl) gl in
                let inv = the_asm (hd_is "bc_ref_inv") gl in
                MATCH_ACCEPT_TAC (MATCH_MP bc_ref_inv_update_other_gen
                  (CONJ inj (CONJ pin (CONJ neq (CONJ (a_vtr gl)
                    (CONJ (a_dtr gl) (CONJ (a_ltr gl)
                      (CONJ (a_tr gl) inv))))))))))))) THEN
    ALL_TAC)
### new_ref_thm
  (* the attempt: the proof of the source names abs_ml_inv_def,
     bc_stack_ref_inv_def, EVERY2_APPEND_IMP_APPEND, el_length_def,
     RefBlock_def, unused_space_inv_def.  What is here rewrites with
     them and closes by arithmetic, and the cheat is behind it until
     the proof is written.  A MESON over them is what the next round
     adds; it costs a load ten minutes to have it in every attempt
     and it closed none of them *)
  (ATTEMPT_TAC 2
    (REPEAT GEN_TAC THEN REPEAT STRIP_TAC THEN
     ASM_REWRITE_TAC[abs_ml_inv_def; bc_stack_ref_inv_def;
       EVERY2_APPEND_IMP_APPEND; el_length_def; RefBlock_def;
       unused_space_inv_def] THEN
     TRY ASM_ARITH_TAC))
### new_thunk_thm
  (* the attempt: the proof of the source names abs_ml_inv_def,
     bc_stack_ref_inv_def, EVERY2_APPEND_IMP_APPEND, el_length_def,
     ThunkBlock_def, unused_space_inv_def.  What is here rewrites
     with them and closes by arithmetic, and the cheat is behind it
     until the proof is written.  A MESON over them is what the next
     round adds; it costs a load ten minutes to have it in every
     attempt and it closed none of them *)
  (ATTEMPT_TAC 2
    (REPEAT GEN_TAC THEN REPEAT STRIP_TAC THEN
     ASM_REWRITE_TAC[abs_ml_inv_def; bc_stack_ref_inv_def;
       EVERY2_APPEND_IMP_APPEND; el_length_def; ThunkBlock_def;
       unused_space_inv_def] THEN
     TRY ASM_ARITH_TAC))
### deref_thm
  (* the attempt: the proof of the source names abs_ml_inv_def,
     bc_stack_ref_inv_def, v_inv_def, reachable_refs_def,
     bc_ref_inv_def, FLOOKUP_DEF.  What is here rewrites with them
     and closes by arithmetic, and the cheat is behind it until the
     proof is written.  A MESON over them is what the next round
     adds; it costs a load ten minutes to have it in every attempt
     and it closed none of them *)
  (ATTEMPT_TAC 2
    (REPEAT GEN_TAC THEN REPEAT STRIP_TAC THEN
     ASM_REWRITE_TAC[abs_ml_inv_def; bc_stack_ref_inv_def;
       v_inv_def; reachable_refs_def; bc_ref_inv_def;
       FLOOKUP_DEF] THEN
     TRY ASM_ARITH_TAC))
### el_thm
  (* the steps that this lemma and the ones after it take are
     above the statement (tools/overrides.py).  The roots are a
     cons whose head is the Block's pointer, the element of the
     payload at the index is the element of its representation
     there, and the invariant of the new stack is the old one
     with that value in front *)
  (STRIP_TAC THEN
   (* what the invariant says of the stack with the Block at its
      head *)
   FIRST_X_ASSUM (fun inv ->
     if not (hd_is "abs_ml_inv" (concl inv)) then fail() else
     STRIP_ASSUME_TAC (REWRITE_RULE[abs_ml_inv_def;
                                    bc_stack_ref_inv_def] inv)) THEN
   (* the roots are a cons, and its head is the Block's *)
   W(fun gl ->
     let lr = the_asm (fun c -> hd_is "ALL2" c) gl in
     CASES_ON_TAC (el 2 (snd (strip_comb (concl lr))))) THEN
   RULE_ASSUM_TRY (REWRITE_RULE[ALL2_DEF; HD; TL; NOT_CONS_NIL]) THEN
   TRY (FIRST_ASSUM CONTR_TAC) THEN
   SPLIT_ASM_TAC THEN
   (* the payload is not empty, because the index is below its
      length *)
   SUBGOAL_THEN `~((xs:dataSem_v list) = [])` ASSUME_TAC THENL
    [REWRITE_TAC[GSYM LENGTH_EQ_NIL] THEN ASM_ARITH_TAC;
     ALL_TAC] THEN
   (* the Block is a pointer at its representation in the heap; the
      invariant of the Block itself is kept, because the values of
      the new stack ask for it *)
   FIRST_ASSUM (fun vb ->
     if not (hd_is "v_inv" (concl vb)) then fail() else
     STRIP_ASSUME_TAC (REWRITE_RULE[v_inv_def;
       ASSUME `~((xs:dataSem_v list) = [])`] vb)) THEN
   VAR_EQ_TAC THEN
   (* the witnesses: the head of the roots, its tail, and the
      element of the Block's representation at the index *)
   W(fun (asl,w as gl) ->
     let cns = lhs (hd (conjuncts (snd (strip_exists w)))) in
     let ys = el 1 (snd (strip_comb (rand (rand
                (concl (blockrep_asm gl)))))) in
     EXISTS_TAC (lhand cns) THEN EXISTS_TAC (rand cns) THEN
     EXISTS_TAC (list_mk_icomb "EL" [`i:num`; ys])) THEN
   (* the payload and its representation are of a length *)
   FIRST_ASSUM (fun lr ->
     if not (hd_is "ALL2" (concl lr)) then fail() else
     ASSUME_TAC (MATCH_MP LIST_REL_LENGTH lr)) THEN
   (* so the index is below the length of the representation *)
   W(fun gl ->
     let lt = the_asm (hd_is "<") gl in
     let le = the_asm (fun c -> is_eq c &&
                hd_is "LENGTH" (lhand c)) gl in
     SUBGOAL_THEN (mk_binop `(<):num->num->bool`
                     (lhand (concl lt)) (rand (concl le)))
       ASSUME_TAC THENL [ASM_ARITH_TAC; ALL_TAC]) THEN
   REPEAT CONJ_TAC THEN
   TRY (SOLVED REFL_TAC) THEN
   (* what the heap holds at the index *)
   TRY (SOLVED
         (W(fun gl ->
            let hl = blockrep_asm gl in
            let lt = the_asm (fun c -> hd_is "<" c &&
                       hd_is "LENGTH" (rand c)) gl in
            MATCH_ACCEPT_TAC (MATCH_MP heap_el_block
              (CONJ hl lt))))) THEN
   (* the invariant with the element on the stack *)
   REWRITE_TAC[abs_ml_inv_def; bc_stack_ref_inv_def] THEN
   REPEAT CONJ_TAC THEN TRY (FIRST_ASSUM ACCEPT_TAC) THEN
   (* the new root is a pointer of the Block's element, and the
      pointers of a good heap are addresses of it *)
   TRY (SOLVED
         (W(fun gl ->
            let ho = the_asm (hd_is "heap_ok") gl in
            let hl = blockrep_asm gl in
            let lt = the_asm (fun c -> hd_is "<" c &&
                       hd_is "LENGTH" (rand c)) gl in
            let ro = the_asm (hd_is "roots_ok") gl in
            MATCH_ACCEPT_TAC (MATCH_MP roots_ok_el
              (CONJ ho (CONJ hl (CONJ lt ro))))))) THEN
   (* the two maps are the same ones *)
   W(fun gl ->
     let sub p = rand (lhand (concl (the_asm (fun c ->
       hd_is "SUBSET" c && hd_is p (rand c)) gl))) in
     EXISTS_TAC (sub "domain") THEN EXISTS_TAC (sub "all_ts")) THEN
   REPEAT CONJ_TAC THEN TRY (FIRST_ASSUM ACCEPT_TAC) THEN
   (* the timestamps of the stack only grow *)
   TRY (SOLVED
         (MATCH_MP_TAC SUBSET_TRANS THEN
          W(fun gl ->
            let s = the_asm (fun c -> hd_is "SUBSET" c &&
                      hd_is "all_ts" (rand c)) gl in
            EXISTS_TAC (rand (concl s))) THEN
          CONJ_TAC THEN TRY (FIRST_ASSUM ACCEPT_TAC) THEN
          MATCH_ACCEPT_TAC all_ts_mono)) THEN
   (* the blocks of the stack stay unique *)
   TRY (SOLVED
         (MATCH_MP_TAC (GEN_ALL blocks_unique_el) THEN
          CONJ_TAC THEN FIRST_ASSUM ACCEPT_TAC)) THEN
   (* the values of the stack are the old ones and the element *)
   (* the values of the stack are the old ones and the element,
      which the relation of the payload gives at the index
      (all2_el_cons) *)
   TRY (SOLVED
         (MATCH_MP_TAC all2_el_cons THEN
          CONV_TAC(TOP_DEPTH_CONV BETA_CONV) THEN
          REPEAT CONJ_TAC THEN TRY (FIRST_ASSUM ACCEPT_TAC) THEN
          POP_ASSUM_LIST (fun l -> MAP_EVERY ASSUME_TAC (filter
            (fun t -> let c = concl t in
               hd_is "<" c ||
               (is_eq c && (hd_is "LENGTH" (lhand c) ||
                            hd_is "LENGTH" (rand c)))) l)) THEN
          ASM_ARITH_TAC)) THEN
   (* and a reference that the element reaches is one that the
      Block reaches *)
   REPEAT STRIP_TAC THEN
   FIRST_X_ASSUM (fun bri ->
     let b = snd (strip_forall (concl bri)) in
     if not (is_imp b) || not (hd_is "bc_ref_inv" (rand b))
     then fail() else MATCH_MP_TAC bri) THEN
   CONJ_TAC THEN TRY (FIRST_ASSUM ACCEPT_TAC) THEN
   MATCH_MP_TAC (GEN_ALL reach_block) THEN
   W(fun gl ->
     let rr = the_asm (hd_is "reachable_refs") gl in
     EXISTS_TAC (lhand (el 0 (snd (strip_comb (concl rr)))))) THEN
   CONJ_TAC THEN TRY (FIRST_ASSUM ACCEPT_TAC) THEN
   MEM_CLOSE)
