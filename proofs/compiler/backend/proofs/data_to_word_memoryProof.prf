     CONV_TAC NUM_REDUCE_CONV THEN REWRITE_TAC[] THEN
     MATCH_REDUCE_TAC THEN
     REWRITE_TAC[GSYM WORD_ADD] THEN CONV_TAC NUM_REDUCE_CONV in
