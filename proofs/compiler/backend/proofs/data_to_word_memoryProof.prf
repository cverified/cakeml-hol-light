   MEMORY_REL_TAC THEN CASES_ON_NAME "v1" THEN
   RULE_ASSUM_TAC(REWRITE_RULE[injectivity "dataSem_v";
                               noforall]) THEN
   V_INV_TAC THEN ASM_REWRITE_TAC[])
