### write_bytes_inj
  (* the induction of the source over the list of words.  The source
     takes the bytes of a word off the list one at a time and reads
     each of them with get_byte; here get_byte_bytes_to_word says it
     of every byte of the first word at once (gbd), so the bytes
     before the first word's worth are the same, the induction
     hypothesis says it of the bytes after them, and LIST_EQ puts
     the two halves together *)
  (let gbd = prove
    (`!zs i (t:'a word) be'.
        good_dimindex (:'a) /\ i < LENGTH zs /\
        i < dimindex (:'a) DIV 8
        ==> get_byte (n2w i)
              (bytes_to_word (dimindex (:'a) DIV 8) (n2w 0) zs t be')
              be' = EL i zs`,
     REPEAT GEN_TAC THEN STRIP_TAC THEN
     FIRST_ASSUM (fun gd ->
       DISJ_CASES_THEN (fun eq ->
         let n = if dest_small_numeral (rand (concl eq)) = 32
                 then 2 else 3 in
         let th = CONV_RULE NUM_REDUCE_CONV
                    (GEN_ALL (INST [mk_small_numeral n,`k:num`]
                       get_byte_bytes_to_word)) in
         RULE_ASSUM_TAC(REWRITE_RULE[eq]) THEN
         RULE_ASSUM_TAC(CONV_RULE NUM_REDUCE_CONV) THEN
         REWRITE_TAC[eq] THEN CONV_TAC NUM_REDUCE_CONV THEN
         MATCH_MP_TAC th THEN
         REPEAT CONJ_TAC THEN TRY (FIRST_ASSUM ACCEPT_TAC) THEN
         REWRITE_TAC[eq] THEN CONV_TAC NUM_REDUCE_CONV)
         (REWRITE_RULE[good_dimindex_def] gd))) in
   (* the bytes in a word, as the goal and the assumptions have it *)
   let kof (asl,w) =
     find_term (fun t -> hd_is "DIV" t && hd_is "dimindex" (lhand t))
       (list_mk_conj (w :: map (concl o snd) asl)) in
   let nil_of t = mk_list([], hd (snd (dest_type (type_of t)))) in
   DISCH_TAC THEN
   (* a word holds at least one byte *)
   W(fun (asl,w) ->
     SUBGOAL_THEN (mk_binop `(<):num->num->bool` `0` (kof (asl,w)))
       ASSUME_TAC THENL
      [FIRST_ASSUM MP_TAC THEN REWRITE_TAC[good_dimindex_def] THEN
       DISCH_THEN(DISJ_CASES_THEN SUBST1_TAC) THEN
       CONV_TAC NUM_REDUCE_CONV;
       ALL_TAC]) THEN
   LIST_INDUCT_TAC THEN REPEAT GEN_TAC THEN
   REWRITE_TAC[write_bytes_def; LENGTH; MULT_CLAUSES] THENL
    [(* no word at all, so there is no byte either *)
     STRIP_TAC THEN REWRITE_TAC[] THEN
     W(fun (asl,w) ->
       MAP_EVERY (fun b ->
         SUBGOAL_THEN (mk_eq (b, nil_of b)) SUBST_ALL_TAC THENL
          [REWRITE_TAC[GSYM LENGTH_EQ_NIL] THEN ASM_ARITH_TAC;
           ALL_TAC])
         [lhs w; rhs w]) THEN
     REWRITE_TAC[];
     ALL_TAC] THEN
   CONV_TAC(DEPTH_CONV let_CONV) THEN
   REWRITE_TAC[CONS_11] THEN
   STRIP_TAC THEN
   EQ_TAC THENL
    [ALL_TAC;
     DISCH_THEN SUBST1_TAC THEN REWRITE_TAC[]] THEN
   STRIP_TAC THEN
   (* the bytes after the first word are the same *)
   W(fun (asl,w) ->
     let k = kof (asl,w) in
     let b1 = lhs w and b2 = rhs w in
     SUBGOAL_THEN (mk_eq (list_mk_icomb "DROP" [k; b1],
                          list_mk_icomb "DROP" [k; b2]))
       ASSUME_TAC THENL
      [ASM_CASES_TAC (mk_binop `(<=):num->num->bool` k
                        (list_mk_icomb "LENGTH" [b1])) THENL
        [(* by the induction hypothesis, for the rest of the words *)
         FIRST_X_ASSUM (fun ih ->
           MP_TAC (SPECL [list_mk_icomb "DROP" [k; b1];
                          list_mk_icomb "DROP" [k; b2]] ih)) THEN
         REWRITE_TAC[LENGTH_DROP] THEN
         ANTS_TAC THENL
          [REPEAT CONJ_TAC THEN
           TRY (W(fun (asl,w) ->
             let dv = find_term (fun t -> hd_is "DIV" t &&
                        not (hd_is "dimindex" (lhand t))) w in
             MP_TAC (SPECL [lhand (lhand dv); rand dv]
                       DIV_SUB_STEP)) THEN
             ANTS_TAC THENL [ASM_ARITH_TAC; ALL_TAC] THEN
             DISCH_THEN SUBST1_TAC) THEN
           ASM_ARITH_TAC;
           ALL_TAC] THEN
         DISCH_THEN (fun iff -> REWRITE_TAC[GSYM iff]) THEN
         FIRST_ASSUM ACCEPT_TAC;
         (* or there is no byte after the first word *)
         W(fun (asl,w) ->
           MAP_EVERY (fun d ->
             SUBGOAL_THEN (mk_eq (d, nil_of d)) SUBST1_TAC THENL
              [REWRITE_TAC[DROP_NIL] THEN ASM_ARITH_TAC; ALL_TAC])
             [lhs w; rhs w]) THEN
         REWRITE_TAC[]];
       ALL_TAC]) THEN
   (* and then every byte of the two is the same *)
   ONCE_REWRITE_TAC[LIST_EQ] THEN
   CONJ_TAC THENL [FIRST_ASSUM ACCEPT_TAC; ALL_TAC] THEN
   X_GEN_TAC `i:num` THEN DISCH_TAC THEN
   W(fun (asl,w) ->
     ASM_CASES_TAC (mk_binop `(<):num->num->bool` `i:num`
                      (kof (asl,w)))) THENL
    [(* a byte of the first word, which the two words agree on *)
     FIRST_ASSUM (fun he ->
       if not (is_eq (concl he) &&
               hd_is "bytes_to_word" (lhs (concl he))) then fail()
       else
       let a1 = snd (strip_comb (lhs (concl he))) in
       let a2 = snd (strip_comb (rhs (concl he))) in
       MP_TAC (SPECL [el 2 a1; `i:num`; el 3 a1; el 4 a1] gbd) THEN
       MP_TAC (SPECL [el 2 a2; `i:num`; el 3 a2; el 4 a2] gbd)) THEN
     ASM_REWRITE_TAC[] THEN
     DISCH_THEN (SUBST1_TAC o SYM) THEN
     DISCH_THEN (SUBST1_TAC o SYM) THEN
     ASM_REWRITE_TAC[];
     (* or a byte after it, where the two rests agree *)
     W(fun (asl,w) ->
       let k = kof (asl,w) in
       let b1 = rand (lhs w) and b2 = rand (rhs w) in
       let d = mk_binop `(-):num->num->num` `i:num` k in
       MP_TAC (ISPECL [b1; d; k] EL_DROP) THEN
       MP_TAC (ISPECL [b2; d; k] EL_DROP)) THEN
     ASM_SIMP_TAC[ARITH_RULE
       `~(i < k) /\ i < n ==> (i - k) + k < n`] THEN
     ASM_SIMP_TAC[ARITH_RULE `~(i < k) ==> (i - k) + k = i`] THEN
     DISCH_THEN (SUBST1_TAC o SYM) THEN
     DISCH_THEN (SUBST1_TAC o SYM) THEN
     ASM_REWRITE_TAC[]])
