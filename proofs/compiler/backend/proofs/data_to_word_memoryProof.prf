     REWRITE_TAC[good_dimindex_def] THEN
     DISCH_THEN(DISJ_CASES_THEN (fun eq ->
       let n = dest_small_numeral (rand (concl eq)) / 8 in
       let all = if n = 4 then set_byte_all_32
                 else set_byte_all_64 in
       SUBST1_TAC eq THEN CONV_TAC NUM_REDUCE_CONV THEN
       ntimes n SPLIT1 THEN ntimes (n + 1) UNFOLD1 THEN
       DISCH_THEN (K ALL_TAC) THEN
       MATCH_ACCEPT_TAC
         (GEN_ALL (MATCH_MP (GEN_ALL all) eq))))) in
