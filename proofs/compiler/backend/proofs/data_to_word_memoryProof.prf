       FIRST_X_ASSUM(fun ih -> MP_TAC(SPECL
         [`tf:(num,num)fmap`; `ts + 1`; `k + i`; `i:num`; `x:num`]
         ih)) THEN
       ANTS_TAC THENL
        [REPEAT CONJ_TAC THEN TRY(FIRST_ASSUM ACCEPT_TAC) THEN
