### word_eq
  (MATCH_ACCEPT_TAC WORD_EQ_BITS)
### ZIP_REPLICATE
  (INDUCT_TAC THEN ASM_REWRITE_TAC[REPLICATE; ZIP])

### MEM_EL_APPEND_MID
  (* the element is one of the list, and MEM of the three parts is
     what the split of the append and of the singleton says *)
  (let lem = MESON[MEM_APPEND; MEM]
     `!e l c r. MEM e (APPEND l (APPEND [c] r))
                ==> MEM e l \/ e = c \/ MEM e r` in
   REPEAT STRIP_TAC THEN MATCH_MP_TAC lem THEN MATCH_MP_TAC MEM_EL THEN
   ASM_REWRITE_TAC[LENGTH_APPEND; LENGTH] THEN ASM_ARITH_TAC)
### MAX_LIST_sum_bound
  (* HOL4's SUM is ITLIST (+) l 0 in the port (ml/lib/hol4.ml), so
     its clauses come first *)
  (let sum_cl = prove
    (`SUM [] = 0 /\ (!h t. SUM (CONS h t) = h + SUM t)`,
     REWRITE_TAC[SUM_DEF; ITLIST]) in
   SPEC_TAC(`ls:num list`,`ls:num list`) THEN LIST_INDUCT_TAC THEN
   REWRITE_TAC[sum_cl; MAX_LIST; LENGTH; MULT_CLAUSES; LE_REFL] THEN
   MATCH_MP_TAC LE_ADD2 THEN CONJ_TAC THENL
   [REWRITE_TAC[ARITH_RULE `a <= MAX a b`];
    MATCH_MP_TAC LE_TRANS THEN
    EXISTS_TAC `MAX_LIST (t:num list) * LENGTH t` THEN
    ASM_REWRITE_TAC[LE_MULT_RCANCEL] THEN DISJ1_TAC THEN
    REWRITE_TAC[ARITH_RULE `b <= MAX a b`]])

### MAX_LIST_bounded_elements
  (LIST_INDUCT_TAC THEN GEN_TAC THEN CASES_BY_NAME "l2" THEN
   REWRITE_TAC[ALL2; MAX_LIST; LE_REFL] THEN STRIP_TAC THEN
   MATCH_MP_TAC(ARITH_RULE
     `a <= c /\ b <= d ==> MAX a b <= MAX c d`) THEN
   ASM_SIMP_TAC[])

### MAX_LIST_MAP
  (* a strictly monotonic f is monotonic, so it commutes with MAX,
     and the induction is then a rewrite; the last goal is the one
     of the empty tail, where MAX_LIST [] = 0 and f 0 <= f h *)
  (REPEAT GEN_TAC THEN DISCH_TAC THEN
   SUBGOAL_THEN `!a b:num. (f:num->num) a <= f b <=> a <= b`
     ASSUME_TAC THENL
    [REPEAT GEN_TAC THEN
     ASM_CASES_TAC `a:num <= b` THEN ASM_REWRITE_TAC[] THENL
      [ASM_CASES_TAC `a:num = b` THENL
        [ASM_REWRITE_TAC[LE_REFL];
         MATCH_MP_TAC LT_IMP_LE THEN FIRST_ASSUM MATCH_MP_TAC THEN
         ASM_ARITH_TAC];
       REWRITE_TAC[NOT_LE] THEN FIRST_ASSUM MATCH_MP_TAC THEN
       ASM_ARITH_TAC];
     ALL_TAC] THEN
   SUBGOAL_THEN `!a b:num. (f:num->num) (MAX a b) = MAX (f a) (f b)`
     ASSUME_TAC THENL
    [REPEAT GEN_TAC THEN ASM_REWRITE_TAC[MAX] THEN
     COND_CASES_TAC THEN REWRITE_TAC[]; ALL_TAC] THEN
   SPEC_TAC(`l:num list`,`l:num list`) THEN
   LIST_INDUCT_TAC THEN REWRITE_TAC[MAP; MAX_LIST; NULL; NULL_EQ] THEN
   ASM_CASES_TAC `t:num list = []` THEN
   ASM_REWRITE_TAC[MAP; MAX_LIST; NULL; NULL_EQ] THEN
   REWRITE_TAC[ARITH_RULE `MAX x 0 = x`] THEN
   ASM_REWRITE_TAC[MAX] THEN COND_CASES_TAC THEN REWRITE_TAC[] THEN
   AP_TERM_TAC THEN ASM_ARITH_TAC)
### w2i_i2w_IMP
  (* the bound that the round trip of an integer through a word
     gives: HOL Light's ival of a word is between the two powers,
     and the integer that the word has as its ival is the one *)
  (DISCH_TAC THEN
   MP_TAC(ISPEC `(i2w i):'a word` IVAL_BOUND) THEN
   ASM_REWRITE_TAC[] THEN
   REWRITE_TAC[integer_word_INT_MIN; integer_word_INT_MAX; INT_MIN;
               GSYM INT_OF_NUM_POW] THEN
   INT_ARITH_TAC)
### word_i2w_sub
  (REWRITE_TAC[IWORD_INT_SUB])
### Word64Rep_DataElement
  (* the first argument is the type itself, which the clause of the
     definition fixes, so the lambda form of it is what rewrites
     here; the witness is the list that the branch has *)
  (let take_ws (asl,w as gl) =
     let bod = snd(dest_exists w) in
     let ws = snd(dest_pair(last(snd(strip_comb(lhs bod))))) in
     (EXISTS_TAC ws THEN REWRITE_TAC[LENGTH; ARITH]) gl in
   REPEAT GEN_TAC THEN REWRITE_TAC[cake_raw "Word64Rep"] THEN
   COND_CASES_TAC THEN take_ws)
### ThunkBlock_11
  (REWRITE_TAC[ThunkBlock_def; injectivity "heap_element";
               injectivity "data_to_word_memoryProof_tag"; CONS_11;
               PAIR_EQ] THEN
   CONV_TAC TAUT)
### v_inv_ck_mono
  (* rule induction: every rule asks for the relation at ck - 1 and
     only when ck is not 0, so a smaller ck asks for less.  The two
     thunk rules name their value and their heap element in the
     premises and not in the conclusion, which a MATCH_MP_TAC would
     leave undetermined, so MESON applies them *)
  (let (vr,vi,vc) = v_inv_ck in
   let rl = CONJUNCTS vr in
   let _ = vc in
   let ar = ARITH_RULE
     `!a b. a <= b /\ ~(a = 0) ==> ~(b = 0) /\ a - 1 <= b - 1` in
   let PRE_TAC = REPEAT GEN_TAC THEN REPEAT STRIP_TAC in
   let mono = prove
    (`!ck conf (v:dataSem_v) refs y.
        v_inv_ck ck conf v refs y
        ==> !ck'. ck' <= ck ==> v_inv_ck ck' conf v refs y`,
     MATCH_MP_TAC vi THEN REPEAT CONJ_TAC THENL
      [PRE_TAC THEN MATCH_MP_TAC(el 0 rl) THEN ASM_REWRITE_TAC[];
       PRE_TAC THEN MATCH_MP_TAC(el 1 rl) THEN ASM_REWRITE_TAC[];
       PRE_TAC THEN MATCH_MP_TAC(el 2 rl) THEN ASM_REWRITE_TAC[];
       PRE_TAC THEN MATCH_ACCEPT_TAC(el 3 rl);
       PRE_TAC THEN MATCH_MP_TAC(el 4 rl) THEN ASM_REWRITE_TAC[];
       PRE_TAC THEN ASM_MESON_TAC[el 5 rl; ar];
       PRE_TAC THEN ASM_MESON_TAC[el 6 rl; ar];
       PRE_TAC THEN MATCH_MP_TAC(el 7 rl) THEN ASM_REWRITE_TAC[];
       (* and the elements of a Block one by one, with the ck of the
          induction hypothesis brought down to the new one *)
       PRE_TAC THEN MATCH_MP_TAC(el 8 rl) THEN
       ASM_REWRITE_TAC[] THEN REPEAT CONJ_TAC THEN
       TRY(FIRST_ASSUM MATCH_ACCEPT_TAC) THEN DISCH_TAC THEN
       FIRST_ASSUM(fun le -> FIRST_ASSUM(fun nz ->
         let a = MATCH_MP ar (CONJ le nz) in
         FIRST_X_ASSUM(fun ih ->
           MP_TAC(MATCH_MP ih (CONJUNCT1 a))) THEN
         MATCH_MP_TAC MONO_ALL2 THEN BETA_TAC THEN
         REPEAT STRIP_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
         MATCH_ACCEPT_TAC(CONJUNCT2 a)))]) in
   REPEAT STRIP_TAC THEN ASM_MESON_TAC[mono])
### v_inv_def
  (* v_inv is v_inv_ck for every ck, so each clause is the cases
     theorem of the relation with the constructor of the value put
     in: the disjuncts of the other constructors go by
     distinctness, and the existentials of the rule are unwound
     against the arguments of the clause.
     Where a rule is recursive the two directions differ.  From a
     clause to the relation the value of the clause holds for every
     ck, so it holds for ck - 1.  The other way round the witness
     of the rule has to be the same for every ck: of a Block it is,
     because the pointer of x fixes the heap element and the
     element fixes the list (ALL2_SWAP then pulls the ck out of the
     list).  Of a RefPtr there are two rules for a thunk -- the
     value lives in a ThunkBlock of the heap, or it is x itself --
     and a derivation may use either at any ck.  So the one that
     every ck admits is found by taking the ck at which the other
     one fails and using v_inv_ck_mono to bring a derivation of a
     greater ck down to it *)
  (let (vr,vi,vc) = v_inv_ck in
   let rl = CONJUNCTS vr in
   let mono_thm = v_inv_ck_mono in
   let unw = CONV_TAC(REDEPTH_CONV UNWIND_CONV) THEN
             REWRITE_TAC tidy_rws in
   let cas th = ONCE_REWRITE_RULE[vc] th in
   let dis = [distinctness "dataSem_v"; injectivity "dataSem_v";
              PAIR_EQ] in
   let base = REWRITE_TAC[v_inv_eq] THEN ONCE_REWRITE_TAC[vc] THEN
              REWRITE_TAC dis THEN unw in
   let ls_tm = `ys:(('a word_loc)heap_address)list` in
   let y_tm = `y:(('a word_loc)heap_address)` in
   (* a Block of a value that is no list of its own *)
   let blk_tac =
     REWRITE_TAC[v_inv_eq] THEN
     ASM_CASES_TAC `vs:(dataSem_v) list = []` THEN
     ASM_REWRITE_TAC[] THENL
      [base;
       EQ_TAC THENL
        [DISCH_TAC THEN
         FIRST_ASSUM(fun th -> MP_TAC(cas (SPEC `0` th))) THEN
         REWRITE_TAC dis THEN unw THEN ASM_REWRITE_TAC[] THEN
         DISCH_THEN(X_CHOOSE_THEN `p:num`
           (X_CHOOSE_THEN ls_tm STRIP_ASSUME_TAC)) THEN
         SUBST_LHS_TAC THEN
         MAP_EVERY EXISTS_TAC [`p:num`; ls_tm] THEN
         ASM_REWRITE_TAC[] THEN
         MATCH_MP_TAC ALL2_SWAP THEN X_GEN_TAC `ck:num` THEN
         FIRST_ASSUM(fun th -> MP_TAC(cas (SPEC `ck + 1` th))) THEN
         REWRITE_TAC(dis @ [injectivity "heap_address";
                            distinctness "heap_address"]) THEN
         unw THEN ASM_REWRITE_TAC[] THEN
         REWRITE_TAC[injectivity "option"; BlockRep_def;
                     injectivity "heap_element"; PAIR_EQ] THEN
         unw THEN
         REWRITE_TAC[ARITH_RULE `~(ck + 1 = 0)`;
                     ARITH_RULE `(ck + 1) - 1 = ck`] THEN
         DISCH_TAC THEN FIRST_ASSUM MATCH_ACCEPT_TAC;
         DISCH_THEN(X_CHOOSE_THEN `p:num`
           (X_CHOOSE_THEN ls_tm STRIP_ASSUME_TAC)) THEN
         X_GEN_TAC `ck:num` THEN SUBST_LHS_TAC THEN
         MATCH_MP_TAC(el 8 rl) THEN
         REPEAT CONJ_TAC THEN TRY(FIRST_ASSUM MATCH_ACCEPT_TAC) THEN
         DISCH_TAC THEN
         FIRST_ASSUM(fun th ->
           if can (term_match []
                     `EVERY2 (p:A->B->bool) l m`) (concl th)
           then MP_TAC th else fail()) THEN
         MATCH_MP_TAC MONO_ALL2 THEN BETA_TAC THEN
         REPEAT STRIP_TAC THEN FIRST_ASSUM MATCH_ACCEPT_TAC]] in
   (* a RefPtr: the thunk of the two recursive rules is named by the
      lookup of the refs and its heap element by the pointer, so a
      derivation of one ck tells what the other ones must say *)
   let step = prove
    (`!ck conf n (refs:(dataSem_v bvlSem_ref) spt) b ev vv y x f tf
         (heap:(('a word_loc,data_to_word_memoryProof_tag#('a
           word_loc) list)heap_element) list).
        v_inv_ck (ck + 1) conf (RefPtr b n) refs (x,f,tf,heap) /\
        lookup n refs = SOME (Thunk ev vv) /\
        heap_lookup (FAPPLY f n) heap = SOME (ThunkBlock ev y)
        ==> (n IN FDOM f /\ ~b /\
             x = gc_shared_Pointer (FAPPLY f n)
                   (wordLang_Word (n2w 0)) /\
             (ev = Evaluated ==> dest_thunk vv refs = NotThunk) /\
             v_inv_ck ck conf vv refs (y,f,tf,heap)) \/
            (ev = Evaluated /\ dest_thunk vv refs = NotThunk /\ ~b /\
             v_inv_ck ck conf vv refs (x,f,tf,heap))`,
     REPEAT GEN_TAC THEN
     DISCH_THEN(fun th ->
       MP_TAC(cas (CONJUNCT1 th)) THEN
       MAP_EVERY ASSUME_TAC (CONJUNCTS(CONJUNCT2 th))) THEN
     REWRITE_TAC dis THEN unw THEN
     ASM_REWRITE_TAC[injectivity "option"; injectivity "bvlSem_ref";
                     distinctness "bvlSem_ref"; ThunkBlock_11;
                     GSYM NOT_EXISTS_THM] THEN
     unw THEN
     REWRITE_TAC[ARITH_RULE `~(ck + 1 = 0)`;
                 ARITH_RULE `(ck + 1) - 1 = ck`] THEN
     STRIP_TAC THEN ASM_REWRITE_TAC[]) in
   (* and the same where the heap element is not known yet *)
   let step2 = prove
    (`!ck conf n (refs:(dataSem_v bvlSem_ref) spt) b ev vv x f tf
         (heap:(('a word_loc,data_to_word_memoryProof_tag#('a
           word_loc) list)heap_element) list).
        v_inv_ck (ck + 1) conf (RefPtr b n) refs (x,f,tf,heap) /\
        lookup n refs = SOME (Thunk ev vv)
        ==> (?y. heap_lookup (FAPPLY f n) heap =
                   SOME (ThunkBlock ev y) /\
                 n IN FDOM f /\ ~b /\
                 x = gc_shared_Pointer (FAPPLY f n)
                       (wordLang_Word (n2w 0)) /\
                 (ev = Evaluated ==> dest_thunk vv refs = NotThunk)
                 /\ v_inv_ck ck conf vv refs (y,f,tf,heap)) \/
            (ev = Evaluated /\ dest_thunk vv refs = NotThunk /\ ~b /\
             v_inv_ck ck conf vv refs (x,f,tf,heap))`,
     REPEAT GEN_TAC THEN
     DISCH_THEN(fun th ->
       MP_TAC(cas (CONJUNCT1 th)) THEN
       MAP_EVERY ASSUME_TAC (CONJUNCTS(CONJUNCT2 th))) THEN
     REWRITE_TAC dis THEN unw THEN
     ASM_REWRITE_TAC[injectivity "option"; injectivity "bvlSem_ref";
                     distinctness "bvlSem_ref"; ThunkBlock_11;
                     GSYM NOT_EXISTS_THM] THEN
     unw THEN
     REWRITE_TAC[ARITH_RULE `~(ck + 1 = 0)`;
                 ARITH_RULE `(ck + 1) - 1 = ck`] THEN
     STRIP_TAC THEN ASM_MESON_TAC[]) in
   (* the three shapes that the relation at ck = 0 can have *)
   let fwd_pre =
     DISCH_TAC THEN
     FIRST_ASSUM(fun th -> MP_TAC(cas (SPEC `0` th))) THEN
     REWRITE_TAC dis THEN unw THEN ASM_REWRITE_TAC[] THEN
     DISCH_THEN(DISJ_CASES_THEN2 STRIP_ASSUME_TAC
       (DISJ_CASES_THEN2
          (X_CHOOSE_THEN `ev:thunk_mode`
             (X_CHOOSE_THEN `vv:dataSem_v`
                (X_CHOOSE_THEN y_tm STRIP_ASSUME_TAC)))
          (X_CHOOSE_THEN `vv:dataSem_v` STRIP_ASSUME_TAC))) in
   (* the terms are written with the type of a heap address in
      them, because a variable of the goal that the parser is left
      to type gets a type of its own and is another variable *)
   let vy = `!ck. v_inv_ck ck conf vv refs
                    (y:(('a word_loc)heap_address),f,tf,heap)` in
   let vx = `!ck. v_inv_ck ck conf vv refs
                    (x:(('a word_loc)heap_address),f,tf,heap)` in
   let sg_tm =
     `!ck2. ev = Evaluated /\ dest_thunk vv refs = NotThunk /\
            v_inv_ck ck2 conf vv refs
              (x:(('a word_loc)heap_address),f,tf,heap)` in
   let case2 =
     DISJ2_TAC THEN
     ASM_CASES_TAC vy THENL
      [DISJ1_TAC THEN
       MAP_EVERY EXISTS_TAC
         [`ev:thunk_mode`; `vv:dataSem_v`; y_tm] THEN
       ASM_REWRITE_TAC[];
       FIRST_ASSUM(fun nf ->
         MP_TAC(REWRITE_RULE[NOT_FORALL_THM] nf)) THEN
       DISCH_THEN(X_CHOOSE_THEN `ck1:num` ASSUME_TAC) THEN
       DISJ2_TAC THEN EXISTS_TAC `vv:dataSem_v` THEN
       SUBGOAL_THEN sg_tm ASSUME_TAC THENL
        [X_GEN_TAC `ck2:num` THEN
         FIRST_ASSUM(fun v -> FIRST_ASSUM(fun l ->
           FIRST_ASSUM(fun h ->
             MP_TAC(MATCH_MP step
               (CONJ (SPEC `(ck1 + ck2) + 1` v)
                     (CONJ l h)))))) THEN
         DISCH_THEN(DISJ_CASES_THEN2
           (fun l2 ->
              MP_TAC(MP (SPEC `ck1:num`
                (MATCH_MP mono_thm (last(CONJUNCTS l2))))
                (ARITH_RULE `ck1 <= ck1 + ck2`)) THEN
              ASM_REWRITE_TAC[])
           (fun r2 ->
              REWRITE_TAC[CONJUNCT1 r2;
                          CONJUNCT1(CONJUNCT2 r2)] THEN
              MATCH_ACCEPT_TAC(MP (SPEC `ck2:num`
                (MATCH_MP mono_thm (last(CONJUNCTS r2))))
                (ARITH_RULE `ck2 <= ck1 + ck2`))));
         FIRST_ASSUM(fun sg ->
           let s0 = SPEC `0` sg in
           ASM_REWRITE_TAC[CONJUNCT1 s0;
                           CONJUNCT1(CONJUNCT2 s0)] THEN
           X_GEN_TAC `ck:num` THEN
           MATCH_ACCEPT_TAC(last(CONJUNCTS(SPEC `ck:num` sg))))]] in
   let case3 =
     DISJ2_TAC THEN
     ASM_CASES_TAC vx THENL
      [DISJ2_TAC THEN EXISTS_TAC `vv:dataSem_v` THEN
       ASM_REWRITE_TAC[];
       FIRST_ASSUM(fun nf ->
         MP_TAC(REWRITE_RULE[NOT_FORALL_THM] nf)) THEN
       DISCH_THEN(X_CHOOSE_THEN `ck2:num` ASSUME_TAC) THEN
       DISJ1_TAC THEN
       FIRST_ASSUM(fun v -> FIRST_ASSUM(fun l ->
         MP_TAC(MATCH_MP step2 (CONJ (SPEC `ck2 + 1` v) l)))) THEN
       DISCH_THEN(DISJ_CASES_THEN2
         (X_CHOOSE_THEN y_tm (fun l ->
            MAP_EVERY EXISTS_TAC
              [`Evaluated`; `vv:dataSem_v`; y_tm] THEN
            ASM_REWRITE_TAC(CONJUNCTS l) THEN
            X_GEN_TAC `ck:num` THEN
            FIRST_ASSUM(fun v -> FIRST_ASSUM(fun l7 ->
              MP_TAC(MATCH_MP step
                (CONJ (SPEC `(ck + ck2) + 1` v)
                      (CONJ l7 (CONJUNCT1 l)))))) THEN
            DISCH_THEN(DISJ_CASES_THEN2
              (fun l2 -> MATCH_ACCEPT_TAC(MP (SPEC `ck:num`
                 (MATCH_MP mono_thm (last(CONJUNCTS l2))))
                 (ARITH_RULE `ck <= ck + ck2`)))
              (fun r2 ->
                 MP_TAC(MP (SPEC `ck2:num`
                   (MATCH_MP mono_thm (last(CONJUNCTS r2))))
                   (ARITH_RULE `ck2 <= ck + ck2`)) THEN
                 ASM_REWRITE_TAC[]))))
         (fun r ->
            MP_TAC(last(CONJUNCTS r)) THEN ASM_REWRITE_TAC[]))] in
   let rev_tac =
     DISCH_THEN(DISJ_CASES_THEN2 STRIP_ASSUME_TAC
       (DISJ_CASES_THEN2
          (X_CHOOSE_THEN `ev:thunk_mode`
             (X_CHOOSE_THEN `vv:dataSem_v`
                (X_CHOOSE_THEN y_tm STRIP_ASSUME_TAC)))
          (X_CHOOSE_THEN `vv:dataSem_v` STRIP_ASSUME_TAC))) THENL
      [X_GEN_TAC `ck:num` THEN SUBST_LHS_TAC THEN
       MATCH_MP_TAC(el 4 rl) THEN ASM_REWRITE_TAC[];
       X_GEN_TAC `ck:num` THEN ASM_MESON_TAC[el 5 rl];
       X_GEN_TAC `ck:num` THEN ASM_MESON_TAC[el 6 rl]] in
   let rp_tac =
     REWRITE_TAC[v_inv_eq] THEN EQ_TAC THENL
      [fwd_pre THENL
        [DISJ1_TAC THEN ASM_REWRITE_TAC[]; case2; case3];
       rev_tac] in
   REPEAT CONJ_TAC THENL
    [base THEN ASM_CASES_TAC `small_int (:'a) i` THEN
     ASM_REWRITE_TAC[] THEN CONV_TAC TAUT;
     base; base; rp_tac; blk_tac])
### v_inv_RefPtr_T
  (* a RefPtr T is no thunk and no MutBlock, so the two rules of
     v_inv that ask for a RefPtr F do not apply and the annotation
     of the pointer is zero *)
  (let rpa = prove
    (`!conf o1.
        (!tg fin l c r.
           ~(o1 = SOME (bvlSem_MutBlock tg fin l c r))) ==>
        ref_ptr_annot conf o1 = wordLang_Word (n2w 0)`,
     REPEAT GEN_TAC THEN CASES_ON_NAME "o1" THEN
     REWRITE_TAC[ref_ptr_annot_def] THEN
     TRY(CASES_ON_NAME "a") THEN
     TRY MATCH_REDUCE_TAC THEN REWRITE_TAC[] THEN
     REWRITE_TAC[injectivity "option"; injectivity "bvlSem_ref"] THEN
     MESON_TAC[]) in
   REWRITE_TAC[v_inv_def] THEN EQ_TAC THEN STRIP_TAC THEN
   ASM_REWRITE_TAC[] THEN ASM_SIMP_TAC[rpa] THEN
   TRY(DISJ1_TAC THEN ASM_SIMP_TAC[rpa]))
### MEM_IMP_v_size
  (REPEAT STRIP_TAC THEN
   MATCH_MP_TAC(ARITH_RULE `a <= b ==> a < 1 + b`) THEN
   MATCH_MP_TAC misc_MEM_list_size THEN ASM_REWRITE_TAC[])
### word_list_limit
  (* a list of words without a repeat is no longer than the
     number of words there are: the values of its elements are
     a list of distinct numbers below dimword, and such a list
     is a subset of the numbers below dimword *)
  (let dist_lt = prove
    (`!(l:num list) n. ALL_DISTINCT l /\ (!x. MEM x l ==> x < n)
        ==> LENGTH l <= n`,
     REPEAT GEN_TAC THEN STRIP_TAC THEN
     MP_TAC(REWRITE_RULE[GSYM ALL_DISTINCT]
       (ISPEC `l:num list` HAS_SIZE_SET_OF_LIST)) THEN
     ASM_REWRITE_TAC[HAS_SIZE] THEN
     DISCH_THEN(CONJUNCTS_THEN2 ASSUME_TAC (SUBST1_TAC o SYM)) THEN
     TRANS_TAC LE_TRANS `CARD {i | i < (n:num)}` THEN CONJ_TAC THENL
      [MATCH_MP_TAC CARD_SUBSET THEN CONJ_TAC THENL
        [REWRITE_TAC[SUBSET; IN_SET_OF_LIST; IN_ELIM_THM] THEN
         ASM_MESON_TAC[];
         MESON_TAC[HAS_SIZE_NUMSEG_LT; HAS_SIZE]];
       REWRITE_TAC[CARD_NUMSEG_LT; LE_REFL]]) in
   STRIP_TAC THEN
   MP_TAC(ISPECL [`MAP (\x. w2n (theWord x)) (ws:('a word_loc) list)`;
                  `dimword (:'a)`] dist_lt) THEN
   REWRITE_TAC[LENGTH_MAP] THEN
   DISCH_THEN MATCH_MP_TAC THEN CONJ_TAC THENL
    [FIRST_X_ASSUM MP_TAC THEN FIRST_X_ASSUM MP_TAC THEN
     REWRITE_TAC[TAUT `(p ==> q ==> r) <=> (p /\ q ==> r)`] THEN
     SPEC_TAC(`ws:('a word_loc) list`,`ws:('a word_loc) list`) THEN
     LIST_INDUCT_TAC THEN
     REWRITE_TAC[MAP; ALL_DISTINCT_CLAUSES; ALL] THEN
     STRIP_TAC THEN CONJ_TAC THENL
      [REWRITE_TAC[MEM_MAP; NOT_EXISTS_THM] THEN
       X_GEN_TAC `y:('a)word_loc` THEN STRIP_TAC THEN
       SUBGOAL_THEN `isWord (y:('a)word_loc)` MP_TAC THENL
        [ASM_MESON_TAC[ALL_MEM]; ALL_TAC] THEN
       UNDISCH_TAC `isWord (h:('a)word_loc)` THEN
       REWRITE_TAC[isWord_exists] THEN
       DISCH_THEN(X_CHOOSE_THEN `wh:('a)word` SUBST_ALL_TAC) THEN
       DISCH_THEN(X_CHOOSE_THEN `wy:('a)word` SUBST_ALL_TAC) THEN
       ASM_MESON_TAC[theWord_def; VAL_EQ];
       FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_REWRITE_TAC[]];
     REWRITE_TAC[MEM_MAP] THEN REPEAT STRIP_TAC THEN
     ASM_REWRITE_TAC[dimword; VAL_BOUND]])
### MOD_EQ_0_0
  (REPEAT STRIP_TAC THEN ASM_MESON_TAC[MOD_LT])

### EVERY2_IMP_EVERY
  (LIST_INDUCT_TAC THEN GEN_TAC THEN CASES_BY_NAME "ys" THEN
   REWRITE_TAC[ALL2; ALL; ZIP] THEN
   CONV_TAC(DEPTH_CONV GEN_BETA_CONV) THEN ASM_SIMP_TAC[])

### EVERY2_IMP_EVERY2
  (* the relations are fixed before the induction, so that the
     induction hypothesis applies to the tails by MATCH_MP_TAC *)
  (let aux = prove
    (`!(P1:A->B->bool) P2 xs ys.
        (!x y. MEM x xs /\ MEM y ys /\ P1 x y ==> P2 x y) /\
        ALL2 P1 xs ys ==> ALL2 P2 xs ys`,
     GEN_TAC THEN GEN_TAC THEN LIST_INDUCT_TAC THEN
     X_GEN_TAC `ys:B list` THEN
     STRUCT_CASES_TAC(ISPEC `ys:B list` list_CASES_v) THEN
     REWRITE_TAC[ALL2; MEM] THEN REPEAT STRIP_TAC THEN
     FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_REWRITE_TAC[] THEN
     REPEAT STRIP_TAC THEN FIRST_ASSUM MATCH_MP_TAC THEN
     ASM_REWRITE_TAC[]) in
   REPEAT GEN_TAC THEN
   REWRITE_TAC[TAUT `(p ==> q ==> r) <=> (p /\ q ==> r)`] THEN
   MATCH_ACCEPT_TAC aux)
### MEM_EVERY2_IMP
  (LIST_INDUCT_TAC THEN REPEAT GEN_TAC THEN CASES_BY_NAME "zs" THEN
   REWRITE_TAC[ALL2; MEM] THEN STRIP_TAC THEN ASM_MESON_TAC[])

### EVERY2_APPEND_CONS
  (let aux = prove
    (`!(P:A->B->bool) xs y ys zs.
        ALL2 P (APPEND xs (CONS y ys)) zs
        ==> ?u1 u u2. zs = APPEND u1 (CONS u u2) /\
                      LENGTH u1 = LENGTH xs /\
                      ALL2 P xs u1 /\ P y u /\ ALL2 P ys u2`,
     GEN_TAC THEN LIST_INDUCT_TAC THENL
      [REPEAT GEN_TAC THEN
       STRUCT_CASES_TAC(ISPEC `zs:B list` list_CASES_v) THEN
       REWRITE_TAC[APPEND; ALL2; LENGTH] THEN STRIP_TAC THEN
       MAP_EVERY EXISTS_TAC [`[]:B list`; `v:B`; `vs:B list`] THEN
       ASM_REWRITE_TAC[APPEND; LENGTH; ALL2];
       REPEAT GEN_TAC THEN
       STRUCT_CASES_TAC(ISPEC `zs:B list` list_CASES_v) THEN
       REWRITE_TAC[APPEND; ALL2; LENGTH] THEN STRIP_TAC THEN
       USE_IH THEN STRIP_TAC THEN
       MAP_EVERY EXISTS_TAC [`CONS (v:B) u1`; `u:B`; `u2:B list`] THEN
       ASM_REWRITE_TAC[APPEND; LENGTH; ALL2]]) in
   REPEAT GEN_TAC THEN MATCH_ACCEPT_TAC aux)
### EVERY2_SWAP
  (LIST_INDUCT_TAC THEN GEN_TAC THEN CASES_BY_NAME "ys" THEN
   ASM_REWRITE_TAC[ALL2] THEN CONV_TAC(DEPTH_CONV BETA_CONV) THEN
   ASM_SIMP_TAC[])

### EVERY2_APPEND_IMP_APPEND
  (let aux = prove
    (`!(P:A->B->bool) xs1 xs2 ys.
        ALL2 P (APPEND xs1 xs2) ys
        ==> ?u1 u2. ys = APPEND u1 u2 /\ ALL2 P xs1 u1 /\
                    ALL2 P xs2 u2`,
     GEN_TAC THEN LIST_INDUCT_TAC THENL
      [REPEAT GEN_TAC THEN REWRITE_TAC[APPEND] THEN STRIP_TAC THEN
       MAP_EVERY EXISTS_TAC [`[]:B list`; `ys:B list`] THEN
       ASM_REWRITE_TAC[APPEND; ALL2];
       REPEAT GEN_TAC THEN
       STRUCT_CASES_TAC(ISPEC `ys:B list` list_CASES_v) THEN
       REWRITE_TAC[APPEND; ALL2] THEN STRIP_TAC THEN
       USE_IH THEN STRIP_TAC THEN
       MAP_EVERY EXISTS_TAC [`CONS (v:B) u1`; `u2:B list`] THEN
       ASM_REWRITE_TAC[APPEND; ALL2]]) in
   REPEAT GEN_TAC THEN MATCH_ACCEPT_TAC aux)
### EVERY2_MAP_FST_SND
  (let aux = prove
    (`!(P:A->B->bool) xs.
        ALL2 P (MAP FST xs) (MAP SND xs) <=> ALL (\(x,y). P x y) xs`,
     GEN_TAC THEN LIST_INDUCT_TAC THEN
     REWRITE_TAC[MAP; ALL2; ALL] THEN
     STRUCT_CASES_TAC(ISPEC `h:A#B` PAIR_SURJECTIVE) THEN
     ASM_REWRITE_TAC[FST; SND] THEN
     CONV_TAC(ONCE_DEPTH_CONV GEN_BETA_CONV) THEN REWRITE_TAC[]) in
   REPEAT GEN_TAC THEN MATCH_ACCEPT_TAC aux)
### fapply_fupdate_update
  (let aux = prove
    (`!(f:(A,B)fmap) p. FAPPLY (f |+ p) = (FST p =+ SND p) (FAPPLY f)`,
     REPEAT GEN_TAC THEN
     STRUCT_CASES_TAC(ISPEC `p:A#B` PAIR_SURJECTIVE) THEN
     REWRITE_TAC[FUN_EQ_THM; UPDATE; FST; SND; FAPPLY_FUPDATE_THM] THEN
     GEN_TAC THEN REWRITE_TAC[EQ_SYM_EQ]) in
   REPEAT GEN_TAC THEN MATCH_ACCEPT_TAC aux)
### heap_lookup_APPEND1
  (* past the first heap the lookup is the one of the second, and
     the two conditions of the clause are false by arithmetic *)
  (let hl = heap_lookup_def in
   let hlen_cl = prove
    (`heap_length [] = 0 /\
      (!x xs. heap_length (CONS x xs) =
              el_length x + heap_length xs)`,
     REWRITE_TAC[heap_length_def; MAP; SUM_DEF; ITLIST]) in
   LIST_INDUCT_TAC THEN
   REWRITE_TAC[hlen_cl; APPEND; hl; SUB_0; LE_0] THEN
   REPEAT GEN_TAC THEN DISCH_TAC THEN
   MP_ISPEC_NAME "h" el_length_GT_0 THEN DISCH_TAC THEN
   COND_CASES_TAC THENL
    [SUBGOAL_THEN `F` CONTR_TAC THEN ASM_ARITH_TAC; ALL_TAC] THEN
   COND_CASES_TAC THENL
    [SUBGOAL_THEN `F` CONTR_TAC THEN ASM_ARITH_TAC; ALL_TAC] THEN
   REWRITE_TAC[ARITH_RULE `a - (b + c) = a - b - c`] THEN
   FIRST_ASSUM MATCH_MP_TAC THEN ASM_ARITH_TAC)
### heap_lookup_APPEND2
  (* heap_length is the SUM of the el_lengths, so its clauses come
     first here too *)
  (let hl = heap_lookup_def in
   let hlen_cl = prove
    (`heap_length [] = 0 /\
      (!x xs. heap_length (CONS x xs) =
              el_length x + heap_length xs)`,
     REWRITE_TAC[heap_length_def; MAP; SUM_DEF; ITLIST]) in
   LIST_INDUCT_TAC THEN
   REWRITE_TAC[hlen_cl; LT; APPEND; hl] THEN
   REPEAT GEN_TAC THEN COND_CASES_TAC THEN REWRITE_TAC[] THEN
   COND_CASES_TAC THEN REWRITE_TAC[] THEN
   DISCH_TAC THEN FIRST_ASSUM MATCH_MP_TAC THEN ASM_ARITH_TAC)
### data_to_word_memoryProof_heap_lookup_APPEND
  (COND_CASES_TAC THENL
    [MATCH_MP_TAC heap_lookup_APPEND2 THEN ASM_REWRITE_TAC[];
     MATCH_MP_TAC heap_lookup_APPEND1 THEN ASM_ARITH_TAC])
### data_to_word_memoryProof_LENGTH_ADDR_MAP
  (REPEAT GEN_TAC THEN
   MATCH_ACCEPT_TAC(GSYM (SPEC_ALL ADDR_MAP_LENGTH)))

### EL_ADDR_MAP
  (let addrmap = ADDR_MAP_def in
   let addrapply = ADDR_APPLY_def in
   LIST_INDUCT_TAC THENL
   [REWRITE_TAC[LENGTH; LT];
    REPEAT GEN_TAC THEN CASES_BY_NAME "h" THEN
    STRUCT_CASES_TAC(SPEC `n:num` num_CASES) THEN
    ASM_REWRITE_TAC[addrmap; addrapply; EL; HD; TL; LENGTH;
                    LT_SUC; LT_0]])

### v_inv_related
  (REPEAT STRIP_TAC THEN
   ASM_MESON_TAC[v_inv_eq; v_inv_related_lemma])
### EVERY2_ADDR_MAP
  (let aux = prove
    (`!P g zs l.
        ALL2 P (ADDR_MAP g zs) l <=>
        ALL2 (\x y. P (ADDR_APPLY g x) y) zs l`,
     GEN_TAC THEN GEN_TAC THEN LIST_INDUCT_TAC THEN
     REWRITE_TAC[ADDR_MAP_def; ALL2_DEF] THEN
     CASES_BY_NAME "h" THEN
     REWRITE_TAC[ADDR_MAP_def; ADDR_APPLY_def;
                 ALL2_DEF] THEN
     ASM_REWRITE_TAC[]) in
   REPEAT GEN_TAC THEN MATCH_ACCEPT_TAC aux)
### gc_heap_inline_rel_heap_lookup
  (* two heaps of which the elements are related have the same
     lengths of elements and the same elements that are data, which
     is what the cases of the relation say, so a lookup in the one is
     data exactly when the lookup in the other is *)
  (let (_,_,cases) = gc_heap_inline_rel in
   let isd = prove
    (`!xs n d. isSomeDataElement (SOME (DataElement xs n d))`,
     REWRITE_TAC[isSomeDataElement_def] THEN MESON_TAC[]) in
   let lem = prove
    (`!x y. gc_heap_inline_rel dest_evaluated_thunk_rel heap x y
        ==> el_length x = el_length y /\
            (isSomeDataElement (SOME x) <=>
             isSomeDataElement (SOME y))`,
     REPEAT GEN_TAC THEN GEN_REWRITE_TAC LAND_CONV [cases] THEN
     STRIP_TAC THEN
     ASM_REWRITE_TAC[el_length_def; isd]) in
   let lcases =
     W(fun (_,w) ->
       STRUCT_CASES_TAC(ISPEC (rand(lhand w)) list_CASES_v)) in
   LIST_INDUCT_TAC THEN GEN_TAC THEN lcases THEN
   REWRITE_TAC[ALL2; heap_lookup_def] THEN
   STRIP_TAC THEN
   FIRST_ASSUM(fun r -> MP_TAC(MATCH_MP lem r)) THEN
   DISCH_THEN(CONJUNCTS_THEN2 (fun e -> REWRITE_TAC[e])
     ASSUME_TAC) THEN
   GEN_TAC THEN COND_CASES_TAC THEN ASM_REWRITE_TAC[] THEN
   COND_CASES_TAC THEN ASM_REWRITE_TAC[] THEN
   FIRST_ASSUM(fun ih -> FIRST_ASSUM(fun r ->
     MATCH_ACCEPT_TAC(MATCH_MP ih r))))
### ThunkBlock_not_EQ
  (REWRITE_TAC[ThunkBlock_def; bignum_def;
               Word64Rep_def; BlockRep_def;
               RefBlock_def; bytes_def] THEN
   PAIRARG_TAC THEN CONV_TAC(TOP_DEPTH_CONV let_CONV) THEN
   COND_CASES_TAC THEN
   REWRITE_TAC[injectivity "heap_element"; PAIR_EQ;
               distinctness "data_to_word_memoryProof_tag";
               NOT_CONS_NIL])
### LIST_REL_gc_heap_inline_DataElement
  (* the lookup of the one heap is data, so the element of the other
     at that address is the one the relation relates it to: either
     the same element, or the data of the same length and the same
     tag whose addresses the relation relates one by one *)
  (let (_,_,cases) = gc_heap_inline_rel in
   let (irules,_,_) = gc_inline_rel in
   let ellen = prove
    (`!inline h1 x y. gc_heap_inline_rel inline h1 x y
        ==> el_length x = el_length y`,
     REPEAT GEN_TAC THEN GEN_REWRITE_TAC LAND_CONV [cases] THEN
     STRIP_TAC THEN ASM_REWRITE_TAC[el_length_def]) in
   let refl2 = prove
    (`!inline h1 l. ALL2 (gc_inline_rel inline h1) l l`,
     GEN_TAC THEN GEN_TAC THEN LIST_INDUCT_TAC THEN
     ASM_REWRITE_TAC[ALL2; CONJUNCT1 irules]) in
   let lcases =
     W(fun (_,w) ->
       STRUCT_CASES_TAC(ISPEC (rand(lhand w)) list_CASES_v)) in
   (* the witness of the existential is what the first conjunct of
      its body equates the bound variable with *)
   let eq_exists =
     W(fun (_,w) ->
       let v,bod = dest_exists w in
       let eq = hd (conjuncts bod) in
       EXISTS_TAC (if rand eq = v then lhand eq else rand eq)) in
   LIST_INDUCT_TAC THEN GEN_TAC THEN lcases THEN
   REWRITE_TAC[ALL2; heap_lookup_def;
               distinctness "option"] THEN
   STRIP_TAC THEN GEN_TAC THEN
   FIRST_ASSUM(fun r -> REWRITE_TAC[MATCH_MP ellen r]) THEN
   COND_CASES_TAC THEN ASM_REWRITE_TAC[] THENL
    [REWRITE_TAC[injectivity "option"] THEN
     DISCH_THEN SUBST_ALL_TAC THEN USE_CHANGED [cases] THEN
     REWRITE_TAC[injectivity "heap_element"] THEN STRIP_TAC THEN
     ASM_REWRITE_TAC[injectivity "heap_element"] THEN
     eq_exists THEN ASM_REWRITE_TAC[refl2];
     COND_CASES_TAC THEN
     REWRITE_TAC[distinctness "option"] THEN
     FIRST_ASSUM(fun ih -> FIRST_ASSUM(fun r ->
       MATCH_ACCEPT_TAC(MATCH_MP ih r)))])
### gc_heap_inline_rel_v_inv
  (REPEAT STRIP_TAC THEN
   ASM_MESON_TAC[v_inv_eq; gc_heap_inline_rel_v_inv_lemma])
### bc_stack_ref_inv_related
  (REWRITE_TAC[gc_inline_related_def] THEN REPEAT STRIP_TAC THEN
   ASM_MESON_TAC[bc_stack_ref_inv_gc_inline;
                 bc_stack_ref_inv_gc_related_roots_heap])
### data_up_to_APPEND
  (REWRITE_TAC[data_up_to_def; heap_split_APPEND_if; LT_REFL;
               SUB_REFL; heap_split_0] THEN
   MATCH_REDUCE_TAC THEN
   REWRITE_TAC[APPEND_NIL; injectivity "option"; PAIR_EQ] THEN
   MESON_TAC[])
### reachable_addresses_related
  (* the root that reaches k reaches it over a path of the heap, and
     the map takes that path to one of the new heap: the first
     address is a key of the map because it is reachable itself (the
     path of no steps), and every step gives the next one *)
  ((* a pointer of the roots is a pointer of the mapped roots *)
   let mem_addr_map = prove
    (`!roots x t f.
        MEM (gc_shared_Pointer x t) roots
        ==> MEM (gc_shared_Pointer (f x) t) (ADDR_MAP f roots)`,
     LIST_INDUCT_TAC THEN REWRITE_TAC[MEM; ADDR_MAP_def] THEN
     REPEAT GEN_TAC THEN CASES_BY_NAME "h" THEN
     REWRITE_TAC[ADDR_MAP_def; MEM; injectivity "heap_address";
                 distinctness "heap_address"] THEN
     REPEAT STRIP_TAC THEN ASM_REWRITE_TAC[] THEN
     TRY DISJ2_TAC THEN
     TRY(FIRST_ASSUM(fun ih -> FIRST_ASSUM(fun m ->
       MATCH_ACCEPT_TAC(MATCH_MP ih m))))) in
   (* and a path of the old heap is a path of the new one, address
      by address: the element that an edge comes from is the mapped
      element, so the edge is there, and the address it goes to is one
      that the map has *)
   let path = prove
    (`!hp hp2 g.
        gc_related g hp hp2 ==>
        !x k. RTC (gc_edge hp) x k ==> x IN FDOM g
              ==> RTC (gc_edge hp2) (FAPPLY g x) (FAPPLY g k)`,
     REPEAT GEN_TAC THEN DISCH_TAC THEN
     MATCH_MP_TAC RTC_INDUCT THEN CONJ_TAC THENL
      [REPEAT STRIP_TAC THEN
       MATCH_ACCEPT_TAC(CONJUNCT1(SPEC_ALL RTC_RULES));
       ALL_TAC] THEN
     REPEAT GEN_TAC THEN
     DISCH_THEN(CONJUNCTS_THEN2
       (MP_TAC o REWRITE_RULE[gc_edge_def]) ASSUME_TAC) THEN
     DISCH_THEN(REPEAT_TCL CHOOSE_THEN STRIP_ASSUME_TAC) THEN
     DISCH_TAC THEN
     FIRST_ASSUM(fun gr ->
       let g3 = CONJUNCT2(CONJUNCT2
                  (REWRITE_RULE[gc_related_def] gr)) in
       FIRST_ASSUM(fun hl -> FIRST_ASSUM(fun fd ->
         let th = MATCH_MP g3 (CONJ fd hl) in
         FIRST_ASSUM(fun m ->
           let yin = MATCH_MP (CONJUNCT2 th) m in
           FIRST_ASSUM(fun ih ->
             let rtc = MATCH_MP ih yin in
             MATCH_MP_TAC(CONJUNCT2(SPEC_ALL RTC_RULES)) THEN
             EXISTS_TAC (el 1 (snd(strip_comb(concl rtc)))) THEN
             CONJ_TAC THENL
              [REWRITE_TAC[gc_edge_def] THEN
               MAP_EVERY EXISTS_TAC
                 (snd(strip_comb(rand(rhs(concl(CONJUNCT1 th))))) @
                  [rand(el 0 (snd(strip_comb(concl m))))]) THEN
               CONJ_TAC THENL
                [ACCEPT_TAC(CONJUNCT1 th);
                 MATCH_ACCEPT_TAC(MATCH_MP mem_addr_map m)];
               ACCEPT_TAC rtc])))))) in
     REPEAT STRIP_TAC THEN
     (* the hypothesis: a pointer of the roots and a path to k *)
     FIRST_ASSUM(fun kin ->
       if not (hd_is "reachable_addresses" (rand(concl kin)))
       then fail() else
       MP_TAC(REWRITE_RULE[IN; reachable_addresses_def] kin)) THEN
     DISCH_THEN(REPEAT_TCL CHOOSE_THEN STRIP_ASSUME_TAC) THEN
     (* x is reachable, so it is a key of the map *)
     FIRST_ASSUM(fun m ->
       if not (hd_is "MEM" (concl m)) then fail() else
       FIRST_ASSUM(fun r ->
         if not (hd_is "RTC" (concl r)) then fail() else
         let args = snd(strip_comb(concl r)) in
         let x = el 1 args in
         FIRST_ASSUM(fun sub ->
           let impl = SPEC x (REWRITE_RULE[SUBSET] sub) in
           SUBGOAL_THEN (lhand(concl impl)) (fun a ->
             let xin = MATCH_MP impl a in
             FIRST_ASSUM(fun gr ->
               let rtc =
                 MATCH_MP (MATCH_MP (MATCH_MP path gr) r) xin in
               REWRITE_TAC[IN; reachable_addresses_def] THEN
               MAP_EVERY EXISTS_TAC
                 [rand(el 0 (snd(strip_comb(concl m))));
                  el 1 (snd(strip_comb(concl rtc)))] THEN
               CONJ_TAC THENL
                [MATCH_ACCEPT_TAC(MATCH_MP mem_addr_map m);
                 ACCEPT_TAC rtc]))))) THEN
     (* and the subgoal: x is reachable, by the path of no steps *)
     (REWRITE_TAC[IN; reachable_addresses_def] THEN
       FIRST_ASSUM(fun m ->
         if not (hd_is "MEM" (concl m)) then fail() else
         FIRST_ASSUM(fun r ->
           if not (hd_is "RTC" (concl r)) then fail() else
           MAP_EVERY EXISTS_TAC
             [rand(el 0 (snd(strip_comb(concl m))));
              el 1 (snd(strip_comb(concl r)))])) THEN
      CONJ_TAC THENL
       [FIRST_ASSUM MATCH_ACCEPT_TAC;
        MATCH_ACCEPT_TAC(CONJUNCT1(SPEC_ALL RTC_RULES))]))
### IMP_all_reachable_from_roots
  (* an address of the second heap is in the range of f, so it is the
     image of an address of the first, which is reachable *)
  (REWRITE_TAC[all_reachable_from_roots_def] THEN
   REPEAT STRIP_TAC THEN
   SUBGOAL_THEN `(p:num) IN FRANGE (f:(num,num)fmap)` MP_TAC THENL
    [ASM_REWRITE_TAC[IN_ELIM_THM; isSomeDataElement_def] THEN
     ASM_MESON_TAC[];
     REWRITE_TAC[FMAP_IN_FRANGE] THEN STRIP_TAC THEN
     FIRST_X_ASSUM(SUBST1_TAC o SYM) THEN
     MATCH_MP_TAC reachable_addresses_related THEN
     CONJ_TAC THENL
      [ASM_MESON_TAC[];
       CONJ_TAC THENL
        [ASM_REWRITE_TAC[]; ASM_REWRITE_TAC[SUBSET_REFL]]]])
### heap_lookup_expand_eq_SOME
  (* past the heap the lookup is in the expansion, which is one
     Unused element, and that is not a DataElement *)
  (let hexp = heap_expand_def in
   let hlk = heap_lookup_def in
   let opt = [distinctness "option"; injectivity "option";
              distinctness "heap_element"] in
   REWRITE_TAC[heap_lookup_APPEND] THEN COND_CASES_TAC THEN
   REWRITE_TAC[] THEN
   MATCH_MP_TAC(TAUT `~a /\ ~b ==> (a <=> b)`) THEN CONJ_TAC THENL
    [REWRITE_TAC[hexp] THEN COND_CASES_TAC THEN REWRITE_TAC[hlk] THEN
     REPEAT COND_CASES_TAC THEN REWRITE_TAC opt;
     DISCH_TAC THEN
     FIRST_ASSUM(MP_TAC o MATCH_MP heap_lookup_LESS) THEN
     ASM_ARITH_TAC])
### isSomeDataElement_heap_lookup
  (let hexp = heap_expand_def in
   let hlk = heap_lookup_def in
   let isde = isSomeDataElement_def in
   let opt = [distinctness "option"; injectivity "option";
              distinctness "heap_element"] in
   REWRITE_TAC[heap_lookup_APPEND] THEN COND_CASES_TAC THEN
   REWRITE_TAC[] THEN
   MATCH_MP_TAC(TAUT `~a /\ ~b ==> (a <=> b)`) THEN CONJ_TAC THENL
    [REWRITE_TAC[hexp] THEN COND_CASES_TAC THEN
     REWRITE_TAC[hlk; isde] THEN REPEAT COND_CASES_TAC THEN
     REWRITE_TAC(isde :: opt);
     REWRITE_TAC[isde] THEN STRIP_TAC THEN
     FIRST_ASSUM(MP_TAC o MATCH_MP heap_lookup_LESS) THEN
     ASM_ARITH_TAC])
### gc_related_APPEND_heap_expand
  (REWRITE_TAC[gc_related_def; isSomeDataElement_heap_lookup;
               heap_lookup_expand_eq_SOME])
### gc_move_data_refs_split
  (* a move of the gc keeps the data in h2 and the references in
     r4: of a Data it changes nothing, of a Pointer at a
     DataElement it puts the element in r4 when its tag is a
     mutable one and at the end of h2 when it is not, and the
     statement's hypothesis says that isRef of the configuration
     is exactly that.  `record_simps` (ml/lib/tactics.ml) is what
     HOL4's record simp set does: the accessors of gc_state over
     its updates, which HOL Light's define_record does not give *)
  (let hd_is n t =
   (try fst(dest_const(fst(strip_comb t))) = n
    with Failure _ -> false) in
   let gcsimps = record_simps "gc_state" ["h2"; "r4"] in
   (* a DataElement is a reference when its tag is a mutable one *)
   let isref = prove
    (`!ys l tag qs.
        data_to_word_memoryProof_isRef (DataElement ys l (tag,qs)) <=>
        isMutTag tag`,
     REPEAT GEN_TAC THEN
     REWRITE_TAC[isRef_def] THEN
     MATCH_REDUCE_TAC THEN
     REWRITE_TAC[injectivity "heap_element"; PAIR_EQ] THEN
     CONV_TAC(REDEPTH_CONV UNWIND_CONV) THEN
     REWRITE_TAC[EXISTS_UNIQUE_REFL; SELECT_REFL]) in
   let isdata = prove
    (`!ys l d. isDataElement (DataElement ys l d)`,
     REWRITE_TAC[isDataElement_def] THEN MESON_TAC[]) in
   DISCH_THEN(REPEAT_TCL CONJUNCTS_THEN ASSUME_TAC) THEN
   FIRST_X_ASSUM(fun th ->
     if (try hd_is "gen_gc_gc_move" (lhs (concl th))
         with Failure _ -> false)
     then MP_TAC th else fail()) THEN
   CASES_BY_NAME "x" THEN
   REWRITE_TAC[gen_gc_gc_move_def] THEN
   EVERY_CASE_TAC THEN
   TRY(CASES_BY_NAME "a2") THEN
   CONV_TAC(TOP_DEPTH_CONV let_CONV) THEN
   TRY COND_CASES_TAC THEN
   TRY(W(fun (asl,w) ->
     let t = find_term (fun u ->
       hd_is "gc_forward_ptr" u &&
       length (snd(strip_comb u)) = 5) w in
     MP_TAC(ISPEC t PAIR_SURJECTIVE)) THEN
     DISCH_THEN(CHOOSE_THEN(CHOOSE_THEN SUBST1_TAC))) THEN
   CONV_TAC(TOP_DEPTH_CONV let_CONV) THEN
   STRIP_TAC THEN
   RULE_ASSUM_TAC(REWRITE_RULE[PAIR_EQ]) THEN
   REPEAT(FIRST_X_ASSUM(fun th ->
     if is_conj (concl th) then STRIP_ASSUME_TAC th else fail())) THEN
   VAR_EQ_TAC THEN
   ASM_REWRITE_TAC(gcsimps @
                   [K_DEF; ALL_APPEND; ALL; isdata; isref]) THEN
   TRY(FIRST_X_ASSUM(fun h ->
     if is_forall (concl h) then RULE_ASSUM_TAC(REWRITE_RULE[h])
     else fail())) THEN
   ASM_REWRITE_TAC[])
### gc_move_list_data_refs_split
  (* the move of a list is the move of its head and then of its
     tail, and each of them keeps the three invariants, which is
     what the theorem about one move says *)
  (let gmd = GEN_ALL gc_move_data_refs_split in
   LIST_INDUCT_TAC THEN REPEAT GEN_TAC THENL
    [REWRITE_TAC[gen_gc_gc_move_list_def; PAIR_EQ] THEN
     DISCH_THEN(CONJUNCTS_THEN2
       (CONJUNCTS_THEN2 (K ALL_TAC) (SUBST1_TAC o SYM))
       STRIP_ASSUME_TAC) THEN
     ASM_REWRITE_TAC[];
     REWRITE_TAC[gen_gc_gc_move_list_def] THEN
     PAIRARG_TAC THEN CONV_TAC(TOP_DEPTH_CONV let_CONV) THEN
     PAIRARG_TAC THEN CONV_TAC(TOP_DEPTH_CONV let_CONV) THEN
     REWRITE_TAC[PAIR_EQ] THEN
     DISCH_THEN(CONJUNCTS_THEN2
       (CONJUNCTS_THEN2 (K ALL_TAC) (SUBST1_TAC o SYM))
       STRIP_ASSUME_TAC) THEN
     FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_EXISTS_TAC THEN
     ASM_REWRITE_TAC[] THEN
     MATCH_MP_TAC gmd THEN ASM_EXISTS_TAC THEN ASM_REWRITE_TAC[]])
### gc_move_refs_data_refs_split
  (* the move of the references takes r2 apart element by element,
     so the induction is on the list that r2 is; the port has no
     induction theorem of the definition.  Of a DataElement the
     element moves into r3 and its list is moved, which is where
     the two theorems about the move of a list come in; of anything
     else the collector only takes the ok flag away *)
  (let gcsimps = record_simps "gc_state"
     ["h1"; "h2"; "r1"; "r2"; "r3"; "r4"] in
   (* a DataElement is a reference when its tag is a mutable one *)
   let isref = prove
    (`!ys l tag qs.
        data_to_word_memoryProof_isRef (DataElement ys l (tag,qs)) <=>
        isMutTag tag`,
     REPEAT GEN_TAC THEN REWRITE_TAC[isRef_def] THEN
     MATCH_REDUCE_TAC THEN
     REWRITE_TAC[injectivity "heap_element"; PAIR_EQ] THEN
     CONV_TAC(REDEPTH_CONV UNWIND_CONV) THEN
     REWRITE_TAC[EXISTS_UNIQUE_REFL; SELECT_REFL]) in
   let hd_is n t =
     (try fst(dest_const(fst(strip_comb t))) = n
      with Failure _ -> false) in
   (* an equation that says what a field of the state was *)
   let is_fld th =
     is_eq(concl th) &&
     (try let h = fst(dest_const(fst(strip_comb(lhs(concl th))))) in
          String.length h > 9 && String.sub h 0 9 = "gc_state_"
      with Failure _ -> false) in
   (* the statement generalised over the list that r2 is, built from
      the goal: the recursion takes that list apart, and the port
      has no induction theorem of the definition *)
   let r2_induct =
     W(fun (asl,w) ->
       let vs,bod = strip_forall w in
       let s = el 1 vs in
       let r2s = find_term
         (fun t -> hd_is "gc_state_r2" t && rand t = s) bod in
       let l = variant (vs @ frees bod) (mk_var("l",type_of r2s)) in
       let gen = list_mk_forall(l :: vs, mk_imp(mk_eq(r2s,l),bod)) in
       SUBGOAL_THEN gen (fun th ->
         MAP_EVERY X_GEN_TAC vs THEN
         ACCEPT_TAC(MP (SPECL (r2s :: vs) th) (REFL r2s)))) in
   (* an empty r2 moves r3 in front of r1 and stops *)
   let base =
     DISCH_THEN(CONJUNCTS_THEN2 (SUBST1_TAC o SYM)
       STRIP_ASSUME_TAC) THEN
     ASM_REWRITE_TAC(K_DEF :: gcsimps) THEN
     RULE_ASSUM_TRY(REWRITE_RULE[ALL_APPEND; ALL]) THEN
     ASM_REWRITE_TAC[ALL_APPEND; ALL] THEN CONV_TAC TAUT in
   (* and an r2 that is no DataElement only takes the ok flag away *)
   let step_common =
     REPEAT GEN_TAC THEN DISCH_TAC THEN
     ONCE_REWRITE_TAC[gc_move_refs_def] THEN ASM_REWRITE_TAC[] THEN
     MATCH_REDUCE_TAC THEN CASES_ON_NAME "h" THEN
     MATCH_REDUCE_TAC THEN
     REWRITE_TAC[injectivity "heap_element";
                 distinctness "heap_element"] THEN
     CONV_TAC(REDEPTH_CONV UNWIND_CONV) THEN
     REWRITE_TAC[EXISTS_UNIQUE_REFL; SELECT_REFL] THEN
     TRY(DISCH_THEN(CONJUNCTS_THEN2 (SUBST1_TAC o SYM)
           STRIP_ASSUME_TAC) THEN
         ASM_REWRITE_TAC(K_DEF :: gcsimps) THEN NO_TAC) in
   (* a DataElement moves into r3: what the move of its list leaves
      in h2 and r4 is what the induction hypothesis asks of them,
      and the other fields are the ones the move did not touch *)
   let data =
     CASES_ON_NAME "a2" THEN PAIRARG_TAC THEN
     CONV_TAC(TOP_DEPTH_CONV let_CONV) THEN
     DISCH_THEN(CONJUNCTS_THEN2 (SUBST1_TAC o SYM)
       STRIP_ASSUME_TAC) THEN
     RULE_ASSUM_TRY(REWRITE_RULE[ALL_APPEND; ALL]) THEN
     REPEAT(FIRST_X_ASSUM(fun th ->
       if is_conj (concl th) then STRIP_ASSUME_TAC th else fail())) THEN
     FIRST_ASSUM(fun a1 ->
       if not(is_pair(rhs(concl a1))) then fail() else
       MP_TAC(MATCH_MP
                (REWRITE_RULE[IMP_CONJ]
                   (GEN_ALL gc_move_list_data_refs_split)) a1) THEN
       MP_TAC(MATCH_MP gc_move_list_IMP a1)) THEN
     DISCH_THEN STRIP_ASSUME_TAC THEN ASM_REWRITE_TAC[] THEN
     DISCH_THEN STRIP_ASSUME_TAC THEN
     REWRITE_TAC[ALL_APPEND] THEN
     FIRST_ASSUM(fun ih ->
       MATCH_MP_TAC(REWRITE_RULE[GSYM IMP_CONJ] ih)) THEN
     W(fun (asl,w) ->
       let vs,bod = strip_exists w in
       let tm = rhs (el 1 (conjuncts bod)) in
       MAP_EVERY EXISTS_TAC [lhand tm; rand tm]) THEN
     ASSUM_LIST(fun ths ->
       RULE_ASSUM_TRY(REWRITE_RULE(filter is_fld ths))) THEN
     RULE_ASSUM_TRY(REWRITE_RULE[isref]) THEN
     ASM_REWRITE_TAC(K_DEF :: gcsimps @ [ALL_APPEND; ALL; isref]) in
   r2_induct THEN LIST_INDUCT_TAC THENL
    [REPEAT GEN_TAC THEN DISCH_TAC THEN
     ONCE_REWRITE_TAC[gc_move_refs_def] THEN ASM_REWRITE_TAC[] THEN
     MATCH_REDUCE_TAC THEN base;
     step_common THEN data])
### gc_move_data_data_refs_split
  (* the move of the data takes the head of h2 -- of the state
     after the move of its list, not of the state it started from,
     so the induction is not on a list but on the measure of the
     definition: the room that is left under the limit, which the
     element that moves into h1 makes smaller *)
  (let gcsimps = record_simps "gc_state"
     ["h1"; "h2"; "r1"; "r2"; "r3"; "r4"] in
   (* a DataElement is a reference when its tag is a mutable one,
      and is a data element whatever it holds *)
   let isref = prove
    (`!ys l tag qs.
        data_to_word_memoryProof_isRef (DataElement ys l (tag,qs)) <=>
        isMutTag tag`,
     REPEAT GEN_TAC THEN REWRITE_TAC[isRef_def] THEN
     MATCH_REDUCE_TAC THEN
     REWRITE_TAC[injectivity "heap_element"; PAIR_EQ] THEN
     CONV_TAC(REDEPTH_CONV UNWIND_CONV) THEN
     REWRITE_TAC[EXISTS_UNIQUE_REFL; SELECT_REFL]) in
   let isdata = prove
    (`!ys l d. isDataElement (DataElement ys l d)`,
     REWRITE_TAC[isDataElement_def] THEN MESON_TAC[]) in
   (* what the recursion moves is the tail of h2, and the port's TL
      is HOL4's, which is the empty list of the empty list *)
   let all_tl = prove
    (`!p (l:(A)list). ALL p l ==> ALL p (TL l)`,
     GEN_TAC THEN LIST_INDUCT_TAC THEN
     REWRITE_TAC[hol4_TL; ALL] THEN CONV_TAC TAUT) in
   let hlen = [heap_length_APPEND; heap_length_CONS; heap_length_NIL;
               el_length_def] in
   (* an equation that says what a field of the state was *)
   let is_fld th =
     is_eq(concl th) &&
     (try let h = fst(dest_const(fst(strip_comb(lhs(concl th))))) in
          String.length h > 9 && String.sub h 0 9 = "gc_state_"
      with Failure _ -> false) in
   (* the statement generalised over the measure of the definition,
      built from the goal: what the recursion makes smaller is the
      room that is left under the limit, and the port has no
      induction theorem of the definition *)
   let meas_induct =
     W(fun (asl,w) ->
       let vs,bod = strip_forall w in
       let cc = el 0 vs and s = el 1 vs in
       let meas =
         mk_binop `(-):num->num->num`
           (list_mk_icomb "gen_gc_conf_limit" [cc])
           (list_mk_icomb "heap_length"
              [list_mk_icomb "gc_state_h1" [s]]) in
       let n = variant (vs @ frees bod) (mk_var("n",`:num`)) in
       let gen = list_mk_forall(n :: vs,
                   mk_imp(mk_binop `(<=):num->num->bool` meas n,
                          bod)) in
       SUBGOAL_THEN gen (fun th ->
         MAP_EVERY X_GEN_TAC vs THEN
         ACCEPT_TAC(MP (SPECL (meas :: vs) th)
                       (SPEC meas LE_REFL)))) in
   (* the states that the collector gives back without recursing:
      the state itself, or the state with the ok flag taken away *)
   let triv =
     DISCH_THEN(CONJUNCTS_THEN2 (SUBST1_TAC o SYM)
       STRIP_ASSUME_TAC) THEN
     ASM_REWRITE_TAC(K_DEF :: gcsimps) THEN
     RULE_ASSUM_TRY(REWRITE_RULE[ALL_APPEND; ALL]) THEN
     ASM_REWRITE_TAC[ALL_APPEND; ALL] THEN TRY(CONV_TAC TAUT) in
   let common =
     REPEAT GEN_TAC THEN DISCH_TAC THEN
     ONCE_REWRITE_TAC[gc_move_data_def] THEN EVERY_CASE_TAC THEN
     REWRITE_TAC[COND_ID] THEN TRY COND_CASES_TAC THEN
     TRY(triv THEN NO_TAC) in
   (* of a measure that is 0 there is no room for the element that
      the recursion moves, so the branch cannot be taken *)
   let absurd =
     SUBGOAL_THEN `F` CONTR_TAC THEN
     RULE_ASSUM_TRY(REWRITE_RULE hlen) THEN ASM_ARITH_TAC in
   (* and the element moves into h1, which leaves the room under the
      limit smaller by its own length: what the move of its list
      leaves in h2 and r4 is what the induction hypothesis asks of
      them, and the other fields are the ones the move did not
      touch *)
   let data =
     CASES_ON_NAME "a2" THEN PAIRARG_TAC THEN
     CONV_TAC(TOP_DEPTH_CONV let_CONV) THEN
     DISCH_THEN(CONJUNCTS_THEN2 (SUBST1_TAC o SYM)
       STRIP_ASSUME_TAC) THEN
     RULE_ASSUM_TRY(REWRITE_RULE[ALL_APPEND; ALL]) THEN
     REPEAT(FIRST_X_ASSUM(fun th ->
       if is_conj (concl th) then STRIP_ASSUME_TAC th
       else fail())) THEN
     FIRST_ASSUM(fun a1 ->
       if not(is_pair(rhs(concl a1))) then fail() else
       MP_TAC(MATCH_MP
                (REWRITE_RULE[IMP_CONJ]
                   (GEN_ALL gc_move_list_data_refs_split)) a1) THEN
       MP_TAC(MATCH_MP gc_move_list_IMP a1)) THEN
     DISCH_THEN STRIP_ASSUME_TAC THEN
     ASM_REWRITE_TAC[ALL; ALL_APPEND] THEN
     DISCH_THEN STRIP_ASSUME_TAC THEN
     ASSUM_LIST(fun ths ->
       RULE_ASSUM_TRY(REWRITE_RULE(filter is_fld ths))) THEN
     ASSUM_LIST(fun ths ->
       MAP_EVERY ASSUME_TAC (mapfilter (MATCH_MP all_tl) ths)) THEN
     RULE_ASSUM_TRY(REWRITE_RULE[isref]) THEN
     REWRITE_TAC[ALL_APPEND] THEN
     FIRST_ASSUM(fun ih ->
       MATCH_MP_TAC(REWRITE_RULE[GSYM IMP_CONJ] ih)) THEN
     W(fun (asl,w) ->
       let vs,bod = strip_exists w in
       let tm = rhs (el 1 (conjuncts bod)) in
       MAP_EVERY EXISTS_TAC [lhand tm; rand tm]) THEN
     ASM_REWRITE_TAC(K_DEF :: gcsimps @
                     [ALL_APPEND; ALL; isref; isdata]) THEN
     RULE_ASSUM_TRY(REWRITE_RULE hlen) THEN
     REWRITE_TAC hlen THEN ASM_ARITH_TAC in
   meas_induct THEN INDUCT_TAC THENL
    [common THEN absurd; common THEN data])
### gc_move_loop_data_refs_split
  (* the loop moves the refs or the data and goes round again, and
     each step keeps the three invariants: the clock is the
     induction, the two theorems above are the step, and an update
     of the ok, the r2 or the r4 field leaves the heaps alone *)
  (let okf = prove
     (`!f (s:('a,'b)gc_state).
         (gc_state_h1 (gc_state_ok_fupd f s) = gc_state_h1 s) /\
         (gc_state_h2 (gc_state_ok_fupd f s) = gc_state_h2 s) /\
         (gc_state_r1 (gc_state_ok_fupd f s) = gc_state_r1 s) /\
         (gc_state_r2 (gc_state_ok_fupd f s) = gc_state_r2 s) /\
         (gc_state_r3 (gc_state_ok_fupd f s) = gc_state_r3 s) /\
         (gc_state_r4 (gc_state_ok_fupd f s) = gc_state_r4 s)`,
      REPEAT GEN_TAC THEN RECORD_CASES_TAC `s:('a,'b)gc_state`) in
    let fupds = prove
     (`!(x:(('a,'b)heap_element)list) (s:('a,'b)gc_state).
         (gc_state_h1 (gc_state_r2_fupd (K x) s) = gc_state_h1 s) /\
         (gc_state_h2 (gc_state_r2_fupd (K x) s) = gc_state_h2 s) /\
         (gc_state_r1 (gc_state_r2_fupd (K x) s) = gc_state_r1 s) /\
         (gc_state_r2 (gc_state_r2_fupd (K x) s) = x) /\
         (gc_state_r3 (gc_state_r2_fupd (K x) s) = gc_state_r3 s) /\
         (gc_state_r4 (gc_state_r2_fupd (K x) s) = gc_state_r4 s) /\
         (gc_state_h1 (gc_state_r4_fupd (K x) s) = gc_state_h1 s) /\
         (gc_state_h2 (gc_state_r4_fupd (K x) s) = gc_state_h2 s) /\
         (gc_state_r1 (gc_state_r4_fupd (K x) s) = gc_state_r1 s) /\
         (gc_state_r2 (gc_state_r4_fupd (K x) s) = gc_state_r2 s) /\
         (gc_state_r3 (gc_state_r4_fupd (K x) s) = gc_state_r3 s) /\
         (gc_state_r4 (gc_state_r4_fupd (K x) s) = x)`,
      REPEAT GEN_TAC THEN RECORD_CASES_TAC `s:('a,'b)gc_state`) in
    let gmrd = GEN_ALL gc_move_refs_data_refs_split in
    let gmdd = GEN_ALL gc_move_data_data_refs_split in
    let refl_exists (asl,w as gl) =
      let vs,bod = strip_exists w in
      let l,r = dest_eq (hd (conjuncts bod)) in
      let i = term_match [] l r in
      MAP_EVERY EXISTS_TAC (map (instantiate i) vs) gl in
    INDUCT_TAC THEN REPEAT GEN_TAC THEN
    GEN_REWRITE_TAC (LAND_CONV o LAND_CONV o LAND_CONV)
      [gen_gc_gc_move_loop_def] THEN
    EVERY_CASE_TAC THEN
    CONV_TAC(TOP_DEPTH_CONV let_CONV) THEN
    REWRITE_TAC[NOT_SUC; ARITH_RULE `SUC n - 1 = n`] THEN
    DISCH_THEN(CONJUNCTS_THEN2 (SUBST1_TAC o SYM) STRIP_ASSUME_TAC) THEN
    REWRITE_TAC[okf] THEN
    TRY(ASM_REWRITE_TAC[] THEN NO_TAC) THEN
    TRY(FIRST_X_ASSUM MATCH_MP_TAC THEN refl_exists THEN
        ASM_REWRITE_TAC[]) THEN
    TRY(MATCH_MP_TAC gmdd THEN refl_exists THEN ASM_REWRITE_TAC[]) THEN
    TRY(MATCH_MP_TAC gmrd THEN refl_exists THEN
        REWRITE_TAC[fupds] THEN
        RULE_ASSUM_TAC(REWRITE_RULE[ALL_APPEND]) THEN
        ASM_REWRITE_TAC[ALL_APPEND; ALL]))
### gen_gc_data_refs_split
  (* the collector starts from a state whose six heaps are empty,
     moves the roots and then runs the loop: what the move of a
     list leaves in h2 and r4 is what the loop asks of them, and
     the fields that the move does not touch are the empty ones of
     the state it started from *)
  (let rt = record_thms "gc_state" in
   (* the witnesses of a lemma about a step of the collector, which
      the equation of the goal gives *)
   let refl_exists (asl,w as gl) =
     let vs,bod = strip_exists w in
     let l,r = dest_eq (hd (conjuncts bod)) in
     let i = term_match [] l r in
     MAP_EVERY EXISTS_TAC (map (instantiate i) vs) gl in
   (* and the fields that the move of a list leaves alone, put
      back: a rewrite with the equations is slow, where the
      substitution is not *)
   let subst_imp =
     FIRST_ASSUM(fun a1 ->
       let imp = MATCH_MP gc_move_list_IMP a1 in
       MAP_EVERY (fun e -> SUBST1_TAC (SYM e))
         (filter (fun th -> is_eq(concl th)) (CONJUNCTS imp))) in
   REPEAT GEN_TAC THEN
   DISCH_THEN(CONJUNCTS_THEN2 MP_TAC ASSUME_TAC) THEN
   REWRITE_TAC[gen_gc_def] THEN
   CONV_TAC(TOP_DEPTH_CONV let_CONV) THEN PAIRARG_TAC THEN
   CONV_TAC(TOP_DEPTH_CONV let_CONV) THEN
   REWRITE_TAC[PAIR_EQ] THEN
   DISCH_THEN(CONJUNCTS_THEN2 (K ALL_TAC) (SUBST1_TAC o SYM)) THEN
   MATCH_MP_TAC(TAUT `b /\ a /\ c ==> a /\ b /\ c`) THEN
   MATCH_MP_TAC(GEN_ALL gc_move_loop_data_refs_split) THEN
   refl_exists THEN REWRITE_TAC[] THEN subst_imp THEN
   REWRITE_TAC(empty_state_def :: rt) THEN REWRITE_TAC[APPEND] THEN
   CONJ_TAC THENL
    [FIRST_ASSUM MATCH_ACCEPT_TAC;
     MATCH_MP_TAC(GEN_ALL gc_move_list_data_refs_split) THEN
     ASM_EXISTS_TAC THEN
     ASM_REWRITE_TAC(empty_state_def :: rt) THEN REWRITE_TAC[ALL]])
### heap_expand_not_isRef
  (REWRITE_TAC[heap_expand_def] THEN COND_CASES_TAC THEN
   REWRITE_TAC[ALL; isRef_def] THEN
   MATCH_REDUCE_TAC THEN REWRITE_TAC[])
### gen_state_ok_reset
  (* the generations that reset_gens makes all start where the first
     heap ends, and nothing of that heap points into the space that
     the expansion leaves: a pointer of a DataElement points at a
     DataElement, and what is in the expansion is an Unused *)
  (let notin = prove
    (`!(hh:((A,B)heap_element) list) rr n p.
        heap_length hh <= p /\ p < n + heap_length hh
        ==> ~(isSomeDataElement
                (heap_lookup p (hh ++ heap_expand n ++ rr)))`,
     REPEAT GEN_TAC THEN STRIP_TAC THEN
     REWRITE_TAC[data_to_word_memoryProof_heap_lookup_APPEND] THEN
     ASM_SIMP_TAC[ARITH_RULE `(h:num) <= p ==> ~(p < h)`;
                  gen_gc_heap_length_heap_expand] THEN
     SUBGOAL_THEN `p - heap_length (hh:((A,B)heap_element) list) < n`
       ASSUME_TAC THENL [ASM_ARITH_TAC; ALL_TAC] THEN
     ASM_REWRITE_TAC[] THEN
     SUBGOAL_THEN `~(n = 0)` ASSUME_TAC THENL
      [ASM_ARITH_TAC; ALL_TAC] THEN
     ASM_REWRITE_TAC[heap_expand_def] THEN
     REWRITE_TAC[heap_lookup_def; el_length_def] THEN
     COND_CASES_TAC THEN
     ASM_REWRITE_TAC[isSomeDataElement_def;
                     injectivity "option"; distinctness "option";
                     distinctness "heap_element"] THEN
     ASM_SIMP_TAC[ARITH_RULE
       `p - h < n /\ ~(n = 0) ==> p - h < (n - 1) + 1`] THEN
     REWRITE_TAC[isSomeDataElement_def; distinctness "option"]) in
   STRIP_TAC THEN
   REWRITE_TAC[reset_gens_def] THEN
   STRUCT_CASES_TAC (ISPEC `data_to_word_config_gc_kind conf`
     (cases "gc_kind")) THEN
   MATCH_REDUCE_TAC THEN
   REWRITE_TAC[gen_state_ok_def; ALL] THEN
   REWRITE_TAC[GSYM ALL_MEM; MEM_MAP; K_DEF] THEN
   REPEAT STRIP_TAC THEN ASM_REWRITE_TAC[LE_REFL] THEN
   REWRITE_TAC[gen_start_ok_def] THEN
   ONCE_REWRITE_TAC[heap_split_APPEND_if] THEN
   REWRITE_TAC[LT_REFL; SUB_REFL; heap_split_0] THEN
   MATCH_REDUCE_TAC THEN
   REWRITE_TAC[APPEND_NIL] THEN
   W(fun (asl,w) ->
     let bod = snd(strip_exists w) in
     let pr = rand(lhs(lhand bod)) in
     let a,b = dest_pair pr in
     MAP_EVERY EXISTS_TAC [a; b]) THEN
   REWRITE_TAC[] THEN
   REPEAT GEN_TAC THEN STRIP_TAC THEN
   MATCH_MP_TAC(TAUT `(~a /\ ~b ==> F) ==> a \/ b`) THEN
   STRIP_TAC THEN
   W(fun (asl,w) ->
     let ths = map snd asl in
     let hd_is n th =
       (try fst(dest_const(fst(strip_comb(concl th)))) = n
        with Failure _ -> false) in
     let arg_is n th =
       (try fst(dest_const(fst(strip_comb(
              el 0 (snd(strip_comb(concl th))))))) = n
        with Failure _ -> false) in
     let okth = find (hd_is "heap_ok") ths in
     let memd = find (fun th ->
       hd_is "MEM" th && arg_is "DataElement" th)
                  ths in
     let memp = find (fun th -> hd_is "MEM" th &&
                                arg_is "gc_shared_Pointer" th) ths in
     let dargs = snd(strip_comb(el 0 (snd(strip_comb(concl memd))))) in
     let pargs = snd(strip_comb(el 0 (snd(strip_comb(concl memp))))) in
     let cl = CONJUNCT2(CONJUNCT2
       (REWRITE_RULE[heap_ok_def] okth)) in
     MP_TAC(SPECL (dargs @ pargs) cl)) THEN
   ASM_REWRITE_TAC[MEM_APPEND] THEN
   DISCH_TAC THEN
   W(fun (asl,w) ->
     let ths = map snd asl in
     let hd_is n th =
       (try fst(dest_const(fst(strip_comb(concl th)))) = n
        with Failure _ -> false) in
     let sde = find (hd_is "isSomeDataElement") ths in
     let heap = rand(el 0 (snd(strip_comb(concl sde)))) in
     let hh = lhand heap in
     let rr = rand(rand heap) in
     MP_TAC(ISPECL [hh; rr] notin)) THEN
   ASM_SIMP_TAC[] THEN
   DISCH_THEN(fun th -> MP_TAC(SPEC_ALL th)) THEN
   ASM_REWRITE_TAC[] THEN ASM_ARITH_TAC)
### heap_split_heap_split
  (* the split at the later point goes through the earlier one: the
     middle piece is what the split of the second half gives, and
     the induction follows the two splits down the heap, one element
     at a time *)
  (let exwit = W(fun (asl,w) ->
     EXISTS_TAC (lhs (el 1 (conjuncts (snd(strip_exists w)))))) in
   let stripconj =
     REPEAT(FIRST_X_ASSUM(fun th ->
       if is_conj (concl th) then STRIP_ASSUME_TAC th else fail())) in
   let aux = prove
    (`!(heap:((A,B)heap_element) list) n1 n2 h1 h2 h3 h4.
        heap_split n2 heap = SOME (h3,h4) /\
        heap_split n1 heap = SOME (h1,h2) /\ n1 <= n2
        ==> ?m. h2 = m ++ h4 /\ h3 = h1 ++ m /\
                heap = h1 ++ m ++ h4 /\
                heap_split (n2 - heap_length h1) h2 = SOME (m,h4)`,
     LIST_INDUCT_TAC THEN REPEAT GEN_TAC THEN
     REWRITE_TAC[heap_split_def] THENL
      [ASM_CASES_TAC `n2 = 0` THEN
       ASM_REWRITE_TAC[distinctness "option"] THEN
       ASM_CASES_TAC `n1 = 0` THEN
       ASM_REWRITE_TAC[distinctness "option"] THEN
       REWRITE_TAC[injectivity "option"; PAIR_EQ] THEN
       STRIP_TAC THEN VAR_EQ_TAC THEN
       EXISTS_TAC `[]:((A,B)heap_element) list` THEN
       REWRITE_TAC[APPEND; heap_length_NIL; SUB_0] THEN
       ASM_REWRITE_TAC[heap_split_def];
       ALL_TAC] THEN
     ASM_CASES_TAC `n2 = 0` THEN
     ASM_REWRITE_TAC[distinctness "option"] THENL
      [STRIP_TAC THEN
       SUBGOAL_THEN `n1 = 0` SUBST_ALL_TAC THENL
        [ASM_ARITH_TAC; ALL_TAC] THEN
       RULE_ASSUM_TAC(REWRITE_RULE[injectivity "option"; PAIR_EQ]) THEN
       stripconj THEN VAR_EQ_TAC THEN
       EXISTS_TAC `[]:((A,B)heap_element) list` THEN
       REWRITE_TAC[APPEND; heap_length_NIL; SUB_0;
                   heap_split_def];
       ALL_TAC] THEN
     ASM_CASES_TAC `n2 < el_length (h:(A,B)heap_element)` THEN
     ASM_REWRITE_TAC[distinctness "option"] THEN
     ASM_CASES_TAC `n1 = 0` THEN ASM_REWRITE_TAC[] THENL
      [EVERY_CASE_TAC THEN
       REWRITE_TAC[distinctness "option"; injectivity "option";
                   PAIR_EQ] THEN
       STRIP_TAC THEN stripconj THEN VAR_EQ_TAC THEN
       REWRITE_TAC[APPEND; heap_length_NIL; SUB_0] THEN
       exwit THEN
       FIRST_X_ASSUM(fun ih ->
         FIRST_ASSUM(fun a1 ->
           MP_TAC(MATCH_MP ih (CONJ a1 (CONJ
             (ISPEC `t:((A,B)heap_element) list`
                (GEN_ALL heap_split_0))
             (SPEC `n2 - el_length (h:(A,B)heap_element)`
                LE_0)))))) THEN
       REWRITE_TAC[APPEND] THEN
       DISCH_THEN(X_CHOOSE_THEN `mm:((A,B)heap_element) list`
         STRIP_ASSUME_TAC) THEN
       VAR_EQ_TAC THEN
       ASM_REWRITE_TAC[APPEND; CONS_11; heap_split_def] THEN
       MATCH_REDUCE_TAC THEN REWRITE_TAC[];
       ALL_TAC] THEN
     ASM_CASES_TAC `n1 < el_length (h:(A,B)heap_element)` THEN
     ASM_REWRITE_TAC[distinctness "option"] THEN
     EVERY_CASE_TAC THEN
     REWRITE_TAC[distinctness "option"; injectivity "option";
                 PAIR_EQ] THEN
     STRIP_TAC THEN stripconj THEN VAR_EQ_TAC THEN
     SUBGOAL_THEN `n1 - el_length (h:(A,B)heap_element) <=
                   n2 - el_length (h:(A,B)heap_element)`
       ASSUME_TAC THENL [ASM_ARITH_TAC; ALL_TAC] THEN
     FIRST_X_ASSUM(fun ih ->
       FIRST_ASSUM(fun a1 -> FIRST_ASSUM(fun a2 -> FIRST_ASSUM(fun a3 ->
         MP_TAC(MATCH_MP ih (CONJ a1 (CONJ a2 a3))) THEN
         DISCH_THEN(X_CHOOSE_THEN `mm:((A,B)heap_element) list`
           STRIP_ASSUME_TAC) THEN
         VAR_EQ_TAC THEN
         EXISTS_TAC `mm:((A,B)heap_element) list` THEN
         ASM_REWRITE_TAC[APPEND; CONS_11;
                         heap_length_CONS] THEN
         REWRITE_TAC[ARITH_RULE `a - (b + c) = (a - b) - c`] THEN
         ASM_REWRITE_TAC[]))))) in
   REPEAT GEN_TAC THEN MATCH_ACCEPT_TAC aux)
### heap_split_LESS_EQ
  (LIST_INDUCT_TAC THEN REPEAT GEN_TAC THEN
   REWRITE_TAC[heap_split_def; heap_length_NIL;
               heap_length_CONS] THEN
   EVERY_CASE_TAC THEN REPEAT COND_CASES_TAC THEN
   ASM_REWRITE_TAC[distinctness "option"; LE_0] THEN
   DISCH_TAC THEN USE_IH THEN ASM_ARITH_TAC)
### isRef_heap_expand
  (GEN_TAC THEN REWRITE_TAC[heap_expand_def] THEN
   COND_CASES_TAC THEN
   REWRITE_TAC[ALL; isRef_def] THEN
   MATCH_REDUCE_TAC THEN REWRITE_TAC[])
### data_pointers_heap_expand
  (* the expansion is one element that is not a DataElement, so it
     contributes no pointer and shifts none *)
  (let dp = data_pointers_def in
   let aux = prove
    (`!heap n. data_pointers (APPEND heap (heap_expand n)) =
               data_pointers heap`,
     LIST_INDUCT_TAC THENL
      [GEN_TAC THEN REWRITE_TAC[APPEND; heap_expand_def] THEN
       COND_CASES_TAC THEN
       GEN_REWRITE_TAC LAND_CONV [dp] THEN MATCH_REDUCE_TAC THEN
       REWRITE_TAC[dp] THEN MATCH_REDUCE_TAC THEN REWRITE_TAC[MAP];
       GEN_TAC THEN REWRITE_TAC[APPEND] THEN CASES_BY_NAME "h" THEN
       GEN_REWRITE_TAC LAND_CONV [dp] THEN MATCH_REDUCE_TAC THEN
       GEN_REWRITE_TAC RAND_CONV [dp] THEN MATCH_REDUCE_TAC THEN
       ASM_REWRITE_TAC[]]) in
   MATCH_ACCEPT_TAC aux)
### data_length_APPEND_heap_expand
  (* the expansion contributes no data element, and the data length
     of a cons is the length of the head when it is one *)
  (let hl = heap_lookup_def in
   let dp = data_pointers_def in
   let dl = data_length_def in
   let ll = lookup_len_def in
   (* a lookup past the first element is one in the tail *)
   let shift_lookup = prove
    (`!(x:((A),(B))heap_element) xs n.
        heap_lookup (n + el_length x) (CONS x xs) = heap_lookup n xs`,
     REPEAT GEN_TAC THEN
     GEN_REWRITE_TAC LAND_CONV [hl] THEN
     MP_TAC(ISPEC `x:((A),(B))heap_element` el_length_GT_0) THEN
     DISCH_TAC THEN
     COND_CASES_TAC THENL
      [SUBGOAL_THEN `F` CONTR_TAC THEN ASM_ARITH_TAC; ALL_TAC] THEN
     COND_CASES_TAC THENL
      [SUBGOAL_THEN `F` CONTR_TAC THEN ASM_ARITH_TAC; ALL_TAC] THEN
     AP_THM_TAC THEN AP_TERM_TAC THEN ARITH_TAC) in
   let map_shift = prove
    (`!(x:((A),(B))heap_element) xs ps.
        MAP (lookup_len (CONS x xs)) (MAP (\n. n + el_length x) ps) =
        MAP (lookup_len xs) ps`,
     GEN_TAC THEN GEN_TAC THEN LIST_INDUCT_TAC THEN
     ASM_REWRITE_TAC[MAP; ll; shift_lookup]) in
   let dl_cons = prove
    (`(!ys l d xs. data_length (CONS (DataElement ys l d) xs) =
                   el_length (DataElement ys l d) + data_length xs) /\
      (!k xs. data_length (CONS (Unused k:((A),(B))heap_element) xs) =
              data_length xs) /\
      (!n d l xs.
         data_length (CONS (ForwardPointer n d l:((A),(B))heap_element)
                           xs) = data_length xs)`,
     REPEAT CONJ_TAC THEN REPEAT GEN_TAC THEN
     GEN_REWRITE_TAC LAND_CONV [dl] THEN
     GEN_REWRITE_TAC (LAND_CONV o RAND_CONV o RAND_CONV) [dp] THEN
     MATCH_REDUCE_TAC THEN
     REWRITE_TAC[MAP; map_shift; SUM_DEF; ITLIST; dl; ll; hl] THEN
     REWRITE_TAC[ADD_CLAUSES]) in
   let aux = prove
    (`!heap n. data_length (APPEND heap (heap_expand n)) =
               data_length heap`,
     LIST_INDUCT_TAC THENL
      [GEN_TAC THEN REWRITE_TAC[APPEND; heap_expand_def] THEN
       COND_CASES_TAC THEN
       REWRITE_TAC[dl; dp; MAP; SUM_DEF; ITLIST] THEN
       MATCH_REDUCE_TAC THEN REWRITE_TAC[MAP; SUM_DEF; ITLIST];
       GEN_TAC THEN REWRITE_TAC[APPEND] THEN
       CASES_ON_NAME "h" THEN
       ASM_REWRITE_TAC[dl_cons]]) in
   MATCH_ACCEPT_TAC aux)
### data_length_heap_length
  (* every element is a data element, so each contributes its own
     length and the data length is the heap length *)
  (let hl = heap_lookup_def in
   let dp = data_pointers_def in
   let dl = data_length_def in
   let ll = lookup_len_def in
   (* a lookup past the first element is one in the tail *)
   let shift_lookup = prove
    (`!(x:((A),(B))heap_element) xs n.
        heap_lookup (n + el_length x) (CONS x xs) = heap_lookup n xs`,
     REPEAT GEN_TAC THEN
     GEN_REWRITE_TAC LAND_CONV [hl] THEN
     MP_TAC(ISPEC `x:((A),(B))heap_element` el_length_GT_0) THEN
     DISCH_TAC THEN
     COND_CASES_TAC THENL
      [SUBGOAL_THEN `F` CONTR_TAC THEN ASM_ARITH_TAC; ALL_TAC] THEN
     COND_CASES_TAC THENL
      [SUBGOAL_THEN `F` CONTR_TAC THEN ASM_ARITH_TAC; ALL_TAC] THEN
     AP_THM_TAC THEN AP_TERM_TAC THEN ARITH_TAC) in
   let map_shift = prove
    (`!(x:((A),(B))heap_element) xs ps.
        MAP (lookup_len (CONS x xs)) (MAP (\n. n + el_length x) ps) =
        MAP (lookup_len xs) ps`,
     GEN_TAC THEN GEN_TAC THEN LIST_INDUCT_TAC THEN
     ASM_REWRITE_TAC[MAP; ll; shift_lookup]) in
   let dl_cons = prove
    (`(!ys l d xs. data_length (CONS (DataElement ys l d) xs) =
                   el_length (DataElement ys l d) + data_length xs) /\
      (!k xs. data_length (CONS (Unused k:((A),(B))heap_element) xs) =
              data_length xs) /\
      (!n d l xs.
         data_length (CONS (ForwardPointer n d l:((A),(B))heap_element)
                           xs) = data_length xs)`,
     REPEAT CONJ_TAC THEN REPEAT GEN_TAC THEN
     GEN_REWRITE_TAC LAND_CONV [dl] THEN
     GEN_REWRITE_TAC (LAND_CONV o RAND_CONV o RAND_CONV) [dp] THEN
     MATCH_REDUCE_TAC THEN
     REWRITE_TAC[MAP; map_shift; SUM_DEF; ITLIST; dl; ll; hl] THEN
     REWRITE_TAC[ADD_CLAUSES]) in
   let hlen_cl = prove
    (`heap_length [] = 0 /\
      (!x xs. heap_length (CONS x xs) =
              el_length x + heap_length xs)`,
     REWRITE_TAC[heap_length_def; MAP; SUM_DEF; ITLIST]) in
   let aux = prove
    (`!heap. EVERY isDataElement heap
             ==> data_length heap = heap_length heap`,
     LIST_INDUCT_TAC THENL
      [REWRITE_TAC[dl; dp] THEN MATCH_REDUCE_TAC THEN
       REWRITE_TAC[MAP; SUM_DEF; ITLIST; hlen_cl];
       REWRITE_TAC[ALL] THEN STRIP_TAC THEN
       CASES_ON_NAME "h" THEN
       RULE_ASSUM_TAC(REWRITE_RULE[isDataElement_def;
                                   distinctness "heap_element";
                                   injectivity "heap_element"]) THEN
       TRY(FIRST_ASSUM CONTR_TAC) THEN
       ASM_SIMP_TAC[dl_cons; hlen_cl]]) in
   MATCH_ACCEPT_TAC aux)
### data_length_CONS
  (* what HOL4's simp set does with data_pointers and lookup_len: the
     pointers of the tail are shifted by the length of the head, and
     a lookup at a shifted pointer is the lookup in the tail *)
  (let dp = data_pointers_def in
   let dl = data_length_def in
   let ll = lookup_len_def in
   let dp_cl = prove
    (`data_pointers ([]:((A,B)heap_element)list) = [] /\
      (!xs l d (t:((A,B)heap_element)list).
         data_pointers (CONS (DataElement xs l d) t) =
         CONS 0 (MAP (\n. n + el_length
                             (DataElement xs l d:(A,B)heap_element))
                     (data_pointers t))) /\
      (!k (t:((A,B)heap_element)list).
         data_pointers (CONS (Unused k) t) =
         MAP (\n. n + el_length (Unused k:(A,B)heap_element))
             (data_pointers t)) /\
      (!a b c (t:((A,B)heap_element)list).
         data_pointers (CONS (ForwardPointer a b c) t) =
         MAP (\n. n + el_length
                        (ForwardPointer a b c:(A,B)heap_element))
             (data_pointers t))`,
     REPEAT CONJ_TAC THEN REPEAT GEN_TAC THEN
     GEN_REWRITE_TAC LAND_CONV [dp] THEN MATCH_REDUCE_TAC THEN
     REWRITE_TAC[]) in
   let hl_sh = prove
    (`!n (x:(A,B)heap_element) xs.
        heap_lookup (n + el_length x) (CONS x xs) = heap_lookup n xs`,
     REPEAT GEN_TAC THEN
     MP_TAC(ISPEC `x:(A,B)heap_element` el_length_GT_0) THEN
     REWRITE_TAC[heap_lookup_def] THEN DISCH_TAC THEN
     COND_CASES_TAC THENL
      [SUBGOAL_THEN `F` CONTR_TAC THEN ASM_ARITH_TAC; ALL_TAC] THEN
     COND_CASES_TAC THENL
      [SUBGOAL_THEN `F` CONTR_TAC THEN ASM_ARITH_TAC; ALL_TAC] THEN
     REWRITE_TAC[ARITH_RULE `(n + m) - m = n`]) in
   let map_sh = prove
    (`!l (x:(A,B)heap_element) xs.
        MAP (lookup_len (CONS x xs)) (MAP (\n. n + el_length x) l) =
        MAP (lookup_len xs) l`,
     LIST_INDUCT_TAC THEN ASM_REWRITE_TAC[MAP; ll; hl_sh]) in
   let ll_0 = prove
    (`!(x:(A,B)heap_element) xs.
        lookup_len (CONS x xs) 0 = el_length x`,
     REWRITE_TAC[ll; heap_lookup_def] THEN
     CONV_TAC(ONCE_DEPTH_CONV MATCH_CONV) THEN REWRITE_TAC[]) in
   let aux = prove
    (`!(x:(A,B)heap_element) xs.
        data_length (CONS x xs) = data_length [x] + data_length xs`,
     GEN_TAC THEN GEN_TAC THEN REWRITE_TAC[dl] THEN
     STRUCT_CASES_TAC
       (ISPEC `x:(A,B)heap_element`
              (cases_of `:(A,B)heap_element`)) THEN
     REWRITE_TAC[dp_cl; MAP; map_sh; ll_0; SUM_DEF; ITLIST] THEN
     ARITH_TAC) in
   MATCH_ACCEPT_TAC aux)
### data_length_APPEND
  (let dl_nil = prove
    (`data_length ([]:((A,B)heap_element)list) = 0`,
     REWRITE_TAC[data_length_def] THEN
     GEN_REWRITE_TAC ONCE_DEPTH_CONV [data_pointers_def] THEN
     MATCH_REDUCE_TAC THEN REWRITE_TAC[MAP; SUM_DEF; ITLIST]) in
   LIST_INDUCT_TAC THENL
    [REWRITE_TAC[APPEND; dl_nil] THEN ARITH_TAC;
     GEN_TAC THEN REWRITE_TAC[APPEND] THEN
     GEN_REWRITE_TAC LAND_CONV [data_length_CONS] THEN
     GEN_REWRITE_TAC (RAND_CONV o LAND_CONV) [data_length_CONS] THEN
     ASM_REWRITE_TAC[] THEN ARITH_TAC])
### data_length_heap_expand
  (REWRITE_TAC[heap_expand_def] THEN COND_CASES_TAC THEN
   REWRITE_TAC[data_length_def] THEN
   GEN_REWRITE_TAC ONCE_DEPTH_CONV [data_pointers_def] THEN
   MATCH_REDUCE_TAC THEN
   GEN_REWRITE_TAC ONCE_DEPTH_CONV [data_pointers_def] THEN
   MATCH_REDUCE_TAC THEN REWRITE_TAC[MAP; SUM_DEF; ITLIST])
### heap_store_lemma
  (LIST_INDUCT_TAC THENL
    [REPEAT GEN_TAC THEN
     REWRITE_TAC[heap_length_NIL; APPEND; heap_store_def] THEN
     REWRITE_TAC[PAIR_EQ; EQ_SYM_EQ];
     REPEAT GEN_TAC THEN
     REWRITE_TAC[heap_length_CONS; APPEND] THEN
     GEN_REWRITE_TAC LAND_CONV [heap_store_def] THEN
     MP_ISPEC_NAME "h" el_length_GT_0 THEN DISCH_TAC THEN
     ASM_SIMP_TAC[ARITH_RULE `1 <= a ==> ~(a + b = 0)`;
                  ARITH_RULE `1 <= a ==> ~(a + b < a)`;
                  ARITH_RULE `(a + b) - a = b`] THEN
     ASM_REWRITE_TAC[] THEN CONV_TAC(ONCE_DEPTH_CONV let_CONV) THEN
     REWRITE_TAC[PAIR_EQ]])
### isSomeDataElement_heap_lookup_lemma1
  (let isde = isSomeDataElement_def in
   let opt = [distinctness "option"; injectivity "option";
              distinctness "heap_element"] in
   REWRITE_TAC[heap_lookup_def; el_length_def] THEN
   COND_CASES_TAC THEN ASM_REWRITE_TAC(isde :: opt) THENL
    [MATCH_MP_TAC(TAUT `~a ==> ~(a /\ b)`) THEN ASM_ARITH_TAC;
     COND_CASES_TAC THEN ASM_REWRITE_TAC(isde :: opt) THENL
      [MATCH_MP_TAC(TAUT `~a ==> ~(a /\ b)`) THEN ASM_ARITH_TAC;
       SUBGOAL_THEN `(k:num) < n` (fun th -> REWRITE_TAC[th]) THEN
       ASM_ARITH_TAC]])
### isSomeDataElement_heap_lookup_lemma2
  (REWRITE_TAC[heap_expand_def] THEN COND_CASES_TAC THEN
   ASM_REWRITE_TAC[APPEND; SUB_0; LE_0] THEN
   REWRITE_TAC[isSomeDataElement_heap_lookup_lemma1] THEN
   ASM_SIMP_TAC[ARITH_RULE `~(k = 0) ==> (n - (k - 1 + 1) = n - k)`;
                ARITH_RULE `~(k = 0) ==> (k - 1 < n <=> k <= n)`])
### isSomeDataElement_heap_lookup_lemma3
  (let isde = isSomeDataElement_def in
   let opt = [distinctness "option"; injectivity "option";
              distinctness "heap_element"] in
   DISCH_TAC THEN REWRITE_TAC[heap_lookup_def] THEN
   ASM_REWRITE_TAC[] THEN COND_CASES_TAC THEN
   ASM_REWRITE_TAC(isde :: opt) THENL
    [MATCH_MP_TAC(TAUT `~a ==> ~(a /\ b)`) THEN ASM_ARITH_TAC;
     ASM_SIMP_TAC[ARITH_RULE `~(a:num < b) ==> (b <= a <=> T)`]])
### heap_store_rel_lemma
  (REWRITE_TAC[heap_store_rel_def;
               isSomeDataElement_def] THEN
   MESON_TAC[])
### v_inv_SUBMAP_lemma
  (* complete induction on the ck of the relation: the value of the
     invariant is taken apart with v_inv_def and the rule of the
     relation for that shape is applied, where the greater maps
     give the same values and the greater heap the same data
     elements.  What the rule asks of a value inside the value is
     the induction hypothesis at ck - 1 *)
  (let (vr,_,_) = v_inv_ck in
   let rl = CONJUNCTS vr in
   let vdef = v_inv_def in
   (* a data element of the heap is still there after the store *)
   let keep = prove
    (`!h1 h2 n e.
        heap_store_rel h1 h2 ==> heap_lookup n h1 = SOME e ==>
        isDataElement e ==> heap_lookup n h2 = SOME e`,
     REWRITE_TAC[heap_store_rel_def] THEN
     REPEAT STRIP_TAC THEN
     FIRST_X_ASSUM(fun th -> MP_TAC(SPEC `n:num` th)) THEN
     ASM_REWRITE_TAC[isSomeDataElement_def;
                     injectivity "option"] THEN
     FIRST_X_ASSUM(MP_TAC o
                   REWRITE_RULE[isDataElement_def]) THEN
     STRIP_TAC THEN ASM_REWRITE_TAC[] THEN MESON_TAC[]) in
   (* the four shapes of a data element that the invariant uses.
      The theorem of the file that says this and more stands
      later in the file than this one does *)
   let isde4 = prove
    (`isDataElement (BlockRep tag ys1) /\
      isDataElement (Word64Rep (:'a) w) /\
      isDataElement (ThunkBlock ev v) /\
      isDataElement (Bignum i)`,
     REWRITE_TAC[isDataElement_def; BlockRep_def;
                 Word64Rep_def; ThunkBlock_def;
                 bignum_def] THEN
     PAIRARG_TAC THEN CONV_TAC(TOP_DEPTH_CONV let_CONV) THEN
     REPEAT CONJ_TAC THEN TRY COND_CASES_TAC THEN MESON_TAC[]) in
   let keep_of hsr hl =
     REWRITE_RULE[isde4] (MATCH_MP (MATCH_MP keep hsr) hl) in
   let KEEP_TAC =
     FIRST_ASSUM(fun hsr -> FIRST_ASSUM(fun hl ->
       MATCH_ACCEPT_TAC(keep_of hsr hl))) in
   let lt1 = ARITH_RULE `~(ck = 0) ==> ck - 1 < ck` in
   (* the b of a RefPtr that the two thunk rules ask to be false *)
   let NOT_VAR_TAC =
     FIRST_ASSUM(fun nb ->
       if is_neg(concl nb) && is_var(rand(concl nb))
       then SUBST_ALL_TAC(EQF_INTRO nb) else fail()) in
   let setup =
     MATCH_MP_TAC num_WF THEN X_GEN_TAC `ck:num` THEN
     DISCH_TAC THEN REPEAT GEN_TAC THEN DISCH_TAC THEN STRIP_TAC THEN
     CASES_ON_NAME "w" THEN USE_CHANGED [vdef] in
   (* a Number is a small one or a Bignum of the heap *)
   let c1 =
     COND_CASES_TAC THEN STRIP_TAC THEN SUBST_LHS_TAC THENL
      [MATCH_MP_TAC(el 0 rl) THEN ASM_REWRITE_TAC[];
       MATCH_MP_TAC(el 1 rl) THEN ASM_REWRITE_TAC[] THEN KEEP_TAC] in
   let c2 = STRIP_TAC THEN REPEAT SUBST_LHS_TAC THEN
            MATCH_MP_TAC(el 2 rl) THEN KEEP_TAC in
   (* a Block is a BlockNil or a BlockRep whose elements the
      induction hypothesis carries over one by one *)
   let c3 =
     COND_CASES_TAC THEN STRIP_TAC THEN REPEAT SUBST_LHS_TAC THENL
      [MATCH_MP_TAC(el 7 rl) THEN ASM_REWRITE_TAC[];
       MATCH_MP_TAC(el 8 rl) THEN REPEAT CONJ_TAC THENL
        [FIRST_ASSUM MATCH_ACCEPT_TAC;
         DISCH_TAC THEN
         FIRST_ASSUM(fun a2th ->
           if can (term_match [] `EVERY2 (p:A->B->bool) l m`)
                  (concl a2th)
           then MP_TAC a2th else fail()) THEN
         MATCH_MP_TAC MONO_ALL2 THEN BETA_TAC THEN
         REPEAT STRIP_TAC THEN CK_IH_TAC;
         FIRST_ASSUM(fun sm -> FIRST_ASSUM(fun fl ->
           MATCH_ACCEPT_TAC(MATCH_MP FLOOKUP_SUBMAP (CONJ sm fl))));
         KEEP_TAC]] in
   let c4 = STRIP_TAC THEN REPEAT SUBST_LHS_TAC THEN
            MATCH_ACCEPT_TAC(el 3 rl) in
   (* and a RefPtr is a plain reference or one of the two thunks,
      whose value and heap element the rule names and not its
      conclusion, so MESON applies the rule *)
   let d5 =
     FIRST_ASSUM(fun sm -> FIRST_ASSUM(fun fd ->
       let s = MATCH_MP (MATCH_MP SUBMAP_FAPPLY sm) fd in
       REPEAT SUBST_LHS_TAC THEN REWRITE_TAC[CONJUNCT2 s] THEN
       MATCH_MP_TAC(el 4 rl) THEN
       REWRITE_TAC[CONJUNCT1 s] THEN REPEAT CONJ_TAC THEN
       TRY(FIRST_ASSUM MATCH_ACCEPT_TAC))) in
   let d6 =
     NOT_VAR_TAC THEN
     FIRST_ASSUM(fun sm -> FIRST_ASSUM(fun fd ->
       let s = MATCH_MP (MATCH_MP SUBMAP_FAPPLY sm) fd in
       RULE_ASSUM_TRY(REWRITE_RULE[CONJUNCT2 s]) THEN
       REPEAT SUBST_LHS_TAC THEN
       REWRITE_TAC[CONJUNCT2 s] THEN
       FIRST_ASSUM(fun hsr -> FIRST_ASSUM(fun hl ->
         FIRST_ASSUM(fun ih ->
           ASM_MESON_TAC[el 5 rl; CONJUNCT1 s; keep_of hsr hl;
                         SPEC `ck - 1` ih; lt1]))))) in
   let d7 =
     NOT_VAR_TAC THEN
     FIRST_ASSUM(fun ih ->
       ASM_MESON_TAC[el 6 rl; SPEC `ck - 1` ih; lt1]) in
   let c5 =
     DISCH_THEN(DISJ_CASES_THEN2 STRIP_ASSUME_TAC
       (DISJ_CASES_THEN2 STRIP_ASSUME_TAC STRIP_ASSUME_TAC)) THENL
      [d5; d6; d7] in
   setup THENL [c1; c2; c3; c4; c5])
### v_inv_SUBMAP
  (REPEAT STRIP_TAC THEN ASM_MESON_TAC[v_inv_eq; v_inv_SUBMAP_lemma])
### heap_store_rel_v_inv
  (REPEAT STRIP_TAC THEN MATCH_MP_TAC v_inv_SUBMAP THEN
   ASM_REWRITE_TAC[SUBMAP_REFL])
### heap_store_unused_alt_thm
  (* the store goes where the unused element of the split sits: the
     split is as long as the space, so what is left of it after
     that element is empty, and then heap_store_lemma says what
     the heap becomes *)
  ((* the head constant of a term, by name *)
   let hd_is n t =
     (try fst(dest_const(fst(strip_comb t))) = n
      with Failure _ -> false) in
   (* the assumption that a test picks out *)
   let grab asl p =
     tryfind (fun (_,th) ->
       if (try p th with Failure _ -> false) then th else fail())
       asl in
   (* an element of a heap is at least one word long *)
   let elpos = prove
    (`!y:(A,B)heap_element. 0 < el_length y`,
     GEN_TAC THEN
     STRUCT_CASES_TAC(ISPEC `y:(A,B)heap_element`
       (cases_of `:(A,B)heap_element`)) THEN
     REWRITE_TAC[el_length_def] THEN ARITH_TAC) in
   (* the length of a heap, clause by clause *)
   let hlen_cl = prove
    (`heap_length [] = 0 /\
      (!x xs. heap_length (CONS x xs) =
              el_length x + heap_length xs)`,
     REWRITE_TAC[heap_length_def; MAP; SUM_DEF; ITLIST]) in
   (* so a heap of no length is empty *)
   let hlen0 = prove
    (`!hb:((A,B)heap_element)list. heap_length hb = 0 ==> hb = []`,
     LIST_INDUCT_TAC THEN
     REWRITE_TAC[hlen_cl; NOT_CONS_NIL] THEN
     MP_TAC(ISPEC `h:(A,B)heap_element` elpos) THEN ARITH_TAC) in
   REPEAT GEN_TAC THEN
   REWRITE_TAC[heap_store_unused_alt_def] THEN
   COND_CASES_TAC THEN REWRITE_TAC[PAIR_EQ] THEN
   POP_ASSUM(CONJUNCTS_THEN2 ASSUME_TAC ASSUME_TAC) THEN
   STRIP_TAC THEN
   FIRST_ASSUM(fun hs ->
     MP_TAC(MATCH_MP heap_split_heap_length hs)) THEN
   DISCH_THEN(REPEAT_TCL CONJUNCTS_THEN ASSUME_TAC) THEN
   SUBGOAL_THEN `0 < n` ASSUME_TAC THENL
    [ASM_MESON_TAC[elpos; LTE_TRANS]; ALL_TAC] THEN
   FIRST_ASSUM(fun eq ->
     if is_eq (concl eq) && hd_is "APPEND" (lhand (concl eq))
     then SUBST_ALL_TAC (SYM eq) else fail()) THEN
   (* the lookup is inside the first half of the split *)
   W(fun (asl,w) ->
     let hl = grab asl (fun th ->
       hd_is "heap_lookup" (lhand (concl th))) in
     let ap = rand (lhand (concl hl)) in
     SUBGOAL_THEN (subst [lhand ap,ap] (concl hl)) ASSUME_TAC THENL
      [MP_TAC(REWRITE_RULE
         [data_to_word_memoryProof_heap_lookup_APPEND] hl) THEN
       ASM_SIMP_TAC[ARITH_RULE `0 < n ==> a < a + n`] THEN
       TRY(DISCH_THEN ACCEPT_TAC);
       ALL_TAC]) THEN
   FIRST_ASSUM(fun hl ->
     if hd_is "heap_lookup" (lhand (concl hl)) &&
        is_var (rand (lhand (concl hl)))
     then MP_TAC(MATCH_MP heap_lookup_SPLIT hl) else fail()) THEN
   DISCH_THEN(REPEAT_TCL CHOOSE_THEN STRIP_ASSUME_TAC) THEN
   FIRST_ASSUM(fun eq ->
     if is_eq (concl eq) && is_var (lhs (concl eq)) &&
        hd_is "APPEND" (rhs (concl eq))
     then SUBST_ALL_TAC eq else fail()) THEN
   (* what is left of the split after that element is empty *)
   W(fun (asl,w) ->
     MP_TAC(ISPEC (var_by_name "hb" (asl,w)) hlen0)) THEN
   ANTS_TAC THENL
    [FIRST_ASSUM(fun hl ->
       if is_eq (concl hl) &&
          hd_is "heap_length" (lhand (concl hl)) &&
          hd_is "+" (rand (concl hl))
       then MP_TAC(REWRITE_RULE[heap_length_APPEND; hlen_cl;
                                el_length_def] hl)
       else fail()) THEN
     MP_TAC(ASSUME `0 < n`) THEN
     FIRST_ASSUM(fun ae ->
       if is_eq (concl ae) && is_var (lhs (concl ae)) &&
          hd_is "heap_length" (rhs (concl ae))
       then SUBST1_TAC ae else fail()) THEN
     ARITH_TAC;
     ALL_TAC] THEN
   DISCH_THEN SUBST_ALL_TAC THEN
   W(fun (asl,w) -> EXISTS_TAC (var_by_name "ha" (asl,w))) THEN
   REPEAT CONJ_TAC THEN TRY(REWRITE_TAC[] THEN NO_TAC) THEN
   TRY(FIRST_ASSUM(fun ae -> ACCEPT_TAC (SYM ae))) THEN
   (* and the store puts what it stores where that element was *)
   FIRST_ASSUM(fun hs ->
     if hd_is "heap_store" (lhand (concl hs))
     then MP_TAC(REWRITE_RULE[GSYM APPEND_ASSOC; APPEND] hs)
     else fail()) THEN
   FIRST_ASSUM(fun ae ->
     if is_eq (concl ae) && is_var (lhs (concl ae)) &&
        hd_is "heap_length" (rhs (concl ae))
     then SUBST1_TAC ae else fail()) THEN
   REWRITE_TAC[heap_store_lemma; PAIR_EQ] THEN
   DISCH_THEN(CONJUNCTS_THEN2 (SUBST1_TAC o SYM) (K ALL_TAC)) THEN
   REWRITE_TAC[GSYM APPEND_ASSOC; APPEND])
### heap_store_unused_alt_heap_lookup
  (* the store into the unused space is a store at the address it
     keeps, so the lookup below that address gives the same; the
     induction is the one of the theorem about a store and a lookup
     that the file states further down, and HOL4 repeats it here as
     well *)
  (let hsl = prove
    (`!heap heap2 a (x:((A,B)heap_element)list) n.
        heap_store a x heap = (heap2,T) /\ n < a
        ==> heap_lookup n heap = heap_lookup n heap2`,
     LIST_INDUCT_TAC THEN REPEAT GEN_TAC THENL
      [REWRITE_TAC[heap_store_def; PAIR_EQ];
       GEN_REWRITE_TAC (LAND_CONV o LAND_CONV o LAND_CONV)
         [heap_store_def] THEN
       COND_CASES_TAC THENL
        [ASM_REWRITE_TAC[ARITH_RULE `((n:num) < 0) <=> F`];
         ALL_TAC] THEN
       COND_CASES_TAC THENL
        [REWRITE_TAC[PAIR_EQ]; ALL_TAC] THEN
       PAIRARG_TAC THEN CONV_TAC(TOP_DEPTH_CONV let_CONV) THEN
       REWRITE_TAC[PAIR_EQ] THEN
       DISCH_THEN(CONJUNCTS_THEN2
         (CONJUNCTS_THEN2 (SUBST1_TAC o SYM)
            (fun th -> SUBST_ALL_TAC(EQT_INTRO th)))
         ASSUME_TAC) THEN
       ONCE_REWRITE_TAC[heap_lookup_def] THEN
       COND_CASES_TAC THEN ASM_REWRITE_TAC[] THEN
       COND_CASES_TAC THEN ASM_REWRITE_TAC[] THEN
       FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_EXISTS_TAC THEN
       ASM_REWRITE_TAC[] THEN ARITH_ASM_TAC]) in
   REPEAT GEN_TAC THEN
   REWRITE_TAC[heap_store_unused_alt_def] THEN
   COND_CASES_TAC THENL
    [MATCH_ACCEPT_TAC hsl;
     REWRITE_TAC[PAIR_EQ]])
### heap_split_heap_store
  (* a store above the split leaves the first half of the split as
     it was: the store goes down the heap one element at a time and
     the induction carries the split along *)
  (let stripconj =
     REPEAT(FIRST_X_ASSUM(fun th ->
       if is_conj (concl th) then STRIP_ASSUME_TAC th else fail())) in
   let aux = prove
    (`!(heap:((A,B)heap_element) list) e h1 h2 a y heap2.
        heap_split e heap = SOME (h1,h2) /\
        heap_store a y heap = (heap2,T) /\ e <= a
        ==> ?h3. heap_split e heap2 = SOME (h1,h3)`,
     LIST_INDUCT_TAC THEN REPEAT GEN_TAC THEN
     REWRITE_TAC[heap_split_def; heap_store_def] THENL
      [REWRITE_TAC[PAIR_EQ];
       ALL_TAC] THEN
     ASM_CASES_TAC `e = 0` THEN ASM_REWRITE_TAC[] THENL
      [REWRITE_TAC[injectivity "option"; PAIR_EQ] THEN
       STRIP_TAC THEN stripconj THEN VAR_EQ_TAC THEN
       W(fun (asl,w) ->
         EXISTS_TAC (rand(lhs(snd(strip_exists w))))) THEN
       REWRITE_TAC[heap_split_0];
       ALL_TAC] THEN
     ASM_CASES_TAC `e < el_length (h:(A,B)heap_element)` THEN
     ASM_REWRITE_TAC[distinctness "option"] THEN
     STRIP_TAC THEN
     SUBGOAL_THEN
       `~(a = 0) /\ ~(a < el_length (h:(A,B)heap_element))`
       STRIP_ASSUME_TAC THENL [ASM_ARITH_TAC; ALL_TAC] THEN
     RULE_ASSUM_TAC(REWRITE_RULE
       [ASSUME `~(a = 0)`;
        ASSUME `~(a < el_length (h:(A,B)heap_element))`]) THEN
     FIRST_X_ASSUM(fun st ->
       if (try fst(dest_const(fst(strip_comb(rhs(concl st))))) =
                "," with Failure _ -> false)
       then MP_TAC st else fail()) THEN
     MP_TAC(ISPEC
       `heap_store (a - el_length (h:(A,B)heap_element))
          (y:((A,B)heap_element) list) t`
       PAIR_SURJECTIVE) THEN
     DISCH_THEN(X_CHOOSE_THEN `xs1:((A,B)heap_element) list`
       (X_CHOOSE_THEN `c1:bool` ASSUME_TAC)) THEN
     ASM_REWRITE_TAC[] THEN
     CONV_TAC(TOP_DEPTH_CONV let_CONV) THEN
     REWRITE_TAC[PAIR_EQ] THEN STRIP_TAC THEN VAR_EQ_TAC THEN
     RULE_ASSUM_TAC(REWRITE_RULE[ASSUME `c1:bool`]) THEN
     FIRST_X_ASSUM(fun sp ->
       if (try fst(dest_const(rator(rhs(concl sp)))) = "SOME"
           with Failure _ -> false)
       then MP_TAC sp else fail()) THEN
     EVERY_CASE_TAC THEN
     REWRITE_TAC[distinctness "option"; injectivity "option";
                 PAIR_EQ] THEN
     STRIP_TAC THEN stripconj THEN VAR_EQ_TAC THEN
     SUBGOAL_THEN `e - el_length (h:(A,B)heap_element) <=
                   a - el_length (h:(A,B)heap_element)`
       ASSUME_TAC THENL [ASM_ARITH_TAC; ALL_TAC] THEN
     FIRST_X_ASSUM(fun ih ->
       FIRST_ASSUM(fun a1 -> FIRST_ASSUM(fun a2 -> FIRST_ASSUM(fun a3 ->
         MP_TAC(MATCH_MP ih (CONJ a1 (CONJ a2 a3))) THEN
         DISCH_THEN(X_CHOOSE_TAC `h3:((A,B)heap_element) list`) THEN
         EXISTS_TAC `h3:((A,B)heap_element) list` THEN
         ASM_REWRITE_TAC[heap_split_def] THEN
         MATCH_REDUCE_TAC THEN REWRITE_TAC[]))))) in
   REPEAT GEN_TAC THEN MATCH_ACCEPT_TAC aux)
### heap_store_unused_alt_gen_state_ok
  (* and the same of the store at the low end: the references start
     where they started, and a is higher by the element, which no
     start of a generation is above *)
  (
   let transfer = prove
    (`!(hp:((A,B)heap_element)list) hp2 aa kk xx ss.
        heap_store aa ([xx] ++ heap_expand (kk - el_length xx)) hp =
          (hp2,T) /\
        ss <= aa /\ gen_start_ok hp (aa + kk) ss
        ==> gen_start_ok hp2 (aa + kk) ss`,
     REPEAT GEN_TAC THEN
     REWRITE_TAC[gen_start_ok_def] THEN
     DISCH_THEN(CONJUNCTS_THEN2 ASSUME_TAC (CONJUNCTS_THEN2 ASSUME_TAC
       (REPEAT_TCL CHOOSE_THEN
         (CONJUNCTS_THEN2 ASSUME_TAC ASSUME_TAC)))) THEN
     FIRST_ASSUM(fun hs -> FIRST_ASSUM(fun sp -> FIRST_ASSUM(fun le ->
       MP_TAC(MATCH_MP heap_split_heap_store
         (CONJ sp (CONJ hs le)))))) THEN
     DISCH_THEN(X_CHOOSE_THEN `h3:((A,B)heap_element)list`
       ASSUME_TAC) THEN
     ASM_EXISTS_TAC THEN ASM_REWRITE_TAC[]) in
   STRIP_TAC THEN CASES_ON_NAME "gens" THEN
   RULE_ASSUM_TAC(REWRITE_RULE[gen_state_ok_def]) THEN
   REWRITE_TAC[gen_state_ok_def] THEN
   USE_CHANGED [heap_store_unused_alt_def] THEN
   COND_CASES_TAC THEN REWRITE_TAC[PAIR_EQ] THEN
   FIRST [DISCH_THEN(fun th ->
            CONTR_TAC(REWRITE_RULE[] (CONJUNCT2 th)));
          DISCH_TAC] THEN
   FIRST_ASSUM(fun gs ->
     let c1 = CONJUNCT1 gs and c2 = CONJUNCT2 gs in
     CONJ_TAC THENL
      [MATCH_MP_TAC ALL_IMP THEN EXISTS_TAC (lhand (concl c1)) THEN
       CONJ_TAC THENL
        [GEN_TAC THEN REWRITE_TAC[] THEN STRIP_TAC THEN ASM_ARITH_TAC;
         ACCEPT_TAC c1];
       MATCH_MP_TAC ALL_IMP THEN
       EXISTS_TAC (lhand (concl c2)) THEN
       CONJ_TAC THENL
        [GEN_TAC THEN STRIP_TAC THEN MATCH_MP_TAC transfer THEN
         W(fun (asl,w) ->
           let hs = find (fun (_,th) ->
             (try fst(dest_const(fst(strip_comb(lhand(concl th))))) =
                  "heap_store"
              with Failure _ -> false)) asl in
           EXISTS_TAC (el 2 (snd(strip_comb
             (lhand (concl (snd hs))))))) THEN
         W(fun gl -> EXISTS_TAC (var_by_name "x" gl)) THEN
         ASM_REWRITE_TAC[] THEN
         FIRST_ASSUM(fun m ->
           ACCEPT_TAC(MATCH_MP (REWRITE_RULE[GSYM ALL_MEM] c1) m));
         ACCEPT_TAC c2]]))
### isDataElement_lemmas
  (REWRITE_TAC[isDataElement_def; BlockRep_def;
               Word64Rep_def; RefBlock_def;
               bytes_def; ThunkBlock_def;
               bignum_def] THEN
   PAIRARG_TAC THEN CONV_TAC(TOP_DEPTH_CONV let_CONV) THEN
   REPEAT CONJ_TAC THEN TRY COND_CASES_TAC THEN MESON_TAC[])
### list_to_BlockReps_heap_length
  (* the induction hypothesis has a hypothesis (the tail is not
     empty), so the step is a SIMP and not a REWRITE *)
  (LIST_INDUCT_TAC THEN REWRITE_TAC[NOT_CONS_NIL] THEN GEN_TAC THEN
   ONCE_REWRITE_TAC[list_to_BlockReps_def] THEN
   CASES_ON_NAME "t" THEN MATCH_REDUCE_TAC THEN
   ASM_SIMP_TAC[heap_length_NIL; heap_length_CONS;
                BlockRep_def; el_length_def;
                LENGTH; NOT_CONS_NIL] THEN
   ARITH_TAC)
### heap_lookup_heap_length
  (REWRITE_TAC[heap_lookup_APPEND; LT_REFL; SUB_REFL])
### list_to_BlockReps_heap_lookup_0
  (LIST_CASES_TAC ["xs"] THEN REWRITE_TAC[NOT_CONS_NIL] THEN
   ONCE_REWRITE_TAC[list_to_BlockReps_def] THEN
   LIST_CASES_TAC ["t"] THEN MATCH_REDUCE_TAC THEN
   REWRITE_TAC[heap_lookup_def; isSomeDataElement_def;
               BlockRep_def] THEN
   MESON_TAC[])
### list_to_BlockReps_isDataElement
  (LIST_INDUCT_TAC THEN REWRITE_TAC[NOT_CONS_NIL] THEN
   REPEAT GEN_TAC THEN
   ONCE_REWRITE_TAC[list_to_BlockReps_def] THEN
   CASES_ON_NAME "t" THEN MATCH_REDUCE_TAC THEN
   ASM_SIMP_TAC[ALL; isDataElement_lemmas; NOT_CONS_NIL])
### list_to_BlockReps_data_up_to_lem
  (REPEAT STRIP_TAC THEN ASM_REWRITE_TAC[data_up_to_APPEND] THEN
   MATCH_MP_TAC list_to_BlockReps_isDataElement THEN
   ASM_REWRITE_TAC[])
### list_to_BlockReps_ForwardPointer
  (* every element is a DataElement, and a DataElement is not a
     ForwardPointer *)
  (let fl = prove
    (`!l:((A,B)heap_element)list.
        ALL isDataElement l ==> FILTER isForwardPointer l = []`,
     LIST_INDUCT_TAC THEN
     REWRITE_TAC[ALL; FILTER; isDataElement_def] THEN
     REPEAT STRIP_TAC THEN
     ASM_REWRITE_TAC[isForwardPointer_def] THEN
     MATCH_REDUCE_TAC THEN ASM_SIMP_TAC[]) in
   DISCH_TAC THEN MATCH_MP_TAC fl THEN
   MATCH_MP_TAC list_to_BlockReps_isDataElement THEN
   ASM_REWRITE_TAC[])
### list_to_BlockReps_Ref
  (let not_ref = prove
    (`!tag ys. ~(isRef (BlockRep tag ys))`,
     REPEAT GEN_TAC THEN
     REWRITE_TAC[BlockRep_def;
                 isRef_def] THEN
     MATCH_REDUCE_TAC THEN
     REWRITE_TAC[isMutTag_def;
                 distinctness "data_to_word_memoryProof_tag"]) in
   LIST_INDUCT_TAC THEN REWRITE_TAC[NOT_CONS_NIL] THEN
   REPEAT GEN_TAC THEN
   ONCE_REWRITE_TAC[list_to_BlockReps_def] THEN
   CASES_ON_NAME "t" THEN MATCH_REDUCE_TAC THEN
   ASM_SIMP_TAC[ALL; not_ref; NOT_CONS_NIL])
### list_to_BlockReps_NULL
  (LIST_CASES_TAC ["xs"] THEN REWRITE_TAC[NOT_CONS_NIL] THEN
   ONCE_REWRITE_TAC[list_to_BlockReps_def] THEN
   LIST_CASES_TAC ["t"] THEN MATCH_REDUCE_TAC THEN
   REWRITE_TAC[NOT_CONS_NIL])
### list_to_BlockReps_MEM
  (ONCE_REWRITE_TAC[list_to_BlockReps_def] THEN
   LIST_CASES_TAC ["t"] THEN MATCH_REDUCE_TAC THEN
   REWRITE_TAC[MEM] THEN MESON_TAC[])
### list_to_v_get_refs
  (LIST_INDUCT_TAC THEN REPEAT GEN_TAC THENL
    [REWRITE_TAC[dataSem_list_to_v_def] THEN DISCH_TAC THEN
     EXISTS_TAC `t:dataSem_v` THEN ASM_REWRITE_TAC[];
     REWRITE_TAC[dataSem_list_to_v_def; get_refs_def;
                 MAP; FLAT; APPEND_NIL; MEM_APPEND; MEM] THEN
     STRIP_TAC THEN ASM_MESON_TAC[]])
### v_inv_lemma
  (* the heap grows by the hs that is taken out of its unused
     space, and that is a heap_store_rel: a data element of the old
     heap is in ha or in hb, the unused space holds none, and the
     two middle parts are of a length.  So v_inv_SUBMAP_lemma
     carries the invariant over, with the two maps unchanged *)
  (let hlen_cl = prove
    (`heap_length [] = 0 /\
      (!x xs. heap_length (CONS x xs) =
              el_length x + heap_length xs)`,
     REWRITE_TAC[heap_length_def; MAP; SUM_DEF; ITLIST]) in
   let hlen_exp = prove
    (`!n. heap_length (heap_expand n) = n`,
     GEN_TAC THEN REWRITE_TAC[heap_expand_def] THEN
     COND_CASES_TAC THEN
     ASM_REWRITE_TAC[hlen_cl; el_length_def] THEN
     ASM_ARITH_TAC) in
   (* the unused space holds no data element at all: its one
      element is an Unused, and past it the lookup is of [] *)
   let isde_rws = [isSomeDataElement_def;
                   distinctness "option"; injectivity "option";
                   distinctness "heap_element"] in
   let exp_none = prove
    (`!n m. ~(isSomeDataElement
                (heap_lookup m
                   (heap_expand n:((A,B)heap_element)list)))`,
     REPEAT GEN_TAC THEN REWRITE_TAC[heap_expand_def] THEN
     COND_CASES_TAC THEN
     REWRITE_TAC(heap_lookup_def :: el_length_def ::
                 isde_rws) THEN
     REPEAT COND_CASES_TAC THEN
     REWRITE_TAC(heap_lookup_def :: isde_rws)) in
   let expand_rel = prove
    (`!ha hs hb sp.
        0 < heap_length hs /\ heap_length hs <= sp
        ==> heap_store_rel (ha ++ heap_expand sp ++ hb)
              (ha ++ hs ++ heap_expand (sp - heap_length hs) ++ hb)`,
     REPEAT GEN_TAC THEN STRIP_TAC THEN
     REWRITE_TAC[heap_store_rel_def] THEN
     X_GEN_TAC `n:num` THEN
     REWRITE_TAC[GSYM APPEND_ASSOC] THEN
     REWRITE_TAC[data_to_word_memoryProof_heap_lookup_APPEND; hlen_exp;
                 heap_length_APPEND] THEN
     (* the three parts of the old heap, and of the new one: the
        splits are the same, because the lookup of a data element
        falls in ha or in hb either way *)
     COND_CASES_TAC THEN REWRITE_TAC[exp_none] THEN
     COND_CASES_TAC THEN REWRITE_TAC[exp_none] THEN
     COND_CASES_TAC THENL
      [SUBGOAL_THEN `F` CONTR_TAC THEN ASM_ARITH_TAC; ALL_TAC] THEN
     COND_CASES_TAC THENL
      [SUBGOAL_THEN `F` CONTR_TAC THEN ASM_ARITH_TAC; ALL_TAC] THEN
     DISCH_TAC THEN AP_THM_TAC THEN AP_TERM_TAC THEN
     ASM_ARITH_TAC) in
   REPEAT GEN_TAC THEN DISCH_TAC THEN STRIP_TAC THEN
   FIRST_ASSUM(fun vi ->
     MATCH_MP_TAC(MATCH_MP v_inv_SUBMAP_lemma vi)) THEN
   REWRITE_TAC[SUBMAP_REFL] THEN
   MATCH_MP_TAC expand_rel THEN ASM_REWRITE_TAC[])
### data_to_word_memoryProof_v_inv_lemma
  (REPEAT STRIP_TAC THEN ASM_MESON_TAC[v_inv_eq; v_inv_lemma])
### v_inv_LIST_REL
  (REWRITE_TAC[LIST_REL_EL_EQN] THEN REPEAT STRIP_TAC THEN
   ASM_REWRITE_TAC[] THEN
   MATCH_MP_TAC data_to_word_memoryProof_v_inv_lemma THEN
   ASM_SIMP_TAC[])
### bind_each_MONO
  (INDUCT_TAC THEN REPEAT GEN_TAC THEN STRIP_TAC THEN
   REWRITE_TAC[bind_each_def] THENL
    [ASM_MESON_TAC[LT_REFL];
     REWRITE_TAC[FDOM_FUPDATE; IN_INSERT; DE_MORGAN_THM] THEN
     CONJ_TAC THENL
      [ASM_ARITH_TAC;
       FIRST_X_ASSUM MATCH_MP_TAC THEN CONJ_TAC THENL
        [ASM_ARITH_TAC; ASM_REWRITE_TAC[]]]])
### bind_each_SUBMAP
  (* every binding of tf is below ts and bind_each adds none below
     it, so what it adds is on top of tf *)
  (INDUCT_TAC THEN REPEAT GEN_TAC THEN DISCH_TAC THEN
   REWRITE_TAC[bind_each_def] THENL
    [MATCH_ACCEPT_TAC SUBMAP_REFL;
     REWRITE_TAC[SUBMAP; FDOM_FUPDATE; IN_INSERT;
                 FAPPLY_FUPDATE_THM] THEN
     GEN_TAC THEN DISCH_TAC THEN
     SUBGOAL_THEN `~((x:num) = ts)` ASSUME_TAC THENL
      [FIRST_X_ASSUM(fun th -> MP_TAC(SPEC `x:num` th)) THEN
       ASM_REWRITE_TAC[] THEN ARITH_TAC;
       ALL_TAC] THEN
     ASM_REWRITE_TAC[] THEN
     FIRST_X_ASSUM(fun ih ->
       MP_TAC(SPECL [`tf:(num,num)fmap`; `ts + 1`; `k + i`; `i:num`]
                    ih)) THEN
     ANTS_TAC THENL
      [GEN_TAC THEN DISCH_TAC THEN
       FIRST_X_ASSUM(MP_TAC o SPEC `t:num`) THEN
       ASM_REWRITE_TAC[] THEN ARITH_TAC;
       REWRITE_TAC[SUBMAP] THEN
       DISCH_THEN(fun th -> MP_TAC(SPEC `x:num` th)) THEN
       ASM_REWRITE_TAC[]]])
### all_ts_cons
  (* the timestamps of a Block on the stack are its own timestamp
     and the ones of its payload, which the payload in front of the
     stack has; the set that the refs contribute is the same on
     both sides, so the proof is about the stack alone *)
  (let (vnil,vsing,vats,vcons) = v_all_vs_clauses () in
   let mems = [vats; MEM; MEM_FLAT; MEM_MAP] in
   let gen = prove
    (`!(s:dataSem_v->bool) ts tag xs stack.
        {t | ?x. (x IN s \/ MEM x (Block ts tag xs :: stack)) /\
                 MEM t (v_all_ts x)} =
        ts INSERT {t | ?x. (x IN s \/ MEM x (xs ++ stack)) /\
                           MEM t (v_all_ts x)}`,
     REPEAT GEN_TAC THEN
     REWRITE_TAC[EXTENSION; IN_INSERT; IN_ELIM_THM; MEM;
                 MEM_APPEND] THEN
     X_GEN_TAC `t:num` THEN EQ_TAC THENL
      [DISCH_THEN(X_CHOOSE_THEN `y:dataSem_v`
         (CONJUNCTS_THEN2 (REPEAT_TCL DISJ_CASES_THEN ASSUME_TAC)
                          ASSUME_TAC)) THENL
        [DISJ2_TAC THEN EXISTS_TAC `y:dataSem_v` THEN
         ASM_REWRITE_TAC[];
         FIRST_X_ASSUM SUBST_ALL_TAC THEN
         FIRST_X_ASSUM(MP_TAC o REWRITE_RULE mems) THEN
         DISCH_THEN(DISJ_CASES_THEN2
           (fun th -> DISJ1_TAC THEN ACCEPT_TAC th)
           (X_CHOOSE_THEN `u:num list`
             (CONJUNCTS_THEN2
                (X_CHOOSE_THEN `z:dataSem_v`
                   (CONJUNCTS_THEN2 ASSUME_TAC ASSUME_TAC))
                MP_TAC))) THEN
         ASM_REWRITE_TAC[] THEN DISCH_TAC THEN
         DISJ2_TAC THEN EXISTS_TAC `z:dataSem_v` THEN
         ASM_REWRITE_TAC[];
         DISJ2_TAC THEN EXISTS_TAC `y:dataSem_v` THEN
         ASM_REWRITE_TAC[]];
       DISCH_THEN(DISJ_CASES_THEN2 ASSUME_TAC
         (X_CHOOSE_THEN `y:dataSem_v`
           (CONJUNCTS_THEN2 (REPEAT_TCL DISJ_CASES_THEN ASSUME_TAC)
                            ASSUME_TAC))) THENL
        [EXISTS_TAC `Block ts tag xs` THEN
         ASM_REWRITE_TAC[vats; MEM];
         EXISTS_TAC `y:dataSem_v` THEN ASM_REWRITE_TAC[];
         EXISTS_TAC `Block ts tag xs` THEN
         REWRITE_TAC mems THEN DISJ2_TAC THEN
         EXISTS_TAC `v_all_ts (y:dataSem_v)` THEN
         CONJ_TAC THENL
          [EXISTS_TAC `y:dataSem_v` THEN ASM_REWRITE_TAC[];
           ASM_REWRITE_TAC[]];
         EXISTS_TAC `y:dataSem_v` THEN ASM_REWRITE_TAC[]]]) in
   REPEAT GEN_TAC THEN REWRITE_TAC[all_ts_def] THEN
   CONV_TAC(TOP_DEPTH_CONV let_CONV) THEN
   MATCH_ACCEPT_TAC gen)
### all_ts_cons_no_block
  (* a value that is not a Block has no timestamp in it, so the head
     of the stack adds nothing to the set *)
  (let keep = EXISTS_TAC `x:dataSem_v` THEN ASM_MESON_TAC[] in
   REPEAT STRIP_TAC THEN
   SUBGOAL_THEN `v_all_ts (v:dataSem_v) = []` ASSUME_TAC THENL
    [CASES_ON_NAME "v" THEN
     GEN_REWRITE_TAC LAND_CONV [v_all_ts_def] THEN
     MATCH_REDUCE_TAC THEN REWRITE_TAC[] THEN ASM_MESON_TAC[];
     ALL_TAC] THEN
   REWRITE_TAC[all_ts_def] THEN
   CONV_TAC(TOP_DEPTH_CONV let_CONV) THEN
   REWRITE_TAC[EXTENSION; IN_ELIM_THM; MEM] THEN
   X_GEN_TAC `t:num` THEN EQ_TAC THEN STRIP_TAC THENL
    [keep; ASM_MESON_TAC[MEM]; keep; keep; keep])
### all_ts_in_no_block
  (REPEAT STRIP_TAC THEN
   FIRST_X_ASSUM(fun th ->
     ASSUME_TAC(MATCH_MP all_ts_cons_no_block th)) THEN
   ASM_MESON_TAC[])
### all_ts_append
  (REPEAT GEN_TAC THEN REWRITE_TAC[all_ts_def] THEN
   CONV_TAC(TOP_DEPTH_CONV let_CONV) THEN
   REWRITE_TAC[EXTENSION; IN_UNION; IN_ELIM_THM; MEM_APPEND] THEN
   MESON_TAC[])
### all_ts_head
  (REPEAT GEN_TAC THEN REWRITE_TAC[GSYM all_ts_append; APPEND])
### v_all_vs_MEM
  (* the values of a list are the values of its head followed by
     the ones of its tail, and a Block among them is followed by
     the values of its payload: the induction of the type gives
     both halves at once, and what each case does to the two
     pieces of the append is what the three lemmas say *)
  (let (vnil,vsing,vats,vcons) = v_all_vs_clauses () in
   let ext0 = prove
    (`!b:dataSem_v list. ?p q. b = p ++ b ++ q`,
     GEN_TAC THEN EXISTS_TAC `[]:dataSem_v list` THEN
     EXISTS_TAC `[]:dataSem_v list` THEN
     REWRITE_TAC[APPEND; APPEND_NIL]) in
   let extc = prove
    (`!(h:dataSem_v) t b. (?p q. t = p ++ b ++ q)
                          ==> (?p q. CONS h t = p ++ b ++ q)`,
     REPEAT GEN_TAC THEN
     DISCH_THEN(X_CHOOSE_THEN `p:dataSem_v list`
       (X_CHOOSE_THEN `q:dataSem_v list` SUBST1_TAC)) THEN
     EXISTS_TAC `CONS (h:dataSem_v) p` THEN
     EXISTS_TAC `q:dataSem_v list` THEN REWRITE_TAC[APPEND]) in
   let extl = prove
    (`!(s:dataSem_v list) t b. (?p q. t = p ++ b ++ q)
                               ==> (?p q. s ++ t = p ++ b ++ q)`,
     REPEAT GEN_TAC THEN
     DISCH_THEN(X_CHOOSE_THEN `p:dataSem_v list`
       (X_CHOOSE_THEN `q:dataSem_v list` SUBST1_TAC)) THEN
     EXISTS_TAC `s ++ p:dataSem_v list` THEN
     EXISTS_TAC `q:dataSem_v list` THEN
     REWRITE_TAC[GSYM APPEND_ASSOC]) in
   let extr = prove
    (`!(s:dataSem_v list) t b. (?p q. t = p ++ b ++ q)
                               ==> (?p q. t ++ s = p ++ b ++ q)`,
     REPEAT GEN_TAC THEN
     DISCH_THEN(X_CHOOSE_THEN `p:dataSem_v list`
       (X_CHOOSE_THEN `q:dataSem_v list` SUBST1_TAC)) THEN
     EXISTS_TAC `p:dataSem_v list` THEN
     EXISTS_TAC `q ++ s:dataSem_v list` THEN
     REWRITE_TAC[APPEND_ASSOC]) in
   let triv = REPEAT GEN_TAC THEN
     REWRITE_TAC[vsing; MEM; distinctness "dataSem_v"] in
   SUBGOAL_THEN
     `(!x ts tag xs.
         MEM (Block ts tag xs) (v_all_vs [x])
         ==> (?p q. v_all_vs [x] =
                    p ++ (Block ts tag xs :: v_all_vs xs) ++ q)) /\
      (!l ts tag xs.
         MEM (Block ts tag xs) (v_all_vs l)
         ==> (?p q. v_all_vs l =
                    p ++ (Block ts tag xs :: v_all_vs xs) ++ q))`
     (fun th -> MATCH_ACCEPT_TAC(CONJUNCT2 th)) THEN
   MATCH_MP_TAC (dataSem_v_induct ()) THEN REPEAT CONJ_TAC THENL
    [triv; triv;
     REPEAT GEN_TAC THEN DISCH_TAC THEN REPEAT GEN_TAC THEN
     REWRITE_TAC[vsing; MEM; injectivity "dataSem_v"] THEN
     DISCH_THEN(DISJ_CASES_THEN2
       (fun eq -> STRIP_ASSUME_TAC eq THEN ASM_REWRITE_TAC[] THEN
                  MATCH_ACCEPT_TAC ext0)
       (fun m -> FIRST_ASSUM(fun ih ->
                   MATCH_ACCEPT_TAC(MATCH_MP extc (MATCH_MP ih m)))));
     triv; triv;
     REWRITE_TAC[vnil; MEM];
     REPEAT GEN_TAC THEN STRIP_TAC THEN REPEAT GEN_TAC THEN
     ONCE_REWRITE_TAC[vcons] THEN REWRITE_TAC[MEM_APPEND] THEN
     DISCH_THEN(DISJ_CASES_THEN2
       (fun m -> FIRST_ASSUM(fun ih ->
                   MATCH_ACCEPT_TAC(MATCH_MP extr (MATCH_MP ih m))))
       (fun m -> FIRST_ASSUM(fun ih ->
                   MATCH_ACCEPT_TAC(MATCH_MP extl
                     (MATCH_MP ih m)))))])
### v_in_all_vs
  (* a value of a value of what the refs and the stack hold is one
     of them as well: each of the four parts of all_vs is a list
     and the values of a list are transitively closed *)
  (REWRITE_TAC[all_vs_def; IN_UNION; IN_ELIM_THM] THEN
   REPEAT GEN_TAC THEN
   DISCH_THEN(CONJUNCTS_THEN2 STRIP_ASSUME_TAC ASSUME_TAC) THEN
   FIRST_ASSUM(fun mx -> FIRST_ASSUM(fun my ->
     ASSUME_TAC(MATCH_MP (snd (v_all_vs_trans_thm ()))
                         (CONJ mx my)))) THEN
   ASM_MESON_TAC[])
### v_all_vs_MEM2
  (* the values of v_all_vs (x::xs) are x itself, the values of its
     payload where it is a Block, and the values of v_all_vs xs: the
     first two are the values of v_all_vs [x] and the third is what
     the induction hypothesis is about *)
  (let vav = v_all_vs_def in
   let vnil = prove
    (`v_all_vs ([]:dataSem_v list) = []`,
     GEN_REWRITE_TAC LAND_CONV [vav] THEN MATCH_REDUCE_TAC THEN
     REWRITE_TAC[]) in
   let vsing = prove
    (`!t tag xs y. MEM y (v_all_vs [Block t tag xs]) <=>
        y = Block t tag xs \/ MEM y (v_all_vs xs)`,
     REPEAT GEN_TAC THEN
     GEN_REWRITE_TAC (LAND_CONV o RAND_CONV) [vav] THEN
     MATCH_REDUCE_TAC THEN
     REWRITE_TAC[vnil; APPEND_NIL; MEM; MEM_APPEND]) in
   LIST_INDUCT_TAC THENL
    [REWRITE_TAC[vnil; MEM];
     REPEAT GEN_TAC THEN CASES_ON_NAME "h" THEN
     GEN_REWRITE_TAC (LAND_CONV o RAND_CONV) [vav] THEN
     MATCH_REDUCE_TAC THEN
     REWRITE_TAC[MEM; MEM_APPEND; distinctness "dataSem_v"] THEN
     ASM_MESON_TAC[vsing]])
### v_all_vs_ts
  (* induction on the value and on a list of values at once, which
     is what define_datatype gives for a type that nests a list of
     itself: the timestamp of a Block among the values of a value is
     one of the timestamps of that value *)
  (let (vnil,vsing,vats,vcons) = v_all_vs_clauses () in
   let triv = REPEAT GEN_TAC THEN
     REWRITE_TAC[vsing; MEM; distinctness "dataSem_v"] in
   SUBGOAL_THEN
     `(!x ts tag xs.
         MEM (Block ts tag xs) (v_all_vs [x]) ==> MEM ts (v_all_ts x))
      /\
      (!l ts tag xs.
         MEM (Block ts tag xs) (v_all_vs l)
         ==> MEM ts (FLAT (MAP v_all_ts l)))`
     (fun th -> MATCH_ACCEPT_TAC(CONJUNCT1 th)) THEN
   MATCH_MP_TAC dataSem_v_INDUCT THEN REPEAT CONJ_TAC THENL
    [triv; triv;
     REPEAT GEN_TAC THEN DISCH_TAC THEN REPEAT GEN_TAC THEN
     REWRITE_TAC[vsing; vats; MEM; injectivity "dataSem_v"] THEN
     ASM_MESON_TAC[];
     triv; triv;
     REWRITE_TAC[vnil; MEM];
     REPEAT GEN_TAC THEN STRIP_TAC THEN REPEAT GEN_TAC THEN
     ONCE_REWRITE_TAC[vcons] THEN
     REWRITE_TAC[MEM_APPEND; MAP; FLAT] THEN
     ASM_MESON_TAC[]])
### MEM_v_all_vs
  (let vav = v_all_vs_def in
   LIST_INDUCT_TAC THEN REWRITE_TAC[MEM] THEN GEN_TAC THEN
   CASES_ON_NAME "h" THEN
   GEN_REWRITE_TAC (RAND_CONV o RAND_CONV) [vav] THEN
   MATCH_REDUCE_TAC THEN
   REWRITE_TAC[MEM_APPEND; MEM] THEN ASM_MESON_TAC[])
### MEM_stack_all_vs
  (REPEAT STRIP_TAC THEN
   REWRITE_TAC[all_vs_def; IN_UNION; IN_ELIM_THM] THEN
   REPEAT DISJ2_TAC THEN MATCH_MP_TAC MEM_v_all_vs THEN
   ASM_REWRITE_TAC[])
### v_all_vs_ts_MEM
  (* the induction that ml/lib/tactics.ml does for the proofs that
     need this before the file states it *)
  (let (c1,_) = v_all_vs_ts_thm () in
   REPEAT GEN_TAC THEN STRIP_TAC THEN
   FIRST_ASSUM(fun a2 -> FIRST_ASSUM(fun a1 ->
     MATCH_ACCEPT_TAC(MATCH_MP c1 (CONJ a1 a2)))))
### v_all_vs_trans
  (* the induction that ml/lib/tactics.ml does for the proofs that
     need this before the file states it *)
  (MATCH_ACCEPT_TAC (snd (v_all_vs_trans_thm ())))
### MEM_in_all_ts
  (* only a Block has a timestamp, and a Block among the values of
     what the refs and the stack hold is among the values of one of
     the values that a ref holds or of one on the stack, whose
     timestamps are therefore timestamps of the stack *)
  (let (c1,_) = v_all_vs_ts_thm () in
   let (vnil,vsing,vats,vcons) = v_all_vs_clauses () in
   let fr = prove
    (`(!l x. find_ref (bvlSem_ValueArray l) x <=> MEM x l) /\
      (!m v x. find_ref (Thunk m v) x <=> (v = x)) /\
      (!tg fin l c r x. find_ref (bvlSem_MutBlock tg fin l c r) x <=>
         MEM x (l ++ [c] ++ r))`,
     REPEAT CONJ_TAC THEN REPEAT GEN_TAC THEN
     GEN_REWRITE_TAC LAND_CONV [find_ref_def] THEN
     MATCH_REDUCE_TAC THEN REWRITE_TAC[]) in
   REPEAT GEN_TAC THEN STRIP_TAC THEN
   SUBGOAL_THEN `?t tag l. (x:dataSem_v) = Block t tag l`
     STRIP_ASSUME_TAC THENL
    [CASES_ON_NAME "x" THEN
     RULE_ASSUM_TAC(REWRITE_RULE[vats; MEM]) THEN
     TRY(FIRST_ASSUM CONTR_TAC) THEN MESON_TAC[];
     ALL_TAC] THEN
   FIRST_X_ASSUM SUBST_ALL_TAC THEN
   RULE_ASSUM_TAC(REWRITE_RULE[all_vs_def; IN_UNION;
                               IN_ELIM_THM]) THEN
   REWRITE_TAC[all_ts_def] THEN
   CONV_TAC(TOP_DEPTH_CONV let_CONV) THEN
   REWRITE_TAC[IN_ELIM_THM] THEN
   ASM_MESON_TAC[v_all_vs_MEM2; c1; fr; MEM_APPEND])
### MEM_in_all_vs
  (REWRITE_TAC[all_vs_def; IN_UNION; IN_ELIM_THM] THEN
   REPEAT STRIP_TAC THEN ASM_MESON_TAC[v_all_vs_trans])
### v_all_vs_ts_list
  (* the other half of that induction: the timestamps of a value
     among the values of a list are timestamps of the list *)
  (let (_,c2) = v_all_vs_ts_thm () in
   REPEAT GEN_TAC THEN STRIP_TAC THEN
   FIRST_ASSUM(fun a2 -> FIRST_ASSUM(fun a1 ->
     MATCH_ACCEPT_TAC(MATCH_MP c2 (CONJ a1 a2)))))
### v_inv_tf_update_thm_lemma
  (* the same complete induction as v_inv_SUBMAP_lemma, but only the
     map of the timestamps changes and by an update at a timestamp
     that is not in its domain: a Block of the invariant has its
     timestamp in that domain, so its lookup is the one it was *)
  (let (vr,_,_) = v_inv_ck in
   let rl = CONJUNCTS vr in
   let vdef = v_inv_def in
   let NOT_VAR_TAC =
     FIRST_ASSUM(fun nb ->
       if is_neg(concl nb) && is_var(rand(concl nb))
       then SUBST_ALL_TAC(EQF_INTRO nb) else fail()) in
   let FLU_TAC =
     ASM_REWRITE_TAC[FLOOKUP_UPDATE] THEN COND_CASES_TAC THEN
     ASM_REWRITE_TAC[] THEN
     FIRST_ASSUM(fun fl -> MP_TAC(MATCH_MP FLOOKUP_IN_FDOM fl)) THEN
     ASM_REWRITE_TAC[] in
   let lt1 = ARITH_RULE `~(ck = 0) ==> ck - 1 < ck` in
   let setup =
     MATCH_MP_TAC num_WF THEN X_GEN_TAC `ck:num` THEN DISCH_TAC THEN
     REPEAT GEN_TAC THEN STRIP_TAC THEN
     CASES_ON_NAME "v" THEN USE_CHANGED [vdef] in
   setup THENL
    [COND_CASES_TAC THEN STRIP_TAC THEN SUBST_LHS_TAC THENL
      [MATCH_MP_TAC(el 0 rl) THEN ASM_REWRITE_TAC[];
       MATCH_MP_TAC(el 1 rl) THEN ASM_REWRITE_TAC[]];
     STRIP_TAC THEN REPEAT SUBST_LHS_TAC THEN
     MATCH_MP_TAC(el 2 rl) THEN ASM_REWRITE_TAC[];
     COND_CASES_TAC THEN STRIP_TAC THEN REPEAT SUBST_LHS_TAC THENL
      [MATCH_MP_TAC(el 7 rl) THEN ASM_REWRITE_TAC[];
       MATCH_MP_TAC(el 8 rl) THEN REPEAT CONJ_TAC THENL
        [FIRST_ASSUM MATCH_ACCEPT_TAC;
         DISCH_TAC THEN
         FIRST_ASSUM(fun a2th ->
           if can (term_match [] `EVERY2 (p:A->B->bool) l m`)
                  (concl a2th)
           then MP_TAC a2th else fail()) THEN
         MATCH_MP_TAC MONO_ALL2 THEN BETA_TAC THEN
         REPEAT STRIP_TAC THEN CK_IH_TAC;
         FLU_TAC;
         FIRST_ASSUM MATCH_ACCEPT_TAC]];
     STRIP_TAC THEN REPEAT SUBST_LHS_TAC THEN
     MATCH_ACCEPT_TAC(el 3 rl);
     DISCH_THEN(DISJ_CASES_THEN2 STRIP_ASSUME_TAC
       (DISJ_CASES_THEN2 STRIP_ASSUME_TAC STRIP_ASSUME_TAC)) THENL
      [REPEAT SUBST_LHS_TAC THEN MATCH_MP_TAC(el 4 rl) THEN
       REPEAT CONJ_TAC THEN TRY(FIRST_ASSUM MATCH_ACCEPT_TAC) THEN
       ASM_REWRITE_TAC[];
       NOT_VAR_TAC THEN
       FIRST_ASSUM(fun ih ->
         ASM_MESON_TAC[el 5 rl; SPEC `ck - 1` ih; lt1]);
       NOT_VAR_TAC THEN
       FIRST_ASSUM(fun ih ->
         ASM_MESON_TAC[el 6 rl; SPEC `ck - 1` ih; lt1])]])
### v_inv_tf_update_thm
  (REPEAT STRIP_TAC THEN
   ASM_MESON_TAC[v_inv_eq; v_inv_tf_update_thm_lemma])
### v_inv_tf_update_thm_alt_lemma
  (* tf is what changes, and only a Block reads it: of the Block
     itself the timestamp of the update is not its own (the
     hypothesis says so), and of an element the induction
     hypothesis asks for the timestamps of the element, which are
     the Block's.  Of the value that a thunk of the refs holds they
     are the refs' (MEM_in_all_ts) *)
  (let rl = v_inv_ck_rules in
   let (vnil,vsing,vats,vcons) = v_all_vs_clauses () in
   let nlt = ARITH_RULE `!n. ~(n = 0) ==> n - 1 < n` in
   (* the value that a thunk of the refs holds is a value of the
      refs, so its timestamps are the refs' *)
   let in_av = prove
    (cake_as_vars (fun () ->
       `lookup n refs = SOME (Thunk ev v)
        ==> v IN all_vs refs stack`),
     DISCH_TAC THEN
     REWRITE_TAC[all_vs_def; IN_UNION; IN_ELIM_THM] THEN
     DISJ2_TAC THEN DISJ1_TAC THEN
     MAP_EVERY EXISTS_TAC
       [`n:num`; `ev:thunk_mode`; `v:dataSem_v`] THEN
     ASM_REWRITE_TAC[] THEN
     MATCH_MP_TAC MEM_v_all_vs THEN REWRITE_TAC[MEM]) in
   (* the assumption that says that the timestamp of the update is
      none of a value's *)
   let is_tsc c =
     is_neg c &&
     (try hd_is "set_of_list" (rand(rand c)) with Failure _ -> false) in
   (* the hypothesis of the lemma, conjunct by conjunct *)
   let prep =
     FIRST_ASSUM(fun c ->
       if is_conj (concl c) then MAP_EVERY ASSUME_TAC (CONJUNCTS c)
       else fail()) in
   (* the induction hypothesis at ck - 1, with the condition of the
      value it is applied to proved by the argument *)
   let ih_by tac =
     FIRST_ASSUM(fun nz ->
       let c = concl nz in
       if not(is_neg c) then fail() else
       let e = rand c in
       if not(is_eq e) || not(type_of(lhs e) = `:num`) ||
          not(rhs e = `0`) then fail() else
       let lt = MP (SPEC (lhs e) nlt) nz in
       FIRST_ASSUM(fun ihth ->
         let ih' = MP (SPEC (mk_binop `(-):num->num->num` (lhs e) `1`)
                         ihth) lt in
         MATCH_MP_TAC ih' THEN REPEAT CONJ_TAC THEN
         TRY(FIRST_ASSUM MATCH_ACCEPT_TAC) THEN tac)) in
   (* of an element of a Block its timestamps are the Block's *)
   let ih =
     ih_by
      (FIRST_ASSUM(fun tsc ->
         if not (is_tsc (concl tsc)) then fail() else
         MP_TAC(REWRITE_RULE[IN_SET_OF_LIST; vats; MEM; MEM_FLAT;
                             MEM_MAP] tsc)) THEN
       REWRITE_TAC[IN_SET_OF_LIST] THEN ASM_MESON_TAC[]) in
   (* and of the value of a thunk they are the refs' *)
   let ih_thunk =
     ih_by
      (REWRITE_TAC[IN_SET_OF_LIST] THEN DISCH_TAC THEN
       FIRST_ASSUM(fun m ->
         FIRST_ASSUM(fun lk ->
           MP_TAC(MATCH_MP MEM_in_all_ts
             (CONJ (MATCH_MP in_av lk) m)))) THEN
       ASM_REWRITE_TAC[]) in
   (* the timestamp of the update is no timestamp of the Block *)
   let tp =
     REWRITE_TAC[FLOOKUP_UPDATE] THEN COND_CASES_TAC THENL
      [FIRST_ASSUM(fun tsc ->
         if not (is_tsc (concl tsc)) then fail() else
         MP_TAC(REWRITE_RULE[IN_SET_OF_LIST; vats; MEM] tsc)) THEN
       ASM_REWRITE_TAC[];
       FIRST_ASSUM MATCH_ACCEPT_TAC] in
   let NOT_VAR_TAC =
     FIRST_ASSUM(fun nb ->
       if is_neg(concl nb) && is_var(rand(concl nb))
       then SUBST_ALL_TAC(EQF_INTRO nb) else fail()) in
   let wit n =
     W(fun (asl,w) ->
       let thunk = tryfind (fun (_,th) ->
         let t = concl th in
         if is_eq t && hd_is "bvlSem_Thunk" (rand(rhs t))
         then rand(rhs t) else fail()) asl in
       if n = 5 then
         let x = tryfind (fun (_,th) ->
           let t = concl th in
           if is_eq t && hd_is "ThunkBlock" (rand(rhs t))
           then rand(rand(rhs t)) else fail()) asl in
         MAP_EVERY EXISTS_TAC [lhand thunk; rand thunk; x]
       else EXISTS_TAC (rand thunk)) in
   let d_thunk n =
     NOT_VAR_TAC THEN REPEAT SUBST_LHS_TAC THEN
     MATCH_MP_TAC(el n rl) THEN wit n THEN REPEAT CONJ_TAC THEN
     FIRST [FIRST_ASSUM MATCH_ACCEPT_TAC;
            DISCH_TAC THEN ih_thunk] in
   V_INV_REFS_TAC_IH ih tp prep ALL_TAC V_INV_HEAP_PLAIN
     (d_thunk 5) (d_thunk 6))
### v_inv_tf_update_thm_alt
  (REPEAT STRIP_TAC THEN
   ASM_MESON_TAC[v_inv_eq; v_inv_tf_update_thm_alt_lemma])
### v_inv_tf_update_lemma
  (* a Block of the refs and the stack: its timestamps are among
     the stack's (MEM_in_all_ts), so the new one is none of them
     and v_inv_tf_update_thm_alt applies *)
  (let no_ts = prove
    (cake_as_vars (fun () ->
       `x IN all_vs refs stack /\ ~(ts' IN all_ts refs stack)
        ==> ~(ts' IN set_of_list (v_all_ts x))`),
     REWRITE_TAC[IN_SET_OF_LIST] THEN REPEAT STRIP_TAC THEN
     FIRST_ASSUM(fun m ->
       if not (hd_is "MEM" (concl m)) then fail() else
       FIRST_ASSUM(fun av ->
         if not (hd_is "all_vs" (rand(concl av))) then fail() else
         MP_TAC(MATCH_MP MEM_in_all_ts (CONJ av m)))) THEN
     ASM_REWRITE_TAC[]) in
   REPEAT GEN_TAC THEN DISCH_TAC THEN REPEAT GEN_TAC THEN
   (* the two equations of the antecedent are substituted, and the
      first of them in the two hypotheses that follow it *)
   DISCH_THEN(fun th ->
     let e1 = CONJUNCT1 th and r1 = CONJUNCT2 th in
     let e2 = CONJUNCT1 r1 in
     SUBST_ALL_TAC e1 THEN SUBST_ALL_TAC e2 THEN
     STRIP_ASSUME_TAC(REWRITE_RULE[e1] (CONJUNCT2 r1))) THEN
   FIRST_ASSUM(fun av ->
     if not (hd_is "all_vs" (rand(concl av))) then fail() else
     FIRST_ASSUM(fun nts ->
       if not (is_neg (concl nts)) then fail() else
       let ts = MATCH_MP no_ts (CONJ av nts) in
       FIRST_ASSUM(fun vi ->
         if not (hd_is "v_inv" (concl vi)) then fail() else
         MATCH_ACCEPT_TAC(SPEC_ALL(REWRITE_RULE[v_inv_eq]
           (MATCH_MP v_inv_tf_update_thm_alt
             (CONJ vi (CONJ nts ts)))))))))
### v_inv_tf_update
  (REPEAT STRIP_TAC THEN
   ASM_MESON_TAC[v_inv_eq; v_inv_tf_update_lemma])
### v_inv_tf_restrict_lemma
  (* the same of a tf whose domain is restricted: a Block keeps its
     timestamp, which the hypothesis says is in the set, and of an
     element the induction hypothesis asks for the timestamps of
     the element (the Block's) -- of the value of a thunk for the
     refs' (MEM_in_all_ts) *)
  (let rl = v_inv_ck_rules in
   let (vnil,vsing,vats,vcons) = v_all_vs_clauses () in
   let nlt = ARITH_RULE `!n. ~(n = 0) ==> n - 1 < n` in
   (* the value that a thunk of the refs holds is a value of the
      refs, so its timestamps are the refs' *)
   let in_av = prove
    (cake_as_vars (fun () ->
       `lookup n refs = SOME (Thunk ev v)
        ==> v IN all_vs refs stack`),
     DISCH_TAC THEN
     REWRITE_TAC[all_vs_def; IN_UNION; IN_ELIM_THM] THEN
     DISJ2_TAC THEN DISJ1_TAC THEN
     MAP_EVERY EXISTS_TAC
       [`n:num`; `ev:thunk_mode`; `v:dataSem_v`] THEN
     ASM_REWRITE_TAC[] THEN
     MATCH_MP_TAC MEM_v_all_vs THEN REWRITE_TAC[MEM]) in
   (* the two conditions of the lemma *)
   let prep = DISCH_THEN(CONJUNCTS_THEN2 ASSUME_TAC ASSUME_TAC) in
   (* the induction hypothesis at ck - 1, with the condition of the
      value it is applied to proved by the argument *)
   let ih_by tac =
     FIRST_ASSUM(fun nz ->
       let c = concl nz in
       if not(is_neg c) then fail() else
       let e = rand c in
       if not(is_eq e) || not(type_of(lhs e) = `:num`) ||
          not(rhs e = `0`) then fail() else
       let lt = MP (SPEC (lhs e) nlt) nz in
       FIRST_ASSUM(fun ihth ->
         let ih' = REWRITE_RULE[GSYM IMP_CONJ]
                     (MP (SPEC (mk_binop `(-):num->num->num`
                                  (lhs e) `1`) ihth) lt) in
         MATCH_MP_TAC ih' THEN REPEAT CONJ_TAC THEN
         TRY(FIRST_ASSUM MATCH_ACCEPT_TAC) THEN tac)) in
   (* the assumption about the timestamps of the value and the one
      about the timestamps of the refs *)
   let is_val a =
     let c = concl a in
     is_forall c &&
     (let b = snd(strip_forall c) in
      is_imp b &&
      (try hd_is "MEM" (lhand b) with Failure _ -> false)) in
   let is_refs a =
     let c = concl a in
     is_forall c &&
     (let b = snd(strip_forall c) in
      is_imp b &&
      (try hd_is "all_ts" (rand(lhand b)) with Failure _ -> false)) in
   (* the timestamps of an element of a Block are the Block's *)
   let ih =
     ih_by
      (GEN_TAC THEN DISCH_TAC THEN
       FIRST_ASSUM(fun a ->
         if not (is_val a) then fail() else MATCH_MP_TAC a) THEN
       REWRITE_TAC[vats; MEM; MEM_FLAT; MEM_MAP] THEN
       ASM_MESON_TAC[]) in
   (* and those of the value of a thunk are the refs' *)
   let ih_thunk =
     ih_by
      (GEN_TAC THEN DISCH_TAC THEN
       FIRST_ASSUM(fun b ->
         if not (is_refs b) then fail() else MATCH_MP_TAC b) THEN
       FIRST_ASSUM(fun m ->
         FIRST_ASSUM(fun lk ->
           MATCH_ACCEPT_TAC(MATCH_MP MEM_in_all_ts
             (CONJ (MATCH_MP in_av lk) m))))) in
   (* a Block keeps its timestamp, so the restriction keeps it *)
   let tp =
     REWRITE_TAC[FLOOKUP_DRESTRICT] THEN COND_CASES_TAC THENL
      [FIRST_ASSUM MATCH_ACCEPT_TAC;
       FIRST_ASSUM(fun nin ->
         if not (is_neg (concl nin)) then fail() else
         let t = lhand(rand(concl nin)) in
         if not (type_of t = `:num`) then fail() else
         FIRST_ASSUM(fun a ->
           if not (is_val a) then fail() else
           MP_TAC(SPEC t a))) THEN
       REWRITE_TAC[vats; MEM] THEN ASM_REWRITE_TAC[]] in
   let NOT_VAR_TAC =
     FIRST_ASSUM(fun nb ->
       if is_neg(concl nb) && is_var(rand(concl nb))
       then SUBST_ALL_TAC(EQF_INTRO nb) else fail()) in
   let wit n =
     W(fun (asl,w) ->
       let thunk = tryfind (fun (_,th) ->
         let t = concl th in
         if is_eq t && hd_is "bvlSem_Thunk" (rand(rhs t))
         then rand(rhs t) else fail()) asl in
       if n = 5 then
         let x = tryfind (fun (_,th) ->
           let t = concl th in
           if is_eq t && hd_is "ThunkBlock" (rand(rhs t))
           then rand(rand(rhs t)) else fail()) asl in
         MAP_EVERY EXISTS_TAC [lhand thunk; rand thunk; x]
       else EXISTS_TAC (rand thunk)) in
   let d_thunk n =
     NOT_VAR_TAC THEN REPEAT SUBST_LHS_TAC THEN
     MATCH_MP_TAC(el n rl) THEN wit n THEN REPEAT CONJ_TAC THEN
     FIRST [FIRST_ASSUM MATCH_ACCEPT_TAC;
            DISCH_TAC THEN ih_thunk] in
   V_INV_REFS_TAC_IH ih tp prep ALL_TAC V_INV_HEAP_PLAIN
     (d_thunk 5) (d_thunk 6))
### v_inv_tf_restrict
  (REPEAT STRIP_TAC THEN
   ASM_MESON_TAC[v_inv_eq; v_inv_tf_restrict_lemma])
### v_all_vs_append
  (let vav = v_all_vs_def in
   let vnil = prove
    (`v_all_vs ([]:dataSem_v list) = []`,
     GEN_REWRITE_TAC LAND_CONV [vav] THEN MATCH_REDUCE_TAC THEN
     REWRITE_TAC[]) in
   LIST_INDUCT_TAC THENL
    [REWRITE_TAC[APPEND; vnil];
     GEN_TAC THEN REWRITE_TAC[APPEND] THEN CASES_ON_NAME "h" THEN
     GEN_REWRITE_TAC LAND_CONV [vav] THEN MATCH_REDUCE_TAC THEN
     GEN_REWRITE_TAC (RAND_CONV o LAND_CONV) [vav] THEN
     MATCH_REDUCE_TAC THEN
     ASM_REWRITE_TAC[APPEND; GSYM APPEND_ASSOC]])
### MEM_v_all_vs_split
  (let cons_app = prove
    (`!(h:dataSem_v) t. CONS h t = APPEND [h] t`,
     REWRITE_TAC[APPEND]) in
   REPEAT GEN_TAC THEN
   GEN_REWRITE_TAC (LAND_CONV o RAND_CONV o RAND_CONV) [cons_app] THEN
   REWRITE_TAC[v_all_vs_append; MEM_APPEND])
### MEM_v_all_vs_split2
  (* v_all_vs of a cons splits into the values of the head and the
     values of the tail (v_all_vs_append, as the source has it), and
     the three parts of v :: y :: xs go where they belong *)
  (let cons_app = prove
    (`!(h:dataSem_v) t. CONS h t = APPEND [h] t`,
     REWRITE_TAC[APPEND]) in
   let vcons = prove
    (`!(v:dataSem_v) xs y. MEM y (v_all_vs (CONS v xs)) <=>
        MEM y (v_all_vs [v]) \/ MEM y (v_all_vs xs)`,
     REPEAT GEN_TAC THEN
     GEN_REWRITE_TAC (LAND_CONV o RAND_CONV o RAND_CONV)
       [cons_app] THEN
     REWRITE_TAC[v_all_vs_append; MEM_APPEND]) in
   MESON_TAC[vcons])
### MEM_v_all_vs_extend_tl
  (let cons_app = prove
    (`!(h:dataSem_v) t. CONS h t = APPEND [h] t`,
     REWRITE_TAC[APPEND]) in
   REPEAT GEN_TAC THEN
   GEN_REWRITE_TAC (RAND_CONV o RAND_CONV o RAND_CONV) [cons_app] THEN
   REWRITE_TAC[v_all_vs_append; MEM_APPEND] THEN CONV_TAC TAUT)
### MEM_v_all_vs_extend_hd
  (let cons_app = prove
    (`!(h:dataSem_v) t. CONS h t = APPEND [h] t`,
     REWRITE_TAC[APPEND]) in
   REPEAT GEN_TAC THEN
   GEN_REWRITE_TAC (RAND_CONV o RAND_CONV o RAND_CONV) [cons_app] THEN
   REWRITE_TAC[v_all_vs_append; MEM_APPEND] THEN CONV_TAC TAUT)
### MEM_v_all_vs_extend_append
  (REWRITE_TAC[v_all_vs_append; MEM_APPEND] THEN CONV_TAC TAUT)
### MEM_v_all_vs_EL
  (LIST_INDUCT_TAC THENL
    [REWRITE_TAC[LENGTH; LT];
     GEN_TAC THEN STRUCT_CASES_TAC (SPEC `i:num` num_CASES) THEN
     REWRITE_TAC[EL; HD; TL; LENGTH; LT_SUC; LT_0] THEN
     ASM_MESON_TAC[MEM_v_all_vs_extend_hd; MEM_v_all_vs_extend_tl]])
### MEM_v_all_vs_LUPDATE
  (* the LUPDATE puts v where the index says and leaves the rest,
     so a value of the result is one of v or one of the list *)
  (let vnil = prove
    (`v_all_vs ([]:dataSem_v list) = []`,
     GEN_REWRITE_TAC LAND_CONV [v_all_vs_def] THEN
     MATCH_REDUCE_TAC THEN REWRITE_TAC[]) in
   LIST_INDUCT_TAC THEN REWRITE_TAC[LUPDATE] THENL
    [REWRITE_TAC[vnil; MEM];
     REPEAT GEN_TAC THEN COND_CASES_TAC THEN
     DISCH_THEN(fun th -> MP_TAC(MATCH_MP MEM_v_all_vs_split th)) THEN
     STRIP_TAC THEN
     FIRST [DISJ1_TAC THEN FIRST_ASSUM ACCEPT_TAC;
            DISJ2_TAC THEN MATCH_MP_TAC MEM_v_all_vs_extend_hd THEN
            FIRST_ASSUM ACCEPT_TAC;
            DISJ2_TAC THEN MATCH_MP_TAC MEM_v_all_vs_extend_tl THEN
            FIRST_ASSUM ACCEPT_TAC;
            FIRST_ASSUM(fun ih -> MP_TAC(SPECL
              [`i - 1`; `v:dataSem_v`; `x:dataSem_v`] ih)) THEN
            ANTS_TAC THENL [FIRST_ASSUM ACCEPT_TAC; ALL_TAC] THEN
            MATCH_MP_TAC(TAUT `(b ==> c) ==> (a \/ b ==> a \/ c)`) THEN
            MATCH_ACCEPT_TAC MEM_v_all_vs_extend_hd]])
### all_vs_Block
  (let vav_block = prove
    (`!t tag xs ys.
        v_all_vs (CONS (Block t tag xs) ys) =
        APPEND (CONS (Block t tag xs) (v_all_vs xs)) (v_all_vs ys)`,
     REPEAT GEN_TAC THEN
     GEN_REWRITE_TAC LAND_CONV [v_all_vs_def] THEN
     MATCH_REDUCE_TAC THEN REWRITE_TAC[]) in
   REWRITE_TAC[all_vs_def; v_all_vs_append; vav_block] THEN
   REWRITE_TAC[EXTENSION; IN_INSERT; IN_UNION; IN_ELIM_THM;
               MEM_APPEND; MEM] THEN
   MESON_TAC[])
### blocks_unique_cons_thm
  (* the four cases of the two Blocks: both the new one (the goal is
     then an equation of the arguments), one of them the new one (the
     other has a timestamp below ts, so the two cannot be equal), or
     both in the set (which is what the hypothesis is about).  The
     instance of the hypothesis is written down, because its
     antecedent has to be discharged by the assumptions as they
     stand: rewriting with t = ts first would put the antecedent out
     of reach of them. *)
  (let inst a b c d =
     FIRST_ASSUM(fun h -> MP_TAC(SPECL [`t:num`; a; b; c; d] h)) THEN
     ANTS_TAC THENL
      [REPEAT CONJ_TAC THEN FIRST_ASSUM ACCEPT_TAC; ALL_TAC] in
   let a1 = `a1:num` and x1 = `xs1:dataSem_v list`
   and a2 = `a2:num` and x2 = `xs2:dataSem_v list` in
   REWRITE_TAC[blocks_unique_def; IN_INSERT;
               injectivity "dataSem_v"] THEN
   DISCH_TAC THEN REPEAT GEN_TAC THEN DISCH_THEN STRIP_ASSUME_TAC THEN
   FIRST
    [ASM_REWRITE_TAC[] THEN ARITH_TAC;
     inst a1 x1 a2 x2 THEN STRIP_TAC THEN ASM_REWRITE_TAC[] THEN
     ASM_ARITH_TAC;
     inst a2 x2 a2 x2 THEN STRIP_TAC THEN
     SUBGOAL_THEN `F` CONTR_TAC THEN ASM_ARITH_TAC;
     inst a1 x1 a1 x1 THEN STRIP_TAC THEN
     SUBGOAL_THEN `F` CONTR_TAC THEN ASM_ARITH_TAC])
### cons_thm_EMPTY
  (* the empty Block is a Data root, so the heap does not change at
     all: what the invariant asks of the new stack is what it asked
     of the old one, because blocks_unique says nothing of a Block
     whose payload is empty, the timestamps only grow, and the
     Block holds no reference *)
  (let hd_is n t =
     (try fst(dest_const(fst(strip_comb t))) = n
      with Failure _ -> false) in
   (* the witness that an assumption names *)
   let gv n =
     W(fun (asl,_) ->
       let tms = itlist (fun (_,th) acc ->
                   union (frees(concl th)) acc) asl [] in
       EXISTS_TAC (find (fun t -> fst(dest_var t) = n) tms)) in
   (* an empty Block holds no reference, so what the stack with it
      in front reaches is what the stack reaches *)
   let rr_nil = prove
    (`!stack refs n t tag.
        reachable_refs (Block t tag [] :: stack) refs n
        ==> reachable_refs stack refs n`,
     REWRITE_TAC[reachable_refs_def; MEM] THEN REPEAT GEN_TAC THEN
     DISCH_THEN(REPEAT_TCL CHOOSE_THEN STRIP_ASSUME_TAC) THENL
      [FIRST_X_ASSUM SUBST_ALL_TAC THEN
       FIRST_X_ASSUM(fun m ->
         CONTR_TAC(REWRITE_RULE[get_refs_def; MAP; FLAT; MEM] m));
       MAP_EVERY EXISTS_TAC [`x:dataSem_v`; `r:num`] THEN
       ASM_REWRITE_TAC[]]) in
   REWRITE_TAC[abs_ml_inv_def; bc_stack_ref_inv_def] THEN
   STRIP_TAC THEN ASM_REWRITE_TAC[] THEN CONJ_TAC THENL
    [(* the new root is a Data, so the pointers are the old ones *)
     USE_CHANGED [roots_ok_def] THEN
     REWRITE_TAC[roots_ok_def; MEM;
                 distinctness "heap_address"];
     ALL_TAC] THEN
   gv "f" THEN gv "tf" THEN ASM_REWRITE_TAC[] THEN
   REPEAT CONJ_TAC THENL
    [(* the timestamps of the stack grow by the Block's own *)
     FIRST_ASSUM(fun sub ->
       let t = rand(concl sub) in
       if hd_is "all_ts" t
       then MATCH_MP_TAC SUBSET_TRANS THEN EXISTS_TAC t THEN
            CONJ_TAC THENL [ACCEPT_TAC sub; ALL_TAC]
       else fail()) THEN
     REWRITE_TAC[all_ts_cons; APPEND; SUBSET; IN_INSERT] THEN
     GEN_TAC THEN DISCH_TAC THEN ASM_REWRITE_TAC[];
     (* blocks_unique says nothing of a Block whose payload is
        empty *)
     REWRITE_TAC[all_vs_Block; APPEND] THEN
     FIRST_ASSUM(fun bu ->
       if hd_is "blocks_unique" (concl bu) then MP_TAC bu
       else fail()) THEN
     REWRITE_TAC[blocks_unique_def; IN_INSERT;
                 injectivity "dataSem_v"] THEN
     DISCH_TAC THEN REPEAT GEN_TAC THEN
     DISCH_THEN STRIP_ASSUME_TAC THEN TRY CONTRA_TAC THEN
     FIRST_ASSUM MATCH_MP_TAC THEN ASM_REWRITE_TAC[];
     (* and its root is the BlockNil word of its tag *)
     REWRITE_TAC[ALL2; v_inv_def] THEN ASM_REWRITE_TAC[];
     (* a reference that the new stack reaches the old one reaches,
        because the Block holds none *)
     GEN_TAC THEN STRIP_TAC THEN FIRST_ASSUM MATCH_MP_TAC THEN
     CONJ_TAC THENL
      [FIRST_ASSUM(fun rr ->
         if not (hd_is "reachable_refs" (concl rr)) then fail() else
         MATCH_ACCEPT_TAC(MATCH_MP rr_nil rr));
       FIRST_ASSUM ACCEPT_TAC]])
### blocks_unique_Word64
  (* a Block of all_vs refs (Word64 w :: stack) is one of
     all_vs refs (ws ++ stack): the Word64 is no Block, and the rest
     of v_all_vs (Word64 w :: stack) is v_all_vs stack *)
  (let vw64 = prove
    (`!(w:word64) ys. v_all_vs (CONS (Word64 w) ys) =
        CONS (Word64 w) (v_all_vs ys)`,
     REPEAT GEN_TAC THEN
     GEN_REWRITE_TAC LAND_CONV [v_all_vs_def] THEN
     MATCH_REDUCE_TAC THEN REWRITE_TAC[]) in
   let inc = prove
    (`!refs ws stack' (w:word64) t a xs.
        Block t a xs IN all_vs refs (CONS (Word64 w) stack') ==>
        Block t a xs IN all_vs refs (APPEND ws stack')`,
     REWRITE_TAC[all_vs_def; IN_UNION; IN_ELIM_THM; vw64;
                 v_all_vs_append; MEM; MEM_APPEND;
                 distinctness "dataSem_v"] THEN MESON_TAC[]) in
   REWRITE_TAC[blocks_unique_def] THEN DISCH_TAC THEN
   REPEAT GEN_TAC THEN STRIP_TAC THEN FIRST_ASSUM MATCH_MP_TAC THEN
   REPEAT CONJ_TAC THEN ASM_MESON_TAC[inc])
### blocks_unique_Number
  (let vnum = prove
    (`!(i:int) ys. v_all_vs (CONS (Number i) ys) =
        CONS (Number i) (v_all_vs ys)`,
     REPEAT GEN_TAC THEN
     GEN_REWRITE_TAC LAND_CONV [v_all_vs_def] THEN
     MATCH_REDUCE_TAC THEN REWRITE_TAC[]) in
   let inc = prove
    (`!refs ws stack' (i:int) t a xs.
        Block t a xs IN all_vs refs (CONS (Number i) stack') ==>
        Block t a xs IN all_vs refs (APPEND ws stack')`,
     REWRITE_TAC[all_vs_def; IN_UNION; IN_ELIM_THM; vnum;
                 v_all_vs_append; MEM; MEM_APPEND;
                 distinctness "dataSem_v"] THEN MESON_TAC[]) in
   REWRITE_TAC[blocks_unique_def] THEN DISCH_TAC THEN
   REPEAT GEN_TAC THEN STRIP_TAC THEN FIRST_ASSUM MATCH_MP_TAC THEN
   REPEAT CONJ_TAC THEN ASM_MESON_TAC[inc])
### ref_edge_ValueArray
  (REWRITE_TAC[ref_edge_def; lookup_insert] THEN
   COND_CASES_TAC THEN REWRITE_TAC[] THEN MATCH_REDUCE_TAC THEN
   REWRITE_TAC[])
### ref_edge_Thunk
  (REWRITE_TAC[ref_edge_def; lookup_insert] THEN
   COND_CASES_TAC THEN REWRITE_TAC[] THEN MATCH_REDUCE_TAC THEN
   REWRITE_TAC[])
### reachable_refs_UPDATE
  (* induction along the reflexive transitive closure: an edge of
     the new references is one of the old ones, or it leaves ptr
     and lands in the array, whose values are roots of their own
     (they are the xs at the front of the stack) *)
  (let rtcpath = prove
    (`!r1 n.
        RTC (ref_edge (insert ptr (ValueArray xs) refs)) r1 n ==>
        RTC (ref_edge refs) r1 n \/
        (?s. MEM s (get_refs (Block 0 ARB xs)) /\
             RTC (ref_edge refs) s n)`,
     MATCH_MP_TAC RTC_INDUCT THEN CONJ_TAC THENL
      [GEN_TAC THEN DISJ1_TAC THEN
       MATCH_ACCEPT_TAC(CONJUNCT1(SPEC_ALL RTC_RULES));
       REPEAT GEN_TAC THEN REWRITE_TAC[ref_edge_ValueArray] THEN
       COND_CASES_TAC THEN STRIP_TAC THEN
       ASM_MESON_TAC[RTC_RULES]]) in
   let mem_block_refs = prove
    (`!(ys:(dataSem_v)list) ss tt aa.
        MEM ss (get_refs (Block tt aa ys))
        ==> ?yy. MEM yy ys /\ MEM ss (get_refs yy)`,
     REWRITE_TAC[get_refs_def; MEM_FLAT; MEM_MAP] THEN
     MESON_TAC[]) in
   REWRITE_TAC[reachable_refs_def] THEN
   DISCH_THEN(X_CHOOSE_THEN `x:dataSem_v`
     (X_CHOOSE_THEN `r:num` STRIP_ASSUME_TAC)) THEN
   FIRST_ASSUM(fun rtc -> MP_TAC(MATCH_MP rtcpath rtc)) THEN
   DISCH_THEN(DISJ_CASES_THEN2
     (fun old ->
        MAP_EVERY EXISTS_TAC [`x:dataSem_v`; `r:num`] THEN
        ASM_REWRITE_TAC[old])
     (X_CHOOSE_THEN `s:num` STRIP_ASSUME_TAC)) THEN
   FIRST_ASSUM(fun m -> MP_TAC(MATCH_MP mem_block_refs m)) THEN
   DISCH_THEN(X_CHOOSE_THEN `yy:dataSem_v` STRIP_ASSUME_TAC) THEN
   MAP_EVERY EXISTS_TAC [`yy:dataSem_v`; `s:num`] THEN
   ASM_REWRITE_TAC[MEM_APPEND])
### reachable_refs_Thunk_UPDATE
  (* the same, with the thunk's value for the array: the payload of
     the edge that leaves ptr is the one value v, which is the
     root at the front of the stack *)
  (let rtcpath = prove
    (`!r1 n.
        RTC (ref_edge (insert ptr (Thunk ev v) refs)) r1 n ==>
        RTC (ref_edge refs) r1 n \/
        (?s. MEM s (get_refs v) /\ RTC (ref_edge refs) s n)`,
     MATCH_MP_TAC RTC_INDUCT THEN CONJ_TAC THENL
      [GEN_TAC THEN DISJ1_TAC THEN
       MATCH_ACCEPT_TAC(CONJUNCT1(SPEC_ALL RTC_RULES));
       REPEAT GEN_TAC THEN REWRITE_TAC[ref_edge_Thunk] THEN
       REWRITE_TAC[get_refs_def; MAP; FLAT; APPEND_NIL] THEN
       COND_CASES_TAC THEN STRIP_TAC THEN
       ASM_MESON_TAC[RTC_RULES]]) in
   REWRITE_TAC[reachable_refs_def] THEN
   DISCH_THEN(X_CHOOSE_THEN `x:dataSem_v`
     (X_CHOOSE_THEN `r:num` STRIP_ASSUME_TAC)) THEN
   FIRST_ASSUM(fun rtc -> MP_TAC(MATCH_MP rtcpath rtc)) THEN
   DISCH_THEN(DISJ_CASES_THEN2
     (fun old ->
        MAP_EVERY EXISTS_TAC [`x:dataSem_v`; `r:num`] THEN
        ASM_REWRITE_TAC[old])
     (X_CHOOSE_THEN `s:num` STRIP_ASSUME_TAC)) THEN
   MAP_EVERY EXISTS_TAC [`v:dataSem_v`; `s:num`] THEN
   ASM_REWRITE_TAC[MEM])
### reachable_refs_UPDATE1
  (* the array that is written is not the stack's xs here, so a
     value of it that was not on the stack has to have sat in the
     old array at ptr -- and then the edge that leaves ptr is an
     edge of the old references too, with ptr itself as the root *)
  (let rtcpath = prove
    (`!r1 n.
        RTC (ref_edge (insert ptr (ValueArray xs1) refs)) r1 n ==>
        RTC (ref_edge refs) r1 n \/
        (?s. MEM s (get_refs (Block 0 ARB xs1)) /\
             RTC (ref_edge refs) s n)`,
     MATCH_MP_TAC RTC_INDUCT THEN CONJ_TAC THENL
      [GEN_TAC THEN DISJ1_TAC THEN
       MATCH_ACCEPT_TAC(CONJUNCT1(SPEC_ALL RTC_RULES));
       REPEAT GEN_TAC THEN REWRITE_TAC[ref_edge_ValueArray] THEN
       COND_CASES_TAC THEN STRIP_TAC THEN
       ASM_MESON_TAC[RTC_RULES]]) in
   let mem_block_refs = prove
    (`!(ys:(dataSem_v)list) ss tt aa.
        MEM ss (get_refs (Block tt aa ys))
        ==> ?yy. MEM yy ys /\ MEM ss (get_refs yy)`,
     REWRITE_TAC[get_refs_def; MEM_FLAT; MEM_MAP] THEN
     MESON_TAC[]) in
   let oldedge = prove
    (`!xs2 s. (lookup ptr refs = SOME (ValueArray xs2)) /\
              MEM s (get_refs (Block 0 ARB xs2))
              ==> ref_edge refs ptr s`,
     REWRITE_TAC[ref_edge_def] THEN REPEAT STRIP_TAC THEN
     ASM_REWRITE_TAC[] THEN MATCH_REDUCE_TAC THEN
     ASM_REWRITE_TAC[]) in
   REWRITE_TAC[reachable_refs_def] THEN
   DISCH_THEN(X_CHOOSE_THEN `x:dataSem_v`
     (X_CHOOSE_THEN `r:num` STRIP_ASSUME_TAC)) THEN
   DISCH_TAC THEN
   FIRST_ASSUM(fun rtc -> MP_TAC(MATCH_MP rtcpath rtc)) THEN
   DISCH_THEN(DISJ_CASES_THEN2
     (fun old ->
        MAP_EVERY EXISTS_TAC [`x:dataSem_v`; `r:num`] THEN
        ASM_REWRITE_TAC[old])
     (X_CHOOSE_THEN `s:num` STRIP_ASSUME_TAC)) THEN
   FIRST_ASSUM(fun m -> MP_TAC(MATCH_MP mem_block_refs m)) THEN
   DISCH_THEN(X_CHOOSE_THEN `yy:dataSem_v` STRIP_ASSUME_TAC) THEN
   ASM_CASES_TAC `MEM (yy:dataSem_v) xs` THENL
    [MAP_EVERY EXISTS_TAC [`yy:dataSem_v`; `s:num`] THEN
     ASM_REWRITE_TAC[MEM_APPEND];
     FIRST_X_ASSUM(fun side ->
       MP_TAC(MATCH_MP (MATCH_MP side (ASSUME `MEM (yy:dataSem_v)
         xs1`)) (ASSUME `~(MEM (yy:dataSem_v) xs)`))) THEN
     DISCH_THEN(X_CHOOSE_THEN `xs2:(dataSem_v)list`
       STRIP_ASSUME_TAC) THEN
     MAP_EVERY EXISTS_TAC
       [`RefPtr b ptr:dataSem_v`; `ptr:num`] THEN
     REWRITE_TAC[MEM_APPEND; MEM; get_refs_def] THEN
     MATCH_MP_TAC(CONJUNCT2(SPEC_ALL RTC_RULES)) THEN
     EXISTS_TAC `s:num` THEN ASM_REWRITE_TAC[] THEN
     MATCH_MP_TAC oldedge THEN EXISTS_TAC `xs2:(dataSem_v)list` THEN
     CONJ_TAC THENL
      [FIRST_ASSUM ACCEPT_TAC;
       REWRITE_TAC[get_refs_def; MEM_FLAT; MEM_MAP] THEN
       EXISTS_TAC `get_refs (yy:dataSem_v)` THEN CONJ_TAC THENL
        [EXISTS_TAC `yy:dataSem_v` THEN ASM_REWRITE_TAC[];
         FIRST_ASSUM ACCEPT_TAC]]])
### v_inv_ByteArray_insert_lemma
  (* the refs that the lemma puts a byte array into: v_inv reads
     the cell at ptr to see whether it is a thunk, to annotate a
     pointer to it and in the dest_thunk of a value, and a byte
     array is no thunk and no MutBlock, as what was there is not
     either *)
  (let opt = [distinctness "option"; injectivity "option"] in
   let rfs = [distinctness "bvlSem_ref";
              injectivity "bvlSem_ref";
              distinctness "dataSem_dest_thunk_ret"] in
   let same = prove
    (`(ptr IN domain refs ==>
       ?a b. lookup ptr refs = SOME (ByteArray a b)) ==>
      (!k ev v.
         lookup k (insert ptr (ByteArray fl xs) refs) =
           SOME (Thunk ev v) <=>
         lookup k refs = SOME (Thunk ev v)) /\
      (!k. ref_ptr_annot conf
             (lookup k (insert ptr (ByteArray fl xs) refs)) =
           ref_ptr_annot conf (lookup k refs)) /\
      (!v. dest_thunk v refs = NotThunk ==>
           dest_thunk v (insert ptr (ByteArray fl xs) refs) =
             NotThunk) /\
      (!k bb.
         (!t2 g2 m2 d2 s2.
            lookup k refs = SOME (bvlSem_MutBlock t2 g2 m2 d2 s2)
              ==> ~bb)
         ==> (!t2 g2 m2 d2 s2.
            lookup k (insert ptr (ByteArray fl xs) refs) =
              SOME (bvlSem_MutBlock t2 g2 m2 d2 s2) ==> ~bb))`,
     DISCH_TAC THEN
     (* the cell at ptr is a byte array, or the refs have no cell
        there: the two are what the rules of a RefPtr read *)
     (SUBGOAL_THEN
       `lookup ptr (refs:(dataSem_v bvlSem_ref) spt) = NONE \/
        ?a b. lookup ptr refs = SOME (ByteArray a b)`
       STRIP_ASSUME_TAC THENL
      [FIRST_ASSUM(fun h ->
         let d = lhand(concl h) in
         ASM_CASES_TAC d THENL
          [DISJ2_TAC THEN MATCH_ACCEPT_TAC(MP h (ASSUME d));
           DISJ1_TAC THEN
           MATCH_ACCEPT_TAC(MATCH_MP no_lk (ASSUME(mk_neg d)))]);
       ALL_TAC; ALL_TAC]) THEN
     (REPEAT CONJ_TAC THENL
      [REPEAT GEN_TAC THEN REWRITE_TAC[lookup_insert] THEN
       COND_CASES_TAC THEN ASM_REWRITE_TAC(opt @ rfs);
       GEN_TAC THEN REWRITE_TAC[lookup_insert] THEN
       COND_CASES_TAC THEN ASM_REWRITE_TAC[] THEN
       REWRITE_TAC[ref_ptr_annot_def] THEN MATCH_REDUCE_TAC THEN
       REWRITE_TAC[];
       GEN_TAC THEN CASES_ON_NAME "v" THEN
       ONCE_REWRITE_TAC[dataSem_dest_thunk_def] THEN
       SAFE_MATCH_REDUCE_TAC THEN REWRITE_TAC[] THEN
       REWRITE_TAC[lookup_insert] THEN
       ASM_CASES_TAC `a1:num = ptr` THEN ASM_REWRITE_TAC[] THEN
       TRY MATCH_REDUCE_TAC THEN REWRITE_TAC(opt @ rfs) THEN
       REPEAT COND_CASES_TAC THEN REWRITE_TAC[] THEN
       TRY(CONV_TAC TAUT);
       REPEAT GEN_TAC THEN DISCH_TAC THEN REPEAT GEN_TAC THEN
       REWRITE_TAC[lookup_insert] THEN COND_CASES_TAC THEN
       ASM_REWRITE_TAC(opt @ rfs) THEN
       TRY(FIRST_ASSUM MATCH_ACCEPT_TAC)])) in
   V_INV_REFS_TAC ALL_TAC ALL_TAC (V_INV_REFS_PLAIN same)
     (V_INV_REFS_THUNK same 5) (V_INV_REFS_THUNK same 6))
### v_inv_ByteArray_insert
  (REPEAT STRIP_TAC THEN
   ASM_MESON_TAC[v_inv_eq; v_inv_ByteArray_insert_lemma])
### heap_store_RefBlock_thm
  (* heap_store_lemma stores at the length of the prefix, and the
     condition it leaves is that the two RefBlocks are of a length *)
  (let hlen_cl = prove
    (`heap_length [] = 0 /\
      (!x xs. heap_length (CONS x xs) = el_length x + heap_length xs)`,
     REWRITE_TAC[heap_length_def; MAP; SUM_DEF; ITLIST]) in
   GEN_TAC THEN DISCH_TAC THEN
   REWRITE_TAC[heap_store_lemma; APPEND; PAIR_EQ; hlen_cl;
               RefBlock_def; el_length_def] THEN
   ASM_ARITH_TAC)
### heap_lookup_RefBlock_lemma
  (* the lookup in the append is the one in ha or the one in the
     RefBlock and what follows it, and a RefBlock is LENGTH y + 1
     long *)
  (REWRITE_TAC[data_to_word_memoryProof_heap_lookup_APPEND;
               heap_lookup_def; RefBlock_def;
               el_length_def] THEN
   REPEAT COND_CASES_TAC THEN
   ASM_REWRITE_TAC[injectivity "option"; distinctness "option"] THEN
   TRY(POP_ASSUM_LIST(fun ths ->
     MP_TAC(end_itlist CONJ (rev ths))) THEN ARITH_TAC) THEN
   TRY(MATCH_ACCEPT_TAC EQ_SYM_EQ) THEN
   REWRITE_TAC[])
### heap_store_RefBlock
  (* a store into a RefBlock: heap_lookup_SPLIT cuts the heap at
     the element, heap_store_RefBlock_thm does the store, and
     heap_lookup_RefBlock_lemma says where an address falls -- in
     the part before the element, at the element itself, or past
     it -- which is the same of both heaps, because the two
     RefBlocks are of a length.  So the two heaps have the same
     length, the same forward pointers and the same data elements
     but the one stored into, their lookups agree away from it,
     and a RefBlock_inv holds, because an element that is not a
     RefBlock is not the one that changed *)
  (let hd_is n t =
      (try fst(dest_const(fst(strip_comb t))) = n
       with Failure _ -> false) in
    (* the clauses of heap_length *)
    let hlen_cl = prove
     (`heap_length [] = 0 /\
       (!x xs. heap_length (CONS x xs) = el_length x + heap_length xs)`,
      REWRITE_TAC[heap_length_def; MAP; SUM_DEF; ITLIST]) in
    (* a RefBlock is one *)
    let isrb = prove
     (`!p. isRefBlock (RefBlock p)`,
      REWRITE_TAC[isRefBlock_def] THEN MESON_TAC[]) in
  DISCH_THEN(CONJUNCTS_THEN2 ASSUME_TAC ASSUME_TAC) THEN
    FIRST_ASSUM(fun hl ->
      MP_TAC(MATCH_MP heap_lookup_SPLIT hl)) THEN
    DISCH_THEN STRIP_ASSUME_TAC THEN
    FIRST_X_ASSUM(fun e ->
      if is_eq (concl e) && is_var (lhs (concl e)) &&
         hd_is "APPEND" (rhs (concl e))
      then SUBST_ALL_TAC e else fail()) THEN
    FIRST_X_ASSUM(fun e ->
      if is_eq (concl e) && is_var (lhs (concl e)) &&
         hd_is "heap_length" (rhs (concl e))
      then SUBST_ALL_TAC e else fail()) THEN
    W(fun (asl,w) ->
      let hs = find_term (hd_is "heap_store") (snd(strip_exists w)) in
      let args = snd(strip_comb hs) in
      let nb = lhand (el 1 args) in
      let hp = el 2 args in
      let ap = rator (rator hp) in
      let rest = rand hp in
      let cs = rator (rator rest) in
      EXISTS_TAC (mk_comb(mk_comb(ap,lhand hp),
                          mk_comb(mk_comb(cs,nb),rand rest)))) THEN
    CONJ_TAC THENL
     [MATCH_MP_TAC heap_store_RefBlock_thm THEN
      FIRST_ASSUM(ACCEPT_TAC o SYM);
      ALL_TAC] THEN
    CONJ_TAC THENL
     [REWRITE_TAC[RefBlock_inv_def;
                  heap_lookup_RefBlock_lemma] THEN
      ASM_REWRITE_TAC[] THEN CONJ_TAC THEN REPEAT GEN_TAC THEN
      REPEAT COND_CASES_TAC THEN REWRITE_TAC[] THEN
      STRIP_TAC THEN TRY(FIRST_ASSUM ACCEPT_TAC) THEN
      REPEAT(FIRST_X_ASSUM(fun e ->
        if is_eq (concl e) && is_var (lhs (concl e)) &&
           hd_is "RefBlock" (rhs (concl e))
        then SUBST_ALL_TAC e else fail())) THEN
      RULE_ASSUM_TAC(REWRITE_RULE[isrb]) THEN
      FIRST_X_ASSUM CONTR_TAC;
      ALL_TAC] THEN
    CONJ_TAC THENL
     [REWRITE_TAC[heap_lookup_RefBlock_lemma; LT_REFL];
      ALL_TAC] THEN
    CONJ_TAC THENL
     [REWRITE_TAC[heap_length_APPEND; hlen_cl;
                  RefBlock_def; el_length_def] THEN
      ASM_REWRITE_TAC[];
      ALL_TAC] THEN
    CONJ_TAC THENL
     [REWRITE_TAC[FILTER_APPEND; FILTER; isForwardPointer_def;
                  RefBlock_def] THEN
      MATCH_REDUCE_TAC THEN REWRITE_TAC[];
      ALL_TAC] THEN
    CONJ_TAC THENL
     [REWRITE_TAC[MEM_APPEND; MEM] THEN MESON_TAC[];
      ALL_TAC] THEN
    CONJ_TAC THENL
     [GEN_TAC THEN
      REWRITE_TAC[isSomeDataElement_def] THEN
      REWRITE_TAC[heap_lookup_RefBlock_lemma] THEN
      ASM_REWRITE_TAC[] THEN
      REPEAT COND_CASES_TAC THEN
      REWRITE_TAC[RefBlock_def] THEN MESON_TAC[];
      ALL_TAC] THEN
    REPEAT GEN_TAC THEN
    REWRITE_TAC[heap_lookup_RefBlock_lemma] THEN
    ASM_REWRITE_TAC[] THEN
    REPEAT COND_CASES_TAC THEN ASM_REWRITE_TAC[] THEN
    ASM_MESON_TAC[])
### NOT_isRefBlock
  (* the tag of a RefBlock is RefTag, and the three shapes have
     another one; the conditional of Word64Rep is split after the
     first rewrite, so the injectivity is used again under it *)
  (let rws = [injectivity "heap_element"; PAIR_EQ;
              distinctness "data_to_word_memoryProof_tag"] in
   REWRITE_TAC[isRefBlock_def; RefBlock_def;
               bignum_def; cake_raw "Word64Rep"] THEN
   PAIRARG_TAC THEN CONV_TAC(TOP_DEPTH_CONV let_CONV) THEN
   REWRITE_TAC rws THEN
   REPEAT CONJ_TAC THEN TRY COND_CASES_TAC THEN
   REWRITE_TAC rws)
### v_inv_Ref_lemma
  (* the two heaps agree on every element that is no RefBlock, and
     the elements that the relation looks up are none of them: so
     one direction of the equation is the induction with that
     carried over, and the other is the hypothesis itself, which
     says the relation holds at the old heap for every clock *)
  ((* the two heaps agree on every element that is no RefBlock, and
      the elements that the relation looks up are none *)
   let hp =
     FIRST_ASSUM(fun rb ->
       let (f1,_) = CONJ_PAIR (REWRITE_RULE[RefBlock_inv_def] rb) in
       MATCH_MP_TAC f1 THEN CONJ_TAC THENL
        [FIRST_ASSUM MATCH_ACCEPT_TAC;
         REWRITE_TAC[isRefBlock_def; RefBlock_def; BlockRep_def;
                     bignum_def; Word64Rep_def; ThunkBlock_def] THEN
         CONV_TAC(TOP_DEPTH_CONV let_CONV) THEN
         TRY PAIRARG_TAC THEN
         CONV_TAC(TOP_DEPTH_CONV let_CONV) THEN
         TRY COND_CASES_TAC THEN
         REWRITE_TAC[injectivity "heap_element"; PAIR_EQ;
                     distinctness "data_to_word_memoryProof_tag"] THEN
         REWRITE_TAC[NOT_EXISTS_THM; DE_MORGAN_THM]]) in
   (* one direction of the equation: the relation at the new heap *)
   let dir = prove
    (`!ck w refs x f tf heap.
        v_inv conf w refs (x,f,tf,heap) /\ RefBlock_inv heap heap2
        ==> v_inv_ck ck conf w refs (x,f,tf,heap2)`,
     V_INV_REFS_TAC ALL_TAC hp V_INV_HEAP_PLAIN
       (V_INV_HEAP_THUNK hp 5) (V_INV_HEAP_THUNK hp 6)) in
   (* and the other one is the hypothesis itself, which says the
      relation holds at the old heap for every clock *)
   REPEAT GEN_TAC THEN
   DISCH_THEN(CONJUNCTS_THEN2 ASSUME_TAC ASSUME_TAC) THEN
   EQ_TAC THEN DISCH_THEN(K ALL_TAC) THENL
    [FIRST_ASSUM(fun vi -> FIRST_ASSUM(fun rb ->
       MATCH_ACCEPT_TAC(SPEC_ALL(MATCH_MP dir (CONJ vi rb)))));
     FIRST_ASSUM(fun vi ->
       MATCH_ACCEPT_TAC(SPEC_ALL(REWRITE_RULE[v_inv_eq] vi)))])
### v_inv_Ref
  (* v_inv_Ref_lemma says that the clocked relation does not see the
     difference between the two heaps, of a value that the relation
     holds of; the unclocked one is the clocked one at every clock,
     so each side gives the other.  The lemma's heap2 is a free
     variable, so the other direction is the lemma with the two
     heaps exchanged, and RefBlock_inv is symmetric *)
  (let lem = v_inv_Ref_lemma in
   let hp = find_term (fun t -> is_var t && fst(dest_var t) = "heap")
              (concl lem) in
   let hp2 = find_term
               (fun t -> is_var t && fst(dest_var t) = "heap2")
               (concl lem) in
   let swapped = INST [hp2,hp; hp,hp2] lem in
   let sym_rb = prove
    (`!h1 h2. RefBlock_inv h1 h2 ==> RefBlock_inv h2 h1`,
     REWRITE_TAC[RefBlock_inv_def] THEN MESON_TAC[]) in
   let step lemm rbt =
     ONCE_REWRITE_TAC[v_inv_eq] THEN
     FIRST_ASSUM(fun rb -> FIRST_ASSUM(fun vi ->
       let th = MATCH_MP lemm (CONJ vi (rbt rb)) in
       let ckv = find_term
                   (fun t -> is_var t && fst(dest_var t) = "ck")
                   (concl th) in
       MP_TAC(GEN ckv th))) THEN
     DISCH_THEN(fun th -> REWRITE_TAC[GSYM th]) THEN
     FIRST_ASSUM(fun vi -> ACCEPT_TAC(REWRITE_RULE[v_inv_eq] vi)) in
   DISCH_TAC THEN REPEAT GEN_TAC THEN EQ_TAC THEN DISCH_TAC THENL
    [step swapped (MATCH_MP sym_rb);
     step lem (fun th -> th)])
### v_inv_ValueArray_insert_lemma
  (* the same of an array of values, whose annotation is zero as
     well.  The hypothesis about the cell at ptr is the second
     conjunct of what the lemma assumes, and prep gives it by
     itself *)
  (let opt = [distinctness "option"; injectivity "option"] in
   let rfs = [distinctness "bvlSem_ref";
              injectivity "bvlSem_ref";
              distinctness "dataSem_dest_thunk_ret"] in
   let same = prove
    (`(ptr IN domain refs ==>
       ?as. lookup ptr refs = SOME (ValueArray as)) ==>
      (!k ev v.
         lookup k (insert ptr (ValueArray xs) refs) =
           SOME (Thunk ev v) <=>
         lookup k refs = SOME (Thunk ev v)) /\
      (!k. ref_ptr_annot conf
             (lookup k (insert ptr (ValueArray xs) refs)) =
           ref_ptr_annot conf (lookup k refs)) /\
      (!v. dest_thunk v refs = NotThunk ==>
           dest_thunk v (insert ptr (ValueArray xs) refs) =
             NotThunk) /\
      (!k bb.
         (!t2 g2 m2 d2 s2.
            lookup k refs = SOME (bvlSem_MutBlock t2 g2 m2 d2 s2)
              ==> ~bb)
         ==> (!t2 g2 m2 d2 s2.
            lookup k (insert ptr (ValueArray xs) refs) =
              SOME (bvlSem_MutBlock t2 g2 m2 d2 s2) ==> ~bb))`,
     DISCH_TAC THEN
     (* the cell at ptr is an array of values, or the refs have no
        cell there: the two are what the rules of a RefPtr read *)
     (SUBGOAL_THEN
       `lookup ptr (refs:(dataSem_v bvlSem_ref) spt) = NONE \/
        ?as. lookup ptr refs = SOME (ValueArray as)`
       STRIP_ASSUME_TAC THENL
      [FIRST_ASSUM(fun h ->
         let d = lhand(concl h) in
         ASM_CASES_TAC d THENL
          [DISJ2_TAC THEN MATCH_ACCEPT_TAC(MP h (ASSUME d));
           DISJ1_TAC THEN
           MATCH_ACCEPT_TAC(MATCH_MP no_lk (ASSUME(mk_neg d)))]);
       ALL_TAC; ALL_TAC]) THEN
     (REPEAT CONJ_TAC THENL
      [REPEAT GEN_TAC THEN REWRITE_TAC[lookup_insert] THEN
       COND_CASES_TAC THEN ASM_REWRITE_TAC(opt @ rfs);
       GEN_TAC THEN REWRITE_TAC[lookup_insert] THEN
       COND_CASES_TAC THEN ASM_REWRITE_TAC[] THEN
       REWRITE_TAC[ref_ptr_annot_def] THEN MATCH_REDUCE_TAC THEN
       REWRITE_TAC[];
       GEN_TAC THEN CASES_ON_NAME "v" THEN
       ONCE_REWRITE_TAC[dataSem_dest_thunk_def] THEN
       SAFE_MATCH_REDUCE_TAC THEN REWRITE_TAC[] THEN
       REWRITE_TAC[lookup_insert] THEN
       ASM_CASES_TAC `a1:num = ptr` THEN ASM_REWRITE_TAC[] THEN
       TRY MATCH_REDUCE_TAC THEN REWRITE_TAC(opt @ rfs) THEN
       REPEAT COND_CASES_TAC THEN REWRITE_TAC[] THEN
       TRY(CONV_TAC TAUT);
       REPEAT GEN_TAC THEN DISCH_TAC THEN REPEAT GEN_TAC THEN
       REWRITE_TAC[lookup_insert] THEN COND_CASES_TAC THEN
       ASM_REWRITE_TAC(opt @ rfs) THEN
       TRY(FIRST_ASSUM MATCH_ACCEPT_TAC)])) in
   let prep = FIRST_ASSUM(fun a -> ASSUME_TAC(CONJUNCT2 a)) in
   V_INV_REFS_TAC prep ALL_TAC (V_INV_REFS_PLAIN same)
     (V_INV_REFS_THUNK same 5) (V_INV_REFS_THUNK same 6))
### v_inv_ValueArray_insert
  (REPEAT STRIP_TAC THEN
   ASM_MESON_TAC[v_inv_eq; v_inv_ValueArray_insert_lemma;
                 v_inv_Ref])
### v_inv_MutBlock_insert_lemma
  (* here the cell is put at a key that the refs do not have, so a
     MutBlock appears where there was nothing: the annotation of a
     pointer and the condition of a plain reference are the old
     ones away from ptr, and a pointer of the relation is a key of
     f, which is a key of the refs *)
  (let opt = [distinctness "option"; injectivity "option"] in
   let rfs = [distinctness "bvlSem_ref";
              injectivity "bvlSem_ref";
              distinctness "dataSem_dest_thunk_ret"] in
   let same = prove
    (`lookup ptr refs = NONE ==>
      (!k ev v.
         lookup k (insert ptr (bvlSem_MutBlock tag fin l cv r)
           refs) = SOME (Thunk ev v) <=>
         lookup k refs = SOME (Thunk ev v)) /\
      (!k. ~(k = ptr) ==>
         ref_ptr_annot conf
           (lookup k (insert ptr (bvlSem_MutBlock tag fin l cv r)
             refs)) =
         ref_ptr_annot conf (lookup k refs)) /\
      (!v. dest_thunk v refs = NotThunk ==>
           dest_thunk v (insert ptr
             (bvlSem_MutBlock tag fin l cv r) refs) = NotThunk) /\
      (!k bb.
         ~(k = ptr) /\
         (!t2 g2 m2 d2 s2.
            lookup k refs = SOME (bvlSem_MutBlock t2 g2 m2 d2 s2)
              ==> ~bb)
         ==> (!t2 g2 m2 d2 s2.
            lookup k (insert ptr (bvlSem_MutBlock tag fin l cv r)
              refs) = SOME (bvlSem_MutBlock t2 g2 m2 d2 s2)
                ==> ~bb))`,
     DISCH_TAC THEN
     (REPEAT CONJ_TAC THENL
      [REPEAT GEN_TAC THEN REWRITE_TAC[lookup_insert] THEN
       COND_CASES_TAC THEN ASM_REWRITE_TAC(opt @ rfs);
       REPEAT STRIP_TAC THEN REWRITE_TAC[lookup_insert] THEN
       ASM_REWRITE_TAC[];
       GEN_TAC THEN CASES_ON_NAME "v" THEN
       ONCE_REWRITE_TAC[dataSem_dest_thunk_def] THEN
       SAFE_MATCH_REDUCE_TAC THEN REWRITE_TAC[] THEN
       REWRITE_TAC[lookup_insert] THEN
       ASM_CASES_TAC `a1:num = ptr` THEN ASM_REWRITE_TAC[] THEN
       TRY MATCH_REDUCE_TAC THEN REWRITE_TAC(opt @ rfs) THEN
       REPEAT COND_CASES_TAC THEN REWRITE_TAC[] THEN
       TRY(CONV_TAC TAUT);
       REPEAT GEN_TAC THEN STRIP_TAC THEN REPEAT GEN_TAC THEN
       REWRITE_TAC[lookup_insert] THEN ASM_REWRITE_TAC[] THEN
       TRY(FIRST_ASSUM MATCH_ACCEPT_TAC)])) in
   let prep =
     FIRST_ASSUM(fun ds ->
       ASSUME_TAC(MATCH_MP no_lk (CONJUNCT1 ds)) THEN
       ASSUME_TAC(REWRITE_RULE[SUBSET] (CONJUNCT2 ds))) in
   let d5 =
     REPEAT SUBST_LHS_TAC THEN
     FIRST_ASSUM(fun nolk ->
       let (t_eq,a_eq,_,m_imp) = v_inv_refs_parts same nolk in
       FIRST_ASSUM(fun sub -> FIRST_ASSUM(fun fd ->
         let np = MATCH_MP notptr (CONJ nolk (CONJ sub fd)) in
         REWRITE_TAC[GSYM (MATCH_MP a_eq np)] THEN
         MATCH_MP_TAC(el 4 v_inv_ck_rules) THEN
         REPEAT CONJ_TAC THENL
          [FIRST_ASSUM MATCH_ACCEPT_TAC;
           ASM_REWRITE_TAC[t_eq];
           MATCH_MP_TAC m_imp THEN CONJ_TAC THENL
            [ACCEPT_TAC np; FIRST_ASSUM MATCH_ACCEPT_TAC]]))) in
   V_INV_REFS_TAC prep ALL_TAC d5
     (V_INV_REFS_THUNK same 5) (V_INV_REFS_THUNK same 6))
### v_inv_MutBlock_insert
  (REPEAT STRIP_TAC THEN
   ASM_MESON_TAC[v_inv_eq; v_inv_MutBlock_insert_lemma])
### v_inv_MutBlock_fin_lemma
  (* the cell at ptr keeps its tag and its payload, so all four
     lookups of the new refs are the old ones: the annotation is
     the ptr_bits of the tag and the two lengths, which the flag
     does not enter, and a MutBlock is no thunk *)
  (let opt = [distinctness "option"; injectivity "option"] in
   let rfs = [distinctness "bvlSem_ref";
              injectivity "bvlSem_ref";
              distinctness "dataSem_dest_thunk_ret"] in
   let same = prove
    (`lookup ptr refs = SOME (bvlSem_MutBlock tag fin1 ll cv rr) ==>
      (!k ev v.
         lookup k (insert ptr (bvlSem_MutBlock tag fin2 ll cv rr)
           refs) = SOME (Thunk ev v) <=>
         lookup k refs = SOME (Thunk ev v)) /\
      (!k. ref_ptr_annot conf
             (lookup k (insert ptr
               (bvlSem_MutBlock tag fin2 ll cv rr) refs)) =
           ref_ptr_annot conf (lookup k refs)) /\
      (!v. dest_thunk v (insert ptr
             (bvlSem_MutBlock tag fin2 ll cv rr) refs) =
           dest_thunk v refs) /\
      (!k bb.
         (!t2 g2 m2 d2 s2.
            lookup k refs = SOME (bvlSem_MutBlock t2 g2 m2 d2 s2)
              ==> ~bb)
         ==> (!t2 g2 m2 d2 s2.
            lookup k (insert ptr (bvlSem_MutBlock tag fin2 ll cv rr)
              refs) = SOME (bvlSem_MutBlock t2 g2 m2 d2 s2)
                ==> ~bb))`,
     DISCH_TAC THEN
     (REPEAT CONJ_TAC THENL
      [REPEAT GEN_TAC THEN REWRITE_TAC[lookup_insert] THEN
       COND_CASES_TAC THEN ASM_REWRITE_TAC(opt @ rfs);
       GEN_TAC THEN REWRITE_TAC[lookup_insert] THEN
       COND_CASES_TAC THEN ASM_REWRITE_TAC[] THEN
       REWRITE_TAC[ref_ptr_annot_def] THEN MATCH_REDUCE_TAC THEN
       REWRITE_TAC[];
       GEN_TAC THEN CASES_ON_NAME "v" THEN
       ONCE_REWRITE_TAC[dataSem_dest_thunk_def] THEN
       SAFE_MATCH_REDUCE_TAC THEN REWRITE_TAC[] THEN
       REWRITE_TAC[lookup_insert] THEN
       ASM_CASES_TAC `a1:num = ptr` THEN ASM_REWRITE_TAC[] THEN
       TRY MATCH_REDUCE_TAC THEN REWRITE_TAC(opt @ rfs) THEN
       REPEAT COND_CASES_TAC THEN REWRITE_TAC[];
       REPEAT GEN_TAC THEN DISCH_TAC THEN REPEAT GEN_TAC THEN
       (REWRITE_TAC[lookup_insert] THEN COND_CASES_TAC THENL
         [FIRST_X_ASSUM SUBST_ALL_TAC THEN
          DISCH_THEN(K ALL_TAC) THEN
          FIRST_ASSUM(fun a -> FIRST_ASSUM(fun lk ->
            ACCEPT_TAC(MATCH_MP a lk)));
          FIRST_ASSUM MATCH_ACCEPT_TAC])])) in
   V_INV_REFS_TAC ALL_TAC ALL_TAC (V_INV_REFS_PLAIN same)
     (V_INV_REFS_THUNK same 5) (V_INV_REFS_THUNK same 6))
### v_inv_MutBlock_fin
  (REPEAT STRIP_TAC THEN
   ASM_MESON_TAC[v_inv_eq; v_inv_MutBlock_fin_lemma])
### all_ts_SUBSET_gen
  (REWRITE_TAC[all_ts_def] THEN
   CONV_TAC(TOP_DEPTH_CONV let_CONV) THEN
   REWRITE_TAC[SUBSET; IN_ELIM_THM] THEN MESON_TAC[])
### all_ts_SUBSET_ts
  (REWRITE_TAC[all_ts_def] THEN
   CONV_TAC(TOP_DEPTH_CONV let_CONV) THEN
   REWRITE_TAC[SUBSET; IN_ELIM_THM] THEN MESON_TAC[])
### all_ts_mutcons
  (* every value that the old refs and stack reach is reached by the
     new ones: one of the refs is not the fresh pointer, because the
     fresh one has no value in refs at all, and the three parts of
     the MutBlock are what find_ref gives of it *)
  (let fr = prove
    (`!tg fin l c r x.
        find_ref (bvlSem_MutBlock tg fin l c r) x <=>
        MEM x l \/ x = c \/ MEM x r`,
     REPEAT GEN_TAC THEN
     GEN_REWRITE_TAC LAND_CONV [find_ref_def] THEN
     MATCH_REDUCE_TAC THEN REWRITE_TAC[MEM_APPEND; MEM]) in
   let li = prove
    (`!k1 k2 v (t:(A)spt) y.
        (sptree_lookup k1 (sptree_insert k2 v t) = SOME y) <=>
        (k1 = k2 /\ v = y) \/
        (~(k1 = k2) /\ sptree_lookup k1 t = SOME y)`,
     REPEAT GEN_TAC THEN REWRITE_TAC[lookup_insert] THEN
     COND_CASES_TAC THEN
     ASM_REWRITE_TAC[injectivity "option"] THEN
     CONV_TAC TAUT) in
   DISCH_THEN(fun hyp ->
     MATCH_MP_TAC all_ts_SUBSET_gen THEN GEN_TAC THEN
     REWRITE_TAC[MEM_APPEND; MEM; li] THEN
     MESON_TAC[fr; REWRITE_RULE[GSYM lookup_NONE_domain] hyp;
               distinctness "option"]))
### blocks_unique_mutcons
  (* a Block of the new refs and stack is one of the old ones: the
     MutBlock at the fresh pointer holds the values that the old
     stack has in front of it, and the RefPtr is no Block *)
  (let vrefptr = prove
    (`!b p ys. v_all_vs (CONS (RefPtr b p) ys) =
        CONS (RefPtr b p) (v_all_vs ys)`,
     REPEAT GEN_TAC THEN
     GEN_REWRITE_TAC LAND_CONV [v_all_vs_def] THEN
     MATCH_REDUCE_TAC THEN REWRITE_TAC[]) in
   let li = prove
    (`!k1 k2 v (t:(A)spt) y.
        (sptree_lookup k1 (sptree_insert k2 v t) = SOME y) <=>
        (k1 = k2 /\ v = y) \/
        (~(k1 = k2) /\ sptree_lookup k1 t = SOME y)`,
     REPEAT GEN_TAC THEN REWRITE_TAC[lookup_insert] THEN
     COND_CASES_TAC THEN
     ASM_REWRITE_TAC[injectivity "option"] THEN CONV_TAC TAUT) in
   let inc = prove
    (`!refs ptr tag l c r stack' t a xs.
        Block t a xs IN
          all_vs (insert ptr (bvlSem_MutBlock tag F l c r) refs)
                 (CONS (RefPtr F ptr) stack') ==>
        Block t a xs IN
          all_vs refs (APPEND (APPEND l (APPEND [c] r)) stack')`,
     REWRITE_TAC[all_vs_def; IN_UNION; IN_ELIM_THM; vrefptr;
                 v_all_vs_append; MEM; MEM_APPEND; li;
                 distinctness "dataSem_v"; distinctness "bvlSem_ref";
                 injectivity "bvlSem_ref"] THEN MESON_TAC[]) in
   REWRITE_TAC[blocks_unique_def] THEN DISCH_TAC THEN
   REPEAT GEN_TAC THEN STRIP_TAC THEN FIRST_ASSUM MATCH_MP_TAC THEN
   REPEAT CONJ_TAC THEN ASM_MESON_TAC[inc])
### ref_edge_MutBlock
  (REWRITE_TAC[ref_edge_def; lookup_insert] THEN
   COND_CASES_TAC THEN REWRITE_TAC[] THEN MATCH_REDUCE_TAC THEN
   REWRITE_TAC[])
### reachable_refs_MutCons_lemma
  (* induction along the reflexive transitive closure: an edge of
     the new refs is one of the old ones, or it leaves ptr and
     lands in the payload of the MutBlock *)
  (MATCH_MP_TAC RTC_INDUCT THEN CONJ_TAC THENL
   [GEN_TAC THEN DISCH_TAC THEN DISJ1_TAC THEN
    MATCH_ACCEPT_TAC(CONJUNCT1(SPEC_ALL RTC_RULES));
    REPEAT GEN_TAC THEN
    REWRITE_TAC[ref_edge_MutBlock] THEN
    COND_CASES_TAC THEN STRIP_TAC THEN DISCH_TAC THEN
    ASM_MESON_TAC[RTC_RULES]])
### reachable_refs_MutCons
  (* reachable_refs_MutCons_lemma says of a path through the new
     references that it is one of the old ones or that it starts
     inside the payload of the MutBlock.  A root of the stack keeps
     its path; the only other root is the pointer to the MutBlock,
     whose path cannot start at all, because ptr is fresh and so has
     no edge; and a path from the payload has its root among the
     payload's values *)
  (
   let mem_block_refs = prove
    (`!(ys:(dataSem_v)list) ss tt aa.
        MEM ss (get_refs (Block tt aa ys))
        ==> ?yy. MEM yy ys /\ MEM ss (get_refs yy)`,
     REWRITE_TAC[get_refs_def; MEM_FLAT; MEM_MAP] THEN
     MESON_TAC[]) in
   let subst_vars =
     REPEAT(FIRST_X_ASSUM(fun th ->
       if is_eq(concl th) && is_var(lhand(concl th))
       then SUBST_ALL_TAC th else fail())) in
   let payload b =
     X_CHOOSE_THEN `ss:num` (CONJUNCTS_THEN2
       (fun m -> MP_TAC(MATCH_MP mem_block_refs m)) ASSUME_TAC) b THEN
     DISCH_THEN(X_CHOOSE_THEN `yy:dataSem_v` STRIP_ASSUME_TAC) THEN
     MAP_EVERY EXISTS_TAC [`yy:dataSem_v`; `ss:num`] THEN
     ASM_REWRITE_TAC[MEM_APPEND] in
   let noedge a =
     MP_TAC(ONCE_REWRITE_RULE[RTC_CASES] a) THEN
     FIRST_ASSUM(fun nd ->
       let th = REWRITE_RULE[GSYM lookup_NONE_domain] nd in
       if concl th = concl nd then fail()
       else REWRITE_TAC[ref_edge_def; th]) THEN
     MATCH_REDUCE_TAC THEN ASM_REWRITE_TAC[] in
   let stackcase a =
     ASSUME_TAC a THEN
     W(fun gl -> MAP_EVERY (fun n -> EXISTS_TAC (var_by_name n gl))
                   ["x"; "r'"]) THEN
     ASM_REWRITE_TAC[MEM_APPEND] in
   let uselemma =
     FIRST_ASSUM(fun rtc -> FIRST_ASSUM(fun ne ->
       MP_TAC(MATCH_MP (MATCH_MP
         reachable_refs_MutCons_lemma rtc) ne))) in
   REWRITE_TAC[reachable_refs_def; MEM] THEN STRIP_TAC THENL
    [subst_vars THEN
     RULE_ASSUM_TAC(REWRITE_RULE[get_refs_def; MEM]) THEN
     subst_vars THEN uselemma THEN
     DISCH_THEN(DISJ_CASES_THEN2 noedge payload);
     uselemma THEN DISCH_THEN(DISJ_CASES_THEN2 stackcase payload)])
### v_inv_MutCons_step
  (* the point is fresh in the references, so it is not in the
     domain of the map and the map is a SUBMAP of its update there;
     v_inv_MutBlock_insert adds the MutBlock to the references and
     v_inv_SUBMAP takes the relation to the bigger map and the
     bigger heap *)
  (
   let submap_fupd = prove
    (`!(g:(A,B)fmap) k v. ~(k IN FDOM g) ==> g SUBMAP (g |+ (k,v))`,
     REWRITE_TAC[SUBMAP; FDOM_FUPDATE; IN_INSERT;
                 FAPPLY_FUPDATE_THM] THEN MESON_TAC[]) in
   STRIP_TAC THEN
   SUBGOAL_THEN `~(ptr IN FDOM (f:(num,num)fmap))` ASSUME_TAC THENL
    [ASM_MESON_TAC[SUBSET]; ALL_TAC] THEN
   FIRST_ASSUM(fun nf -> ASSUME_TAC(MATCH_MP submap_fupd nf)) THEN
   FIRST_ASSUM(fun vi -> FIRST_ASSUM(fun nd -> FIRST_ASSUM(fun sub ->
     ASSUME_TAC(MATCH_MP v_inv_MutBlock_insert
       (CONJ vi (CONJ nd sub)))))) THEN
   MATCH_MP_TAC (GEN_ALL v_inv_SUBMAP) THEN
   W(fun gl -> MAP_EVERY (fun n -> EXISTS_TAC (var_by_name n gl))
                 ["f"; "tf"; "heap"]) THEN
   ASM_REWRITE_TAC[SUBMAP_REFL])
### take_el_drop
  (* DROP_EL_CONS puts the element and the DROP after it back
     together, and TAKE_DROP puts the two halves back together *)
  (REPEAT STRIP_TAC THEN REWRITE_TAC[APPEND] THEN
   FIRST_ASSUM(fun th ->
     MP_TAC(REWRITE_RULE[ADD1] (MATCH_MP DROP_EL_CONS th))) THEN
   DISCH_THEN(SUBST1_TAC o SYM) THEN REWRITE_TAC[TAKE_DROP])
### dest_thunk_insert_fresh
  (* only a RefPtr reads the refs, and at a pointer that the refs
     have no value for the old dest_thunk is BadRef, which the
     assumption says it is not; away from the pointer the lookup is
     the one it was *)
  (let dt_def = dataSem_dest_thunk_def in
   let dtr = [distinctness "dataSem_dest_thunk_ret";
              injectivity "dataSem_dest_thunk_ret"] in
   let opt_rws = [distinctness "option"; injectivity "option"] in
   STRIP_TAC THEN CASES_ON_NAME "v" THEN
   ONCE_REWRITE_TAC[dt_def] THEN
   RULE_ASSUM_TAC(ONCE_REWRITE_RULE[dt_def]) THEN
   SAFE_MATCH_REDUCE_TAC THEN REWRITE_TAC[] THEN
   RULE_ASSUM_TAC(REWRITE_RULE[GSYM lookup_NONE_domain]) THEN
   REWRITE_TAC[lookup_insert] THEN
   ASM_CASES_TAC `a1:num = ptr` THEN ASM_REWRITE_TAC[] THEN
   EVERY_CASE_TAC THEN ASM_REWRITE_TAC dtr THEN
   REPEAT COND_CASES_TAC THEN
   ASM_MESON_TAC (dtr @ opt_rws))
### mutcons_thm
  (* take_el_drop writes the values as the three parts of the
     MutBlock, which is what mutcons_thm_alt is about, and its
     statement with those three parts in is the goal *)
  (
   STRIP_TAC THEN
   FIRST_ASSUM(fun ix ->
     let eq = REWRITE_RULE[APPEND_ASSOC]
                (MATCH_MP take_el_drop ix) in
     W(fun (asl,w) ->
       let hd_is n t = (try fst(dest_const(fst(strip_comb t))) = n
                        with Failure _ -> false) in
       let alt = mutcons_thm_alt in
       let fv n = find_term
         (fun t -> is_var t && fst(dest_var t) = n) (concl alt) in
       let args = snd(strip_comb
         (find_term (hd_is "bvlSem_MutBlock") w)) in
       let alt = REWRITE_RULE[APPEND_ASSOC; eq]
         (INST [el 2 args, fv "l"; el 3 args, fv "c";
                el 4 args, fv "r"] alt) in
       (* the statement of the theorem and the statement of the goal
          invented type variables of their own, so the one is
          instantiated at the other: with the three parts in, the two
          conclusions are the same term but for those variables *)
       MP_TAC(INSTANTIATE (term_match [] (rand (concl alt)) w)
                alt))) THEN
   ASM_REWRITE_TAC[] THEN TRY(DISCH_THEN ACCEPT_TAC))
### heap_store_ThunkBlock_thm
  (* a ThunkBlock is one element long whatever it holds, so the
     store leaves the lengths to agree *)
  (let hlen_cl = prove
    (`heap_length [] = 0 /\
      (!x xs. heap_length (CONS x xs) = el_length x + heap_length xs)`,
     REWRITE_TAC[heap_length_def; MAP; SUM_DEF; ITLIST]) in
   GEN_TAC THEN
   REWRITE_TAC[heap_store_lemma; APPEND; PAIR_EQ; hlen_cl;
               ThunkBlock_def; el_length_def] THEN
   ARITH_TAC)
### heap_lookup_ThunkBlock_lemma
  (* and a ThunkBlock is two long *)
  (REWRITE_TAC[data_to_word_memoryProof_heap_lookup_APPEND;
               heap_lookup_def; ThunkBlock_def;
               el_length_def] THEN
   REPEAT COND_CASES_TAC THEN
   ASM_REWRITE_TAC[injectivity "option"; distinctness "option"] THEN
   TRY(POP_ASSUM_LIST(fun ths ->
     MP_TAC(end_itlist CONJ (rev ths))) THEN ARITH_TAC) THEN
   TRY(MATCH_ACCEPT_TAC EQ_SYM_EQ) THEN
   REWRITE_TAC[])
### heap_store_ThunkBlock
  (* a store into a ThunkBlock: as the store into a BlockRep,
     where the lengths need no hypothesis, because a ThunkBlock
     holds one value whatever its tag says *)
  (let hd_is n t =
      (try fst(dest_const(fst(strip_comb t))) = n
       with Failure _ -> false) in
    (* the clauses of heap_length *)
    let hlen_cl = prove
     (`heap_length [] = 0 /\
       (!x xs. heap_length (CONS x xs) = el_length x + heap_length xs)`,
      REWRITE_TAC[heap_length_def; MAP; SUM_DEF; ITLIST]) in
  DISCH_TAC THEN
    FIRST_ASSUM(fun hl ->
      MP_TAC(MATCH_MP heap_lookup_SPLIT hl)) THEN
    DISCH_THEN STRIP_ASSUME_TAC THEN
    FIRST_X_ASSUM(fun e ->
      if is_eq (concl e) && is_var (lhs (concl e)) &&
         hd_is "APPEND" (rhs (concl e))
      then SUBST_ALL_TAC e else fail()) THEN
    FIRST_X_ASSUM(fun e ->
      if is_eq (concl e) && is_var (lhs (concl e)) &&
         hd_is "heap_length" (rhs (concl e))
      then SUBST_ALL_TAC e else fail()) THEN
    W(fun (asl,w) ->
      let hs = find_term (hd_is "heap_store") (snd(strip_exists w)) in
      let args = snd(strip_comb hs) in
      let nb = lhand (el 1 args) in
      let hp = el 2 args in
      let ap = rator (rator hp) in
      let rest = rand hp in
      let cs = rator (rator rest) in
      EXISTS_TAC (mk_comb(mk_comb(ap,lhand hp),
                          mk_comb(mk_comb(cs,nb),rand rest)))) THEN
    CONJ_TAC THENL
     [MATCH_ACCEPT_TAC heap_store_ThunkBlock_thm;
      ALL_TAC] THEN
    CONJ_TAC THENL
     [REWRITE_TAC[heap_lookup_ThunkBlock_lemma; LT_REFL];
      ALL_TAC] THEN
    CONJ_TAC THENL
     [REWRITE_TAC[heap_length_APPEND; hlen_cl;
                  ThunkBlock_def; el_length_def] THEN
      ASM_REWRITE_TAC[];
      ALL_TAC] THEN
    CONJ_TAC THENL
     [REWRITE_TAC[FILTER_APPEND; FILTER; isForwardPointer_def;
                  ThunkBlock_def] THEN
      MATCH_REDUCE_TAC THEN REWRITE_TAC[];
      ALL_TAC] THEN
    CONJ_TAC THENL
     [REWRITE_TAC[MEM_APPEND; MEM] THEN MESON_TAC[];
      ALL_TAC] THEN
    CONJ_TAC THENL
     [GEN_TAC THEN
      REWRITE_TAC[isSomeDataElement_def] THEN
      REWRITE_TAC[heap_lookup_ThunkBlock_lemma] THEN
      ASM_REWRITE_TAC[] THEN
      REPEAT COND_CASES_TAC THEN
      REWRITE_TAC[ThunkBlock_def] THEN MESON_TAC[];
      ALL_TAC] THEN
    REPEAT GEN_TAC THEN
    REWRITE_TAC[heap_lookup_ThunkBlock_lemma] THEN
    ASM_REWRITE_TAC[] THEN
    REPEAT COND_CASES_TAC THEN ASM_REWRITE_TAC[] THEN
    ASM_MESON_TAC[])
### INJ_NEQ
  (REWRITE_TAC[INJ] THEN REPEAT STRIP_TAC THEN ASM_MESON_TAC[])
### heap_lookup_heap_split
  (* the element that a lookup finds is in the half of the split
     that its address falls in: heap_lookup_SPLIT cuts the heap at
     the element, and the split of that append is the one of the
     first part or the one that keeps the element *)
  (let stripconj =
     REPEAT(FIRST_X_ASSUM(fun th ->
       if is_conj (concl th) then STRIP_ASSUME_TAC th else fail())) in
   let aux = prove
    (`!(heap:((A,B)heap_element) list) a b h1 h2 x.
        heap_split a heap = SOME (h1,h2) /\
        heap_lookup b heap = SOME x
        ==> (if b < a then MEM x h1 else MEM x h2)`,
     REPEAT GEN_TAC THEN STRIP_TAC THEN
     FIRST_X_ASSUM(fun th ->
       if (try fst(dest_const(fst(strip_comb(lhs(concl th))))) =
                "heap_lookup"
           with Failure _ -> false)
       then MP_TAC(MATCH_MP heap_lookup_SPLIT th)
       else fail()) THEN
     DISCH_THEN(X_CHOOSE_THEN `ha:((A,B)heap_element) list`
       (X_CHOOSE_THEN `hb:((A,B)heap_element) list`
         STRIP_ASSUME_TAC)) THEN
     VAR_EQ_TAC THEN
     FIRST_X_ASSUM(fun th ->
       MP_TAC(ONCE_REWRITE_RULE
         [heap_split_APPEND_if] th)) THEN
     COND_CASES_TAC THEN
     REWRITE_TAC[heap_split_def] THEN
     ASM_CASES_TAC
       `a - heap_length (ha:((A,B)heap_element) list) = 0` THEN
     ASM_REWRITE_TAC[] THEN
     ASM_CASES_TAC
       `a - heap_length (ha:((A,B)heap_element) list) <
        el_length (x:(A,B)heap_element)` THEN
     ASM_REWRITE_TAC[distinctness "option"] THEN
     EVERY_CASE_TAC THEN
     REWRITE_TAC[distinctness "option"; injectivity "option";
                 PAIR_EQ] THEN
     STRIP_TAC THEN stripconj THEN VAR_EQ_TAC THEN
     ASM_REWRITE_TAC[MEM_APPEND; MEM] THEN
     TRY(CONV_TAC TAUT) THEN TRY ASM_ARITH_TAC) in
   REPEAT GEN_TAC THEN MATCH_ACCEPT_TAC aux)
### heap_store_heap_lookup
  (* the store leaves the elements before the address it writes at
     where they are, so the lookup below it gives the same *)
  (LIST_INDUCT_TAC THEN REPEAT GEN_TAC THENL
    [REWRITE_TAC[heap_store_def; PAIR_EQ];
     GEN_REWRITE_TAC (LAND_CONV o LAND_CONV o LAND_CONV)
       [heap_store_def] THEN
     COND_CASES_TAC THENL
      [ASM_REWRITE_TAC[ARITH_RULE `((n:num) < 0) <=> F`];
       ALL_TAC] THEN
     COND_CASES_TAC THENL
      [REWRITE_TAC[PAIR_EQ]; ALL_TAC] THEN
     PAIRARG_TAC THEN CONV_TAC(TOP_DEPTH_CONV let_CONV) THEN
     REWRITE_TAC[PAIR_EQ] THEN
     DISCH_THEN(CONJUNCTS_THEN2
       (CONJUNCTS_THEN2 (SUBST1_TAC o SYM)
          (fun th -> SUBST_ALL_TAC(EQT_INTRO th)))
       ASSUME_TAC) THEN
     ONCE_REWRITE_TAC[heap_lookup_def] THEN
     COND_CASES_TAC THEN ASM_REWRITE_TAC[] THEN
     COND_CASES_TAC THEN ASM_REWRITE_TAC[] THEN
     FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_EXISTS_TAC THEN
     ASM_REWRITE_TAC[] THEN ARITH_ASM_TAC])
### update_ref_gen_state_ok
  ((* the head constant of a term, by name, and the assumption
      that a test picks out *)
   let hd_is n t =
     (try fst(dest_const(fst(strip_comb t))) = n
      with Failure _ -> false) in
   let grab asl p =
     tryfind (fun (_,th) ->
       if (try p th with Failure _ -> false) then th else fail())
       asl in
   (* the generations are all below a and the pointers of the part
     below each of them stay where they were: the store is at b,
     which is at or above a, so the split at a generation's start
     gives the same first half (heap_split_heap_store) *)
  STRUCT_CASES_TAC(ISPEC `gens:gen_state`
    (cases_of `:gen_state`)) THEN
  REWRITE_TAC[gen_state_ok_def] THEN
  DISCH_THEN(REPEAT_TCL CONJUNCTS_THEN ASSUME_TAC) THEN
  ASM_REWRITE_TAC[] THEN
  FIRST_X_ASSUM(fun ev ->
    if hd_is "ALL" (concl ev) &&
       hd_is "gen_start_ok" (lhand (concl ev))
    then MP_TAC(REWRITE_RULE[GSYM ALL_MEM] ev) else fail()) THEN
  REWRITE_TAC[GSYM ALL_MEM] THEN
  DISCH_TAC THEN GEN_TAC THEN DISCH_TAC THEN
  FIRST_ASSUM(fun ev ->
    FIRST_ASSUM(fun mm -> MP_TAC(MATCH_MP ev mm))) THEN
  REWRITE_TAC[gen_start_ok_def] THEN
  DISCH_THEN(REPEAT_TCL CHOOSE_THEN STRIP_ASSUME_TAC) THEN
  W(fun (asl,w) ->
    let ev = grab asl (fun th -> hd_is "ALL" (concl th)) in
    let m  = grab asl (fun th -> hd_is "MEM" (concl th) &&
               rand (concl th) = rand (concl ev)) in
    let ab = grab asl (fun th -> hd_is "<=" (concl th)) in
    let sp = grab asl (fun th ->
               hd_is "heap_split" (lhand (concl th))) in
    let st = grab asl (fun th ->
               hd_is "heap_store" (lhand (concl th))) in
    let xa = BETA_RULE(MATCH_MP (REWRITE_RULE[GSYM ALL_MEM] ev) m) in
    let xb = MATCH_MP (MATCH_MP (ARITH_RULE
               `(x:num) <= a ==> a <= b ==> x <= b`) xa) ab in
    MP_TAC(MATCH_MP heap_split_heap_store
             (CONJ sp (CONJ st xb)))) THEN
  DISCH_THEN(REPEAT_TCL CHOOSE_THEN ASSUME_TAC) THEN
  ASM_MESON_TAC[])
### data_up_to_alt
  (let opt = [injectivity "option"; distinctness "option";
              PAIR_EQ] in
   REWRITE_TAC[data_up_to_def; heap_split_def] THEN
   CONJ_TAC THEN COND_CASES_TAC THEN
   ASM_REWRITE_TAC(ALL :: opt) THENL
    [CONV_TAC(REDEPTH_CONV UNWIND_CONV) THEN REWRITE_TAC[ALL];
     CONV_TAC(REDEPTH_CONV UNWIND_CONV) THEN REWRITE_TAC[ALL];
     COND_CASES_TAC THEN ASM_REWRITE_TAC(ALL :: opt) THEN
     EVERY_CASE_TAC THEN ASM_REWRITE_TAC(ALL :: opt) THEN
     CONV_TAC(REDEPTH_CONV UNWIND_CONV) THEN
     ASM_REWRITE_TAC(ALL :: opt) THEN
     COND_CASES_TAC THEN ASM_REWRITE_TAC[]])
### update_thunk_gen_state_ok
  ((* the head constant of a term, by name, and the assumption
      that a test picks out *)
   let hd_is n t =
     (try fst(dest_const(fst(strip_comb t))) = n
      with Failure _ -> false) in
   let grab asl p =
     tryfind (fun (_,th) ->
       if (try p th with Failure _ -> false) then th else fail())
       asl in
   (* the generations are all below a and the pointers of the part
     below each of them stay where they were: the store is at b,
     which is at or above a, so the split at a generation's start
     gives the same first half (heap_split_heap_store) *)
  STRUCT_CASES_TAC(ISPEC `gens:gen_state`
    (cases_of `:gen_state`)) THEN
  REWRITE_TAC[gen_state_ok_def] THEN
  DISCH_THEN(REPEAT_TCL CONJUNCTS_THEN ASSUME_TAC) THEN
  ASM_REWRITE_TAC[] THEN
  FIRST_X_ASSUM(fun ev ->
    if hd_is "ALL" (concl ev) &&
       hd_is "gen_start_ok" (lhand (concl ev))
    then MP_TAC(REWRITE_RULE[GSYM ALL_MEM] ev) else fail()) THEN
  REWRITE_TAC[GSYM ALL_MEM] THEN
  DISCH_TAC THEN GEN_TAC THEN DISCH_TAC THEN
  FIRST_ASSUM(fun ev ->
    FIRST_ASSUM(fun mm -> MP_TAC(MATCH_MP ev mm))) THEN
  REWRITE_TAC[gen_start_ok_def] THEN
  DISCH_THEN(REPEAT_TCL CHOOSE_THEN STRIP_ASSUME_TAC) THEN
  W(fun (asl,w) ->
    let ev = grab asl (fun th -> hd_is "ALL" (concl th)) in
    let m  = grab asl (fun th -> hd_is "MEM" (concl th) &&
               rand (concl th) = rand (concl ev)) in
    let ab = grab asl (fun th -> hd_is "<=" (concl th)) in
    let sp = grab asl (fun th ->
               hd_is "heap_split" (lhand (concl th))) in
    let st = grab asl (fun th ->
               hd_is "heap_store" (lhand (concl th))) in
    let xa = BETA_RULE(MATCH_MP (REWRITE_RULE[GSYM ALL_MEM] ev) m) in
    let xb = MATCH_MP (MATCH_MP (ARITH_RULE
               `(x:num) <= a ==> a <= b ==> x <= b`) xa) ab in
    MP_TAC(MATCH_MP heap_split_heap_store
             (CONJ sp (CONJ st xb)))) THEN
  DISCH_THEN(REPEAT_TCL CHOOSE_THEN ASSUME_TAC) THEN
  ASM_MESON_TAC[])
### data_up_to_heap_store
  (* the store of a data element keeps the elements below the
     address it writes at, and writes a data element where it
     writes, so the heap stays data up to the address it was *)
  (let hl1 = prove
    (`!y:(A,B)heap_element. heap_length [y] = el_length y`,
     REWRITE_TAC[heap_length_def; MAP; SUM_DEF; ITLIST] THEN
     ARITH_TAC) in
   let dac1 = prove
    (`!a (h:(A,B)heap_element) t.
        data_up_to a (CONS h t) /\ ~(a = 0)
        ==> ~(a < el_length h) /\ isDataElement h /\
            data_up_to (a - el_length h) t`,
     REPEAT GEN_TAC THEN ONCE_REWRITE_TAC[data_up_to_alt] THEN
     COND_CASES_TAC THENL [ASM_MESON_TAC[]; ALL_TAC] THEN
     COND_CASES_TAC THENL [REWRITE_TAC[]; ALL_TAC] THEN
     POP_ASSUM(STRIP_ASSUME_TAC o REWRITE_RULE[DE_MORGAN_THM]) THEN
     STRIP_TAC THEN ASM_REWRITE_TAC[]) in
   LIST_INDUCT_TAC THEN REPEAT GEN_TAC THENL
    [REWRITE_TAC[heap_store_def; PAIR_EQ];
     GEN_REWRITE_TAC
       (LAND_CONV o RAND_CONV o LAND_CONV o LAND_CONV)
       [heap_store_def] THEN
     COND_CASES_TAC THENL
      [REWRITE_TAC[PAIR_EQ; APPEND; hl1] THEN
       DISCH_THEN(CONJUNCTS_THEN2 ASSUME_TAC
         (CONJUNCTS_THEN2
            (CONJUNCTS_THEN2 (SUBST1_TAC o SYM) ASSUME_TAC)
            ASSUME_TAC)) THEN
       ONCE_REWRITE_TAC[data_up_to_alt] THEN
       COND_CASES_TAC THEN REWRITE_TAC[] THEN
       FIRST_ASSUM(fun du -> FIRST_ASSUM(fun ne ->
         MP_TAC(MATCH_MP dac1 (CONJ du ne)))) THEN
       ASM_REWRITE_TAC[] THEN STRIP_TAC THEN ASM_REWRITE_TAC[];
       ALL_TAC] THEN
     COND_CASES_TAC THENL
      [REWRITE_TAC[PAIR_EQ]; ALL_TAC] THEN
     PAIRARG_TAC THEN CONV_TAC(TOP_DEPTH_CONV let_CONV) THEN
     REWRITE_TAC[PAIR_EQ] THEN
     DISCH_THEN(CONJUNCTS_THEN2 ASSUME_TAC
       (CONJUNCTS_THEN2
          (CONJUNCTS_THEN2 (SUBST1_TAC o SYM)
             (fun th -> SUBST_ALL_TAC(EQT_INTRO th)))
          ASSUME_TAC)) THEN
     ONCE_REWRITE_TAC[data_up_to_alt] THEN
     COND_CASES_TAC THEN REWRITE_TAC[] THEN
     FIRST_ASSUM(fun du -> FIRST_ASSUM(fun ne ->
       MP_TAC(MATCH_MP dac1 (CONJ du ne)))) THEN
     STRIP_TAC THEN ASM_REWRITE_TAC[] THEN
     FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_MESON_TAC[]])
### blocks_unique_update_ref
  (* the ValueArray that the pointer is given holds the values that
     the stack has in front of it *)
  (let li = prove
    (`!k1 k2 v (t:(A)spt) y.
        (sptree_lookup k1 (sptree_insert k2 v t) = SOME y) <=>
        (k1 = k2 /\ v = y) \/
        (~(k1 = k2) /\ sptree_lookup k1 t = SOME y)`,
     REPEAT GEN_TAC THEN REWRITE_TAC[lookup_insert] THEN
     COND_CASES_TAC THEN
     ASM_REWRITE_TAC[injectivity "option"] THEN CONV_TAC TAUT) in
   let inc = prove
    (`!refs ptr xs b stack' t a q.
        Block t a q IN
          all_vs (insert ptr (ValueArray xs) refs)
                 (APPEND xs (CONS (RefPtr b ptr) stack')) ==>
        Block t a q IN
          all_vs refs (APPEND xs (CONS (RefPtr b ptr) stack'))`,
     REWRITE_TAC[all_vs_def; IN_UNION; IN_ELIM_THM;
                 v_all_vs_append; MEM_APPEND; li;
                 distinctness "bvlSem_ref";
                 injectivity "bvlSem_ref"] THEN MESON_TAC[]) in
   REWRITE_TAC[blocks_unique_def] THEN DISCH_TAC THEN
   REPEAT GEN_TAC THEN STRIP_TAC THEN FIRST_ASSUM MATCH_MP_TAC THEN
   REPEAT CONJ_TAC THEN ASM_MESON_TAC[inc])
### blocks_unique_update_ref1
  (* the values of the updated array are the old ones and the head
     of the list, which the stack already holds, so every value of
     the new store is one of the old store, and what was unique
     there stays unique *)
  (let lk_ins = prove
    (`!n p (y:(dataSem_v)bvlSem_ref) rfs z.
        lookup n (insert p y rfs) = SOME z <=>
        (n = p /\ y = z) \/ (~(n = p) /\ lookup n rfs = SOME z)`,
     REPEAT GEN_TAC THEN REWRITE_TAC[lookup_insert] THEN
     COND_CASES_TAC THEN
     ASM_REWRITE_TAC[injectivity "option"; distinctness "option"] THEN
     CONV_TAC TAUT) in
   let hd_cons = prove
    (`!(xs:dataSem_v list). 0 < LENGTH xs
        ==> ?t. xs = CONS (HD xs) t`,
     LIST_INDUCT_TAC THEN
     REWRITE_TAC[LENGTH; LT_REFL; HD; LT_0] THEN
     EXISTS_TAC `t:dataSem_v list` THEN REWRITE_TAC[]) in
   REWRITE_TAC[blocks_unique_def] THEN
   DISCH_THEN(CONJUNCTS_THEN2 ASSUME_TAC
     (CONJUNCTS_THEN2 ASSUME_TAC ASSUME_TAC)) THEN
   FIRST_ASSUM(fun th -> MP_TAC(MATCH_MP hd_cons th)) THEN
   DISCH_THEN(X_CHOOSE_TAC `tt:dataSem_v list`) THEN
   SUBGOAL_THEN
     `!v. MEM v (v_all_vs (LUPDATE (HD (xs:dataSem_v list)) i xs1))
          ==> MEM v (v_all_vs xs1) \/ MEM v (v_all_vs xs)`
     ASSUME_TAC THENL
    [GEN_TAC THEN DISCH_TAC THEN
     FIRST_ASSUM(fun th ->
       MP_TAC(MATCH_MP MEM_v_all_vs_LUPDATE th)) THEN
     DISCH_THEN(DISJ_CASES_THEN2
       (fun hd1 -> DISJ2_TAC THEN
         FIRST_ASSUM(fun xe ->
           if (try fst(dest_var(lhs(concl xe))) = "xs"
               with Failure _ -> false)
           then GEN_REWRITE_TAC (RAND_CONV o RAND_CONV) [xe]
           else fail()) THEN
         MATCH_MP_TAC MEM_v_all_vs_extend_tl THEN
         ACCEPT_TAC hd1)
       (fun t2 -> DISJ1_TAC THEN ACCEPT_TAC t2));
     ALL_TAC] THEN
   W(fun (asl,w) ->
     let hd_is n t =
       (try fst(dest_const(fst(strip_comb t))) = n
        with Failure _ -> false) in
     let allvs t = hd_is "all_vs" t &&
                   length (snd(strip_comb t)) = 2 in
     let newset = find_term allvs w in
     let oldset = find_term allvs
       (concl (find (fun th -> can (find_term allvs) (concl th))
                 (map snd asl))) in
     let vv = mk_var("v",hd(snd(dest_type(type_of newset)))) in
     let inn a s =
       mk_comb(mk_comb(inst [type_of a,`:A`]
         `(IN):A->(A->bool)->bool`, a), s) in
     SUBGOAL_THEN
       (mk_forall(vv, mk_imp(inn vv newset, inn vv oldset)))
       ASSUME_TAC) THENL
    [GEN_TAC THEN
     REWRITE_TAC[all_vs_def; IN_UNION; IN_ELIM_THM; lk_ins;
                 injectivity "bvlSem_ref"; distinctness "bvlSem_ref";
                 v_all_vs_append; MEM_APPEND] THEN
     STRIP_TAC THEN ASM_MESON_TAC[];
     ALL_TAC] THEN
   REPEAT GEN_TAC THEN STRIP_TAC THEN FIRST_ASSUM MATCH_MP_TAC THEN
   ASM_REWRITE_TAC[] THEN CONJ_TAC THEN FIRST_ASSUM MATCH_MP_TAC THEN
   FIRST_ASSUM ACCEPT_TAC)
### blocks_unique_update_thunk
  (* the value that the thunk is given is on the stack already *)
  (let li = prove
    (`!k1 k2 v (t:(A)spt) y.
        (sptree_lookup k1 (sptree_insert k2 v t) = SOME y) <=>
        (k1 = k2 /\ v = y) \/
        (~(k1 = k2) /\ sptree_lookup k1 t = SOME y)`,
     REPEAT GEN_TAC THEN REWRITE_TAC[lookup_insert] THEN
     COND_CASES_TAC THEN
     ASM_REWRITE_TAC[injectivity "option"] THEN CONV_TAC TAUT) in
   let vcons = prove
    (`!(v:dataSem_v) xs y. MEM y (v_all_vs (CONS v xs)) <=>
        MEM y (v_all_vs [v]) \/ MEM y (v_all_vs xs)`,
     REPEAT GEN_TAC THEN
     GEN_REWRITE_TAC (LAND_CONV o RAND_CONV o RAND_CONV)
       [prove(`!(h:dataSem_v) t. CONS h t = APPEND [h] t`,
              REWRITE_TAC[APPEND])] THEN
     REWRITE_TAC[v_all_vs_append; MEM_APPEND]) in
   let inc = prove
    (`!refs ptr ev h stack' t a q.
        Block t a q IN
          all_vs (insert ptr (Thunk ev h) refs)
                 (CONS h (CONS (RefPtr F ptr) stack')) ==>
        Block t a q IN
          all_vs refs (CONS h (CONS (RefPtr F ptr) stack'))`,
     REWRITE_TAC[all_vs_def; IN_UNION; IN_ELIM_THM; li;
                 distinctness "bvlSem_ref";
                 injectivity "bvlSem_ref"] THEN
     MESON_TAC[vcons]) in
   REWRITE_TAC[blocks_unique_def] THEN DISCH_TAC THEN
   REPEAT GEN_TAC THEN STRIP_TAC THEN FIRST_ASSUM MATCH_MP_TAC THEN
   REPEAT CONJ_TAC THEN ASM_MESON_TAC[inc])
### heap_store_BlockRep_thm
  (* as the store into a RefBlock above: heap_store_lemma stores at
     the length of the prefix and leaves the lengths to agree *)
  (let hlen_cl = prove
    (`heap_length [] = 0 /\
      (!x xs. heap_length (CONS x xs) = el_length x + heap_length xs)`,
     REWRITE_TAC[heap_length_def; MAP; SUM_DEF; ITLIST]) in
   GEN_TAC THEN DISCH_TAC THEN
   REWRITE_TAC[heap_store_lemma; APPEND; PAIR_EQ; hlen_cl;
               BlockRep_def; el_length_def] THEN
   ASM_ARITH_TAC)
### heap_lookup_BlockRep_lemma
  (* where an address falls in a heap that a BlockRep splits: below
     the first part, at the element itself, or past the element,
     whose el_length is one more than the length of its list *)
  (let pick = W(fun (asl,w) ->
     ASM_CASES_TAC (el 0 (snd(strip_comb (rhs w))))) in
   let contra = SUBGOAL_THEN `F` CONTR_TAC THEN ASM_ARITH_TAC in
   pick THENL
    [ASM_SIMP_TAC[gen_gc_LESS_IMP_heap_lookup];
     ASM_SIMP_TAC[NOT_LESS_IMP_heap_lookup] THEN
     REWRITE_TAC[heap_lookup_def; BlockRep_def;
                 el_length_def] THEN
     pick THENL
      [ASM_REWRITE_TAC[SUB_REFL] THEN
       REWRITE_TAC[injectivity "option"] THEN
       MATCH_ACCEPT_TAC EQ_SYM_EQ;
       ASM_REWRITE_TAC[] THEN pick THEN ASM_REWRITE_TAC[] THENL
        [COND_CASES_TAC THENL [contra; ALL_TAC] THEN
         COND_CASES_TAC THENL [contra; ALL_TAC] THEN
         REWRITE_TAC[];
         COND_CASES_TAC THENL [contra; ALL_TAC] THEN
         COND_CASES_TAC THENL
          [REWRITE_TAC[distinctness "option"]; contra]]]])
### heap_store_BlockRep
  (* a store into a BlockRep: as the store into a RefBlock above,
     with heap_store_BlockRep_thm and heap_lookup_BlockRep_lemma,
     and without the RefBlock_inv *)
  (let hd_is n t =
      (try fst(dest_const(fst(strip_comb t))) = n
       with Failure _ -> false) in
    (* the clauses of heap_length *)
    let hlen_cl = prove
     (`heap_length [] = 0 /\
       (!x xs. heap_length (CONS x xs) = el_length x + heap_length xs)`,
      REWRITE_TAC[heap_length_def; MAP; SUM_DEF; ITLIST]) in
  DISCH_THEN(CONJUNCTS_THEN2 ASSUME_TAC ASSUME_TAC) THEN
    FIRST_ASSUM(fun hl ->
      MP_TAC(MATCH_MP heap_lookup_SPLIT hl)) THEN
    DISCH_THEN STRIP_ASSUME_TAC THEN
    FIRST_X_ASSUM(fun e ->
      if is_eq (concl e) && is_var (lhs (concl e)) &&
         hd_is "APPEND" (rhs (concl e))
      then SUBST_ALL_TAC e else fail()) THEN
    FIRST_X_ASSUM(fun e ->
      if is_eq (concl e) && is_var (lhs (concl e)) &&
         hd_is "heap_length" (rhs (concl e))
      then SUBST_ALL_TAC e else fail()) THEN
    W(fun (asl,w) ->
      let hs = find_term (hd_is "heap_store") (snd(strip_exists w)) in
      let args = snd(strip_comb hs) in
      let nb = lhand (el 1 args) in
      let hp = el 2 args in
      let ap = rator (rator hp) in
      let rest = rand hp in
      let cs = rator (rator rest) in
      EXISTS_TAC (mk_comb(mk_comb(ap,lhand hp),
                          mk_comb(mk_comb(cs,nb),rand rest)))) THEN
    CONJ_TAC THENL
     [MATCH_MP_TAC heap_store_BlockRep_thm THEN
      FIRST_ASSUM(ACCEPT_TAC o SYM);
      ALL_TAC] THEN
    CONJ_TAC THENL
     [REWRITE_TAC[heap_lookup_BlockRep_lemma; LT_REFL];
      ALL_TAC] THEN
    CONJ_TAC THENL
     [REWRITE_TAC[heap_length_APPEND; hlen_cl;
                  BlockRep_def; el_length_def] THEN
      ASM_REWRITE_TAC[];
      ALL_TAC] THEN
    CONJ_TAC THENL
     [REWRITE_TAC[FILTER_APPEND; FILTER; isForwardPointer_def;
                  BlockRep_def] THEN
      MATCH_REDUCE_TAC THEN REWRITE_TAC[];
      ALL_TAC] THEN
    CONJ_TAC THENL
     [REWRITE_TAC[MEM_APPEND; MEM] THEN MESON_TAC[];
      ALL_TAC] THEN
    CONJ_TAC THENL
     [GEN_TAC THEN
      REWRITE_TAC[isSomeDataElement_def] THEN
      REWRITE_TAC[heap_lookup_BlockRep_lemma] THEN
      ASM_REWRITE_TAC[] THEN
      REPEAT COND_CASES_TAC THEN
      REWRITE_TAC[BlockRep_def] THEN MESON_TAC[];
      ALL_TAC] THEN
    REPEAT GEN_TAC THEN
    REWRITE_TAC[heap_lookup_BlockRep_lemma] THEN
    ASM_REWRITE_TAC[] THEN
    REPEAT COND_CASES_TAC THEN ASM_REWRITE_TAC[] THEN
    ASM_MESON_TAC[])
### v_inv_BlockRep_upd_lemma
  (* the refs do not change and the heap does: every lookup of the
     old heap that the relation makes is a lookup away from p, so
     the hypothesis about the two heaps carries it over.  Away from
     p because the element at p is a BlockRep: of a Block the
     pointer is one that tf gives, which the hypothesis about tf
     keeps off p, and of anything else the shape of the element
     settles it *)
  (let flk = prove
    (`!f x y. FLOOKUP f x = SOME y ==> x IN FDOM f /\ FAPPLY f x = y`,
     REWRITE_TAC[FLOOKUP_DEF] THEN REPEAT GEN_TAC THEN
     COND_CASES_TAC THEN
     REWRITE_TAC[distinctness "option"; injectivity "option"] THEN
     STRIP_TAC THEN ASM_REWRITE_TAC[]) in
   let notp =
     FIRST
      [FIRST_ASSUM(fun fl ->
         let fd = MATCH_MP flk fl in
         FIRST_ASSUM(fun tfc ->
           ACCEPT_TAC(REWRITE_RULE[CONJUNCT2 fd]
             (MATCH_MP tfc (CONJUNCT1 fd)))));
       DISCH_TAC THEN FIRST_X_ASSUM SUBST_ALL_TAC THEN
       FIRST_ASSUM(fun blk ->
         if not (hd_is "BlockRep" (rand(rhs(concl blk)))) then fail()
         else FIRST_ASSUM(fun l ->
           if concl l = concl blk then fail() else
           MP_TAC(TRANS (SYM l) blk))) THEN
       REWRITE_TAC[injectivity "option"; BlockRep_def; bignum_def;
                   Word64Rep_def; ThunkBlock_def] THEN
       TRY PAIRARG_TAC THEN
       CONV_TAC(TOP_DEPTH_CONV let_CONV) THEN
       TRY COND_CASES_TAC THEN
       REWRITE_TAC[injectivity "heap_element"; PAIR_EQ;
                   distinctness "data_to_word_memoryProof_tag"]] in
   (* a lookup of the old heap is one of the new heap, away from p *)
   let hp =
     FIRST_ASSUM(fun pres ->
       MATCH_MP_TAC pres THEN CONJ_TAC THENL
        [notp; FIRST_ASSUM MATCH_ACCEPT_TAC]) in
   (* the hypothesis about the heaps, conjunct by conjunct *)
   let prep =
     FIRST_ASSUM(fun ds ->
       if is_conj (concl ds) then MAP_EVERY ASSUME_TAC (CONJUNCTS ds)
       else fail()) in
   V_INV_REFS_TAC prep hp V_INV_HEAP_PLAIN
     (V_INV_HEAP_THUNK hp 5) (V_INV_HEAP_THUNK hp 6))
### v_inv_MutBlock_hole_lemma
  (* and the same where what sits in the hole changes as well: the
     annotation counts the two sides of the hole and not what is in
     it *)
  (let opt = [distinctness "option"; injectivity "option"] in
   let rfs = [distinctness "bvlSem_ref";
              injectivity "bvlSem_ref";
              distinctness "dataSem_dest_thunk_ret"] in
   let same = prove
    (`lookup ptr refs = SOME (bvlSem_MutBlock tag fin1 ll cv1 rr) ==>
      (!k ev v.
         lookup k (insert ptr (bvlSem_MutBlock tag fin2 ll cv2 rr)
           refs) = SOME (Thunk ev v) <=>
         lookup k refs = SOME (Thunk ev v)) /\
      (!k. ref_ptr_annot conf
             (lookup k (insert ptr
               (bvlSem_MutBlock tag fin2 ll cv2 rr) refs)) =
           ref_ptr_annot conf (lookup k refs)) /\
      (!v. dest_thunk v (insert ptr
             (bvlSem_MutBlock tag fin2 ll cv2 rr) refs) =
           dest_thunk v refs) /\
      (!k bb.
         (!t2 g2 m2 d2 s2.
            lookup k refs = SOME (bvlSem_MutBlock t2 g2 m2 d2 s2)
              ==> ~bb)
         ==> (!t2 g2 m2 d2 s2.
            lookup k (insert ptr (bvlSem_MutBlock tag fin2 ll cv2 rr)
              refs) = SOME (bvlSem_MutBlock t2 g2 m2 d2 s2)
                ==> ~bb))`,
     DISCH_TAC THEN
     (REPEAT CONJ_TAC THENL
      [REPEAT GEN_TAC THEN REWRITE_TAC[lookup_insert] THEN
       COND_CASES_TAC THEN ASM_REWRITE_TAC(opt @ rfs);
       GEN_TAC THEN REWRITE_TAC[lookup_insert] THEN
       COND_CASES_TAC THEN ASM_REWRITE_TAC[] THEN
       REWRITE_TAC[ref_ptr_annot_def] THEN MATCH_REDUCE_TAC THEN
       REWRITE_TAC[];
       GEN_TAC THEN CASES_ON_NAME "v" THEN
       ONCE_REWRITE_TAC[dataSem_dest_thunk_def] THEN
       SAFE_MATCH_REDUCE_TAC THEN REWRITE_TAC[] THEN
       REWRITE_TAC[lookup_insert] THEN
       ASM_CASES_TAC `a1:num = ptr` THEN ASM_REWRITE_TAC[] THEN
       TRY MATCH_REDUCE_TAC THEN REWRITE_TAC(opt @ rfs) THEN
       REPEAT COND_CASES_TAC THEN REWRITE_TAC[];
       REPEAT GEN_TAC THEN DISCH_TAC THEN REPEAT GEN_TAC THEN
       (REWRITE_TAC[lookup_insert] THEN COND_CASES_TAC THENL
         [FIRST_X_ASSUM SUBST_ALL_TAC THEN
          DISCH_THEN(K ALL_TAC) THEN
          FIRST_ASSUM(fun a -> FIRST_ASSUM(fun lk ->
            ACCEPT_TAC(MATCH_MP a lk)));
          FIRST_ASSUM MATCH_ACCEPT_TAC])])) in
   V_INV_REFS_TAC ALL_TAC ALL_TAC (V_INV_REFS_PLAIN same)
     (V_INV_REFS_THUNK same 5) (V_INV_REFS_THUNK same 6))
### v_inv_MutBlock_hole
  (REPEAT STRIP_TAC THEN
   ASM_MESON_TAC[v_inv_eq; v_inv_MutBlock_hole_lemma])
### blocks_unique_update_mutblock
  (* the elements of the updated reference are among the ones of
     the old store, so what was unique there stays unique: the
     block that the update puts in has its head and its tail in
     the elements of the store it replaces *)
  (let cons_app = prove
    (`!(h:dataSem_v) t. CONS h t = APPEND [h] t`,
     REWRITE_TAC[APPEND]) in
   let lk_ins = prove
    (`!n p (y:(dataSem_v)bvlSem_ref) rfs z.
        lookup n (insert p y rfs) = SOME z <=>
        (n = p /\ y = z) \/ (~(n = p) /\ lookup n rfs = SOME z)`,
     REPEAT GEN_TAC THEN REWRITE_TAC[lookup_insert] THEN
     COND_CASES_TAC THEN
     ASM_REWRITE_TAC[injectivity "option"; distinctness "option"] THEN
     CONV_TAC TAUT) in
   let hd_is n t =
     (try fst(dest_const(fst(strip_comb t))) = n
      with Failure _ -> false) in
   REWRITE_TAC[blocks_unique_def] THEN
   DISCH_THEN(CONJUNCTS_THEN2 ASSUME_TAC ASSUME_TAC) THEN
   REPEAT GEN_TAC THEN STRIP_TAC THEN FIRST_ASSUM MATCH_MP_TAC THEN
   ASM_REWRITE_TAC[] THEN CONJ_TAC THEN
   W(fun (asl,w) ->
     let gel = el 0 (snd(strip_comb w)) in
     FIRST_ASSUM(fun inm ->
       let c = concl inm in
       if not (hd_is "IN" c) || not (el 0 (snd(strip_comb c)) = gel)
       then fail() else
       FIRST_ASSUM(fun lk ->
         if not (hd_is "=" (concl lk)) then fail() else
         MP_TAC(REWRITE_RULE[all_vs_def; IN_UNION; IN_ELIM_THM;
                             lk_ins; v_all_vs_append; MEM_APPEND;
                             injectivity "bvlSem_ref";
                             distinctness "bvlSem_ref"]
                  (ONCE_REWRITE_RULE[cons_app] inm)) THEN
         MP_TAC lk THEN
         REWRITE_TAC[all_vs_def; IN_UNION; IN_ELIM_THM;
                     v_all_vs_append; MEM_APPEND] THEN
         MESON_TAC[MEM_v_all_vs_extend_tl;
                   MEM_v_all_vs_extend_hd]))))
### ref_edge_MutBlock_UPDATE
  (* the edge of the updated reference is an edge of the old one:
     the payload of the MutBlock differs in the hole only, and the
     element of the hole is not z *)
  (let flat_app = prove
    (`!(l1:((A)list)list) l2.
        FLAT (APPEND l1 l2) = APPEND (FLAT l1) (FLAT l2)`,
     LIST_INDUCT_TAC THEN
     ASM_REWRITE_TAC[FLAT; APPEND; APPEND_ASSOC]) in
   let mem_refs = prove
    (`!z ll a rr.
        MEM z (get_refs (Block 0 ARB (APPEND ll (APPEND [a] rr)))) <=>
        MEM z (get_refs (Block 0 ARB ll)) \/ MEM z (get_refs a) \/
        MEM z (get_refs (Block 0 ARB rr))`,
     REWRITE_TAC[get_refs_def; MAP_APPEND; MAP; flat_app;
                 FLAT; MEM_APPEND; APPEND_NIL]) in
   let swap_refs = prove
    (`!z ll a b rr.
        MEM z (get_refs (Block 0 ARB (APPEND ll (APPEND [a] rr)))) /\
        ~MEM z (get_refs a)
        ==> MEM z (get_refs (Block 0 ARB (APPEND ll
                                           (APPEND [b] rr))))`,
     REWRITE_TAC[mem_refs] THEN MESON_TAC[]) in
   REWRITE_TAC[ref_edge_MutBlock] THEN COND_CASES_TAC THEN
   REPEAT STRIP_TAC THEN TRY(FIRST_ASSUM ACCEPT_TAC) THEN
   SUBGOAL_THEN
     `sptree_lookup r1 (refs:(dataSem_v bvlSem_ref) spt) =
      SOME (bvlSem_MutBlock tg fin ll cc rr)`
     (fun th -> ONCE_REWRITE_TAC[ref_edge_def] THEN
                REWRITE_TAC[th]) THENL
    [ASM_MESON_TAC[]; ALL_TAC] THEN
   MATCH_REDUCE_TAC THEN
   FIRST_ASSUM(fun th1 -> FIRST_ASSUM(fun th2 ->
     MATCH_ACCEPT_TAC(MATCH_MP swap_refs (CONJ th1 th2)))))
### reachable_refs_MutBlock_UPDATE
  (* the update replaces the centre of the MutBlock by h,
     which is the root at the front of the stack: a path
     through the new references is one through the old ones
     unless it leaves ptr into h, and then it starts at a
     root of its own *)
  ((* the head constant of a term, by name *)
   let hd_is n t =
     (try fst(dest_const(fst(strip_comb t))) = n
      with Failure _ -> false) in
   let mem_block_refs = prove
   (`!(ys:(dataSem_v)list) ss tt aa.
       MEM ss (get_refs (Block tt aa ys))
       ==> ?yy. MEM yy ys /\ MEM ss (get_refs yy)`,
    REWRITE_TAC[get_refs_def; MEM_FLAT; MEM_MAP] THEN
    MESON_TAC[]) in
  let block_refs = prove
   (`!(ys:(dataSem_v)list) ss tt aa yy.
       MEM yy ys /\ MEM ss (get_refs yy)
       ==> MEM ss (get_refs (Block tt aa ys))`,
    REWRITE_TAC[get_refs_def; MEM_FLAT; MEM_MAP] THEN
    MESON_TAC[]) in
  (* an edge that leaves ptr in the old references *)
  let oldedge = prove
   (`lookup ptr refs = SOME (bvlSem_MutBlock tg fin ll cc rr) /\
     MEM (s:num) (get_refs (Block 0 ARB (ll ++ [cc] ++ rr)))
     ==> ref_edge refs ptr (s:num)`,
    REWRITE_TAC[ref_edge_def] THEN STRIP_TAC THEN
    ASM_REWRITE_TAC[] THEN MATCH_REDUCE_TAC THEN
    ASM_REWRITE_TAC[]) in
  (* a path through the new references is one through the old ones,
     or it leaves ptr into h -- and h is a root of its own *)
  let rtcpath = prove
   (`lookup ptr refs = SOME (bvlSem_MutBlock tg fin ll cc rr)
     ==> !u w. RTC (ref_edge (insert ptr
                 (bvlSem_MutBlock tg fin ll h rr) refs)) u w
               ==> RTC (ref_edge refs) u w \/
                   (?s. MEM s (get_refs h) /\
                        RTC (ref_edge refs) s w)`,
    DISCH_TAC THEN MATCH_MP_TAC RTC_INDUCT THEN CONJ_TAC THENL
     [GEN_TAC THEN DISJ1_TAC THEN
      MATCH_ACCEPT_TAC(CONJUNCT1(SPEC_ALL RTC_RULES));
      MAP_EVERY X_GEN_TAC [`u:num`; `v:num`; `w:num`] THEN
      REWRITE_TAC[ref_edge_MutBlock] THEN
      COND_CASES_TAC THEN STRIP_TAC THEN
      (* the induction hypothesis gives the right half already *)
      TRY(DISJ2_TAC THEN EXISTS_TAC `s:num` THEN
          ASM_REWRITE_TAC[] THEN NO_TAC) THEN
      (* an edge that does not leave ptr is an old edge *)
      TRY(DISJ1_TAC THEN
          MATCH_MP_TAC(CONJUNCT2(SPEC_ALL RTC_RULES)) THEN
          EXISTS_TAC `v:num` THEN ASM_REWRITE_TAC[] THEN NO_TAC) THEN
      FIRST_ASSUM(fun m -> MP_TAC(MATCH_MP mem_block_refs m)) THEN
      DISCH_THEN(X_CHOOSE_THEN `yy:dataSem_v` STRIP_ASSUME_TAC) THEN
      FIRST_X_ASSUM(fun mm ->
        if hd_is "MEM" (concl mm) && hd_is "APPEND" (rand (concl mm))
        then MP_TAC(REWRITE_RULE[MEM_APPEND; MEM] mm) else fail()) THEN
      STRIP_TAC THEN
      (* it lands in h, which is a root *)
      TRY(DISJ2_TAC THEN EXISTS_TAC `v:num` THEN
          FIRST_X_ASSUM(fun eq ->
            if is_eq (concl eq) && is_var (lhs (concl eq)) &&
               is_var (rhs (concl eq))
            then SUBST_ALL_TAC eq else fail()) THEN
          ASM_REWRITE_TAC[] THEN NO_TAC) THEN
      (* or in a part that the old payload has too *)
      DISJ1_TAC THEN
      MATCH_MP_TAC(CONJUNCT2(SPEC_ALL RTC_RULES)) THEN
      EXISTS_TAC `v:num` THEN CONJ_TAC THEN
      TRY(FIRST_ASSUM ACCEPT_TAC) THEN
      MATCH_MP_TAC oldedge THEN ASM_REWRITE_TAC[] THEN
      MATCH_MP_TAC block_refs THEN EXISTS_TAC `yy:dataSem_v` THEN
      ASM_REWRITE_TAC[MEM_APPEND; MEM]]) in
  DISCH_THEN(CONJUNCTS_THEN2 (fun lk ->
      ASSUME_TAC lk THEN ASSUME_TAC(MATCH_MP rtcpath lk)) MP_TAC) THEN
  REWRITE_TAC[reachable_refs_def] THEN
  DISCH_THEN(X_CHOOSE_THEN `x:dataSem_v`
    (X_CHOOSE_THEN `r:num` STRIP_ASSUME_TAC)) THEN
  FIRST_ASSUM(fun pth ->
    if not (is_forall (concl pth)) then fail() else
    FIRST_ASSUM(fun rtc -> MP_TAC(MATCH_MP (SPEC_ALL pth) rtc))) THEN
  DISCH_THEN(DISJ_CASES_THEN2
    (fun old ->
       MAP_EVERY EXISTS_TAC [`x:dataSem_v`; `r:num`] THEN
       ASM_REWRITE_TAC[old])
    (X_CHOOSE_THEN `s:num` STRIP_ASSUME_TAC)) THEN
  MAP_EVERY EXISTS_TAC [`h:dataSem_v`; `s:num`] THEN
  ASM_REWRITE_TAC[MEM])
### LENGTH_write_bytes
  (LIST_INDUCT_TAC THEN REPEAT GEN_TAC THEN
   REWRITE_TAC[write_bytes_def] THEN
   CONV_TAC(ONCE_DEPTH_CONV let_CONV) THEN
   ASM_REWRITE_TAC[LENGTH])
### LIST_REL_IMP_LIST_REL
  (let aux = prove
    (`!(P:A->B->bool) Q xs ys.
        (!x y. MEM x xs /\ P x y ==> Q x y) /\ ALL2 P xs ys
        ==> ALL2 Q xs ys`,
     GEN_TAC THEN GEN_TAC THEN LIST_INDUCT_TAC THEN
     X_GEN_TAC `ys:B list` THEN
     STRUCT_CASES_TAC(ISPEC `ys:B list` list_CASES_v) THEN
     REWRITE_TAC[ALL2; MEM] THEN REPEAT STRIP_TAC THEN
     FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_REWRITE_TAC[] THEN
     REPEAT STRIP_TAC THEN FIRST_ASSUM MATCH_MP_TAC THEN
     ASM_REWRITE_TAC[]) in
   REPEAT GEN_TAC THEN
   REWRITE_TAC[TAUT `(p ==> q ==> r) <=> (p /\ q ==> r)`] THEN
   MATCH_ACCEPT_TAC aux)
### v_size_LESS_EQ
  (REPEAT STRIP_TAC THEN MATCH_MP_TAC misc_MEM_list_size THEN
   ASM_REWRITE_TAC[])
### v_inv_IMP
  (* the lemma is applied to the assumption and not to the goal:
     where a type variable of the statement stands only in the
     antecedent, MATCH_MP_TAC leaves the lemma's own one there *)
  (REWRITE_TAC[v_inv_eq] THEN REPEAT GEN_TAC THEN
   DISCH_THEN(fun th ->
     GEN_TAC THEN
     MATCH_ACCEPT_TAC(MATCH_MP v_inv_IMP_lemma
       (REWRITE_RULE[GSYM v_inv_eq] th))))
### v_inv_IMP_lemma
  (* the store replaces the contents of a byte array by another, and
     the element it writes is as long as the one that was there (a
     write keeps the words), so a lookup that finds something else
     finds it in the new heap as well (heap_lookup_replace) *)
  ((* the element that the store replaces is a Bytes, and what the
      relation looks up is none: so the lookup is the old one
      (heap_lookup_replace), because the two elements are as long *)
   let notbytes = prove
    (cake_as_vars (fun () ->
       `~(Bignum i = Bytes be flag bs (ys:('a word)list)) /\
        ~(Word64Rep (:'a) w = Bytes be flag bs ys) /\
        ~(BlockRep n xs = Bytes be flag bs ys) /\
        ~(ThunkBlock ev x = Bytes be flag bs ys)`),
     REWRITE_TAC[ThunkBlock_def; bignum_def; Word64Rep_def;
                 BlockRep_def; bytes_def] THEN
     PAIRARG_TAC THEN CONV_TAC(TOP_DEPTH_CONV let_CONV) THEN
     COND_CASES_TAC THEN
     REWRITE_TAC[injectivity "heap_element"; PAIR_EQ;
                 distinctness "data_to_word_memoryProof_tag";
                 NOT_CONS_NIL]) in
   let hp =
     MATCH_MP_TAC heap_lookup_replace THEN ASM_EXISTS_TAC THEN
     REPEAT CONJ_TAC THENL
      [FIRST_ASSUM MATCH_ACCEPT_TAC;
       (* the two elements are as long: a write keeps the words *)
       REWRITE_TAC[bytes_def] THEN
       CONV_TAC(TOP_DEPTH_CONV let_CONV) THEN
       REWRITE_TAC[el_length_def; LENGTH_write_bytes];
       REWRITE_TAC[notbytes]] in
   V_INV_REFS_TAC ALL_TAC hp V_INV_HEAP_PLAIN
     (V_INV_HEAP_THUNK hp 5) (V_INV_HEAP_THUNK hp 6))
### gen_state_ok_update_byte
  (* the two elements are of the same length and the one that is
     written holds no pointer, so a split of the heap gives the
     halves of the old one, up to that element *)
  ((* the head constant of a term, by name, and the assumption
      that a test picks out *)
   let hd_is n t =
     (try fst(dest_const(fst(strip_comb t))) = n
      with Failure _ -> false) in
   let grab asl p =
     tryfind (fun (_,th) ->
       if (try p th with Failure _ -> false) then th else fail())
       asl in
   let samelen b =
     prove(b,
       REWRITE_TAC[bytes_def] THEN
       CONV_TAC(TOP_DEPTH_CONV let_CONV) THEN
       REWRITE_TAC[el_length_def; LENGTH_write_bytes]) in
   let use_split =
     W(fun (asl,w) ->
       let sp = grab asl (fun th ->
                  hd_is "heap_split" (lhand (concl th))) in
       let c = concl sp in
       let e = rand (rator (lhand c)) in
       let old = rand (lhand c) in
       let ha = lhand old in
       let u = rand (rator (lhand (rand old))) in
       let hb = rand (rand old) in
       let h1,h2 = dest_pair (rand (rand c)) in
       let _,bod = strip_exists w in
       let newh = rand (lhand (lhand bod)) in
       let v = rand (rator (lhand (rand newh))) in
       MP_TAC(ISPECL [e; ha; u; v; hb; h1; h2]
                heap_split_replace)) THEN
     DISCH_THEN(fun imp ->
       FIRST_ASSUM(fun sp ->
         if not (hd_is "heap_split" (lhand (concl sp)))
         then fail() else
         MP_TAC(MATCH_MP imp
                  (CONJ sp (samelen (rand (lhand (concl imp)))))))) THEN
     DISCH_THEN(REPEAT_TCL CHOOSE_THEN STRIP_ASSUME_TAC) in
   let bytes_nopt =
     W(fun (asl,w) ->
       let eqv = grab asl (fun th -> is_eq (concl th) &&
                   hd_is "DataElement" (lhs (concl th))) in
       let r3 = REWRITE_RULE[injectivity "heap_element"]
                  (CONV_RULE(TOP_DEPTH_CONV let_CONV)
                     (REWRITE_RULE[bytes_def] eqv)) in
       let m = grab asl (fun th ->
                 hd_is "MEM" (concl th) &&
                 not (hd_is "DataElement"
                        (rand (rator (concl th))))) in
       MP_TAC(REWRITE_RULE[CONJUNCT1 r3; MEM] m)) THEN
     REWRITE_TAC[] in
   STRUCT_CASES_TAC(ISPEC `gens:gen_state`
     (cases_of `:gen_state`)) THEN
   REWRITE_TAC[gen_state_ok_def] THEN
   DISCH_THEN(REPEAT_TCL CONJUNCTS_THEN ASSUME_TAC) THEN
   ASM_REWRITE_TAC[] THEN
   FIRST_X_ASSUM(fun ev ->
     if hd_is "ALL" (concl ev) &&
        hd_is "gen_start_ok" (lhand (concl ev))
     then MP_TAC(REWRITE_RULE[GSYM ALL_MEM] ev) else fail()) THEN
   REWRITE_TAC[GSYM ALL_MEM] THEN
   DISCH_TAC THEN GEN_TAC THEN DISCH_TAC THEN
   FIRST_ASSUM(fun ev ->
     FIRST_ASSUM(fun mm -> MP_TAC(MATCH_MP ev mm))) THEN
   REWRITE_TAC[gen_start_ok_def] THEN
   DISCH_THEN(REPEAT_TCL CHOOSE_THEN STRIP_ASSUME_TAC) THEN
   use_split THEN
   W(fun (asl,w) ->
     let sp2 = grab asl (fun th ->
                 hd_is "heap_split" (lhand (concl th))) in
     let a,b = dest_pair (rand (rand (concl sp2))) in
     MAP_EVERY EXISTS_TAC [a; b]) THEN
   ASM_REWRITE_TAC[] THEN
   REPEAT GEN_TAC THEN STRIP_TAC THEN
   FIRST_ASSUM(fun tr ->
     if not (is_forall (concl tr)) then fail() else
     FIRST_ASSUM(fun m ->
       if not (hd_is "MEM" (concl m)) then fail() else
       MP_TAC(MATCH_MP (SPEC_ALL tr) m))) THEN
   DISCH_THEN(DISJ_CASES_THEN2 ASSUME_TAC ASSUME_TAC) THENL
    [(* the element is one of the old half, so the old condition
        says what the goal says *)
     ASM_MESON_TAC[];
     (* or it is the one that was written, which holds no pointer *)
     bytes_nopt])
### unused_space_inv_byte_update
  (* the unused element is not the one that was written, the heap
     is as long as it was, and the part below the pointer still
     holds data *)
  ((* the head constant of a term, by name, and the assumption
      that a test picks out *)
   let hd_is n t =
     (try fst(dest_const(fst(strip_comb t))) = n
      with Failure _ -> false) in
   let grab asl p =
     tryfind (fun (_,th) ->
       if (try p th with Failure _ -> false) then th else fail())
       asl in
   let bytefacts =
     REWRITE_TAC[bytes_def] THEN
     CONV_TAC(TOP_DEPTH_CONV let_CONV) in
   let samelen b =
     prove(b, bytefacts THEN
              REWRITE_TAC[el_length_def; LENGTH_write_bytes]) in
   REWRITE_TAC[unused_space_inv_def] THEN
   DISCH_THEN(REPEAT_TCL CONJUNCTS_THEN ASSUME_TAC) THEN
   REPEAT CONJ_TAC THENL
    [DISCH_TAC THEN
     FIRST_ASSUM(fun imp ->
       if not (is_imp (concl imp)) then fail() else
       FIRST_ASSUM(fun ne -> MP_TAC(MATCH_MP imp ne))) THEN
     DISCH_TAC THEN
     W(fun (asl,w) ->
       let lk = grab asl (fun th ->
                  hd_is "heap_lookup" (lhand (concl th))) in
       let c = concl lk in
       let n = rand (rator (lhand c)) in
       let old = rand (lhand c) in
       let ha = lhand old in
       let u = rand (rator (lhand (rand old))) in
       let hb = rand (rand old) in
       let z = rand (rand c) in
       let newh = rand (lhand w) in
       let v = rand (rator (lhand (rand newh))) in
       MP_TAC(ISPECL [n; ha; u; v; hb; z] heap_lookup_replace)) THEN
     DISCH_THEN(fun imp ->
       FIRST_ASSUM(fun lk ->
         if not (hd_is "heap_lookup" (lhand (concl lk)))
         then fail() else
         let ants = conjuncts (lhand (concl imp)) in
         let notit = prove(el 2 ants,
           bytefacts THEN
           REWRITE_TAC[distinctness "heap_element"]) in
         ACCEPT_TAC(MATCH_MP imp
           (CONJ lk (CONJ (samelen (el 1 ants)) notit)))));
     FIRST_ASSUM(fun le ->
       if hd_is "<=" (concl le) then MP_TAC le else fail()) THEN
     REWRITE_TAC[heap_length_APPEND; heap_length_clauses;
                 bytes_def] THEN
     CONV_TAC(TOP_DEPTH_CONV let_CONV) THEN
     REWRITE_TAC[el_length_def; LENGTH_write_bytes];
     FIRST_ASSUM(fun du ->
       if hd_is "data_up_to" (concl du) then MP_TAC du
       else fail()) THEN
     REWRITE_TAC[data_up_to_def] THEN
     DISCH_THEN(REPEAT_TCL CHOOSE_THEN STRIP_ASSUME_TAC) THEN
     W(fun (asl,w) ->
       let sp = grab asl (fun th ->
                  hd_is "heap_split" (lhand (concl th))) in
       let c = concl sp in
       let e = rand (rator (lhand c)) in
       let old = rand (lhand c) in
       let ha = lhand old in
       let u = rand (rator (lhand (rand old))) in
       let hb = rand (rand old) in
       let h1,h2 = dest_pair (rand (rand c)) in
       let _,bod = strip_exists w in
       let newh = rand (lhand (lhand bod)) in
       let v = rand (rator (lhand (rand newh))) in
       MP_TAC(ISPECL [e; ha; u; v; hb; h1; h2]
                heap_split_replace)) THEN
     DISCH_THEN(fun imp ->
       FIRST_ASSUM(fun sp ->
         if not (hd_is "heap_split" (lhand (concl sp)))
         then fail() else
         MP_TAC(MATCH_MP imp
           (CONJ sp (samelen (rand (lhand (concl imp)))))))) THEN
     DISCH_THEN(REPEAT_TCL CHOOSE_THEN STRIP_ASSUME_TAC) THEN
     W(fun (asl,w) ->
       let sp2 = grab asl (fun th ->
                   hd_is "heap_split" (lhand (concl th))) in
       let a,b = dest_pair (rand (rand (concl sp2))) in
       MAP_EVERY EXISTS_TAC [a; b]) THEN
     ASM_REWRITE_TAC[] THEN
     REWRITE_TAC[GSYM ALL_MEM] THEN
     GEN_TAC THEN DISCH_TAC THEN
     FIRST_ASSUM(fun tr ->
       if not (is_forall (concl tr)) then fail() else
       FIRST_ASSUM(fun m ->
         if not (hd_is "MEM" (concl m)) then fail() else
         MP_TAC(MATCH_MP (SPEC_ALL tr) m))) THEN
     DISCH_THEN(DISJ_CASES_THEN2 ASSUME_TAC SUBST_ALL_TAC) THENL
      [FIRST_ASSUM(fun ev ->
         if hd_is "ALL" (concl ev)
         then ASM_MESON_TAC[REWRITE_RULE[GSYM ALL_MEM] ev]
         else fail());
       bytefacts THEN REWRITE_TAC[isDataElement_def] THEN
       W(fun (asl,w) ->
         let _,bod = strip_exists w in
         MAP_EVERY EXISTS_TAC (snd(strip_comb (lhs bod)))) THEN
       REFL_TAC]])
### blocks_unique_insert_ByteArray
  (* a ByteArray holds no value of the language *)
  (let li = prove
    (`!k1 k2 v (t:(A)spt) y.
        (sptree_lookup k1 (sptree_insert k2 v t) = SOME y) <=>
        (k1 = k2 /\ v = y) \/
        (~(k1 = k2) /\ sptree_lookup k1 t = SOME y)`,
     REPEAT GEN_TAC THEN REWRITE_TAC[lookup_insert] THEN
     COND_CASES_TAC THEN
     ASM_REWRITE_TAC[injectivity "option"] THEN CONV_TAC TAUT) in
   let inc = prove
    (`!refs p fl ys s t a q.
        Block t a q IN all_vs (insert p (ByteArray fl ys) refs) s ==>
        Block t a q IN all_vs refs s`,
     REWRITE_TAC[all_vs_def; IN_UNION; IN_ELIM_THM; li;
                 distinctness "bvlSem_ref";
                 injectivity "bvlSem_ref"] THEN MESON_TAC[]) in
   REWRITE_TAC[blocks_unique_def] THEN DISCH_TAC THEN
   REPEAT GEN_TAC THEN STRIP_TAC THEN FIRST_ASSUM MATCH_MP_TAC THEN
   REPEAT CONJ_TAC THEN ASM_MESON_TAC[inc])
### heap_store_unused_thm
  (* the store goes where the unused element of the split sits: the
     split is as long as the space, so what is left of it after
     that element is empty, and then heap_store_lemma says what
     the heap becomes *)
  ((* the head constant of a term, by name *)
   let hd_is n t =
     (try fst(dest_const(fst(strip_comb t))) = n
      with Failure _ -> false) in
   (* the assumption that a test picks out *)
   let grab asl p =
     tryfind (fun (_,th) ->
       if (try p th with Failure _ -> false) then th else fail())
       asl in
   (* an element of a heap is at least one word long *)
   let elpos = prove
    (`!y:(A,B)heap_element. 0 < el_length y`,
     GEN_TAC THEN
     STRUCT_CASES_TAC(ISPEC `y:(A,B)heap_element`
       (cases_of `:(A,B)heap_element`)) THEN
     REWRITE_TAC[el_length_def] THEN ARITH_TAC) in
   (* the length of a heap, clause by clause *)
   let hlen_cl = prove
    (`heap_length [] = 0 /\
      (!x xs. heap_length (CONS x xs) =
              el_length x + heap_length xs)`,
     REWRITE_TAC[heap_length_def; MAP; SUM_DEF; ITLIST]) in
   (* so a heap of no length is empty *)
   let hlen0 = prove
    (`!hb:((A,B)heap_element)list. heap_length hb = 0 ==> hb = []`,
     LIST_INDUCT_TAC THEN
     REWRITE_TAC[hlen_cl; NOT_CONS_NIL] THEN
     MP_TAC(ISPEC `h:(A,B)heap_element` elpos) THEN ARITH_TAC) in
   REPEAT GEN_TAC THEN
   REWRITE_TAC[heap_store_unused_def] THEN
   COND_CASES_TAC THEN REWRITE_TAC[PAIR_EQ] THEN
   POP_ASSUM(CONJUNCTS_THEN2 ASSUME_TAC ASSUME_TAC) THEN
   STRIP_TAC THEN
   FIRST_ASSUM(fun hs ->
     MP_TAC(MATCH_MP heap_split_heap_length hs)) THEN
   DISCH_THEN(REPEAT_TCL CONJUNCTS_THEN ASSUME_TAC) THEN
   SUBGOAL_THEN `0 < n` ASSUME_TAC THENL
    [ASM_MESON_TAC[elpos; LTE_TRANS]; ALL_TAC] THEN
   FIRST_ASSUM(fun eq ->
     if is_eq (concl eq) && hd_is "APPEND" (lhand (concl eq))
     then SUBST_ALL_TAC (SYM eq) else fail()) THEN
   (* the lookup is inside the first half of the split *)
   W(fun (asl,w) ->
     let hl = grab asl (fun th ->
       hd_is "heap_lookup" (lhand (concl th))) in
     let ap = rand (lhand (concl hl)) in
     SUBGOAL_THEN (subst [lhand ap,ap] (concl hl)) ASSUME_TAC THENL
      [MP_TAC(REWRITE_RULE
         [data_to_word_memoryProof_heap_lookup_APPEND] hl) THEN
       ASM_SIMP_TAC[ARITH_RULE `0 < n ==> a < a + n`] THEN
       TRY(DISCH_THEN ACCEPT_TAC);
       ALL_TAC]) THEN
   FIRST_ASSUM(fun hl ->
     if hd_is "heap_lookup" (lhand (concl hl)) &&
        is_var (rand (lhand (concl hl)))
     then MP_TAC(MATCH_MP heap_lookup_SPLIT hl) else fail()) THEN
   DISCH_THEN(REPEAT_TCL CHOOSE_THEN STRIP_ASSUME_TAC) THEN
   FIRST_ASSUM(fun eq ->
     if is_eq (concl eq) && is_var (lhs (concl eq)) &&
        hd_is "APPEND" (rhs (concl eq))
     then SUBST_ALL_TAC eq else fail()) THEN
   (* what is left of the split after that element is empty *)
   W(fun (asl,w) ->
     MP_TAC(ISPEC (var_by_name "hb" (asl,w)) hlen0)) THEN
   ANTS_TAC THENL
    [FIRST_ASSUM(fun hl ->
       if is_eq (concl hl) &&
          hd_is "heap_length" (lhand (concl hl)) &&
          hd_is "+" (rand (concl hl))
       then MP_TAC(REWRITE_RULE[heap_length_APPEND; hlen_cl;
                                el_length_def] hl)
       else fail()) THEN
     MP_TAC(ASSUME `0 < n`) THEN
     FIRST_ASSUM(fun ae ->
       if is_eq (concl ae) && is_var (lhs (concl ae)) &&
          hd_is "heap_length" (rhs (concl ae))
       then SUBST1_TAC ae else fail()) THEN
     ARITH_TAC;
     ALL_TAC] THEN
   DISCH_THEN SUBST_ALL_TAC THEN
   W(fun (asl,w) -> EXISTS_TAC (var_by_name "ha" (asl,w))) THEN
   REPEAT CONJ_TAC THEN TRY(REWRITE_TAC[] THEN NO_TAC) THEN
   TRY(FIRST_ASSUM(fun ae -> ACCEPT_TAC (SYM ae))) THEN
   (* and the store puts what it stores where that element was *)
   FIRST_ASSUM(fun hs ->
     if hd_is "heap_store" (lhand (concl hs))
     then MP_TAC(REWRITE_RULE[GSYM APPEND_ASSOC; APPEND] hs)
     else fail()) THEN
   FIRST_ASSUM(fun ae ->
     if is_eq (concl ae) && is_var (lhs (concl ae)) &&
        hd_is "heap_length" (rhs (concl ae))
     then SUBST1_TAC ae else fail()) THEN
   REWRITE_TAC[heap_store_lemma; PAIR_EQ] THEN
   DISCH_THEN(CONJUNCTS_THEN2 (SUBST1_TAC o SYM) (K ALL_TAC)) THEN
   REWRITE_TAC[GSYM APPEND_ASSOC; APPEND])
### heap_store_unused_heap_lookup
  (* and the same for the store that keeps the unused space at the
     end *)
  (REPEAT GEN_TAC THEN
   REWRITE_TAC[heap_store_unused_def] THEN
   COND_CASES_TAC THENL
    [MATCH_ACCEPT_TAC heap_store_heap_lookup;
     REWRITE_TAC[PAIR_EQ]])
### heap_store_unused_gen_state_ok
  (* a start of a generation is below a, so the split of the heap
     there is the split of the stored heap (heap_split_heap_store),
     with the same first half; and the references start lower than
     before, which is a weaker bound on the pointers.  The transfer
     is a lemma with type variables of its own, so that it can be
     used on the heaps of the goal (PORTING-GUIDE.md entry 25) *)
  (
   let transfer = prove
    (`!(hp:((A,B)heap_element)list) hp2 aa kk xx ss.
        heap_store aa (heap_expand (kk - el_length xx) ++ [xx]) hp =
          (hp2,T) /\
        ss <= aa /\ gen_start_ok hp (aa + kk) ss
        ==> gen_start_ok hp2 ((aa + kk) - el_length xx) ss`,
     REPEAT GEN_TAC THEN
     REWRITE_TAC[gen_start_ok_def] THEN
     DISCH_THEN(CONJUNCTS_THEN2 ASSUME_TAC (CONJUNCTS_THEN2 ASSUME_TAC
       (REPEAT_TCL CHOOSE_THEN
         (CONJUNCTS_THEN2 ASSUME_TAC ASSUME_TAC)))) THEN
     FIRST_ASSUM(fun hs -> FIRST_ASSUM(fun sp -> FIRST_ASSUM(fun le ->
       MP_TAC(MATCH_MP heap_split_heap_store
         (CONJ sp (CONJ hs le)))))) THEN
     DISCH_THEN(X_CHOOSE_THEN `h3:((A,B)heap_element)list`
       ASSUME_TAC) THEN
     ASM_EXISTS_TAC THEN ASM_REWRITE_TAC[] THEN
     REPEAT GEN_TAC THEN STRIP_TAC THEN
     FIRST_ASSUM(fun pc -> FIRST_ASSUM(fun m1 -> FIRST_ASSUM(fun m2 ->
       MP_TAC(MATCH_MP pc (CONJ m1 m2))))) THEN
     ARITH_TAC) in
   STRIP_TAC THEN CASES_ON_NAME "gens" THEN
   RULE_ASSUM_TAC(REWRITE_RULE[gen_state_ok_def]) THEN
   REWRITE_TAC[gen_state_ok_def] THEN
   USE_CHANGED [heap_store_unused_def] THEN
   COND_CASES_TAC THEN REWRITE_TAC[PAIR_EQ] THEN
   FIRST [DISCH_THEN(fun th ->
            CONTR_TAC(REWRITE_RULE[] (CONJUNCT2 th)));
          DISCH_TAC] THEN
   FIRST_ASSUM(fun gs ->
     let c1 = CONJUNCT1 gs and c2 = CONJUNCT2 gs in
     CONJ_TAC THENL
      [ACCEPT_TAC c1;
       MATCH_MP_TAC ALL_IMP THEN
       EXISTS_TAC (lhand (concl c2)) THEN
       CONJ_TAC THENL
        [GEN_TAC THEN STRIP_TAC THEN MATCH_MP_TAC transfer THEN
         W(fun (asl,w) ->
           let hs = find (fun (_,th) ->
             (try fst(dest_const(fst(strip_comb(lhand(concl th))))) =
                  "heap_store"
              with Failure _ -> false)) asl in
           EXISTS_TAC (el 2 (snd(strip_comb
             (lhand (concl (snd hs))))))) THEN
         ASM_REWRITE_TAC[] THEN
         FIRST_ASSUM(fun m ->
           ACCEPT_TAC(MATCH_MP (REWRITE_RULE[GSYM ALL_MEM] c1) m));
         ACCEPT_TAC c2]]))
### blocks_unique_new_ref
  (* the ValueArray of the new reference holds the values that the
     stack has in front of it already *)
  (let li = prove
    (`!k1 k2 v (t:(A)spt) y.
        (sptree_lookup k1 (sptree_insert k2 v t) = SOME y) <=>
        (k1 = k2 /\ v = y) \/
        (~(k1 = k2) /\ sptree_lookup k1 t = SOME y)`,
     REPEAT GEN_TAC THEN REWRITE_TAC[lookup_insert] THEN
     COND_CASES_TAC THEN
     ASM_REWRITE_TAC[injectivity "option"] THEN CONV_TAC TAUT) in
   let vrefptr = prove
    (`!b p ys. v_all_vs (CONS (RefPtr b p) ys) =
        CONS (RefPtr b p) (v_all_vs ys)`,
     REPEAT GEN_TAC THEN
     GEN_REWRITE_TAC LAND_CONV [v_all_vs_def] THEN
     MATCH_REDUCE_TAC THEN REWRITE_TAC[]) in
   let inc = prove
    (`!refs p xs stack' t a q.
        Block t a q IN
          all_vs (insert p (ValueArray xs) refs)
                 (APPEND xs (CONS (RefPtr T p) stack')) ==>
        Block t a q IN all_vs refs (APPEND xs stack')`,
     REWRITE_TAC[all_vs_def; IN_UNION; IN_ELIM_THM; li;
                 vrefptr; v_all_vs_append; MEM; MEM_APPEND;
                 distinctness "dataSem_v";
                 distinctness "bvlSem_ref";
                 injectivity "bvlSem_ref"] THEN MESON_TAC[]) in
   REWRITE_TAC[blocks_unique_def] THEN DISCH_TAC THEN
   REPEAT GEN_TAC THEN STRIP_TAC THEN FIRST_ASSUM MATCH_MP_TAC THEN
   REPEAT CONJ_TAC THEN ASM_MESON_TAC[inc])
### v_inv_new_Thunk_insert_lemma
  (* a thunk at a key that the refs do not have: now a lookup of
     the new refs does find a thunk where the old ones found
     nothing, so the facts hold away from ptr -- and a pointer of
     the relation is a key of f, which ptr is not, while a thunk of
     the old refs is one of the new refs wherever it is *)
  (let opt = [distinctness "option"; injectivity "option"] in
   let rfs = [distinctness "bvlSem_ref";
              injectivity "bvlSem_ref";
              distinctness "dataSem_dest_thunk_ret"] in
   let notptr3 = prove
    (`~(ptr IN FDOM f) /\ k IN FDOM f ==> ~(k = ptr)`,
     MESON_TAC[]) in
   let thunk_tr = prove
    (`lookup ptr refs = NONE ==>
      (!k ev2 v2. lookup k refs = SOME (Thunk ev2 v2) ==>
         lookup k (insert ptr (Thunk ev h) refs) =
           SOME (Thunk ev2 v2))`,
     DISCH_TAC THEN REPEAT GEN_TAC THEN
     REWRITE_TAC[lookup_insert] THEN
     COND_CASES_TAC THEN ASM_REWRITE_TAC(opt @ rfs)) in
   let same = prove
    (`lookup ptr refs = NONE ==>
      (!k. ~(k = ptr) ==>
         (!ev2 v2.
            lookup k (insert ptr (Thunk ev h) refs) =
              SOME (Thunk ev2 v2) <=>
            lookup k refs = SOME (Thunk ev2 v2))) /\
      (!k. ~(k = ptr) ==>
         ref_ptr_annot conf
           (lookup k (insert ptr (Thunk ev h) refs)) =
         ref_ptr_annot conf (lookup k refs)) /\
      (!v. dest_thunk v refs = NotThunk ==>
           dest_thunk v (insert ptr (Thunk ev h) refs) = NotThunk) /\
      (!k bb.
         (!t2 g2 m2 d2 s2.
            lookup k refs = SOME (bvlSem_MutBlock t2 g2 m2 d2 s2)
              ==> ~bb)
         ==> (!t2 g2 m2 d2 s2.
            lookup k (insert ptr (Thunk ev h) refs) =
              SOME (bvlSem_MutBlock t2 g2 m2 d2 s2) ==> ~bb))`,
     DISCH_TAC THEN
     (REPEAT CONJ_TAC THENL
      [REPEAT STRIP_TAC THEN REWRITE_TAC[lookup_insert] THEN
       ASM_REWRITE_TAC[];
       REPEAT STRIP_TAC THEN REWRITE_TAC[lookup_insert] THEN
       ASM_REWRITE_TAC[];
       GEN_TAC THEN CASES_ON_NAME "v" THEN
       ONCE_REWRITE_TAC[dataSem_dest_thunk_def] THEN
       SAFE_MATCH_REDUCE_TAC THEN REWRITE_TAC[] THEN
       REWRITE_TAC[lookup_insert] THEN
       ASM_CASES_TAC `a1:num = ptr` THEN ASM_REWRITE_TAC[] THEN
       TRY MATCH_REDUCE_TAC THEN REWRITE_TAC(opt @ rfs) THEN
       REPEAT COND_CASES_TAC THEN REWRITE_TAC[] THEN
       TRY(CONV_TAC TAUT);
       REPEAT GEN_TAC THEN DISCH_TAC THEN REPEAT GEN_TAC THEN
       REWRITE_TAC[lookup_insert] THEN COND_CASES_TAC THEN
       ASM_REWRITE_TAC(opt @ rfs) THEN
       TRY(FIRST_ASSUM MATCH_ACCEPT_TAC)])) in
   let lt1 = ARITH_RULE `~(ck = 0) ==> ck - 1 < ck` in
   let prep =
     FIRST_ASSUM(fun ds ->
       ASSUME_TAC(CONJUNCT1 ds) THEN
       ASSUME_TAC(MATCH_MP no_lk (CONJUNCT1(CONJUNCT2 ds)))) in
   let d5 =
     REPEAT SUBST_LHS_TAC THEN
     FIRST_ASSUM(fun nolk ->
       let (t_eq,a_eq,_,m_imp) = v_inv_refs_parts same nolk in
       FIRST_ASSUM(fun nf -> FIRST_ASSUM(fun fd ->
         let np = MATCH_MP notptr3 (CONJ nf fd) in
         REWRITE_TAC[GSYM (MATCH_MP a_eq np)] THEN
         MATCH_MP_TAC(el 4 v_inv_ck_rules) THEN
         REPEAT CONJ_TAC THENL
          [FIRST_ASSUM MATCH_ACCEPT_TAC;
           ASM_REWRITE_TAC[MATCH_MP t_eq np];
           MATCH_MP_TAC m_imp THEN
           FIRST_ASSUM MATCH_ACCEPT_TAC]))) in
   let d_nt n =
     NOT_VAR_TAC THEN REPEAT SUBST_LHS_TAC THEN
     FIRST_ASSUM(fun nolk ->
       let (_,_,dt,_) = v_inv_refs_parts same nolk in
       let tr = MATCH_MP thunk_tr nolk in
       FIRST_ASSUM(fun ih ->
         ASM_MESON_TAC[el n v_inv_ck_rules; tr; dt;
                       SPEC `ck - 1` ih; lt1])) in
   V_INV_REFS_TAC prep ALL_TAC d5 (d_nt 5) (d_nt 6))
### blocks_unique_new_thunk
  (* the value that the thunk holds is on the stack already,
     and the RefPtr that is put there is no Block *)
  (let li = prove
    (`!k1 k2 v (t:(A)spt) y.
        (sptree_lookup k1 (sptree_insert k2 v t) = SOME y) <=>
        (k1 = k2 /\ v = y) \/
        (~(k1 = k2) /\ sptree_lookup k1 t = SOME y)`,
     REPEAT GEN_TAC THEN REWRITE_TAC[lookup_insert] THEN
     COND_CASES_TAC THEN
     ASM_REWRITE_TAC[injectivity "option"] THEN CONV_TAC TAUT) in
   let cons_app = prove
    (`!(h:dataSem_v) t. CONS h t = APPEND [h] t`,
     REWRITE_TAC[APPEND]) in
   let vrefptr = prove
    (`!b p ys. v_all_vs (CONS (RefPtr b p) ys) =
        CONS (RefPtr b p) (v_all_vs ys)`,
     REPEAT GEN_TAC THEN
     GEN_REWRITE_TAC LAND_CONV [v_all_vs_def] THEN
     MATCH_REDUCE_TAC THEN REWRITE_TAC[]) in
   let f1 = prove
    (`!(v:dataSem_v) p xs y.
        MEM y (v_all_vs (CONS v (CONS (RefPtr F p) xs))) <=>
        MEM y (v_all_vs [v]) \/ y = RefPtr F p \/
        MEM y (v_all_vs xs)`,
     REPEAT GEN_TAC THEN
     GEN_REWRITE_TAC (LAND_CONV o RAND_CONV o RAND_CONV)
       [cons_app] THEN
     REWRITE_TAC[v_all_vs_append; MEM_APPEND; vrefptr; MEM]) in
   let inc = prove
    (`!refs ptr ev v stack' t a q.
        Block t a q IN
          all_vs (insert ptr (Thunk ev v) refs)
                 (CONS v (CONS (RefPtr F ptr) stack')) ==>
        Block t a q IN all_vs refs (CONS v stack')`,
     REPEAT GEN_TAC THEN
     REWRITE_TAC[all_vs_def; IN_UNION; IN_ELIM_THM; li; f1;
                 distinctness "bvlSem_ref"; injectivity "bvlSem_ref";
                 distinctness "dataSem_v"] THEN
     MESON_TAC[MEM_v_all_vs_extend_tl; MEM_v_all_vs_extend_hd]) in
   REWRITE_TAC[blocks_unique_def] THEN DISCH_TAC THEN
   REPEAT GEN_TAC THEN STRIP_TAC THEN FIRST_ASSUM MATCH_MP_TAC THEN
   REPEAT CONJ_TAC THEN ASM_MESON_TAC[inc])
### blocks_unique_deref1
  (* the value of the thunk is a value of the refs already *)
  (let vcons = prove
    (`!(v:dataSem_v) xs y. MEM y (v_all_vs (CONS v xs)) <=>
        MEM y (v_all_vs [v]) \/ MEM y (v_all_vs xs)`,
     REPEAT GEN_TAC THEN
     GEN_REWRITE_TAC (LAND_CONV o RAND_CONV o RAND_CONV)
       [prove(`!(h:dataSem_v) t. CONS h t = APPEND [h] t`,
              REWRITE_TAC[APPEND])] THEN
     REWRITE_TAC[v_all_vs_append; MEM_APPEND]) in
   let inc = prove
    (`!refs ptr a' stack' t a q.
        sptree_lookup ptr refs = SOME (Thunk NotEvaluated a') /\
        Block t a q IN all_vs refs (CONS a' (CONS (RefPtr F ptr)
          stack')) ==>
        Block t a q IN all_vs refs (CONS (RefPtr F ptr) stack')`,
     REWRITE_TAC[all_vs_def; IN_UNION; IN_ELIM_THM] THEN
     MESON_TAC[vcons]) in
   REWRITE_TAC[blocks_unique_def] THEN STRIP_TAC THEN
   REPEAT GEN_TAC THEN STRIP_TAC THEN FIRST_ASSUM MATCH_MP_TAC THEN
   REPEAT CONJ_TAC THEN ASM_MESON_TAC[inc])
### blocks_unique_deref2
  (* the value that the dereference puts on the stack is one
     of the ValueArray that the pointer holds *)
  (let cons_app = prove
    (`!(h:dataSem_v) t. CONS h t = APPEND [h] t`,
     REWRITE_TAC[APPEND]) in
   let vrefptr = prove
    (`!b p ys. v_all_vs (CONS (RefPtr b p) ys) =
        CONS (RefPtr b p) (v_all_vs ys)`,
     REPEAT GEN_TAC THEN
     GEN_REWRITE_TAC LAND_CONV [v_all_vs_def] THEN
     MATCH_REDUCE_TAC THEN REWRITE_TAC[]) in
   let fref = prove
    (`!(v:dataSem_v) p b xs y.
        MEM y (v_all_vs (CONS v (CONS (RefPtr b p) xs))) <=>
        MEM y (v_all_vs [v]) \/ y = RefPtr b p \/ MEM y (v_all_vs xs)`,
     REPEAT GEN_TAC THEN
     GEN_REWRITE_TAC (LAND_CONV o RAND_CONV o RAND_CONV)
       [cons_app] THEN
     REWRITE_TAC[v_all_vs_append; MEM_APPEND; vrefptr; MEM]) in
   let inc = prove
    (`!refs ptr b l n stack' t a q.
        n < LENGTH l /\
        sptree_lookup ptr refs = SOME (ValueArray l) /\
        Block t a q IN
          all_vs refs (CONS (EL n l) (CONS (RefPtr b ptr) stack')) ==>
        Block t a q IN all_vs refs (CONS (RefPtr b ptr) stack')`,
     REWRITE_TAC[all_vs_def; IN_UNION; IN_ELIM_THM; fref;
                 distinctness "dataSem_v"] THEN
     MESON_TAC[MEM_v_all_vs_EL; MEM_v_all_vs_extend_hd]) in
   REWRITE_TAC[blocks_unique_def] THEN STRIP_TAC THEN
   REPEAT GEN_TAC THEN STRIP_TAC THEN FIRST_ASSUM MATCH_MP_TAC THEN
   REPEAT CONJ_TAC THEN ASM_MESON_TAC[inc])
### blocks_unique_el
  (* and the element of a Block is one of its payload *)
  (let cons_app = prove
    (`!(h:dataSem_v) t. CONS h t = APPEND [h] t`,
     REWRITE_TAC[APPEND]) in
   let vblk = prove
    (`!t tag xs ys. v_all_vs (CONS (Block t tag xs) ys) =
        APPEND (CONS (Block t tag xs) (v_all_vs xs)) (v_all_vs ys)`,
     REPEAT GEN_TAC THEN
     GEN_REWRITE_TAC LAND_CONV [v_all_vs_def] THEN
     MATCH_REDUCE_TAC THEN REWRITE_TAC[]) in
   let fblk = prove
    (`!(v:dataSem_v) t tag xs ys y.
        MEM y (v_all_vs (CONS v (CONS (Block t tag xs) ys))) <=>
        MEM y (v_all_vs [v]) \/ y = Block t tag xs \/
        MEM y (v_all_vs xs) \/ MEM y (v_all_vs ys)`,
     REPEAT GEN_TAC THEN
     GEN_REWRITE_TAC (LAND_CONV o RAND_CONV o RAND_CONV)
       [cons_app] THEN
     REWRITE_TAC[v_all_vs_append; MEM_APPEND; vblk; MEM;
                 DISJ_ASSOC]) in

   let inc = prove
    (`!refs t0 n xs i stack' t a q.
        i < LENGTH xs /\
        Block t a q IN
          all_vs refs (CONS (EL i xs) (CONS (Block t0 n xs)
            stack')) ==>
        Block t a q IN all_vs refs (CONS (Block t0 n xs) stack')`,
     REWRITE_TAC[all_vs_def; IN_UNION; IN_ELIM_THM; fblk;
                 vblk; MEM; MEM_APPEND] THEN
     MESON_TAC[MEM_v_all_vs_EL]) in
   REWRITE_TAC[blocks_unique_def] THEN STRIP_TAC THEN
   REPEAT GEN_TAC THEN STRIP_TAC THEN FIRST_ASSUM MATCH_MP_TAC THEN
   REPEAT CONJ_TAC THEN ASM_MESON_TAC[inc])
### blocks_unique_new_byte_alt
  (* and the RefPtr that the stack is given is no Block *)
  (let li = prove
    (`!k1 k2 v (t:(A)spt) y.
        (sptree_lookup k1 (sptree_insert k2 v t) = SOME y) <=>
        (k1 = k2 /\ v = y) \/
        (~(k1 = k2) /\ sptree_lookup k1 t = SOME y)`,
     REPEAT GEN_TAC THEN REWRITE_TAC[lookup_insert] THEN
     COND_CASES_TAC THEN
     ASM_REWRITE_TAC[injectivity "option"] THEN CONV_TAC TAUT) in
   let vrefptr = prove
    (`!b p ys. v_all_vs (CONS (RefPtr b p) ys) =
        CONS (RefPtr b p) (v_all_vs ys)`,
     REPEAT GEN_TAC THEN
     GEN_REWRITE_TAC LAND_CONV [v_all_vs_def] THEN
     MATCH_REDUCE_TAC THEN REWRITE_TAC[]) in
   let inc = prove
    (`!refs p fl bs b stack' t a q.
        Block t a q IN
          all_vs (insert p (ByteArray fl bs) refs)
                 (CONS (RefPtr b p) stack') ==>
        Block t a q IN all_vs refs stack'`,
     REWRITE_TAC[all_vs_def; IN_UNION; IN_ELIM_THM; li;
                 vrefptr; MEM; distinctness "dataSem_v";
                 distinctness "bvlSem_ref";
                 injectivity "bvlSem_ref"] THEN MESON_TAC[]) in
   REWRITE_TAC[blocks_unique_def] THEN DISCH_TAC THEN
   REPEAT GEN_TAC THEN STRIP_TAC THEN FIRST_ASSUM MATCH_MP_TAC THEN
   REPEAT CONJ_TAC THEN ASM_MESON_TAC[inc])
### ref_eq_thm
  (REWRITE_TAC[abs_ml_inv_def;
               bc_stack_ref_inv_def] THEN
   STRIP_TAC THEN
   RULE_ASSUM_TAC(REWRITE_RULE[ALL2; v_inv_RefPtr_T; INJ]) THEN
   ASM_MESON_TAC[injectivity "heap_address"])
### num_eq_thm
  (* the roots of two small integers are the words of four times
     them, and such a word determines the integer because four
     times a small one is within the range of the word: an eighth
     part of the dimword times four is half of it *)
  ((* Smallnum as an i2w, which the file proves a few theorems
      later (smallnum_i2w of the source): a section may only name
      what stands before it, so the proof stands here as well *)
   let as_i2w = prove
    (`Smallnum i = i2w ((&4) * i)`,
     REWRITE_TAC[smallnum_def] THEN COND_CASES_TAC THENL
      [REWRITE_TAC[WORD_SUB_LZERO] THEN
       ONCE_REWRITE_TAC[WORD_IWORD] THEN
       REWRITE_TAC[GSYM IWORD_INT_NEG] THEN AP_TERM_TAC THEN
       SUBGOAL_THEN `&0 <= &4 * ((&0) - (i:int))` (fun th ->
         REWRITE_TAC[MATCH_MP INT_OF_NUM_OF_INT th]) THENL
        [ASM_INT_ARITH_TAC; INT_ARITH_TAC];
       ONCE_REWRITE_TAC[WORD_IWORD] THEN AP_TERM_TAC THEN
       MATCH_MP_TAC INT_OF_NUM_OF_INT THEN ASM_INT_ARITH_TAC]) in
   (* four times a small integer is within the range of the word *)
   let bnds = prove
    (`small_int (:'a) i ==>
       --(&2 pow (dimindex (:'a) - 1)) <= (&4) * i /\
       (&4) * i < &2 pow (dimindex (:'a) - 1)`,
     let exp1 = prove
      (`!d. 1 <= d ==> 2 EXP d = 2 * 2 EXP (d - 1)`,
       INDUCT_TAC THEN
       REWRITE_TAC[ARITH_RULE `~(1 <= 0)`; SUC_SUB1; EXP]) in
     let key = prove
      (`4 * (2 EXP (dimindex (:'a)) DIV 8)
        <= 2 EXP (dimindex (:'a) - 1)`,
       MP_TAC(SPECL [`2 EXP (dimindex (:'a))`; `8`] DIVISION) THEN
       REWRITE_TAC[ARITH_EQ] THEN
       MP_TAC(MATCH_MP exp1 (ISPEC `(:'a)` DIMINDEX_GE_1)) THEN
       ARITH_TAC) in
     REWRITE_TAC[small_int_def; dimword] THEN
     MP_TAC key THEN
     REWRITE_TAC[GSYM INT_OF_NUM_POW; GSYM INT_OF_NUM_LE;
                 GSYM INT_OF_NUM_MUL] THEN
     INT_ARITH_TAC) in
   (* so the word of a small integer determines it *)
   let num_eq = prove
    (`small_int (:'a) i1 /\ small_int (:'a) i2 ==>
       ((i1 = i2) <=> (Smallnum i1 = (Smallnum i2:'a word)))`,
     STRIP_TAC THEN
     REWRITE_TAC[as_i2w; GSYM IVAL_EQ] THEN
     ASSUM_LIST(fun ths ->
       REWRITE_TAC(mapfilter
         (fun a -> MATCH_MP IVAL_IWORD (MATCH_MP bnds a)) ths)) THEN
     INT_ARITH_TAC) in
   REWRITE_TAC[abs_ml_inv_def; bc_stack_ref_inv_def] THEN
   STRIP_TAC THEN
   RULE_ASSUM_TRY(REWRITE_RULE[ALL2; v_inv_def]) THEN
   (* the two roots are the words of the integers *)
   FIRST_ASSUM(fun c ->
     if not (is_conj (concl c)) then fail() else
     FIRST_ASSUM(fun s1 -> FIRST_ASSUM(fun s2 ->
       if concl s1 = concl s2 then fail() else
       STRIP_ASSUME_TAC(REWRITE_RULE[s1; s2] c)))) THEN
   ASM_REWRITE_TAC[injectivity "heap_address";
                   injectivity "word_loc"] THEN
   FIRST_ASSUM(fun s1 -> FIRST_ASSUM(fun s2 ->
     if concl s1 = concl s2 then fail() else
     ACCEPT_TAC(MATCH_MP num_eq (CONJ s1 s2)))))
### smallnum_i2w
  (* Smallnum writes the two cases of i2w out: a negative integer
     is the negation of the word of its absolute value, and & of
     the number of a non-negative integer is the integer itself *)
  (REWRITE_TAC[smallnum_def] THEN COND_CASES_TAC THENL
    [REWRITE_TAC[WORD_SUB_LZERO] THEN
     ONCE_REWRITE_TAC[WORD_IWORD] THEN
     REWRITE_TAC[GSYM IWORD_INT_NEG] THEN AP_TERM_TAC THEN
     SUBGOAL_THEN `&0 <= &4 * ((&0) - (i:int))` (fun th ->
       REWRITE_TAC[MATCH_MP INT_OF_NUM_OF_INT th]) THENL
      [ASM_INT_ARITH_TAC; INT_ARITH_TAC];
     ONCE_REWRITE_TAC[WORD_IWORD] THEN AP_TERM_TAC THEN
     MATCH_MP_TAC INT_OF_NUM_OF_INT THEN ASM_INT_ARITH_TAC])
### small_int_IMP_MIN_MAX
  (* the bound of a small integer is a quarter of the dimword and
     INT_MIN and INT_MAX are a half of it, so four times a small
     integer is between them *)
  (REWRITE_TAC[good_dimindex_def; small_int_def;
               dimword; integer_word_INT_MIN; integer_word_INT_MAX;
               INT_MIN] THEN
   STRIP_TAC THEN FIRST_X_ASSUM SUBST_ALL_TAC THEN
   RULE_ASSUM_TAC(CONV_RULE NUM_REDUCE_CONV) THEN
   CONV_TAC NUM_REDUCE_CONV THEN ASM_INT_ARITH_TAC)
### num_less_thm
  (* the words are the i2w of four times the integers, whose
     ival is the integer itself because a small integer times
     four is between INT_MIN and INT_MAX *)
  (let bnds = prove
    (`good_dimindex (:'a) /\ small_int (:'a) i ==>
       --(&2 pow (dimindex (:'a) - 1)) <= (&4) * i /\
       (&4) * i < &2 pow (dimindex (:'a) - 1)`,
     REWRITE_TAC[good_dimindex_def; small_int_def;
                 dimword] THEN
     STRIP_TAC THEN FIRST_X_ASSUM SUBST_ALL_TAC THEN
     RULE_ASSUM_TAC(CONV_RULE NUM_REDUCE_CONV) THEN
     CONV_TAC NUM_REDUCE_CONV THEN
     CONV_TAC(ONCE_DEPTH_CONV INT_POW_CONV) THEN
     ASM_INT_ARITH_TAC) in
   STRIP_TAC THEN
   REWRITE_TAC[smallnum_i2w; word_ilt; irelational2] THEN
   CONV_TAC(DEPTH_CONV BETA_CONV) THEN
   ASSUM_LIST(fun ths ->
     REWRITE_TAC(mapfilter (fun (a,b) ->
       MATCH_MP IVAL_IWORD (MATCH_MP bnds (CONJ a b)))
       (allpairs (fun a b -> (a,b)) ths ths))) THEN
   INT_ARITH_TAC)
### all_ts_permute
  (* the two variables of HOL4's statement, `stack` and `stack'`,
     became one name in the port, so what it states here is that
     the timestamps of a list are the timestamps of that same list
     (see ISSUES.md, "A statement whose two variables became one
     name"): nothing uses it, in the port or in HOL4, and the
     statement is what has to be put right, not the proof *)
  (REWRITE_TAC[])
### reachable_refs_stack_subset
  (* the roots of the one stack are roots of the other, and
     reachable_refs asks for nothing else of them *)
  (REWRITE_TAC[reachable_refs_def] THEN
   REPEAT GEN_TAC THEN REWRITE_TAC[SUBSET; IN_SET_OF_LIST] THEN
   STRIP_TAC THEN ASM_MESON_TAC[])
### MEM_v_all_vs_FST
  (* the head of the list is the pair that holds the value, or the
     value is one of the tail *)
  (LIST_INDUCT_TAC THEN REWRITE_TAC[MAP; MEM] THEN
   REPEAT GEN_TAC THEN
   DISCH_THEN(CONJUNCTS_THEN2 STRIP_ASSUME_TAC ASSUME_TAC) THENL
    [FIRST_X_ASSUM(SUBST_ALL_TAC o SYM) THEN
     REWRITE_TAC[FST] THEN
     MATCH_MP_TAC MEM_v_all_vs_extend_tl THEN
     FIRST_ASSUM ACCEPT_TAC;
     MATCH_MP_TAC MEM_v_all_vs_extend_hd THEN
     FIRST_ASSUM(fun ih -> FIRST_ASSUM(fun a1 ->
       FIRST_ASSUM(fun a2 ->
         ACCEPT_TAC(MATCH_MP ih (CONJ a1 a2)))))])
### MEM_v_all_vs_SUBSET
  (* the head of ys is a pair of xs, so its value is one of the
     values of xs; the tail is the induction hypothesis *)
  (let vnil = prove
    (`v_all_vs ([]:dataSem_v list) = []`,
     GEN_REWRITE_TAC LAND_CONV [v_all_vs_def] THEN
     MATCH_REDUCE_TAC THEN REWRITE_TAC[]) in
   let pairit = CONV_RULE(ONCE_DEPTH_CONV(REWR_CONV(GSYM PAIR))) in
   LIST_INDUCT_TAC THEN REWRITE_TAC[MAP] THENL
    [REWRITE_TAC[vnil; MEM];
     REPEAT GEN_TAC THEN
     DISCH_THEN(CONJUNCTS_THEN2
       (ASSUME_TAC o REWRITE_RULE[SUBSET; IN_SET_OF_LIST; MEM])
       (fun th -> MP_TAC(MATCH_MP MEM_v_all_vs_split th))) THEN
     STRIP_TAC THENL
      [FIRST_X_ASSUM(fun sub ->
         let v,bod = dest_forall(concl sub) in
         let dis = lhand bod in
         let p = rand(lhand dis) in
         ASSUME_TAC(MP (SPEC p sub)
           (DISJ1 (REFL p) (vsubst [p,v] (rand dis))))) THEN
       FIRST_ASSUM(fun m1 -> FIRST_ASSUM(fun m2 ->
         ACCEPT_TAC(MATCH_MP MEM_v_all_vs_FST
           (CONJ (pairit m1) m2))));
       FIRST_X_ASSUM MATCH_MP_TAC THEN CONJ_TAC THENL
        [REWRITE_TAC[SUBSET; IN_SET_OF_LIST] THEN
         GEN_TAC THEN DISCH_TAC THEN
         FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_REWRITE_TAC[];
         FIRST_ASSUM ACCEPT_TAC]]])
### blocks_unique_stack_permute
  (* and a sublist of the pairs has a sublist of the values *)
  (let inc = prove
    (`!refs (ys:(dataSem_v#A)list) xs stack' t a q.
        set_of_list ys SUBSET set_of_list xs /\
        Block t a q IN all_vs refs (APPEND (MAP FST ys) stack') ==>
        Block t a q IN all_vs refs (APPEND (MAP FST xs) stack')`,
     REWRITE_TAC[all_vs_def; IN_UNION; IN_ELIM_THM;
                 v_all_vs_append; MEM_APPEND] THEN
     MESON_TAC[MEM_v_all_vs_SUBSET]) in
   REWRITE_TAC[blocks_unique_def] THEN STRIP_TAC THEN
   REPEAT GEN_TAC THEN STRIP_TAC THEN FIRST_ASSUM MATCH_MP_TAC THEN
   REPEAT CONJ_TAC THEN ASM_MESON_TAC[inc])
### pop_thm
  (* the stack permutation that keeps none of the values that are
     popped: the pairs of the two lists are the ZIP of them *)
  (let pop = prove
    (`!conf (xs:(dataSem_v)list) (rs:(('a word_loc)heap_address)list)
         stack roots heap be a sp sp1 gens limit ts refs.
        abs_ml_inv conf (xs ++ stack) refs
          (rs ++ roots,heap,be,a,sp,sp1,gens) limit ts /\
        LENGTH xs = LENGTH rs
        ==> abs_ml_inv conf stack refs
              (roots,heap,be,a,sp,sp1,gens) limit ts`,
     REPEAT GEN_TAC THEN STRIP_TAC THEN
     MP_TAC(ISPECL
       [`ZIP (xs:(dataSem_v)list)
             (rs:(('a word_loc)heap_address)list)`;
        `[]:(dataSem_v#('a word_loc)heap_address)list`]
       abs_ml_inv_stack_permute) THEN
     ASM_SIMP_TAC[MAP_FST_ZIP; MAP_SND_ZIP; MAP; APPEND;
                  set_of_list; EMPTY_SUBSET]) in
   MATCH_ACCEPT_TAC pop)
### blocks_unique_duplicate
  (* the values of xs ++ xs ++ stack are the values of xs ++ stack *)
  (let inc = prove
    (`!refs xs stack' t a q.
        Block t a q IN all_vs refs (APPEND xs (APPEND xs stack')) ==>
        Block t a q IN all_vs refs (APPEND xs stack')`,
     REWRITE_TAC[all_vs_def; IN_UNION; IN_ELIM_THM;
                 v_all_vs_append; MEM_APPEND] THEN MESON_TAC[]) in
   REWRITE_TAC[blocks_unique_def] THEN DISCH_TAC THEN
   REPEAT GEN_TAC THEN STRIP_TAC THEN FIRST_ASSUM MATCH_MP_TAC THEN
   REPEAT CONJ_TAC THEN ASM_MESON_TAC[inc])
### duplicate_thm
  (* the invariant of the doubled stack: the roots and the
     reachable references are the ones of the stack it doubles,
     blocks_unique_duplicate gives the uniqueness, the timestamps of
     the doubled stack are more and the relation of the values is
     the one of the two parts, which the split of a LIST_REL over an
     append gives *)
  (let gv n =
     W(fun (asl,_) ->
       let tms = itlist (fun (_,th) acc -> union (frees(concl th)) acc)
                   asl [] in
       EXISTS_TAC (find (fun t -> fst(dest_var t) = n) tms)) in
   let rel_app_eq = prove
    (`!(P:A->B->bool) xs1 ys1 xs2 ys2. LENGTH xs1 = LENGTH ys1
        ==> (ALL2 P (xs1 ++ xs2) (ys1 ++ ys2) <=>
             ALL2 P xs1 ys1 /\ ALL2 P xs2 ys2)`,
     GEN_TAC THEN LIST_INDUCT_TAC THEN X_GEN_TAC `ys1:B list` THEN
     STRUCT_CASES_TAC(ISPEC `ys1:B list` list_CASES_v) THEN
     REWRITE_TAC[LENGTH; APPEND; ALL2; NOT_SUC; SUC_INJ;
                 ARITH_RULE `~(SUC n = 0)`;
                 ARITH_RULE `~(0 = SUC n)`] THEN
     REPEAT GEN_TAC THEN DISCH_TAC THEN ASM_SIMP_TAC[] THEN
     CONV_TAC TAUT) in
   let rr_mono = prove
    (`!(as:(dataSem_v)list) bs rfs n.
        (!x. MEM x as ==> MEM x bs) /\ reachable_refs as rfs n
        ==> reachable_refs bs rfs n`,
     REWRITE_TAC[reachable_refs_def] THEN MESON_TAC[]) in
   REWRITE_TAC[abs_ml_inv_def; bc_stack_ref_inv_def] THEN
   STRIP_TAC THEN ASM_REWRITE_TAC[] THEN CONJ_TAC THENL
    [USE_CHANGED [roots_ok_def] THEN
     REWRITE_TAC[roots_ok_def; MEM_APPEND] THEN MESON_TAC[];
     ALL_TAC] THEN
   gv "f" THEN gv "tf" THEN ASM_REWRITE_TAC[] THEN
   REPEAT CONJ_TAC THENL
    [FIRST_ASSUM(fun sub ->
       let t = rand(concl sub) in
       if (try fst(dest_const(fst(strip_comb t))) = "all_ts"
           with Failure _ -> false)
       then MATCH_MP_TAC SUBSET_TRANS THEN EXISTS_TAC t THEN
            CONJ_TAC THENL [ACCEPT_TAC sub; ALL_TAC]
       else fail()) THEN
     REWRITE_TAC[all_ts_def] THEN
     CONV_TAC(TOP_DEPTH_CONV let_CONV) THEN
     REWRITE_TAC[SUBSET; IN_ELIM_THM; MEM_APPEND] THEN
     GEN_TAC THEN MATCH_MP_TAC MONO_EXISTS THEN GEN_TAC THEN
     CONV_TAC TAUT;
     MATCH_MP_TAC blocks_unique_duplicate THEN
     ASM_REWRITE_TAC[];
     W(fun (asl,_) ->
       let eqs = mapfilter (fun (_,th) -> MATCH_MP rel_app_eq th) asl in
       RULE_ASSUM_TAC(REWRITE_RULE eqs) THEN REWRITE_TAC eqs) THEN
     ASM_REWRITE_TAC[];
     GEN_TAC THEN STRIP_TAC THEN
     FIRST_ASSUM MATCH_MP_TAC THEN CONJ_TAC THENL
      [FIRST_ASSUM(fun rr ->
         MATCH_MP_TAC rr_mono THEN
         EXISTS_TAC (rand(rator(rator(concl rr)))) THEN
         CONJ_TAC THENL
          [REWRITE_TAC[MEM_APPEND] THEN GEN_TAC THEN CONV_TAC TAUT;
           ACCEPT_TAC rr]);
       FIRST_ASSUM ACCEPT_TAC]])
### blocks_unique_move
  (* the values of a stack do not depend on the order of its
     three parts *)
  (let inc = prove
    (`!refs xs1 xs2 xs3 stack' t a q.
        Block t a q IN
          all_vs refs (APPEND xs1 (APPEND xs3 (APPEND xs2 stack')))
        ==>
        Block t a q IN
          all_vs refs (APPEND xs1 (APPEND xs2 (APPEND xs3 stack')))`,
     REWRITE_TAC[all_vs_def; IN_UNION; IN_ELIM_THM;
                 v_all_vs_append; MEM_APPEND] THEN MESON_TAC[]) in
   REWRITE_TAC[blocks_unique_def] THEN DISCH_TAC THEN
   REPEAT GEN_TAC THEN STRIP_TAC THEN FIRST_ASSUM MATCH_MP_TAC THEN
   REPEAT CONJ_TAC THEN ASM_MESON_TAC[inc])
### move_thm
  (* the invariant of the stack with its second and third part
     exchanged: nothing of it depends on the order of the parts, so
     each conjunct is the one of the assumption -- the relation of
     the values after splitting it into the four parts, and
     blocks_unique_move for the uniqueness *)
  (let gv n =
     W(fun (asl,_) ->
       let tms = itlist (fun (_,th) acc -> union (frees(concl th)) acc)
                   asl [] in
       EXISTS_TAC (find (fun t -> fst(dest_var t) = n) tms)) in
   let rel_app_eq = prove
    (`!(P:A->B->bool) xs1 ys1 xs2 ys2. LENGTH xs1 = LENGTH ys1
        ==> (ALL2 P (xs1 ++ xs2) (ys1 ++ ys2) <=>
             ALL2 P xs1 ys1 /\ ALL2 P xs2 ys2)`,
     GEN_TAC THEN LIST_INDUCT_TAC THEN X_GEN_TAC `ys1:B list` THEN
     STRUCT_CASES_TAC(ISPEC `ys1:B list` list_CASES_v) THEN
     REWRITE_TAC[LENGTH; APPEND; ALL2; NOT_SUC; SUC_INJ;
                 ARITH_RULE `~(SUC n = 0)`;
                 ARITH_RULE `~(0 = SUC n)`] THEN
     REPEAT GEN_TAC THEN DISCH_TAC THEN ASM_SIMP_TAC[] THEN
     CONV_TAC TAUT) in
   let rr_mono = prove
    (`!(as:(dataSem_v)list) bs rfs n.
        (!x. MEM x as ==> MEM x bs) /\ reachable_refs as rfs n
        ==> reachable_refs bs rfs n`,
     REWRITE_TAC[reachable_refs_def] THEN MESON_TAC[]) in
   REPEAT GEN_TAC THEN
   REWRITE_TAC[abs_ml_inv_def; bc_stack_ref_inv_def] THEN
   STRIP_TAC THEN ASM_REWRITE_TAC[] THEN CONJ_TAC THENL
    [USE_CHANGED [roots_ok_def] THEN
     REWRITE_TAC[roots_ok_def; MEM_APPEND] THEN MESON_TAC[];
     ALL_TAC] THEN
   gv "f" THEN gv "tf" THEN ASM_REWRITE_TAC[] THEN
   REPEAT CONJ_TAC THENL
    [FIRST_ASSUM(fun sub ->
       let t = rand(concl sub) in
       if (try fst(dest_const(fst(strip_comb t))) = "all_ts"
           with Failure _ -> false)
       then MATCH_MP_TAC SUBSET_TRANS THEN EXISTS_TAC t THEN
            CONJ_TAC THENL [ACCEPT_TAC sub; ALL_TAC]
       else fail()) THEN
     REWRITE_TAC[all_ts_def] THEN
     CONV_TAC(TOP_DEPTH_CONV let_CONV) THEN
     REWRITE_TAC[SUBSET; IN_ELIM_THM; MEM_APPEND] THEN
     GEN_TAC THEN MATCH_MP_TAC MONO_EXISTS THEN GEN_TAC THEN
     CONV_TAC TAUT;
     MATCH_MP_TAC blocks_unique_move THEN
     ASM_REWRITE_TAC[];
     W(fun (asl,_) ->
       let eqs = mapfilter (fun (_,th) -> MATCH_MP rel_app_eq th) asl in
       RULE_ASSUM_TAC(REWRITE_RULE eqs) THEN REWRITE_TAC eqs) THEN
     ASM_REWRITE_TAC[];
     GEN_TAC THEN STRIP_TAC THEN
     FIRST_ASSUM MATCH_MP_TAC THEN CONJ_TAC THENL
      [FIRST_ASSUM(fun rr ->
         MATCH_MP_TAC rr_mono THEN
         EXISTS_TAC (rand(rator(rator(concl rr)))) THEN
         CONJ_TAC THENL
          [REWRITE_TAC[MEM_APPEND] THEN GEN_TAC THEN CONV_TAC TAUT;
           ACCEPT_TAC rr]);
       FIRST_ASSUM ACCEPT_TAC]])
### split1_thm
  (REWRITE_TAC[abs_ml_inv_def; bc_stack_ref_inv_def;
               LIST_REL_SPLIT1] THEN
   STRIP_TAC THEN ASM_MESON_TAC[LIST_REL_LENGTH])
### split2_thm
  (REWRITE_TAC[abs_ml_inv_def; bc_stack_ref_inv_def;
               GSYM APPEND_ASSOC; LIST_REL_SPLIT1] THEN
   STRIP_TAC THEN ASM_MESON_TAC[LIST_REL_LENGTH])
### split3_thm
  (REWRITE_TAC[abs_ml_inv_def; bc_stack_ref_inv_def;
               GSYM APPEND_ASSOC; LIST_REL_SPLIT1] THEN
   STRIP_TAC THEN ASM_MESON_TAC[LIST_REL_LENGTH])
### abs_ml_inv_Num
  (* the new root is a Data, so the roots stay ok; the value has no
     refs and no timestamps of its own, so what the stack reaches
     and what the timestamps are stay as they are, and v_inv of a
     small Number is its Smallnum *)
  (let gr0 = CONJUNCT1 get_refs_def in
  let reach = prove
   (`!(sk:(dataSem_v)list) rfs n i.
       reachable_refs (Number i :: sk) rfs n
       ==> reachable_refs sk rfs n`,
    REWRITE_TAC[reachable_refs_def; MEM] THEN
    MESON_TAC[gr0; MEM]) in
  REWRITE_TAC[abs_ml_inv_def; bc_stack_ref_inv_def] THEN
  DISCH_THEN(CONJUNCTS_THEN2 STRIP_ASSUME_TAC ASSUME_TAC) THEN
  REPEAT CONJ_TAC THEN TRY(FIRST_ASSUM MATCH_ACCEPT_TAC) THENL
   [RULE_ASSUM_TAC(REWRITE_RULE[roots_ok_def]) THEN
    REWRITE_TAC[roots_ok_def; MEM;
                distinctness "heap_address"] THEN
    FIRST_ASSUM MATCH_ACCEPT_TAC;
    MAP_EVERY EXISTS_TAC [`f:(num,num)fmap`; `tf:(num,num)fmap`] THEN
    REPEAT CONJ_TAC THEN TRY(FIRST_ASSUM MATCH_ACCEPT_TAC) THENL
     [(fun (asl,w) ->
        let ats = rand w in
        let wit = mk_comb(rator ats, rand(rand ats)) in
        (MATCH_MP_TAC SUBSET_TRANS THEN EXISTS_TAC wit) (asl,w)) THEN
      ASM_REWRITE_TAC[] THEN
      MATCH_MP_TAC all_ts_SUBSET_gen THEN
      REWRITE_TAC[MEM] THEN GEN_TAC THEN
      DISCH_THEN(DISJ_CASES_THEN2
        (fun p -> DISJ1_TAC THEN ACCEPT_TAC p)
        (fun m -> DISJ2_TAC THEN DISJ2_TAC THEN ACCEPT_TAC m));
      MATCH_MP_TAC (INST [`[]:(dataSem_v)list`,`ws:(dataSem_v)list`]
        blocks_unique_Number) THEN
      ASM_REWRITE_TAC[APPEND];
      REWRITE_TAC[ALL2] THEN ASM_REWRITE_TAC[] THEN
      REWRITE_TAC[v_inv_def] THEN ASM_REWRITE_TAC[];
      X_GEN_TAC `nn:num` THEN STRIP_TAC THEN
      FIRST_ASSUM MATCH_MP_TAC THEN CONJ_TAC THENL
       [FIRST_ASSUM(fun rr -> MATCH_ACCEPT_TAC(MATCH_MP reach rr));
        FIRST_ASSUM MATCH_ACCEPT_TAC]]])
### heap_store_unused_IMP_length
  (* the lookup splits the heap at the unused element, the store
     lemma says what the store gives back, and the lengths add up *)
  (REWRITE_TAC[heap_store_unused_def] THEN
   COND_CASES_TAC THENL
    [FIRST_X_ASSUM STRIP_ASSUME_TAC THEN
     FIRST_ASSUM(fun th -> MP_TAC(MATCH_MP heap_lookup_SPLIT th)) THEN
     DISCH_THEN STRIP_ASSUME_TAC THEN VAR_EQ_TAC THEN
     ASM_REWRITE_TAC[heap_store_lemma; PAIR_EQ] THEN
     STRIP_TAC THEN VAR_EQ_TAC THEN
     ASM_REWRITE_TAC[heap_length_APPEND; heap_length_CONS] THEN
     ASM_ARITH_TAC;
     REWRITE_TAC[PAIR_EQ] THEN STRIP_TAC THEN ASM_REWRITE_TAC[]])
### heap_store_unused_alt_IMP_length
  (REWRITE_TAC[heap_store_unused_alt_def] THEN
   COND_CASES_TAC THENL
    [FIRST_X_ASSUM STRIP_ASSUME_TAC THEN
     FIRST_ASSUM(fun th -> MP_TAC(MATCH_MP heap_lookup_SPLIT th)) THEN
     DISCH_THEN STRIP_ASSUME_TAC THEN VAR_EQ_TAC THEN
     ASM_REWRITE_TAC[heap_store_lemma; PAIR_EQ] THEN
     STRIP_TAC THEN VAR_EQ_TAC THEN
     ASM_REWRITE_TAC[heap_length_APPEND; heap_length_CONS] THEN
     ASM_ARITH_TAC;
     REWRITE_TAC[PAIR_EQ] THEN STRIP_TAC THEN ASM_REWRITE_TAC[]])
### data_to_word_memoryProof_b2w_def
  (REWRITE_TAC[b2w_def; b2n_def])
### word_payload_T_IMP
  (* the six tags each give a header of make_header or of
     make_byte_header, and the third component of the payload says
     what the length is.  The bit two of a header is the bit zero of
     its tag, because the length sits above the bit two (the length
     size and two are below the dimindex) and the three at the
     bottom has the bit two clear; of make_byte_header it is set,
     whichever of the two tags it takes *)
  (let hdr_bit2 = prove
    (`!conf tg len.
        data_to_word_config_len_size conf + 2 < dimindex (:'a)
        ==> (word_bit 2 (make_header conf (tg:'a word) len) <=>
             word_bit 0 tg)`,
     REPEAT GEN_TAC THEN DISCH_TAC THEN
     FIRST_ASSUM(fun th ->
       ASSUME_TAC(MATCH_MP
         (ARITH_RULE `k + 2 < d ==> 2 < d`) th)) THEN
     REWRITE_TAC[make_header_def] THEN
     CONV_TAC(TOP_DEPTH_CONV let_CONV) THEN
     REWRITE_TAC[BIT_WORD_OR; BIT_WORD_SHL; BIT_WORD] THEN
     CONV_TAC NUM_REDUCE_CONV THEN
     ASM_SIMP_TAC[ARITH_RULE `k + 2 < d ==> ~(d - k <= 2)`] THEN
     ASM_REWRITE_TAC[]) in
   let byte_hdr_bit2 = prove
    (`!conf fl n. 2 < dimindex (:'a)
        ==> word_bit 2 (make_byte_header conf fl n:'a word)`,
     REPEAT GEN_TAC THEN DISCH_TAC THEN
     REWRITE_TAC[make_byte_header_def] THEN
     CONV_TAC(TOP_DEPTH_CONV let_CONV) THEN
     REPEAT COND_CASES_TAC THEN
     ASM_REWRITE_TAC[BIT_WORD_OR; BIT_WORD] THEN
     CONV_TAC NUM_REDUCE_CONV THEN ASM_REWRITE_TAC[]) in
   STRIP_TAC THEN
   FIRST_ASSUM(fun th ->
     ASSUME_TAC(MATCH_MP (ARITH_RULE `k + 2 < d ==> 2 < d`) th) THEN
     ASSUME_TAC(MATCH_MP (ARITH_RULE `k + 2 < d ==> 0 < d`) th)) THEN
   CASES_ON_NAME "tag" THEN
   RULE_ASSUM_TAC(REWRITE_RULE[word_payload_def; PAIR_EQ;
                               EQ_CLAUSES]) THEN
   REPEAT(FIRST_X_ASSUM(CONJUNCTS_THEN ASSUME_TAC)) THEN
   REPEAT(FIRST_X_ASSUM(fun th ->
     let c = concl th in
     if is_eq c && is_var(rand c) && not(is_var(lhand c))
     then SUBST_ALL_TAC(SYM th) else fail())) THEN
   ASM_SIMP_TAC[hdr_bit2; byte_hdr_bit2; LENGTH_MAP; BIT_WORD_SHL;
                BIT_WORD; BIT_WORD_OR] THEN
   CONV_TAC NUM_REDUCE_CONV THEN ASM_REWRITE_TAC[])
### gen_starts_in_store_IMP
  (CASES_ON_NAME "x" THEN CASES_ON_NAME "gens" THEN
   REWRITE_TAC[gen_starts_in_store_def] THEN
   SAFE_MATCH_REDUCE_TAC THEN REWRITE_TAC[] THEN
   TRY(CASES_ON_NAME "a" THEN
       REWRITE_TAC[gen_starts_in_store_def] THEN
       SAFE_MATCH_REDUCE_TAC THEN REWRITE_TAC[]) THEN
   MESON_TAC[])
### IMP_THE_EQ
  (DISCH_THEN SUBST1_TAC THEN REWRITE_TAC[THE])
### EVERY2_MAP_MAP
  (let aux = prove
    (`!(P:B->C->bool) f g (xs:A list).
        ALL2 P (MAP f xs) (MAP g xs) <=> ALL (\x. P (f x) (g x)) xs`,
     GEN_TAC THEN GEN_TAC THEN GEN_TAC THEN LIST_INDUCT_TAC THEN
     ASM_REWRITE_TAC[MAP; ALL2; ALL]) in
   REPEAT GEN_TAC THEN MATCH_ACCEPT_TAC aux)
### MEM_FIRST_EL
  (* a member of a list is at some index, and the least such index
     is one where no earlier element is that element *)
  (let lemma = prove
    (`!(xs:A list) x.
        MEM x xs <=>
        (?n. n < LENGTH xs /\ EL n xs = x /\
             (!m. m < n ==> ~(EL m xs = EL n xs)))`,
     REPEAT GEN_TAC THEN EQ_TAC THENL
      [DISCH_TAC THEN
       MP_TAC(SPEC `\n. n < LENGTH (xs:A list) /\ EL n xs = x`
         num_WOP) THEN
       REWRITE_TAC[] THEN
       DISCH_THEN(MP_TAC o fst o EQ_IMP_RULE) THEN
       ANTS_TAC THENL
        [FIRST_X_ASSUM(MP_TAC o REWRITE_RULE[MEM_EXISTS_EL]) THEN
         MESON_TAC[];
         ALL_TAC] THEN
       DISCH_THEN(X_CHOOSE_THEN `n:num` STRIP_ASSUME_TAC) THEN
       EXISTS_TAC `n:num` THEN ASM_REWRITE_TAC[] THEN
       X_GEN_TAC `m:num` THEN DISCH_TAC THEN
       FIRST_X_ASSUM(MP_TAC o SPEC `m:num`) THEN
       ASM_REWRITE_TAC[] THEN
       MATCH_MP_TAC(TAUT `p ==> (~(p /\ q) ==> ~q)`) THEN
       ASM_ARITH_TAC;
       DISCH_THEN(X_CHOOSE_THEN `n:num` STRIP_ASSUME_TAC) THEN
       REWRITE_TAC[MEM_EXISTS_EL] THEN EXISTS_TAC `n:num` THEN
       ASM_REWRITE_TAC[]]) in
   MATCH_ACCEPT_TAC lemma)
### ALOOKUP_ZIP_EL
  (* the lookup of the nth key walks past the n keys before it,
     which the hypothesis says are not that key, and the pair that
     the zip has there is the nth key with the nth value *)
  (let split = prove
    (`!(h:A) t k. (!m. m < SUC k ==> ~(EL m (CONS h t) = EL k t))
        ==> ~(h = EL k t) /\ (!m. m < k ==> ~(EL m t = EL k t))`,
     REPEAT GEN_TAC THEN DISCH_TAC THEN CONJ_TAC THENL
      [FIRST_X_ASSUM(MP_TAC o SPEC `0`) THEN
       REWRITE_TAC[LT_0; EL; HD];
       GEN_TAC THEN DISCH_TAC THEN
       FIRST_X_ASSUM(MP_TAC o SPEC `SUC m`) THEN
       REWRITE_TAC[EL; TL; LT_SUC] THEN ASM_REWRITE_TAC[]]) in
   LIST_INDUCT_TAC THENL
    [REWRITE_TAC[LENGTH; ARITH_RULE `((n:num) < 0) <=> F`];
     (fun (asl,w as gl) ->
        let hsv = fst(dest_forall w) in
        (X_GEN_TAC hsv THEN
         STRUCT_CASES_TAC(ISPEC hsv list_CASES_v)) gl) THEN
     GEN_TAC THEN
     STRUCT_CASES_TAC(ISPEC `n:num` num_CASES) THEN
     REWRITE_TAC[LENGTH; ZIP; ALOOKUP; EL; HD; TL; FST; SND;
                 ARITH_RULE `(0 = SUC n) <=> F`;
                 ARITH_RULE `(SUC n = 0) <=> F`] THEN
     TRY(CONV_TAC TAUT) THEN
     STRIP_TAC THEN
     FIRST_ASSUM(fun th -> STRIP_ASSUME_TAC (MATCH_MP split th)) THEN
     ASM_REWRITE_TAC[] THEN
     FIRST_X_ASSUM MATCH_MP_TAC THEN
     REPEAT CONJ_TAC THEN TRY ASM_ARITH_TAC THEN
     ASM_REWRITE_TAC[]])
### memory_rel_rearrange
  (* the witnesses of the goal's existential are the ones the
     assumption has: HOL4's asm_exists_tac, ml/lib/tactics.ml *)
  (REWRITE_TAC[memory_rel_def] THEN REPEAT STRIP_TAC THEN
   ASM_EXISTS_TAC THEN ASM_REWRITE_TAC[] THEN
   FIRST_X_ASSUM(fun th -> MP_TAC th THEN
     MATCH_MP_TAC word_ml_inv_rearrange) THEN
   ASM_REWRITE_TAC[])
### memory_rel_tl
  (* the source's match_mp_tac takes the lemma's second antecedent
     for the goal's; HOL Light's takes the conclusion, so the two
     antecedents are swapped first and the assumption discharges
     the one that says what the memory holds *)
  (DISCH_TAC THEN
   FIRST_ASSUM(fun th ->
     MATCH_MP_TAC(MATCH_MP
       (ONCE_REWRITE_RULE[TAUT `(p ==> q ==> r) <=> (q ==> p ==> r)`]
          memory_rel_rearrange) th)) THEN
   REWRITE_TAC[MEM] THEN MESON_TAC[])
### word_ml_inv_Unit
  (* Unit is the empty Block of the tuple tag, which cons_thm_EMPTY
     puts on the stack with the root Data (Word (BlockNil 0)), and
     that word is two, whose lowest bit word_addr takes off *)
  (let blocknil0 = prove
    (`BlockNil 0 = (n2w 2:'a word)`,
     REWRITE_TAC[BlockNil_def] THEN CONV_TAC WORD_RULE) in
   let and2 = prove
    (`(n2w 2:(N)word) && word_not (n2w 1) = n2w 2`,
     WORD_NUM_BIT_TAC 2) in
   let dimword16 = prove
    (`good_dimindex (:'a) ==> 0 < dimword (:'a) DIV 16`,
     REWRITE_TAC[good_dimindex_def; dimword] THEN
     DISCH_THEN(DISJ_CASES_THEN SUBST1_TAC) THEN
     CONV_TAC NUM_REDUCE_CONV) in
   let waddr = hd (word_addr_clauses ()) in
   let cons0 = REWRITE_RULE[blocknil0]
     (INST [`0`,`tag:num`] cons_thm_EMPTY) in
   REWRITE_TAC[word_ml_inv_def] THEN REPEAT STRIP_TAC THEN
   EXISTS_TAC
     `CONS (gc_shared_Data (wordLang_Word (n2w 2:'a word))) hs` THEN
   REWRITE_TAC[MAP; ALL2; waddr; and2] THEN
   ASM_REWRITE_TAC[dataSem_Unit_def;
                   tuple_tag_def] THEN
   MATCH_MP_TAC cons0 THEN
   ASM_SIMP_TAC[dimword16])
### memory_rel_Unit
  (REWRITE_TAC[memory_rel_def] THEN REPEAT STRIP_TAC THEN
   ASM_EXISTS_TAC THEN ASM_REWRITE_TAC[] THEN
   MATCH_MP_TAC word_ml_inv_Unit THEN ASM_REWRITE_TAC[])
### get_lowerbits_LSL_shift_length
  (* the lower bits are below small_shift_length, which is below
     shift_length, so the shift leaves nothing *)
  (CASES_ON_NAME "a" THEN
   REWRITE_TAC[get_lowerbits_def] THEN MATCH_REDUCE_TAC THEN
   REWRITE_TAC[WORD_EQ_BITS_ALT; BIT_WORD_0; BIT_WORD_USHR;
               BIT_WORD_OR; BIT_WORD_1; word_bits; BIT_WORD_SUBWORD;
               small_shift_length_def;
               shift_length_def] THEN
   REPEAT STRIP_TAC THEN ASM_ARITH_TAC)
### or_1
  (* the lowest bit of a word, or one, is one *)
  (GEN_TAC THEN
   REWRITE_TAC[WORD_EQ_BITS_ALT; BIT_WORD_OR; word_bits;
               BIT_WORD_SUBWORD; BIT_WORD_1] THEN
   X_GEN_TAC `i:num` THEN DISCH_TAC THEN
   CONV_TAC NUM_REDUCE_CONV THEN
   ASM_CASES_TAC `i = 0` THEN ASM_REWRITE_TAC[] THEN
   CONV_TAC NUM_REDUCE_CONV THEN
   TRY(REWRITE_TAC[ARITH_RULE `0 < d <=> 1 <= d`; DIMINDEX_GE_1]) THEN
   POP_ASSUM_LIST(fun ths -> MAP_EVERY MP_TAC ths) THEN ARITH_TAC)
### get_real_offset_thm
  (* the offset of an index is four times it, which a dimindex of
     32 adds to the bytes in a word as it stands and one of 64
     doubles first *)
  (let shl1 = prove
    (`!(v:(N)word). word_shl v 1 = word 2 * v`,
     REWRITE_TAC[word_shl; GSYM VAL_EQ; VAL_WORD_MUL; VAL_WORD] THEN
     CONV_TAC MOD_DOWN_CONV THEN CONV_TAC NUM_REDUCE_CONV THEN
     REWRITE_TAC[MULT_AC]) in
   REWRITE_TAC[good_dimindex_def; get_real_offset_def;
               bytes_in_word_def] THEN
   DISCH_THEN(DISJ_CASES_THEN SUBST1_TAC) THEN
   CONV_TAC NUM_REDUCE_CONV THEN
   REWRITE_TAC[injectivity "option"; shl1; WORD_MUL] THEN
   CONV_TAC WORD_RULE)
### word_heap_APPEND
  (* the address of the second half is the first address shifted by
     the length of the first half, which is a word ring identity *)
  (LIST_INDUCT_TAC THEN
   ASM_REWRITE_TAC[APPEND; word_heap_def; heap_length_NIL;
                   heap_length_CONS; emp_STAR; STAR_ASSOC;
                   WORD_ADD_MUL_SPLIT; WORD_ADD_MUL_0])
### data_to_word_memoryProof_FORALL_WORD
  (EQ_TAC THEN REPEAT STRIP_TAC THEN ASM_REWRITE_TAC[] THEN
   ONCE_REWRITE_TAC[GSYM WORD_VAL] THEN
   FIRST_X_ASSUM MATCH_MP_TAC THEN
   REWRITE_TAC[dimword; VAL_BOUND])
### BlockNil_and_lemma
  (* sixteen times a word has its four lowest bits clear, so the
     and with the complement of one leaves it alone; the port reads
     the statement as the and of that complement with the multiple
     of sixteen, and HOL4 as the and with the sum, because the two
     give the bitwise operators another precedence (see ISSUES.md,
     "The precedence of a word's bitwise operators") -- both are
     true, and this is the one the port states *)
  (let shl16 = prove
    (`!(v:(N)word). word 16 * v = word_shl v 4`,
     REWRITE_TAC[word_shl; GSYM VAL_EQ; VAL_WORD_MUL; VAL_WORD] THEN
     CONV_TAC MOD_DOWN_CONV THEN CONV_TAC NUM_REDUCE_CONV THEN
     REWRITE_TAC[MULT_AC]) in
   let not1 = WORD_RULE `--(word 2):(N)word = word_not (word 1)` in
   DISCH_TAC THEN
   REWRITE_TAC[shl16; not1] THEN
   AP_THM_TAC THEN AP_TERM_TAC THEN
   REWRITE_TAC[WORD_EQ_BITS_ALT; BIT_WORD_AND; BIT_WORD_NOT;
               BIT_WORD_1; BIT_WORD_SHL] THEN
   X_GEN_TAC `i:num` THEN DISCH_TAC THEN
   ASM_CASES_TAC `(i:num) = 0` THEN ASM_REWRITE_TAC[] THEN
   CONV_TAC NUM_REDUCE_CONV THEN TRY(CONV_TAC TAUT))
### word_ml_inv_num_lemma
  (* four times a word has its two lowest bits clear, and -2 is the
     complement of 1, which has only the lowest *)
  (let shl4 = prove
    (`!(v:(N)word). word 4 * v = word_shl v 2`,
     REWRITE_TAC[word_shl; GSYM VAL_EQ; VAL_WORD_MUL; VAL_WORD] THEN
     CONV_TAC MOD_DOWN_CONV THEN CONV_TAC NUM_REDUCE_CONV THEN
     REWRITE_TAC[MULT_AC]) in
   let neg2 = prove
    (`word_neg (word 2):(N)word = word_not (word 1)`,
     CONV_TAC WORD_RULE) in
   DISCH_TAC THEN
   REWRITE_TAC[neg2; shl4] THEN
   REWRITE_TAC[WORD_EQ_BITS_ALT; BIT_WORD_AND; BIT_WORD_NOT;
               BIT_WORD_1; BIT_WORD_SHL] THEN
   REPEAT STRIP_TAC THEN ASM_CASES_TAC `2 <= i` THEN
   ASM_REWRITE_TAC[] THEN
   ASM_SIMP_TAC[ARITH_RULE `2 <= i ==> ~(i = 0)`])
### word_ml_inv_num
  (* a small enough integer as a root of word_ml_inv: its root is
     the Data of its Smallnum, which abs_ml_inv_Num adds to the
     roots of the abs_ml_inv, and word_addr of that Data is four
     times the integer, because Smallnum of a natural number is
     four times it and the and with the complement of one leaves
     such a word alone *)
  (let hd_is n t =
      (try fst(dest_const(fst(strip_comb t))) = n
       with Failure _ -> false) in
    let grab asl p =
      tryfind (fun (_,th) ->
        if (try p th with Failure _ -> false) then th else fail())
        asl in
    let smn = prove
     (`!n. Smallnum (&n) = (n2w (4 * n)):(N)word`,
      GEN_TAC THEN REWRITE_TAC[smallnum_def] THEN
      REWRITE_TAC[INT_ARITH `~((&n:int) < &0)`] THEN
      REWRITE_TAC[INT_OF_NUM_MUL; NUM_OF_INT_OF_NUM]) in
    let and4 = prove
     (`!n. word_and (n2w (4 * n)) (word_not (word 1)) =
           (n2w (4 * n)):(N)word`,
      GEN_TAC THEN
      REWRITE_TAC[WORD_EQ_BITS_ALT; BIT_WORD_AND; BIT_WORD_NOT;
                  BIT_WORD_1] THEN
      X_GEN_TAC `i:num` THEN DISCH_TAC THEN
      ASM_CASES_TAC `(i:num) = 0` THEN ASM_REWRITE_TAC[] THEN
      TRY(REWRITE_TAC[BIT_WORD; EXP; DIV_1; ODD_MULT] THEN
        CONV_TAC NUM_REDUCE_CONV THEN NO_TAC) THEN
      TRY(CONV_TAC TAUT)) in
    REWRITE_TAC[word_ml_inv_def] THEN
    DISCH_THEN(REPEAT_TCL CONJUNCTS_THEN ASSUME_TAC) THEN
    FIRST_X_ASSUM(fun th ->
      if is_exists (concl th) then STRIP_ASSUME_TAC th else fail()) THEN
    SUBGOAL_THEN `small_int (:'a) (&n)` ASSUME_TAC THENL
     [FIRST_X_ASSUM(fun se ->
        if hd_is "small_enough_int" (concl se) then MP_TAC se
        else fail()) THEN
      FIRST_ASSUM(fun gd ->
        if hd_is "good_dimindex" (concl gd)
        then MP_TAC(REWRITE_RULE[good_dimindex_def] gd)
        else fail()) THEN
      REWRITE_TAC[small_enough_int_def;
                  small_int_def; dimword] THEN
      DISCH_THEN(DISJ_CASES_THEN SUBST1_TAC) THEN
      CONV_TAC NUM_REDUCE_CONV THEN INT_ARITH_TAC;
      ALL_TAC] THEN
    W(fun (asl,w) ->
      let am = grab asl (fun th -> hd_is "abs_ml_inv" (concl th)) in
      let si = grab asl (fun th -> hd_is "small_int" (concl th)) in
      let nw = MATCH_MP abs_ml_inv_Num (CONJ am si) in
      ASSUME_TAC nw THEN
      EXISTS_TAC
        (fst(dest_pair (el 3 (snd(strip_comb (concl nw))))))) THEN
    ASM_REWRITE_TAC[MAP; FST; SND; ALL2] THEN
    REWRITE_TAC(word_addr_clauses () @ [smn; and4]))
### word_ml_inv_neg_num_lemma
  (* and so does minus four times a word *)
  (let shl4 = prove
    (`!(v:(N)word). word 4 * v = word_shl v 2`,
     REWRITE_TAC[word_shl; GSYM VAL_EQ; VAL_WORD_MUL; VAL_WORD] THEN
     CONV_TAC MOD_DOWN_CONV THEN CONV_TAC NUM_REDUCE_CONV THEN
     REWRITE_TAC[MULT_AC]) in
   let neg2 = prove
    (`word_neg (word 2):(N)word = word_not (word 1)`,
     CONV_TAC WORD_RULE) in
   let nshl4 = prove
    (`!(v:(N)word). word_neg (word 4) * v = word_shl (word_neg v) 2`,
     REWRITE_TAC[GSYM shl4] THEN CONV_TAC WORD_RULE) in
   DISCH_TAC THEN
   REWRITE_TAC[neg2; nshl4] THEN
   REWRITE_TAC[WORD_EQ_BITS_ALT; BIT_WORD_AND; BIT_WORD_NOT;
               BIT_WORD_1; BIT_WORD_SHL] THEN
   REPEAT STRIP_TAC THEN ASM_CASES_TAC `2 <= i` THEN
   ASM_REWRITE_TAC[] THEN
   ASM_SIMP_TAC[ARITH_RULE `2 <= i ==> ~(i = 0)`])
### word_ml_inv_neg_num
  (* the root of a negative small number is the Data of its
     Smallnum, which is minus four times the number; its two lowest
     bits are clear, so the complement of one takes nothing off, and
     abs_ml_inv_Num adds the Number to the stack once the bound of
     small_enough_int gives the one of small_int *)
  (
   let waddr = hd (word_addr_clauses ()) in
   let smallneg = prove
    (`~(n = 0) ==> Smallnum (--(&n)) = --(n2w (4 * n)):'a word`,
     DISCH_TAC THEN REWRITE_TAC[smallnum_def] THEN
     SUBGOAL_THEN `--(&n) < (&0:int)` (fun th -> REWRITE_TAC[th]) THENL
      [SUBGOAL_THEN `(&0:int) < &n` MP_TAC THENL
        [REWRITE_TAC[INT_OF_NUM_LT] THEN ASM_ARITH_TAC;
         INT_ARITH_TAC];
       ALL_TAC] THEN
     SUBGOAL_THEN `num_of_int (&4 * (&0 - --(&n))) = 4 * n`
       SUBST1_TAC THENL
      [REWRITE_TAC[INT_ARITH `&0 - --(&n) = &n:int`;
                   INT_OF_NUM_MUL; NUM_OF_INT_OF_NUM];
       CONV_TAC WORD_RULE]) in
   let andneg = prove
    (`(--(n2w (4 * n)):(N)word) && word_not (n2w 1) =
       --(n2w (4 * n))`,
     let shl4 = prove
      (`!(v:(N)word). word 4 * v = word_shl v 2`,
       REWRITE_TAC[word_shl; GSYM VAL_EQ; VAL_WORD_MUL; VAL_WORD] THEN
       CONV_TAC MOD_DOWN_CONV THEN CONV_TAC NUM_REDUCE_CONV THEN
       REWRITE_TAC[MULT_AC]) in
     let nshl = prove
      (`!(k:num). --(n2w (4 * k)):(N)word = word_shl (--(n2w k)) 2`,
       GEN_TAC THEN REWRITE_TAC[GSYM shl4] THEN CONV_TAC WORD_RULE) in
     let and_shl = prove
      (`!(v:(N)word). word_shl v 2 && word_not (word 1) =
                      word_shl v 2`,
       REWRITE_TAC[WORD_EQ_BITS_ALT; BIT_WORD_AND; BIT_WORD_NOT;
                   BIT_WORD_1; BIT_WORD_SHL] THEN
       REPEAT STRIP_TAC THEN ASM_CASES_TAC `2 <= i` THEN
       ASM_REWRITE_TAC[] THEN
       ASM_SIMP_TAC[ARITH_RULE `2 <= i ==> ~(i = 0)`]) in
     ONCE_REWRITE_TAC[nshl] THEN MATCH_ACCEPT_TAC and_shl) in
   let smalln = prove
    (`good_dimindex (:'a) /\ small_enough_int (--(&n))
        ==> small_int (:'a) (--(&n))`,
     REWRITE_TAC[good_dimindex_def; small_int_def;
                 small_enough_int_def; dimword] THEN
     DISCH_THEN(CONJUNCTS_THEN2
       (DISJ_CASES_THEN SUBST1_TAC) MP_TAC) THEN
     CONV_TAC NUM_REDUCE_CONV THEN INT_ARITH_TAC) in
   REWRITE_TAC[word_ml_inv_def] THEN REPEAT STRIP_TAC THEN
   EXISTS_TAC
     `CONS (gc_shared_Data (wordLang_Word
        (Smallnum (--(&n)):'a word))) hs` THEN
   REWRITE_TAC[MAP; ALL2; waddr] THEN REPEAT CONJ_TAC THENL
    [MATCH_MP_TAC abs_ml_inv_Num THEN
     ASM_SIMP_TAC[smalln];
     ASM_SIMP_TAC[smallneg] THEN REWRITE_TAC[andneg];
     FIRST_ASSUM ACCEPT_TAC])
### word_list_APPEND
  (LIST_INDUCT_TAC THEN
   ASM_REWRITE_TAC[APPEND; word_list_def; LENGTH;
                   emp_STAR; STAR_ASSOC; WORD_ADD_SUC_MUL;
                   WORD_ADD_0_MUL])
### all_ts_head_eq
  (* a value that the refs or the stack already hold adds no
     timestamp to the stack, which is what MEM_in_all_ts says of
     the value itself and all_ts_head of the head of a stack *)
  (REPEAT GEN_TAC THEN DISCH_TAC THEN
   ONCE_REWRITE_TAC[all_ts_head] THEN
   MATCH_MP_TAC(SET_RULE `s SUBSET t ==> t = s UNION t`) THEN
   REWRITE_TAC[SUBSET] THEN X_GEN_TAC `u:num` THEN
   REWRITE_TAC[all_ts_def] THEN
   CONV_TAC(TOP_DEPTH_CONV let_CONV) THEN
   REWRITE_TAC[IN_ELIM_THM; MEM] THEN
   DISCH_THEN(X_CHOOSE_THEN `y:dataSem_v`
     (CONJUNCTS_THEN2
        (DISJ_CASES_THEN2 ASSUME_TAC (SUBST_ALL_TAC o SYM))
        ASSUME_TAC)) THENL
    [EXISTS_TAC `y:dataSem_v` THEN ASM_REWRITE_TAC[];
     MP_TAC(SPECL [`y:dataSem_v`; `u:num`; `stack':(dataSem_v)list`;
                   `refs:(dataSem_v bvlSem_ref) spt`]
       MEM_in_all_ts) THEN
     ASM_REWRITE_TAC[] THEN
     REWRITE_TAC[all_ts_def] THEN
     CONV_TAC(TOP_DEPTH_CONV let_CONV) THEN
     REWRITE_TAC[IN_ELIM_THM]])
### memory_rel_El'
  (let hd_is n t =
   (try fst(dest_const(fst(strip_comb t))) = n
    with Failure _ -> false) in
 let rec facs t =
   if hd_is "STAR" t then
     let args = snd(strip_comb t) in
     facs (el 0 args) @ facs (el 1 args)
   else [t] in
 let rec remove1 t = function
     [] -> []
   | h :: rest -> if h = t then rest else h :: remove1 t rest in
 let grab asl p =
   tryfind (fun (_,th) ->
     if (try p th with Failure _ -> false) then th else fail())
     asl in
 let is_hl th = hd_is "heap_lookup" (lhs (concl th)) in
 let swapmul a =
   let args = snd(strip_comb (rand a)) in
   let mul = fst(strip_comb (rand a)) in
   mk_comb(rator a, mk_comb(mk_comb(mul,el 1 args),el 0 args)) in
 let realaddr =
   W(fun (asl,w) ->
     let hl = grab asl is_hl in
     let hlen = grab asl (fun th ->
       hd_is "heap_length" (lhand (concl th))) in
     let cu = grab asl (fun th ->
       hd_is "FLOOKUP" (lhs (concl th)) &&
       fst(dest_const(rand(lhs(concl th)))) = "CurrHeap") in
     let gd = grab asl (fun th ->
       hd_is "good_dimindex" (concl th)) in
     let gat = tryfind (fun t ->
       find_term (fun u ->
         hd_is "get_addr" u && length (snd(strip_comb u)) = 3) t)
       (w :: map (fun (_,th) -> concl th) asl) in
     let mm = MATCH_MP get_real_addr_get_addr
                (CONJ hlen (CONJ hl (CONJ cu gd))) in
     let wv = find (fun v -> fst(dest_var v) = "w")
                (frees (concl mm)) in
     let th = SPEC (last (snd(strip_comb gat))) (GEN wv mm) in
     let a = rand (rhs (concl (CONJUNCT1 th))) in
     EXISTS_TAC (swapmul a) THEN
     STRIP_ASSUME_TAC(REWRITE_RULE[WORD_RULE (mk_eq(a,swapmul a))]
                        th)) in
   let all2cons = prove
    (`!P h t (l:(A)list).
        ALL2 P l (CONS (h:B) t) <=>
        ?a b. l = CONS a b /\ P a h /\ ALL2 P b t`,
     REPEAT GEN_TAC THEN
     STRUCT_CASES_TAC(ISPEC `l:(A)list` list_CASES) THEN
     REWRITE_TAC[ALL2; NOT_CONS_NIL; CONS_11] THEN MESON_TAC[]) in
   let addreq = WORD_RULE
     `!(a:(N)word) i.
        (a + bytes_in_word) + n2w i * bytes_in_word =
        a + bytes_in_word + bytes_in_word * n2w i` in
   (* the element of a heap that an address and an index name *)
   let heapel = prove
    (`!a u n (heap:(('a,'b)heap_element)list) xs l d y.
        heap_lookup a heap = SOME (DataElement xs l d) /\
        n < LENGTH xs /\
        heap_el (gc_shared_Pointer a u) n heap = (y,T)
        ==> y = EL n xs`,
     REPEAT GEN_TAC THEN
     DISCH_THEN(CONJUNCTS_THEN2 ASSUME_TAC
       (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
     REWRITE_TAC[heap_el_def] THEN
     MATCH_REDUCE_TAC THEN
     ASM_REWRITE_TAC[] THEN
     MATCH_REDUCE_TAC THEN
     ASM_REWRITE_TAC[PAIR_EQ] THEN
     REWRITE_TAC[injectivity "option"; injectivity "heap_element";
                 PAIR_EQ] THEN
     CONV_TAC(REDEPTH_CONV UNWIND_CONV) THEN
     REWRITE_TAC[EXISTS_UNIQUE_REFL; SELECT_REFL] THEN
     ASM_REWRITE_TAC[PAIR_EQ] THEN
     DISCH_THEN(ACCEPT_TAC o SYM)) in
   DISCH_THEN(REPEAT_TCL CONJUNCTS_THEN ASSUME_TAC) THEN
   SUBGOAL_THEN `~(vals:(dataSem_v)list = [])` ASSUME_TAC THENL
    [DISCH_TAC THEN VAR_EQ_TAC THEN
     FIRST_X_ASSUM(fun th ->
       if (try hd_is "<" (concl th) with Failure _ -> false)
       then MP_TAC(REWRITE_RULE[LENGTH; LT] th) else fail()) THEN
     REWRITE_TAC[];
     ALL_TAC] THEN
   FIRST_ASSUM(fun mr ->
     if hd_is "memory_rel" (concl mr)
     then MP_TAC(REWRITE_RULE[memory_rel_def;
                              word_ml_inv_def; MAP; FST] mr)
     else fail()) THEN
   DISCH_THEN STRIP_ASSUME_TAC THEN
   FIRST_X_ASSUM(fun a2 ->
     if hd_is "ALL2" (concl a2)
     then MP_TAC(REWRITE_RULE[MAP; all2cons] a2) else fail()) THEN
   DISCH_THEN STRIP_ASSUME_TAC THEN
   VAR_EQ_TAC THEN
   FIRST_ASSUM(fun am ->
     if hd_is "abs_ml_inv" (concl am)
     then MP_TAC(REWRITE_RULE[abs_ml_inv_def;
                              bc_stack_ref_inv_def] am)
     else fail()) THEN
   DISCH_THEN STRIP_ASSUME_TAC THEN
   FIRST_X_ASSUM(fun a2 ->
     if hd_is "ALL2" (concl a2) &&
        can (find_term (hd_is "v_inv")) (concl a2)
     then MP_TAC(REWRITE_RULE[ALL2; NOT_CONS_NIL; HD; TL] a2)
     else fail()) THEN
   DISCH_THEN STRIP_ASSUME_TAC THEN
   FIRST_X_ASSUM(fun vi ->
     if hd_is "v_inv" (concl vi)
     then MP_TAC(REWRITE_RULE[v_inv_def] vi)
     else fail()) THEN
   ASM_REWRITE_TAC[] THEN
   DISCH_THEN STRIP_ASSUME_TAC THEN
   FIRST_X_ASSUM(fun e ->
     if is_eq (concl e) && is_var (lhs (concl e)) &&
        hd_is "gc_shared_Pointer" (rhs (concl e))
     then SUBST_ALL_TAC e else fail()) THEN
   RULE_ASSUM_TAC(REWRITE_RULE(word_addr_clauses ())) THEN
   REWRITE_TAC(word_addr_clauses ()) THEN
   W(fun (asl,w) ->
     let vs,bod = strip_exists w in
     EXISTS_TAC (rand (lhs (hd (conjuncts bod))))) THEN
   REWRITE_TAC[] THEN
   FIRST_ASSUM(fun th ->
     if hd_is "heap_in_memory_store" (concl th)
     then MP_TAC(REWRITE_RULE[heap_in_memory_store_def] th)
     else fail()) THEN
   DISCH_THEN STRIP_ASSUME_TAC THEN
   realaddr THEN
   FIRST_ASSUM(fun lr ->
     if hd_is "ALL2" (concl lr) &&
        can (find_term (hd_is "v_inv")) (concl lr)
     then ASSUME_TAC(MATCH_MP LIST_REL_LENGTH lr) else fail()) THEN
   W(fun (asl,w) ->
     let lt = grab asl (fun th ->
       hd_is "<" (concl th) && hd_is "LENGTH" (rand (concl th))) in
     let le = grab asl (fun th ->
       hd_is "=" (concl th) && hd_is "LENGTH" (lhs (concl th)) &&
       hd_is "LENGTH" (rhs (concl th))) in
     MP_TAC(MATCH_MP LESS_LENGTH
              (REWRITE_RULE[le] lt))) THEN
   DISCH_THEN STRIP_ASSUME_TAC THEN
   VAR_EQ_TAC THEN
   W(fun (asl,w) ->
     MP_TAC(MATCH_MP heap_lookup_SPLIT
              (grab asl is_hl))) THEN
   DISCH_THEN STRIP_ASSUME_TAC THEN
   VAR_EQ_TAC THEN
   FIRST_X_ASSUM(fun th ->
     if (try hd_is "STAR" (rator (concl th)) with Failure _ -> false)
     then MP_TAC th else fail()) THEN
   REWRITE_TAC[word_heap_APPEND; word_heap_def;
               BlockRep_def] THEN
   CONV_TAC(TOP_DEPTH_CONV let_CONV) THEN
   REWRITE_TAC[word_el_def] THEN
   CONV_TAC(TOP_DEPTH_CONV let_CONV) THEN
   REWRITE_TAC[word_payload_def] THEN
   CONV_TAC(TOP_DEPTH_CONV let_CONV) THEN
   REWRITE_TAC[MAP_APPEND; MAP; word_list_APPEND;
               word_list_def; LENGTH_MAP] THEN
   ASM_REWRITE_TAC[addreq] THEN
   W(fun (asl,w) ->
     let addr = lhand (hd (conjuncts (rand w))) in
     let pred = rator (lhand w) in
     let fs = facs pred in
     let one = find (fun t ->
       hd_is "set_sep_one" t && fst(dest_pair (rand t)) = addr) fs in
     let rest = remove1 one fs in
     let st = fst(strip_comb pred) in
     let mk a b = mk_comb(mk_comb(st,a),b) in
     SUBGOAL_THEN (mk_eq(pred, mk one (end_itlist mk rest)))
       SUBST1_TAC THENL [REWRITE_TAC[STAR_AC]; ALL_TAC]) THEN
   DISCH_THEN(fun sep ->
     STRIP_ASSUME_TAC(MATCH_MP read_fun2set sep)) THEN
   ASM_REWRITE_TAC[] THEN
   W(fun (asl,w) ->
     let am = grab asl (fun th -> hd_is "abs_ml_inv" (concl th)) in
     let lt = grab asl (fun th ->
       hd_is "<" (concl th) &&
       hd_is "LENGTH" (rand (concl th)) &&
       fst(dest_var(rand(rand(concl th)))) = "vals") in
     MP_TAC(MATCH_MP el_thm (CONJ am lt))) THEN
   DISCH_THEN STRIP_ASSUME_TAC THEN
   RULE_ASSUM_TAC(REWRITE_RULE[CONS_11]) THEN
   REPEAT(FIRST_X_ASSUM(fun th ->
     if is_conj (concl th) then STRIP_ASSUME_TAC th else fail())) THEN
   VAR_EQ_TAC THEN
   W(fun (asl,w) ->
     let hl = REWRITE_RULE[BlockRep_def] (grab asl is_hl) in
     let he = REWRITE_RULE[BlockRep_def]
                (grab asl (fun th ->
                   hd_is "heap_el" (lhs (concl th)))) in
     let le = grab asl (fun th ->
       hd_is "=" (concl th) && hd_is "LENGTH" (lhs (concl th)) &&
       hd_is "LENGTH" (rhs (concl th))) in
     let n = el 1 (snd(strip_comb (lhs (concl he)))) in
     let lt = prove(mk_binop `(<):num->num->bool` n
                      (rhs (concl le)),
                    REWRITE_TAC[LENGTH_APPEND; LENGTH] THEN
                    ARITH_TAC) in
     SUBST_ALL_TAC(REWRITE_RULE[EL_APPEND; LT_REFL; SUB_REFL; EL; HD]
       (MATCH_MP heapel (CONJ hl (CONJ lt he))))) THEN
   REWRITE_TAC[memory_rel_def] THEN
   W(fun (asl,w) ->
     let hm = grab asl (fun th ->
       hd_is "heap_in_memory_store" (concl th)) in
     let args = snd(strip_comb (concl hm)) in
     EXISTS_TAC (el 0 args) THEN EXISTS_TAC (el 9 args) THEN
     EXISTS_TAC (el 1 args) THEN EXISTS_TAC (el 2 args) THEN
     EXISTS_TAC (el 3 args) THEN EXISTS_TAC (el 4 args)) THEN
   ASM_REWRITE_TAC[word_ml_inv_def] THEN
   REWRITE_TAC[MAP; FST; SND] THEN
   W(fun (asl,w) ->
     let am = grab asl (fun th ->
       hd_is "abs_ml_inv" (concl th) &&
       hd_is "EL" (lhand (el 1 (snd(strip_comb (concl th)))))) in
     EXISTS_TAC
       (fst(dest_pair (el 3 (snd(strip_comb (concl am))))))) THEN
   ASM_REWRITE_TAC[MAP; ALL2; HD; TL; NOT_CONS_NIL] THEN
   REWRITE_TAC(word_addr_clauses ()))
### memory_rel_El
  (* an element of a block at an index that a Number root holds:
     memory_rel_El' with the index read off that root.  Its v_inv
     is the small-integer case, because the condition of the
     payload says that the header encodes the length of the block,
     which is above the index, and such a length is below two to
     the dimindex less four; and then the word of the root is four
     times the index, which get_real_offset_thm turns into the
     offset of the element *)
  (let hd_is n t =
      (try fst(dest_const(fst(strip_comb t))) = n
       with Failure _ -> false) in
    let rec facs t =
      if hd_is "STAR" t then
        let args = snd(strip_comb t) in
        facs (el 0 args) @ facs (el 1 args)
      else [t] in
    let rec remove1 t = function
        [] -> []
      | h :: rest -> if h = t then rest else h :: remove1 t rest in
    let grab asl p =
      tryfind (fun (_,th) ->
        if (try p th with Failure _ -> false) then th else fail())
        asl in
    let is_hl th = hd_is "heap_lookup" (lhs (concl th)) in
    let swapmul a =
      let args = snd(strip_comb (rand a)) in
      let mul = fst(strip_comb (rand a)) in
      mk_comb(rator a, mk_comb(mk_comb(mul,el 1 args),el 0 args)) in
    let sepfront names =
      W(fun (asl,w) ->
        let pred = rator (lhand w) in
        let fs = facs pred in
        let picked = map (fun n -> find (hd_is n) fs) names in
        let rest = filter (fun t -> not (mem t picked)) fs in
        let st = fst(strip_comb pred) in
        let mk a b = mk_comb(mk_comb(st,a),b) in
        let target = itlist mk picked (end_itlist mk rest) in
        SUBGOAL_THEN (mk_eq(pred,target)) SUBST1_TAC THENL
         [REWRITE_TAC[STAR_AC]; ALL_TAC]) in
    let all2cons = prove
     (`!P h t (l:(A)list).
         ALL2 P l (CONS (h:B) t) <=>
         ?a b. l = CONS a b /\ P a h /\ ALL2 P b t`,
      REPEAT GEN_TAC THEN
      STRUCT_CASES_TAC(ISPEC `l:(A)list` list_CASES) THEN
      REWRITE_TAC[ALL2; NOT_CONS_NIL; CONS_11] THEN MESON_TAC[]) in
    let addreq = WORD_RULE
      `!(a:(N)word) i.
         (a + bytes_in_word) + n2w i * bytes_in_word =
         a + bytes_in_word + bytes_in_word * n2w i` in
    (* the element of a heap that an address and an index name *)
    let heapel = prove
     (`!a u n (heap:(('a,'b)heap_element)list) xs l d y.
         heap_lookup a heap = SOME (DataElement xs l d) /\
         n < LENGTH xs /\
         heap_el (gc_shared_Pointer a u) n heap = (y,T)
         ==> y = EL n xs`,
      REPEAT GEN_TAC THEN
      DISCH_THEN(CONJUNCTS_THEN2 ASSUME_TAC
        (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
      REWRITE_TAC[heap_el_def] THEN
      MATCH_REDUCE_TAC THEN
      ASM_REWRITE_TAC[] THEN
      MATCH_REDUCE_TAC THEN
      ASM_REWRITE_TAC[PAIR_EQ] THEN
      REWRITE_TAC[injectivity "option"; injectivity "heap_element";
                  PAIR_EQ] THEN
      CONV_TAC(REDEPTH_CONV UNWIND_CONV) THEN
      REWRITE_TAC[EXISTS_UNIQUE_REFL; SELECT_REFL] THEN
      ASM_REWRITE_TAC[PAIR_EQ] THEN
      DISCH_THEN(ACCEPT_TAC o SYM)) in
    (* the Smallnum of a natural number is four times it, and the and
       with the complement of one leaves such a word alone *)
    let smn = prove
     (`!n. Smallnum (&n) = (n2w (4 * n)):(N)word`,
      GEN_TAC THEN REWRITE_TAC[smallnum_def] THEN
      REWRITE_TAC[INT_ARITH `~((&n:int) < &0)`] THEN
      REWRITE_TAC[INT_OF_NUM_MUL; NUM_OF_INT_OF_NUM]) in
    let and4 = prove
     (`!n. word_and (n2w (4 * n)) (word_not (word 1)) =
           (n2w (4 * n)):(N)word`,
      GEN_TAC THEN
      REWRITE_TAC[WORD_EQ_BITS_ALT; BIT_WORD_AND; BIT_WORD_NOT;
                  BIT_WORD_1] THEN
      X_GEN_TAC `i:num` THEN DISCH_TAC THEN
      ASM_CASES_TAC `(i:num) = 0` THEN ASM_REWRITE_TAC[] THEN
      TRY(REWRITE_TAC[BIT_WORD; EXP; DIV_1; ODD_MULT] THEN
        CONV_TAC NUM_REDUCE_CONV THEN NO_TAC) THEN
      TRY(CONV_TAC TAUT)) in
    (* the address of the heap element, without the existential of
       the goal: this proof fills the existentials at the end *)
    let realaddr_noex =
      W(fun (asl,w) ->
        let hl = grab asl is_hl in
        let hlen = grab asl (fun th ->
          hd_is "heap_length" (lhand (concl th))) in
        let cu = grab asl (fun th ->
          hd_is "FLOOKUP" (lhs (concl th)) &&
          fst(dest_const(rand(lhs(concl th)))) = "CurrHeap") in
        let gd = grab asl (fun th ->
          hd_is "good_dimindex" (concl th)) in
        let gat = tryfind (fun t ->
          find_term (fun u ->
            hd_is "get_addr" u && length (snd(strip_comb u)) = 3) t)
          (w :: map (fun (_,th) -> concl th) asl) in
        let mm = MATCH_MP get_real_addr_get_addr
                   (CONJ hlen (CONJ hl (CONJ cu gd))) in
        let wv = find (fun v -> fst(dest_var v) = "w")
                   (frees (concl mm)) in
        let th = SPEC (last (snd(strip_comb gat))) (GEN wv mm) in
        let a = rand (rhs (concl (CONJUNCT1 th))) in
        STRIP_ASSUME_TAC(REWRITE_RULE[WORD_RULE (mk_eq(a,swapmul a))]
                           th)) in
    let offeq = WORD_RULE
      `!(x:(N)word) i.
         x + (bytes_in_word + n2w i * bytes_in_word) =
         x + bytes_in_word + bytes_in_word * n2w i` in
    (* the length a header encodes is below two to the dimindex less
       four, and an index into such a list is a small integer *)
    let enchdr = prove
     (`!c tag len (h:'a word).
         encode_header c tag len = SOME h
         ==> len < 2 EXP (dimindex (:'a) - 4)`,
      REPEAT GEN_TAC THEN REWRITE_TAC[encode_header_def] THEN
      COND_CASES_TAC THEN REWRITE_TAC[distinctness "option"] THEN
      DISCH_THEN(K ALL_TAC) THEN ASM_REWRITE_TAC[]) in
    let smallidx = prove
     (`!(i:num) n.
         good_dimindex (:'a) /\ i < n /\
         n < 2 EXP (dimindex (:'a) - 4)
         ==> small_int (:'a) (&i)`,
      REPEAT GEN_TAC THEN
      REWRITE_TAC[small_int_def; dimword;
                  good_dimindex_def] THEN
      DISCH_THEN(CONJUNCTS_THEN2 MP_TAC STRIP_ASSUME_TAC) THEN
      DISCH_THEN(DISJ_CASES_THEN SUBST_ALL_TAC) THEN
      RULE_ASSUM_TAC(CONV_RULE NUM_REDUCE_CONV) THEN
      CONV_TAC NUM_REDUCE_CONV THEN
      CONJ_TAC THEN
      TRY(MATCH_MP_TAC INT_LE_TRANS THEN EXISTS_TAC `&0:int` THEN
          REWRITE_TAC[INT_POS; INT_NEG_LE0; INT_POS] THEN NO_TAC) THEN
      REWRITE_TAC[INT_OF_NUM_LT] THEN ASM_ARITH_TAC) in
  DISCH_THEN(REPEAT_TCL CONJUNCTS_THEN ASSUME_TAC) THEN
    SUBGOAL_THEN `~(vals:(dataSem_v)list = [])` ASSUME_TAC THENL
     [DISCH_TAC THEN VAR_EQ_TAC THEN
      FIRST_X_ASSUM(fun th ->
        if (try hd_is "<" (concl th) with Failure _ -> false)
        then MP_TAC(REWRITE_RULE[LENGTH; LT] th) else fail()) THEN
      REWRITE_TAC[];
      ALL_TAC] THEN
    FIRST_ASSUM(fun mr ->
      if hd_is "memory_rel" (concl mr)
      then MP_TAC(REWRITE_RULE[memory_rel_def;
                               word_ml_inv_def; MAP; FST] mr)
      else fail()) THEN
    DISCH_THEN STRIP_ASSUME_TAC THEN
    FIRST_X_ASSUM(fun a2 ->
      if hd_is "ALL2" (concl a2)
      then MP_TAC(REWRITE_RULE[MAP; all2cons] a2) else fail()) THEN
    DISCH_THEN STRIP_ASSUME_TAC THEN
    VAR_EQ_TAC THEN
    FIRST_ASSUM(fun am ->
      if hd_is "abs_ml_inv" (concl am)
      then MP_TAC(REWRITE_RULE[abs_ml_inv_def;
                               bc_stack_ref_inv_def] am)
      else fail()) THEN
    DISCH_THEN STRIP_ASSUME_TAC THEN
    FIRST_X_ASSUM(fun a2 ->
      if hd_is "ALL2" (concl a2) &&
         can (find_term (hd_is "v_inv")) (concl a2)
      then MP_TAC(REWRITE_RULE[ALL2; NOT_CONS_NIL; HD; TL] a2)
      else fail()) THEN
    DISCH_THEN STRIP_ASSUME_TAC THEN
    FIRST_X_ASSUM(fun vi ->
      if hd_is "v_inv" (concl vi) &&
         hd_is "dataSem_Block" (el 1 (snd(strip_comb (concl vi))))
      then MP_TAC(REWRITE_RULE[v_inv_def] vi)
      else fail()) THEN
    ASM_REWRITE_TAC[] THEN
    DISCH_THEN STRIP_ASSUME_TAC THEN
    FIRST_X_ASSUM(fun e ->
      if is_eq (concl e) && is_var (lhs (concl e)) &&
         hd_is "gc_shared_Pointer" (rhs (concl e))
      then SUBST_ALL_TAC e else fail()) THEN
    RULE_ASSUM_TAC(REWRITE_RULE(word_addr_clauses ())) THEN
    REWRITE_TAC(word_addr_clauses ()) THEN
    FIRST_ASSUM(fun th ->
      if hd_is "heap_in_memory_store" (concl th)
      then MP_TAC(REWRITE_RULE[heap_in_memory_store_def] th)
      else fail()) THEN
    DISCH_THEN STRIP_ASSUME_TAC THEN
    realaddr_noex THEN
    FIRST_ASSUM(fun lr ->
      if hd_is "ALL2" (concl lr) &&
         can (find_term (hd_is "v_inv")) (concl lr)
      then ASSUME_TAC(MATCH_MP LIST_REL_LENGTH lr) else fail()) THEN
    W(fun (asl,w) ->
      let lt = grab asl (fun th ->
        hd_is "<" (concl th) && hd_is "LENGTH" (rand (concl th))) in
      let le = grab asl (fun th ->
        hd_is "=" (concl th) && hd_is "LENGTH" (lhs (concl th)) &&
        hd_is "LENGTH" (rhs (concl th))) in
      MP_TAC(MATCH_MP LESS_LENGTH
               (REWRITE_RULE[le] lt))) THEN
    DISCH_THEN STRIP_ASSUME_TAC THEN
    VAR_EQ_TAC THEN
    W(fun (asl,w) ->
      MP_TAC(MATCH_MP heap_lookup_SPLIT
               (grab asl is_hl))) THEN
    DISCH_THEN STRIP_ASSUME_TAC THEN
    VAR_EQ_TAC THEN
    FIRST_X_ASSUM(fun th ->
      if (try hd_is "STAR" (rator (concl th)) with Failure _ -> false)
      then MP_TAC th else fail()) THEN
    REWRITE_TAC[word_heap_APPEND; word_heap_def;
                BlockRep_def] THEN
    CONV_TAC(TOP_DEPTH_CONV let_CONV) THEN
    REWRITE_TAC[word_el_def] THEN
    CONV_TAC(TOP_DEPTH_CONV let_CONV) THEN
    REWRITE_TAC[word_payload_def] THEN
    CONV_TAC(TOP_DEPTH_CONV let_CONV) THEN
    REWRITE_TAC[MAP_APPEND; MAP; word_list_APPEND;
                word_list_def; LENGTH_MAP] THEN
    ASM_REWRITE_TAC[addreq] THEN
    (* the condition of the payload says what the header encodes *)
    REPEAT(sepfront ["cond"] THEN REWRITE_TAC[cond_STAR] THEN
           DISCH_THEN(CONJUNCTS_THEN2 STRIP_ASSUME_TAC MP_TAC)) THEN
    W(fun (asl,w) ->
      let ga = grab asl (fun th ->
        hd_is "get_real_addr" (lhs (concl th))) in
      let base = rand (rhs (concl ga)) in
      let pred = rator (lhand w) in
      let fs = facs pred in
      let one = find (fun t ->
        hd_is "set_sep_one" t &&
        not (fst(dest_pair (rand t)) = base)) fs in
      let rest = remove1 one fs in
      let st = fst(strip_comb pred) in
      let mk a b = mk_comb(mk_comb(st,a),b) in
      SUBGOAL_THEN (mk_eq(pred, mk one (end_itlist mk rest)))
        SUBST1_TAC THENL [REWRITE_TAC[STAR_AC]; ALL_TAC]) THEN
    DISCH_THEN(fun sep ->
      STRIP_ASSUME_TAC(MATCH_MP read_fun2set sep)) THEN
    ASM_REWRITE_TAC[] THEN
    (* the index is a small integer, because it is below the length
       that the header of the block encodes *)
    W(fun (asl,w) ->
      let eh = grab asl (fun th ->
        hd_is "encode_header" (lhs (concl th))) in
      let lt = grab asl (fun th ->
        hd_is "<" (concl th) && hd_is "LENGTH" (lhand (concl th)) &&
        hd_is "LENGTH" (rand (concl th))) in
      let le = grab asl (fun th ->
        hd_is "=" (concl th) && hd_is "LENGTH" (lhs (concl th)) &&
        hd_is "LENGTH" (rhs (concl th))) in
      let gd = grab asl (fun th ->
        hd_is "good_dimindex" (concl th)) in
      ASSUME_TAC(MATCH_MP smallidx
        (CONJ gd (CONJ (REWRITE_RULE[le] lt)
                       (MATCH_MP enchdr eh))))) THEN
    FIRST_X_ASSUM(fun vi ->
      if hd_is "v_inv" (concl vi) &&
         hd_is "dataSem_Number" (el 1 (snd(strip_comb (concl vi))))
      then MP_TAC(REWRITE_RULE[v_inv_def] vi)
      else fail()) THEN
    FIRST_ASSUM(fun si ->
      if hd_is "small_int" (concl si) then REWRITE_TAC[si]
      else fail()) THEN
    DISCH_THEN(fun eq ->
      RULE_ASSUM_TAC(REWRITE_RULE[eq]) THEN REWRITE_TAC[eq]) THEN
    RULE_ASSUM_TAC(REWRITE_RULE
      (word_addr_clauses () @ [smn; and4])) THEN
    REWRITE_TAC(word_addr_clauses () @ [smn; and4]) THEN
    W(fun (asl,w) ->
      let am = grab asl (fun th -> hd_is "abs_ml_inv" (concl th)) in
      let lt = grab asl (fun th ->
        hd_is "<" (concl th) &&
        hd_is "LENGTH" (rand (concl th)) &&
        fst(dest_var(rand(rand(concl th)))) = "vals") in
      MP_TAC(MATCH_MP el_thm (CONJ am lt))) THEN
    DISCH_THEN STRIP_ASSUME_TAC THEN
    RULE_ASSUM_TAC(REWRITE_RULE[CONS_11]) THEN
    REPEAT(FIRST_X_ASSUM(fun th ->
      if is_conj (concl th) then STRIP_ASSUME_TAC th else fail())) THEN
    VAR_EQ_TAC THEN
    W(fun (asl,w) ->
      let hl = REWRITE_RULE[BlockRep_def] (grab asl is_hl) in
      let he = REWRITE_RULE[BlockRep_def]
                 (grab asl (fun th ->
                    hd_is "heap_el" (lhs (concl th)))) in
      let le = grab asl (fun th ->
        hd_is "=" (concl th) && hd_is "LENGTH" (lhs (concl th)) &&
        hd_is "LENGTH" (rhs (concl th))) in
      let n = el 1 (snd(strip_comb (lhs (concl he)))) in
      let lt = prove(mk_binop `(<):num->num->bool` n
                       (rhs (concl le)),
                     REWRITE_TAC[LENGTH_APPEND; LENGTH] THEN
                     ARITH_TAC) in
      SUBST_ALL_TAC(REWRITE_RULE[EL_APPEND; LT_REFL; SUB_REFL; EL; HD]
        (MATCH_MP heapel (CONJ hl (CONJ lt he))))) THEN
    W(fun (asl,w) ->
      let cs = conjuncts (snd(strip_exists w)) in
      let ga = grab asl (fun th ->
        hd_is "get_real_addr" (lhs (concl th))) in
      let gd = grab asl (fun th ->
        hd_is "good_dimindex" (concl th)) in
      let ro0 = MATCH_MP get_real_offset_thm gd in
      let iv = find (fun v -> type_of v = `:num`) (frees (concl ro0)) in
      let ro = INST [rand (rand (rand (lhs (el 1 cs)))),iv] ro0 in
      EXISTS_TAC (rand (lhs (el 0 cs))) THEN
      EXISTS_TAC (rand (lhs (el 1 cs))) THEN
      EXISTS_TAC (rand (rhs (concl ga))) THEN
      EXISTS_TAC (rand (rhs (concl ro))) THEN
      ASM_REWRITE_TAC[ro; offeq]) THEN
    REWRITE_TAC[memory_rel_def] THEN
    W(fun (asl,w) ->
      let hm = grab asl (fun th ->
        hd_is "heap_in_memory_store" (concl th)) in
      let args = snd(strip_comb (concl hm)) in
      EXISTS_TAC (el 0 args) THEN EXISTS_TAC (el 9 args) THEN
      EXISTS_TAC (el 1 args) THEN EXISTS_TAC (el 2 args) THEN
      EXISTS_TAC (el 3 args) THEN EXISTS_TAC (el 4 args)) THEN
    ASM_REWRITE_TAC[word_ml_inv_def] THEN
    REWRITE_TAC[MAP; FST; SND] THEN
    W(fun (asl,w) ->
      let am = grab asl (fun th ->
        hd_is "abs_ml_inv" (concl th) &&
        hd_is "EL" (lhand (el 1 (snd(strip_comb (concl th)))))) in
      EXISTS_TAC
        (fst(dest_pair (el 3 (snd(strip_comb (concl am))))))) THEN
    ASM_REWRITE_TAC[MAP; ALL2; HD; TL; NOT_CONS_NIL] THEN
    REWRITE_TAC(word_addr_clauses () @ [and4]))
### memory_rel_swap
  (DISCH_TAC THEN
   FIRST_ASSUM(fun th ->
     MATCH_MP_TAC(MATCH_MP
       (ONCE_REWRITE_RULE[TAUT `(p ==> q ==> r) <=> (q ==> p ==> r)`]
          memory_rel_rearrange) th)) THEN
   REWRITE_TAC[MEM] THEN MESON_TAC[])
### memory_rel_Deref'
  (* an element of a reference's array, read out of the memory: the
     same shape as memory_rel_El', with bc_ref_inv's RefBlock in
     place of the Block's BlockRep and deref_thm in place of
     el_thm.  The thunk rules of v_inv are out because the
     reference holds a ValueArray, and the address of the element
     is the pointer of the root, which is not a variable here, so
     the heap's split has to be substituted by hand *)
  (let hd_is n t =
   (try fst(dest_const(fst(strip_comb t))) = n
    with Failure _ -> false) in
 let rec facs t =
   if hd_is "STAR" t then
     let args = snd(strip_comb t) in
     facs (el 0 args) @ facs (el 1 args)
   else [t] in
 let rec remove1 t = function
     [] -> []
   | h :: rest -> if h = t then rest else h :: remove1 t rest in
 let grab asl p =
   tryfind (fun (_,th) ->
     if (try p th with Failure _ -> false) then th else fail())
     asl in
 let is_hl th = hd_is "heap_lookup" (lhs (concl th)) in
 let killthunk =
   TRY(FIRST_ASSUM(fun t1 -> FIRST_ASSUM(fun t2 ->
     CONTR_TAC(REWRITE_RULE[injectivity "option";
                            distinctness "bvlSem_ref"]
                 (TRANS (SYM t1) t2))))) in
 let refinv ptr root =
   FIRST_X_ASSUM(fun th ->
     if is_forall (concl th) &&
        hd_is "bc_ref_inv" (rand (snd(strip_forall(concl th))))
     then MP_TAC(SPEC ptr th) else fail()) THEN
   ANTS_TAC THENL
    [CONJ_TAC THENL
      [REWRITE_TAC[reachable_refs_def; MEM] THEN
       EXISTS_TAC root THEN EXISTS_TAC ptr THEN
       REWRITE_TAC[get_refs_def; MEM;
                   CONJUNCT1(SPEC_ALL RTC_RULES)];
       ASM_REWRITE_TAC[]];
     ALL_TAC] THEN
   REWRITE_TAC[bc_ref_inv_def] THEN
   ASM_SIMP_TAC[FLOOKUP_DEF] THEN
   MATCH_REDUCE_TAC in
 let swapmul a =
   let args = snd(strip_comb (rand a)) in
   let mul = fst(strip_comb (rand a)) in
   mk_comb(rator a, mk_comb(mk_comb(mul,el 1 args),el 0 args)) in
 let realaddr =
   W(fun (asl,w) ->
     let hl = grab asl is_hl in
     let hlen = grab asl (fun th ->
       hd_is "heap_length" (lhand (concl th))) in
     let cu = grab asl (fun th ->
       hd_is "FLOOKUP" (lhs (concl th)) &&
       fst(dest_const(rand(lhs(concl th)))) = "CurrHeap") in
     let gd = grab asl (fun th ->
       hd_is "good_dimindex" (concl th)) in
     let gat = tryfind (fun t ->
       find_term (fun u ->
         hd_is "get_addr" u && length (snd(strip_comb u)) = 3) t)
       (w :: map (fun (_,th) -> concl th) asl) in
     let mm = MATCH_MP get_real_addr_get_addr
                (CONJ hlen (CONJ hl (CONJ cu gd))) in
     let wv = find (fun v -> fst(dest_var v) = "w")
                (frees (concl mm)) in
     let th = SPEC (last (snd(strip_comb gat))) (GEN wv mm) in
     let a = rand (rhs (concl (CONJUNCT1 th))) in
     EXISTS_TAC (swapmul a) THEN
     STRIP_ASSUME_TAC(REWRITE_RULE[WORD_RULE (mk_eq(a,swapmul a))]
                        th)) in
   let all2cons = prove
    (`!P h t (l:(A)list).
        ALL2 P l (CONS (h:B) t) <=>
        ?a b. l = CONS a b /\ P a h /\ ALL2 P b t`,
     REPEAT GEN_TAC THEN
     STRUCT_CASES_TAC(ISPEC `l:(A)list` list_CASES) THEN
     REWRITE_TAC[ALL2; NOT_CONS_NIL; CONS_11] THEN MESON_TAC[]) in
   let addreq = WORD_RULE
     `!(a:(N)word) i.
        (a + bytes_in_word) + n2w i * bytes_in_word =
        a + bytes_in_word + bytes_in_word * n2w i` in
   (* the element of a heap that an address and an index name *)
   let heapel = prove
    (`!a u n (heap:(('a,'b)heap_element)list) xs l d y.
        heap_lookup a heap = SOME (DataElement xs l d) /\
        n < LENGTH xs /\
        heap_el (gc_shared_Pointer a u) n heap = (y,T)
        ==> y = EL n xs`,
     REPEAT GEN_TAC THEN
     DISCH_THEN(CONJUNCTS_THEN2 ASSUME_TAC
       (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
     REWRITE_TAC[heap_el_def] THEN
     MATCH_REDUCE_TAC THEN
     ASM_REWRITE_TAC[] THEN
     MATCH_REDUCE_TAC THEN
     ASM_REWRITE_TAC[PAIR_EQ] THEN
     REWRITE_TAC[injectivity "option"; injectivity "heap_element";
                 PAIR_EQ] THEN
     CONV_TAC(REDEPTH_CONV UNWIND_CONV) THEN
     REWRITE_TAC[EXISTS_UNIQUE_REFL; SELECT_REFL] THEN
     ASM_REWRITE_TAC[PAIR_EQ] THEN
     DISCH_THEN(ACCEPT_TAC o SYM)) in
   DISCH_THEN(REPEAT_TCL CONJUNCTS_THEN ASSUME_TAC) THEN
   SUBGOAL_THEN `~(vals:(dataSem_v)list = [])` ASSUME_TAC THENL
    [DISCH_TAC THEN VAR_EQ_TAC THEN
     FIRST_X_ASSUM(fun th ->
       if (try hd_is "<" (concl th) with Failure _ -> false)
       then MP_TAC(REWRITE_RULE[LENGTH; LT] th) else fail()) THEN
     REWRITE_TAC[];
     ALL_TAC] THEN
   FIRST_ASSUM(fun mr ->
     if hd_is "memory_rel" (concl mr)
     then MP_TAC(REWRITE_RULE[memory_rel_def;
                              word_ml_inv_def; MAP; FST] mr)
     else fail()) THEN
   DISCH_THEN STRIP_ASSUME_TAC THEN
   FIRST_X_ASSUM(fun a2 ->
     if hd_is "ALL2" (concl a2)
     then MP_TAC(REWRITE_RULE[MAP; all2cons] a2) else fail()) THEN
   DISCH_THEN STRIP_ASSUME_TAC THEN
   VAR_EQ_TAC THEN
   FIRST_ASSUM(fun am ->
     if hd_is "abs_ml_inv" (concl am)
     then MP_TAC(REWRITE_RULE[abs_ml_inv_def;
                              bc_stack_ref_inv_def] am)
     else fail()) THEN
   DISCH_THEN STRIP_ASSUME_TAC THEN
   FIRST_X_ASSUM(fun a2 ->
     if hd_is "ALL2" (concl a2) &&
        can (find_term (hd_is "v_inv")) (concl a2)
     then MP_TAC(REWRITE_RULE[ALL2; NOT_CONS_NIL; HD; TL] a2)
     else fail()) THEN
   DISCH_THEN STRIP_ASSUME_TAC THEN
   FIRST_X_ASSUM(fun vi ->
     if hd_is "v_inv" (concl vi)
     then MP_TAC(REWRITE_RULE[v_inv_def] vi)
     else fail()) THEN
   DISCH_THEN STRIP_ASSUME_TAC THEN
   killthunk THEN
   FIRST_X_ASSUM(fun e ->
     if is_eq (concl e) && is_var (lhs (concl e)) &&
        hd_is "gc_shared_Pointer" (rhs (concl e))
     then SUBST_ALL_TAC e else fail()) THEN
   RULE_ASSUM_TAC(REWRITE_RULE(word_addr_clauses ())) THEN
   REWRITE_TAC(word_addr_clauses ()) THEN
   W(fun (asl,w) ->
     let vs,bod = strip_exists w in
     EXISTS_TAC (rand (lhs (hd (conjuncts bod))))) THEN
   REWRITE_TAC[] THEN
   refinv `nn:num` `RefPtr bl nn:dataSem_v` THEN
   ASM_REWRITE_TAC[] THEN
   CONV_TAC(TOP_DEPTH_CONV let_CONV) THEN
   DISCH_THEN STRIP_ASSUME_TAC THEN
   FIRST_ASSUM(fun th ->
     if hd_is "heap_in_memory_store" (concl th)
     then MP_TAC(REWRITE_RULE[heap_in_memory_store_def] th)
     else fail()) THEN
   DISCH_THEN STRIP_ASSUME_TAC THEN
   realaddr THEN
   FIRST_ASSUM(fun lr ->
     if hd_is "ALL2" (concl lr) &&
        can (find_term (hd_is "v_inv")) (concl lr)
     then ASSUME_TAC(MATCH_MP LIST_REL_LENGTH lr) else fail()) THEN
   W(fun (asl,w) ->
     let lt = grab asl (fun th ->
       hd_is "<" (concl th) && hd_is "LENGTH" (rand (concl th))) in
     let le = grab asl (fun th ->
       hd_is "=" (concl th) && hd_is "LENGTH" (lhs (concl th)) &&
       hd_is "LENGTH" (rhs (concl th))) in
     MP_TAC(MATCH_MP LESS_LENGTH
              (REWRITE_RULE[GSYM le] lt))) THEN
   DISCH_THEN STRIP_ASSUME_TAC THEN
   VAR_EQ_TAC THEN
   W(fun (asl,w) ->
     MP_TAC(MATCH_MP heap_lookup_SPLIT
              (grab asl is_hl))) THEN
   DISCH_THEN STRIP_ASSUME_TAC THEN
   VAR_EQ_TAC THEN
   TRY(FIRST_X_ASSUM(fun th ->
     if (try hd_is "fmap_apply" (lhs (concl th))
         with Failure _ -> false)
     then SUBST_ALL_TAC th else fail())) THEN
   FIRST_X_ASSUM(fun th ->
     if (try hd_is "STAR" (rator (concl th)) with Failure _ -> false)
     then MP_TAC th else fail()) THEN
   REWRITE_TAC[word_heap_APPEND; word_heap_def;
               RefBlock_def] THEN
   CONV_TAC(TOP_DEPTH_CONV let_CONV) THEN
   REWRITE_TAC[word_el_def] THEN
   CONV_TAC(TOP_DEPTH_CONV let_CONV) THEN
   REWRITE_TAC[word_payload_def] THEN
   CONV_TAC(TOP_DEPTH_CONV let_CONV) THEN
   REWRITE_TAC[MAP_APPEND; MAP; word_list_APPEND;
               word_list_def; LENGTH_MAP] THEN
   ASM_REWRITE_TAC[addreq] THEN
   W(fun (asl,w) ->
     let addr = lhand (hd (conjuncts (rand w))) in
     let pred = rator (lhand w) in
     let fs = facs pred in
     let one = find (fun t ->
       hd_is "set_sep_one" t && fst(dest_pair (rand t)) = addr) fs in
     let rest = remove1 one fs in
     let st = fst(strip_comb pred) in
     let mk a b = mk_comb(mk_comb(st,a),b) in
     SUBGOAL_THEN (mk_eq(pred, mk one (end_itlist mk rest)))
       SUBST1_TAC THENL [REWRITE_TAC[STAR_AC]; ALL_TAC]) THEN
   DISCH_THEN(fun sep ->
     STRIP_ASSUME_TAC(MATCH_MP read_fun2set sep)) THEN
   ASM_REWRITE_TAC[] THEN
   W(fun (asl,w) ->
     let am = grab asl (fun th -> hd_is "abs_ml_inv" (concl th)) in
     MP_TAC(MATCH_MP deref_thm am)) THEN
   ASM_REWRITE_TAC[THE] THEN
   MATCH_REDUCE_TAC THEN
   DISCH_THEN STRIP_ASSUME_TAC THEN
   W(fun (asl,w) ->
     let fa = grab asl (fun th ->
       is_forall (concl th) &&
       can (find_term (hd_is "heap_el")) (concl th)) in
     let lt = grab asl (fun th ->
       hd_is "<" (concl th) && hd_is "LENGTH" (rand (concl th))) in
     MP_TAC(MP (SPEC (lhand (concl lt)) fa) lt)) THEN
   DISCH_THEN STRIP_ASSUME_TAC THEN
   RULE_ASSUM_TAC(REWRITE_RULE[CONS_11]) THEN
   REPEAT(FIRST_X_ASSUM(fun th ->
     if is_conj (concl th) then STRIP_ASSUME_TAC th else fail())) THEN
   VAR_EQ_TAC THEN
   W(fun (asl,w) ->
     let hl = REWRITE_RULE[RefBlock_def] (grab asl is_hl) in
     let he = REWRITE_RULE[RefBlock_def]
                (grab asl (fun th ->
                   hd_is "heap_el" (lhs (concl th)))) in
     let n = el 1 (snd(strip_comb (lhs (concl he)))) in
     let len = el 1 (snd(strip_comb (rand (rhs (concl hl))))) in
     let lt = prove(mk_binop `(<):num->num->bool` n len,
                    REWRITE_TAC[LENGTH_APPEND; LENGTH] THEN
                    ARITH_TAC) in
     SUBST_ALL_TAC(REWRITE_RULE[EL_APPEND; LT_REFL; SUB_REFL; EL; HD]
       (MATCH_MP heapel (CONJ hl (CONJ lt he))))) THEN
   REWRITE_TAC[memory_rel_def] THEN
   W(fun (asl,w) ->
     let hm = grab asl (fun th ->
       hd_is "heap_in_memory_store" (concl th)) in
     let args = snd(strip_comb (concl hm)) in
     EXISTS_TAC (el 0 args) THEN EXISTS_TAC (el 9 args) THEN
     EXISTS_TAC (el 1 args) THEN EXISTS_TAC (el 2 args) THEN
     EXISTS_TAC (el 3 args) THEN EXISTS_TAC (el 4 args)) THEN
   ASM_REWRITE_TAC[word_ml_inv_def] THEN
   REWRITE_TAC[MAP; FST; SND] THEN
   W(fun (asl,w) ->
     let am = grab asl (fun th ->
       hd_is "abs_ml_inv" (concl th) &&
       hd_is "EL" (lhand (el 1 (snd(strip_comb (concl th)))))) in
     EXISTS_TAC
       (fst(dest_pair (el 3 (snd(strip_comb (concl am))))))) THEN
   ASM_REWRITE_TAC[MAP; ALL2; HD; TL; NOT_CONS_NIL] THEN
   REWRITE_TAC(word_addr_clauses ()))
### memory_rel_Deref
  (* an element of a reference's array at an index that a Number
     root holds: memory_rel_Deref' with the index read off that
     root, the same way as memory_rel_El reads it off its own *)
  (let hd_is n t =
      (try fst(dest_const(fst(strip_comb t))) = n
       with Failure _ -> false) in
    let rec facs t =
      if hd_is "STAR" t then
        let args = snd(strip_comb t) in
        facs (el 0 args) @ facs (el 1 args)
      else [t] in
    let rec remove1 t = function
        [] -> []
      | h :: rest -> if h = t then rest else h :: remove1 t rest in
    let grab asl p =
      tryfind (fun (_,th) ->
        if (try p th with Failure _ -> false) then th else fail())
        asl in
    let is_hl th = hd_is "heap_lookup" (lhs (concl th)) in
    let swapmul a =
      let args = snd(strip_comb (rand a)) in
      let mul = fst(strip_comb (rand a)) in
      mk_comb(rator a, mk_comb(mk_comb(mul,el 1 args),el 0 args)) in
    let sepfront names =
      W(fun (asl,w) ->
        let pred = rator (lhand w) in
        let fs = facs pred in
        let picked = map (fun n -> find (hd_is n) fs) names in
        let rest = filter (fun t -> not (mem t picked)) fs in
        let st = fst(strip_comb pred) in
        let mk a b = mk_comb(mk_comb(st,a),b) in
        let target = itlist mk picked (end_itlist mk rest) in
        SUBGOAL_THEN (mk_eq(pred,target)) SUBST1_TAC THENL
         [REWRITE_TAC[STAR_AC]; ALL_TAC]) in
    let killthunk =
      TRY(FIRST_ASSUM(fun t1 -> FIRST_ASSUM(fun t2 ->
        CONTR_TAC(REWRITE_RULE[injectivity "option";
                               distinctness "bvlSem_ref"]
                    (TRANS (SYM t1) t2))))) in
    let refinv ptr root =
      FIRST_X_ASSUM(fun th ->
        if is_forall (concl th) &&
           hd_is "bc_ref_inv" (rand (snd(strip_forall(concl th))))
        then MP_TAC(SPEC ptr th) else fail()) THEN
      ANTS_TAC THENL
       [CONJ_TAC THENL
         [REWRITE_TAC[reachable_refs_def; MEM] THEN
          EXISTS_TAC root THEN EXISTS_TAC ptr THEN
          REWRITE_TAC[get_refs_def; MEM;
                      CONJUNCT1(SPEC_ALL RTC_RULES)];
          ASM_REWRITE_TAC[]];
        ALL_TAC] THEN
      REWRITE_TAC[bc_ref_inv_def] THEN
      ASM_SIMP_TAC[FLOOKUP_DEF] THEN
      MATCH_REDUCE_TAC in
    let all2cons = prove
     (`!P h t (l:(A)list).
         ALL2 P l (CONS (h:B) t) <=>
         ?a b. l = CONS a b /\ P a h /\ ALL2 P b t`,
      REPEAT GEN_TAC THEN
      STRUCT_CASES_TAC(ISPEC `l:(A)list` list_CASES) THEN
      REWRITE_TAC[ALL2; NOT_CONS_NIL; CONS_11] THEN MESON_TAC[]) in
    let addreq = WORD_RULE
      `!(a:(N)word) i.
         (a + bytes_in_word) + n2w i * bytes_in_word =
         a + bytes_in_word + bytes_in_word * n2w i` in
    (* the element of a heap that an address and an index name *)
    let heapel = prove
     (`!a u n (heap:(('a,'b)heap_element)list) xs l d y.
         heap_lookup a heap = SOME (DataElement xs l d) /\
         n < LENGTH xs /\
         heap_el (gc_shared_Pointer a u) n heap = (y,T)
         ==> y = EL n xs`,
      REPEAT GEN_TAC THEN
      DISCH_THEN(CONJUNCTS_THEN2 ASSUME_TAC
        (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
      REWRITE_TAC[heap_el_def] THEN
      MATCH_REDUCE_TAC THEN
      ASM_REWRITE_TAC[] THEN
      MATCH_REDUCE_TAC THEN
      ASM_REWRITE_TAC[PAIR_EQ] THEN
      REWRITE_TAC[injectivity "option"; injectivity "heap_element";
                  PAIR_EQ] THEN
      CONV_TAC(REDEPTH_CONV UNWIND_CONV) THEN
      REWRITE_TAC[EXISTS_UNIQUE_REFL; SELECT_REFL] THEN
      ASM_REWRITE_TAC[PAIR_EQ] THEN
      DISCH_THEN(ACCEPT_TAC o SYM)) in
    (* the Smallnum of a natural number is four times it, and the and
       with the complement of one leaves such a word alone *)
    let smn = prove
     (`!n. Smallnum (&n) = (n2w (4 * n)):(N)word`,
      GEN_TAC THEN REWRITE_TAC[smallnum_def] THEN
      REWRITE_TAC[INT_ARITH `~((&n:int) < &0)`] THEN
      REWRITE_TAC[INT_OF_NUM_MUL; NUM_OF_INT_OF_NUM]) in
    let and4 = prove
     (`!n. word_and (n2w (4 * n)) (word_not (word 1)) =
           (n2w (4 * n)):(N)word`,
      GEN_TAC THEN
      REWRITE_TAC[WORD_EQ_BITS_ALT; BIT_WORD_AND; BIT_WORD_NOT;
                  BIT_WORD_1] THEN
      X_GEN_TAC `i:num` THEN DISCH_TAC THEN
      ASM_CASES_TAC `(i:num) = 0` THEN ASM_REWRITE_TAC[] THEN
      TRY(REWRITE_TAC[BIT_WORD; EXP; DIV_1; ODD_MULT] THEN
        CONV_TAC NUM_REDUCE_CONV THEN NO_TAC) THEN
      TRY(CONV_TAC TAUT)) in
    (* the address of the heap element, without the existential of
       the goal: this proof fills the existentials at the end *)
    let realaddr_noex =
      W(fun (asl,w) ->
        let hl = grab asl is_hl in
        let hlen = grab asl (fun th ->
          hd_is "heap_length" (lhand (concl th))) in
        let cu = grab asl (fun th ->
          hd_is "FLOOKUP" (lhs (concl th)) &&
          fst(dest_const(rand(lhs(concl th)))) = "CurrHeap") in
        let gd = grab asl (fun th ->
          hd_is "good_dimindex" (concl th)) in
        let gat = tryfind (fun t ->
          find_term (fun u ->
            hd_is "get_addr" u && length (snd(strip_comb u)) = 3) t)
          (w :: map (fun (_,th) -> concl th) asl) in
        let mm = MATCH_MP get_real_addr_get_addr
                   (CONJ hlen (CONJ hl (CONJ cu gd))) in
        let wv = find (fun v -> fst(dest_var v) = "w")
                   (frees (concl mm)) in
        let th = SPEC (last (snd(strip_comb gat))) (GEN wv mm) in
        let a = rand (rhs (concl (CONJUNCT1 th))) in
        STRIP_ASSUME_TAC(REWRITE_RULE[WORD_RULE (mk_eq(a,swapmul a))]
                           th)) in
    let offeq = WORD_RULE
      `!(x:(N)word) i.
         x + (bytes_in_word + n2w i * bytes_in_word) =
         x + bytes_in_word + bytes_in_word * n2w i` in
    let smallidx = prove
     (`!(i:num) n.
         good_dimindex (:'a) /\ i < n /\
         n < 2 EXP (dimindex (:'a) - 4)
         ==> small_int (:'a) (&i)`,
      REPEAT GEN_TAC THEN
      REWRITE_TAC[small_int_def; dimword;
                  good_dimindex_def] THEN
      DISCH_THEN(CONJUNCTS_THEN2 MP_TAC STRIP_ASSUME_TAC) THEN
      DISCH_THEN(DISJ_CASES_THEN SUBST_ALL_TAC) THEN
      RULE_ASSUM_TAC(CONV_RULE NUM_REDUCE_CONV) THEN
      CONV_TAC NUM_REDUCE_CONV THEN
      CONJ_TAC THEN
      TRY(MATCH_MP_TAC INT_LE_TRANS THEN EXISTS_TAC `&0:int` THEN
          REWRITE_TAC[INT_POS; INT_NEG_LE0; INT_POS] THEN NO_TAC) THEN
      REWRITE_TAC[INT_OF_NUM_LT] THEN ASM_ARITH_TAC) in
  DISCH_THEN(REPEAT_TCL CONJUNCTS_THEN ASSUME_TAC) THEN
    SUBGOAL_THEN `~(vals:(dataSem_v)list = [])` ASSUME_TAC THENL
     [DISCH_TAC THEN VAR_EQ_TAC THEN
      FIRST_X_ASSUM(fun th ->
        if (try hd_is "<" (concl th) with Failure _ -> false)
        then MP_TAC(REWRITE_RULE[LENGTH; LT] th) else fail()) THEN
      REWRITE_TAC[];
      ALL_TAC] THEN
    FIRST_ASSUM(fun mr ->
      if hd_is "memory_rel" (concl mr)
      then MP_TAC(REWRITE_RULE[memory_rel_def;
                               word_ml_inv_def; MAP; FST] mr)
      else fail()) THEN
    DISCH_THEN STRIP_ASSUME_TAC THEN
    FIRST_X_ASSUM(fun a2 ->
      if hd_is "ALL2" (concl a2)
      then MP_TAC(REWRITE_RULE[MAP; all2cons] a2) else fail()) THEN
    DISCH_THEN STRIP_ASSUME_TAC THEN
    VAR_EQ_TAC THEN
    FIRST_ASSUM(fun am ->
      if hd_is "abs_ml_inv" (concl am)
      then MP_TAC(REWRITE_RULE[abs_ml_inv_def;
                               bc_stack_ref_inv_def] am)
      else fail()) THEN
    DISCH_THEN STRIP_ASSUME_TAC THEN
    FIRST_X_ASSUM(fun a2 ->
      if hd_is "ALL2" (concl a2) &&
         can (find_term (hd_is "v_inv")) (concl a2)
      then MP_TAC(REWRITE_RULE[ALL2; NOT_CONS_NIL; HD; TL] a2)
      else fail()) THEN
    DISCH_THEN STRIP_ASSUME_TAC THEN
    FIRST_X_ASSUM(fun vi ->
      if hd_is "v_inv" (concl vi) &&
         hd_is "dataSem_RefPtr" (el 1 (snd(strip_comb (concl vi))))
      then MP_TAC(REWRITE_RULE[v_inv_def] vi)
      else fail()) THEN
    DISCH_THEN STRIP_ASSUME_TAC THEN
    killthunk THEN
    FIRST_X_ASSUM(fun e ->
      if is_eq (concl e) && is_var (lhs (concl e)) &&
         hd_is "gc_shared_Pointer" (rhs (concl e))
      then SUBST_ALL_TAC e else fail()) THEN
    RULE_ASSUM_TAC(REWRITE_RULE(word_addr_clauses ())) THEN
    REWRITE_TAC(word_addr_clauses ()) THEN
    refinv `nn:num` `RefPtr bl nn:dataSem_v` THEN
    ASM_REWRITE_TAC[] THEN
    CONV_TAC(TOP_DEPTH_CONV let_CONV) THEN
    DISCH_THEN STRIP_ASSUME_TAC THEN
    FIRST_ASSUM(fun th ->
      if hd_is "heap_in_memory_store" (concl th)
      then MP_TAC(REWRITE_RULE[heap_in_memory_store_def] th)
      else fail()) THEN
    DISCH_THEN STRIP_ASSUME_TAC THEN
    realaddr_noex THEN
    FIRST_ASSUM(fun lr ->
      if hd_is "ALL2" (concl lr) &&
         can (find_term (hd_is "v_inv")) (concl lr)
      then ASSUME_TAC(MATCH_MP LIST_REL_LENGTH lr) else fail()) THEN
    W(fun (asl,w) ->
      let lt = grab asl (fun th ->
        hd_is "<" (concl th) && hd_is "LENGTH" (rand (concl th))) in
      let le = grab asl (fun th ->
        hd_is "=" (concl th) && hd_is "LENGTH" (lhs (concl th)) &&
        hd_is "LENGTH" (rhs (concl th))) in
      MP_TAC(MATCH_MP LESS_LENGTH
               (REWRITE_RULE[GSYM le] lt))) THEN
    DISCH_THEN STRIP_ASSUME_TAC THEN
    VAR_EQ_TAC THEN
    W(fun (asl,w) ->
      MP_TAC(MATCH_MP heap_lookup_SPLIT
               (grab asl is_hl))) THEN
    DISCH_THEN STRIP_ASSUME_TAC THEN
    VAR_EQ_TAC THEN
    TRY(FIRST_X_ASSUM(fun th ->
      if (try hd_is "fmap_apply" (lhs (concl th))
          with Failure _ -> false)
      then SUBST_ALL_TAC th else fail())) THEN
    FIRST_X_ASSUM(fun th ->
      if (try hd_is "STAR" (rator (concl th)) with Failure _ -> false)
      then MP_TAC th else fail()) THEN
    REWRITE_TAC[word_heap_APPEND; word_heap_def;
                RefBlock_def] THEN
    CONV_TAC(TOP_DEPTH_CONV let_CONV) THEN
    REWRITE_TAC[word_el_def] THEN
    CONV_TAC(TOP_DEPTH_CONV let_CONV) THEN
    REWRITE_TAC[word_payload_def] THEN
    CONV_TAC(TOP_DEPTH_CONV let_CONV) THEN
    REWRITE_TAC[MAP_APPEND; MAP; word_list_APPEND;
                word_list_def; LENGTH_MAP] THEN
    ASM_REWRITE_TAC[addreq] THEN
    (* the condition of the payload bounds the length of the block *)
    REPEAT(sepfront ["cond"] THEN REWRITE_TAC[cond_STAR] THEN
           DISCH_THEN(CONJUNCTS_THEN2 STRIP_ASSUME_TAC MP_TAC)) THEN
    W(fun (asl,w) ->
      let ga = grab asl (fun th ->
        hd_is "get_real_addr" (lhs (concl th))) in
      let base = rand (rhs (concl ga)) in
      let pred = rator (lhand w) in
      let fs = facs pred in
      let one = find (fun t ->
        hd_is "set_sep_one" t &&
        not (fst(dest_pair (rand t)) = base)) fs in
      let rest = remove1 one fs in
      let st = fst(strip_comb pred) in
      let mk a b = mk_comb(mk_comb(st,a),b) in
      SUBGOAL_THEN (mk_eq(pred, mk one (end_itlist mk rest)))
        SUBST1_TAC THENL [REWRITE_TAC[STAR_AC]; ALL_TAC]) THEN
    DISCH_THEN(fun sep ->
      STRIP_ASSUME_TAC(MATCH_MP read_fun2set sep)) THEN
    ASM_REWRITE_TAC[] THEN
    (* the index is a small integer, because it is below the length
       that the header of the block encodes *)
    W(fun (asl,w) ->
      let bd = grab asl (fun th ->
        hd_is "<" (concl th) && hd_is "LENGTH" (lhand (concl th)) &&
        hd_is "EXP" (rand (concl th))) in
      let lt0 = grab asl (fun th ->
        hd_is "<" (concl th) && hd_is "LENGTH" (lhand (concl th)) &&
        hd_is "LENGTH" (rand (concl th))) in
      let lt = try REWRITE_RULE[grab asl (fun th ->
                     hd_is "=" (concl th) &&
                     hd_is "LENGTH" (lhs (concl th)) &&
                     hd_is "LENGTH" (rhs (concl th)))] lt0
               with Failure _ -> lt0 in
      let gd = grab asl (fun th ->
        hd_is "good_dimindex" (concl th)) in
      ASSUME_TAC(MATCH_MP smallidx (CONJ gd (CONJ lt bd)))) THEN
    FIRST_X_ASSUM(fun vi ->
      if hd_is "v_inv" (concl vi) &&
         hd_is "dataSem_Number" (el 1 (snd(strip_comb (concl vi))))
      then MP_TAC(REWRITE_RULE[v_inv_def] vi)
      else fail()) THEN
    FIRST_ASSUM(fun si ->
      if hd_is "small_int" (concl si) then REWRITE_TAC[si]
      else fail()) THEN
    DISCH_THEN(fun eq ->
      RULE_ASSUM_TAC(REWRITE_RULE[eq]) THEN REWRITE_TAC[eq]) THEN
    RULE_ASSUM_TAC(REWRITE_RULE
      (word_addr_clauses () @ [smn; and4])) THEN
    REWRITE_TAC(word_addr_clauses () @ [smn; and4]) THEN
    W(fun (asl,w) ->
      let am = grab asl (fun th -> hd_is "abs_ml_inv" (concl th)) in
      MP_TAC(MATCH_MP deref_thm am)) THEN
    ASM_REWRITE_TAC[THE] THEN
    MATCH_REDUCE_TAC THEN
    DISCH_THEN STRIP_ASSUME_TAC THEN
    W(fun (asl,w) ->
      let fa = grab asl (fun th ->
        is_forall (concl th) &&
        can (find_term (hd_is "heap_el")) (concl th)) in
      let lt = grab asl (fun th ->
        hd_is "<" (concl th) && hd_is "LENGTH" (rand (concl th))) in
      MP_TAC(MP (SPEC (lhand (concl lt)) fa) lt)) THEN
    DISCH_THEN STRIP_ASSUME_TAC THEN
    RULE_ASSUM_TAC(REWRITE_RULE[CONS_11]) THEN
    REPEAT(FIRST_X_ASSUM(fun th ->
      if is_conj (concl th) then STRIP_ASSUME_TAC th else fail())) THEN
    VAR_EQ_TAC THEN
    W(fun (asl,w) ->
      let hl = REWRITE_RULE[RefBlock_def] (grab asl is_hl) in
      let he = REWRITE_RULE[RefBlock_def]
                 (grab asl (fun th ->
                    hd_is "heap_el" (lhs (concl th)))) in
      let n = el 1 (snd(strip_comb (lhs (concl he)))) in
      let len = el 1 (snd(strip_comb (rand (rhs (concl hl))))) in
      let lt = prove(mk_binop `(<):num->num->bool` n len,
                     REWRITE_TAC[LENGTH_APPEND; LENGTH] THEN
                     ARITH_TAC) in
      SUBST_ALL_TAC(REWRITE_RULE[EL_APPEND; LT_REFL; SUB_REFL; EL; HD]
        (MATCH_MP heapel (CONJ hl (CONJ lt he))))) THEN
    W(fun (asl,w) ->
      let cs = conjuncts (snd(strip_exists w)) in
      let ga = grab asl (fun th ->
        hd_is "get_real_addr" (lhs (concl th))) in
      let gd = grab asl (fun th ->
        hd_is "good_dimindex" (concl th)) in
      let ro0 = MATCH_MP get_real_offset_thm gd in
      let iv = find (fun v -> type_of v = `:num`) (frees (concl ro0)) in
      let ro = INST [rand (rand (rand (lhs (el 1 cs)))),iv] ro0 in
      EXISTS_TAC (rand (lhs (el 0 cs))) THEN
      EXISTS_TAC (rand (lhs (el 1 cs))) THEN
      EXISTS_TAC (rand (rhs (concl ga))) THEN
      EXISTS_TAC (rand (rhs (concl ro))) THEN
      ASM_REWRITE_TAC[ro; offeq]) THEN
    REWRITE_TAC[memory_rel_def] THEN
    W(fun (asl,w) ->
      let hm = grab asl (fun th ->
        hd_is "heap_in_memory_store" (concl th)) in
      let args = snd(strip_comb (concl hm)) in
      EXISTS_TAC (el 0 args) THEN EXISTS_TAC (el 9 args) THEN
      EXISTS_TAC (el 1 args) THEN EXISTS_TAC (el 2 args) THEN
      EXISTS_TAC (el 3 args) THEN EXISTS_TAC (el 4 args)) THEN
    ASM_REWRITE_TAC[word_ml_inv_def] THEN
    REWRITE_TAC[MAP; FST; SND] THEN
    W(fun (asl,w) ->
      let am = grab asl (fun th ->
        hd_is "abs_ml_inv" (concl th) &&
        hd_is "EL" (lhand (el 1 (snd(strip_comb (concl th)))))) in
      EXISTS_TAC
        (fst(dest_pair (el 3 (snd(strip_comb (concl am))))))) THEN
    ASM_REWRITE_TAC[MAP; ALL2; HD; TL; NOT_CONS_NIL] THEN
    REWRITE_TAC(word_addr_clauses () @ [and4]))
### LENGTH_EQ_1
  (let lrw = [LENGTH; CONS_11; NOT_CONS_NIL; LENGTH_EQ_NIL;
              EQ_SYM_EQ; ARITH_RULE `~(0 = 1)`;
              ARITH_RULE `(SUC n = 1) <=> (n = 0)`] in
   let aux = prove
    (`!xs:A list. (LENGTH xs = 1 <=> ?a1. xs = [a1]) /\
                  (1 = LENGTH xs <=> ?a1. xs = [a1])`,
     GEN_TAC THEN
     STRUCT_CASES_TAC(ISPEC `xs:A list` list_CASES_v) THEN
     REWRITE_TAC lrw THEN
     CONV_TAC(REDEPTH_CONV UNWIND_CONV) THEN REWRITE_TAC[]) in
   REPEAT GEN_TAC THEN MATCH_ACCEPT_TAC aux)
### LENGTH_EQ_2
  (let lrw = [LENGTH; CONS_11; NOT_CONS_NIL; LENGTH_EQ_NIL;
              EQ_SYM_EQ; ARITH_RULE `~(0 = 1)`;
              ARITH_RULE `~(0 = 2)`;
              ARITH_RULE `(SUC n = 1) <=> (n = 0)`;
              ARITH_RULE `(SUC n = 2) <=> (n = 1)`] in
   let aux = prove
    (`!xs:A list. (LENGTH xs = 2 <=> ?a1 a2. xs = [a1; a2]) /\
                  (2 = LENGTH xs <=> ?a1 a2. xs = [a1; a2])`,
     GEN_TAC THEN
     STRUCT_CASES_TAC(ISPEC `xs:A list` list_CASES_v) THEN
     REWRITE_TAC lrw THEN
     TRY(CONV_TAC(REDEPTH_CONV UNWIND_CONV) THEN REWRITE_TAC[]) THEN
     STRUCT_CASES_TAC(ISPEC `vs:A list` list_CASES_v) THEN
     REWRITE_TAC lrw THEN
     CONV_TAC(REDEPTH_CONV UNWIND_CONV) THEN REWRITE_TAC[]) in
   REPEAT GEN_TAC THEN MATCH_ACCEPT_TAC aux)
### LENGTH_EQ_3
  (* one element off the front and LENGTH_EQ_2 says the rest *)
  (let lrw = [LENGTH; CONS_11; NOT_CONS_NIL; LENGTH_EQ_NIL;
              EQ_SYM_EQ; ARITH_RULE `~(0 = 3)`;
              ARITH_RULE `(SUC n = 3) <=> (n = 2)`] in
   let aux = prove
    (`!xs:A list. (LENGTH xs = 3 <=> ?a1 a2 a3. xs = [a1; a2; a3]) /\
                  (3 = LENGTH xs <=> ?a1 a2 a3. xs = [a1; a2; a3])`,
     GEN_TAC THEN
     STRUCT_CASES_TAC(ISPEC `xs:A list` list_CASES_v) THEN
     REWRITE_TAC lrw THEN
     TRY(CONV_TAC(REDEPTH_CONV UNWIND_CONV) THEN REWRITE_TAC[]) THEN
     MATCH_ACCEPT_TAC(CONJUNCT1 LENGTH_EQ_2)) in
   REPEAT GEN_TAC THEN MATCH_ACCEPT_TAC aux)
### heap_split_SOME_APPEND
  (REWRITE_TAC[heap_split_APPEND_if] THEN REPEAT GEN_TAC THEN
   COND_CASES_TAC THEN EVERY_CASE_TAC THEN
   ASM_REWRITE_TAC[injectivity "option"; distinctness "option";
                   PAIR_EQ] THEN
   MESON_TAC[])
### store_list_append
  (* the store of the append stores xs and then ys, at the address
     that the length of xs moves on to *)
  (LIST_INDUCT_TAC THEN REPEAT GEN_TAC THEN
   ASM_REWRITE_TAC[APPEND;
                   data_to_word_memoryProof_store_list_def;
                   LENGTH; WORD_ADD_MUL_0; WORD_ADD_MUL_SUC] THEN
   TRY(COND_CASES_TAC) THEN
   ASM_REWRITE_TAC[distinctness "option"; injectivity "option"] THEN
   MESON_TAC[])
### minus_lemma
  (CONV_TAC WORD_RULE)
### n2w_lsr_eq_0
  (REPEAT STRIP_TAC THEN
   RULE_ASSUM_TAC(REWRITE_RULE[dimword]) THEN
   ASM_SIMP_TAC[GSYM VAL_EQ_0; VAL_WORD_USHR; VAL_WORD; MOD_LT])
### LESS_EXO_SUB
  (DISCH_TAC THEN MATCH_MP_TAC LTE_TRANS THEN
   EXISTS_TAC `2 EXP (k - m)` THEN
   ASM_REWRITE_TAC[LE_EXP; ARITH_EQ] THEN ARITH_TAC)
### LESS_EXO_SUB_ALT
  (REPEAT STRIP_TAC THEN
   SUBGOAL_THEN `2 EXP k = 2 EXP (k - m) * 2 EXP m` SUBST1_TAC THENL
    [REWRITE_TAC[GSYM EXP_ADD] THEN AP_TERM_TAC THEN ASM_ARITH_TAC;
     ASM_REWRITE_TAC[LT_MULT_RCANCEL; EXP_EQ_0; ARITH_EQ]])
### less_pow_dimindex_sub_imp
  (REWRITE_TAC[dimword] THEN MATCH_ACCEPT_TAC LESS_EXO_SUB)
### encode_header_NEQ_0
  (* the header has the lowest bit of its three set, and a word
     with a bit is not zero *)
  (REWRITE_TAC[encode_header_def] THEN
   COND_CASES_TAC THEN
   REWRITE_TAC[distinctness "option"; injectivity "option"] THEN
   DISCH_THEN(SUBST1_TAC o SYM) THEN
   REWRITE_TAC[make_header_def] THEN
   CONV_TAC(TOP_DEPTH_CONV let_CONV) THEN
   REWRITE_TAC[WORD_EQ_BITS_ALT] THEN
   DISCH_THEN(MP_TAC o SPEC `0`) THEN
   REWRITE_TAC[BIT_WORD_OR; BIT_WORD_0; BIT_WORD] THEN
   CONV_TAC NUM_REDUCE_CONV THEN
   REWRITE_TAC[ARITH_RULE `0 < d <=> 1 <= d`; DIMINDEX_GE_1])
### encode_header_IMP
  (* what encode_header gives back is make_header of the tag and the
     length, so the length is the one of its condition and the shift
     down of decode_length undoes the shift up that make_header did:
     the tag and the three are below the shift, so the shift down
     loses them *)
  (let hi = prove
    (`!n r (i:num). n < 2 EXP r /\ r <= i
        ==> ~(bit i ((n2w n):'a word))`,
     MATCH_ACCEPT_TAC BIT_WORD_HI) in
   let b3 = prove
    (`!j. j < dimindex (:'a)
          ==> (bit j ((n2w 3):'a word) <=> j < 2)`,
     GEN_TAC THEN DISCH_TAC THEN
     ASM_CASES_TAC `(j:num) < 2` THEN ASM_REWRITE_TAC[] THENL
      [FIRST_ASSUM(DISJ_CASES_THEN SUBST_ALL_TAC o MATCH_MP
         (ARITH_RULE `(j:num) < 2 ==> j = 0 \/ j = 1`)) THEN
       ASM_REWRITE_TAC[BIT_WORD] THEN CONV_TAC NUM_REDUCE_CONV THEN
       ASM_ARITH_TAC;
       MP_TAC(ISPECL [`3`; `2`; `j:num`] hi) THEN
       ASM_SIMP_TAC[ARITH_RULE `~((j:num) < 2) ==> 2 <= j`] THEN
       CONV_TAC NUM_REDUCE_CONV]) in
   REWRITE_TAC[encode_header_def] THEN
   COND_CASES_TAC THEN
   REWRITE_TAC[distinctness "option"; injectivity "option"] THEN
   REPEAT(FIRST_X_ASSUM(fun th ->
     if is_conj (concl th) then STRIP_ASSUME_TAC th else fail())) THEN
   DISCH_THEN(CONJUNCTS_THEN2 (SUBST1_TAC o SYM) STRIP_ASSUME_TAC) THEN
   CONJ_TAC THENL
    [FIRST_ASSUM ACCEPT_TAC;
     REWRITE_TAC[decode_length_def; make_header_def] THEN
     CONV_TAC(TOP_DEPTH_CONV let_CONV) THEN
     SUBGOAL_THEN
       `!j. bit j (((n2w tag) << 2 || (n2w 3)):'a word)
            ==> j < dimindex (:'a) -
                    data_to_word_config_len_size c`
       (fun th -> REWRITE_TAC[MATCH_MP USHR_OR_LOW th]) THENL
      [X_GEN_TAC `j:num` THEN
       REWRITE_TAC[BIT_WORD_OR; BIT_WORD_SHL] THEN STRIP_TAC THENL
        [MP_TAC(ISPECL
           [`tag:num`;
            `dimindex (:'a) - data_to_word_config_len_size c - 2`;
            `j - 2`] hi) THEN
         ASM_REWRITE_TAC[] THEN ARITH_NO_BIT_TAC;
         MP_TAC(MATCH_MP b3 (ASSUME `j < dimindex (:'a)`)) THEN
         ASM_REWRITE_TAC[] THEN ARITH_NO_BIT_TAC];
       MATCH_MP_TAC USHR_SHL_CANCEL THEN
       X_GEN_TAC `j:num` THEN
       ASM_CASES_TAC `bit j ((n2w len):'a word)` THEN
       ASM_REWRITE_TAC[] THEN
       MP_TAC(ISPECL
         [`len:num`; `data_to_word_config_len_size c`; `j:num`] hi) THEN
       ASM_REWRITE_TAC[] THEN ARITH_NO_BIT_TAC]])
### thunk_tag_bits_lemma
  (* three is the tag of an evaluated thunk, so the word is 8 or 6 *)
  (REWRITE_TAC[thunk_tag_to_bits_def] THEN
   MATCH_REDUCE_TAC THEN
   WORD_NUM_BIT_TAC 4)
### word_list_exists_thm
  (* the two clauses of word_list_exists: at zero it is emp, and at
     a successor it is the cell at the address beside the list of
     the rest -- the existential of the definition is over the list
     of the words, and the condition on its length picks the empty
     list or a cons *)
  (CONJ_TAC THEN ONCE_REWRITE_TAC[FUN_EQ_THM] THEN GEN_TAC THEN
   REWRITE_TAC[word_list_exists_def] THEN
   REWRITE_TAC[STAR_SEP_EXISTS; SEP_EXISTS_THM] THEN
   REWRITE_TAC[STAR_ASSOC; STAR_cond] THEN
   REWRITE_TAC[GSYM(CONJUNCT2 word_list_def)] THEN
   REWRITE_TAC[LENGTH_EQ_NIL; emp_def] THENL
    [REWRITE_TAC[UNWIND_THM2; word_list_def; emp_def];
     MESON_TAC[LENGTH_EQ_CONS; LENGTH]])
### word_list_exists_ADD
  (* the SEP_EXISTS of the head comes out of the separating
     conjunction (the first clause of HOL4's SEP_CLAUSES), and the
     address of the tail is the head's address shifted once *)
  (INDUCT_TAC THEN
   ASM_REWRITE_TAC[word_list_exists_thm; ADD; emp_STAR; STAR_ASSOC;
                   SEP_EXISTS_STAR; WORD_ADD_MUL_SUC;
                   WORD_ADD_MUL_0])
### store_list_thm
  (* the store of a list of words into a space that word_list_exists
     describes: the space of a cons is a cell and the space of the
     rest, read_fun2set says the address of the cell is in the
     domain, write_fun2set says what the store at it leaves, and the
     induction hypothesis stores the rest with the cell in the frame *)
  (let aux = prove
    (`!(xs:((N)word_loc) list) (a:(N)word) frame m dm.
        (word_list_exists a (LENGTH xs) * frame) (fun2set (m,dm))
        ==> ?m1. data_to_word_memoryProof_store_list a xs m dm =
                 SOME m1 /\
                 (misc_word_list a xs * frame) (fun2set (m1,dm))`,
     LIST_INDUCT_TAC THEN REPEAT GEN_TAC THENL
      [REWRITE_TAC[LENGTH; word_list_exists_thm;
                   word_list_def;
                   data_to_word_memoryProof_store_list_def] THEN
       DISCH_TAC THEN
       EXISTS_TAC `m:(N)word->(N)word_loc` THEN
       ASM_REWRITE_TAC[];
       ALL_TAC] THEN
     REWRITE_TAC[LENGTH; word_list_exists_thm;
                 word_list_def;
                 data_to_word_memoryProof_store_list_def] THEN
     REWRITE_TAC[SEP_EXISTS_STAR; SEP_EXISTS_THM] THEN
     DISCH_THEN(X_CHOOSE_THEN `w:(N)word_loc` MP_TAC) THEN
     REWRITE_TAC[GSYM STAR_ASSOC] THEN DISCH_TAC THEN
     FIRST_ASSUM(fun th -> MP_TAC(MATCH_MP read_fun2set th)) THEN
     DISCH_THEN(CONJUNCTS_THEN2 (K ALL_TAC) ASSUME_TAC) THEN
     ASM_REWRITE_TAC[] THEN
     FIRST_ASSUM(fun th ->
       MP_TAC(MATCH_MP (ISPEC `h:(N)word_loc` write_fun2set) th)) THEN
     DISCH_TAC THEN
     FIRST_X_ASSUM(fun ih ->
       MP_TAC(SPECL [`a + bytes_in_word:(N)word`;
                     `set_sep_one (a:(N)word,h:(N)word_loc) * frame`;
                     `(a =+ (h:(N)word_loc)) (m:(N)word->(N)word_loc)`;
                     `dm:(N)word->bool`] ih)) THEN
     ANTS_TAC THENL
      [FIRST_X_ASSUM(fun th -> MP_TAC th) THEN
       REWRITE_TAC[STAR_AC];
       ALL_TAC] THEN
     DISCH_THEN(X_CHOOSE_THEN `m1:(N)word->(N)word_loc`
       STRIP_ASSUME_TAC) THEN
     EXISTS_TAC `m1:(N)word->(N)word_loc` THEN
     ASM_REWRITE_TAC[] THEN
     FIRST_X_ASSUM(fun th -> MP_TAC th) THEN
     REWRITE_TAC[STAR_AC]) in
   MATCH_ACCEPT_TAC aux)
### store_list_domain
  (* the n-th address of the store is the first one shifted n
     times, which the induction over the list takes apart *)
  (let aux = prove
    (`!xs (a:(N)word) m dm m1.
        data_to_word_memoryProof_store_list a xs m dm = SOME m1
        ==> !n. n < LENGTH xs
                ==> a + n2w n * bytes_in_word IN dm`,
     LIST_INDUCT_TAC THEN REPEAT GEN_TAC THEN
     REWRITE_TAC[data_to_word_memoryProof_store_list_def;
                 LENGTH; CONJUNCT1 LT] THEN
     COND_CASES_TAC THEN REWRITE_TAC[distinctness "option"] THEN
     DISCH_TAC THEN X_GEN_TAC `k:num` THEN
     STRUCT_CASES_TAC(SPEC `k:num` num_CASES) THEN
     ASM_REWRITE_TAC[WORD_ADD_0_MUL; LT_SUC; WORD_ADD_SUC_MUL;
                     LT_0] THEN
     DISCH_TAC THEN USE_IH THEN DISCH_THEN MATCH_MP_TAC THEN
     FIRST_ASSUM ACCEPT_TAC) in
   REPEAT GEN_TAC THEN MATCH_ACCEPT_TAC aux)
### store_list_append_imp
  (let aux = prove
    (`!w1 (a:(N)word) m dm m' w2.
        data_to_word_memoryProof_store_list a (APPEND w1 w2) m dm =
          SOME m'
        ==> ?m''.
              data_to_word_memoryProof_store_list a w1 m dm =
                SOME m'' /\
              data_to_word_memoryProof_store_list
                (a + n2w (LENGTH w1) * bytes_in_word) w2 m'' dm =
                SOME m'`,
     LIST_INDUCT_TAC THEN REPEAT GEN_TAC THEN
     REWRITE_TAC[APPEND;
                 data_to_word_memoryProof_store_list_def;
                 LENGTH; WORD_ADD_0_MUL; WORD_ADD_SUC_MUL] THEN
     TRY COND_CASES_TAC THEN
     REWRITE_TAC[distinctness "option"] THEN DISCH_TAC THEN
     TRY USE_IH THEN ASM_MESON_TAC[]) in
   REPEAT GEN_TAC THEN MATCH_ACCEPT_TAC aux)
### store_list_update_m_outside
  (* the store of a list of words does not disturb an address that
     none of its stores touches, and the update of the memory at
     such an address commutes with every store of the list; the
     address of the i-th store of the tail is the one of the
     (i+1)-th store of the list *)
  (let upd_comm = prove
    (`!a b x y (f:A->B). ~(a = b)
        ==> (a =+ x) ((b =+ y) f) = (b =+ y) ((a =+ x) f)`,
     REPEAT STRIP_TAC THEN REWRITE_TAC[FUN_EQ_THM; UPDATE] THEN
     GEN_TAC THEN REPEAT COND_CASES_TAC THEN ASM_REWRITE_TAC[] THEN
     ASM_MESON_TAC[]) in
   let wzero = prove
    (`!(a:(N)word). a + n2w 0 * bytes_in_word = a`,
     CONV_TAC WORD_RULE) in
   let wsuc = prove
    (`!(a:(N)word) i.
        (a + bytes_in_word) + n2w i * bytes_in_word =
        a + n2w (SUC i) * bytes_in_word`,
     REWRITE_TAC[ADD1; WORD_ADD] THEN CONV_TAC WORD_RULE) in
   LIST_INDUCT_TAC THEN REPEAT GEN_TAC THEN
   REWRITE_TAC[data_to_word_memoryProof_store_list_def] THENL
    [REWRITE_TAC[injectivity "option"] THEN
     DISCH_THEN(fun th -> REWRITE_TAC[SYM(CONJUNCT1 th)]);
     COND_CASES_TAC THEN
     REWRITE_TAC[distinctness "option"] THEN STRIP_TAC THEN
     FIRST_ASSUM(fun th ->
       let th' = REWRITE_RULE[wzero; LENGTH; LT_0] (SPEC `0` th) in
       if is_neg (concl th') then ASSUME_TAC th' else fail()) THEN
     FIRST_ASSUM(fun th -> REWRITE_TAC[MATCH_MP upd_comm th]) THEN
     FIRST_X_ASSUM MATCH_MP_TAC THEN
     ASM_REWRITE_TAC[wsuc] THEN
     GEN_TAC THEN DISCH_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
     ASM_REWRITE_TAC[LENGTH; LT_SUC]])
### word_payload_IMP
  (* every clause of word_payload gives the payload as a list of
     the same length as the one it is made of; the equation that
     says what ts is has to be used the other way round, and MESON
     does not get past the header of the clause *)
  (let use_ts (asl,w as gl) =
     let v = var_by_name "ts" gl in
     let ok t = can rhs (concl t) && rhs(concl t) = v in
     let th = tryfind (fun (_,t) -> if ok t then t else fail()) asl in
     (SUBST1_TAC(SYM th) THEN ASM_REWRITE_TAC[LENGTH_MAP]) gl in
   CASES_ON_NAME "tags" THEN
   REWRITE_TAC[word_payload_def; PAIR_EQ] THEN
   EVERY_CASE_TAC THEN REPEAT STRIP_TAC THEN use_ts)
### word_el_IMP_word_list_exists
  (* whatever a heap element says of the memory, the space it takes
     is free space of its own length: an Unused element is that
     space already, a ForwardPointer is a cell and the space after
     it, and a DataElement is a word_list, whose length the
     condition of word_el and word_payload_IMP give *)
  (let wlie = prove
    (`!(xs:((M)word_loc) list) (a:(N)word) p s.
        (p * misc_word_list a xs) s
        ==> (p * word_list_exists a (LENGTH xs)) s`,
     REPEAT GEN_TAC THEN
     REWRITE_TAC[word_list_exists_def; STAR_SEP_EXISTS;
                 SEP_EXISTS_THM] THEN
     DISCH_TAC THEN EXISTS_TAC `xs:((M)word_loc) list` THEN
     REWRITE_TAC[STAR_ASSOC; STAR_cond] THEN
     ASM_REWRITE_TAC[]) in
   let aux = prove
    (`!conf s (temp:((M)word_loc,
                     data_to_word_memoryProof_tag #
                     ((M)word_loc) list)heap_element) p (curr:(N)word).
        (p * word_el curr temp conf) s
        ==> (p * word_list_exists curr (el_length temp)) s`,
     REPEAT GEN_TAC THEN CASES_ON_NAME "temp" THENL
      [REWRITE_TAC[word_el_def; el_length_def];
       REWRITE_TAC[word_el_def; el_length_def] THEN
       REWRITE_TAC[GSYM ADD1; word_list_exists_thm] THEN
       REWRITE_TAC[STAR_SEP_EXISTS; SEP_EXISTS_THM] THEN
       DISCH_TAC THEN
       EXISTS_TAC `wordLang_Word ((n2w a0 << 2):(M)word)` THEN
       FIRST_ASSUM ACCEPT_TAC;
       MP_TAC(ISPEC `a2:data_to_word_memoryProof_tag #
                        ((M)word_loc) list` PAIR_SURJECTIVE) THEN
       DISCH_THEN(X_CHOOSE_THEN `tag:data_to_word_memoryProof_tag`
         (X_CHOOSE_THEN `qs:((M)word_loc) list` SUBST1_TAC)) THEN
       REWRITE_TAC[word_el_def; el_length_def] THEN
       W(fun (asl,w) ->
         let pr = find_term (fun t ->
           (try fst(dest_const(fst(strip_comb t))) = "word_payload"
            with Failure _ -> false)) w in
         MP_TAC(ISPEC pr PAIR_SURJECTIVE)) THEN
       DISCH_THEN(X_CHOOSE_THEN `hh:(M)word`
         (X_CHOOSE_THEN `rest:((M)word_loc) list # bool`
           ASSUME_TAC)) THEN
       MP_TAC(ISPEC `rest:((M)word_loc) list # bool`
         PAIR_SURJECTIVE) THEN
       DISCH_THEN(X_CHOOSE_THEN `ts:((M)word_loc) list`
         (X_CHOOSE_THEN `cc:bool` SUBST_ALL_TAC)) THEN
       ASM_REWRITE_TAC[] THEN
       CONV_TAC(TOP_DEPTH_CONV let_CONV) THEN
       REWRITE_TAC[STAR_ASSOC; STAR_cond] THEN
       STRIP_TAC THEN
       RULE_ASSUM_TAC(REWRITE_RULE[ASSUME `cc:bool`]) THEN
       FIRST_ASSUM(fun pay ->
         MP_TAC(MATCH_MP word_payload_IMP pay)) THEN
       DISCH_TAC THEN
       FIRST_ASSUM(fun st ->
         MP_TAC(MATCH_MP wlie
           (REWRITE_RULE[GSYM STAR_ASSOC] st))) THEN
       ASM_REWRITE_TAC[LENGTH; ADD1]]) in
   REPEAT GEN_TAC THEN MATCH_ACCEPT_TAC aux)
### word_heap_IMP_word_list_exists
  (* and the same of a whole heap, element by element: the space of
     a cons splits by word_list_exists_ADD, and the induction
     hypothesis takes the rest with the first element's space in the
     frame *)
  (let swap2 = prove
    (`!(p:((A)->bool)->bool) q r. (p * q) * r = (p * r) * q`,
     REWRITE_TAC[STAR_AC]) in
   let aux = prove
    (`!(temp:(((M)word_loc,
               data_to_word_memoryProof_tag #
               ((M)word_loc) list)heap_element) list) conf s p
        (curr:(N)word).
        (p * word_heap curr temp conf) s
        ==> (p * word_list_exists curr (heap_length temp)) s`,
     LIST_INDUCT_TAC THEN REPEAT GEN_TAC THENL
      [REWRITE_TAC[word_heap_def; heap_length_NIL;
                   word_list_exists_thm];
       ALL_TAC] THEN
     REWRITE_TAC[word_heap_def;
                 heap_length_CONS] THEN
     REWRITE_TAC[word_list_exists_ADD] THEN
     REWRITE_TAC[STAR_ASSOC] THEN
     DISCH_TAC THEN
     FIRST_ASSUM(fun st ->
       MP_TAC(ONCE_REWRITE_RULE[swap2] st)) THEN
     DISCH_THEN(fun st ->
       MP_TAC(MATCH_MP word_el_IMP_word_list_exists
         st)) THEN
     DISCH_THEN(fun st -> MP_TAC(ONCE_REWRITE_RULE[swap2] st)) THEN
     FIRST_X_ASSUM(fun ih ->
       DISCH_THEN(fun st -> MP_TAC(MATCH_MP ih st))) THEN
     REWRITE_TAC[]) in
   REPEAT GEN_TAC THEN MATCH_ACCEPT_TAC aux)
### EVERY2_f_EQ
  (let aux = prove
    (`!(f:A->B) rs ws. ALL2 (\v w. f v = w) rs ws <=> MAP f rs = ws`,
     GEN_TAC THEN LIST_INDUCT_TAC THEN X_GEN_TAC `ws:B list` THEN
     STRUCT_CASES_TAC(ISPEC `ws:B list` list_CASES_v) THEN
     ASM_REWRITE_TAC[ALL2; MAP; CONS_11; NOT_CONS_NIL;
                     EQ_SYM_EQ]) in
   REPEAT GEN_TAC THEN MATCH_ACCEPT_TAC aux)
### word_heap_heap_expand
  (STRUCT_CASES_TAC(SPEC `n:num` num_CASES) THEN
   ASM_REWRITE_TAC[heap_expand_def; NOT_SUC;
                   word_heap_def; word_el_def;
                   STAR_emp; CONJUNCT1 word_list_exists_thm;
                   ARITH_RULE `SUC n - 1 = n`; ADD1])
### get_lowerbits_or_1
  (CASES_ON_NAME "v" THEN
   REWRITE_TAC[get_lowerbits_def] THEN
   MATCH_REDUCE_TAC THEN WORD_BITWISE_TAC)
### INJ_FUPDATE
  (* the new key is not in the domain and the new value not in the
     range, so the update stays injective.  The negated existential
     of the range is turned into an implication, which is what
     ASM_SIMP_TAC can use of it *)
  (REWRITE_TAC[INJ; FDOM_FUPDATE; IN_INSERT; FMAP_IN_FRANGE;
               NOT_EXISTS_THM; DE_MORGAN_THM;
               TAUT `(~a \/ ~b) <=> (a ==> ~b)`;
               FAPPLY_FUPDATE_THM] THEN
   REPEAT STRIP_TAC THEN REPEAT COND_CASES_TAC THEN
   ASM_SIMP_TAC[] THEN ASM_MESON_TAC[])
### v_inv_swap_refs
  (* rule induction on v_inv_ck.  Every premise of a rule reads the
     refs through a lookup only, dest_thunk included, so lookups
     that agree at every pointer let the derivation be replayed
     with the other refs; the ck of the relation is untouched, and
     v_inv is the relation for every ck *)
  (let (vr,vi,vcases) = v_inv_ck in
   let rl = CONJUNCTS vr in
   let _ = vcases in
   let dt = prove
    (`!(v:dataSem_v) refs refs1.
        (!n. sptree_lookup n refs = sptree_lookup n refs1)
        ==> dataSem_dest_thunk v refs = dataSem_dest_thunk v refs1`,
     REPEAT STRIP_TAC THEN
     ASM_REWRITE_TAC[dataSem_dest_thunk_def]) in
   (* the assumption that the two lookups agree, which the cases of
      the induction each need in both directions *)
   let is_cnd th =
     let t = concl th in
     is_forall t &&
     (let b = snd(dest_forall t) in
      is_eq b &&
      (try fst(dest_const(fst(strip_comb(lhs b)))) = "sptree_lookup"
       with Failure _ -> false)) in
   let CND ttac =
     FIRST_ASSUM(fun th -> if is_cnd th then ttac th else fail()) in
   let PRE_TAC = REPEAT GEN_TAC THEN REPEAT STRIP_TAC in
   let swap = prove
    (`!ck conf (v:dataSem_v) refs1 y.
        v_inv_ck ck conf v refs1 y
        ==> !refs. (!n. sptree_lookup n refs = sptree_lookup n refs1)
                   ==> v_inv_ck ck conf v refs y`,
     MATCH_MP_TAC vi THEN REPEAT CONJ_TAC THENL
      [PRE_TAC THEN MATCH_MP_TAC(el 0 rl) THEN ASM_REWRITE_TAC[];
       PRE_TAC THEN MATCH_MP_TAC(el 1 rl) THEN ASM_REWRITE_TAC[];
       PRE_TAC THEN MATCH_MP_TAC(el 2 rl) THEN ASM_REWRITE_TAC[];
       PRE_TAC THEN MATCH_ACCEPT_TAC(el 3 rl);
       (* the annotation of the pointer is a lookup of the refs *)
       PRE_TAC THEN CND(fun cnd ->
         REWRITE_TAC[GSYM cnd] THEN MATCH_MP_TAC(el 4 rl) THEN
         REWRITE_TAC[cnd] THEN ASM_REWRITE_TAC[] THEN
         REPEAT CONJ_TAC THEN TRY(FIRST_ASSUM MATCH_ACCEPT_TAC));
       (* the thunk of the rule is named by its lookup, which is
          what MESON takes from the assumptions *)
       PRE_TAC THEN CND(fun cnd ->
         ASM_MESON_TAC[el 5 rl; MATCH_MP dt cnd]);
       PRE_TAC THEN CND(fun cnd ->
         ASM_MESON_TAC[el 6 rl; MATCH_MP dt cnd]);
       PRE_TAC THEN MATCH_MP_TAC(el 7 rl) THEN ASM_REWRITE_TAC[];
       (* and the elements of a Block are carried over one by one *)
       PRE_TAC THEN CND(fun cnd ->
         MATCH_MP_TAC(el 8 rl) THEN ASM_REWRITE_TAC[] THEN
         REPEAT CONJ_TAC THEN TRY(FIRST_ASSUM MATCH_ACCEPT_TAC) THEN
         DISCH_TAC THEN
         FIRST_X_ASSUM(fun ih ->
           FIRST_ASSUM(fun nz -> MP_TAC(MATCH_MP ih nz))) THEN
         MATCH_MP_TAC MONO_ALL2 THEN BETA_TAC THEN
         REPEAT STRIP_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
         ASM_REWRITE_TAC[])]) in
   REWRITE_TAC[v_inv_eq] THEN REPEAT STRIP_TAC THEN
   ASM_MESON_TAC[swap])
### bc_stack_ref_inv_swap_refs
  (* each part of the invariant reads the refs through a lookup
     only: the domain by domain_lookup, all_ts, all_vs and ref_edge
     by their definitions, and v_inv by v_inv_swap_refs.  So the
     whole of it is rewritten from the one refs to the other and
     the assumption is the goal *)
  (let domq = prove
    (`!refs refs1:(A)spt.
        (!n. sptree_lookup n refs = sptree_lookup n refs1)
        ==> domain refs = domain refs1`,
     REPEAT STRIP_TAC THEN
     REWRITE_TAC[EXTENSION; domain_lookup] THEN ASM_REWRITE_TAC[]) in
   let atq = prove
    (`!refs refs1 stack.
        (!n. sptree_lookup n refs = sptree_lookup n refs1)
        ==> all_ts refs stack = all_ts refs1 stack`,
     REPEAT STRIP_TAC THEN ASM_REWRITE_TAC[all_ts_def]) in
   let avq = prove
    (`!refs refs1 stack.
        (!n. sptree_lookup n refs = sptree_lookup n refs1)
        ==> all_vs refs stack = all_vs refs1 stack`,
     REPEAT STRIP_TAC THEN ASM_REWRITE_TAC[all_vs_def]) in
   let reqq = prove
    (`!refs refs1.
        (!n. sptree_lookup n refs = sptree_lookup n refs1)
        ==> ref_edge refs = ref_edge refs1`,
     REPEAT STRIP_TAC THEN REWRITE_TAC[FUN_EQ_THM] THEN
     REPEAT GEN_TAC THEN ASM_REWRITE_TAC[ref_edge_def]) in
   let rchq = prove
    (`!refs refs1.
        (!n. sptree_lookup n refs = sptree_lookup n refs1)
        ==> !roots t. reachable_refs roots refs t <=>
                      reachable_refs roots refs1 t`,
     REPEAT STRIP_TAC THEN
     REWRITE_TAC[reachable_refs_def] THEN
     FIRST_ASSUM(fun th -> REWRITE_TAC[MATCH_MP reqq th])) in
   let viq = prove
    (`!refs refs1.
        (!n. sptree_lookup n refs = sptree_lookup n refs1)
        ==> !c (v:dataSem_v) y. v_inv c v refs y <=>
                                v_inv c v refs1 y`,
     REPEAT GEN_TAC THEN DISCH_TAC THEN
     REWRITE_TAC[FORALL_PAIR_THM] THEN REPEAT GEN_TAC THEN
     EQ_TAC THEN ASM_MESON_TAC[v_inv_swap_refs]) in
   let dtq = prove
    (`!refs refs1.
        (!n. sptree_lookup n refs = sptree_lookup n refs1)
        ==> !v. dataSem_dest_thunk v refs =
                dataSem_dest_thunk v refs1`,
     REPEAT STRIP_TAC THEN
     ASM_REWRITE_TAC[dataSem_dest_thunk_def]) in
   let brq = prove
    (`!refs refs1.
        (!n. sptree_lookup n refs = sptree_lookup n refs1)
        ==> !c n x. bc_ref_inv c n refs x <=> bc_ref_inv c n refs1 x`,
     REPEAT GEN_TAC THEN DISCH_TAC THEN
     REWRITE_TAC[FORALL_PAIR_THM] THEN REPEAT GEN_TAC THEN
     FIRST_ASSUM(fun th ->
       ASM_REWRITE_TAC[bc_ref_inv_def; MATCH_MP viq th;
                       MATCH_MP dtq th])) in
   DISCH_THEN(CONJUNCTS_THEN2 MP_TAC ASSUME_TAC) THEN
   FIRST_ASSUM(fun cnd ->
     DISCH_THEN(MP_TAC o REWRITE_RULE
       [bc_stack_ref_inv_def; MATCH_MP domq cnd;
        MATCH_MP atq cnd; MATCH_MP avq cnd; MATCH_MP rchq cnd;
        MATCH_MP viq cnd; MATCH_MP brq cnd]) THEN
     REWRITE_TAC[bc_stack_ref_inv_def]))
### blocks_unique_SUBSET
  (REWRITE_TAC[blocks_unique_def; SUBSET] THEN
   REPEAT GEN_TAC THEN STRIP_TAC THEN REPEAT GEN_TAC THEN
   DISCH_THEN STRIP_ASSUME_TAC THEN FIRST_ASSUM MATCH_MP_TAC THEN
   ASM_SIMP_TAC[])
### blocks_unique_INSERT
  (let inst a b c d =
     FIRST_ASSUM(fun h -> MP_TAC(SPECL [`t:num`; a; b; c; d] h)) THEN
     ANTS_TAC THENL
      [REPEAT CONJ_TAC THEN FIRST_ASSUM ACCEPT_TAC; ALL_TAC] in
   let a1 = `a1:num` and x1 = `xs1:dataSem_v list`
   and a2 = `a2:num` and x2 = `xs2:dataSem_v list` in
   REWRITE_TAC[blocks_unique_def; IN_INSERT;
               injectivity "dataSem_v"] THEN
   DISCH_TAC THEN REPEAT GEN_TAC THEN DISCH_THEN STRIP_ASSUME_TAC THEN
   FIRST
    [ASM_REWRITE_TAC[] THEN ARITH_TAC;
     inst a1 x1 a2 x2 THEN STRIP_TAC THEN ASM_REWRITE_TAC[] THEN
     ASM_ARITH_TAC;
     inst a2 x2 a2 x2 THEN STRIP_TAC THEN
     SUBGOAL_THEN `F` CONTR_TAC THEN ASM_ARITH_TAC;
     inst a1 x1 a1 x1 THEN STRIP_TAC THEN
     SUBGOAL_THEN `F` CONTR_TAC THEN ASM_ARITH_TAC])
### all_ts_CONS_SUBSET
  (MATCH_MP_TAC all_ts_SUBSET_gen THEN REWRITE_TAC[MEM] THEN
   MESON_TAC[])
### in_all_vs_stack
  (DISCH_TAC THEN
   REWRITE_TAC[all_vs_def; IN_UNION; IN_ELIM_THM] THEN
   REPEAT DISJ2_TAC THEN ASM_REWRITE_TAC[])
### in_all_vs_MutBlock
  (REPEAT STRIP_TAC THEN
   REWRITE_TAC[all_vs_def; IN_UNION; IN_ELIM_THM] THEN
   DISJ2_TAC THEN DISJ2_TAC THEN DISJ1_TAC THEN ASM_MESON_TAC[])
### all_vs_CONS_SUBSET
  (* the three parts of all_vs that read the refs are the same, and
     a value of the head is a value of the refs or of the stack
     already, because the head itself is *)
  (let (vnil,vsing,vats,vcons) = v_all_vs_clauses () in
   DISCH_TAC THEN REWRITE_TAC[SUBSET] THEN GEN_TAC THEN
   GEN_REWRITE_TAC (LAND_CONV o RAND_CONV) [all_vs_def] THEN
   REWRITE_TAC[IN_UNION; IN_ELIM_THM] THEN
   GEN_REWRITE_TAC ONCE_DEPTH_CONV [vcons] THEN
   REWRITE_TAC[MEM_APPEND] THEN STRIP_TAC THEN
   RULE_ASSUM_TAC(REWRITE_RULE[vnil; MEM]) THEN
   TRY(FIRST_ASSUM CONTR_TAC) THEN
   TRY(FIRST_ASSUM(fun m -> FIRST_ASSUM(fun xm ->
     MATCH_ACCEPT_TAC(MATCH_MP v_in_all_vs
       (CONJ xm m))))) THEN
   REWRITE_TAC[all_vs_def; IN_UNION; IN_ELIM_THM] THEN
   ASM_MESON_TAC[])
### all_vs_MutBlock_centre
  (* the centre of the MutBlock is a value of the refs already, so
     putting it on the stack adds nothing *)
  (DISCH_TAC THEN MATCH_MP_TAC all_vs_CONS_SUBSET THEN
   ASM_MESON_TAC[in_all_vs_MutBlock; MEM_v_all_vs; MEM_APPEND; MEM])
### all_vs_MutBlock_T
  (* the three parts of all_vs that read the refs see the cell at
     ptr with the payload it had, and the new stack carries that
     payload and the written value: so a value of the left side is
     a value of the refs, a value of the new stack, or the new
     Block itself *)
  (let (vnil,vsing,vats,vcons) = v_all_vs_clauses () in
   (* the values of the stack with the new Block in front: the
      Block itself, the three parts of its payload, and the rest *)
   let stack_mem = prove
    (`MEM (w:dataSem_v)
        (v_all_vs (Block t2 g (p ++ [q] ++ s) :: l)) <=>
      w = Block t2 g (p ++ [q] ++ s) \/ MEM w (v_all_vs p) \/
      MEM w (v_all_vs [q]) \/ MEM w (v_all_vs s) \/
      MEM w (v_all_vs l)`,
     GEN_REWRITE_TAC (LAND_CONV o RAND_CONV) [vcons] THEN
     REWRITE_TAC[vsing; MEM_APPEND; MEM; v_all_vs_append] THEN
     CONV_TAC TAUT) in
   (* and the values of a stack of two values in front of a rest *)
   let vmem2 = prove
    (`MEM (w:dataSem_v) (v_all_vs (a :: aa :: l)) <=>
      MEM w (v_all_vs [a]) \/ MEM w (v_all_vs [aa]) \/
      MEM w (v_all_vs l)`,
     GEN_REWRITE_TAC (LAND_CONV o RAND_CONV) [vcons] THEN
     GEN_REWRITE_TAC (LAND_CONV o RAND_CONV o RAND_CONV)
       [vcons] THEN
     REWRITE_TAC[MEM_APPEND]) in
   (* the cell that the lookup of a part of all_vs found: at ptr it
      is the one the insert put there and away from ptr the one of
      the refs *)
   let open_lk =
     FIRST_X_ASSUM(fun th ->
       MP_TAC(CONV_RULE(LAND_CONV(REWR_CONV lookup_insert)) th)) THEN
     COND_CASES_TAC in
   let by_mut tac =
     SUBGOAL_THEN `MEM w (v_all_vs (left ++ [cen] ++ right))`
       (fun m -> FIRST_ASSUM(fun lk ->
          MATCH_ACCEPT_TAC(MATCH_MP in_all_vs_MutBlock (CONJ lk m))))
     THEN tac in
   let by_stack =
     SUBGOAL_THEN `MEM w (v_all_vs (res :: RefPtr b ptr :: vars))`
       (fun m -> MATCH_ACCEPT_TAC(MATCH_MP in_all_vs_stack m)) THEN
     ASM_REWRITE_TAC[vmem2] in
   (* a cell that is no MutBlock is not the one at ptr, and is the
      cell it was *)
   let plain =
     open_lk THENL
      [REWRITE_TAC[injectivity "option";
                   distinctness "bvlSem_ref"];
       DISCH_TAC THEN DISJ2_TAC THEN
       REWRITE_TAC[all_vs_def; IN_UNION; IN_ELIM_THM] THEN
       ASM_MESON_TAC[]] in
   DISCH_TAC THEN REWRITE_TAC[SUBSET] THEN
   X_GEN_TAC `w:dataSem_v` THEN
   GEN_REWRITE_TAC (LAND_CONV o RAND_CONV) [all_vs_def] THEN
   REWRITE_TAC[IN_UNION; IN_ELIM_THM; IN_INSERT; stack_mem] THEN
   DISCH_THEN STRIP_ASSUME_TAC THENL
    [(* the ValueArrays and the Thunks of the refs are untouched *)
     plain;
     plain;
     (* the cell at ptr keeps its payload, and the other MutBlocks
        are the ones they were *)
     open_lk THENL
      [REWRITE_TAC[injectivity "option";
                   injectivity "bvlSem_ref"] THEN
       STRIP_TAC THEN DISJ2_TAC THEN by_mut (ASM_REWRITE_TAC[]);
       DISCH_TAC THEN DISJ2_TAC THEN
       FIRST_ASSUM(fun m -> FIRST_ASSUM(fun lk ->
         MATCH_ACCEPT_TAC(MATCH_MP in_all_vs_MutBlock
           (CONJ lk m))))];
     (* the new Block itself *)
     ASM_REWRITE_TAC[];
     (* its left part and its right part are the payload of the
        cell at ptr *)
     DISJ2_TAC THEN
     by_mut (ASM_REWRITE_TAC[v_all_vs_append; MEM_APPEND]);
     (* and the written value and the rest of the stack are roots
        of the right side *)
     DISJ2_TAC THEN by_stack;
     DISJ2_TAC THEN
     by_mut (ASM_REWRITE_TAC[v_all_vs_append; MEM_APPEND]);
     DISJ2_TAC THEN by_stack])
### reachable_refs_MutBlock_centre
  (* the centre of the MutBlock is reachable from the pointer to it
     in one step of ref_edge, because it is inside the payload, so
     what the centre reaches the pointer reaches as well; a root
     other than the centre is a root of the shorter list *)
  (REWRITE_TAC[reachable_refs_def; MEM] THEN
   DISCH_THEN(CONJUNCTS_THEN2 ASSUME_TAC
     (REPEAT_TCL CHOOSE_THEN STRIP_ASSUME_TAC)) THENL
    [FIRST_X_ASSUM(fun th ->
       if is_eq(concl th) && is_var(lhand(concl th))
       then SUBST_ALL_TAC th else fail()) THEN
     MAP_EVERY EXISTS_TAC [`RefPtr b ptr:dataSem_v`; `ptr:num`] THEN
     REWRITE_TAC[get_refs_def; MEM] THEN
     MATCH_MP_TAC(CONJUNCT2 (SPEC_ALL RTC_RULES)) THEN
     EXISTS_TAC `r:num` THEN ASM_REWRITE_TAC[] THEN
     ASM_REWRITE_TAC[ref_edge_def] THEN MATCH_REDUCE_TAC THEN
     REWRITE_TAC[get_refs_def; MEM_FLAT; MEM_MAP; MEM_APPEND;
                 MEM] THEN
     ASM_MESON_TAC[];
     MAP_EVERY EXISTS_TAC [`x:dataSem_v`; `r:num`] THEN
     ASM_REWRITE_TAC[];
     MAP_EVERY EXISTS_TAC [`x:dataSem_v`; `r:num`] THEN
     ASM_REWRITE_TAC[]])
### ref_edge_insert_MutBlock
  (DISCH_TAC THEN REWRITE_TAC[FUN_EQ_THM] THEN REPEAT GEN_TAC THEN
   REWRITE_TAC[ref_edge_MutBlock] THEN COND_CASES_TAC THENL
    [SUBGOAL_THEN
       `sptree_lookup x (refs:(dataSem_v bvlSem_ref) spt) =
        SOME (bvlSem_MutBlock tg fin1 l c r)`
       ASSUME_TAC THENL
      [ASM_MESON_TAC[]; ALL_TAC] THEN
     ONCE_REWRITE_TAC[ref_edge_def] THEN ASM_REWRITE_TAC[] THEN
     MATCH_REDUCE_TAC THEN REWRITE_TAC[];
     REWRITE_TAC[]])
### reachable_refs_MutBlock_T
  (* the payload of the cell at ptr is the one it was, so the edges
     are the old ones; a ref that the new Block reaches it reaches
     through its left part, the written value or its right part,
     and the first and the last of those are in the payload of the
     cell, which the pointer reaches in one step *)
  (let blk_refs = prove
    (`MEM ss (get_refs (Block tt aa ys)) <=>
      ?yy. MEM yy ys /\ MEM ss (get_refs yy)`,
     REWRITE_TAC[get_refs_def; MEM_FLAT; MEM_MAP] THEN
     MESON_TAC[]) in
   let by_ptr =
     MAP_EVERY EXISTS_TAC [`RefPtr b ptr:dataSem_v`; `ptr:num`] THEN
     REWRITE_TAC[get_refs_def; MEM] THEN
     MATCH_MP_TAC(CONJUNCT2(SPEC_ALL RTC_RULES)) THEN
     EXISTS_TAC `rr:num` THEN ASM_REWRITE_TAC[] THEN
     ASM_REWRITE_TAC[ref_edge_def] THEN MATCH_REDUCE_TAC THEN
     REWRITE_TAC[blk_refs; MEM_APPEND; MEM] THEN
     EXISTS_TAC `yy:dataSem_v` THEN ASM_REWRITE_TAC[] in
   DISCH_THEN(CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
   FIRST_ASSUM(fun th ->
     REWRITE_TAC[reachable_refs_def; MEM;
                 MATCH_MP ref_edge_insert_MutBlock th]) THEN
   DISCH_THEN(X_CHOOSE_THEN `xx:dataSem_v`
     (X_CHOOSE_THEN `rr:num` STRIP_ASSUME_TAC)) THEN
   REWRITE_TAC[reachable_refs_def; MEM] THENL
    [FIRST_X_ASSUM SUBST_ALL_TAC THEN
     FIRST_X_ASSUM(fun th ->
       MP_TAC(CONV_RULE(REWR_CONV blk_refs) th)) THEN
     REWRITE_TAC[MEM_APPEND; MEM] THEN
     DISCH_THEN(X_CHOOSE_THEN `yy:dataSem_v`
       STRIP_ASSUME_TAC) THENL
      [by_ptr;
       MAP_EVERY EXISTS_TAC [`yy:dataSem_v`; `rr:num`] THEN
       ASM_REWRITE_TAC[];
       by_ptr];
     MAP_EVERY EXISTS_TAC [`xx:dataSem_v`; `rr:num`] THEN
     ASM_REWRITE_TAC[]])
### dest_thunk_insert_MutBlock
  (* and a MutBlock is no Thunk, so the dest_thunk of the pointer
     is NotThunk before the insert and after it *)
  (let dt_def = dataSem_dest_thunk_def in
   let opt_rws = [distinctness "option"; injectivity "option"] in
   let ref_rws = [distinctness "bvlSem_ref"; injectivity "bvlSem_ref";
                  distinctness "thunk_mode"] in
   DISCH_TAC THEN CASES_ON_NAME "v" THEN
   ONCE_REWRITE_TAC[dt_def] THEN
   SAFE_MATCH_REDUCE_TAC THEN REWRITE_TAC[] THEN
   REWRITE_TAC[lookup_insert] THEN
   ASM_CASES_TAC `a1:num = ptr` THEN ASM_REWRITE_TAC[] THEN
   TRY MATCH_REDUCE_TAC THEN
   REWRITE_TAC(opt_rws @ ref_rws) THEN
   REPEAT COND_CASES_TAC THEN REWRITE_TAC[])
### bc_stack_ref_inv_union_del_ins_lemma
  (* the two refs have the same lookup everywhere: at ptr the delete
     takes the value out of the left half and the insert puts the
     same value in the right one, and away from ptr neither changes
     anything *)
  (STRIP_TAC THEN
   SUBGOAL_THEN
     `!n. sptree_lookup n
            (sptree_union (refs:(dataSem_v bvlSem_ref) spt) frame) =
          sptree_lookup n (sptree_union (sptree_delete ptr refs)
                             (sptree_insert ptr x frame))`
     ASSUME_TAC THENL
    [GEN_TAC THEN
     REWRITE_TAC[lookup_union; OPT_MATCH_COND; lookup_delete;
                 lookup_insert] THEN
     ASM_CASES_TAC `n:num = ptr` THEN
     ASM_REWRITE_TAC[distinctness "option"];
     ALL_TAC] THEN
   FIRST_ASSUM(fun c -> FIRST_ASSUM(fun h ->
     MATCH_ACCEPT_TAC(MATCH_MP
       bc_stack_ref_inv_swap_refs (CONJ h c)))))
### memory_rel_FinaliseCons
  (* the finalisation of a cons: what it does to the refs and to
     the timestamp is what bc_stack_ref_inv_FinaliseCons_lemma
     says of the invariant of the stack, with no frame beside the
     refs (the union with the empty tree is the tree).  The heap,
     the roots and the words of the roots are the same, so the
     memory_rel goes back together as it came apart *)
  (let hd_is n t =
      (try fst(dest_const(fst(strip_comb t))) = n
       with Failure _ -> false) in
    let grab asl p =
      tryfind (fun (_,th) ->
        if (try p th with Failure _ -> false) then th else fail())
        asl in
    (* an ALL2 whose second list is a cons *)
    let all2cons = prove
     (`!P h t (l:(A)list).
         ALL2 P l (CONS (h:B) t) <=>
         ?a b. l = CONS a b /\ P a h /\ ALL2 P b t`,
      REPEAT GEN_TAC THEN
      STRUCT_CASES_TAC(ISPEC `l:(A)list` list_CASES) THEN
      REWRITE_TAC[ALL2; NOT_CONS_NIL; CONS_11] THEN MESON_TAC[]) in
    (* the union with the empty tree on the right *)
    let union_LN = prove
     (`!t. sptree_union t (LN:(A)spt) = t`,
      MATCH_MP_TAC spt_INDUCT THEN REPEAT CONJ_TAC THEN
      REPEAT GEN_TAC THEN TRY(DISCH_THEN(K ALL_TAC)) THEN
      REWRITE_TAC[union_def] THEN
      TRY MATCH_REDUCE_TAC THEN REWRITE_TAC[]) in
  DISCH_THEN(CONJUNCTS_THEN2 MP_TAC ASSUME_TAC) THEN
    REWRITE_TAC[memory_rel_def; word_ml_inv_def;
                abs_ml_inv_def; MAP; FST] THEN
    DISCH_THEN STRIP_ASSUME_TAC THEN
    FIRST_X_ASSUM(fun a2 ->
      if hd_is "ALL2" (concl a2)
      then MP_TAC(REWRITE_RULE[MAP; SND; all2cons] a2) else fail()) THEN
    DISCH_THEN STRIP_ASSUME_TAC THEN
    FIRST_X_ASSUM(fun e ->
      if is_eq (concl e) && is_var (lhs (concl e)) &&
         hd_is "CONS" (rhs (concl e))
      then SUBST_ALL_TAC e else fail()) THEN
    W(fun (asl,w) ->
      let th0 = bc_stack_ref_inv_FinaliseCons_lemma in
      let vs = fst(strip_forall (concl th0)) in
      let th1 = REWRITE_RULE[union_LN]
        (SPECL (map (fun v ->
           if fst(dest_var v) = "frame"
           then `LN:((dataSem_v)bvlSem_ref)spt` else v) vs) th0) in
      let bs = grab asl (fun th ->
        hd_is "bc_stack_ref_inv" (concl th)) in
      let fc = grab asl (fun th ->
        hd_is "dataSem_finalise_cons" (lhs (concl th))) in
      MP_TAC(MATCH_MP th1
        (CONJ fc (CONJ (REFL (rand (lhs (concl fc)))) bs)))) THEN
    DISCH_THEN(CONJUNCTS_THEN2 ASSUME_TAC ASSUME_TAC) THEN
    CONJ_TAC THENL [FIRST_ASSUM ACCEPT_TAC; ALL_TAC] THEN
    REWRITE_TAC[memory_rel_def; word_ml_inv_def;
                abs_ml_inv_def; MAP; FST] THEN
    W(fun (asl,w) ->
      let hm = grab asl (fun th ->
        hd_is "heap_in_memory_store" (concl th)) in
      let args = snd(strip_comb (concl hm)) in
      EXISTS_TAC (el 0 args) THEN EXISTS_TAC (el 9 args) THEN
      EXISTS_TAC (el 1 args) THEN EXISTS_TAC (el 2 args) THEN
      EXISTS_TAC (el 3 args) THEN EXISTS_TAC (el 4 args)) THEN
    ASM_REWRITE_TAC[] THEN
    W(fun (asl,w) ->
      let bs = grab asl (fun th ->
        hd_is "bc_stack_ref_inv" (concl th)) in
      EXISTS_TAC (fst(dest_pair
        (el 4 (snd(strip_comb (concl bs))))))) THEN
    ASM_REWRITE_TAC[ALL2])
### memory_rel_Cons_empty
  (* the empty Block of a tag has the root Data (Word (BlockNil
     tag)), which cons_thm_EMPTY adds, and the BlockNil is sixteen
     times the tag plus two, whose lowest bit is clear.  HOL4 has
     that last fact as BlockNil_and_lemma; the port's statement of
     that lemma is the and of the complement with the multiple of
     sixteen, not with the sum (see ISSUES.md, "The precedence of a
     word's bitwise operators"), so the fact is proved again here *)
  (let bw2 = prove
     (`!i. bit i (word 2:(N)word) <=> i = 1 /\ 1 < dimindex(:N)`,
      GEN_TAC THEN
      GEN_REWRITE_TAC (LAND_CONV o RAND_CONV o RAND_CONV)
        [ARITH_RULE `2 = 2 EXP 1`] THEN
      REWRITE_TAC[BIT_WORD_POW2]) in
    let addor = prove
     (`!(v:(N)word). word_shl v 4 + word 2 = word_shl v 4 || word 2`,
      GEN_TAC THEN MATCH_MP_TAC WORD_ADD_OR THEN
      REWRITE_TAC[WORD_EQ_BITS_ALT; BIT_WORD_AND; BIT_WORD_0;
                  BIT_WORD_SHL; bw2] THEN
      X_GEN_TAC `i:num` THEN DISCH_TAC THEN
      ASM_CASES_TAC `(i:num) = 1` THEN ASM_REWRITE_TAC[] THEN
      CONV_TAC NUM_REDUCE_CONV THEN TRY(CONV_TAC TAUT)) in
    let andsum = prove
     (`!(tag:(N)word).
         (word_shl tag 4 + word 2) && word_not (word 1) =
         word_shl tag 4 + word 2`,
      GEN_TAC THEN REWRITE_TAC[addor] THEN
      REWRITE_TAC[WORD_EQ_BITS_ALT; BIT_WORD_AND; BIT_WORD_NOT;
                  BIT_WORD_1; BIT_WORD_OR; BIT_WORD_SHL; bw2] THEN
      X_GEN_TAC `i:num` THEN DISCH_TAC THEN
      ASM_CASES_TAC `(i:num) = 0` THEN ASM_REWRITE_TAC[] THEN
      CONV_TAC NUM_REDUCE_CONV THEN TRY(CONV_TAC TAUT)) in
    let waddr = hd (word_addr_clauses ()) in
    REWRITE_TAC[memory_rel_def; word_ml_inv_def] THEN
    REPEAT STRIP_TAC THEN ASM_EXISTS_TAC THEN
    ASM_REWRITE_TAC[] THEN
    EXISTS_TAC
      `CONS (gc_shared_Data (wordLang_Word (BlockNil tag:'a word))) hs`
    THEN
    REWRITE_TAC[MAP; ALL2; waddr] THEN
    ASM_REWRITE_TAC[] THEN
    CONJ_TAC THENL
     [MATCH_MP_TAC cons_thm_EMPTY THEN ASM_REWRITE_TAC[];
      REWRITE_TAC[BlockNil_def] THEN AP_TERM_TAC THEN
      MATCH_ACCEPT_TAC andsum])
### word_list_AND_word_list_exists_IMP
  (* a word_list that lies inside free space takes the front of it:
     the cell of the head is the first cell of the space (both are
     the memory at the address, which read_fun2set reads off), and
     the induction hypothesis takes the tail with that cell in the
     frame *)
  (let has nm th =
     can (find_term (fun t ->
       (try fst(dest_const(fst(strip_comb t))) = nm
        with Failure _ -> false))) (concl th) in
   let aux = prove
    (`!(ws:(M)list) (aa:(N)word) frame n m dm.
        (misc_word_list aa ws * SEP_T) (fun2set (m,dm)) /\
        (word_list_exists aa n * frame) (fun2set (m,dm)) /\
        LENGTH ws <= n
        ==> (misc_word_list aa ws *
             word_list_exists (aa + bytes_in_word * n2w (LENGTH ws))
               (n - LENGTH ws) * frame) (fun2set (m,dm))`,
     LIST_INDUCT_TAC THEN REPEAT GEN_TAC THENL
      [REWRITE_TAC[word_list_def; LENGTH; emp_STAR;
                   SUB_0; WORD_ADD_MUL_0] THEN
       STRIP_TAC THEN ASM_REWRITE_TAC[];
       ALL_TAC] THEN
     STRIP_TAC THEN
     (SUBGOAL_THEN `?n':num. n = SUC n'` MP_TAC THENL
       [EXISTS_TAC `n - 1` THEN
        FIRST_X_ASSUM(fun th -> MP_TAC th) THEN
        REWRITE_TAC[LENGTH] THEN ARITH_TAC;
        ALL_TAC]) THEN
     DISCH_THEN(X_CHOOSE_THEN `n':num` SUBST_ALL_TAC) THEN
     RULE_ASSUM_TAC(REWRITE_RULE
       [word_list_def; LENGTH;
        word_list_exists_thm;
        SEP_EXISTS_STAR; SEP_EXISTS_THM]) THEN
     FIRST_X_ASSUM(fun ex ->
       if is_exists (concl ex) then
         X_CHOOSE_THEN `w:M` ASSUME_TAC ex else fail()) THEN
     REWRITE_TAC[word_list_def; LENGTH] THEN
     REWRITE_TAC[ARITH_RULE `SUC a - SUC b = a - b`;
                 WORD_ADD_MUL_SUC] THEN
     SUBGOAL_THEN `(w:M) = h` SUBST_ALL_TAC THENL
      [FIRST_ASSUM(fun a1 ->
         if has "SEP_T" a1
         then MP_TAC(MATCH_MP read_fun2set
                (REWRITE_RULE[GSYM STAR_ASSOC] a1))
         else fail()) THEN
       FIRST_ASSUM(fun a2 ->
         if has "word_list_exists" a2
         then MP_TAC(MATCH_MP read_fun2set
                (REWRITE_RULE[GSYM STAR_ASSOC] a2))
         else fail()) THEN
       MESON_TAC[];
       ALL_TAC] THEN
     FIRST_X_ASSUM(fun ih ->
       if is_forall (concl ih) then
         MP_TAC(SPECL [`aa + bytes_in_word:(N)word`;
                       `set_sep_one (aa:(N)word,h:M) *
                        frame`;
                       `n':num`; `m:(N)word->M`;
                       `dm:(N)word->bool`] ih)
       else fail()) THEN
     ANTS_TAC THENL
      [REPEAT CONJ_TAC THENL
        [FIRST_ASSUM(fun a1 ->
           if has "SEP_T" a1
           then MP_TAC(REWRITE_RULE[GSYM STAR_ASSOC; STAR_SEP_T] a1)
           else fail()) THEN
         REWRITE_TAC[STAR_SEP_T] THEN
         DISCH_THEN(X_CHOOSE_THEN `u:((N)word # M)->bool`
           (CONJUNCTS_THEN2 ASSUME_TAC
             (fun st -> MP_TAC(REWRITE_RULE[one_STAR] st)))) THEN
         DISCH_THEN(CONJUNCTS_THEN2 (K ALL_TAC) ASSUME_TAC) THEN
         EXISTS_TAC
           `(u:((N)word # M)->bool) DELETE (aa,h)` THEN
         ASM_REWRITE_TAC[] THEN
         FIRST_X_ASSUM(fun th ->
           if has "SUBSET" th then MP_TAC th else fail()) THEN
         SET_TAC[];
         FIRST_ASSUM(fun a2 ->
           if has "word_list_exists" a2 then MP_TAC a2 else fail()) THEN
         REWRITE_TAC[STAR_AC];
         FIRST_X_ASSUM(fun th ->
           if has "LENGTH" th then MP_TAC th else fail()) THEN
         REWRITE_TAC[LENGTH] THEN ARITH_TAC];
       ALL_TAC] THEN
     DISCH_THEN(fun th -> MP_TAC th) THEN
     REWRITE_TAC[STAR_AC]) in
   REPEAT GEN_TAC THEN MATCH_ACCEPT_TAC aux)
### memory_rel_REPLICATE
  (MATCH_MP_TAC memory_rel_rearrange THEN
   GEN_TAC THEN REWRITE_TAC[MEM_APPEND; MEM_REPLICATE; MEM] THEN
   CONV_TAC TAUT)
### set_byte_word_of_byte
  (* every set_byte of the word that repeats a byte writes the byte
     it already has there: the byte index is a multiple of eight, so
     the position inside the byte is the position modulo eight, and
     that is the bit of the byte that word_of_byte put there *)
  (let bsb0 = prove
    (`!(a:(N)word) b (h:(N)word) bb j. j < dimindex (:N)
        ==> (bit j (set_byte a b h bb) <=>
             (if byte_index a bb <= j /\ j < byte_index a bb + 8
              then bit (j - byte_index a bb) b else bit j h))`,
     REPEAT GEN_TAC THEN DISCH_TAC THEN
     REWRITE_TAC[set_byte_def] THEN
     CONV_TAC(TOP_DEPTH_CONV let_CONV) THEN
     ASM_SIMP_TAC[BIT_WORD_OR; BIT_WORD_SLICE_ALT_LT; BIT_WORD_SHL;
                  BIT_WORD_ZX; DIMINDEX_8] THEN
     MP_TAC(REWRITE_RULE[DIMINDEX_8]
       (ISPECL [`b:(8)word`; `j - byte_index (a:(N)word) bb`]
          BIT_TRIVIAL)) THEN
     ASM_CASES_TAC `byte_index (a:(N)word) bb <= j` THEN
     ASM_CASES_TAC `j < byte_index (a:(N)word) bb + 8` THEN
     ASM_CASES_TAC `bit j (h:(N)word)` THEN
     ASM_CASES_TAC
       `bit (j - byte_index (a:(N)word) bb) (b:(8)word)` THEN
     ASM_REWRITE_TAC[] THEN ARITH_NO_BIT_TAC) in
   let modgen = prove
    (`!i k. 8 * k <= i /\ i < 8 * k + 8 ==> i MOD 8 = i - 8 * k`,
     REPEAT GEN_TAC THEN STRIP_TAC THEN
     SUBGOAL_THEN `(8 * k + (i - 8 * k)) MOD 8 = i - 8 * k` MP_TAC THENL
      [ONCE_REWRITE_TAC[ARITH_RULE `8 * k + r = k * 8 + r`] THEN
       REWRITE_TAC[MOD_MULT_ADD] THEN
       MATCH_MP_TAC MOD_LT THEN ASM_ARITH_TAC;
       ASM_SIMP_TAC[ARITH_RULE
         `8 * k <= i ==> 8 * k + (i - 8 * k) = i`]]) in
   let modfacts =
     map (fun k -> REWRITE_RULE[LE_0; SUB_0]
       (CONV_RULE NUM_REDUCE_CONV
         (SPECL [`i:num`; mk_small_numeral k] modgen)))
       [0; 1; 2; 3; 4; 5; 6; 7] in
   let bix8 = prove
    (`!(a:'a word) bb. ?k. byte_index a bb = 8 * k /\
                           (0 < dimindex (:'a) DIV 8
                            ==> k < dimindex (:'a) DIV 8)`,
     REPEAT GEN_TAC THEN
     REWRITE_TAC[byte_index_def] THEN
     CONV_TAC(TOP_DEPTH_CONV let_CONV) THEN
     COND_CASES_TAC THENL
      [EXISTS_TAC `(dimindex (:'a) DIV 8 - 1) -
                   w2n (a:'a word) MOD (dimindex (:'a) DIV 8)`;
       EXISTS_TAC `w2n (a:'a word) MOD (dimindex (:'a) DIV 8)`] THEN
     REWRITE_TAC[] THEN DISCH_TAC THEN
     ASM_SIMP_TAC[DIVISION] THEN ASM_ARITH_TAC) in
   let rules =
     let num k = mk_small_numeral k in
     let le a b = mk_binop `(<=):num->num->bool` a b in
     let lt a b = mk_binop `(<):num->num->bool` a b in
     let iv = `i:num` in
     let ks = [8; 16; 24; 32; 40; 48; 56; 64] in
     itlist (fun k acc -> itlist (fun k2 acc ->
       (if k <= k2
        then [ARITH_RULE(mk_imp(le (num k2) iv, le (num k) iv));
              ARITH_RULE(mk_imp(lt iv (num k), lt iv (num k2)))]
        else []) @
       (if k2 <= k
        then [ARITH_RULE(mk_imp(lt iv (num k2), mk_neg(le (num k) iv)));
              ARITH_RULE(mk_imp(le (num k) iv, mk_neg(lt iv (num k2))))]
        else []) @ acc) ks acc) ks
       [ARITH_RULE `i < 64 ==> (i - m < 64 <=> T)`;
        ARITH_RULE `i < 32 ==> (i - m < 32 <=> T)`;
        ARITH_RULE `(8 <= i - 8 <=> 16 <= i) /\
                    (8 <= i - 16 <=> 24 <= i) /\
                    (8 <= i - 24 <=> 32 <= i) /\
                    (8 <= i - 32 <=> 40 <= i) /\
                    (8 <= i - 40 <=> 48 <= i) /\
                    (8 <= i - 48 <=> 56 <= i) /\
                    (16 <= i - 32 <=> 48 <= i)`] in
   let killbit tm =
     TRY(MP_TAC(REWRITE_RULE[DIMINDEX_8]
           (ISPECL [`w:(8)word`; tm] BIT_TRIVIAL)) THEN
         (ANTS_TAC THENL
           [ASM_ARITH_TAC;
            DISCH_THEN(fun th -> REWRITE_TAC[th])])) in
   let wobbit = prove
    (`!i. good_dimindex (:'a) /\ i < dimindex (:'a)
          ==> (bit i (word_of_byte ((w2w (w:(8)word)):'a word)) <=>
               bit (i MOD 8) w)`,
     GEN_TAC THEN STRIP_TAC THEN
     FIRST_ASSUM(DISJ_CASES_THEN ASSUME_TAC o
       REWRITE_RULE[good_dimindex_def]) THEN
     REWRITE_TAC[word_of_byte_def] THEN
     CONV_TAC(TOP_DEPTH_CONV let_CONV) THEN
     ASM_REWRITE_TAC[] THEN CONV_TAC NUM_REDUCE_CONV THEN
     REWRITE_TAC[BIT_WORD_OR; BIT_WORD_SHL; BIT_WORD_ZX;
                 DIMINDEX_8] THEN
     REWRITE_TAC[ARITH_RULE
       `(((i - 32) - 16) - 8 = i - 56) /\ ((i - 32) - 16 = i - 48) /\
        ((i - 32) - 8 = i - 40) /\ ((i - 16) - 8 = i - 24)`] THEN
     (SUBGOAL_THEN
        `(i:num) < 8 \/ (8 <= i /\ i < 16) \/ (16 <= i /\ i < 24) \/
         (24 <= i /\ i < 32) \/ (32 <= i /\ i < 40) \/
         (40 <= i /\ i < 48) \/ (48 <= i /\ i < 56) \/
         (56 <= i /\ i < 64)`
        MP_TAC THENL [ASM_ARITH_TAC; ALL_TAC]) THEN
     STRIP_TAC THEN
     killbit `i:num` THEN killbit `i - 8` THEN killbit `i - 16` THEN
     killbit `i - 24` THEN killbit `i - 32` THEN killbit `i - 40` THEN
     killbit `i - 48` THEN
     ASM_SIMP_TAC (modfacts @ rules) THEN
     TRY(SUBGOAL_THEN `F` CONTR_TAC THEN ASM_ARITH_TAC)) in
   let stripconj =
     REPEAT(FIRST_X_ASSUM(fun th ->
       if is_conj (concl th) then STRIP_ASSUME_TAC th else fail())) in
   DISCH_TAC THEN
   REWRITE_TAC[WORD_EQ_BITS_ALT] THEN
   X_GEN_TAC `i:num` THEN DISCH_TAC THEN
   ASM_SIMP_TAC[bsb0; wobbit] THEN
   W(fun (asl,w) ->
     let bidx = find_term (fun t ->
       (try fst(dest_const(fst(strip_comb t))) = "byte_index"
        with Failure _ -> false)) w in
     MP_TAC(ISPECL (snd(strip_comb bidx)) bix8)) THEN
   DISCH_THEN(X_CHOOSE_THEN `k:num` STRIP_ASSUME_TAC) THEN
   ASM_REWRITE_TAC[] THEN
   COND_CASES_TAC THEN ASM_REWRITE_TAC[] THEN
   stripconj THEN
   FIRST_ASSUM(fun th1 -> FIRST_ASSUM(fun th2 ->
     MP_TAC(MATCH_MP modgen (CONJ th1 th2)) THEN
     DISCH_THEN SUBST1_TAC THEN REWRITE_TAC[])))
### w2w_word_of_byte_w2w
  (* the word of a byte repeats the byte, and the low eight bits of
     it are the byte itself: the shifts of the definition are by
     eight, sixteen and thirty-two, which no bit below eight is
     above *)
  (DISCH_TAC THEN
   REWRITE_TAC[WORD_EQ_BITS_ALT; DIMINDEX_8] THEN
   X_GEN_TAC `i:num` THEN DISCH_TAC THEN
   REWRITE_TAC[word_of_byte_def] THEN
   CONV_TAC(TOP_DEPTH_CONV let_CONV) THEN
   FIRST_ASSUM(DISJ_CASES_THEN (fun th -> ASSUME_TAC th) o
     REWRITE_RULE[good_dimindex_def]) THEN
   ASM_REWRITE_TAC[ARITH_EQ] THEN
   ASM_REWRITE_TAC[BIT_WORD_ZX; BIT_WORD_OR; BIT_WORD_SHL;
                   DIMINDEX_8] THEN
   ASM_SIMP_TAC[ARITH_RULE `i < 8 ==> ~(8 <= i)`;
                ARITH_RULE `i < 8 ==> ~(16 <= i)`;
                ARITH_RULE `i < 8 ==> ~(32 <= i)`;
                ARITH_RULE `i < 8 ==> i < 32`;
                ARITH_RULE `i < 8 ==> i < 64`])
### write_bytes_REPLICATE
  (* the words are written one by one, and writing the bytes of a
     word of one byte over and over leaves it as it is, which
     set_byte_word_of_byte says of each byte.  The flag of the
     endianness is called b2 in the two lemmas, because be is the
     field of the configuration and not a variable *)
  (let drop0 = prove
    (`!l:A list. DROP 0 l = l`,
     LIST_INDUCT_TAC THEN REWRITE_TAC[DROP]) in
   let drop_rep = prove
    (`!k m (x:A). DROP k (REPLICATE m x) = REPLICATE (m - k) x`,
     INDUCT_TAC THENL
      [REWRITE_TAC[drop0; SUB_0];
       REPEAT GEN_TAC THEN
       STRUCT_CASES_TAC(ISPEC `m:num` num_CASES) THEN
       ASM_REWRITE_TAC[REPLICATE; DROP; NOT_SUC; SUC_SUB1; SUB_0;
                       SUB_SUC; ARITH_RULE `0 - SUC k = 0`]]) in
   let head = prove
    (`good_dimindex (:'a) ==>
      !k a m b2.
        bytes_to_word k (a:'a word) (REPLICATE m (w:(8)word))
          (word_of_byte ((w2w w):'a word)) b2 =
        word_of_byte ((w2w w):'a word)`,
     DISCH_TAC THEN INDUCT_TAC THENL
      [ONCE_REWRITE_TAC[bytes_to_word_def] THEN
       REWRITE_TAC[];
       REPEAT GEN_TAC THEN
       ONCE_REWRITE_TAC[bytes_to_word_def] THEN
       REWRITE_TAC[NOT_SUC; SUC_SUB1] THEN
       STRUCT_CASES_TAC(ISPEC `m:num` num_CASES) THEN
       REWRITE_TAC[REPLICATE] THEN MATCH_REDUCE_TAC THEN
       ASM_REWRITE_TAC[] THEN
       ASM_SIMP_TAC[set_byte_word_of_byte]]) in
   INDUCT_TAC THENL
    [REWRITE_TAC[REPLICATE; write_bytes_def];
     GEN_TAC THEN DISCH_TAC THEN
     REWRITE_TAC[REPLICATE] THEN
     ONCE_REWRITE_TAC[write_bytes_def] THEN
     CONV_TAC(TOP_DEPTH_CONV let_CONV) THEN
     ASM_SIMP_TAC[head; drop_rep] THEN
     FIRST_ASSUM(fun th ->
       ASM_SIMP_TAC[SPEC `m - dimindex (:'a) DIV 8` th])])
### IMP_EXP_LESS
  (REWRITE_TAC[LE_EXP; ARITH_EQ] THEN ARITH_TAC)
### shift_shift_lemma
  (* the shift up and down of a word that keeps t of its bits:
     the bit that the two shifts leave at j is the one of n at
     j plus the word shift, and above t there is none, because
     n divided by the word shift is below two to the t *)
  (let ARITH_NO_DIV_TAC =
     POP_ASSUM_LIST(fun l ->
       MAP_EVERY MP_TAC
         (filter (fun th ->
            not (can (find_term (fun t ->
              (try fst(dest_const(fst(strip_comb t))) = "DIV"
               with Failure _ -> false))) (concl th))) l)) THEN
     ARITH_TAC in
   STRIP_TAC THEN
   REWRITE_TAC[WORD_EQ_BITS_ALT] THEN
   X_GEN_TAC `j:num` THEN DISCH_TAC THEN
   REWRITE_TAC[BIT_WORD_USHR; BIT_WORD_SHL; BIT_WORD] THEN
   SUBGOAL_THEN
     `(j + (l - t)) - (k - t) =
      j + backend_common_word_shift (:'a)`
     SUBST1_TAC THENL [ARITH_NO_DIV_TAC; ALL_TAC] THEN
   SUBGOAL_THEN `(n DIV i) DIV 2 EXP j =
                 n DIV 2 EXP (j + backend_common_word_shift (:'a))`
     SUBST1_TAC THENL
    [ASM_REWRITE_TAC[DIV_DIV; GSYM EXP_ADD] THEN
     AP_TERM_TAC THEN AP_TERM_TAC THEN ARITH_TAC;
     ALL_TAC] THEN
   ASM_CASES_TAC `(j:num) < t` THENL
    [SUBGOAL_THEN
       `(k - t <= j + (l - t)) /\ (j + (l - t) < dimindex (:'a)) /\
        (j + backend_common_word_shift (:'a) < dimindex (:'a)) /\
        j < dimindex (:'a)`
       (fun th -> REWRITE_TAC[th]) THENL
      [ARITH_NO_DIV_TAC];
     SUBGOAL_THEN
       `n DIV 2 EXP (j + backend_common_word_shift (:'a)) = 0`
       SUBST1_TAC THENL
      [SUBGOAL_THEN
         `n DIV 2 EXP (j + backend_common_word_shift (:'a)) =
          (n DIV i) DIV 2 EXP j` SUBST1_TAC THENL
        [ASM_REWRITE_TAC[DIV_DIV; GSYM EXP_ADD] THEN
         AP_TERM_TAC THEN AP_TERM_TAC THEN ARITH_TAC;
         MATCH_MP_TAC DIV_LT THEN
         TRANS_TAC LTE_TRANS `2 EXP t` THEN
         ASM_REWRITE_TAC[LE_EXP] THEN
         CONV_TAC NUM_REDUCE_CONV THEN ARITH_NO_DIV_TAC];
       REWRITE_TAC[ODD]]])
### write_bytes_APPEND
  (* induction on the first list of words: each word takes the
     bytes of its own length off the front, so the words of the
     second list see the bytes that the first list leaves *)
  (LIST_INDUCT_TAC THEN
   REWRITE_TAC[APPEND; write_bytes_def; LENGTH; MULT_CLAUSES;
               DROP_0] THEN
   REPEAT GEN_TAC THEN
   CONV_TAC(TOP_DEPTH_CONV let_CONV) THEN
   ASM_REWRITE_TAC[APPEND; DROP_DROP] THEN
   REWRITE_TAC[ARITH_RULE `(d * SUC n) = d + d * n`] THEN
   REWRITE_TAC[DROP_DROP; ADD_AC])
### set_byte_sort
  (* two set_bytes of a word commute when they write different
     bytes of it: the byte index of a number below the number of
     bytes is eight times it (or eight times its mirror), so two
     such indices are different, and no bit is in both ranges; when
     the two are the same byte the outer write covers the inner *)
  (let bsb0 = prove
  (`!(a:(N)word) b (h:(N)word) bb j. j < dimindex (:N)
      ==> (bit j (set_byte a b h bb) <=>
           (if byte_index a bb <= j /\ j < byte_index a bb + 8
            then bit (j - byte_index a bb) b else bit j h))`,
   REPEAT GEN_TAC THEN DISCH_TAC THEN
   REWRITE_TAC[set_byte_def] THEN
   CONV_TAC(TOP_DEPTH_CONV let_CONV) THEN
   ASM_SIMP_TAC[BIT_WORD_OR; BIT_WORD_SLICE_ALT_LT; BIT_WORD_SHL;
                BIT_WORD_ZX; DIMINDEX_8] THEN
   MP_TAC(REWRITE_RULE[DIMINDEX_8]
     (ISPECL [`b:(8)word`; `j - byte_index (a:(N)word) bb`]
        BIT_TRIVIAL)) THEN
   ASM_CASES_TAC `byte_index (a:(N)word) bb <= j` THEN
   ASM_CASES_TAC `j < byte_index (a:(N)word) bb + 8` THEN
   ASM_CASES_TAC `bit j (h:(N)word)` THEN
   ASM_CASES_TAC `bit (j - byte_index (a:(N)word) bb) (b:(8)word)` THEN
   ASM_REWRITE_TAC[] THEN ARITH_NO_BIT_TAC) in
 let bixval = prove
  (`!n bb. good_dimindex (:'a) /\ n < dimindex (:'a) DIV 8
      ==> byte_index ((n2w n):'a word) bb =
          8 * (if bb then (dimindex (:'a) DIV 8 - 1) - n else n)`,
   REPEAT GEN_TAC THEN
   REWRITE_TAC[good_dimindex_def; byte_index_def] THEN
   CONV_TAC(TOP_DEPTH_CONV let_CONV) THEN
   REWRITE_TAC[VAL_WORD; dimword] THEN
   STRIP_TAC THEN
   FIRST_ASSUM(fun dd ->
     if (try fst(dest_const(fst(strip_comb(lhs(concl dd))))) =
              "dimindex" with Failure _ -> false)
     then REWRITE_TAC[dd] THEN RULE_ASSUM_TAC(REWRITE_RULE[dd]) THEN
          ASSUME_TAC dd
     else fail()) THEN
   CONV_TAC NUM_REDUCE_CONV THEN
   RULE_ASSUM_TAC(fun th ->
     try CONV_RULE NUM_REDUCE_CONV th with Failure _ -> th) THEN
   (FIRST
     [(SUBGOAL_THEN `n MOD 4294967296 MOD 4 = n` SUBST1_TAC THENL
        [MP_TAC(SPECL [`n:num`; `4`; `1073741824`] MOD_MOD) THEN
         CONV_TAC NUM_REDUCE_CONV THEN
         DISCH_THEN SUBST1_TAC THEN
         MATCH_MP_TAC MOD_LT THEN ASM_ARITH_TAC;
         ALL_TAC]);
      (SUBGOAL_THEN `n MOD 18446744073709551616 MOD 8 = n`
         SUBST1_TAC THENL
        [MP_TAC(SPECL [`n:num`; `8`; `2305843009213693952`]
           MOD_MOD) THEN
         CONV_TAC NUM_REDUCE_CONV THEN
         DISCH_THEN SUBST1_TAC THEN
         MATCH_MP_TAC MOD_LT THEN ASM_ARITH_TAC;
         ALL_TAC])]) THEN
   COND_CASES_TAC THEN REWRITE_TAC[]) in
   let usebe =
     TRY(FIRST_ASSUM(fun th ->
       let c = concl th in
       if is_var c || (is_neg c && is_var (rand c))
       then RULE_ASSUM_TAC(REWRITE_RULE[th]) THEN ASSUME_TAC th
       else fail())) in
   let numred =
     RULE_ASSUM_TAC(fun th ->
       try CONV_RULE NUM_REDUCE_CONV th with Failure _ -> th) in
   let stripconj =
     REPEAT(FIRST_X_ASSUM(fun th ->
       if is_conj (concl th) then STRIP_ASSUME_TAC th else fail())) in
   REPEAT GEN_TAC THEN
   COND_CASES_TAC THENL
    [ASM_REWRITE_TAC[] THEN
     REWRITE_TAC[WORD_EQ_BITS_ALT] THEN
     X_GEN_TAC `i:num` THEN DISCH_TAC THEN
     ASM_SIMP_TAC[bsb0] THEN
     COND_CASES_TAC THEN REWRITE_TAC[];
     COND_CASES_TAC THENL
      [stripconj THEN
       REWRITE_TAC[WORD_EQ_BITS_ALT] THEN
       X_GEN_TAC `i:num` THEN DISCH_TAC THEN
       ASM_SIMP_TAC[bsb0; bixval] THEN
       REPEAT COND_CASES_TAC THEN usebe THEN numred THEN
       ASM_REWRITE_TAC[] THEN
       TRY(SUBGOAL_THEN `F` CONTR_TAC THEN ASM_ARITH_TAC);
       REWRITE_TAC[]]])
### set_byte_eq_ARB
  (* the bit of a set_byte is the byte's bit inside the byte and the
     word's outside it, so two set_bytes of the same byte agree
     exactly when the two words agree outside it -- which does not
     depend on what the byte is *)
  (let bsb = prove
    (`!a b (h:(N)word) bb j.
        byte_index a bb + 8 <= dimindex (:N) /\ j < dimindex (:N)
        ==> (bit j (set_byte a b h bb) <=>
             (if byte_index a bb <= j /\ j < byte_index a bb + 8
              then bit (j - byte_index a bb) b else bit j h))`,
     REPEAT GEN_TAC THEN STRIP_TAC THEN
     REWRITE_TAC[set_byte_def] THEN
     CONV_TAC(TOP_DEPTH_CONV let_CONV) THEN
     ASM_SIMP_TAC[BIT_WORD_OR; BIT_WORD_SLICE_ALT;
                  ARITH_RULE `0 <= (i:num)`;
                  BIT_WORD_SHL; BIT_WORD_ZX; DIMINDEX_8] THEN
     MP_TAC(REWRITE_RULE[DIMINDEX_8]
       (ISPECL [`b:(8)word`; `j - byte_index (a:(N)word) bb`]
          BIT_TRIVIAL)) THEN
     ASM_CASES_TAC `byte_index (a:(N)word) bb <= j` THEN
     ASM_CASES_TAC `j < byte_index (a:(N)word) bb + 8` THEN
     ASM_CASES_TAC `bit j (h:(N)word)` THEN
     ASM_CASES_TAC
       `bit (j - byte_index (a:(N)word) bb) (b:(8)word)` THEN
     ASM_REWRITE_TAC[] THEN ARITH_NO_BIT_TAC) in
   let bib = prove
    (`!(k:num) bb. good_dimindex (:'a)
        ==> byte_index ((n2w k):'a word) bb + 8 <= dimindex (:'a)`,
     REPEAT GEN_TAC THEN
     REWRITE_TAC[byte_index_def] THEN
     CONV_TAC(TOP_DEPTH_CONV let_CONV) THEN
     REWRITE_TAC[good_dimindex_def] THEN
     DISCH_THEN(DISJ_CASES_THEN (fun th -> SUBST1_TAC th)) THEN
     CONV_TAC NUM_REDUCE_CONV THEN
     (MP_TAC(SPEC `w2n ((n2w k):'a word)`
        (MATCH_MP DIVISION (ARITH_RULE `~(4 = 0)`))) ORELSE
      MP_TAC(SPEC `w2n ((n2w k):'a word)`
        (MATCH_MP DIVISION (ARITH_RULE `~(8 = 0)`)))) THEN
     COND_CASES_TAC THEN ARITH_TAC) in
   DISCH_TAC THEN REPEAT GEN_TAC THEN REPEAT CONJ_TAC THEN
   REWRITE_TAC[WORD_EQ_BITS_ALT] THEN
   ASM_SIMP_TAC[bsb; bib; COND_SAME_IFF])
### write_bytes_inj_lemma
  (* the words are written one by one: the first word of the one
     list and of the other are the same word written over the same
     bytes, which bytes_to_word_eq_lemma takes to the other bytes,
     and the rest follows by the induction with the bytes dropped *)
  (let len_drop = prove
    (`!k (l:A list). LENGTH (DROP k l) = LENGTH l - k`,
     INDUCT_TAC THEN LIST_INDUCT_TAC THEN
     ASM_REWRITE_TAC[DROP; LENGTH; SUB_0; NOT_SUC; SUC_SUB1;
                     ARITH_RULE `0 - SUC k = 0`; SUB_SUC]) in
   DISCH_TAC THEN LIST_INDUCT_TAC THEN GEN_TAC THEN
   CASES_ON_NAME "w2" THEN
   REWRITE_TAC[write_bytes_def; LENGTH; NOT_SUC;
               ARITH_RULE `~(0 = SUC n)`] THEN
   CONV_TAC(TOP_DEPTH_CONV let_CONV) THEN
   REWRITE_TAC[CONS_11; SUC_INJ] THEN REPEAT GEN_TAC THEN
   STRIP_TAC THEN CONJ_TAC THENL
    [FIRST_ASSUM(fun gd -> FIRST_ASSUM(fun lb -> FIRST_ASSUM(fun bw ->
       ACCEPT_TAC(MATCH_MP bytes_to_word_eq_lemma
         (CONJ gd (CONJ lb bw))))));
     FIRST_X_ASSUM MATCH_MP_TAC THEN
     FIRST_ASSUM(fun th ->
       EXISTS_TAC(rand(rator(rator(lhand(concl th))))) THEN
       ASM_REWRITE_TAC[len_drop])])
### set_byte_all_64
  (* and the eight bytes of a word of sixty-four bits cover it the
     same way *)
  (let bsb = prove
    (`!a b (h:(N)word) bb j.
        byte_index a bb + 8 <= dimindex (:N) /\ j < dimindex (:N)
        ==> (bit j (set_byte a b h bb) <=>
             (if byte_index a bb <= j /\ j < byte_index a bb + 8
              then bit (j - byte_index a bb) b else bit j h))`,
     REPEAT GEN_TAC THEN STRIP_TAC THEN
     REWRITE_TAC[set_byte_def] THEN
     CONV_TAC(TOP_DEPTH_CONV let_CONV) THEN
     ASM_SIMP_TAC[BIT_WORD_OR; BIT_WORD_SLICE_ALT;
                  ARITH_RULE `0 <= (i:num)`;
                  BIT_WORD_SHL; BIT_WORD_ZX; DIMINDEX_8] THEN
     MP_TAC(REWRITE_RULE[DIMINDEX_8]
       (ISPECL [`b:(8)word`; `j - byte_index (a:(N)word) bb`]
          BIT_TRIVIAL)) THEN
     ASM_CASES_TAC `byte_index (a:(N)word) bb <= j` THEN
     ASM_CASES_TAC `j < byte_index (a:(N)word) bb + 8` THEN
     ASM_CASES_TAC `bit j (h:(N)word)` THEN
     ASM_CASES_TAC
       `bit (j - byte_index (a:(N)word) bb) (b:(8)word)` THEN
     ASM_REWRITE_TAC[] THEN ARITH_NO_BIT_TAC) in
   let bib = prove
    (`!(k:num) bb. good_dimindex (:'a)
        ==> byte_index ((n2w k):'a word) bb + 8 <= dimindex (:'a)`,
     REPEAT GEN_TAC THEN
     REWRITE_TAC[byte_index_def] THEN
     CONV_TAC(TOP_DEPTH_CONV let_CONV) THEN
     REWRITE_TAC[good_dimindex_def] THEN
     DISCH_THEN(DISJ_CASES_THEN (fun th -> SUBST1_TAC th)) THEN
     CONV_TAC NUM_REDUCE_CONV THEN
     (MP_TAC(SPEC `w2n ((n2w k):'a word)`
        (MATCH_MP DIVISION (ARITH_RULE `~(4 = 0)`))) ORELSE
      MP_TAC(SPEC `w2n ((n2w k):'a word)`
        (MATCH_MP DIVISION (ARITH_RULE `~(8 = 0)`)))) THEN
     COND_CASES_TAC THEN ARITH_TAC) in
   DISCH_TAC THEN
   SUBGOAL_THEN `good_dimindex (:'a)` ASSUME_TAC THENL
    [ASM_REWRITE_TAC[good_dimindex_def]; ALL_TAC] THEN
   REWRITE_TAC[WORD_EQ_BITS_ALT] THEN
   ASM_SIMP_TAC[bsb; bib; COND_SAME_IFF] THEN
   X_GEN_TAC `i:num` THEN DISCH_TAC THEN
   REWRITE_TAC[byte_index_def] THEN
   CONV_TAC(TOP_DEPTH_CONV let_CONV) THEN
   ASM_REWRITE_TAC[VAL_WORD] THEN
   CONV_TAC NUM_REDUCE_CONV THEN
   COND_CASES_TAC THEN ASM_REWRITE_TAC[] THEN
   CONV_TAC NUM_REDUCE_CONV THEN ARITH_NO_BIT_TAC)
### set_byte_all_32
  (* the four bytes of a word of thirty-two bits cover it, so what
     the fourth set_byte writes over is never read: every index is in
     one of the four byte ranges, whichever way round the endianness
     puts them *)
  (let bsb = prove
    (`!a b (h:(N)word) bb j.
        byte_index a bb + 8 <= dimindex (:N) /\ j < dimindex (:N)
        ==> (bit j (set_byte a b h bb) <=>
             (if byte_index a bb <= j /\ j < byte_index a bb + 8
              then bit (j - byte_index a bb) b else bit j h))`,
     REPEAT GEN_TAC THEN STRIP_TAC THEN
     REWRITE_TAC[set_byte_def] THEN
     CONV_TAC(TOP_DEPTH_CONV let_CONV) THEN
     ASM_SIMP_TAC[BIT_WORD_OR; BIT_WORD_SLICE_ALT;
                  ARITH_RULE `0 <= (i:num)`;
                  BIT_WORD_SHL; BIT_WORD_ZX; DIMINDEX_8] THEN
     MP_TAC(REWRITE_RULE[DIMINDEX_8]
       (ISPECL [`b:(8)word`; `j - byte_index (a:(N)word) bb`]
          BIT_TRIVIAL)) THEN
     ASM_CASES_TAC `byte_index (a:(N)word) bb <= j` THEN
     ASM_CASES_TAC `j < byte_index (a:(N)word) bb + 8` THEN
     ASM_CASES_TAC `bit j (h:(N)word)` THEN
     ASM_CASES_TAC
       `bit (j - byte_index (a:(N)word) bb) (b:(8)word)` THEN
     ASM_REWRITE_TAC[] THEN ARITH_NO_BIT_TAC) in
   let bib = prove
    (`!(k:num) bb. good_dimindex (:'a)
        ==> byte_index ((n2w k):'a word) bb + 8 <= dimindex (:'a)`,
     REPEAT GEN_TAC THEN
     REWRITE_TAC[byte_index_def] THEN
     CONV_TAC(TOP_DEPTH_CONV let_CONV) THEN
     REWRITE_TAC[good_dimindex_def] THEN
     DISCH_THEN(DISJ_CASES_THEN (fun th -> SUBST1_TAC th)) THEN
     CONV_TAC NUM_REDUCE_CONV THEN
     (MP_TAC(SPEC `w2n ((n2w k):'a word)`
        (MATCH_MP DIVISION (ARITH_RULE `~(4 = 0)`))) ORELSE
      MP_TAC(SPEC `w2n ((n2w k):'a word)`
        (MATCH_MP DIVISION (ARITH_RULE `~(8 = 0)`)))) THEN
     COND_CASES_TAC THEN ARITH_TAC) in
   DISCH_TAC THEN
   SUBGOAL_THEN `good_dimindex (:'a)` ASSUME_TAC THENL
    [ASM_REWRITE_TAC[good_dimindex_def]; ALL_TAC] THEN
   REWRITE_TAC[WORD_EQ_BITS_ALT] THEN
   ASM_SIMP_TAC[bsb; bib; COND_SAME_IFF] THEN
   X_GEN_TAC `i:num` THEN DISCH_TAC THEN
   REWRITE_TAC[byte_index_def] THEN
   CONV_TAC(TOP_DEPTH_CONV let_CONV) THEN
   ASM_REWRITE_TAC[VAL_WORD] THEN
   CONV_TAC NUM_REDUCE_CONV THEN
   COND_CASES_TAC THEN ASM_REWRITE_TAC[] THEN
   CONV_TAC NUM_REDUCE_CONV THEN ARITH_NO_BIT_TAC)
### word_of_byte_set_byte_64
  (* and the same of a word of sixty-four bits, with eight
     set_bytes and one shift more *)
  (let bsb0 = prove
    (`!(a:(N)word) b (h:(N)word) bb j. j < dimindex (:N)
        ==> (bit j (set_byte a b h bb) <=>
             (if byte_index a bb <= j /\ j < byte_index a bb + 8
              then bit (j - byte_index a bb) b else bit j h))`,
     REPEAT GEN_TAC THEN DISCH_TAC THEN
     REWRITE_TAC[set_byte_def] THEN
     CONV_TAC(TOP_DEPTH_CONV let_CONV) THEN
     ASM_SIMP_TAC[BIT_WORD_OR; BIT_WORD_SLICE_ALT_LT; BIT_WORD_SHL;
                  BIT_WORD_ZX; DIMINDEX_8] THEN
     MP_TAC(REWRITE_RULE[DIMINDEX_8]
       (ISPECL [`b:(8)word`; `j - byte_index (a:(N)word) bb`]
          BIT_TRIVIAL)) THEN
     ASM_CASES_TAC `byte_index (a:(N)word) bb <= j` THEN
     ASM_CASES_TAC `j < byte_index (a:(N)word) bb + 8` THEN
     ASM_CASES_TAC `bit j (h:(N)word)` THEN
     ASM_CASES_TAC
       `bit (j - byte_index (a:(N)word) bb) (b:(8)word)` THEN
     ASM_REWRITE_TAC[] THEN ARITH_NO_BIT_TAC) in
   let killbit tm =
     TRY(MP_TAC(REWRITE_RULE[DIMINDEX_8]
           (ISPECL [`w:(8)word`; tm] BIT_TRIVIAL)) THEN
         ANTS_TAC THENL
          [ASM_ARITH_TAC;
           DISCH_THEN(fun th -> REWRITE_TAC[th])]) in
   let rules =
     let num k = mk_small_numeral k in
     let le a b = mk_binop `(<=):num->num->bool` a b in
     let lt a b = mk_binop `(<):num->num->bool` a b in
     let iv = `i:num` in
     let ks = [8; 16; 24; 32; 40; 48; 56; 64] in
     itlist (fun k acc -> itlist (fun k2 acc ->
       (if k <= k2
        then [ARITH_RULE(mk_imp(le (num k2) iv, le (num k) iv));
              ARITH_RULE(mk_imp(lt iv (num k), lt iv (num k2)))]
        else []) @
       (if k2 <= k
        then [ARITH_RULE(mk_imp(lt iv (num k2), mk_neg(le (num k) iv)));
              ARITH_RULE(mk_imp(le (num k) iv, mk_neg(lt iv (num k2))))]
        else []) @ acc) ks acc) ks
       [ARITH_RULE `i < 64 ==> (i - m < 64 <=> T)`;
        ARITH_RULE `(8 <= i - 8 <=> 16 <= i) /\
                    (8 <= i - 16 <=> 24 <= i) /\
                    (8 <= i - 24 <=> 32 <= i) /\
                    (8 <= i - 32 <=> 40 <= i) /\
                    (8 <= i - 40 <=> 48 <= i) /\
                    (8 <= i - 48 <=> 56 <= i) /\
                    (16 <= i - 32 <=> 48 <= i)`] in
   let usebe =
     TRY(FIRST_ASSUM(fun th ->
       let c = concl th in
       if is_var c || (is_neg c && is_var (rand c))
       then RULE_ASSUM_TAC(REWRITE_RULE[th]) THEN ASSUME_TAC th
       else fail())) in
   let numred =
     RULE_ASSUM_TAC(fun th ->
       try CONV_RULE NUM_REDUCE_CONV th with Failure _ -> th) in
   let stripconj =
     REPEAT(FIRST_X_ASSUM(fun th ->
       if is_conj (concl th) then STRIP_ASSUME_TAC th else fail())) in
   DISCH_TAC THEN
   REWRITE_TAC[WORD_EQ_BITS_ALT] THEN
   X_GEN_TAC `i:num` THEN DISCH_TAC THEN
   ASM_SIMP_TAC[bsb0] THEN
   REWRITE_TAC[byte_index_def; word_of_byte_def] THEN
   CONV_TAC(TOP_DEPTH_CONV let_CONV) THEN
   ASM_REWRITE_TAC[VAL_WORD; dimword] THEN
   CONV_TAC NUM_REDUCE_CONV THEN
   REWRITE_TAC[BIT_WORD_OR; BIT_WORD_SHL; BIT_WORD_ZX; DIMINDEX_8] THEN
   SUBGOAL_THEN `(i:num) < 64` ASSUME_TAC THENL
    [ASM_ARITH_TAC; ALL_TAC] THEN
   REPEAT COND_CASES_TAC THEN usebe THEN numred THEN stripconj THEN
   TRY(SUBGOAL_THEN `F` CONTR_TAC THEN ASM_ARITH_TAC) THEN
   REWRITE_TAC[ARITH_RULE
     `(((i - 32) - 16) - 8 = i - 56) /\ ((i - 32) - 16 = i - 48) /\
      ((i - 32) - 8 = i - 40) /\ ((i - 16) - 8 = i - 24) /\
      (i - 0 = i)`] THEN
   killbit `i:num` THEN killbit `i - 8` THEN killbit `i - 16` THEN
   killbit `i - 24` THEN killbit `i - 32` THEN killbit `i - 40` THEN
   killbit `i - 48` THEN
   ASM_SIMP_TAC rules THEN
   TRY(SUBGOAL_THEN `F` CONTR_TAC THEN ASM_ARITH_TAC))
### word_of_byte_set_byte_32
  (* the word that repeats a byte is what the four set_bytes of a
     word of thirty-two bits write the byte into: at every bit the
     shifts of word_of_byte give the bit of the byte at the position
     modulo eight, and so does the set_byte whose range the position
     falls in *)
  (let bsb0 = prove
    (`!(a:(N)word) b (h:(N)word) bb j. j < dimindex (:N)
        ==> (bit j (set_byte a b h bb) <=>
             (if byte_index a bb <= j /\ j < byte_index a bb + 8
              then bit (j - byte_index a bb) b else bit j h))`,
     REPEAT GEN_TAC THEN DISCH_TAC THEN
     REWRITE_TAC[set_byte_def] THEN
     CONV_TAC(TOP_DEPTH_CONV let_CONV) THEN
     ASM_SIMP_TAC[BIT_WORD_OR; BIT_WORD_SLICE_ALT_LT; BIT_WORD_SHL;
                  BIT_WORD_ZX; DIMINDEX_8] THEN
     MP_TAC(REWRITE_RULE[DIMINDEX_8]
       (ISPECL [`b:(8)word`; `j - byte_index (a:(N)word) bb`]
          BIT_TRIVIAL)) THEN
     ASM_CASES_TAC `byte_index (a:(N)word) bb <= j` THEN
     ASM_CASES_TAC `j < byte_index (a:(N)word) bb + 8` THEN
     ASM_CASES_TAC `bit j (h:(N)word)` THEN
     ASM_CASES_TAC
       `bit (j - byte_index (a:(N)word) bb) (b:(8)word)` THEN
     ASM_REWRITE_TAC[] THEN ARITH_NO_BIT_TAC) in
   let afacts =
     [ARITH_RULE `(i:num) < 8 ==> ~(8 <= i)`;
      ARITH_RULE `(i:num) < 8 ==> ~(16 <= i)`;
      ARITH_RULE `(i:num) < 8 ==> ~(24 <= i)`;
      ARITH_RULE `~((i:num) < 8) ==> 8 <= i`;
      ARITH_RULE `~((i:num) < 16) ==> 16 <= i`;
      ARITH_RULE `~((i:num) < 24) ==> 24 <= i`;
      ARITH_RULE `(i:num) < 16 ==> ~(16 <= i)`;
      ARITH_RULE `(i:num) < 24 ==> ~(24 <= i)`;
      ARITH_RULE `(i:num) < 16 ==> i - 8 < 8`;
      ARITH_RULE `(i:num) < 24 ==> i - 16 < 8`;
      ARITH_RULE `(i:num) < 32 ==> i - 24 < 8`;
      SUB_0;
      REWRITE_RULE[DIMINDEX_8] (ISPEC `w:(8)word` BIT_TRIVIAL);
      ARITH_RULE `~((i:num) < 16) ==> 8 <= i - 8`;
      ARITH_RULE `~((i:num) < 24) ==> 8 <= i - 16`;
      ARITH_RULE `(i:num) < 32 ==> i - 8 < 32`;
      ARITH_RULE `(i:num) < 32 ==> i - 16 < 32`;
      ARITH_RULE `(i:num) < 32 ==> i - 24 < 32`] in
   let killbit tm =
     TRY(MP_TAC(REWRITE_RULE[DIMINDEX_8]
           (ISPECL [`w:(8)word`; tm] BIT_TRIVIAL)) THEN
         ANTS_TAC THENL
          [ASM_ARITH_TAC;
           DISCH_THEN(fun th -> REWRITE_TAC[th])]) in
   DISCH_TAC THEN
   REWRITE_TAC[WORD_EQ_BITS_ALT] THEN
   X_GEN_TAC `i:num` THEN DISCH_TAC THEN
   ASM_SIMP_TAC[bsb0] THEN
   REWRITE_TAC[byte_index_def; word_of_byte_def] THEN
   CONV_TAC(TOP_DEPTH_CONV let_CONV) THEN
   ASM_REWRITE_TAC[VAL_WORD; dimword] THEN
   CONV_TAC NUM_REDUCE_CONV THEN
   REWRITE_TAC[BIT_WORD_OR; BIT_WORD_SHL; BIT_WORD_ZX; DIMINDEX_8] THEN
   REWRITE_TAC[ARITH_RULE `(i - 16) - 8 = i - 24`] THEN
   SUBGOAL_THEN `(i:num) < 32` ASSUME_TAC THENL
    [ASM_ARITH_TAC; ALL_TAC] THEN
   ASM_CASES_TAC `(i:num) < 8` THEN
   ASM_CASES_TAC `(i:num) < 16` THEN
   ASM_CASES_TAC `(i:num) < 24` THEN
   REPEAT COND_CASES_TAC THEN
   TRY(SUBGOAL_THEN `F` CONTR_TAC THEN ASM_ARITH_TAC) THEN
   killbit `i:num` THEN killbit `i - 8` THEN killbit `i - 16` THEN
   ASM_SIMP_TAC afacts THEN
   TRY(SUBGOAL_THEN `F` CONTR_TAC THEN ASM_ARITH_TAC))
### last_bytes_bytes_to_word_REPLICATE
  (* the bytes of a replicated byte written one after the other are
     what last_bytes writes, by the induction on the number *)
  (SUBGOAL_THEN
      `!n k a (w:'a word) bb bend. n <= k
         ==> bytes_to_word k a (REPLICATE n bb) w bend =
             last_bytes n bb a w bend`
      (fun th -> REPEAT GEN_TAC THEN
         DISCH_THEN(CONJUNCTS_THEN2 ASSUME_TAC
           (CONJUNCTS_THEN2 SUBST_ALL_TAC SUBST1_TAC)) THEN
         FIRST_ASSUM(fun le ->
           MATCH_ACCEPT_TAC(MATCH_MP (SPEC_ALL th) le)))
    THEN
    INDUCT_TAC THEN REPEAT GEN_TAC THEN DISCH_TAC THENL
     [ONCE_REWRITE_TAC[bytes_to_word_def] THEN
      ONCE_REWRITE_TAC[last_bytes_def] THEN
      REWRITE_TAC[REPLICATE] THEN
      COND_CASES_TAC THEN REWRITE_TAC[] THEN
      MATCH_REDUCE_TAC THEN REWRITE_TAC[];
      ONCE_REWRITE_TAC[bytes_to_word_def] THEN
      ONCE_REWRITE_TAC[last_bytes_def] THEN
      REWRITE_TAC[REPLICATE; NOT_SUC; ARITH_RULE `SUC n - 1 = n`] THEN
      COND_CASES_TAC THENL
       [FIRST_ASSUM(fun th -> MP_TAC th) THEN ASM_ARITH_TAC;
        ALL_TAC] THEN
      MATCH_REDUCE_TAC THEN
      AP_THM_TAC THEN AP_TERM_TAC THEN
      FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_ARITH_TAC])
### decode_length_make_byte_header
  (* decode_length shifts down by two (or three) more than
     make_byte_header shifted up, so it reads the length plus the
     word size divided by it, which is between the length divided by
     the word size and one more than that *)
  (let hi = prove
    (`!n r (i:num). n < 2 EXP r /\ r <= i
        ==> ~(bit i ((n2w n):'a word))`,
     MATCH_ACCEPT_TAC BIT_WORD_HI) in
   let tag5 = prove
    (`!fl j. bit j ((if fl then (n2w 7) else (n2w 23)):'a word)
             ==> j < 5`,
     REPEAT GEN_TAC THEN
     ASM_CASES_TAC `(j:num) < 5` THEN ASM_REWRITE_TAC[] THEN
     COND_CASES_TAC THENL
      [MP_TAC(ISPECL [`7`; `5`; `j:num`] hi);
       MP_TAC(ISPECL [`23`; `5`; `j:num`] hi)] THEN
     CONV_TAC NUM_REDUCE_CONV THEN
     ASM_SIMP_TAC[ARITH_RULE `~((j:num) < 5) ==> 5 <= j`]) in
   let ushr_shl = prove
    (`!(x:'a word) s k. (!j. bit j x ==> j + s < dimindex (:'a))
        ==> word_ushr (word_shl x s) (s + k) = word_ushr x k`,
     REPEAT GEN_TAC THEN DISCH_TAC THEN
     REWRITE_TAC[WORD_EQ_BITS_ALT; BIT_WORD_USHR; BIT_WORD_SHL] THEN
     X_GEN_TAC `j:num` THEN DISCH_TAC THEN
     REWRITE_TAC[ARITH_RULE
       `s <= (j + s + k) /\ ((j + s + k) - s = j + k)`] THEN
     ASM_CASES_TAC `bit (j + k) (x:'a word)` THEN
     ASM_REWRITE_TAC[] THEN
     FIRST_X_ASSUM(fun th -> MP_TAC(SPEC `j + k` th)) THEN
     ASM_REWRITE_TAC[] THEN ARITH_TAC) in
   let usedim =
     FIRST_X_ASSUM(fun dd ->
       let c = concl dd in
       if is_eq c &&
          (try fst(dest_const(fst(strip_comb(lhs c)))) = "dimindex"
           with Failure _ -> false)
       then RULE_ASSUM_TAC(REWRITE_RULE[dd;
              word_shift_def]) THEN
            ASSUME_TAC dd
       else fail()) in
   STRIP_TAC THEN
   FIRST_ASSUM(DISJ_CASES_THEN ASSUME_TAC o
     REWRITE_RULE[good_dimindex_def]) THEN
   usedim THEN
   RULE_ASSUM_TAC(CONV_RULE NUM_REDUCE_CONV) THEN
   REWRITE_TAC[decode_length_def;
               make_byte_header_def] THEN
   CONV_TAC(TOP_DEPTH_CONV let_CONV) THEN
   ASM_REWRITE_TAC[] THEN CONV_TAC NUM_REDUCE_CONV THENL
    [SUBGOAL_THEN
       `32 - data_to_word_config_len_size c =
        (30 - data_to_word_config_len_size c) + 2`
       SUBST1_TAC THENL [ASM_ARITH_TAC; ALL_TAC] THEN
     SUBGOAL_THEN
       `!j. bit j ((if fl then (n2w 7) else (n2w 23)):'a word)
            ==> j < (30 - data_to_word_config_len_size c) + 2`
       (fun th -> REWRITE_TAC[MATCH_MP USHR_OR_LOW th]) THENL
      [GEN_TAC THEN DISCH_THEN(fun th -> MP_TAC(MATCH_MP tag5 th)) THEN
       ASM_ARITH_TAC; ALL_TAC] THEN
     SUBGOAL_THEN
       `!j. bit j ((n2w (len + 4)):'a word)
            ==> j + (30 - data_to_word_config_len_size c) <
                dimindex (:'a)`
       (fun th -> REWRITE_TAC[MATCH_MP ushr_shl th]) THENL
      [X_GEN_TAC `j:num` THEN
       ASM_CASES_TAC
         `j + (30 - data_to_word_config_len_size c) <
          dimindex (:'a)` THEN
       ASM_REWRITE_TAC[] THEN
       MP_TAC(ISPECL [`len + 4`;
                      `data_to_word_config_len_size c + 2`;
                      `j:num`] hi) THEN
       SUBGOAL_THEN `data_to_word_config_len_size c + 2 <= j`
         (fun th -> REWRITE_TAC[th]) THENL
        [ASM_ARITH_TAC; ASM_REWRITE_TAC[]];
       ALL_TAC] THEN
     REWRITE_TAC[VAL_WORD_USHR; VAL_WORD] THEN
     ASM_REWRITE_TAC[] THEN CONV_TAC NUM_REDUCE_CONV THEN
     SUBGOAL_THEN `(len + 4) MOD 4294967296 = len + 4` SUBST1_TAC THENL
      [MATCH_MP_TAC MOD_LT THEN
       TRANS_TAC LTE_TRANS
         `2 EXP (data_to_word_config_len_size c + 2)` THEN
       ASM_REWRITE_TAC[] THEN
       TRANS_TAC LE_TRANS `2 EXP 32` THEN
       SIMP_TAC[LE_EXP; ARITH] THEN
       CONV_TAC NUM_REDUCE_CONV THEN ASM_ARITH_TAC;
       ALL_TAC] THEN
     MP_TAC(SPEC `len:num` (MATCH_MP DIVISION (ARITH_RULE `~(4 = 0)`)))
     THEN
     MP_TAC(SPEC `len + 4` (MATCH_MP DIVISION
       (ARITH_RULE `~(4 = 0)`))) THEN
     ARITH_TAC;
     SUBGOAL_THEN
       `64 - data_to_word_config_len_size c =
        (61 - data_to_word_config_len_size c) + 3`
       SUBST1_TAC THENL [ASM_ARITH_TAC; ALL_TAC] THEN
     SUBGOAL_THEN
       `!j. bit j ((if fl then (n2w 7) else (n2w 23)):'a word)
            ==> j < (61 - data_to_word_config_len_size c) + 3`
       (fun th -> REWRITE_TAC[MATCH_MP USHR_OR_LOW th]) THENL
      [GEN_TAC THEN DISCH_THEN(fun th -> MP_TAC(MATCH_MP tag5 th)) THEN
       ASM_ARITH_TAC; ALL_TAC] THEN
     SUBGOAL_THEN
       `!j. bit j ((n2w (len + 8)):'a word)
            ==> j + (61 - data_to_word_config_len_size c) <
                dimindex (:'a)`
       (fun th -> REWRITE_TAC[MATCH_MP ushr_shl th]) THENL
      [X_GEN_TAC `j:num` THEN
       ASM_CASES_TAC
         `j + (61 - data_to_word_config_len_size c) <
          dimindex (:'a)` THEN
       ASM_REWRITE_TAC[] THEN
       MP_TAC(ISPECL [`len + 8`;
                      `data_to_word_config_len_size c + 3`;
                      `j:num`] hi) THEN
       SUBGOAL_THEN `data_to_word_config_len_size c + 3 <= j`
         (fun th -> REWRITE_TAC[th]) THENL
        [ASM_ARITH_TAC; ASM_REWRITE_TAC[]];
       ALL_TAC] THEN
     REWRITE_TAC[VAL_WORD_USHR; VAL_WORD] THEN
     ASM_REWRITE_TAC[] THEN CONV_TAC NUM_REDUCE_CONV THEN
     SUBGOAL_THEN
       `(len + 8) MOD 18446744073709551616 = len + 8`
       SUBST1_TAC THENL
      [MATCH_MP_TAC MOD_LT THEN
       TRANS_TAC LTE_TRANS
         `2 EXP (data_to_word_config_len_size c + 3)` THEN
       ASM_REWRITE_TAC[] THEN
       TRANS_TAC LE_TRANS `2 EXP 64` THEN
       SIMP_TAC[LE_EXP; ARITH] THEN
       CONV_TAC NUM_REDUCE_CONV THEN ASM_ARITH_TAC;
       ALL_TAC] THEN
     MP_TAC(SPEC `len:num` (MATCH_MP DIVISION (ARITH_RULE `~(8 = 0)`)))
     THEN
     MP_TAC(SPEC `len + 8` (MATCH_MP DIVISION
       (ARITH_RULE `~(8 = 0)`))) THEN
     ARITH_TAC])
### memory_rel_tail
  (DISCH_TAC THEN
   FIRST_ASSUM(fun th ->
     MATCH_MP_TAC(MATCH_MP
       (ONCE_REWRITE_RULE[TAUT `(p ==> q ==> r) <=> (q ==> p ==> r)`]
          memory_rel_rearrange) th)) THEN
   REWRITE_TAC[MEM] THEN MESON_TAC[])
### memory_rel_drop
  (DISCH_TAC THEN
   FIRST_ASSUM(fun th ->
     MATCH_MP_TAC(MATCH_MP
       (ONCE_REWRITE_RULE[TAUT `(p ==> q ==> r) <=> (q ==> p ==> r)`]
          memory_rel_rearrange) th)) THEN
   REWRITE_TAC[MEM_APPEND] THEN MESON_TAC[])
### memory_rel_IMP_word_list_exists
  (* the free space of the heap is the Unused element at the
     address that NextFree points at, and word_el makes it a
     word_list_exists of its length; the part of it that the
     statement asks for is the first n cells, which
     word_list_exists_ADD splits off, and the rest of the memory
     goes into the SEP_T *)
  (let hd_is n t =
     (try fst(dest_const(fst(strip_comb t))) = n
      with Failure _ -> false) in
   let rec facs t =
     if hd_is "STAR" t then
       let args = snd(strip_comb t) in
       facs (el 0 args) @ facs (el 1 args)
     else [t] in
   let star_T = prove
    (`!(p:(A->bool)->bool) q s. (p * q) s ==> (p * SEP_T) s`,
     REWRITE_TAC[STAR_SEP_T; STAR_def; SPLIT_LEMMA] THEN
     MESON_TAC[]) in
   let sep_T_tac = W(fun (asl,w) ->
     let tgt = lhand (rator w) in
     let ante = tryfind (fun (_,th) ->
       let c = concl th in
       if hd_is "STAR" (rator c) && mem tgt (facs (rator c))
       then rator c else fail()) asl in
     let rec remove1 t = function
         [] -> []
       | h :: rest -> if h = t then rest else h :: remove1 t rest in
     let rest = remove1 tgt (facs ante) in
     let st = fst(strip_comb ante) in
     let mk a b = mk_comb(mk_comb(st,a),b) in
     MATCH_MP_TAC star_T THEN
     EXISTS_TAC (end_itlist mk rest) THEN
     FIRST_ASSUM(fun th ->
       if (try hd_is "STAR" (rator (concl th))
           with Failure _ -> false)
       then MP_TAC th else fail()) THEN
     REWRITE_TAC[STAR_AC]) in
   REWRITE_TAC[memory_rel_def; word_ml_inv_def;
               abs_ml_inv_def;
               bc_stack_ref_inv_def] THEN
   STRIP_TAC THEN
   FIRST_X_ASSUM(fun th ->
     if hd_is "heap_in_memory_store" (concl th)
     then MP_TAC(REWRITE_RULE[heap_in_memory_store_def] th)
     else fail()) THEN
   STRIP_TAC THEN
   ASM_CASES_TAC `n = 0` THENL
    [ASM_REWRITE_TAC[CONJUNCT1 word_list_exists_thm;
                     emp_STAR; SEP_T_def];
     ALL_TAC] THEN
   FIRST_ASSUM(fun t1 -> FIRST_ASSUM(fun t2 ->
     let e = REWRITE_RULE[injectivity "option";
                          injectivity "word_loc"]
               (TRANS (SYM t1) t2) in
     if is_eq (concl e) && is_var (lhs (concl e))
     then SUBST1_TAC e else fail())) THEN
   FIRST_X_ASSUM(fun th ->
     if hd_is "unused_space_inv" (concl th)
     then MP_TAC(REWRITE_RULE[unused_space_inv_def] th)
     else fail()) THEN
   DISCH_THEN(CONJUNCTS_THEN2 ASSUME_TAC STRIP_ASSUME_TAC) THEN
   SUBGOAL_THEN `~(sp' + sp1 = 0)` ASSUME_TAC THENL
    [UNDISCH_TAC `(n:num) <= sp` THEN
     UNDISCH_TAC `(sp:num) <= sp'` THEN
     UNDISCH_TAC `~(n = 0)` THEN ARITH_TAC;
     ALL_TAC] THEN
   FIRST_X_ASSUM(fun imp -> FIRST_ASSUM(fun ne ->
     MP_TAC(MATCH_MP heap_lookup_SPLIT (MP imp ne)))) THEN
   DISCH_THEN STRIP_ASSUME_TAC THEN
   VAR_EQ_TAC THEN
   FIRST_X_ASSUM(fun th ->
     if (try hd_is "STAR" (rator (concl th)) with Failure _ -> false)
     then MP_TAC th else fail()) THEN
   REWRITE_TAC[word_heap_APPEND; word_heap_def;
               word_el_def] THEN
   SUBGOAL_THEN `(sp' + sp1) - 1 + 1 = n + ((sp' + sp1) - n)`
     SUBST1_TAC THENL
    [UNDISCH_TAC `(n:num) <= sp` THEN
     UNDISCH_TAC `(sp:num) <= sp'` THEN
     UNDISCH_TAC `~(sp' + sp1 = 0)` THEN ARITH_TAC;
     ALL_TAC] THEN
   REWRITE_TAC[word_list_exists_ADD] THEN
   DISCH_TAC THEN sep_T_tac)
### get_addr_0
  (* the lowest bit of get_addr is the one that get_lowerbits ors
     in, whichever of its two clauses applies *)
  (REWRITE_TAC[word_index; get_addr_def] THEN
   CASES_ON_NAME "u" THEN
   REWRITE_TAC[get_lowerbits_def] THEN MATCH_REDUCE_TAC THEN
   REWRITE_TAC[BIT_WORD_OR; BIT_WORD_1] THEN
   MESON_TAC[DIMINDEX_GE_1; ARITH_RULE `1 <= n ==> 0 < n`])
### word_addr_eq_Loc
  (* only the Data of a Loc has a Loc for its word_addr, and the
     second component of it is zero *)
  (CASES_ON_NAME "v" THEN TRY(CASES_ON_NAME "a") THEN
   REWRITE_TAC[word_addr_def] THEN MATCH_REDUCE_TAC THEN
   REWRITE_TAC[distinctness "word_loc"; injectivity "word_loc";
               distinctness "heap_address";
               injectivity "heap_address"] THEN
   MESON_TAC[])
### blocks_unique_CodePtr
  (* a CodePtr is no Block *)
  (let vcodeptr = prove
    (`!l ys. v_all_vs (CONS (CodePtr l) ys) =
        CONS (CodePtr l) (v_all_vs ys)`,
     REPEAT GEN_TAC THEN
     GEN_REWRITE_TAC LAND_CONV [v_all_vs_def] THEN
     MATCH_REDUCE_TAC THEN REWRITE_TAC[]) in
   let inc = prove
    (`!refs l vs t a q.
        Block t a q IN all_vs refs (CONS (CodePtr l) vs) ==>
        Block t a q IN all_vs refs vs`,
     REWRITE_TAC[all_vs_def; IN_UNION; IN_ELIM_THM; vcodeptr;
                 MEM; distinctness "dataSem_v"] THEN MESON_TAC[]) in
   REWRITE_TAC[blocks_unique_def] THEN DISCH_TAC THEN
   REPEAT GEN_TAC THEN STRIP_TAC THEN FIRST_ASSUM MATCH_MP_TAC THEN
   REPEAT CONJ_TAC THEN ASM_MESON_TAC[inc])
### memory_rel_CodePtr
  (* the root of a CodePtr is the Data of its Loc, which word_addr
     gives the Loc of; a CodePtr is no Block, so the timestamps and
     the unique blocks of the stack stay as they are, and it has no
     refs, so what the stack reaches stays as it is *)
  (let grc = prove
    (`!l. get_refs (CodePtr l) = []`,
     GEN_TAC THEN
     GEN_REWRITE_TAC LAND_CONV [get_refs_def] THEN
     REWRITE_TAC[]) in
   let reach = prove
    (`!(sk:(dataSem_v)list) rfs n l.
        reachable_refs (CodePtr l :: sk) rfs n
        ==> reachable_refs sk rfs n`,
     REWRITE_TAC[reachable_refs_def; MEM] THEN
     MESON_TAC[grc; MEM]) in
   let waddr = el 2 (word_addr_clauses ()) in
   REWRITE_TAC[memory_rel_def; word_ml_inv_def] THEN
   REPEAT STRIP_TAC THEN ASM_EXISTS_TAC THEN
   ASM_REWRITE_TAC[] THEN
   (* the root that goes in front has the type that the statement
      left to the parser, so it is built with that type *)
   (fun (asl,w as gl) ->
      let v = fst(dest_exists w) in
      let tm = `CONS (gc_shared_Data (wordLang_Loc lab 0)) hs` in
      EXISTS_TAC (inst (type_match (type_of tm) (type_of v) []) tm)
        gl) THEN
   REWRITE_TAC[MAP; ALL2; waddr] THEN
   ASM_REWRITE_TAC[] THEN
   USE_CHANGED [abs_ml_inv_def; bc_stack_ref_inv_def]
   THEN
   DISCH_THEN STRIP_ASSUME_TAC THEN
   REWRITE_TAC[abs_ml_inv_def; bc_stack_ref_inv_def] THEN
   REPEAT CONJ_TAC THEN TRY(FIRST_ASSUM MATCH_ACCEPT_TAC) THENL
    [RULE_ASSUM_TAC(REWRITE_RULE[roots_ok_def]) THEN
     REWRITE_TAC[roots_ok_def; MEM;
                 distinctness "heap_address"] THEN
     FIRST_ASSUM MATCH_ACCEPT_TAC;
     MAP_EVERY EXISTS_TAC [`f:(num,num)fmap`; `tf:(num,num)fmap`] THEN
     REPEAT CONJ_TAC THEN TRY(FIRST_ASSUM MATCH_ACCEPT_TAC) THENL
      [(fun (asl,w as gl) ->
         let th = PART_MATCH (lhs o rand)
                    all_ts_cons_no_block (rand w) in
         (MP_TAC th THEN REWRITE_TAC[distinctness "dataSem_v"] THEN
          DISCH_THEN(fun e -> ASM_REWRITE_TAC[e])) gl);
       MATCH_MP_TAC blocks_unique_CodePtr THEN
       ASM_REWRITE_TAC[];
       REWRITE_TAC[ALL2] THEN ASM_REWRITE_TAC[] THEN
       REWRITE_TAC[v_inv_def];
       X_GEN_TAC `nn:num` THEN STRIP_TAC THEN
       FIRST_ASSUM MATCH_MP_TAC THEN CONJ_TAC THENL
        [FIRST_ASSUM(fun rr -> MATCH_ACCEPT_TAC(MATCH_MP reach rr));
         FIRST_ASSUM MATCH_ACCEPT_TAC]]])
### memory_rel_Block_IMP
  (* what the root of a Block is: of an empty one the Data of its
     BlockNil, whose and with the complement of one leaves it alone
     (its lowest bit is clear, because sixteen times the tag plus
     two is even); of a non-empty one a pointer at the BlockRep,
     whose header the memory holds, with the length and the
     encode_header off the cond of the word_el and the two bits
     read off make_header.  The timestamp is below ts because tf
     binds it and its domain is below ts *)
  (let hd_is n t =
   (try fst(dest_const(fst(strip_comb t))) = n
    with Failure _ -> false) in
 let rec facs t =
   if hd_is "STAR" t then
     let args = snd(strip_comb t) in
     facs (el 0 args) @ facs (el 1 args)
   else [t] in
 let grab asl p =
   tryfind (fun (_,th) ->
     if (try p th with Failure _ -> false) then th else fail())
     asl in
 let is_hl th = hd_is "heap_lookup" (lhs (concl th)) in
 let sepfront names =
   W(fun (asl,w) ->
     let pred = rator (lhand w) in
     let fs = facs pred in
     let picked = map (fun n -> find (hd_is n) fs) names in
     let rest = filter (fun t -> not (mem t picked)) fs in
     let st = fst(strip_comb pred) in
     let mk a b = mk_comb(mk_comb(st,a),b) in
     let target = itlist mk picked (end_itlist mk rest) in
     SUBGOAL_THEN (mk_eq(pred,target)) SUBST1_TAC THENL
      [REWRITE_TAC[STAR_AC]; ALL_TAC]) in
 let swapmul a =
   let args = snd(strip_comb (rand a)) in
   let mul = fst(strip_comb (rand a)) in
   mk_comb(rator a, mk_comb(mk_comb(mul,el 1 args),el 0 args)) in
 let realaddr =
   W(fun (asl,w) ->
     let hl = grab asl is_hl in
     let hlen = grab asl (fun th ->
       hd_is "heap_length" (lhand (concl th))) in
     let cu = grab asl (fun th ->
       hd_is "FLOOKUP" (lhs (concl th)) &&
       fst(dest_const(rand(lhs(concl th)))) = "CurrHeap") in
     let gd = grab asl (fun th ->
       hd_is "good_dimindex" (concl th)) in
     let gat = tryfind (fun t ->
       find_term (fun u ->
         hd_is "get_addr" u && length (snd(strip_comb u)) = 3) t)
       (w :: map (fun (_,th) -> concl th) asl) in
     let mm = MATCH_MP get_real_addr_get_addr
                (CONJ hlen (CONJ hl (CONJ cu gd))) in
     let wv = find (fun v -> fst(dest_var v) = "w")
                (frees (concl mm)) in
     let th = SPEC (last (snd(strip_comb gat))) (GEN wv mm) in
     let a = rand (rhs (concl (CONJUNCT1 th))) in
     EXISTS_TAC (swapmul a) THEN
     STRIP_ASSUME_TAC(REWRITE_RULE[WORD_RULE (mk_eq(a,swapmul a))]
                        th)) in
   let shl16 = prove
    (`!(v:(N)word). word_shl v 4 = word 16 * v`,
     REWRITE_TAC[word_shl; GSYM VAL_EQ; VAL_WORD_MUL; VAL_WORD] THEN
     CONV_TAC MOD_DOWN_CONV THEN CONV_TAC NUM_REDUCE_CONV THEN
     REWRITE_TAC[MULT_AC]) in
   let shl1 = prove
    (`!(v:(N)word). word_shl v 1 = word 2 * v`,
     REWRITE_TAC[word_shl; GSYM VAL_EQ; VAL_WORD_MUL; VAL_WORD] THEN
     CONV_TAC MOD_DOWN_CONV THEN CONV_TAC NUM_REDUCE_CONV THEN
     REWRITE_TAC[MULT_AC]) in
   let andid = prove
    (`!(x:(N)word).
        word_and (word_shl x 4 + word 2) (word_not (word 1)) =
        x * word 16 + word 2`,
     GEN_TAC THEN
     SUBGOAL_THEN
       `word_shl (x:(N)word) 4 + word 2 = x * word 16 + word 2`
       SUBST1_TAC THENL
      [REWRITE_TAC[shl16] THEN CONV_TAC WORD_RULE; ALL_TAC] THEN
     SUBGOAL_THEN `~(bit 0 ((x:(N)word) * word 16 + word 2))`
       MP_TAC THENL
      [SUBGOAL_THEN `(x:(N)word) * word 16 + word 2 =
                     word_shl (word 8 * x + word 1) 1` SUBST1_TAC THENL
        [REWRITE_TAC[shl1] THEN CONV_TAC WORD_RULE; ALL_TAC] THEN
       REWRITE_TAC[BIT_WORD_SHL] THEN CONV_TAC NUM_REDUCE_CONV;
       ALL_TAC] THEN
     DISCH_TAC THEN
     REWRITE_TAC[WORD_EQ_BITS_ALT; BIT_WORD_AND; BIT_WORD_NOT;
                 BIT_WORD_1] THEN
     X_GEN_TAC `i:num` THEN DISCH_TAC THEN
     ASM_CASES_TAC `(i:num) = 0` THEN ASM_REWRITE_TAC[] THEN
     CONV_TAC TAUT) in
   MEMORY_REL_TAC THEN
   ASM_CASES_TAC `vals:(dataSem_v)list = []` THEN
   ASM_REWRITE_TAC[] THENL
    [VAR_EQ_TAC THEN V_INV_TAC v_inv_def THEN
     REWRITE_TAC(word_addr_clauses ()) THEN
     W(fun (asl,w) ->
       EXISTS_TAC
         (rand (lhs (hd (conjuncts (snd(strip_exists w))))))) THEN
     ASM_REWRITE_TAC[] THEN CONJ_TAC THENL
      [REWRITE_TAC[BlockNil_def; andid] THEN
       CONV_TAC WORD_RULE;
       REWRITE_TAC[word_index; BIT_WORD_AND; BIT_WORD_NOT;
                   BIT_WORD_1] THEN
       CONV_TAC NUM_REDUCE_CONV];
     V_INV_TAC v_inv_def THEN
     FIRST_ASSUM(fun ne ->
       if is_neg (concl ne)
       then RULE_ASSUM_TAC(REWRITE_RULE[v_inv_def; ne])
       else fail()) THEN
     REPEAT(FIRST_X_ASSUM(fun th ->
       if is_exists (concl th) then CHOOSE_TAC th else fail())) THEN
     REPEAT(FIRST_X_ASSUM(fun th ->
       if is_conj (concl th) then STRIP_ASSUME_TAC th
       else fail())) THEN
     FIRST_ASSUM(fun e ->
       let c = concl e in
       if is_eq c && is_var (rand c) && hd_is "wordLang_Word" (lhs c)
       then SUBST1_TAC (SYM e) else fail()) THEN
     REWRITE_TAC[injectivity "word_loc"] THEN
     CONV_TAC(REDEPTH_CONV UNWIND_CONV) THEN
     REWRITE_TAC[get_addr_0] THEN
     FIRST_X_ASSUM(fun th ->
       if hd_is "heap_in_memory_store" (concl th)
       then MP_TAC(REWRITE_RULE[heap_in_memory_store_def] th)
       else fail()) THEN
     STRIP_TAC THEN
     W(fun (asl,w) ->
       MP_TAC(MATCH_MP heap_lookup_SPLIT
                (grab asl is_hl))) THEN
     DISCH_THEN STRIP_ASSUME_TAC THEN
     VAR_EQ_TAC THEN
     realaddr THEN
     FIRST_X_ASSUM(fun th ->
       if (try hd_is "STAR" (rator (concl th))
           with Failure _ -> false)
       then MP_TAC th else fail()) THEN
     REWRITE_TAC[word_heap_APPEND; word_heap_def;
                 BlockRep_def] THEN
     CONV_TAC(TOP_DEPTH_CONV let_CONV) THEN
     REWRITE_TAC[word_el_def] THEN
     CONV_TAC(TOP_DEPTH_CONV let_CONV) THEN
     REWRITE_TAC[word_payload_def] THEN
     CONV_TAC(TOP_DEPTH_CONV let_CONV) THEN
     REWRITE_TAC[word_list_def; LENGTH_MAP] THEN
     sepfront ["cond"] THEN
     REWRITE_TAC[cond_STAR] THEN
     DISCH_THEN(CONJUNCTS_THEN2 STRIP_ASSUME_TAC MP_TAC) THEN
     sepfront ["set_sep_one"] THEN
     DISCH_THEN(fun sep ->
       let rd = MATCH_MP read_fun2set sep in
       EXISTS_TAC (rand (rhs (concl (CONJUNCT1 rd)))) THEN
       STRIP_ASSUME_TAC rd) THEN
     FIRST_ASSUM(fun lr ->
       if hd_is "ALL2" (concl lr) then
         let e = MATCH_MP LIST_REL_LENGTH lr in
         if fst(dest_var(rand(lhs(concl e)))) = "vals"
         then SUBST1_TAC e else fail()
       else fail()) THEN
     SUBGOAL_THEN `(ts':num) < ts` ASSUME_TAC THENL
      [FIRST_ASSUM(fun fl ->
         if (try hd_is "FLOOKUP" (lhs (concl fl)) &&
                  fst(dest_var(rand(lhs(concl fl)))) = "ts'"
             with Failure _ -> false)
         then MP_TAC(REWRITE_RULE[FLOOKUP_DEF] fl) else fail()) THEN
       COND_CASES_TAC THEN
       REWRITE_TAC[distinctness "option"] THEN
       DISCH_THEN(K ALL_TAC) THEN
       FIRST_ASSUM(fun i -> FIRST_ASSUM(fun sub ->
         MP_TAC(REWRITE_RULE[IN_ELIM_THM]
           (MATCH_MP (REWRITE_RULE[SUBSET] sub) i)))) THEN
       REWRITE_TAC[];
       ALL_TAC] THEN
     ASM_REWRITE_TAC[MULT_SYM] THEN
     REWRITE_TAC[make_header_def] THEN
     CONV_TAC(TOP_DEPTH_CONV let_CONV) THEN
     REWRITE_TAC[BIT_WORD_OR; BIT_WORD_SHL; BIT_WORD] THEN
     CONV_TAC NUM_REDUCE_CONV THEN
     SUBGOAL_THEN
       `~(dimindex (:'a) - data_to_word_config_len_size c <= 3) /\
        ~(dimindex (:'a) - data_to_word_config_len_size c <= 2)`
       (fun th -> REWRITE_TAC[th]) THEN
     UNDISCH_TAC
       `data_to_word_config_len_size c + 7 < dimindex (:'a)` THEN
     ARITH_TAC])
### IMP_memory_rel_Number
  (* the root of a small Number is the Data of its Smallnum, which
     abs_ml_inv_Num adds to the roots, and Smallnum is four times
     the integer up to the sign, so word_addr leaves it alone *)
  (let nmul = prove
    (`!(i:int). &0 <= i
        ==> n2w (num_of_int (&4 * i)) =
            (n2w 4 * n2w (num_of_int i):(N)word)`,
     REPEAT STRIP_TAC THEN
     SUBGOAL_THEN `num_of_int (&4 * (i:int)) = 4 * num_of_int i`
       SUBST1_TAC THENL
      [FIRST_ASSUM(fun th ->
         GEN_REWRITE_TAC (LAND_CONV o RAND_CONV o RAND_CONV)
           [GSYM(MATCH_MP INT_OF_NUM_OF_INT th)]) THEN
       REWRITE_TAC[INT_OF_NUM_MUL; NUM_OF_INT_OF_NUM];
       REWRITE_TAC[WORD_MUL]]) in
   let and_sym = WORD_BITWISE_RULE `(x:(N)word) && y = y && x` in
   let andnot1 = prove
    (`good_dimindex (:'a)
      ==> ((n2w 4 * v:'a word) && word_not (n2w 1) = n2w 4 * v) /\
          ((--(n2w 4) * v:'a word) && word_not (n2w 1) =
           --(n2w 4) * v)`,
     DISCH_TAC THEN
     SUBGOAL_THEN `word_not (n2w 1:'a word) = --(n2w 2)`
       SUBST1_TAC THENL
      [CONV_TAC WORD_RULE; ALL_TAC] THEN
     ONCE_REWRITE_TAC[and_sym] THEN
     ASM_SIMP_TAC[word_ml_inv_num_lemma;
                  word_ml_inv_neg_num_lemma]) in
   let neg_mul = WORD_RULE
     `word_neg (word 4 * (v:(N)word)) = word_neg (word 4) * v` in
   let waddr = hd (word_addr_clauses ()) in
   REWRITE_TAC[memory_rel_def; word_ml_inv_def] THEN
   REPEAT STRIP_TAC THEN ASM_EXISTS_TAC THEN
   ASM_REWRITE_TAC[] THEN
   EXISTS_TAC
     `CONS (gc_shared_Data (wordLang_Word (Smallnum i:'a word))) hs`
   THEN
   REWRITE_TAC[MAP; ALL2; waddr] THEN
   ASM_REWRITE_TAC[] THEN CONJ_TAC THENL
    [MATCH_MP_TAC abs_ml_inv_Num THEN ASM_REWRITE_TAC[];
     REWRITE_TAC[smallnum_def] THEN COND_CASES_TAC THENL
      [SUBGOAL_THEN `&0 <= ((&0) - (i:int))` ASSUME_TAC THENL
        [ASM_INT_ARITH_TAC; ALL_TAC] THEN
       FIRST_ASSUM(fun th -> REWRITE_TAC[MATCH_MP nmul th]) THEN
       REWRITE_TAC[WORD_SUB_LZERO; neg_mul] THEN
       ASM_SIMP_TAC[andnot1];
       SUBGOAL_THEN `&0 <= (i:int)` ASSUME_TAC THENL
        [ASM_INT_ARITH_TAC; ALL_TAC] THEN
       FIRST_ASSUM(fun th -> REWRITE_TAC[MATCH_MP nmul th]) THEN
       ASM_SIMP_TAC[andnot1]]])
### memory_rel_El_any
  (* the same statement as memory_rel_El', up to an existential
     that neither of the two uses: the source proves it again from
     memory_rel_El, with a Number put into the list for the offset,
     and the port takes the primed one, which is already there *)
  (let hd_is n t =
   (try fst(dest_const(fst(strip_comb t))) = n
    with Failure _ -> false) in
 let grab asl p =
   tryfind (fun (_,th) ->
     if (try p th with Failure _ -> false) then th else fail())
     asl in
   DISCH_TAC THEN
   FIRST_ASSUM(fun th ->
     MP_TAC(MATCH_MP memory_rel_El' th)) THEN
   DISCH_THEN STRIP_ASSUME_TAC THEN
   W(fun (asl,w) ->
     let pe = grab asl (fun th ->
       hd_is "wordLang_Word" (rhs (concl th))) in
     let ga = grab asl (fun th ->
       hd_is "get_real_addr" (lhs (concl th))) in
     let pw = rand (rhs (concl pe)) in
     let x = rand (rhs (concl ga)) in
     EXISTS_TAC pw THEN EXISTS_TAC x THEN EXISTS_TAC x) THEN
   ASM_REWRITE_TAC[])
### make_header_tag_mask
  (* the tag mask keeps the bits of a header between the second and
     the one the length size leaves, and those are the bits of four
     times the tag; above them the tag has none, because it is below
     two to the width of its field *)
  (let hi = prove
    (`!n r (i:num). n < 2 EXP r /\ r <= i
        ==> ~(bit i ((n2w n):'a word))`,
     MATCH_ACCEPT_TAC BIT_WORD_HI) in
   let b3 = prove
    (`!j. j < dimindex (:'a)
          ==> (bit j ((n2w 3):'a word) <=> j < 2)`,
     GEN_TAC THEN DISCH_TAC THEN
     ASM_CASES_TAC `(j:num) < 2` THEN ASM_REWRITE_TAC[] THENL
      [FIRST_ASSUM(DISJ_CASES_THEN SUBST_ALL_TAC o MATCH_MP
         (ARITH_RULE `(j:num) < 2 ==> j = 0 \/ j = 1`)) THEN
       ASM_REWRITE_TAC[BIT_WORD] THEN CONV_TAC NUM_REDUCE_CONV THEN
       ASM_ARITH_TAC;
       MP_TAC(ISPECL [`3`; `2`; `j:num`] hi) THEN
       ASM_SIMP_TAC[ARITH_RULE `~((j:num) < 2) ==> 2 <= j`] THEN
       CONV_TAC NUM_REDUCE_CONV]) in
   let btm = prove
    (`!c j. j < dimindex (:'a)
        ==> (bit j ((tag_mask c):'a word) <=>
             2 <= j /\
             j < dimindex (:'a) - data_to_word_config_len_size c)`,
     REPEAT GEN_TAC THEN DISCH_TAC THEN
     REWRITE_TAC[tag_mask_def] THEN
     CONV_TAC(TOP_DEPTH_CONV let_CONV) THEN
     ASM_SIMP_TAC[BIT_WORD_SLICE; BIT_WORD_NOT; BIT_WORD_0] THEN
     ASM_ARITH_TAC) in
   let bmh = prove
    (`!c (t:'a word) n j. j < dimindex (:'a)
        ==> (bit j (make_header c t n:'a word) <=>
             j < 2 \/ (2 <= j /\ bit (j - 2) t) \/
             (dimindex (:'a) - data_to_word_config_len_size c <= j /\
              bit (j - (dimindex (:'a) -
                        data_to_word_config_len_size c))
                  ((n2w n):'a word)))`,
     REPEAT GEN_TAC THEN DISCH_TAC THEN
     REWRITE_TAC[make_header_def] THEN
     CONV_TAC(TOP_DEPTH_CONV let_CONV) THEN
     ASM_SIMP_TAC[BIT_WORD_OR; BIT_WORD_SHL; b3] THEN
     CONV_TAC TAUT) in
   let n4 = prove
    (`!k. (n2w (4 * k):(N)word) = word_shl (n2w k) 2`,
     let shl4 = prove
      (`!(v:(N)word). word 4 * v = word_shl v 2`,
       REWRITE_TAC[word_shl; GSYM VAL_EQ; VAL_WORD_MUL; VAL_WORD] THEN
       CONV_TAC MOD_DOWN_CONV THEN CONV_TAC NUM_REDUCE_CONV THEN
       REWRITE_TAC[MULT_AC]) in
     GEN_TAC THEN REWRITE_TAC[GSYM shl4; WORD_MUL]) in
   DISCH_TAC THEN
   REWRITE_TAC[WORD_EQ_BITS_ALT] THEN
   X_GEN_TAC `j:num` THEN DISCH_TAC THEN
   ASM_SIMP_TAC[BIT_WORD_AND; btm; bmh; n4; BIT_WORD_SHL] THEN
   MP_TAC(ISPECL
     [`k:num`;
      `dimindex (:'a) - (data_to_word_config_len_size c + 2)`;
      `j - 2`] hi) THEN
   ASM_CASES_TAC `2 <= (j:num)` THEN
   ASM_CASES_TAC
     `j < dimindex (:'a) - data_to_word_config_len_size c` THEN
   ASM_CASES_TAC `bit (j - 2) ((n2w k):'a word)` THEN
   ASM_REWRITE_TAC[] THEN ARITH_NO_BIT_TAC)
### make_header_and_2
  (* make_header ors a 3 in, whose second bit is the one that the 2
     masks out *)
  (let bw2 = prove
    (`!i. bit i (word 2:(N)word) <=> i = 1 /\ 1 < dimindex(:N)`,
     GEN_TAC THEN
     GEN_REWRITE_TAC (LAND_CONV o RAND_CONV o RAND_CONV)
       [ARITH_RULE `2 = 2 EXP 1`] THEN
     REWRITE_TAC[BIT_WORD_POW2]) in
   let bw3_1 = prove
    (`bit 1 (word 3:(N)word) <=> 1 < dimindex(:N)`,
     REWRITE_TAC[BIT_WORD] THEN CONV_TAC NUM_REDUCE_CONV) in
   REWRITE_TAC[make_header_def] THEN
   CONV_TAC(ONCE_DEPTH_CONV let_CONV) THEN
   REWRITE_TAC[WORD_EQ_BITS_ALT; BIT_WORD_AND; BIT_WORD_OR; bw2] THEN
   GEN_TAC THEN DISCH_TAC THEN
   ASM_CASES_TAC `i = 1` THEN ASM_REWRITE_TAC[bw3_1] THEN
   CONV_TAC TAUT)
### encode_header_tag_mask
  (* the header of encode_header is make_header of four times the
     tag, whose and with the tag mask make_header_tag_mask says is
     sixteen times the tag and whose and with the two
     make_header_and_2 says is the two; the or of those two is their
     sum, because sixteen times a number has no bit as low as the
     second *)
  (
   let bw2 = prove
    (`!i. bit i (word 2:(N)word) <=> i = 1 /\ 1 < dimindex(:N)`,
     GEN_TAC THEN
     GEN_REWRITE_TAC (LAND_CONV o RAND_CONV o RAND_CONV)
       [ARITH_RULE `2 = 2 EXP 1`] THEN
     REWRITE_TAC[BIT_WORD_POW2]) in
   let n16 = prove
    (`!k. (n2w (16 * k):(N)word) = word_shl (n2w k) 4`,
     let shl16 = prove
      (`!(v:(N)word). word 16 * v = word_shl v 4`,
       REWRITE_TAC[word_shl; GSYM VAL_EQ; VAL_WORD_MUL; VAL_WORD] THEN
       CONV_TAC MOD_DOWN_CONV THEN CONV_TAC NUM_REDUCE_CONV THEN
       REWRITE_TAC[MULT_AC]) in
     GEN_TAC THEN REWRITE_TAC[GSYM shl16; WORD_MUL]) in
   let and2_0 = prove
    (`!k. (n2w (16 * k):(N)word) && n2w 2 = n2w 0`,
     GEN_TAC THEN REWRITE_TAC[n16] THEN
     REWRITE_TAC[WORD_EQ_BITS_ALT; BIT_WORD_AND; BIT_WORD_0;
                 BIT_WORD_SHL; bw2] THEN
     X_GEN_TAC `i:num` THEN DISCH_TAC THEN
     ASM_CASES_TAC `(i:num) = 1` THEN ASM_REWRITE_TAC[] THEN
     CONV_TAC NUM_REDUCE_CONV) in
   let orsum = prove
    (`!k. (n2w (16 * k):(N)word) || n2w 2 = n2w (16 * k + 2)`,
     GEN_TAC THEN
     MP_TAC(SPEC_ALL (ISPECL [`n2w (16 * k):(N)word`; `n2w 2:(N)word`]
       WORD_ADD_OR)) THEN
     REWRITE_TAC[and2_0] THEN
     DISCH_THEN(fun th -> REWRITE_TAC[GSYM th]) THEN
     REWRITE_TAC[WORD_ADD]) in
   let distr = WORD_BITWISE_RULE
     `!(x:(N)word) a b. x && (a || b) = (x && a) || (x && b)` in
   STRIP_TAC THEN
   USE_CHANGED [encode_header_def] THEN
   COND_CASES_TAC THEN REWRITE_TAC[distinctness "option"] THEN
   REWRITE_TAC[injectivity "option"] THEN
   DISCH_THEN(SUBST_ALL_TAC o SYM) THEN
   FIRST_X_ASSUM(CONJUNCTS_THEN ASSUME_TAC) THEN
   CONJ_TAC THENL
    [ASM_ARITH_TAC;
     REWRITE_TAC[distr] THEN
     ONCE_REWRITE_TAC[WORD_AND_SYM] THEN
     REWRITE_TAC[make_header_and_2] THEN
     SUBGOAL_THEN
       `tag_mask c && make_header c ((n2w (4 * tag)):'a word) n =
        n2w (4 * (4 * tag))`
       SUBST1_TAC THENL
      [MATCH_MP_TAC make_header_tag_mask THEN
       REWRITE_TAC[ARITH_RULE `d - (k + 2) = d - k - 2`] THEN
       ASM_REWRITE_TAC[];
       ONCE_REWRITE_TAC[WORD_AND_SYM] THEN
       REWRITE_TAC[ARITH_RULE `4 * (4 * tag) = 16 * tag`; orsum]]])
### memory_rel_tag_limit
  (* the tag of an empty Block is below the bound by what
     memory_rel_Block_IMP says, and the tag of a Block with a
     payload by the header that encode_header gives it *)
  (STRIP_TAC THEN USE2 memory_rel_Block_IMP THEN STRIP_TAC THEN
   OPEN_COND THEN
   TRY(FIRST_ASSUM ACCEPT_TAC) THEN
   USE2 encode_header_tag_mask THEN STRIP_TAC THEN
   FIRST_ASSUM ACCEPT_TAC)
### LESS_DIV_16_IMP
  (ARITH_TAC)
### MULT_BIT0
  (* HOL4's BIT0_ODD, which the port does not have of bitTheory *)
  (let bit0 = prove
    (`!n. BIT 0 n <=> ODD n`,
     REWRITE_TAC[BIT; BITS; MOD_2EXP; DIV_2EXP; SUB_0; EXP; DIV_1;
                 ARITH_RULE `SUC 0 = 1`; EXP_1] THEN
     GEN_TAC THEN
     MP_TAC(SPECL [`n:num`; `2`] DIVISION) THEN
     REWRITE_TAC[ARITH_EQ] THEN
     MP_TAC(SPEC `n:num` EVEN_OR_ODD) THEN
     REWRITE_TAC[EVEN_MOD; ODD_MOD] THEN ARITH_TAC) in
   REWRITE_TAC[bit0; ODD_MULT])
### memory_rel_test_nil_eq
  (* memory_rel_Block_IMP says what the word of the Block is: of an
     empty Block it is sixteen times the tag plus two, whose lowest
     bit is clear, and of a Block with values it is a pointer, whose
     lowest bit is set.  So of an empty Block the two words are
     equal exactly when the two numbers are, both of which are below
     dimword by LESS_DIV_16_IMP, and of a Block with values the test
     fails on the lowest bit *)
  (let ldi = LESS_DIV_16_IMP in
   let n2w_11 = prove
    (`!a b. a < dimword (:N) /\ b < dimword (:N)
        ==> ((n2w a:(N)word) = n2w b <=> a = b)`,
     REPEAT STRIP_TAC THEN
     REWRITE_TAC[GSYM VAL_EQ; VAL_WORD; GSYM dimword] THEN
     ASM_SIMP_TAC[MOD_LT]) in
   STRIP_TAC THEN
   FIRST_ASSUM(fun mr -> FIRST_ASSUM(fun gd ->
     MP_TAC(MATCH_MP memory_rel_Block_IMP
       (CONJ mr gd)))) THEN
   DISCH_THEN(X_CHOOSE_THEN `u:'a word`
     (CONJUNCTS_THEN2 SUBST_ALL_TAC MP_TAC)) THEN
   COND_CASES_TAC THEN ASM_REWRITE_TAC[] THENL
    [DISCH_THEN(CONJUNCTS_THEN2 SUBST_ALL_TAC STRIP_ASSUME_TAC) THEN
     EXISTS_TAC `n2w tag * n2w 16 + (n2w 2):'a word` THEN
     REWRITE_TAC[GSYM WORD_MUL; GSYM WORD_ADD] THEN
     MP_TAC(SPECL [`tag * 16 + 2`; `16 * n + 2`]
       (INST_TYPE [`:'a`,`:N`] n2w_11)) THEN
     ANTS_TAC THENL
      [CONJ_TAC THENL
        [MP_TAC(INST [`tag:num`,`n:num`;
                      `dimword (:'a)`,`k:num`] ldi);
         MP_TAC(INST [`dimword (:'a)`,`k:num`] ldi)] THEN
       ASM_ARITH_TAC;
       DISCH_THEN(fun th -> REWRITE_TAC[th]) THEN ARITH_TAC];
     STRIP_TAC THEN EXISTS_TAC `u:'a word` THEN REWRITE_TAC[] THEN
     DISCH_THEN SUBST_ALL_TAC THEN
     FIRST_ASSUM(fun b0 ->
       CONTR_TAC(REWRITE_RULE[word_index; BIT_WORD; EXP; DIV_1;
         ODD_ADD; ODD_MULT; ARITH] b0))])
### memory_rel_test_none_eq
  (* the Block has values, because its length is not zero, so
     memory_rel_Block_IMP gives its header, and encode_header of the
     tag and that length is SOME of it, not NONE *)
  (REPEAT STRIP_TAC THEN
   SUBGOAL_THEN `~(l:(dataSem_v)list = [])` ASSUME_TAC THENL
    [REWRITE_TAC[GSYM LENGTH_EQ_NIL] THEN ASM_REWRITE_TAC[];
     ALL_TAC] THEN
   FIRST_ASSUM(fun mr -> FIRST_ASSUM(fun gd ->
     MP_TAC(MATCH_MP memory_rel_Block_IMP
       (CONJ mr gd)))) THEN
   ASM_REWRITE_TAC[] THEN STRIP_TAC THEN
   (* the equations of the chosen witnesses are used up, the tag and
      the length first *)
   REPEAT(FIRST_X_ASSUM(fun th ->
     if is_eq(concl th) && is_var(lhand(concl th))
     then SUBST_ALL_TAC th else fail())) THEN
   FIRST_X_ASSUM(fun th ->
     let c = concl th in
     if is_eq c && is_var(rand c) && not(is_var(lhand c))
     then SUBST_ALL_TAC(SYM th) else fail()) THEN
   FIRST_ASSUM(fun th1 -> FIRST_ASSUM(fun th2 ->
     CONTR_TAC(REWRITE_RULE[th1; option_DISTINCT] th2))))
### not_bit_lt_2exp
  (* the number is below 2 EXP (p + 1), so every bit of it from
     there up is zero *)
  (REPEAT STRIP_TAC THEN
   FIRST_X_ASSUM(MP_TAC o REWRITE_RULE[BIT; BITS; MOD_2EXP;
                                       DIV_2EXP]) THEN
   SUBGOAL_THEN `n DIV (2 EXP (p + (x + 1))) = 0` SUBST1_TAC THENL
    [MATCH_MP_TAC DIV_LT THEN
     MATCH_MP_TAC LTE_TRANS THEN
     EXISTS_TAC `2 EXP (p + 1)` THEN ASM_REWRITE_TAC[LE_EXP] THEN
     CONV_TAC NUM_REDUCE_CONV THEN ARITH_TAC;
     REWRITE_TAC[ARITH_RULE `SUC a - a = 1`] THEN
     CONV_TAC NUM_REDUCE_CONV])
### encode_header_EQ
  (* two headers with the same bits have the same fields: the bit of
     the tag at j is the bit of the header at j plus two, the bit of
     the length at j is the one at j plus the shift, and above their
     fields both tags and both lengths have no bit at all *)
  (let hi = prove
    (`!n r (i:num). n < 2 EXP r /\ r <= i
        ==> ~(bit i ((n2w n):'a word))`,
     MATCH_ACCEPT_TAC BIT_WORD_HI) in
   let b3 = prove
    (`!j. j < dimindex (:'a)
          ==> (bit j ((n2w 3):'a word) <=> j < 2)`,
     GEN_TAC THEN DISCH_TAC THEN
     ASM_CASES_TAC `(j:num) < 2` THEN ASM_REWRITE_TAC[] THENL
      [FIRST_ASSUM(DISJ_CASES_THEN SUBST_ALL_TAC o MATCH_MP
         (ARITH_RULE `(j:num) < 2 ==> j = 0 \/ j = 1`)) THEN
       ASM_REWRITE_TAC[BIT_WORD] THEN CONV_TAC NUM_REDUCE_CONV THEN
       ASM_ARITH_TAC;
       MP_TAC(ISPECL [`3`; `2`; `j:num`] hi) THEN
       ASM_SIMP_TAC[ARITH_RULE `~((j:num) < 2) ==> 2 <= j`] THEN
       CONV_TAC NUM_REDUCE_CONV]) in
   let bmh = prove
    (`!c (t:'a word) n j. j < dimindex (:'a)
        ==> (bit j (make_header c t n:'a word) <=>
             j < 2 \/ (2 <= j /\ bit (j - 2) t) \/
             (dimindex (:'a) - data_to_word_config_len_size c <= j /\
              bit (j - (dimindex (:'a) -
                        data_to_word_config_len_size c))
                  ((n2w n):'a word)))`,
     REPEAT GEN_TAC THEN DISCH_TAC THEN
     REWRITE_TAC[make_header_def] THEN
     CONV_TAC(TOP_DEPTH_CONV let_CONV) THEN
     ASM_SIMP_TAC[BIT_WORD_OR; BIT_WORD_SHL; b3] THEN
     CONV_TAC TAUT) in
   let n2w_inj = prove
    (`!a b m. a < 2 EXP m /\ b < 2 EXP m /\ m <= dimindex (:'a) /\
              ((n2w a):'a word = n2w b)
        ==> a = b`,
     REPEAT GEN_TAC THEN STRIP_TAC THEN
     FIRST_X_ASSUM(MP_TAC o AP_TERM `val:'a word->num`) THEN
     REWRITE_TAC[VAL_WORD] THEN
     SUBGOAL_THEN
       `a < 2 EXP dimindex (:'a) /\ b < 2 EXP dimindex (:'a)`
       STRIP_ASSUME_TAC THENL
      [CONJ_TAC THEN TRANS_TAC LTE_TRANS `2 EXP m` THEN
       ASM_SIMP_TAC[LE_EXP; ARITH];
       ASM_SIMP_TAC[MOD_LT]]) in
   REWRITE_TAC[encode_header_def] THEN
   COND_CASES_TAC THEN COND_CASES_TAC THEN
   REWRITE_TAC[distinctness "option"; injectivity "option"] THEN
   REPEAT(FIRST_X_ASSUM(fun th ->
     if is_conj (concl th) then STRIP_ASSUME_TAC th else fail())) THEN
   DISCH_THEN(CONJUNCTS_THEN2 (SUBST1_TAC o SYM)
     (CONJUNCTS_THEN2 (SUBST1_TAC o SYM) ASSUME_TAC)) THEN
   EQ_TAC THENL
    [DISCH_THEN(fun hdeq ->
       ASSUME_TAC(REWRITE_RULE[WORD_EQ_BITS_ALT] hdeq)) THEN
     SUBGOAL_THEN
       `((n2w t1):'a word = n2w t2) /\ ((n2w l1):'a word = n2w l2)`
       MP_TAC THENL
      [CONJ_TAC THEN REWRITE_TAC[WORD_EQ_BITS_ALT] THEN
       X_GEN_TAC `j:num` THEN DISCH_TAC THENL
        [ASM_CASES_TAC `j < dimindex (:'a) -
                        data_to_word_config_len_size c - 2` THENL
          [SUBGOAL_THEN
             `~(j + 2 < 2) /\ 2 <= j + 2 /\
              ~(dimindex (:'a) - data_to_word_config_len_size c <=
                j + 2) /\
              (j + 2) - 2 = j /\ j + 2 < dimindex (:'a)`
             STRIP_ASSUME_TAC THENL [ASM_ARITH_TAC; ALL_TAC] THEN
           FIRST_X_ASSUM(fun bits -> MP_TAC(SPEC `j + 2` bits)) THEN
           ASM_SIMP_TAC[bmh] THEN TRY(DISCH_THEN ACCEPT_TAC);
           MP_TAC(ISPECL
             [`t1:num`; `dimindex (:'a) -
               data_to_word_config_len_size c - 2`; `j:num`] hi) THEN
           MP_TAC(ISPECL
             [`t2:num`; `dimindex (:'a) -
               data_to_word_config_len_size c - 2`; `j:num`] hi) THEN
           ASM_SIMP_TAC[ARITH_RULE `~((j:num) < m) ==> m <= j`] THEN
           DISCH_THEN(fun th -> REWRITE_TAC[th]) THEN
           DISCH_THEN(fun th -> REWRITE_TAC[th])];
         ASM_CASES_TAC `j < data_to_word_config_len_size c` THENL
          [SUBGOAL_THEN
             `~(j + (dimindex (:'a) -
                     data_to_word_config_len_size c) < 2) /\
              2 <= j + (dimindex (:'a) -
                        data_to_word_config_len_size c) /\
              dimindex (:'a) - data_to_word_config_len_size c <=
              j + (dimindex (:'a) -
                   data_to_word_config_len_size c) /\
              (j + (dimindex (:'a) -
                    data_to_word_config_len_size c)) -
              (dimindex (:'a) - data_to_word_config_len_size c) = j /\
              j + (dimindex (:'a) -
                   data_to_word_config_len_size c) <
              dimindex (:'a) /\
              dimindex (:'a) - data_to_word_config_len_size c - 2 <=
              (j + (dimindex (:'a) -
                    data_to_word_config_len_size c)) - 2`
             STRIP_ASSUME_TAC THENL [ASM_ARITH_TAC; ALL_TAC] THEN
           FIRST_X_ASSUM(fun bits -> MP_TAC(SPEC
             `j + (dimindex (:'a) -
                   data_to_word_config_len_size c)` bits)) THEN
           ASM_SIMP_TAC[bmh] THEN
           MP_TAC(ISPECL
             [`t1:num`; `dimindex (:'a) -
               data_to_word_config_len_size c - 2`;
              `(j + (dimindex (:'a) -
                     data_to_word_config_len_size c)) - 2`] hi) THEN
           MP_TAC(ISPECL
             [`t2:num`; `dimindex (:'a) -
               data_to_word_config_len_size c - 2`;
              `(j + (dimindex (:'a) -
                     data_to_word_config_len_size c)) - 2`] hi) THEN
           ASM_REWRITE_TAC[] THEN
           DISCH_THEN(fun th -> REWRITE_TAC[th]) THEN
           DISCH_THEN(fun th -> REWRITE_TAC[th]) THEN
           TRY(DISCH_THEN ACCEPT_TAC);
           MP_TAC(ISPECL
             [`l1:num`; `data_to_word_config_len_size c`;
              `j:num`] hi) THEN
           MP_TAC(ISPECL
             [`l2:num`; `data_to_word_config_len_size c`;
              `j:num`] hi) THEN
           ASM_SIMP_TAC[ARITH_RULE `~((j:num) < m) ==> m <= j`] THEN
           DISCH_THEN(fun th -> REWRITE_TAC[th]) THEN
           DISCH_THEN(fun th -> REWRITE_TAC[th])]];
       STRIP_TAC THEN CONJ_TAC THENL
        [MATCH_MP_TAC n2w_inj THEN
         EXISTS_TAC `dimindex (:'a) -
                     data_to_word_config_len_size c - 2` THEN
         ASM_REWRITE_TAC[] THEN ARITH_TAC;
         MATCH_MP_TAC n2w_inj THEN
         EXISTS_TAC `data_to_word_config_len_size c` THEN
         ASM_REWRITE_TAC[] THEN ASM_ARITH_TAC]];
     DISCH_THEN(CONJUNCTS_THEN SUBST1_TAC) THEN REFL_TAC])
### memory_rel_ValueArray_IMP
  (* the header of a reference's array, read out of the memory: as
     for a byte array, the v_inv of the RefPtr gives the pointer
     (whose lowest bit is set, which is get_addr_0), bc_ref_inv
     gives the RefBlock of the heap and get_real_addr_get_addr the
     address.  The cond of the word_el says what decode_length of
     the header is, and the three bits of the statement are read
     off make_header: the tag of a RefTag is two, which puts the
     bit at three, and the length sits above the len_size, which
     heap_in_memory_store keeps seven below the word size *)
  (let hd_is n t =
     (try fst(dest_const(fst(strip_comb t))) = n
      with Failure _ -> false) in
   let rec facs t =
     if hd_is "STAR" t then
       let args = snd(strip_comb t) in
       facs (el 0 args) @ facs (el 1 args)
     else [t] in
   let grab asl p =
     tryfind (fun (_,th) ->
       if (try p th with Failure _ -> false) then th else fail()) asl in
   let is_hl th = hd_is "heap_lookup" (lhs (concl th)) in
   let sepfront names =
     W(fun (asl,w) ->
       let pred = rator (lhand w) in
       let fs = facs pred in
       let picked = map (fun n -> find (hd_is n) fs) names in
       let rest = filter (fun t -> not (mem t picked)) fs in
       let st = fst(strip_comb pred) in
       let mk a b = mk_comb(mk_comb(st,a),b) in
       let target = itlist mk picked (end_itlist mk rest) in
       SUBGOAL_THEN (mk_eq(pred,target)) SUBST1_TAC THENL
        [REWRITE_TAC[STAR_AC]; ALL_TAC]) in
   MEMORY_REL_TAC THEN V_INV_TAC v_inv_def THEN
   TRY(FIRST_ASSUM(fun t1 -> FIRST_ASSUM(fun t2 ->
     CONTR_TAC(REWRITE_RULE[injectivity "option";
                            distinctness "bvlSem_ref"]
                 (TRANS (SYM t1) t2))))) THEN
   FIRST_ASSUM(fun e ->
     let c = concl e in
     if is_eq c && is_var (rand c) && hd_is "wordLang_Word" (lhs c)
     then SUBST1_TAC (SYM e) else fail()) THEN
   REWRITE_TAC[injectivity "word_loc"] THEN
   CONV_TAC(REDEPTH_CONV UNWIND_CONV) THEN
   REWRITE_TAC[get_addr_0] THEN
   FIRST_X_ASSUM(fun th ->
     if is_forall (concl th) &&
        hd_is "bc_ref_inv" (rand (snd(strip_forall(concl th))))
     then MP_TAC(SPEC `p:num` th) else fail()) THEN
   ANTS_TAC THENL
    [CONJ_TAC THENL
      [REWRITE_TAC[reachable_refs_def; MEM] THEN
       EXISTS_TAC `RefPtr bl p:dataSem_v` THEN
       EXISTS_TAC `p:num` THEN
       REWRITE_TAC[get_refs_def; MEM;
                   CONJUNCT1(SPEC_ALL RTC_RULES)];
       ASM_REWRITE_TAC[]];
     ALL_TAC] THEN
   REWRITE_TAC[bc_ref_inv_def] THEN
   ASM_SIMP_TAC[FLOOKUP_DEF] THEN
   MATCH_REDUCE_TAC THEN
   DISCH_THEN STRIP_ASSUME_TAC THEN
   FIRST_X_ASSUM(fun th ->
     if hd_is "heap_in_memory_store" (concl th)
     then MP_TAC(REWRITE_RULE[heap_in_memory_store_def] th)
     else fail()) THEN
   STRIP_TAC THEN
   W(fun (asl,w) ->
     MP_TAC(MATCH_MP heap_lookup_SPLIT
              (grab asl is_hl))) THEN
   DISCH_THEN STRIP_ASSUME_TAC THEN
   VAR_EQ_TAC THEN
   FIRST_X_ASSUM(fun th ->
     if (try hd_is "fmap_apply" (lhs (concl th))
         with Failure _ -> false)
     then SUBST_ALL_TAC th else fail()) THEN
   W(fun (asl,w) ->
     let hl = grab asl is_hl in
     let hlen = grab asl (fun th ->
       hd_is "heap_length" (lhand (concl th))) in
     let cu = grab asl (fun th ->
       hd_is "FLOOKUP" (lhs (concl th)) &&
       fst(dest_const(rand(lhs(concl th)))) = "CurrHeap") in
     let gd = grab asl (fun th -> concl th = `good_dimindex (:'a)`) in
     let gat = tryfind (fun t ->
       find_term (fun u ->
         hd_is "get_addr" u && length (snd(strip_comb u)) = 3) t)
       (w :: map (fun (_,th) -> concl th) asl) in
     let th = SPEC (last (snd(strip_comb gat)))
       (GEN `w:('a)word_loc`
         (MATCH_MP get_real_addr_get_addr
           (CONJ hlen (CONJ hl (CONJ cu gd))))) in
     let r = rhs (concl (CONJUNCT1 th)) in
     let a = rand r in
     let args = snd(strip_comb (rand a)) in
     let mul = fst(strip_comb (rand a)) in
     let swap = mk_comb(rator a,
                  mk_comb(mk_comb(mul,el 1 args),el 0 args)) in
     let sw = WORD_RULE (mk_eq(a,swap)) in
     EXISTS_TAC swap THEN
     STRIP_ASSUME_TAC(REWRITE_RULE[sw] th)) THEN
   FIRST_X_ASSUM(fun th ->
     if (try hd_is "STAR" (rator (concl th)) with Failure _ -> false)
     then MP_TAC th else fail()) THEN
   REWRITE_TAC[word_heap_APPEND; word_heap_def;
               RefBlock_def] THEN
   CONV_TAC(TOP_DEPTH_CONV let_CONV) THEN
   REWRITE_TAC[word_el_def] THEN
   CONV_TAC(TOP_DEPTH_CONV let_CONV) THEN
   REWRITE_TAC[word_payload_def] THEN
   CONV_TAC(TOP_DEPTH_CONV let_CONV) THEN
   REWRITE_TAC[word_list_def; LENGTH_MAP] THEN
   sepfront ["cond"] THEN
   REWRITE_TAC[cond_STAR] THEN
   DISCH_THEN(CONJUNCTS_THEN2 STRIP_ASSUME_TAC MP_TAC) THEN
   sepfront ["set_sep_one"] THEN
   DISCH_THEN(fun sep ->
     let rd = MATCH_MP read_fun2set sep in
     EXISTS_TAC (rand (rhs (concl (CONJUNCT1 rd)))) THEN
     STRIP_ASSUME_TAC rd) THEN
   FIRST_ASSUM(fun lr ->
     if hd_is "ALL2" (concl lr)
     then SUBST1_TAC(SYM(MATCH_MP LIST_REL_LENGTH lr)) else fail()) THEN
   ASM_REWRITE_TAC[] THEN
   REWRITE_TAC[make_header_def] THEN
   CONV_TAC(TOP_DEPTH_CONV let_CONV) THEN
   REWRITE_TAC[BIT_WORD_OR; BIT_WORD_SHL; BIT_WORD] THEN
   CONV_TAC NUM_REDUCE_CONV THEN
   UNDISCH_TAC `data_to_word_config_len_size c + 7 < dimindex (:'a)`
     THEN ARITH_TAC)
### blocks_unique_Thunk
  (* the value of the thunk is a value of the refs already *)
  (let vcons = prove
    (`!(v:dataSem_v) xs y. MEM y (v_all_vs (CONS v xs)) <=>
        MEM y (v_all_vs [v]) \/ MEM y (v_all_vs xs)`,
     REPEAT GEN_TAC THEN
     GEN_REWRITE_TAC (LAND_CONV o RAND_CONV o RAND_CONV)
       [prove(`!(h:dataSem_v) t. CONS h t = APPEND [h] t`,
              REWRITE_TAC[APPEND])] THEN
     REWRITE_TAC[v_all_vs_append; MEM_APPEND]) in
   let inc = prove
    (`!refs p ev x bl vs t a q.
        sptree_lookup p refs = SOME (Thunk ev x) /\
        Block t a q IN all_vs refs (CONS x vs) ==>
        Block t a q IN all_vs refs (CONS (RefPtr bl p) vs)`,
     REWRITE_TAC[all_vs_def; IN_UNION; IN_ELIM_THM] THEN
     MESON_TAC[vcons]) in
   REWRITE_TAC[blocks_unique_def] THEN STRIP_TAC THEN
   REPEAT GEN_TAC THEN STRIP_TAC THEN FIRST_ASSUM MATCH_MP_TAC THEN
   REPEAT CONJ_TAC THEN ASM_MESON_TAC[inc])
### blocks_unique_Thunk2
  (* the value of the Thunk at p is already among the values of the
     references, so the stack with it in front has the same values
     as the stack without it, and the uniqueness carries over.  The
     element of the goal picks the assumption about it (there are
     two), and the two sides of the transfer are split the same way
     so that the disjuncts match one by one *)
  (
   let cons_app = prove
    (`!(h:dataSem_v) t. CONS h t = APPEND [h] t`,
     REWRITE_TAC[APPEND]) in
   let hd_is n t =
     (try fst(dest_const(fst(strip_comb t))) = n
      with Failure _ -> false) in
   REWRITE_TAC[blocks_unique_def] THEN
   DISCH_THEN(CONJUNCTS_THEN2 ASSUME_TAC ASSUME_TAC) THEN
   REPEAT GEN_TAC THEN STRIP_TAC THEN FIRST_ASSUM MATCH_MP_TAC THEN
   ASM_REWRITE_TAC[] THEN CONJ_TAC THEN
   W(fun (asl,w) ->
     let gel = el 0 (snd(strip_comb w)) in
     FIRST_ASSUM(fun inm ->
       let c = concl inm in
       if not (hd_is "IN" c) || not (el 0 (snd(strip_comb c)) = gel)
       then fail() else
       FIRST_ASSUM(fun lk ->
         if not (hd_is "=" (concl lk)) then fail() else
         MP_TAC(REWRITE_RULE[all_vs_def; IN_UNION;
                             IN_ELIM_THM; v_all_vs_append;
                             MEM_APPEND]
                  (ONCE_REWRITE_RULE[cons_app] inm)) THEN
         MP_TAC lk THEN
         REWRITE_TAC[all_vs_def; IN_UNION; IN_ELIM_THM;
                     v_all_vs_append; MEM_APPEND] THEN
         MESON_TAC[]))))
### get_byte_set_byte_alt
  (REPEAT STRIP_TAC THEN ASM_MESON_TAC[get_byte_set_byte_diff])
### MOD_MULT_MOD_LEMMA
  (* n divides k, so k is n times the quotient and MOD_MOD gives
     the modulus of the modulus *)
  (STRIP_TAC THEN
   SUBGOAL_THEN `?q. k:num = n * q` (CHOOSE_THEN SUBST_ALL_TAC) THENL
    [EXISTS_TAC `k DIV n` THEN
     MP_TAC(SPECL [`k:num`; `n:num`] DIVISION) THEN
     ASM_SIMP_TAC[ARITH_RULE `0 < n ==> ~(n = 0)`] THEN
     ASM_REWRITE_TAC[ADD_CLAUSES] THEN MESON_TAC[MULT_SYM];
     ASM_REWRITE_TAC[MOD_MOD]])
### w2n_add_byte_align_lemma
  (* the alignment of a word is the word shifted down and up again,
     so its lowest bits are clear and adding it does not change the
     value by the bytes in a word -- which is two to the shift, as
     the two good dimindexes give *)
  (let LOG2_RED =
     REPEATC(CHANGED_CONV(ONCE_DEPTH_CONV(REWR_CONV LOG2) THENC
                          NUM_REDUCE_CONV THENC REWRITE_CONV[])) in
   let slice_shl = prove
    (`!p (w:(N)word).
        word_slice (dimindex (:N) - 1) p w =
        word_shl (word_ushr w p) p`,
     REPEAT GEN_TAC THEN
     REWRITE_TAC[word_slice; word_bits; WORD_EQ_BITS_ALT;
                 BIT_WORD_SHL; BIT_WORD_SUBWORD; BIT_WORD_USHR] THEN
     X_GEN_TAC `i:num` THEN DISCH_TAC THEN
     ASM_CASES_TAC `p:num <= i` THEN ASM_REWRITE_TAC[] THEN
     SUBGOAL_THEN
       `i - p < MIN ((dimindex (:N) - 1 + 1) - p) (dimindex (:N))`
       (fun th -> REWRITE_TAC[th]) THENL
      [REWRITE_TAC[ARITH_RULE
         `MIN a b = if a <= b then a else b`] THEN
       COND_CASES_TAC THEN ASM_ARITH_TAC;
       REWRITE_TAC[ARITH_RULE `p + (i - p) = (i - p) + p`]]) in
   let main = prove
    (`!p d (x:(N)word) y. d = 2 EXP p /\ p <= dimindex (:N)
        ==> w2n (x + word_shl y p) MOD d = w2n x MOD d`,
     REPEAT GEN_TAC THEN
     DISCH_THEN(CONJUNCTS_THEN2 SUBST1_TAC ASSUME_TAC) THEN
     REWRITE_TAC[VAL_WORD_ADD; VAL_WORD_SHL; MOD_MOD_EXP_MIN] THEN
     ASM_SIMP_TAC[ARITH_RULE `p <= d ==> MIN d p = p`] THEN
     ONCE_REWRITE_TAC[GSYM MOD_ADD_MOD] THEN
     REWRITE_TAC[MOD_MOD_EXP_MIN] THEN
     ASM_SIMP_TAC[ARITH_RULE `p <= d ==> MIN d p = p`] THEN
     REWRITE_TAC[MOD_MULT; ADD_CLAUSES; MOD_MOD_REFL]) in
   DISCH_TAC THEN
   REWRITE_TAC[byte_align_def; align_def;
               slice_shl] THEN
   MATCH_MP_TAC main THEN
   FIRST_ASSUM(DISJ_CASES_THEN SUBST1_TAC o
     REWRITE_RULE[good_dimindex_def]) THEN
   CONV_TAC NUM_REDUCE_CONV THEN CONV_TAC LOG2_RED THEN
   CONV_TAC NUM_REDUCE_CONV)
### get_byte_byte_align
  (* which byte an address picks out is its remainder by the bytes
     in a word, which adding a byte aligned word does not change *)
  (DISCH_TAC THEN
   REWRITE_TAC[get_byte_def] THEN
   AP_TERM_TAC THEN AP_TERM_TAC THEN
   REWRITE_TAC[byte_index_def] THEN
   CONV_TAC(TOP_DEPTH_CONV let_CONV) THEN
   ASM_SIMP_TAC[w2n_add_byte_align_lemma])
### get_byte_eq
  (* the byte that an address selects does not change when the
     address is taken modulo the word it is in *)
  (STRIP_TAC THEN
   FIRST_X_ASSUM(fun th -> ONCE_REWRITE_TAC[th]) THEN
   ONCE_REWRITE_TAC[WORD_ADD_SYM] THEN
   FIRST_ASSUM(fun gd ->
     MATCH_ACCEPT_TAC(MATCH_MP get_byte_byte_align gd)))
### write_bytes_same
  (* the words come out the same because every byte that one of
     them reads is the same in the two lists: the head word reads
     the first bytes (the bytes_to_word of a list of bytes that
     agree up to the count), and the tail reads the rest, which the
     DROP shifts by the count *)
  (let btw = prove
    (`!k a b1 b2 (w:(N)word) be.
        (!n. n < k ==> n < LENGTH b1 /\ n < LENGTH b2 /\
             EL n b1 = EL n b2)
        ==> bytes_to_word k a b1 w be = bytes_to_word k a b2 w be`,
     INDUCT_TAC THEN REPEAT GEN_TAC THENL
      [REWRITE_TAC[bytes_to_word_def]; ALL_TAC] THEN
     DISCH_TAC THEN
     GEN_REWRITE_TAC BINOP_CONV [bytes_to_word_def] THEN
     REWRITE_TAC[NOT_SUC] THEN
     FIRST_ASSUM(MP_TAC o SPEC `0`) THEN
     REWRITE_TAC[LT_0] THEN STRIP_TAC THEN
     MP_TAC(ISPEC `b1:(word8)list` list_CASES) THEN
     DISCH_THEN(DISJ_CASES_THEN2 SUBST_ALL_TAC
       (X_CHOOSE_THEN `h1:word8`
         (X_CHOOSE_THEN `t1:(word8)list` SUBST_ALL_TAC))) THENL
      [ASM_MESON_TAC[LENGTH; LT_REFL]; ALL_TAC] THEN
     MP_TAC(ISPEC `b2:(word8)list` list_CASES) THEN
     DISCH_THEN(DISJ_CASES_THEN2 SUBST_ALL_TAC
       (X_CHOOSE_THEN `h2:word8`
         (X_CHOOSE_THEN `t2:(word8)list` SUBST_ALL_TAC))) THENL
      [ASM_MESON_TAC[LENGTH; LT_REFL]; ALL_TAC] THEN
     RULE_ASSUM_TAC(REWRITE_RULE[EL; HD]) THEN
     ASM_REWRITE_TAC[] THEN AP_THM_TAC THEN AP_TERM_TAC THEN
     REWRITE_TAC[SUC_SUB1] THEN
     FIRST_X_ASSUM MATCH_MP_TAC THEN
     X_GEN_TAC `n:num` THEN DISCH_TAC THEN
     FIRST_X_ASSUM(MP_TAC o SPEC `SUC n`) THEN
     ASM_REWRITE_TAC[LT_SUC; LENGTH; EL; TL] THEN
     ASM_ARITH_TAC) in
   let lt1 = ARITH_RULE `!n m b:num. n < b ==> n < m * b + b` in
   let lt2 = ARITH_RULE
     `!n m b:num. n < m * b ==> n + b < m * b + b` in
   let lt3 = ARITH_RULE `!n b l:num. n + b < l ==> n < l - b` in
   LIST_INDUCT_TAC THEN
   REWRITE_TAC[write_bytes_def] THEN
   REPEAT GEN_TAC THEN
   CONV_TAC(TOP_DEPTH_CONV let_CONV) THEN
   REWRITE_TAC[CONS_11] THEN
   DISCH_TAC THEN CONJ_TAC THENL
    [MATCH_MP_TAC btw THEN
     X_GEN_TAC `n:num` THEN DISCH_TAC THEN
     FIRST_X_ASSUM MATCH_MP_TAC THEN
     REWRITE_TAC[LENGTH; MULT] THEN
     MATCH_MP_TAC lt1 THEN ASM_REWRITE_TAC[];
     FIRST_X_ASSUM MATCH_MP_TAC THEN
     X_GEN_TAC `n:num` THEN DISCH_TAC THEN
     REWRITE_TAC[LENGTH_DROP] THEN
     FIRST_X_ASSUM(MP_TAC o SPEC `n + dimindex (:'a) DIV 8`) THEN
     ANTS_TAC THENL
      [REWRITE_TAC[LENGTH; MULT] THEN
       MATCH_MP_TAC lt2 THEN ASM_REWRITE_TAC[];
       ALL_TAC] THEN
     STRIP_TAC THEN ASM_SIMP_TAC[EL_DROP] THEN
     REPEAT CONJ_TAC THEN TRY(MATCH_MP_TAC lt3) THEN
     ASM_REWRITE_TAC[]])
### memory_rel_RefPtr_IMP_lemma
  (* every rule of v_inv for a RefPtr says that the pointer is in
     the refs: the first through the domain of f, the other two
     with the lookup itself *)
  (MEMORY_REL_TAC THEN V_INV_TAC v_inv_def THEN
   ASM_MESON_TAC[domain_lookup; SUBSET])
### memory_rel_MutBlock_IMP_F
  (* a RefPtr T is no MutBlock: every rule of v_inv that gives one
     a root says so *)
  (MEMORY_REL_TAC THEN V_INV_TAC v_inv_def THEN ASM_MESON_TAC[])
### memory_rel_RefPtr_T_IMP
  (* a RefPtr T is no thunk (the rule of v_inv for one asks for a
     RefPtr F) and no MutBlock, so the four cases of the value in
     the refs are the two arrays and two contradictions *)
  (STRIP_TAC THEN
   FIRST_ASSUM(fun mr ->
     MP_TAC(MATCH_MP memory_rel_RefPtr_IMP_lemma mr)) THEN
   STRIP_TAC THEN CASES_ON_NAME "res" THEN
   ALL_INST3 memory_rel_ValueArray_IMP THEN
   ALL_INST3 memory_rel_ByteArray_IMP THEN
   ALL_INST3 memory_rel_Thunk_IMP THEN
   ALL_INST2 memory_rel_MutBlock_IMP_F THEN
   RULE_ASSUM_TAC(REWRITE_RULE[]) THEN
   TRY(FIRST_X_ASSUM CONTR_TAC) THEN
   ASM_MESON_TAC[])
### memory_rel_RefPtr_IMP
  (* the pointer has a value in the refs, which is a ValueArray or
     a ByteArray because the hypotheses exclude the other two *)
  (STRIP_TAC THEN
   FIRST_ASSUM(fun mr ->
     MP_TAC(MATCH_MP memory_rel_RefPtr_IMP_lemma mr)) THEN
   STRIP_TAC THEN CASES_ON_NAME "res" THEN
   TRY(FIRST_X_ASSUM(fun th -> FIRST_ASSUM(fun a ->
     CONTR_TAC(MP (NOT_ELIM(SPEC_ALL th)) a)))) THEN
   ALL_INST3 memory_rel_ValueArray_IMP THEN
   ALL_INST3 memory_rel_ByteArray_IMP THEN
   ASM_MESON_TAC[])
### smallnum_bits
  (* Smallnum is four times the integer, up to the sign, so
     its two lowest bits are clear *)
  (let bw2 = prove
    (`!i. bit i (word 2:(N)word) <=> i = 1 /\ 1 < dimindex(:N)`,
     GEN_TAC THEN
     GEN_REWRITE_TAC (LAND_CONV o RAND_CONV o RAND_CONV)
       [ARITH_RULE `2 = 2 EXP 1`] THEN
     REWRITE_TAC[BIT_WORD_POW2]) in
   let shl4 = prove
    (`!(v:(N)word). word 4 * v = word_shl v 2`,
     REWRITE_TAC[word_shl; GSYM VAL_EQ; VAL_WORD_MUL; VAL_WORD] THEN
     CONV_TAC MOD_DOWN_CONV THEN CONV_TAC NUM_REDUCE_CONV THEN
     REWRITE_TAC[MULT_AC]) in
   let bits01 = prove
    (`!(v:(N)word). (word 1 && word_shl v 2 = word 0) /\
                    (word 2 && word_shl v 2 = word 0)`,
     GEN_TAC THEN
     REWRITE_TAC[WORD_EQ_BITS_ALT; BIT_WORD_AND; BIT_WORD_0;
                 BIT_WORD_1; bw2; BIT_WORD_SHL] THEN
     CONJ_TAC THEN GEN_TAC THEN DISCH_TAC THEN ARITH_TAC) in
   let nmul = prove
    (`!(i:int). &0 <= i
        ==> n2w (num_of_int (&4 * i)) =
            (n2w 4 * n2w (num_of_int i):(N)word)`,
     REPEAT STRIP_TAC THEN
     SUBGOAL_THEN `num_of_int (&4 * (i:int)) = 4 * num_of_int i`
       SUBST1_TAC THENL
      [FIRST_ASSUM(fun th ->
         GEN_REWRITE_TAC (LAND_CONV o RAND_CONV o RAND_CONV)
           [GSYM(MATCH_MP INT_OF_NUM_OF_INT th)]) THEN
       REWRITE_TAC[INT_OF_NUM_MUL; NUM_OF_INT_OF_NUM];
       REWRITE_TAC[WORD_MUL]]) in
   REWRITE_TAC[smallnum_def] THEN COND_CASES_TAC THENL
    [SUBGOAL_THEN `&0 <= ((&0) - (i:int))` ASSUME_TAC THENL
      [ASM_INT_ARITH_TAC; ALL_TAC] THEN
     FIRST_ASSUM(fun th -> REWRITE_TAC[MATCH_MP nmul th]) THEN
     REWRITE_TAC[WORD_SUB_LZERO; shl4] THEN
     GEN_REWRITE_TAC (ONCE_DEPTH_CONV)
       [WORD_RULE `word_neg (word_shl v 2) = word_shl (word_neg v) 2`]
     THEN REWRITE_TAC[bits01];
     SUBGOAL_THEN `&0 <= (i:int)` ASSUME_TAC THENL
      [ASM_INT_ARITH_TAC; ALL_TAC] THEN
     FIRST_ASSUM(fun th -> REWRITE_TAC[MATCH_MP nmul th]) THEN
     REWRITE_TAC[shl4; bits01]])
### memory_rel_any_Number_IMP
  (* the root of a Number is the Data of its Smallnum, whose lowest
     bit the and with the complement of one clears, or a Pointer,
     whose address has that bit set (get_addr_0) *)
  (MEMORY_REL_TAC THEN V_INV_TAC v_inv_def THEN
    FIRST_ASSUM(fun e ->
      let c = concl e in
      if is_eq c && is_var (rand c) then SUBST1_TAC (SYM e)
      else fail()) THEN
    REWRITE_TAC[injectivity "word_loc"] THEN
    CONV_TAC(REDEPTH_CONV UNWIND_CONV) THEN
    REWRITE_TAC[word_index; get_addr_0; BIT_WORD_AND;
                BIT_WORD_NOT; BIT_WORD_1] THEN
    CONV_TAC NUM_REDUCE_CONV THEN
    REWRITE_TAC[ARITH_RULE `0 < d <=> 1 <= d`; DIMINDEX_GE_1])
### memory_rel_Number_IMP
  (* the root of a small Number is the Data of its Smallnum,
     whose word_addr takes the tag bit off -- and Smallnum is
     four times the integer, which has that bit clear *)
  (let nmul = prove
    (`!(i:int). &0 <= i
        ==> n2w (num_of_int (&4 * i)) =
            (n2w 4 * n2w (num_of_int i):(N)word)`,
     REPEAT STRIP_TAC THEN
     SUBGOAL_THEN `num_of_int (&4 * (i:int)) = 4 * num_of_int i`
       SUBST1_TAC THENL
      [FIRST_ASSUM(fun th ->
         GEN_REWRITE_TAC (LAND_CONV o RAND_CONV o RAND_CONV)
           [GSYM(MATCH_MP INT_OF_NUM_OF_INT th)]) THEN
       REWRITE_TAC[INT_OF_NUM_MUL; NUM_OF_INT_OF_NUM];
       REWRITE_TAC[WORD_MUL]]) in
   let neg2 = prove
    (`word_not (word 1):(N)word = word_neg (word 2)`,
     CONV_TAC WORD_RULE) in
   let sm_and = prove
    (`good_dimindex (:'a) ==>
        ((Smallnum i && word_not (n2w 1)) = (Smallnum i:'a word))`,
     DISCH_TAC THEN REWRITE_TAC[smallnum_def] THEN
     REWRITE_TAC[neg2] THEN ONCE_REWRITE_TAC[WORD_AND_SYM] THEN
     COND_CASES_TAC THENL
      [SUBGOAL_THEN `&0 <= ((&0) - (i:int))` ASSUME_TAC THENL
        [ASM_INT_ARITH_TAC; ALL_TAC] THEN
       FIRST_ASSUM(fun th -> REWRITE_TAC[MATCH_MP nmul th]) THEN
       REWRITE_TAC[WORD_SUB_LZERO] THEN
       SUBGOAL_THEN
         `word_neg (n2w 4 * n2w (num_of_int ((&0) - (i:int)))) =
          word_neg (n2w 4) * (n2w (num_of_int ((&0) - i)):'a word)`
         SUBST1_TAC THENL
        [CONV_TAC WORD_RULE; ALL_TAC] THEN
       MATCH_MP_TAC word_ml_inv_neg_num_lemma THEN
       FIRST_ASSUM ACCEPT_TAC;
       SUBGOAL_THEN `&0 <= (i:int)` ASSUME_TAC THENL
        [ASM_INT_ARITH_TAC; ALL_TAC] THEN
       FIRST_ASSUM(fun th -> REWRITE_TAC[MATCH_MP nmul th]) THEN
       MATCH_MP_TAC word_ml_inv_num_lemma THEN
       FIRST_ASSUM ACCEPT_TAC]) in
   MEMORY_REL_TAC THEN V_INV_TAC v_inv_def THEN
   TRY CONTRA_TAC THEN
   FIRST_ASSUM(fun gd ->
     RULE_ASSUM_TAC(REWRITE_RULE[MATCH_MP sm_and gd])) THEN
   ASM_MESON_TAC[])
### memory_rel_Number_bignum_header
  (let hd_is n t =
     (try fst(dest_const(fst(strip_comb t))) = n
      with Failure _ -> false) in
   let sep_cond_front =
     W(fun (asl,w) ->
       let star t = hd_is "STAR" t in
       let rec facs t =
         if star t then
           let args = snd(strip_comb t) in
           facs (el 0 args) @ facs (el 1 args)
         else [t] in
       let pred = rator (lhand w) in
       let fs = facs pred in
       let isone t = hd_is "set_sep_one" t in
       let iscond t = hd_is "cond" t in
       let one = find isone fs and cnd = find iscond fs in
       let rest = filter (fun t -> not (isone t) && not (iscond t))
                    fs in
       let st = fst(strip_comb pred) in
       let mk a b = mk_comb(mk_comb(st,a),b) in
       let target = mk cnd (mk one (end_itlist mk rest)) in
       SUBGOAL_THEN (mk_eq(pred,target)) SUBST1_TAC THENL
        [REWRITE_TAC[STAR_AC]; ALL_TAC]) in
   MEMORY_REL_TAC THEN
   FIRST_ASSUM(fun vi ->
     if hd_is "v_inv" (concl vi)
     then MP_TAC(REWRITE_RULE[v_inv_def] vi)
     else fail()) THEN
   ASM_REWRITE_TAC[] THEN
   DISCH_THEN(X_CHOOSE_THEN `ptr:num` STRIP_ASSUME_TAC) THEN
   VAR_EQ_TAC THEN
   RULE_ASSUM_TAC(REWRITE_RULE(word_addr_clauses ())) THEN
   FIRST_ASSUM(fun hm ->
     if hd_is "heap_in_memory_store" (concl hm)
     then MP_TAC(REWRITE_RULE[heap_in_memory_store_def] hm)
     else fail()) THEN
   STRIP_TAC THEN
   REPEAT(FIRST_X_ASSUM(fun th ->
     if is_exists (concl th) then
       (X_CHOOSE_THEN `curr:'a word`
         (X_CHOOSE_THEN `other:'a word` STRIP_ASSUME_TAC)) th
     else fail())) THEN
   REWRITE_TAC(word_addr_clauses ()) THEN
   EXISTS_TAC `get_addr c ptr (wordLang_Word ((n2w 0):'a word))` THEN
   EXISTS_TAC `curr + n2w ptr * bytes_in_word:'a word` THEN
   REWRITE_TAC[] THEN CONJ_TAC THENL
    [FIRST_ASSUM(fun hl ->
       if hd_is "=" (concl hl) && hd_is "heap_lookup" (lhs(concl hl))
       then FIRST_ASSUM(fun hlen ->
         FIRST_ASSUM(fun cu ->
           FIRST_ASSUM(fun gd ->
             MP_TAC(SPEC `wordLang_Word ((n2w 0):'a word)`
               (GEN `w:('a)word_loc`
                 (MATCH_MP get_real_addr_get_addr
                   (CONJ hlen (CONJ hl (CONJ cu gd)))))))))
       else fail()) THEN
     DISCH_THEN(ACCEPT_TAC o CONJUNCT2);
     ALL_TAC] THEN
   FIRST_ASSUM(fun hl ->
     if hd_is "=" (concl hl) && hd_is "heap_lookup" (lhs(concl hl))
     then MP_TAC(MATCH_MP heap_lookup_SPLIT hl)
     else fail()) THEN
   DISCH_THEN(X_CHOOSE_THEN
     `ha:(('a word_loc,data_to_word_memoryProof_tag#('a word_loc)
           list)heap_element) list`
     (X_CHOOSE_THEN
       `hb:(('a word_loc,data_to_word_memoryProof_tag#('a word_loc)
             list)heap_element) list` STRIP_ASSUME_TAC)) THEN
   VAR_EQ_TAC THEN
   FIRST_X_ASSUM(fun hs ->
     if (try hd_is "STAR" (rator(concl hs)) with Failure _ -> false)
     then MP_TAC hs else fail()) THEN
   REWRITE_TAC[word_heap_APPEND; word_heap_def;
               bignum_def; i2mw_def] THEN
   CONV_TAC(TOP_DEPTH_CONV let_CONV) THEN
   REWRITE_TAC[word_el_def] THEN
   CONV_TAC(TOP_DEPTH_CONV let_CONV) THEN
   REWRITE_TAC[word_payload_def] THEN
   CONV_TAC(TOP_DEPTH_CONV let_CONV) THEN
   REWRITE_TAC[word_list_def; LENGTH_MAP] THEN
   sep_cond_front THEN
   REWRITE_TAC[cond_STAR] THEN
   DISCH_THEN(CONJUNCTS_THEN2 STRIP_ASSUME_TAC
     (fun st -> MP_TAC(MATCH_MP read_fun2set st))) THEN
   ASM_REWRITE_TAC[] THEN
   DISCH_THEN(CONJUNCTS_THEN2 (SUBST1_TAC o SYM) (K ALL_TAC)) THEN
   AP_TERM_TAC THEN AP_TERM_TAC THEN CONV_TAC WORD_RULE)
### memory_rel_Number_bignum_IMP
  (* the ALT of it says more; this is what the source keeps *)
  (STRIP_TAC THEN
   FIRST_ASSUM(fun t1 -> FIRST_ASSUM(fun t2 -> FIRST_ASSUM(fun t3 ->
     MP_TAC(MATCH_MP memory_rel_Number_bignum_IMP_ALT
       (CONJ t1 (CONJ t2 t3)))))) THEN
   STRIP_TAC THEN
   REPEAT(FIRST_X_ASSUM(CONJUNCTS_THEN ASSUME_TAC)) THEN
   REPEAT(FIRST_X_ASSUM(fun th ->
     if is_exists(concl th) then CHOOSE_TAC th else fail())) THEN
   ASM_MESON_TAC[])
### IMP_memory_rel_Number_num3
  (* the Smallnum of a natural number is it shifted up by two, and
     a number below two to the dimindex less three is small *)
  (let shl2 = prove
    (`!(v:(N)word). word_shl v 2 = word 4 * v`,
     REWRITE_TAC[word_shl; GSYM VAL_EQ; VAL_WORD_MUL; VAL_WORD] THEN
     CONV_TAC MOD_DOWN_CONV THEN CONV_TAC NUM_REDUCE_CONV THEN
     REWRITE_TAC[MULT_AC]) in
   let smallnum_shl = prove
    (`Smallnum (&n) = ((n2w n << 2):'a word)`,
     REWRITE_TAC[smallnum_def; INT_OF_NUM_LT;
                 ARITH_RULE `~(n < 0)`; INT_OF_NUM_MUL;
                 NUM_OF_INT_OF_NUM; shl2; WORD_MUL]) in
   STRIP_TAC THEN
   MP_TAC(INST [`&n:int`,`i:int`]
     IMP_memory_rel_Number) THEN
   REWRITE_TAC[smallnum_shl] THEN
   DISCH_THEN MATCH_MP_TAC THEN
   ASM_REWRITE_TAC[small_int_def; INT_OF_NUM_LT; dimword] THEN
   CONJ_TAC THENL
    [INT_ARITH_TAC;
     UNDISCH_TAC `good_dimindex (:'a)` THEN
     REWRITE_TAC[good_dimindex_def] THEN
     DISCH_THEN(DISJ_CASES_THEN SUBST_ALL_TAC) THEN
     RULE_ASSUM_TAC(CONV_RULE NUM_REDUCE_CONV) THEN
     CONV_TAC NUM_REDUCE_CONV THEN ARITH_ASM_TAC])
### IMP_memory_rel_Number_num
  (* and so is one below two to the dimindex less four *)
  (let shl2 = prove
    (`!(v:(N)word). word_shl v 2 = word 4 * v`,
     REWRITE_TAC[word_shl; GSYM VAL_EQ; VAL_WORD_MUL; VAL_WORD] THEN
     CONV_TAC MOD_DOWN_CONV THEN CONV_TAC NUM_REDUCE_CONV THEN
     REWRITE_TAC[MULT_AC]) in
   let smallnum_shl = prove
    (`Smallnum (&n) = ((n2w n << 2):'a word)`,
     REWRITE_TAC[smallnum_def; INT_OF_NUM_LT;
                 ARITH_RULE `~(n < 0)`; INT_OF_NUM_MUL;
                 NUM_OF_INT_OF_NUM; shl2; WORD_MUL]) in
   STRIP_TAC THEN
   MP_TAC(INST [`&n:int`,`i:int`]
     IMP_memory_rel_Number) THEN
   REWRITE_TAC[smallnum_shl] THEN
   DISCH_THEN MATCH_MP_TAC THEN
   ASM_REWRITE_TAC[small_int_def; INT_OF_NUM_LT; dimword] THEN
   CONJ_TAC THENL
    [INT_ARITH_TAC;
     UNDISCH_TAC `good_dimindex (:'a)` THEN
     REWRITE_TAC[good_dimindex_def] THEN
     DISCH_THEN(DISJ_CASES_THEN SUBST_ALL_TAC) THEN
     RULE_ASSUM_TAC(CONV_RULE NUM_REDUCE_CONV) THEN
     CONV_TAC NUM_REDUCE_CONV THEN ARITH_ASM_TAC])
### memory_rel_Number_EQ
  (* two Numbers of which at least one is small: if both are, both
     roots are Smallnums and num_eq_thm says that two Smallnums are
     equal only for equal integers; if one is not, the lowest bits
     of the two roots differ (that bit says whether the Number is
     small), so the words differ, and so do the integers *)
  (let hd_is n t =
   (try fst(dest_const(fst(strip_comb t))) = n
    with Failure _ -> false) in
   let clash =
     FIRST_ASSUM(fun n ->
       if is_neg (concl n) then
         FIRST_ASSUM(fun p ->
           if concl p = rand (concl n)
           then CONTR_TAC(EQ_MP (EQF_INTRO n) p) else fail())
       else fail()) in
   let all2cons = prove
    (`!P h t (l:(A)list).
        ALL2 P l (CONS (h:B) t) <=>
        ?a b. l = CONS a b /\ P a h /\ ALL2 P b t`,
     REPEAT GEN_TAC THEN
     STRUCT_CASES_TAC(ISPEC `l:(A)list` list_CASES) THEN
     REWRITE_TAC[ALL2; NOT_CONS_NIL; CONS_11] THEN MESON_TAC[]) in
   (* one of the two is small and the other is not: their lowest
      bits differ, so the words differ, and the integers differ
      because small_int holds of one and not of the other *)
   let bits =
     MATCH_MP_TAC(TAUT `~p /\ ~q ==> (p <=> q)`) THEN CONJ_TAC THENL
      [DISCH_THEN SUBST_ALL_TAC THEN
       W(fun (asl,w) ->
         MP_TAC(end_itlist CONJ
           (map snd (filter (fun (_,th) ->
              let c = concl th in
              is_eq c && type_of (lhs c) = bool_ty) asl)))) THEN
       ASM_REWRITE_TAC[];
       DISCH_THEN SUBST_ALL_TAC THEN clash] in
   DISCH_THEN(CONJUNCTS_THEN2 ASSUME_TAC
     (CONJUNCTS_THEN2 ASSUME_TAC ASSUME_TAC)) THEN
   FIRST_ASSUM(fun mr -> FIRST_ASSUM(fun gd ->
     MP_TAC(MATCH_MP memory_rel_any_Number_IMP
              (CONJ gd mr)))) THEN
   DISCH_THEN(X_CHOOSE_THEN `v1:'a word` STRIP_ASSUME_TAC) THEN
   FIRST_ASSUM(fun mr -> FIRST_ASSUM(fun gd ->
     let tl = MATCH_MP memory_rel_tail mr in
     MP_TAC(MATCH_MP memory_rel_any_Number_IMP
              (CONJ gd tl)))) THEN
   DISCH_THEN(X_CHOOSE_THEN `v2:'a word` STRIP_ASSUME_TAC) THEN
   EXISTS_TAC `v1:'a word` THEN EXISTS_TAC `v2:'a word` THEN
   ASM_REWRITE_TAC[] THEN
   ASM_CASES_TAC `small_int (:'a) i1` THEN
   ASM_CASES_TAC `small_int (:'a) i2` THENL
    [(* both are small, so both roots are Smallnums, and num_eq_thm
        says that two Smallnums are equal only for equal integers *)
     FIRST_ASSUM(fun e1 ->
       FIRST_ASSUM(fun mr -> FIRST_ASSUM(fun gd ->
         FIRST_ASSUM(fun si ->
           let ni = MATCH_MP memory_rel_Number_IMP
                      (CONJ gd (CONJ si mr)) in
           SUBST_ALL_TAC(REWRITE_RULE[injectivity "word_loc"]
                           (TRANS (SYM e1) ni)))))) THEN
     FIRST_ASSUM(fun e2 ->
       FIRST_ASSUM(fun mr -> FIRST_ASSUM(fun gd ->
         FIRST_ASSUM(fun si ->
           let tl = MATCH_MP memory_rel_tail mr in
           let ni = MATCH_MP memory_rel_Number_IMP
                      (CONJ gd (CONJ si tl)) in
           SUBST_ALL_TAC(REWRITE_RULE[injectivity "word_loc"]
                           (TRANS (SYM e2) ni)))))) THEN
     FIRST_ASSUM(fun mr ->
       if hd_is "memory_rel" (concl mr)
       then MP_TAC(REWRITE_RULE[memory_rel_def;
                                word_ml_inv_def; MAP; FST] mr)
       else fail()) THEN
     DISCH_THEN STRIP_ASSUME_TAC THEN
     FIRST_X_ASSUM(fun a2 ->
       if hd_is "ALL2" (concl a2)
       then MP_TAC(REWRITE_RULE[MAP; all2cons] a2) else fail()) THEN
     DISCH_THEN STRIP_ASSUME_TAC THEN
     VAR_EQ_TAC THEN
     FIRST_ASSUM(fun am -> FIRST_ASSUM(fun s1 -> FIRST_ASSUM(fun s2 ->
       MP_TAC(MATCH_MP num_eq_thm
                (CONJ am (CONJ s1 s2)))))) THEN
     DISCH_THEN(CONJUNCTS_THEN2 MP_TAC
       (CONJUNCTS_THEN SUBST_ALL_TAC)) THEN
     REWRITE_TAC[injectivity "word_loc";
                 injectivity "heap_address"] THEN
     DISCH_THEN(ACCEPT_TAC o GSYM);
     bits;
     bits;
     (* neither is small, which the statement's disjunction denies *)
     FIRST_ASSUM(fun d ->
       if is_disj (concl d) then DISJ_CASES_TAC d else fail()) THEN
     clash])
### memory_rel_Number_LESS
  (* both words are the Smallnum of their integer, and num_less_thm
     says that the order of the two is the order of the integers *)
  (STRIP_TAC THEN
   FIRST_ASSUM(fun mr -> ASSUME_TAC(MATCH_MP memory_rel_swap mr)) THEN
   ALL_INST3 memory_rel_Number_IMP THEN
   ASM_MESON_TAC[num_less_thm])
### memory_rel_Number_LESS_EQ
  (* the order or the equality, which the two theorems above give *)
  (let wle = prove
    (`!(x:(N)word) y. x <= y <=> x < y \/ x = y`,
     REWRITE_TAC[word_ile; word_ilt; irelational2] THEN
     CONV_TAC(DEPTH_CONV BETA_CONV) THEN
     REWRITE_TAC[GSYM IVAL_EQ] THEN INT_ARITH_TAC) in
   STRIP_TAC THEN
   FIRST_ASSUM(fun mr -> FIRST_ASSUM(fun s1 -> FIRST_ASSUM(fun s2 ->
     FIRST_ASSUM(fun gd ->
       MP_TAC(MATCH_MP memory_rel_Number_EQ
         (CONJ mr (CONJ (DISJ1 s1 (concl s2)) gd))) THEN
       MP_TAC(MATCH_MP memory_rel_Number_LESS
         (CONJ mr (CONJ s1 (CONJ s2 gd)))))))) THEN
   REPEAT STRIP_TAC THEN
   REPEAT(FIRST_X_ASSUM(fun th ->
     if is_eq(concl th) && is_var(lhs(concl th))
     then SUBST_ALL_TAC th else fail())) THEN
   RULE_ASSUM_TAC(REWRITE_RULE[injectivity "word_loc"]) THEN
   ASM_REWRITE_TAC[] THEN
   ASM_MESON_TAC[wle; INT_LE_LT])
### memory_rel_Number_word_msb
  (* zero is a small integer, so the relation holds of it as
     well, and the order of the two Smallnums is the order of
     the integers: the sign bit of the word says which side of
     zero it is on *)
  (let si0 = prove
    (`good_dimindex (:'a) ==> small_int (:'a) (&0)`,
     REWRITE_TAC[good_dimindex_def; small_int_def;
                 dimword] THEN
     STRIP_TAC THEN ASM_REWRITE_TAC[] THEN
     CONV_TAC NUM_REDUCE_CONV THEN INT_ARITH_TAC) in
   let sm0 = prove
    (`Smallnum (&0) = (word 0:(N)word)`,
     REWRITE_TAC[smallnum_def] THEN
     REWRITE_TAC[INT_ARITH `~((&0:int) < &0)`] THEN
     REWRITE_TAC[INT_ARITH `(&4:int) * &0 = &0`;
                 NUM_OF_INT_OF_NUM]) in
   STRIP_TAC THEN
   FIRST_ASSUM(fun gd -> ASSUME_TAC(MATCH_MP si0 gd)) THEN
   ALL_INST3 IMP_memory_rel_Number THEN
   RULE_ASSUM_TAC(REWRITE_RULE[sm0]) THEN
   ALL_INST4 memory_rel_Number_LESS_EQ THEN
   RULE_ASSUM_TAC(REWRITE_RULE[injectivity "word_loc"]) THEN
   REWRITE_TAC[word_msb; MSB_IVAL] THEN
   ASM_MESON_TAC[word_ile; irelational2; IVAL_WORD_0;
                 INT_ARITH `(i:int) < &0 <=> ~(&0 <= i)`])
### memory_rel_RefPtr_EQ_lemma
  (* the one in the lowest bit is free of the shifted pointer, so
     the or is a sum, the sum cancels and the shift is a
     multiplication by two to the shift, which cancels as well
     because both products are below the dimword *)
  (
   let shl_n2w = prove
    (`!n k. word_shl (n2w n:(N)word) k = n2w (n * 2 EXP k)`,
     REPEAT GEN_TAC THEN
     REWRITE_TAC[word_shl; GSYM VAL_EQ; VAL_WORD] THEN
     CONV_TAC MOD_DOWN_CONV THEN REWRITE_TAC[MULT_AC]) in
   let and1 = prove
    (`!(v:(N)word) k. 0 < k ==> word_shl v k && n2w 1 = n2w 0`,
     REPEAT STRIP_TAC THEN
     REWRITE_TAC[WORD_EQ_BITS_ALT; BIT_WORD_AND; BIT_WORD_0;
                 BIT_WORD_SHL; BIT_WORD_1] THEN
     X_GEN_TAC `i:num` THEN DISCH_TAC THEN
     ASM_CASES_TAC `(i:num) = 0` THEN ASM_REWRITE_TAC[] THEN
     ASM_ARITH_TAC) in
   let n2w_11 = prove
    (`!a b. a < dimword (:N) /\ b < dimword (:N)
        ==> ((n2w a:(N)word) = n2w b <=> a = b)`,
     REPEAT STRIP_TAC THEN
     REWRITE_TAC[GSYM VAL_EQ; VAL_WORD; GSYM dimword] THEN
     ASM_SIMP_TAC[MOD_LT]) in
   STRIP_TAC THEN
   FIRST_ASSUM(fun pk ->
     let a1 = MATCH_MP (ISPEC `n2w n:'a word` and1) pk
     and a2 = MATCH_MP (ISPEC `n2w m:'a word` and1) pk in
     RULE_ASSUM_TAC(REWRITE_RULE
       [GSYM (MATCH_MP WORD_ADD_OR a1);
        GSYM (MATCH_MP WORD_ADD_OR a2)])) THEN
   RULE_ASSUM_TAC(REWRITE_RULE[shl_n2w;
     WORD_ARITH `!(x:(N)word) y a. (x + a = y + a) <=> (x = y)`]) THEN
   FIRST_ASSUM(fun eq ->
     FIRST_ASSUM(fun b1 -> FIRST_ASSUM(fun b2 ->
       MP_TAC(EQ_MP (MATCH_MP n2w_11 (CONJ b1 b2)) eq)))) THEN
   SUBGOAL_THEN `~(2 EXP k = 0)` MP_TAC THENL
    [REWRITE_TAC[EXP_EQ_0; ARITH_EQ]; ALL_TAC] THEN
   MESON_TAC[EQ_MULT_RCANCEL])
### memory_rel_RefPtr_EQ_IMP
  (* the value at the pointer is a ByteArray, so the two RefPtrs
     are no thunks and the rule of v_inv for a plain reference
     gives both of them the same address *)
  (let LOOKUP_SUBST =
     FIRST_ASSUM(fun th ->
       let c = concl th in
       if is_eq c &&
          (try fst(dest_const(fst(strip_comb(lhs c)))) =
               "sptree_lookup"
           with Failure _ -> false)
       then RULE_ASSUM_TRY(REWRITE_RULE[th]) else fail()) in
   MEMORY_REL_TAC THEN V_INV_TAC v_inv_def THEN SPLIT_ROOTS_TAC THEN
   V_INV_TAC v_inv_def THEN
   LOOKUP_SUBST THEN
   RULE_ASSUM_TAC(REWRITE_RULE[injectivity "option";
                              distinctness "bvlSem_ref"]) THEN
   TRY(FIRST_ASSUM CONTR_TAC) THEN
   FIRST_ASSUM(fun t1 -> FIRST_ASSUM(fun t2 ->
     MATCH_ACCEPT_TAC(TRANS (SYM t1) t2))))
### memory_rel_Boolv_T
  (* the true Boolv is the empty Block of the true tag, which is
     one, so its root is the Data of BlockNil 1, the word eighteen *)
  (let shl16 = prove
    (`word_shl (word 1:(N)word) 4 = word 16`,
     REWRITE_TAC[word_shl; GSYM VAL_EQ; VAL_WORD] THEN
     CONV_TAC MOD_DOWN_CONV THEN CONV_TAC NUM_REDUCE_CONV) in
   let blocknil1 = prove
    (`BlockNil 1 = (n2w 18:'a word)`,
     REWRITE_TAC[BlockNil_def; shl16] THEN
     CONV_TAC WORD_RULE) in
   let and18 = prove
    (`(n2w 18:(N)word) && word_not (n2w 1) = n2w 18`,
     WORD_NUM_BIT_TAC 5) in
   let dimword16 = prove
    (`good_dimindex (:'a) ==> 1 < dimword (:'a) DIV 16`,
     REWRITE_TAC[good_dimindex_def; dimword] THEN
     DISCH_THEN(DISJ_CASES_THEN SUBST1_TAC) THEN
     CONV_TAC NUM_REDUCE_CONV) in
   let waddr = hd (word_addr_clauses ()) in
   let cons1 = REWRITE_RULE[blocknil1]
     (INST [`1`,`tag:num`] cons_thm_EMPTY) in
   REWRITE_TAC[memory_rel_def; word_ml_inv_def] THEN
   REPEAT STRIP_TAC THEN ASM_EXISTS_TAC THEN
   ASM_REWRITE_TAC[] THEN
   EXISTS_TAC
     `CONS (gc_shared_Data (wordLang_Word (n2w 18:'a word))) hs` THEN
   REWRITE_TAC[MAP; ALL2; waddr; and18] THEN
   ASM_REWRITE_TAC[dataSem_Boolv_def;
                   bool_to_tag_def; true_tag_def] THEN
   MATCH_MP_TAC cons1 THEN
   ASM_SIMP_TAC[dimword16])
### memory_rel_Boolv_F
  (* the false Boolv is the empty Block of the false tag, which is
     zero, so it is the same root as the one of Unit *)
  (let blocknil0 = prove
    (`BlockNil 0 = (n2w 2:'a word)`,
     REWRITE_TAC[BlockNil_def] THEN CONV_TAC WORD_RULE) in
   let and2 = prove
    (`(n2w 2:(N)word) && word_not (n2w 1) = n2w 2`,
     WORD_NUM_BIT_TAC 2) in
   let dimword16 = prove
    (`good_dimindex (:'a) ==> 0 < dimword (:'a) DIV 16`,
     REWRITE_TAC[good_dimindex_def; dimword] THEN
     DISCH_THEN(DISJ_CASES_THEN SUBST1_TAC) THEN
     CONV_TAC NUM_REDUCE_CONV) in
   let waddr = hd (word_addr_clauses ()) in
   let cons0 = REWRITE_RULE[blocknil0]
     (INST [`0`,`tag:num`] cons_thm_EMPTY) in
   REWRITE_TAC[memory_rel_def; word_ml_inv_def] THEN
   REPEAT STRIP_TAC THEN ASM_EXISTS_TAC THEN
   ASM_REWRITE_TAC[] THEN
   EXISTS_TAC
     `CONS (gc_shared_Data (wordLang_Word (n2w 2:'a word))) hs` THEN
   REWRITE_TAC[MAP; ALL2; waddr; and2] THEN
   ASM_REWRITE_TAC[dataSem_Boolv_def;
                   bool_to_tag_def; false_tag_def] THEN
   MATCH_MP_TAC cons0 THEN
   ASM_SIMP_TAC[dimword16])
### memory_rel_Boolv
  (STRIP_TAC THEN ASM_CASES_TAC `b:bool` THEN ASM_SIMP_TAC[] THENL
    [MATCH_MP_TAC memory_rel_Boolv_T;
     MATCH_MP_TAC memory_rel_Boolv_F] THEN
   ASM_REWRITE_TAC[])
### word_ml_inv_SP_LIMIT
  (* the unused space of the invariant lies inside the heap and the
     heap is of the limit *)
  (REWRITE_TAC[word_ml_inv_def; abs_ml_inv_def;
               unused_space_inv_def; heap_ok_def] THEN
   REPEAT STRIP_TAC THEN ARITH_ASM_TAC)
### small_int_w2i_i2w
  (* four times a small integer is between INT_MIN and INT_MAX, so
     the i2w of it has it for its w2i *)
  (let bnds = prove
    (`good_dimindex (:'a) /\ small_int (:'a) i ==>
       --(&2 pow (dimindex (:'a) - 1)) <= (&4) * i /\
       (&4) * i < &2 pow (dimindex (:'a) - 1)`,
     REWRITE_TAC[good_dimindex_def; small_int_def;
                 dimword] THEN
     STRIP_TAC THEN FIRST_X_ASSUM SUBST_ALL_TAC THEN
     RULE_ASSUM_TAC(CONV_RULE NUM_REDUCE_CONV) THEN
     CONV_TAC NUM_REDUCE_CONV THEN
     CONV_TAC(ONCE_DEPTH_CONV INT_POW_CONV) THEN
     ASM_INT_ARITH_TAC) in
   STRIP_TAC THEN MATCH_MP_TAC IVAL_IWORD THEN
   FIRST_ASSUM(fun t1 -> FIRST_ASSUM(fun t2 ->
     ACCEPT_TAC(MATCH_MP bnds (CONJ t1 t2)))))
### memory_rel_Add
  (* the sum of two small integers: the bit zero of each root is
     clear, so memory_rel_any_Number_IMP says that both integers
     are small and memory_rel_Number_IMP that the roots are their
     Smallnums, whose sum is the Smallnum of the sum, because
     Smallnum is i2w of four times the integer.  The sum is small
     in its turn, because w2i of it is four times it by the
     premise, and w2i_i2w_IMP puts that between INT_MIN and
     INT_MAX *)
  (let hd_is n t =
      (try fst(dest_const(fst(strip_comb t))) = n
       with Failure _ -> false) in
    let grab asl p =
      tryfind (fun (_,th) ->
        if (try p th with Failure _ -> false) then th else fail())
        asl in
    (* the sum of two Smallnums *)
    (* the sum and the difference of two Smallnums *)
    let addsm = prove
     (`!i j. word_add (Smallnum i) (Smallnum j) =
             (Smallnum (i + j):(N)word)`,
      REWRITE_TAC[smallnum_i2w; GSYM IWORD_INT_ADD;
                  GSYM INT_ADD_LDISTRIB]) in
    (* and an integer whose four times is between INT_MIN and INT_MAX
       is a small one: the converse of small_int_IMP_MIN_MAX *)
    (* and an integer whose four times is between INT_MIN and INT_MAX
       is a small one: the converse of small_int_IMP_MIN_MAX *)
    let minmax_small = prove
     (`!i. good_dimindex (:'a) /\
           INT_MIN (:'a) <= (&4) * i /\ (&4) * i <= INT_MAX (:'a)
           ==> small_int (:'a) i`,
      REWRITE_TAC[good_dimindex_def; small_int_def;
                  dimword; integer_word_INT_MIN; integer_word_INT_MAX;
                  INT_MIN] THEN
      GEN_TAC THEN STRIP_TAC THEN FIRST_X_ASSUM SUBST_ALL_TAC THEN
      RULE_ASSUM_TAC(CONV_RULE NUM_REDUCE_CONV) THEN
      CONV_TAC NUM_REDUCE_CONV THEN ASM_INT_ARITH_TAC) in
    let mr0 asl = grab asl (fun th -> hd_is "memory_rel" (concl th)) in
    let mr1 asl = MATCH_MP memory_rel_tail (mr0 asl) in
    let mr2 asl = MATCH_MP memory_rel_tail (mr1 asl) in
    let smalls =
      W(fun (asl,w) ->
        let gd = grab asl (fun th ->
          hd_is "good_dimindex" (concl th)) in
        let nbs = map snd (filter (fun (_,th) ->
          is_neg (concl th) &&
          (try hd_is "bit" (rand (concl th)) with Failure _ -> false))
          asl) in
        let any = memory_rel_any_Number_IMP in
        let step m =
          MP_TAC(MATCH_MP any (CONJ gd m)) THEN
          REWRITE_TAC[injectivity "word_loc"; word_index] THEN
          DISCH_THEN(CHOOSE_THEN(fun th ->
            ASSUME_TAC(REWRITE_RULE (GSYM(CONJUNCT1 th) :: nbs)
                         (CONJUNCT2 th)))) in
        step (mr0 asl) THEN step (mr1 asl)) in
  DISCH_THEN(REPEAT_TCL CONJUNCTS_THEN ASSUME_TAC) THEN
    smalls THEN
    W(fun (asl,w) ->
      let gd = grab asl (fun th ->
        hd_is "good_dimindex" (concl th)) in
      let num = memory_rel_Number_IMP in
      let inj = REWRITE_RULE[injectivity "word_loc"] in
      let sis = filter (fun (_,th) -> hd_is "small_int" (concl th))
                  asl in
      let e1 = inj (MATCH_MP num
        (CONJ gd (CONJ (snd (el 1 sis)) (mr0 asl)))) in
      let e2 = inj (MATCH_MP num
        (CONJ gd (CONJ (snd (el 0 sis)) (mr1 asl)))) in
      RULE_ASSUM_TAC(REWRITE_RULE[e1; e2]) THEN
      REWRITE_TAC[e1; e2]) THEN
    REWRITE_TAC[addsm] THEN
    MATCH_MP_TAC IMP_memory_rel_Number THEN
    W(fun (asl,w) ->
      let gd = grab asl (fun th ->
        hd_is "good_dimindex" (concl th)) in
      let sis = filter (fun (_,th) -> hd_is "small_int" (concl th))
                  asl in
      let sw = small_int_w2i_i2w in
      let e1 = MATCH_MP sw (CONJ (snd (el 1 sis)) gd) in
      let e2 = MATCH_MP sw (CONJ (snd (el 0 sis)) gd) in
      let hy = grab asl (fun th -> hd_is "ival" (lhs (concl th))) in
      let th = REWRITE_RULE[smallnum_i2w; e1; e2;
                            GSYM IWORD_INT_ADD;
                            GSYM INT_ADD_LDISTRIB] hy in
      ASSUME_TAC(MATCH_MP minmax_small
        (CONJ gd (MATCH_MP w2i_i2w_IMP th))) THEN
      ASM_REWRITE_TAC[mr2 asl]))
### memory_rel_Sub
  (* the difference of two small integers: the bit zero of each
     root is clear, so memory_rel_any_Number_IMP says that both
     integers are small and memory_rel_Number_IMP that the roots
     are their Smallnums, whose difference is the Smallnum of the
     difference, because Smallnum is i2w of four times the
     integer.  The difference is small in its turn, because w2i of
     it is four times it by the premise, and w2i_i2w_IMP puts that
     between INT_MIN and INT_MAX *)
  (let hd_is n t =
      (try fst(dest_const(fst(strip_comb t))) = n
       with Failure _ -> false) in
    let grab asl p =
      tryfind (fun (_,th) ->
        if (try p th with Failure _ -> false) then th else fail())
        asl in
    (* the difference of two Smallnums *)
    let subsm = prove
     (`!i j. word_sub (Smallnum i) (Smallnum j) =
             (Smallnum (i - j):(N)word)`,
      REWRITE_TAC[smallnum_i2w; GSYM IWORD_INT_SUB;
                  GSYM INT_SUB_LDISTRIB]) in
    (* and an integer whose four times is between INT_MIN and INT_MAX
       is a small one: the converse of small_int_IMP_MIN_MAX *)
    (* and an integer whose four times is between INT_MIN and INT_MAX
       is a small one: the converse of small_int_IMP_MIN_MAX *)
    let minmax_small = prove
     (`!i. good_dimindex (:'a) /\
           INT_MIN (:'a) <= (&4) * i /\ (&4) * i <= INT_MAX (:'a)
           ==> small_int (:'a) i`,
      REWRITE_TAC[good_dimindex_def; small_int_def;
                  dimword; integer_word_INT_MIN; integer_word_INT_MAX;
                  INT_MIN] THEN
      GEN_TAC THEN STRIP_TAC THEN FIRST_X_ASSUM SUBST_ALL_TAC THEN
      RULE_ASSUM_TAC(CONV_RULE NUM_REDUCE_CONV) THEN
      CONV_TAC NUM_REDUCE_CONV THEN ASM_INT_ARITH_TAC) in
    let mr0 asl = grab asl (fun th -> hd_is "memory_rel" (concl th)) in
    let mr1 asl = MATCH_MP memory_rel_tail (mr0 asl) in
    let mr2 asl = MATCH_MP memory_rel_tail (mr1 asl) in
    let smalls =
      W(fun (asl,w) ->
        let gd = grab asl (fun th ->
          hd_is "good_dimindex" (concl th)) in
        let nbs = map snd (filter (fun (_,th) ->
          is_neg (concl th) &&
          (try hd_is "bit" (rand (concl th)) with Failure _ -> false))
          asl) in
        let any = memory_rel_any_Number_IMP in
        let step m =
          MP_TAC(MATCH_MP any (CONJ gd m)) THEN
          REWRITE_TAC[injectivity "word_loc"; word_index] THEN
          DISCH_THEN(CHOOSE_THEN(fun th ->
            ASSUME_TAC(REWRITE_RULE (GSYM(CONJUNCT1 th) :: nbs)
                         (CONJUNCT2 th)))) in
        step (mr0 asl) THEN step (mr1 asl)) in
  DISCH_THEN(REPEAT_TCL CONJUNCTS_THEN ASSUME_TAC) THEN
    smalls THEN
    W(fun (asl,w) ->
      let gd = grab asl (fun th ->
        hd_is "good_dimindex" (concl th)) in
      let num = memory_rel_Number_IMP in
      let inj = REWRITE_RULE[injectivity "word_loc"] in
      let sis = filter (fun (_,th) -> hd_is "small_int" (concl th))
                  asl in
      let e1 = inj (MATCH_MP num
        (CONJ gd (CONJ (snd (el 1 sis)) (mr0 asl)))) in
      let e2 = inj (MATCH_MP num
        (CONJ gd (CONJ (snd (el 0 sis)) (mr1 asl)))) in
      RULE_ASSUM_TAC(REWRITE_RULE[e1; e2]) THEN
      REWRITE_TAC[e1; e2]) THEN
    REWRITE_TAC[subsm] THEN
    MATCH_MP_TAC IMP_memory_rel_Number THEN
    W(fun (asl,w) ->
      let gd = grab asl (fun th ->
        hd_is "good_dimindex" (concl th)) in
      let sis = filter (fun (_,th) -> hd_is "small_int" (concl th))
                  asl in
      let sw = small_int_w2i_i2w in
      let e1 = MATCH_MP sw (CONJ (snd (el 1 sis)) gd) in
      let e2 = MATCH_MP sw (CONJ (snd (el 0 sis)) gd) in
      let hy = grab asl (fun th -> hd_is "ival" (lhs (concl th))) in
      let th = REWRITE_RULE[smallnum_i2w; e1; e2;
                            GSYM IWORD_INT_SUB;
                            GSYM INT_SUB_LDISTRIB] hy in
      ASSUME_TAC(MATCH_MP minmax_small
        (CONJ gd (MATCH_MP w2i_i2w_IMP th))) THEN
      ASM_REWRITE_TAC[mr2 asl]))
### exists_num
  (* an integer that is not below zero is the injection of a
     number, which is HOL Light's INT_OF_NUM_EXISTS *)
  (REWRITE_TAC[INT_OF_NUM_EXISTS; INT_NOT_LT])
### small_int_w2n
  (* a byte is below 256 and the bound of a small integer is a
     quarter of the dimword, which good_dimindex makes 2 EXP 29 at
     the least *)
  (REWRITE_TAC[good_dimindex_def; small_int_def;
               dimword] THEN
   STRIP_TAC THEN ASM_REWRITE_TAC[] THEN
   MATCH_MP_TAC(INT_ARITH
     `&0 <= (i:int) /\ i < n ==> --n <= i /\ i < n`) THEN
   REWRITE_TAC[INT_POS; INT_OF_NUM_LT] THEN
   MP_TAC(ISPEC `w:word8` VAL_BOUND) THEN
   REWRITE_TAC[DIMINDEX_8] THEN CONV_TAC NUM_REDUCE_CONV THEN
   ARITH_TAC)
### memory_rel_And
  (* the and of two bytes as the and of their roots: both roots are
     the Smallnum of their byte, because a byte is a small integer,
     and the and of two Smallnums of bytes is the Smallnum of the
     and of the bytes, because the Smallnum of a byte has the bits
     of the byte two places up *)
  (let hd_is n t =
      (try fst(dest_const(fst(strip_comb t))) = n
       with Failure _ -> false) in
    let grab asl p =
      tryfind (fun (_,th) ->
        if (try p th with Failure _ -> false) then th else fail())
        asl in
    (* the Smallnum of a natural number is four times it, and the and
       with the complement of one leaves such a word alone *)
    let smn = prove
     (`!n. Smallnum (&n) = (n2w (4 * n)):(N)word`,
      GEN_TAC THEN REWRITE_TAC[smallnum_def] THEN
      REWRITE_TAC[INT_ARITH `~((&n:int) < &0)`] THEN
      REWRITE_TAC[INT_OF_NUM_MUL; NUM_OF_INT_OF_NUM]) in
    (* the bits of the Smallnum of a byte: two above the bits
       of the byte *)
    let bitsm = prove
     (`!(x:(M)word) i.
         bit i (n2w (4 * w2n x):(N)word) <=>
         i < dimindex (:N) /\ 2 <= i /\ bit (i - 2) x`,
      REPEAT GEN_TAC THEN REWRITE_TAC[BIT_WORD] THEN
      ASM_CASES_TAC `2 <= i` THENL
       [FIRST_ASSUM(X_CHOOSE_THEN `k:num` SUBST1_TAC o
          REWRITE_RULE[LE_EXISTS]) THEN
        REWRITE_TAC[ARITH_RULE `(2 + k) - 2 = k`; BIT_VAL] THEN
        REWRITE_TAC[EXP_ADD; ARITH_RULE `2 EXP 2 = 4`] THEN
        SIMP_TAC[DIV_MULT2; ARITH_EQ] THEN
        REWRITE_TAC[ARITH_RULE `(2 <= 2 + k) <=> T`] THEN
        CONV_TAC TAUT;
        ASM_REWRITE_TAC[] THEN
        FIRST_ASSUM(fun th ->
          DISJ_CASES_THEN SUBST1_TAC
            (MATCH_MP (ARITH_RULE
               `~(2 <= i) ==> i = 0 \/ i = 1`) th)) THEN
        CONV_TAC NUM_REDUCE_CONV THEN
        REWRITE_TAC[DIV_1] THEN
        REWRITE_TAC[ARITH_RULE `4 * n = 2 * (2 * n)`] THEN
        SIMP_TAC[DIV_MULT; ARITH_EQ] THEN
        REWRITE_TAC[ODD_MULT] THEN CONV_TAC NUM_REDUCE_CONV THEN
        CONV_TAC TAUT]) in
    (* and the Smallnum of a bitwise operation on bytes is the
       operation on the Smallnums *)
    let andsm = prove
     (`!(x:word8) y.
         word_and (Smallnum (&(w2n x))) (Smallnum (&(w2n y))) =
         (Smallnum (&(w2n (word_and x y))):(N)word)`,
      REPEAT GEN_TAC THEN REWRITE_TAC[smn; WORD_EQ_BITS_ALT] THEN
      X_GEN_TAC `i:num` THEN DISCH_TAC THEN
      ASM_REWRITE_TAC[BIT_WORD_AND_ALT; bitsm] THEN CONV_TAC TAUT) in

    DISCH_THEN(CONJUNCTS_THEN2 ASSUME_TAC ASSUME_TAC) THEN
    W(fun (asl,w) ->
      let gd = grab asl (fun th ->
        hd_is "good_dimindex" (concl th)) in
      let mr = grab asl (fun th -> hd_is "memory_rel" (concl th)) in
      let tl = memory_rel_tail in
      let mr2 = MATCH_MP tl mr in
      let mr3 = MATCH_MP tl mr2 in
      let inj = REWRITE_RULE[injectivity "word_loc"] in
      let siw = MATCH_MP small_int_w2n gd in
      let byte th =
        rand (rand (rand (fst(dest_pair(lhand(last
          (snd(strip_comb (concl th)))))))) ) in
      let wv = find (fun v -> type_of v = type_of (byte mr))
                 (frees (concl siw)) in
      let num = memory_rel_Number_IMP in
      let e1 = inj (MATCH_MP num
                      (CONJ gd (CONJ (INST [byte mr,wv] siw) mr))) in
      let e2 = inj (MATCH_MP num
                      (CONJ gd (CONJ (INST [byte mr2,wv] siw) mr2))) in
      REWRITE_TAC[e1; e2; andsm] THEN
      MATCH_MP_TAC IMP_memory_rel_Number THEN
      ASM_REWRITE_TAC[siw; mr3]))
### memory_rel_Or
  (* the or of two bytes as the or of their roots: both roots are
     the Smallnum of their byte, because a byte is a small integer,
     and the or of two Smallnums of bytes is the Smallnum of the
     or of the bytes, because the Smallnum of a byte has the bits
     of the byte two places up *)
  (let hd_is n t =
      (try fst(dest_const(fst(strip_comb t))) = n
       with Failure _ -> false) in
    let grab asl p =
      tryfind (fun (_,th) ->
        if (try p th with Failure _ -> false) then th else fail())
        asl in
    (* the Smallnum of a natural number is four times it, and the and
       with the complement of one leaves such a word alone *)
    let smn = prove
     (`!n. Smallnum (&n) = (n2w (4 * n)):(N)word`,
      GEN_TAC THEN REWRITE_TAC[smallnum_def] THEN
      REWRITE_TAC[INT_ARITH `~((&n:int) < &0)`] THEN
      REWRITE_TAC[INT_OF_NUM_MUL; NUM_OF_INT_OF_NUM]) in
    (* the bits of the Smallnum of a byte: two above the bits
       of the byte *)
    let bitsm = prove
     (`!(x:(M)word) i.
         bit i (n2w (4 * w2n x):(N)word) <=>
         i < dimindex (:N) /\ 2 <= i /\ bit (i - 2) x`,
      REPEAT GEN_TAC THEN REWRITE_TAC[BIT_WORD] THEN
      ASM_CASES_TAC `2 <= i` THENL
       [FIRST_ASSUM(X_CHOOSE_THEN `k:num` SUBST1_TAC o
          REWRITE_RULE[LE_EXISTS]) THEN
        REWRITE_TAC[ARITH_RULE `(2 + k) - 2 = k`; BIT_VAL] THEN
        REWRITE_TAC[EXP_ADD; ARITH_RULE `2 EXP 2 = 4`] THEN
        SIMP_TAC[DIV_MULT2; ARITH_EQ] THEN
        REWRITE_TAC[ARITH_RULE `(2 <= 2 + k) <=> T`] THEN
        CONV_TAC TAUT;
        ASM_REWRITE_TAC[] THEN
        FIRST_ASSUM(fun th ->
          DISJ_CASES_THEN SUBST1_TAC
            (MATCH_MP (ARITH_RULE
               `~(2 <= i) ==> i = 0 \/ i = 1`) th)) THEN
        CONV_TAC NUM_REDUCE_CONV THEN
        REWRITE_TAC[DIV_1] THEN
        REWRITE_TAC[ARITH_RULE `4 * n = 2 * (2 * n)`] THEN
        SIMP_TAC[DIV_MULT; ARITH_EQ] THEN
        REWRITE_TAC[ODD_MULT] THEN CONV_TAC NUM_REDUCE_CONV THEN
        CONV_TAC TAUT]) in
    let orsm = prove
     (`!(x:word8) y.
         word_or (Smallnum (&(w2n x))) (Smallnum (&(w2n y))) =
         (Smallnum (&(w2n (word_or x y))):(N)word)`,
      REPEAT GEN_TAC THEN REWRITE_TAC[smn; WORD_EQ_BITS_ALT] THEN
      X_GEN_TAC `i:num` THEN DISCH_TAC THEN
      ASM_REWRITE_TAC[BIT_WORD_OR_ALT; bitsm] THEN CONV_TAC TAUT) in

    DISCH_THEN(CONJUNCTS_THEN2 ASSUME_TAC ASSUME_TAC) THEN
    W(fun (asl,w) ->
      let gd = grab asl (fun th ->
        hd_is "good_dimindex" (concl th)) in
      let mr = grab asl (fun th -> hd_is "memory_rel" (concl th)) in
      let tl = memory_rel_tail in
      let mr2 = MATCH_MP tl mr in
      let mr3 = MATCH_MP tl mr2 in
      let inj = REWRITE_RULE[injectivity "word_loc"] in
      let siw = MATCH_MP small_int_w2n gd in
      let byte th =
        rand (rand (rand (fst(dest_pair(lhand(last
          (snd(strip_comb (concl th)))))))) ) in
      let wv = find (fun v -> type_of v = type_of (byte mr))
                 (frees (concl siw)) in
      let num = memory_rel_Number_IMP in
      let e1 = inj (MATCH_MP num
                      (CONJ gd (CONJ (INST [byte mr,wv] siw) mr))) in
      let e2 = inj (MATCH_MP num
                      (CONJ gd (CONJ (INST [byte mr2,wv] siw) mr2))) in
      REWRITE_TAC[e1; e2; orsm] THEN
      MATCH_MP_TAC IMP_memory_rel_Number THEN
      ASM_REWRITE_TAC[siw; mr3]))
### memory_rel_Xor
  (* the xor of two bytes as the xor of their roots: both roots are
     the Smallnum of their byte, because a byte is a small integer,
     and the xor of two Smallnums of bytes is the Smallnum of the
     xor of the bytes, because the Smallnum of a byte has the bits
     of the byte two places up *)
  (let hd_is n t =
      (try fst(dest_const(fst(strip_comb t))) = n
       with Failure _ -> false) in
    let grab asl p =
      tryfind (fun (_,th) ->
        if (try p th with Failure _ -> false) then th else fail())
        asl in
    (* the Smallnum of a natural number is four times it, and the and
       with the complement of one leaves such a word alone *)
    let smn = prove
     (`!n. Smallnum (&n) = (n2w (4 * n)):(N)word`,
      GEN_TAC THEN REWRITE_TAC[smallnum_def] THEN
      REWRITE_TAC[INT_ARITH `~((&n:int) < &0)`] THEN
      REWRITE_TAC[INT_OF_NUM_MUL; NUM_OF_INT_OF_NUM]) in
    (* the bits of the Smallnum of a byte: two above the bits
       of the byte *)
    let bitsm = prove
     (`!(x:(M)word) i.
         bit i (n2w (4 * w2n x):(N)word) <=>
         i < dimindex (:N) /\ 2 <= i /\ bit (i - 2) x`,
      REPEAT GEN_TAC THEN REWRITE_TAC[BIT_WORD] THEN
      ASM_CASES_TAC `2 <= i` THENL
       [FIRST_ASSUM(X_CHOOSE_THEN `k:num` SUBST1_TAC o
          REWRITE_RULE[LE_EXISTS]) THEN
        REWRITE_TAC[ARITH_RULE `(2 + k) - 2 = k`; BIT_VAL] THEN
        REWRITE_TAC[EXP_ADD; ARITH_RULE `2 EXP 2 = 4`] THEN
        SIMP_TAC[DIV_MULT2; ARITH_EQ] THEN
        REWRITE_TAC[ARITH_RULE `(2 <= 2 + k) <=> T`] THEN
        CONV_TAC TAUT;
        ASM_REWRITE_TAC[] THEN
        FIRST_ASSUM(fun th ->
          DISJ_CASES_THEN SUBST1_TAC
            (MATCH_MP (ARITH_RULE
               `~(2 <= i) ==> i = 0 \/ i = 1`) th)) THEN
        CONV_TAC NUM_REDUCE_CONV THEN
        REWRITE_TAC[DIV_1] THEN
        REWRITE_TAC[ARITH_RULE `4 * n = 2 * (2 * n)`] THEN
        SIMP_TAC[DIV_MULT; ARITH_EQ] THEN
        REWRITE_TAC[ODD_MULT] THEN CONV_TAC NUM_REDUCE_CONV THEN
        CONV_TAC TAUT]) in
    let xorsm = prove
     (`!(x:word8) y.
         word_xor (Smallnum (&(w2n x))) (Smallnum (&(w2n y))) =
         (Smallnum (&(w2n (word_xor x y))):(N)word)`,
      REPEAT GEN_TAC THEN REWRITE_TAC[smn; WORD_EQ_BITS_ALT] THEN
      X_GEN_TAC `i:num` THEN DISCH_TAC THEN
      ASM_REWRITE_TAC[BIT_WORD_XOR_ALT; bitsm] THEN CONV_TAC TAUT) in

    DISCH_THEN(CONJUNCTS_THEN2 ASSUME_TAC ASSUME_TAC) THEN
    W(fun (asl,w) ->
      let gd = grab asl (fun th ->
        hd_is "good_dimindex" (concl th)) in
      let mr = grab asl (fun th -> hd_is "memory_rel" (concl th)) in
      let tl = memory_rel_tail in
      let mr2 = MATCH_MP tl mr in
      let mr3 = MATCH_MP tl mr2 in
      let inj = REWRITE_RULE[injectivity "word_loc"] in
      let siw = MATCH_MP small_int_w2n gd in
      let byte th =
        rand (rand (rand (fst(dest_pair(lhand(last
          (snd(strip_comb (concl th)))))))) ) in
      let wv = find (fun v -> type_of v = type_of (byte mr))
                 (frees (concl siw)) in
      let num = memory_rel_Number_IMP in
      let e1 = inj (MATCH_MP num
                      (CONJ gd (CONJ (INST [byte mr,wv] siw) mr))) in
      let e2 = inj (MATCH_MP num
                      (CONJ gd (CONJ (INST [byte mr2,wv] siw) mr2))) in
      REWRITE_TAC[e1; e2; xorsm] THEN
      MATCH_MP_TAC IMP_memory_rel_Number THEN
      ASM_REWRITE_TAC[siw; mr3]))
### memory_rel_Number_IMP_Word
  (* a Number stands for a Data of its Smallnum or for a Pointer at
     its Bignum, and the word_addr of either is a Word *)
  (MEMORY_REL_TAC THEN V_INV_TAC v_inv_def THEN ASM_MESON_TAC[])
### memory_rel_Number_IMP_Word_2
  (* the same of the two Numbers at the head of the list *)
  (MEMORY_REL_TAC THEN SPLIT_ROOTS_TAC THEN V_INV_TAC v_inv_def THEN
   ASM_MESON_TAC[])
### memory_rel_zero_space
  (REWRITE_TAC[memory_rel_def] THEN STRIP_TAC THEN
   ASM_EXISTS_TAC THEN ASM_REWRITE_TAC[LE_0])
### memory_rel_less_space
  (REWRITE_TAC[memory_rel_def] THEN REPEAT STRIP_TAC THEN
   ASM_EXISTS_TAC THEN ASM_REWRITE_TAC[] THEN ASM_ARITH_TAC)
### all_ones_bit
  (* all_ones is the slice of the word of all ones, so its bit is
     the one of the subword that the slice shifts up *)
  (DISCH_TAC THEN
   REWRITE_TAC[word_index; all_ones_def] THEN
   COND_CASES_TAC THENL
    [REWRITE_TAC[BIT_WORD_0] THEN
     FIRST_ASSUM(fun th -> MP_TAC th) THEN ARITH_TAC;
     ALL_TAC] THEN
   ASM_SIMP_TAC[word_slice; word_bits; BIT_WORD_SHL;
                BIT_WORD_SUBWORD; BIT_WORD_NOT; BIT_WORD_0] THEN
   REWRITE_TAC[ARITH_RULE `MIN a b = if a <= b then a else b`] THEN
   REPEAT COND_CASES_TAC THEN ASM_REWRITE_TAC[] THEN
   POP_ASSUM_LIST(fun ths -> MAP_EVERY MP_TAC ths) THEN ARITH_TAC)
### maxout_bits_bit
  (* maxout_bits is the number shifted up by the base, and a number
     below two to the width of the field has no bit at the width or
     above, or it is all the ones of the field *)
  (let odd_div = prove
    (`!k m i. k < 2 EXP m /\ m <= i
              ==> (ODD (k DIV 2 EXP i) <=> F)`,
     REPEAT STRIP_TAC THEN
     SUBGOAL_THEN `k DIV 2 EXP i = 0` SUBST1_TAC THENL
      [MATCH_MP_TAC DIV_LT THEN
       TRANS_TAC LTE_TRANS `2 EXP m` THEN
       ASM_REWRITE_TAC[LE_EXP] THEN ARITH_TAC;
       REWRITE_TAC[ODD]]) in
   REWRITE_TAC[word_index; maxout_bits_def] THEN
   COND_CASES_TAC THENL
    [REWRITE_TAC[BIT_WORD_SHL; BIT_WORD] THEN
     STRIP_TAC THEN ASM_REWRITE_TAC[] THEN
     MP_TAC(SPECL [`n:num`; `l:num`; `i - b`] odd_div) THEN
     ASM_REWRITE_TAC[] THEN
     ASM_SIMP_TAC[ARITH_RULE `n < m - 1 ==> n < m`] THEN
     ARITH_ASM_TAC;
     STRIP_TAC THEN
     ASM_MESON_TAC[REWRITE_RULE[word_index] all_ones_bit]])
### maxout_bits_IMP
  (REPEAT STRIP_TAC THEN
   FIRST_ASSUM(fun th1 -> FIRST_ASSUM(fun th2 ->
     MP_TAC(MATCH_MP maxout_bits_bit (CONJ th1 th2)))) THEN
   ARITH_TAC)
### make_cons_ptr_thm
  (* the lower bits of ptr_bits are ptr_bits itself, which the
     source proves here as well (the theorem that states it on its
     own stands further down the file) *)
  (let mb = REWRITE_RULE[word_index] maxout_bits_IMP in
   let bits_lt = prove
    (`!i. i < dimindex (:'a) /\ bit i (ptr_bits c x y:'a word)
          ==> i < small_shift_length c`,
     REWRITE_TAC[ptr_bits_def; small_shift_length_def;
                 BIT_WORD_OR] THEN
     REPEAT STRIP_TAC THEN
     FIRST_X_ASSUM(fun th ->
       MP_TAC(MATCH_MP mb
         (CONJ (ASSUME `i < dimindex (:'a)`) th))) THEN
     ARITH_TAC) in
   let glp = prove
    (`get_lowerbits c (wordLang_Word (ptr_bits c x y)) =
      (ptr_bits c x y || (n2w 1))`,
     REWRITE_TAC[get_lowerbits_def] THEN MATCH_REDUCE_TAC THEN
     AP_THM_TAC THEN AP_TERM_TAC THEN
     REWRITE_TAC[WORD_EQ_BITS_ALT; word_bits; BIT_WORD_SUBWORD;
                 ADD_CLAUSES] THEN
     GEN_TAC THEN DISCH_TAC THEN EQ_TAC THENL
      [SIMP_TAC[];
       DISCH_TAC THEN ASM_REWRITE_TAC[] THEN
       FIRST_ASSUM(fun th1 -> FIRST_ASSUM(fun th2 ->
         MP_TAC(MATCH_MP bits_lt (CONJ th2 th1)))) THEN
       ASM_ARITH_TAC]) in
   REWRITE_TAC[make_cons_ptr_def; glp] THEN
   AP_TERM_TAC THEN WORD_BITWISE_TAC)
### Num_ABS_lemmas
  (REWRITE_TAC[INT_ABS_NUM; INT_ABS_NEG; NUM_OF_INT_OF_NUM])
### memory_rel_Block_MEM
  (* an element of a block at an index, with the root of the index
     put in and taken out again: the length of the block that
     memory_rel_Block_IMP gives is below two to the dimindex less
     four, so the index below it is a small integer, which
     IMP_memory_rel_Number puts in front of the roots and
     memory_rel_swap moves past the block; then memory_rel_El reads
     the element out and memory_rel_rearrange drops the root of the
     index again *)
  (let hd_is n t =
      (try fst(dest_const(fst(strip_comb t))) = n
       with Failure _ -> false) in
    let grab asl p =
      tryfind (fun (_,th) ->
        if (try p th with Failure _ -> false) then th else fail())
        asl in
    (* an index below a length that a header encodes is small *)
    let smallidx = prove
     (`!(i:num) n.
         good_dimindex (:'a) /\ i < n /\
         n < 2 EXP (dimindex (:'a) - 4)
         ==> small_int (:'a) (&i)`,
      REPEAT GEN_TAC THEN
      REWRITE_TAC[small_int_def; dimword;
                  good_dimindex_def] THEN
      DISCH_THEN(CONJUNCTS_THEN2 MP_TAC STRIP_ASSUME_TAC) THEN
      DISCH_THEN(DISJ_CASES_THEN SUBST_ALL_TAC) THEN
      RULE_ASSUM_TAC(CONV_RULE NUM_REDUCE_CONV) THEN
      CONV_TAC NUM_REDUCE_CONV THEN
      CONJ_TAC THEN
      TRY(MATCH_MP_TAC INT_LE_TRANS THEN EXISTS_TAC `&0:int` THEN
          REWRITE_TAC[INT_POS; INT_NEG_LE0; INT_POS] THEN NO_TAC) THEN
      REWRITE_TAC[INT_OF_NUM_LT] THEN ASM_ARITH_TAC) in
  DISCH_THEN(REPEAT_TCL CONJUNCTS_THEN ASSUME_TAC) THEN
    SUBGOAL_THEN `~(ls:(dataSem_v)list = [])` ASSUME_TAC THENL
     [DISCH_TAC THEN VAR_EQ_TAC THEN
      FIRST_X_ASSUM(fun th ->
        if (try hd_is "<" (concl th) with Failure _ -> false)
        then MP_TAC(REWRITE_RULE[LENGTH; LT] th) else fail()) THEN
      REWRITE_TAC[];
      ALL_TAC] THEN
    W(fun (asl,w) ->
      let mr = grab asl (fun th -> hd_is "memory_rel" (concl th)) in
      let gd = grab asl (fun th ->
        hd_is "good_dimindex" (concl th)) in
      MP_TAC(MATCH_MP memory_rel_Block_IMP
               (CONJ mr gd))) THEN
    ASM_REWRITE_TAC[] THEN
    DISCH_THEN STRIP_ASSUME_TAC THEN
    W(fun (asl,w) ->
      let bd = grab asl (fun th ->
        hd_is "<" (concl th) && hd_is "LENGTH" (lhand (concl th)) &&
        hd_is "EXP" (rand (concl th))) in
      let lt = grab asl (fun th ->
        hd_is "<" (concl th) && hd_is "LENGTH" (rand (concl th))) in
      let gd = grab asl (fun th ->
        hd_is "good_dimindex" (concl th)) in
      ASSUME_TAC(MATCH_MP smallidx (CONJ gd (CONJ lt bd)))) THEN
    W(fun (asl,w) ->
      let mr = grab asl (fun th -> hd_is "memory_rel" (concl th)) in
      let si = grab asl (fun th -> hd_is "small_int" (concl th)) in
      let gd = grab asl (fun th ->
        hd_is "good_dimindex" (concl th)) in
      ASSUME_TAC(MATCH_MP IMP_memory_rel_Number
                   (CONJ gd (CONJ si mr)))) THEN
    W(fun (asl,w) ->
      let num = grab asl (fun th ->
        hd_is "memory_rel" (concl th) &&
        hd_is "dataSem_Number"
          (fst(dest_pair(lhand(last(snd(strip_comb (concl th)))))))) in
      let gd = grab asl (fun th ->
        hd_is "good_dimindex" (concl th)) in
      let lt = grab asl (fun th ->
        hd_is "<" (concl th) && hd_is "LENGTH" (rand (concl th))) in
      MP_TAC(MATCH_MP memory_rel_El
               (CONJ (MATCH_MP memory_rel_swap num)
                     (CONJ gd lt)))) THEN
    DISCH_THEN STRIP_ASSUME_TAC THEN
    FIRST_X_ASSUM(fun e ->
      if is_eq (concl e) && hd_is "wordLang_Word" (lhs (concl e)) &&
         hd_is "wordLang_Word" (rhs (concl e))
      then SUBST_ALL_TAC(SYM(REWRITE_RULE[injectivity "word_loc"] e))
      else fail()) THEN
    W(fun (asl,w) ->
      let ind = grab asl (fun th ->
        hd_is "IN" (concl th) &&
        hd_is "word_add" (lhand (concl th))) in
      let x = lhand (lhand (concl ind)) in
      let y = rand (lhand (concl ind)) in
      let ga = grab asl (fun th ->
        hd_is "get_real_addr" (lhs (concl th)) &&
        rand (rhs (concl th)) = x) in
      EXISTS_TAC (rand (lhs (concl ga))) THEN
      EXISTS_TAC x THEN EXISTS_TAC y) THEN
    ASM_REWRITE_TAC[] THEN
    CONJ_TAC THENL
     [ASM_MESON_TAC[injectivity "word_loc"];
      ALL_TAC] THEN
    W(fun (asl,w) ->
      let mr = grab asl (fun th ->
        hd_is "memory_rel" (concl th) &&
        hd_is "EL"
          (fst(dest_pair(lhand(last(snd(strip_comb (concl th)))))))) in
      MATCH_MP_TAC(MATCH_MP
        (ONCE_REWRITE_RULE[TAUT `(p ==> q ==> r) <=> (q ==> p ==> r)`]
           memory_rel_rearrange) mr)) THEN
    ASM_REWRITE_TAC[MEM] THEN
    MESON_TAC[])
### smallnum_0
  (* Smallnum_bits says that the one of its two lowest bits is
     clear; a bit is clear exactly when the and with the word of
     that bit is zero *)
  (let bit0_and = prove
    (`!x:(N)word. bit 0 x <=> ~((n2w 1 && x) = n2w 0)`,
     GEN_TAC THEN
     REWRITE_TAC[WORD_EQ_BITS_ALT; BIT_WORD_AND; BIT_WORD_0;
                 BIT_WORD_1] THEN
     MESON_TAC[DIMINDEX_GE_1; ARITH_RULE `1 <= d ==> 0 < d:num`]) in
   REWRITE_TAC[word_index; bit0_and;
               CONJUNCT1 smallnum_bits])
### smallnum_1
  (* and the other one, where the word of the bit is two and the
     dimindex has to be above one, which good_dimindex gives *)
  (let bw2 = prove
    (`!i. bit i (n2w 2:(N)word) <=> i = 1 /\ 1 < dimindex(:N)`,
     GEN_TAC THEN
     GEN_REWRITE_TAC (LAND_CONV o RAND_CONV o RAND_CONV)
       [ARITH_RULE `2 = 2 EXP 1`] THEN
     REWRITE_TAC[BIT_WORD_POW2]) in
   let bit1_and = prove
    (`!x:(N)word. 1 < dimindex(:N)
                  ==> (bit 1 x <=> ~((n2w 2 && x) = n2w 0))`,
     GEN_TAC THEN DISCH_TAC THEN
     REWRITE_TAC[WORD_EQ_BITS_ALT; BIT_WORD_AND; BIT_WORD_0;
                 bw2] THEN
     ASM_MESON_TAC[]) in
   DISCH_TAC THEN REWRITE_TAC[word_index] THEN
   FIRST_ASSUM(fun gd ->
     MP_TAC(REWRITE_RULE[good_dimindex_def] gd)) THEN
   STRIP_TAC THEN
   ASM_SIMP_TAC[bit1_and; CONJUNCT2 smallnum_bits;
                ARITH_RULE `d = 32 ==> 1 < d:num`;
                ARITH_RULE `d = 64 ==> 1 < d:num`])
### do_eq_list_F_IMP_MEM
  (* a do_eq_list that says F has an element that does: the clause
     of a cons compares the heads and goes on with the tails, so
     either the head is the element (and the index is zero) or the
     induction hypothesis names one of the tail (and the index is
     its successor).  Only the clause of do_eq_list is unfolded:
     the two are one definition, and the other clause would unfold
     the do_eq of the conclusion as well *)
  (let hd_is n t =
   (try fst(dest_const(fst(strip_comb t))) = n
    with Failure _ -> false) in
   LIST_INDUCT_TAC THEN GEN_TAC THEN CASES_ON_NAME "l'" THEN
   ONCE_REWRITE_TAC[CONJUNCT2 dataSem_do_eq_def] THEN
   SAFE_MATCH_REDUCE_TAC THEN
   REWRITE_TAC[LENGTH; NOT_SUC; GSYM NOT_SUC; SUC_INJ;
               injectivity "eq_result"] THEN
   EVERY_CASE_TAC THEN
   STRIP_TAC THEN
   (* the head is the element that fails, or the tail has one *)
   TRY(EXISTS_TAC `0` THEN
       ASM_REWRITE_TAC[EL; HD; LT_0] THEN NO_TAC) THEN
   FIRST_X_ASSUM(fun ih ->
     if is_forall (concl ih) then
       FIRST_ASSUM(fun dl ->
         if (try hd_is "dataSem_do_eq_list" (lhs (concl dl))
             with Failure _ -> false)
         then MP_TAC(SPEC (rand (lhs (concl dl))) ih) else fail())
     else fail()) THEN
   ASM_REWRITE_TAC[] THEN
   DISCH_THEN(X_CHOOSE_THEN `i:num` STRIP_ASSUME_TAC) THEN
   EXISTS_TAC `SUC i` THEN
   ASM_REWRITE_TAC[LT_SUC; EL; TL])
### memory_rel_rotate3
  (MATCH_MP_TAC memory_rel_rearrange THEN
   GEN_TAC THEN REWRITE_TAC[MEM] THEN CONV_TAC TAUT)
### v_inv_Block_tag_limit
  (* the header of the BlockRep that the Block points at is an
     encode_header of four times the tag, and encode_header is only
     a SOME when that is below a sixteenth of the word size *)
  (let hd_is n t =
     (try fst(dest_const(fst(strip_comb t))) = n
      with Failure _ -> false) in
   let rec facs t =
     if hd_is "STAR" t then
       let args = snd(strip_comb t) in
       facs (el 0 args) @ facs (el 1 args)
     else [t] in
   let sepfront names =
     W(fun (asl,w) ->
       let pred = rator (lhand w) in
       let fs = facs pred in
       let picked = map (fun n -> find (hd_is n) fs) names in
       let rest = filter (fun t -> not (mem t picked)) fs in
       let st = fst(strip_comb pred) in
       let mk a b = mk_comb(mk_comb(st,a),b) in
       let target = itlist mk picked (end_itlist mk rest) in
       SUBGOAL_THEN (mk_eq(pred,target)) SUBST1_TAC THENL
        [REWRITE_TAC[STAR_AC]; ALL_TAC]) in
   DISCH_THEN(CONJUNCTS_THEN2 MP_TAC ASSUME_TAC) THEN
   REWRITE_TAC[v_inv_def] THEN
   COND_CASES_TAC THENL
    [STRIP_TAC THEN ASM_REWRITE_TAC[]; ALL_TAC] THEN
   DISCH_THEN STRIP_ASSUME_TAC THEN
   FIRST_X_ASSUM(fun th ->
     if hd_is "heap_in_memory_store" (concl th)
     then MP_TAC(REWRITE_RULE[heap_in_memory_store_def] th)
     else fail()) THEN
   STRIP_TAC THEN
   FIRST_ASSUM(fun th ->
     if hd_is "heap_lookup" (lhs (concl th))
     then MP_TAC(MATCH_MP heap_lookup_SPLIT th)
     else fail()) THEN
   DISCH_THEN STRIP_ASSUME_TAC THEN
   VAR_EQ_TAC THEN
   FIRST_X_ASSUM(fun th ->
     if (try hd_is "STAR" (rator (concl th)) with Failure _ -> false)
     then MP_TAC th else fail()) THEN
   REWRITE_TAC[word_heap_APPEND; word_heap_def;
               word_el_def; BlockRep_def] THEN
   CONV_TAC(TOP_DEPTH_CONV let_CONV) THEN
   REWRITE_TAC[word_payload_def] THEN
   CONV_TAC(TOP_DEPTH_CONV let_CONV) THEN
   sepfront ["cond"] THEN
   REWRITE_TAC[cond_STAR] THEN
   DISCH_THEN(MP_TAC o CONJUNCT1) THEN
   REWRITE_TAC[encode_header_def] THEN
   COND_CASES_TAC THEN
   REWRITE_TAC[distinctness "option"] THEN
   POP_ASSUM MP_TAC THEN ARITH_TAC)
### not_all_distinct_map_snd
  (* a list whose seconds repeat: the induction finds the first
     repetition, either the head's second in the tail -- and then
     the head is the first of the two -- or inside the tail, which
     the hypothesis splits.  The lemma states the split with the
     types of the pairs named, so the two pairs can be taken apart
     and the witnesses written down *)
  (let lem = prove
    (`!l:(A#B)list. ~(ALL_DISTINCT (MAP SND l))
        ==> ?l1 l2 l3 x y1 y2.
              l = l1 ++ [(y1,x)] ++ l2 ++ [(y2,x)] ++ l3`,
     LIST_INDUCT_TAC THEN
     REWRITE_TAC[MAP; ALL_DISTINCT_CLAUSES; DE_MORGAN_THM] THEN
     MP_TAC(ISPEC `h:A#B` PAIR_SURJECTIVE) THEN
     DISCH_THEN(X_CHOOSE_THEN `a:A`
       (X_CHOOSE_THEN `b:B` SUBST_ALL_TAC)) THEN
     REWRITE_TAC[SND; MEM_MAP; MEM_APPEND_DECOMPOSE] THEN
     DISCH_THEN(DISJ_CASES_THEN2
       (X_CHOOSE_THEN `p:A#B` (CONJUNCTS_THEN2
          (X_CHOOSE_THEN `m1:(A#B)list`
            (X_CHOOSE_THEN `m2:(A#B)list` SUBST_ALL_TAC))
          ASSUME_TAC))
       ASSUME_TAC) THENL
      [MP_TAC(ISPEC `p:A#B` PAIR_SURJECTIVE) THEN
       DISCH_THEN(X_CHOOSE_THEN `c:A`
         (X_CHOOSE_THEN `d:B` SUBST_ALL_TAC)) THEN
       RULE_ASSUM_TAC(REWRITE_RULE[SND]) THEN
       FIRST_X_ASSUM SUBST_ALL_TAC THEN
       MAP_EVERY EXISTS_TAC
         [`[]:(A#B)list`; `m1:(A#B)list`; `m2:(A#B)list`;
          `d:B`; `a:A`; `c:A`] THEN
       REWRITE_TAC[APPEND];
       FIRST_X_ASSUM(fun ih -> FIRST_X_ASSUM(fun nd ->
         MP_TAC(MATCH_MP ih nd))) THEN
       DISCH_THEN(REPEAT_TCL CHOOSE_THEN SUBST_ALL_TAC) THEN
       MAP_EVERY EXISTS_TAC
         [`CONS (a:A,b:B) (l1:(A#B)list)`; `l2:(A#B)list`;
          `l3:(A#B)list`; `x:B`; `y1:A`; `y2:A`] THEN
       REWRITE_TAC[APPEND]]) in
   MATCH_ACCEPT_TAC lem)
### IN_all_vs_HD
  (REWRITE_TAC[all_vs_def; IN_UNION; IN_ELIM_THM] THEN
   REPEAT DISJ2_TAC THEN MATCH_MP_TAC MEM_v_all_vs THEN
   REWRITE_TAC[MEM])
### IN_all_vs_TL
  (* the three parts of all_vs that read the refs are the same, and
     what the stack reaches is still reached when a value is put in
     front of it: the values of that one come first, whatever it is *)
  (let tl_mem = prove
    (`!y xs x. MEM x (v_all_vs xs) ==> MEM x (v_all_vs (CONS y xs))`,
     REPEAT GEN_TAC THEN DISCH_TAC THEN
     STRUCT_CASES_TAC(ISPEC `y:dataSem_v` (cases_of `:dataSem_v`)) THEN
     GEN_REWRITE_TAC ONCE_DEPTH_CONV [v_all_vs_def] THEN
     MATCH_REDUCE_TAC THEN
     ASM_REWRITE_TAC[MEM; MEM_APPEND]) in
   REWRITE_TAC[all_vs_def; IN_UNION; IN_ELIM_THM] THEN
   STRIP_TAC THEN ASM_MESON_TAC[tl_mem])
### get_lowerbits_shift_length
  (* the bits of the shifted or are the shifted bits of each, and
     the second word has none left; BIT_GUARD is what says that a
     bit that is set is one of the word's own *)
  (DISCH_TAC THEN
   FIRST_X_ASSUM(MP_TAC o
     REWRITE_RULE[WORD_EQ_BITS_ALT; BIT_WORD_0;
                  BIT_WORD_USHR]) THEN
   DISCH_TAC THEN
   REWRITE_TAC[WORD_EQ_BITS_ALT; BIT_WORD_OR; BIT_WORD_USHR] THEN
   REPEAT STRIP_TAC THEN ASM_SIMP_TAC[] THEN
   GEN_REWRITE_TAC RAND_CONV [BIT_GUARD] THEN REWRITE_TAC[])
### shift_shift
  (* the shift up multiplies by two to the shift, which stays below
     the dimword, so the shift down divides it out again *)
  (let e2 = prove
    (`!l. 1 <= 2 EXP l`,
     REWRITE_TAC[ARITH_RULE `1 <= n <=> ~(n = 0)`; EXP_EQ_0;
                 ARITH_EQ]) in
   DISCH_TAC THEN
   SUBGOAL_THEN `n1 < dimword (:'a) /\ 2 EXP l * n1 < dimword (:'a)`
     STRIP_ASSUME_TAC THENL
    [CONJ_TAC THENL
      [TRANS_TAC LET_TRANS `n1 * 2 EXP l` THEN ASM_REWRITE_TAC[] THEN
       SUBGOAL_THEN `n1 * 1 <= n1 * 2 EXP l` MP_TAC THENL
        [REWRITE_TAC[LE_MULT_LCANCEL] THEN
         DISJ2_TAC THEN MATCH_ACCEPT_TAC e2;
         ARITH_TAC];
       ONCE_REWRITE_TAC[MULT_SYM] THEN ASM_REWRITE_TAC[]];
     ALL_TAC] THEN
   REWRITE_TAC[GSYM VAL_EQ; VAL_WORD_USHR; VAL_WORD_SHL; VAL_WORD;
               GSYM dimword] THEN
   CONV_TAC MOD_DOWN_CONV THEN
   ASM_SIMP_TAC[MOD_LT; DIV_MULT; EXP_EQ_0; ARITH_EQ])
### word_addr_Data_NE_get_addr
  (* the address of a Data of a Loc is a Loc, and the one of a Data
     of a word has its lowest bit taken off, where get_addr_0 says
     that the lowest bit of an address is set *)
  (DISCH_TAC THEN CASES_ON_NAME "a1" THEN
   REWRITE_TAC(word_addr_clauses () @
               [distinctness "word_loc"; injectivity "word_loc"]) THEN
   DISCH_TAC THEN
   FIRST_ASSUM(fun eq ->
     let ga = PART_MATCH (rand o rator)
                (GEN_ALL get_addr_0) (rand (concl eq)) in
     CONTR_TAC(REWRITE_RULE[GSYM eq; word_index; BIT_WORD_AND;
                            BIT_WORD_NOT; BIT_WORD_1] ga)))
### elements_list_all_blocks
  (* the elements of an elements_list are the payload of the next
     one, so each of them is a Block when the first is, and each is
     smaller than the next: the size of a Block counts the sizes of
     its payload, and the element is one of that payload *)
  (let sumc = prove
    (`SUM [] = 0 /\ (!h t. SUM (CONS h t) = h + SUM t)`,
     REWRITE_TAC[SUM_DEF; ITLIST]) in
   let sum_append = prove
    (`!l1 l2. SUM (l1 ++ l2) = SUM l1 + SUM l2`,
     LIST_INDUCT_TAC THEN
     ASM_REWRITE_TAC[APPEND; sumc; ADD_CLAUSES; ADD_ASSOC]) in
   let vbs = prove
    (`!ts t ls. vb_size (Block ts t ls) =
                1 + t + SUM (MAP vb_size ls) + LENGTH ls`,
     REPEAT GEN_TAC THEN
     GEN_REWRITE_TAC LAND_CONV [vb_size_def] THEN
     MATCH_REDUCE_TAC THEN REWRITE_TAC[]) in
   SUBGOAL_THEN
     `!xs. elements_list xs /\ ~(xs = []) /\
           (?t a b. HD xs = Block t a b)
           ==> EVERY (\x. ?t a b. x = Block t a b) xs /\
               SORTED (\x y. vb_size x < vb_size y) xs`
     (fun th -> MATCH_ACCEPT_TAC th) THEN
   LIST_INDUCT_TAC THENL [REWRITE_TAC[]; ALL_TAC] THEN
   POP_ASSUM MP_TAC THEN
   STRUCT_CASES_TAC(ISPEC `t:(dataSem_v)list` list_CASES_v) THEN
   DISCH_TAC THENL
    [REWRITE_TAC[ALL; SORTED_DEF; HD] THEN MESON_TAC[];
     REWRITE_TAC[elements_list_def; HD; ALL; SORTED_DEF] THEN
     STRIP_TAC THEN
     SUBGOAL_THEN
       `EVERY (\x. ?t a b. x = Block t a b) (CONS v vs) /\
        SORTED (\x y. vb_size x < vb_size y) (CONS v vs)`
       (fun th -> STRIP_ASSUME_TAC(REWRITE_RULE[ALL] th)) THENL
      [FIRST_X_ASSUM MATCH_MP_TAC THEN
       ASM_REWRITE_TAC[NOT_CONS_NIL; HD] THEN ASM_MESON_TAC[];
       ALL_TAC] THEN
     ASM_REWRITE_TAC[] THEN
     ASM_REWRITE_TAC[vbs; MAP_APPEND; sum_append; LENGTH_APPEND;
                     MAP; LENGTH; sumc] THEN
     REPEAT CONJ_TAC THEN TRY ARITH_TAC THEN MESON_TAC[]])
### memory_rel_elements_list_distinct
  (* the roots of the tail of an elements_list are distinct: the
     tail is what the lemma says it of, whose Block the second
     clause of elements_list names (the head of the list is an
     element of it).  The tail of the empty list is empty, which is
     HOL4's clause for it (ml/lib/hol4.ml) *)
  (let hd_is n t =
   (try fst(dest_const(fst(strip_comb t))) = n
    with Failure _ -> false) in
 let grab asl p =
   tryfind (fun (_,th) ->
     if (try p th with Failure _ -> false) then th else fail())
     asl in
   REPEAT GEN_TAC THEN STRIP_TAC THEN
   VAR_EQ_TAC THEN
   CASES_ON_NAME "vars'" THEN
   REWRITE_TAC[hol4_TL] THEN
   TRY(REWRITE_TAC[MAP; ALL_DISTINCT; PAIRWISE] THEN NO_TAC) THEN
   FIRST_ASSUM(fun mr ->
     if hd_is "memory_rel" (concl mr)
     then ASSUME_TAC(MATCH_MP memory_rel_tl mr)
     else fail()) THEN
   CASES_ON_NAME "a1" THEN
   REWRITE_TAC[hol4_TL] THEN
   TRY(REWRITE_TAC[MAP; ALL_DISTINCT; PAIRWISE] THEN NO_TAC) THEN
   FIRST_X_ASSUM(fun el ->
     if hd_is "elements_list" (concl el)
     then MP_TAC(REWRITE_RULE[MAP; elements_list_def] el)
     else fail()) THEN
   DISCH_THEN STRIP_ASSUME_TAC THEN
   MATCH_MP_TAC
     memory_rel_elements_list_distinct_lemma THEN
   W(fun (asl,w) ->
     let be = grab asl (fun th ->
       is_eq (concl th) && hd_is "dataSem_Block" (rhs (concl th))) in
     let args = snd(strip_comb (rhs (concl be))) in
     let cs = conjuncts (snd(strip_exists w)) in
     EXISTS_TAC (rhs (el 2 cs)) THEN
     EXISTS_TAC (el 0 args) THEN EXISTS_TAC (el 1 args) THEN
     EXISTS_TAC (el 2 args)) THEN
   FIRST_ASSUM(fun e ->
     if is_eq (concl e) && hd_is "dataSem_Block" (rhs (concl e))
     then RULE_ASSUM_TAC(REWRITE_RULE[e]) THEN
          ASM_REWRITE_TAC[e; MAP; HD; NOT_CONS_NIL; PAIRWISE;
                          hol4_TL]
     else fail()))
### memory_rel_elements_list_words
  (* every root of the tail of an elements_list is a Word: the
     second element of the list is a Block by the third clause of
     elements_list, so the root of the tail that memory_rel_tl
     keeps is the Word that memory_rel_Block_IMP gives it, and the
     induction says it of the rest.  The hypothesis of the
     induction is moved into the goal, so that the split of the
     tail reaches it *)
  (let hd_is n t =
      (try fst(dest_const(fst(strip_comb t))) = n
       with Failure _ -> false) in
    let grab asl p =
      tryfind (fun (_,th) ->
        if (try p th with Failure _ -> false) then th else fail())
        asl in
  SUBGOAL_THEN
      `!vars0 (c:data_to_word_config) be ts refs sp st m dm.
         memory_rel c be ts refs sp st m (dm:'a word->bool) vars0 /\
         elements_list (MAP FST vars0) /\ good_dimindex (:'a)
         ==> ALL isWord (TL (MAP SND vars0))`
      (fun th ->
        REPEAT GEN_TAC THEN
        DISCH_THEN(REPEAT_TCL CONJUNCTS_THEN ASSUME_TAC) THEN
        VAR_EQ_TAC THEN DISCH_THEN(K ALL_TAC) THEN
        W(fun (asl,w) ->
          let mr = grab asl (fun t -> hd_is "memory_rel" (concl t)) in
          let args = snd(strip_comb (concl mr)) in
          let el = grab asl (fun t ->
            hd_is "elements_list" (concl t)) in
          let gd = grab asl (fun t ->
            hd_is "good_dimindex" (concl t)) in
          ACCEPT_TAC(MP (SPECL (last args :: butlast args) th)
                        (CONJ mr (CONJ el gd))))) THEN
    LIST_INDUCT_TAC THENL
     [REWRITE_TAC[MAP; hol4_TL; ALL];
      ALL_TAC] THEN
    POP_ASSUM MP_TAC THEN
    W(fun (asl,w) ->
      STRUCT_CASES_TAC(ISPEC (var_by_name "t" (asl,w)) list_CASES))
    THENL
     [REWRITE_TAC[MAP; hol4_TL; ALL];
      ALL_TAC] THEN
    W(fun (asl,w) ->
      let l = last (snd(strip_comb (find_term (hd_is "memory_rel") w)))
        in
      let ty = hd (snd (dest_type (type_of l))) in
      STRUCT_CASES_TAC(ISPEC
        (find_term (fun u -> is_var u && type_of u = ty) w)
        PAIR_SURJECTIVE)) THEN
    REWRITE_TAC[MAP; FST; SND; hol4_TL; ALL] THEN
    DISCH_TAC THEN
    REPEAT GEN_TAC THEN
    DISCH_THEN(REPEAT_TCL CONJUNCTS_THEN ASSUME_TAC) THEN
    FIRST_X_ASSUM(fun el ->
      if hd_is "elements_list" (concl el)
      then MP_TAC(REWRITE_RULE[elements_list_def] el)
      else fail()) THEN
    DISCH_THEN STRIP_ASSUME_TAC THEN
    FIRST_ASSUM(fun mr ->
      if hd_is "memory_rel" (concl mr)
      then ASSUME_TAC(MATCH_MP memory_rel_tl mr)
      else fail()) THEN
    CONJ_TAC THENL
     [W(fun (asl,w) ->
        let be = grab asl (fun th ->
          is_eq (concl th) && is_var (lhs (concl th)) &&
          hd_is "dataSem_Block" (rhs (concl th))) in
        let mr = grab asl (fun th ->
          hd_is "memory_rel" (concl th) &&
          fst(dest_pair(lhand(last(snd(strip_comb (concl th)))))) =
            lhs (concl be)) in
        let gd = grab asl (fun th ->
          hd_is "good_dimindex" (concl th)) in
        MP_TAC(MATCH_MP memory_rel_Block_IMP
                 (CONJ (REWRITE_RULE[be] mr) gd))) THEN
      DISCH_THEN STRIP_ASSUME_TAC THEN
      FIRST_X_ASSUM(fun e ->
        if is_eq (concl e) && is_var (lhs (concl e)) &&
           hd_is "wordLang_Word" (rhs (concl e))
        then SUBST1_TAC e else fail()) THEN
      REWRITE_TAC[isWord_def] THEN MATCH_REDUCE_TAC THEN
      REWRITE_TAC[];
      W(fun (asl,w) ->
        let ih = grab asl (fun t ->
          is_forall (concl t) &&
          can (find_term (hd_is "memory_rel")) (concl t)) in
        let mr = grab asl (fun t ->
          hd_is "memory_rel" (concl t) &&
          not (hd_is "CONS"
                 (rand (last (snd(strip_comb (concl t))))))) in
        let args = butlast (snd(strip_comb (concl mr))) in
        let el = grab asl (fun t ->
          hd_is "elements_list" (concl t) &&
          hd_is "CONS" (rand (concl t))) in
        let gd = grab asl (fun t ->
          hd_is "good_dimindex" (concl t)) in
        ACCEPT_TAC(REWRITE_RULE[MAP; SND; hol4_TL]
          (MP (SPECL args ih) (CONJ mr (CONJ el gd)))))])
### memory_rel_Block_Block_small_eq
  (* the first Block has its lowest bit clear, so it is the empty
     one, whose word is sixteen times its tag plus two.  If the two
     had the same length and the same tag the second would be the
     empty one of the same tag, whose word is the same word, which
     the assumption says it is not *)
  (let subst_vars =
     REPEAT(FIRST_X_ASSUM(fun th ->
       if is_eq(concl th) && is_var(lhand(concl th))
       then SUBST_ALL_TAC th else fail())) in
   STRIP_TAC THEN
   FIRST_ASSUM(fun mr -> FIRST_ASSUM(fun gd ->
     MP_TAC(MATCH_MP memory_rel_Block_IMP
       (CONJ mr gd)))) THEN
   REWRITE_TAC[injectivity "word_loc"; word_index] THEN
   DISCH_THEN(X_CHOOSE_THEN `u:'a word`
     (CONJUNCTS_THEN2 SUBST_ALL_TAC MP_TAC)) THEN
   COND_CASES_TAC THEN ASM_REWRITE_TAC[] THEN
   ONCE_REWRITE_TAC[GSYM DE_MORGAN_THM] THEN
   UNDISCH_TAC `(v1:(dataSem_v)list) = []` THEN
   DISCH_THEN SUBST_ALL_TAC THEN STRIP_TAC THEN STRIP_TAC THEN
   RULE_ASSUM_TAC(REWRITE_RULE[LENGTH]) THEN
   SUBGOAL_THEN `(v2:(dataSem_v)list) = []` SUBST_ALL_TAC THENL
    [REWRITE_TAC[GSYM LENGTH_EQ_NIL] THEN ASM_REWRITE_TAC[];
     ALL_TAC] THEN
   FIRST_ASSUM(fun mr -> FIRST_ASSUM(fun gd ->
     MP_TAC(MATCH_MP memory_rel_Block_IMP
       (CONJ (MATCH_MP memory_rel_tail mr) gd)))) THEN
   REWRITE_TAC[injectivity "word_loc"; word_index] THEN
   DISCH_THEN(X_CHOOSE_THEN `u2:'a word`
     (CONJUNCTS_THEN2 SUBST_ALL_TAC MP_TAC)) THEN
   REWRITE_TAC[] THEN STRIP_TAC THEN subst_vars THEN
   FIRST_ASSUM(fun th -> CONTR_TAC(REWRITE_RULE[] th)))
### data_to_word_memoryProof_fix_clock_IMP
  (REPEAT GEN_TAC THEN CASES_ON_NAME "x" THEN
   REWRITE_TAC[data_to_word_memoryProof_fix_clock_def;
               distinctness "option"] THEN
   TRY(CASES_ON_NAME "a" THEN CASES_ON_NAME "y" THEN
       REWRITE_TAC[data_to_word_memoryProof_fix_clock_def]) THEN
   CONV_TAC(TOP_DEPTH_CONV let_CONV) THEN
   REWRITE_TAC[injectivity "option"; PAIR_EQ] THEN
   REPEAT COND_CASES_TAC THEN REPEAT STRIP_TAC THEN
   ASM_ARITH_TAC)
### fix_clock_word_eq
  (* word_eq gives a clock and a budget that are no larger than the
     ones it was given, so fix_clock leaves its result alone *)
  (let wle = CONJUNCT1 word_eq_LESS_EQ in
   (fun (asl,w as gl) -> CASES_ON_TAC (rand w) gl) THEN
   REWRITE_TAC[data_to_word_memoryProof_fix_clock_def] THEN
   TRY(CASES_ON_NAME "a" THEN CASES_ON_NAME "y" THEN
       REWRITE_TAC[data_to_word_memoryProof_fix_clock_def]) THEN
   CONV_TAC(TOP_DEPTH_CONV let_CONV) THEN
   REWRITE_TAC[injectivity "option"; PAIR_EQ] THEN
   FIRST_ASSUM(fun th -> MP_TAC(MATCH_MP wle th)) THEN
   ARITH_TAC)
### bit_pattern_1100
  (* 12 is the two bits 2 and 3, which good_dimindex puts inside
     the word *)
  (let bw12 = prove
    (`!i. bit i (word 12:(N)word) <=>
          (i = 2 \/ i = 3) /\ i < dimindex(:N)`,
     GEN_TAC THEN REWRITE_TAC[BIT_WORD] THEN
     ASM_CASES_TAC `i < 4` THENL
      [FIRST_X_ASSUM(MP_TAC o REWRITE_RULE
         [ARITH_RULE
            `i < 4 <=> i = 0 \/ i = 1 \/ i = 2 \/ i = 3`]) THEN
       DISCH_THEN(REPEAT_TCL DISJ_CASES_THEN SUBST1_TAC) THEN
       CONV_TAC NUM_REDUCE_CONV THEN CONV_TAC TAUT;
       SUBGOAL_THEN `12 DIV 2 EXP i = 0` SUBST1_TAC THENL
        [MATCH_MP_TAC DIV_LT THEN
         MATCH_MP_TAC LTE_TRANS THEN EXISTS_TAC `2 EXP 4` THEN
         ASM_REWRITE_TAC[LE_EXP] THEN CONV_TAC NUM_REDUCE_CONV THEN
         ASM_ARITH_TAC;
         CONV_TAC NUM_REDUCE_CONV THEN ASM_ARITH_TAC]]) in
   DISCH_TAC THEN
   SUBGOAL_THEN `2 < dimindex (:'a) /\ 3 < dimindex (:'a)`
     STRIP_ASSUME_TAC THENL
    [FIRST_X_ASSUM(MP_TAC o
       REWRITE_RULE[good_dimindex_def]) THEN
     ARITH_TAC; ALL_TAC] THEN
   REWRITE_TAC[WORD_EQ_BITS_ALT; BIT_WORD_AND; BIT_WORD_0;
               bw12] THEN
   ASM_MESON_TAC[])
### word_eq_max_clock
  (* the MAX is the clock itself or the clock plus the difference,
     and word_eq_add_clock gives the second *)
  (let step th1 =
     REPEAT GEN_TAC THEN DISCH_TAC THEN
     ASM_CASES_TAC `ck < n:num` THENL
      [SUBGOAL_THEN `MAX ck n = ck + (n - ck)` SUBST1_TAC THENL
        [ASM_ARITH_TAC; ALL_TAC] THEN
       FIRST_ASSUM(fun th -> MATCH_ACCEPT_TAC(MATCH_MP th1 th));
       SUBGOAL_THEN `MAX ck n = ck /\ n - ck = 0`
         (CONJUNCTS_THEN SUBST1_TAC) THENL
        [ASM_ARITH_TAC; ALL_TAC] THEN
       ASM_REWRITE_TAC[ADD_CLAUSES]] in
   CONJ_TAC THENL [step (CONJUNCT1 word_eq_add_clock);
                   step (CONJUNCT2 word_eq_add_clock)])
### word_eq_min_max_clock
  (* the clock of the goal is above the clock of the assumption,
     because each MAX is above its first argument, so the difference
     is what word_eq_add_clock adds *)
  (let step cj =
     REPEAT GEN_TAC THEN DISCH_TAC THEN
     SUBGOAL_THEN `?n. MIN (MAX a x) (MAX b y) = MIN a b + n`
       (CHOOSE_THEN SUBST1_TAC) THENL
      [EXISTS_TAC `MIN (MAX a x) (MAX b y) - MIN a b` THEN
       ARITH_TAC;
       ALL_TAC] THEN
     EXISTS_TAC `ck1 + n` THEN
     FIRST_ASSUM(fun th -> MATCH_ACCEPT_TAC(MATCH_MP cj th)) in
   CONJ_TAC THENL
    [step (CONJUNCT1 word_eq_add_clock);
     step (CONJUNCT2 word_eq_add_clock)])
### memory_rel_isClos
  (* the Block has values, because the lowest bit of its word is
     set, so memory_rel_Block_IMP gives its header and the address
     and the header word are the ones of the goal;
     encode_header_tag_mask reads the tag off the header as sixteen
     times the tag plus two, and both that and the two closure tags
     are below the dimword, where the two numbers are equal exactly
     when the tags are *)
  (
   let n2w_11 = prove
    (`!a b. a < dimword (:N) /\ b < dimword (:N)
        ==> ((n2w a:(N)word) = n2w b <=> a = b)`,
     REPEAT STRIP_TAC THEN
     REWRITE_TAC[GSYM VAL_EQ; VAL_WORD; GSYM dimword] THEN
     ASM_SIMP_TAC[MOD_LT]) in
   let ldi = LESS_DIV_16_IMP in
   STRIP_TAC THEN
   FIRST_ASSUM(fun mr -> FIRST_ASSUM(fun gd ->
     MP_TAC(MATCH_MP memory_rel_Block_IMP
       (CONJ mr gd)))) THEN
   REWRITE_TAC[injectivity "word_loc"; word_index] THEN
   DISCH_THEN(X_CHOOSE_THEN `u:'a word`
     (CONJUNCTS_THEN2 SUBST_ALL_TAC MP_TAC)) THEN
   COND_CASES_TAC THEN STRIP_TAC THENL
    [FIRST_ASSUM(fun pos -> FIRST_ASSUM(fun neg ->
       CONTR_TAC(MP (NOT_ELIM neg) pos)));
     ALL_TAC] THEN
   (* the address and the header word are the ones of the goal *)
   REPEAT(FIRST_X_ASSUM(fun g2 ->
     FIRST_ASSUM(fun g1 ->
       let th = REWRITE_RULE[g1; injectivity "option";
                             injectivity "word_loc"] g2 in
       if concl th = concl g2 then fail() else SUBST_ALL_TAC th))) THEN
   REWRITE_TAC[word_is_clos_def; dataSem_isClos_def;
               closure_tag_def; partial_app_tag_def] THEN
   FIRST_ASSUM(fun eh -> FIRST_ASSUM(fun gd ->
     MP_TAC(MATCH_MP encode_header_tag_mask
       (CONJ eh gd)))) THEN
   DISCH_THEN(CONJUNCTS_THEN2 ASSUME_TAC SUBST1_TAC) THEN
   ASM_REWRITE_TAC[] THEN
   SUBGOAL_THEN `16 * t1 + 2 < dimword (:'a)` ASSUME_TAC THENL
    [FIRST_ASSUM(fun th ->
       MP_TAC(INST [`t1:num`,`n:num`;
                    `dimword (:'a)`,`k:num`] ldi)) THEN
     ASM_ARITH_TAC;
     ALL_TAC] THEN
   SUBGOAL_THEN `16 * 30 + 2 < dimword (:'a) /\
                 16 * 31 + 2 < dimword (:'a)`
     STRIP_ASSUME_TAC THENL
    [REWRITE_TAC[dimword] THEN
     FIRST_ASSUM(DISJ_CASES_THEN SUBST1_TAC o
       REWRITE_RULE[good_dimindex_def]) THEN
     CONV_TAC NUM_REDUCE_CONV;
     ALL_TAC] THEN
   ASM_SIMP_TAC[n2w_11] THEN ARITH_TAC)
### eq_explode_APPEND
  (LIST_INDUCT_TAC THEN REPEAT GEN_TAC THEN
   ASM_REWRITE_TAC[APPEND; eq_explode_def; LENGTH;
                   WORD_ADD_0_MUL; WORD_ADD_SUC_MUL])
### eq_assum_APPEND
  (LIST_INDUCT_TAC THEN REPEAT GEN_TAC THEN
   ASM_REWRITE_TAC[APPEND; eq_assum_def; LENGTH;
                   WORD_ADD_0_MUL; WORD_ADD_SUC_MUL; CONJ_ASSOC])
### memory_rel_Block_explode
  (* memory_rel_Block_explode_lemma says it of the first n values of
     the Block, so at the length of the Block it says it of all of
     them; what it gives has the Block itself still in front of the
     rest, which memory_rel_rearrange drops *)
  (let take_all = prove
    (`!l:A list. TAKE (LENGTH l) l = l`,
     LIST_INDUCT_TAC THEN
     REWRITE_TAC[TAKE; LENGTH; NOT_SUC; SUC_SUB1] THEN
     ASM_REWRITE_TAC[]) in
   let rearrange =
     ONCE_REWRITE_RULE [TAUT `(p ==> q ==> r) <=> (q ==> p ==> r)`]
       memory_rel_rearrange in
   STRIP_TAC THEN
   MP_TAC(SPEC `LENGTH (v1:(dataSem_v)list)`
     memory_rel_Block_explode_lemma) THEN
   ASM_REWRITE_TAC[take_all] THEN STRIP_TAC THEN CONJ_TAC THENL
    [FIRST_ASSUM(fun th ->
       MATCH_MP_TAC(MATCH_MP rearrange th) THEN
       REWRITE_TAC[MEM_APPEND; MEM] THEN MESON_TAC[]);
     FIRST_ASSUM ACCEPT_TAC])
### memory_rel_Loc
  (* the word_addr of a root is a Loc only for a Data of a Loc,
     which only a CodePtr stands for: the RefPtr that could is a
     RefPtr F, which the hypothesis excludes *)
  (let noforall = MESON[] `(!p. ~(q /\ (x:num) = p)) <=> ~q` in
   MEMORY_REL_TAC THEN CASES_ON_NAME "v1" THEN
   RULE_ASSUM_TAC(REWRITE_RULE[injectivity "dataSem_v";
                               noforall]) THEN
   V_INV_TAC v_inv_def THEN ASM_REWRITE_TAC[])
### memory_rel_ByteArray_words_IMP
  (* the words of a byte array, read out of the memory: the
     reference's v_inv gives the pointer, bc_ref_inv (at the
     reference itself, which reaches itself) gives the Bytes
     element of the heap, get_real_addr_get_addr turns the pointer
     into the address, and the word_el of the element is the header
     cell beside the word_list of the bytes.  The length comes off
     the cond of the word_el, where decode_length of the header is
     the length of the list, and the w2n of that is the length
     itself because the cond also bounds it *)
  (let hd_is n t =
     (try fst(dest_const(fst(strip_comb t))) = n
      with Failure _ -> false) in
   let rec facs t =
     if hd_is "STAR" t then
       let args = snd(strip_comb t) in
       facs (el 0 args) @ facs (el 1 args)
     else [t] in
   let rec remove1 t = function
       [] -> []
     | h :: rest -> if h = t then rest else h :: remove1 t rest in
   let grab asl p =
     tryfind (fun (_,th) ->
       if (try p th with Failure _ -> false) then th else fail()) asl in
   let is_hl th = hd_is "heap_lookup" (lhs (concl th)) in
   let sepfront names =
     W(fun (asl,w) ->
       let pred = rator (lhand w) in
       let fs = facs pred in
       let picked = map (fun n -> find (hd_is n) fs) names in
       let rest = filter (fun t -> not (mem t picked)) fs in
       let st = fst(strip_comb pred) in
       let mk a b = mk_comb(mk_comb(st,a),b) in
       let target = itlist mk picked (end_itlist mk rest) in
       SUBGOAL_THEN (mk_eq(pred,target)) SUBST1_TAC THENL
        [REWRITE_TAC[STAR_AC]; ALL_TAC]) in
   let usesep =
     FIRST_ASSUM(fun th ->
       if (try hd_is "STAR" (rator (concl th))
           with Failure _ -> false)
       then MP_TAC th else fail()) in
   MEMORY_REL_TAC THEN V_INV_TAC v_inv_def THEN
   TRY(FIRST_ASSUM(fun t1 -> FIRST_ASSUM(fun t2 ->
     CONTR_TAC(REWRITE_RULE[injectivity "option";
                            distinctness "bvlSem_ref"]
                 (TRANS (SYM t1) t2))))) THEN
   FIRST_X_ASSUM(fun th ->
     if is_forall (concl th) &&
        hd_is "bc_ref_inv" (rand (snd(strip_forall(concl th))))
     then MP_TAC(SPEC `p:num` th) else fail()) THEN
   ANTS_TAC THENL
    [CONJ_TAC THENL
      [REWRITE_TAC[reachable_refs_def; MEM] THEN
       EXISTS_TAC `RefPtr bl p:dataSem_v` THEN
       EXISTS_TAC `p:num` THEN
       REWRITE_TAC[get_refs_def; MEM;
                   CONJUNCT1(SPEC_ALL RTC_RULES)];
       ASM_REWRITE_TAC[]];
     ALL_TAC] THEN
   REWRITE_TAC[bc_ref_inv_def] THEN
   ASM_SIMP_TAC[FLOOKUP_DEF] THEN
   MATCH_REDUCE_TAC THEN
   CONV_TAC(TOP_DEPTH_CONV let_CONV) THEN
   DISCH_TAC THEN
   FIRST_X_ASSUM(fun th ->
     if hd_is "heap_in_memory_store" (concl th)
     then MP_TAC(REWRITE_RULE[heap_in_memory_store_def] th)
     else fail()) THEN
   STRIP_TAC THEN
   W(fun (asl,w) ->
     let hl = grab asl is_hl in
     let hlen = grab asl (fun th ->
       hd_is "heap_length" (lhand (concl th))) in
     let cu = grab asl (fun th ->
       hd_is "FLOOKUP" (lhs (concl th)) &&
       fst(dest_const(rand(lhs(concl th)))) = "CurrHeap") in
     let gd = grab asl (fun th -> concl th = `good_dimindex (:'a)`) in
     let ga = grab asl (fun th -> hd_is "get_addr" (lhs (concl th))) in
     let gr = grab asl (fun th ->
       hd_is "get_real_addr" (lhs (concl th))) in
     let th = CONJUNCT2(SPEC (rand (lhs (concl ga)))
       (GEN `w:('a)word_loc`
         (MATCH_MP get_real_addr_get_addr
           (CONJ hlen (CONJ hl (CONJ cu gd)))))) in
     let eq = REWRITE_RULE[injectivity "option"]
                (TRANS (SYM gr) (REWRITE_RULE[ga] th)) in
     let r = rhs (concl eq) in
     let args = snd(strip_comb (rand r)) in
     let mul = fst(strip_comb (rand r)) in
     let swap = mk_comb(rator r,
                  mk_comb(mk_comb(mul,el 1 args),el 0 args)) in
     SUBST_ALL_TAC(TRANS eq (WORD_RULE (mk_eq(r,swap))))) THEN
   W(fun (asl,w) ->
     MP_TAC(MATCH_MP heap_lookup_SPLIT
              (grab asl is_hl))) THEN
   DISCH_THEN STRIP_ASSUME_TAC THEN
   VAR_EQ_TAC THEN
   FIRST_X_ASSUM(fun th ->
     if (try hd_is "fmap_apply" (lhs (concl th))
         with Failure _ -> false)
     then SUBST_ALL_TAC th else fail()) THEN
   FIRST_X_ASSUM(fun th ->
     if (try hd_is "STAR" (rator (concl th)) with Failure _ -> false)
     then MP_TAC th else fail()) THEN
   REWRITE_TAC[word_heap_APPEND; word_heap_def;
               bytes_def] THEN
   CONV_TAC(TOP_DEPTH_CONV let_CONV) THEN
   REWRITE_TAC[word_el_def] THEN
   CONV_TAC(TOP_DEPTH_CONV let_CONV) THEN
   REWRITE_TAC[word_payload_def] THEN
   CONV_TAC(TOP_DEPTH_CONV let_CONV) THEN
   REWRITE_TAC[word_list_def; LENGTH_MAP;
               LENGTH_write_bytes; LENGTH_REPLICATE] THEN
   sepfront ["cond"] THEN
   REWRITE_TAC[cond_STAR] THEN
   DISCH_THEN(CONJUNCTS_THEN2 STRIP_ASSUME_TAC MP_TAC) THEN
   sepfront ["set_sep_one"] THEN
   DISCH_THEN(fun sep ->
     let rd = MATCH_MP read_fun2set sep in
     EXISTS_TAC (rand (rhs (concl (CONJUNCT1 rd)))) THEN
     ASSUME_TAC sep THEN STRIP_ASSUME_TAC rd) THEN
   W(fun (asl,w) ->
     let sep = grab asl (fun th -> hd_is "STAR" (rator (concl th))) in
     let fs = facs (rator (concl sep)) in
     let wl = find (hd_is "misc_word_list") fs in
     let rest = remove1 wl fs in
     let st = fst(strip_comb (rator (concl sep))) in
     let mk a b = mk_comb(mk_comb(st,a),b) in
     EXISTS_TAC (end_itlist mk rest)) THEN
   FIRST_ASSUM(fun dl ->
     if (try hd_is "decode_length" (lhs (concl dl))
         with Failure _ -> false)
     then REWRITE_TAC[dl] else fail()) THEN
   REWRITE_TAC[VAL_WORD; GSYM dimword] THEN
   SUBGOAL_THEN
     `(LENGTH (vals:(word8)list) DIV (dimindex (:'a) DIV 8) + 1)
        MOD dimword (:'a) =
      LENGTH vals DIV (dimindex (:'a) DIV 8) + 1`
     SUBST1_TAC THENL
    [MATCH_MP_TAC MOD_LT THEN
     TRANS_TAC LTE_TRANS `2 EXP (dimindex (:'a) - 4)` THEN
     ASM_REWRITE_TAC[dimword] THEN
     SIMP_TAC[LE_EXP; ARITH] THEN ARITH_TAC;
     ALL_TAC] THEN
   ASM_REWRITE_TAC[] THEN
   REPEAT CONJ_TAC THENL
    [usesep THEN REWRITE_TAC[STAR_AC];
     TRANS_TAC LTE_TRANS `2 EXP (dimindex (:'a) - 4)` THEN
     ASM_REWRITE_TAC[dimword] THEN
     SIMP_TAC[LE_EXP; ARITH] THEN ARITH_TAC])
### poly_inj_lemma
  (* the remainder of the division by b gives a and a', and what is
     left of the equation then cancels b *)
  (STRIP_TAC THEN
   SUBGOAL_THEN `(a:num) = a'` ASSUME_TAC THENL
    [SUBGOAL_THEN
       `((a:num) + b * c) MOD b = (a' + b * c') MOD b` MP_TAC THENL
      [ASM_REWRITE_TAC[]; ALL_TAC] THEN
     ONCE_REWRITE_TAC[ADD_SYM] THEN ONCE_REWRITE_TAC[MULT_SYM] THEN
     REWRITE_TAC[MOD_MULT_ADD] THEN ASM_SIMP_TAC[MOD_LT];
     ALL_TAC] THEN
   ASM_REWRITE_TAC[] THEN
   UNDISCH_TAC `(a:num) + b * c = a' + b * c'` THEN
   ASM_REWRITE_TAC[EQ_ADD_LCANCEL; EQ_MULT_LCANCEL] THEN
   ARITH_ASM_TAC)
### mw2n_inj
  (* the value of a multiword is its first word plus the dimword
     times the value of the rest, and a word is below the dimword,
     so poly_inj_lemma takes the sum apart *)
  (let pil = GEN_ALL poly_inj_lemma in
   let wlt = prove
    (`!(x:(N)word). w2n x < dimword (:N)`,
     REWRITE_TAC[dimword; VAL_BOUND]) in
   LIST_INDUCT_TAC THEN GEN_TAC THEN
   STRUCT_CASES_TAC(ISPEC `y:('a word)list` list_CASES_v) THEN
   REWRITE_TAC[LENGTH; mw2n_def; CONS_11; NOT_CONS_NIL;
               ARITH_RULE `(0 = SUC n) <=> F`;
               ARITH_RULE `(SUC n = 0) <=> F`; SUC_INJ] THEN
   DISCH_TAC THEN EQ_TAC THENL
    [DISCH_TAC THEN
     FIRST_ASSUM(fun eq ->
       MP_TAC(MATCH_MP pil (CONJ (ISPEC `h:'a word` wlt)
         (CONJ (ISPEC `v:'a word` wlt) eq)))) THEN
     DISCH_THEN(CONJUNCTS_THEN ASSUME_TAC) THEN
     CONJ_TAC THENL
      [ASM_MESON_TAC[VAL_EQ];
       FIRST_X_ASSUM(fun ih ->
         MP_TAC(SPEC `vs:('a word)list` ih)) THEN
       ASM_REWRITE_TAC[]];
     DISCH_THEN(CONJUNCTS_THEN SUBST1_TAC) THEN REWRITE_TAC[]])
### MIN_ADD
  (ARITH_TAC)
### MIN_SUB
  (ARITH_TAC)
### MAX_ADD
  (ARITH_TAC)
### MAX_SUB
  (ARITH_TAC)
### do_eq_IMP_vb_eq_size
  (REWRITE_TAC[CONJUNCT1 do_eq_IFF_vb_eq_size])
### vb_eq_size_IMP_do_eq
  (REWRITE_TAC[CONJUNCT1 do_eq_IFF_vb_eq_size] THEN MESON_TAC[])
### memory_rel_ptr_vb_eq
  (* a vb_eq_size that gives b is a do_eq that gives Eq_val b *)
  (STRIP_TAC THEN
   FIRST_ASSUM(fun th ->
     MP_TAC(MATCH_MP vb_eq_size_IMP_do_eq th)) THEN
   DISCH_TAC THEN
   MATCH_MP_TAC memory_rel_ptr_eq THEN
   ASM_MESON_TAC[])
### word_eq_thm
  (* do_eq gives the size of the comparison, memory_rel_limit bounds
     it by the clock of MustTerminate (and the dimword is at least
     one, so the bound by the limit less one holds as well), and
     word_eq_thm0 is the comparison itself *)
  (STRIP_TAC THEN
   FIRST_ASSUM(fun de ->
     MP_TAC(MATCH_MP do_eq_IMP_vb_eq_size de)) THEN
   DISCH_THEN(X_CHOOSE_THEN `nn:num` ASSUME_TAC) THEN
   FIRST_ASSUM(fun mr -> FIRST_ASSUM(fun vb -> FIRST_ASSUM(fun gd ->
     ASSUME_TAC(MATCH_MP (SPEC_ALL memory_rel_limit)
       (CONJ mr (CONJ vb gd)))))) THEN
   SUBGOAL_THEN `1 <= dimword (:'a)` ASSUME_TAC THENL
    [REWRITE_TAC[dimword; ARITH_RULE `1 <= n <=> ~(n = 0)`;
                 EXP_EQ_0; ARITH_EQ];
     ALL_TAC] THEN
   SUBGOAL_THEN
     `nn * dimword (:'a) < MustTerminate_limit (:'a) - 1`
     ASSUME_TAC THENL
    [ASM_ARITH_TAC; ALL_TAC] THEN
   FIRST_ASSUM(fun mr -> FIRST_ASSUM(fun vb -> FIRST_ASSUM(fun lt ->
     FIRST_ASSUM(fun gd ->
       let ck = REFL `MIN (vs_depth v1) (vs_depth v2)` in
       let th = MATCH_MP (CONJUNCT1 word_eq_thm0)
                  (CONJ mr (CONJ vb (CONJ ck (CONJ lt gd)))) in
       MP_TAC th)))) THEN
   STRIP_TAC THEN ASM_EXISTS_TAC THEN ASM_REWRITE_TAC[])
### word_mem_eq_thm
  (* the memory holds the words of the list, so the loop reads them
     one at a time: the cell at the address is the head, which
     read_fun2set takes out of the separating product, and the
     induction hypothesis takes the cell into the frame *)
  (let hd_is n t =
     (try fst(dest_const(fst(strip_comb t))) = n
      with Failure _ -> false) in
   let rec facs t =
     if hd_is "STAR" t then
       let args = snd(strip_comb t) in
       facs (el 0 args) @ facs (el 1 args)
     else [t] in
   let sepasm (asl,w) =
     tryfind (fun (_,th) ->
       let c = concl th in
       if hd_is "STAR" (rator c) then rator c else fail()) asl in
   let witness = W(fun gl ->
     let ante = sepasm gl in
     let fs = facs ante in
     let one = find (hd_is "set_sep_one") fs in
     let rest = filter (fun t -> not (hd_is "set_sep_one" t) &&
                                 not (hd_is "misc_word_list" t)) fs in
     let st = fst(strip_comb ante) in
     let mk a b = mk_comb(mk_comb(st,a),b) in
     EXISTS_TAC (mk one (end_itlist mk rest))) in
   let usesep =
     FIRST_ASSUM(fun th ->
       if hd_is "STAR" (rator (concl th)) then MP_TAC th else fail()) in
   LIST_INDUCT_TAC THEN GEN_TAC THEN CASES_BY_NAME "ys" THEN
   REWRITE_TAC[word_mem_eq_def; LENGTH; MAP; NOT_CONS_NIL;
               NOT_SUC; GSYM NOT_SUC; SUC_INJ; CONS_11] THEN
   REPEAT GEN_TAC THEN
   REWRITE_TAC[word_list_def; GSYM STAR_ASSOC] THEN
   STRIP_TAC THEN
   FIRST_ASSUM(fun th -> MP_TAC(MATCH_MP read_fun2set th)) THEN
   DISCH_THEN(CONJUNCTS_THEN2 ASSUME_TAC ASSUME_TAC) THEN
   ASM_REWRITE_TAC[isWord_def; injectivity "word_loc"] THEN
   COND_CASES_TAC THEN ASM_REWRITE_TAC[] THEN
   RULE_ASSUM_TAC(REWRITE_RULE[]) THEN VAR_EQ_TAC THEN
   REWRITE_TAC[] THEN
   FIRST_X_ASSUM MATCH_MP_TAC THEN witness THEN
   ASM_REWRITE_TAC[] THEN usesep THEN REWRITE_TAC[STAR_AC])
### or_seven_eq
  (* seven has no bit above the second, and the shift by more than
     two has none below the third, so the bit where the shifts
     differ is a bit where the ors differ *)
  (let odd_div = prove
    (`!k m i. k < 2 EXP m /\ m <= i
              ==> (ODD (k DIV 2 EXP i) <=> F)`,
     REPEAT STRIP_TAC THEN
     SUBGOAL_THEN `k DIV 2 EXP i = 0` SUBST1_TAC THENL
      [MATCH_MP_TAC DIV_LT THEN
       TRANS_TAC LTE_TRANS `2 EXP m` THEN
       ASM_REWRITE_TAC[LE_EXP] THEN ARITH_TAC;
       REWRITE_TAC[ODD]]) in
   let bit7 = prove
    (`!i. 3 <= i ==> (word_bit i (n2w 7:(N)word) <=> F)`,
     REPEAT STRIP_TAC THEN REWRITE_TAC[BIT_WORD] THEN
     MP_TAC(SPECL [`7`; `3`; `i:num`] odd_div) THEN
     ASM_REWRITE_TAC[] THEN CONV_TAC NUM_REDUCE_CONV THEN
     DISCH_THEN(fun th -> REWRITE_TAC[th])) in
   MATCH_MP_TAC(TAUT `(q ==> b ==> a) ==> (~a /\ q ==> ~b)`) THEN
   DISCH_TAC THEN
   REWRITE_TAC[WORD_EQ_BITS_ALT; BIT_WORD_OR; BIT_WORD_SHL] THEN
   REPEAT STRIP_TAC THEN
   FIRST_X_ASSUM(MP_TAC o SPEC `i:num`) THEN
   ASM_REWRITE_TAC[] THEN
   ASM_CASES_TAC `3 <= i` THENL
    [ASM_SIMP_TAC[bit7];
     ASM_SIMP_TAC[ARITH_RULE `~(3 <= i) /\ 2 < k ==> ~(k <= i)`]])
### make_byte_header_eq
  (* the header of a byte array keeps the length in the field above
     the shift, so two of them agree only when their lengths do: the
     tag is below the shift and the length plus the word size is
     below two to the width of the field, because the byte length is
     below two to the length size *)
  (let hi = prove
    (`!n r (i:num). n < 2 EXP r /\ r <= i
        ==> ~(bit i ((n2w n):'a word))`,
     MATCH_ACCEPT_TAC BIT_WORD_HI) in
   let b7 = prove
    (`!j. j < dimindex (:'a)
          ==> (bit j ((n2w 7):'a word) <=> j < 3)`,
     GEN_TAC THEN DISCH_TAC THEN
     ASM_CASES_TAC `(j:num) < 3` THEN ASM_REWRITE_TAC[] THENL
      [FIRST_ASSUM(REPEAT_TCL DISJ_CASES_THEN SUBST_ALL_TAC o MATCH_MP
         (ARITH_RULE `(j:num) < 3 ==> j = 0 \/ j = 1 \/ j = 2`)) THEN
       ASM_REWRITE_TAC[BIT_WORD] THEN CONV_TAC NUM_REDUCE_CONV THEN
       ASM_ARITH_TAC;
       MP_TAC(ISPECL [`7`; `3`; `j:num`] hi) THEN
       ASM_SIMP_TAC[ARITH_RULE `~((j:num) < 3) ==> 3 <= j`] THEN
       CONV_TAC NUM_REDUCE_CONV]) in
   let n2w_inj = prove
    (`!a b m. a < 2 EXP m /\ b < 2 EXP m /\ m <= dimindex (:'a) /\
              ((n2w a):'a word = n2w b)
        ==> a = b`,
     REPEAT GEN_TAC THEN STRIP_TAC THEN
     FIRST_X_ASSUM(MP_TAC o AP_TERM `val:'a word->num`) THEN
     REWRITE_TAC[VAL_WORD] THEN
     SUBGOAL_THEN
       `a < 2 EXP dimindex (:'a) /\ b < 2 EXP dimindex (:'a)`
       STRIP_ASSUME_TAC THENL
      [CONJ_TAC THEN TRANS_TAC LTE_TRANS `2 EXP m` THEN
       ASM_SIMP_TAC[LE_EXP; ARITH];
       ASM_SIMP_TAC[MOD_LT]]) in
   let gen = prove
    (`!(s:num) a m n.
        3 <= s /\ s < dimindex (:'a) /\
        m + a < 2 EXP (dimindex (:'a) - s) /\
        n + a < 2 EXP (dimindex (:'a) - s) /\
        ((((n2w (m + a)):'a word) << s || n2w 7) =
         (((n2w (n + a)):'a word) << s || n2w 7))
        ==> m = n`,
     REPEAT GEN_TAC THEN STRIP_TAC THEN
     SUBGOAL_THEN `!j. bit j ((n2w 7):'a word) ==> j < s`
       ASSUME_TAC THENL
      [X_GEN_TAC `j:num` THEN
       ASM_CASES_TAC `j < dimindex (:'a)` THENL
        [ASM_SIMP_TAC[b7] THEN ASM_ARITH_TAC;
         ASM_SIMP_TAC[BIT_TRIVIAL;
                      ARITH_RULE `~((a:num) < b) ==> b <= a`]];
       ALL_TAC] THEN
     SUBGOAL_THEN
       `(!j. bit j ((n2w (m + a)):'a word) ==> j + s < dimindex (:'a))
        /\
        (!j. bit j ((n2w (n + a)):'a word) ==> j + s < dimindex (:'a))`
       STRIP_ASSUME_TAC THENL
      [CONJ_TAC THEN X_GEN_TAC `j:num` THEN
       ASM_CASES_TAC `j + s < dimindex (:'a)` THEN
       ASM_REWRITE_TAC[] THENL
        [MP_TAC(ISPECL [`m + a:num`; `dimindex (:'a) - s`; `j:num`] hi);
         MP_TAC(ISPECL [`n + a:num`; `dimindex (:'a) - s`;
                        `j:num`] hi)] THEN
       ASM_SIMP_TAC[ARITH_RULE
         `~(j + s < d) /\ s < d ==> d - s <= j`] THEN
       REWRITE_TAC[];
       ALL_TAC] THEN
     SUBGOAL_THEN `m + a = n + a` MP_TAC THENL
      [MATCH_MP_TAC n2w_inj THEN
       EXISTS_TAC `dimindex (:'a) - s` THEN
       ASM_REWRITE_TAC[] THEN CONJ_TAC THENL
        [ARITH_TAC; ALL_TAC] THEN
       FIRST_X_ASSUM(fun th -> MP_TAC(AP_TERM
         `\w:'a word. word_ushr w s` th)) THEN
       CONV_TAC(TOP_DEPTH_CONV BETA_CONV) THEN
       ASM_SIMP_TAC[USHR_OR_LOW; USHR_SHL_CANCEL];
       ARITH_TAC]) in
   let usedim =
     FIRST_X_ASSUM(fun dd ->
       let c = concl dd in
       if is_eq c &&
          (try fst(dest_const(fst(strip_comb(lhs c)))) = "dimindex"
           with Failure _ -> false)
       then RULE_ASSUM_TAC(REWRITE_RULE[dd; byte_len_def]) THEN
            ASSUME_TAC dd
       else fail()) in
   STRIP_TAC THEN EQ_TAC THENL
    [ALL_TAC; DISCH_THEN SUBST1_TAC THEN REFL_TAC] THEN
   FIRST_ASSUM(DISJ_CASES_THEN ASSUME_TAC o
     REWRITE_RULE[good_dimindex_def]) THEN
   usedim THEN
   REWRITE_TAC[make_byte_header_def] THEN
   CONV_TAC(TOP_DEPTH_CONV let_CONV) THEN
   ASM_REWRITE_TAC[] THEN CONV_TAC NUM_REDUCE_CONV THEN
   DISCH_TAC THEN MATCH_MP_TAC gen THENL
    [MAP_EVERY EXISTS_TAC
       [`30 - data_to_word_config_len_size c`; `4`] THEN
     SUBGOAL_THEN
       `dimindex (:'a) - (30 - data_to_word_config_len_size c) =
        data_to_word_config_len_size c + 2`
       SUBST1_TAC THENL [ASM_ARITH_TAC; ALL_TAC] THEN
     ASM_REWRITE_TAC[EXP_ADD] THEN CONV_TAC NUM_REDUCE_CONV THEN
     REPEAT CONJ_TAC THEN TRY ASM_ARITH_TAC THEN
     MP_TAC(SPEC `m:num` (MATCH_MP DIVISION (ARITH_RULE `~(4 = 0)`)))
     THEN
     MP_TAC(SPEC `n:num` (MATCH_MP DIVISION (ARITH_RULE `~(4 = 0)`)))
     THEN ASM_ARITH_TAC;
     MAP_EVERY EXISTS_TAC
       [`61 - data_to_word_config_len_size c`; `8`] THEN
     SUBGOAL_THEN
       `dimindex (:'a) - (61 - data_to_word_config_len_size c) =
        data_to_word_config_len_size c + 3`
       SUBST1_TAC THENL [ASM_ARITH_TAC; ALL_TAC] THEN
     ASM_REWRITE_TAC[EXP_ADD] THEN CONV_TAC NUM_REDUCE_CONV THEN
     REPEAT CONJ_TAC THEN TRY ASM_ARITH_TAC THEN
     MP_TAC(SPEC `m:num` (MATCH_MP DIVISION (ARITH_RULE `~(8 = 0)`)))
     THEN
     MP_TAC(SPEC `n:num` (MATCH_MP DIVISION (ARITH_RULE `~(8 = 0)`)))
     THEN ASM_ARITH_TAC])
### word_1_and_eq_0
  (REWRITE_TAC[WORD_EQ_BITS_ALT; BIT_WORD_AND; BIT_WORD_0;
               BIT_WORD_1] THEN
   MESON_TAC[DIMINDEX_GE_1; ARITH_RULE `1 <= n ==> 0 < n`])
### memory_rel_ByteArray_IMP_store
  (* a byte of a byte array can be stored: memory_rel_ByteArray_IMP
     says that the load of that byte works, which tells that the
     cell the store writes holds a word and is in the domain, and
     it says that the memory relation survives the write.  Those
     two are about the address of the lemma's own existential, and
     the statement's is the same because get_real_addr is a
     function *)
  (let hd_is n t =
   (try fst(dest_const(fst(strip_comb t))) = n
    with Failure _ -> false) in
   (* what a load of a byte says about the cell it reads: it holds a
      word and its address is in the domain *)
   let loadword = prove
    (`!(m:('a)word->('a)word_loc) dm be' w x.
        mem_load_byte_aux m dm be' w = SOME x
        ==> (?v. m (byte_align w) = wordLang_Word v) /\
            byte_align w IN dm`,
     REPEAT GEN_TAC THEN
     REWRITE_TAC[mem_load_byte_aux_def] THEN
     STRUCT_CASES_TAC(ISPEC `(m:('a)word->('a)word_loc) (byte_align w)`
                        (cases_of `:('a)word_loc`)) THEN
     MATCH_REDUCE_TAC THEN
     REWRITE_TAC[distinctness "option"] THEN
     COND_CASES_TAC THEN
     ASM_REWRITE_TAC[distinctness "option"] THEN
     MESON_TAC[]) in
   DISCH_THEN(REPEAT_TCL CONJUNCTS_THEN ASSUME_TAC) THEN
   FIRST_ASSUM(fun mr -> FIRST_ASSUM(fun lk -> FIRST_ASSUM(fun gd ->
     MP_TAC(MATCH_MP memory_rel_ByteArray_IMP
              (CONJ mr (CONJ lk gd)))))) THEN
   DISCH_THEN(STRIP_ASSUME_TAC o
              REWRITE_RULE[injectivity "word_loc"]) THEN
   VAR_EQ_TAC THEN
   FIRST_ASSUM(fun e1 -> FIRST_ASSUM(fun e2 ->
     let e = REWRITE_RULE[injectivity "option"] (TRANS (SYM e1) e2) in
     if is_var (lhs (concl e)) && lhs (concl e) <> rhs (concl e)
     then SUBST_ALL_TAC e else fail())) THEN
   FIRST_X_ASSUM(fun ld ->
     if is_forall (concl ld) &&
        (try hd_is "mem_load_byte_aux"
               (lhs (rand (snd(strip_forall (concl ld)))))
         with Failure _ -> false)
     then MP_TAC(SPEC `i:num` ld) else fail()) THEN
   ASM_REWRITE_TAC[] THEN
   DISCH_THEN(fun le -> STRIP_ASSUME_TAC(MATCH_MP loadword le)) THEN
   FIRST_X_ASSUM(fun st ->
     if is_forall (concl st) &&
        (try hd_is "memory_rel"
               (snd(dest_let(rand(snd(strip_forall (concl st))))))
         with Failure _ -> false)
     then MP_TAC(SPECL [`i:num`; `b:(word8)`] st) else fail()) THEN
   CONV_TAC(TOP_DEPTH_CONV let_CONV) THEN
   ASM_REWRITE_TAC[theWord_def] THEN
   DISCH_TAC THEN
   ASM_REWRITE_TAC[mem_store_byte_aux_def] THEN
   MATCH_REDUCE_TAC THEN
   ASM_REWRITE_TAC[injectivity "option"; UNWIND_THM1; UNWIND_THM2])
### list_copy_fwd_eq
  (* a complete induction on the number of elements to copy: none,
     one, two or three of them are the chain of the updates that a
     clause of the definition does, and four or more are the same
     four and the induction hypothesis of what they made *)
  (MATCH_MP_TAC num_WF THEN X_GEN_TAC `n:num` THEN DISCH_TAC THEN
   REPEAT GEN_TAC THEN STRIP_TAC THEN
   ONCE_REWRITE_TAC[list_copy_fwd_def] THEN ASM_REWRITE_TAC[] THEN
   (ASM_CASES_TAC `n = 0` THENL
     [POP_ASSUM SUBST_ALL_TAC THEN
      REWRITE_TAC[TAKE_0; APPEND; ADD_CLAUSES; TAKE_DROP];
      ALL_TAC]) THEN
   ASM_REWRITE_TAC[] THEN
   (ASM_CASES_TAC `n = 1` THENL
     [POP_ASSUM SUBST_ALL_TAC THEN COPY_BNDS_TAC THEN
      ASM_SIMP_TAC[copy_base]; ALL_TAC]) THEN
   ASM_REWRITE_TAC[] THEN
   (ASM_CASES_TAC `n = 2` THENL
     [POP_ASSUM SUBST_ALL_TAC THEN COPY_BNDS_TAC THEN
      ASM_SIMP_TAC[o_THM; copy_base; copy_step; ARITH;
                   ADD_CLAUSES];
      ALL_TAC]) THEN
   ASM_REWRITE_TAC[] THEN
   (ASM_CASES_TAC `n = 3` THENL
     [POP_ASSUM SUBST_ALL_TAC THEN COPY_BNDS_TAC THEN
      ASM_SIMP_TAC[o_THM; copy_base; copy_step; ARITH;
                   ADD_CLAUSES];
      ALL_TAC]) THEN
   ASM_REWRITE_TAC[] THEN
   COPY_BNDS_TAC THEN
   ASM_SIMP_TAC[o_THM; copy_base; copy_step; ARITH; ADD_CLAUSES] THEN
   W(fun (asl,w) ->
     let args = snd(strip_comb(lhs w)) in
     FIRST_ASSUM(fun ih ->
       if not (is_forall(concl ih)) then fail() else
       MP_TAC(SPEC (hd args) ih))) THEN
   (ANTS_TAC THENL [ASM_ARITH_TAC; ALL_TAC]) THEN
   DISCH_THEN(fun ih2 ->
     W(fun (asl,w) ->
       let args = snd(strip_comb(lhs w)) in
       MP_TAC(SPECL (tl args) ih2))) THEN
   (ANTS_TAC THENL
     [CONJ_TAC THENL
       [ASM_ARITH_TAC;
        COPY_LEN_TAC THEN
        ASM_REWRITE_TAC[LENGTH_APPEND; LENGTH_DROP] THEN
        ASM_ARITH_TAC];
      ALL_TAC]) THEN
   DISCH_THEN SUBST1_TAC THEN AP_TERM_TAC THEN
   MATCH_MP_TAC copy_glue THEN ASM_ARITH_TAC)
### list_copy_bwd_eq
  (* the same of a copy that goes backward, where the number that
     the definition recurses on is a natural one *)
  (MATCH_MP_TAC num_WF THEN X_GEN_TAC `n:num` THEN DISCH_TAC THEN
   REPEAT GEN_TAC THEN STRIP_TAC THEN
   ONCE_REWRITE_TAC[list_copy_bwd_def] THEN
   REWRITE_TAC[minus_def] THEN ASM_REWRITE_TAC[] THEN
   (ASM_CASES_TAC `n = 0` THENL
     [POP_ASSUM SUBST_ALL_TAC THEN
      REWRITE_TAC[SUB_0; TAKE_0; APPEND; TAKE_DROP];
      ALL_TAC]) THEN
   ASM_REWRITE_TAC[] THEN
   (ASM_CASES_TAC `n = 1` THENL
     [POP_ASSUM SUBST_ALL_TAC THEN ASM_SIMP_TAC[copy_base_bwd];
      ALL_TAC]) THEN
   ASM_REWRITE_TAC[] THEN
   (ASM_CASES_TAC `n = 2` THENL
     [POP_ASSUM SUBST_ALL_TAC THEN COPY_BNDS_B_TAC THEN
      ASM_SIMP_TAC[o_THM; SUB_0; copy_base_bwd; copy_step_bwd;
                   ARITH];
      ALL_TAC]) THEN
   ASM_REWRITE_TAC[] THEN
   (ASM_CASES_TAC `n = 3` THENL
     [POP_ASSUM SUBST_ALL_TAC THEN COPY_BNDS_B_TAC THEN
      ASM_SIMP_TAC[o_THM; SUB_0; copy_base_bwd; copy_step_bwd;
                   ARITH];
      ALL_TAC]) THEN
   ASM_REWRITE_TAC[] THEN
   COPY_BNDS_B_TAC THEN
   ASM_SIMP_TAC[o_THM; SUB_0; copy_base_bwd; copy_step_bwd;
                ARITH] THEN
   W(fun (asl,w) ->
     let args = snd(strip_comb(lhs w)) in
     FIRST_ASSUM(fun ih ->
       if not (is_forall(concl ih)) then fail() else
       MP_TAC(SPEC (hd args) ih))) THEN
   (ANTS_TAC THENL [ASM_ARITH_TAC; ALL_TAC]) THEN
   DISCH_THEN(fun ih2 ->
     W(fun (asl,w) ->
       let args = snd(strip_comb(lhs w)) in
       MP_TAC(SPECL (tl args) ih2))) THEN
   (ANTS_TAC THENL
     [REPEAT CONJ_TAC THEN COPY_LEN_TAC THEN
      ASM_REWRITE_TAC[LENGTH_APPEND; LENGTH_DROP] THEN
      ASM_ARITH_TAC;
      ALL_TAC]) THEN
   DISCH_THEN SUBST1_TAC THEN AP_TERM_TAC THEN
   MATCH_MP_TAC copy_glue_bwd THEN ASM_ARITH_TAC)
### list_copy_thm
  (* the offsets are of naturals, so copy_array is NONE exactly
     when one of the two lists is too short and otherwise is the
     copy that the two equations give, forward when the destination
     is not above the source and backward from the end of it when
     it is *)
  (REPEAT GEN_TAC THEN
   REWRITE_TAC[copy_array_def; I_THM; INT_OF_NUM_ADD; INT_ABS_NUM;
               NUM_OF_INT_OF_NUM; INT_OF_NUM_LT; LT] THEN
   COND_CASES_TAC THEN REWRITE_TAC[distinctness "option"] THEN
   CONV_TAC(TOP_DEPTH_CONV let_CONV) THEN MATCH_REDUCE_TAC THEN
   COND_CASES_TAC THEN REWRITE_TAC[distinctness "option"] THEN
   REWRITE_TAC[injectivity "option"] THEN
   DISCH_THEN(SUBST1_TAC o SYM) THEN
   REWRITE_TAC[list_copy_def] THEN
   (COND_CASES_TAC THENL
     [W(fun (_,w) -> MP_TAC(PART_MATCH (lhs o rand)
          list_copy_fwd_eq (lhand w))) THEN
      (ANTS_TAC THENL [ASM_ARITH_TAC; ALL_TAC]) THEN
      DISCH_THEN SUBST1_TAC THEN
      (SUBGOAL_THEN `n + yp = yp + n` SUBST1_TAC THENL
        [ARITH_TAC; ALL_TAC]) THEN
      REFL_TAC;
      W(fun (_,w) -> MP_TAC(PART_MATCH (lhs o rand)
          list_copy_bwd_eq (lhand w))) THEN
      (ANTS_TAC THENL [ASM_ARITH_TAC; ALL_TAC]) THEN
      DISCH_THEN SUBST1_TAC THEN
      (SUBGOAL_THEN `(((yp + n) - 1) + 1) - n = yp` SUBST1_TAC THENL
        [ASM_ARITH_TAC; ALL_TAC]) THEN
      (SUBGOAL_THEN `(((xp + n) - 1) + 1) - n = xp` SUBST1_TAC THENL
        [ASM_ARITH_TAC; ALL_TAC]) THEN
      (SUBGOAL_THEN `((yp + n) - 1) + 1 = yp + n` SUBST1_TAC THENL
        [ASM_ARITH_TAC; ALL_TAC]) THEN
      REFL_TAC]))
### list_copy_fwd_alias_eq
  (* the same of an alias, where the copy is of the list it is
     written into *)
  (MATCH_MP_TAC num_WF THEN X_GEN_TAC `n:num` THEN DISCH_TAC THEN
   REPEAT GEN_TAC THEN STRIP_TAC THEN
   ONCE_REWRITE_TAC[list_copy_fwd_alias_def] THEN ASM_REWRITE_TAC[] THEN
   (ASM_CASES_TAC `n = 0` THENL
     [POP_ASSUM SUBST_ALL_TAC THEN
      REWRITE_TAC[TAKE_0; APPEND; ADD_CLAUSES; TAKE_DROP];
      ALL_TAC]) THEN
   ASM_REWRITE_TAC[] THEN
   (ASM_CASES_TAC `n = 1` THENL
     [POP_ASSUM SUBST_ALL_TAC THEN COPY_BNDS_TAC THEN
      ASM_SIMP_TAC[copy_base]; ALL_TAC]) THEN
   ASM_REWRITE_TAC[] THEN
   (ASM_CASES_TAC `n = 2` THENL
     [POP_ASSUM SUBST_ALL_TAC THEN COPY_BNDS_TAC THEN
      ASM_SIMP_TAC[o_THM; copy_base; copy_step; ARITH;
                   ADD_CLAUSES];
      ALL_TAC]) THEN
   ASM_REWRITE_TAC[] THEN
   (ASM_CASES_TAC `n = 3` THENL
     [POP_ASSUM SUBST_ALL_TAC THEN COPY_BNDS_TAC THEN
      ASM_SIMP_TAC[o_THM; copy_base; copy_step; ARITH;
                   ADD_CLAUSES];
      ALL_TAC]) THEN
   ASM_REWRITE_TAC[] THEN
   COPY_BNDS_TAC THEN
   ASM_SIMP_TAC[o_THM; copy_base; copy_step; ARITH; ADD_CLAUSES] THEN
   W(fun (asl,w) ->
     let args = snd(strip_comb(lhs w)) in
     FIRST_ASSUM(fun ih ->
       if not (is_forall(concl ih)) then fail() else
       MP_TAC(SPEC (hd args) ih))) THEN
   (ANTS_TAC THENL [ASM_ARITH_TAC; ALL_TAC]) THEN
   DISCH_THEN(fun ih2 ->
     W(fun (asl,w) ->
       let args = snd(strip_comb(lhs w)) in
       MP_TAC(SPECL (tl args) ih2))) THEN
   (ANTS_TAC THENL
     [REPEAT CONJ_TAC THEN COPY_LEN_TAC THEN
      ASM_REWRITE_TAC[LENGTH_APPEND; LENGTH_DROP] THEN
      ASM_ARITH_TAC;
      ALL_TAC]) THEN
   DISCH_THEN SUBST1_TAC THEN AP_TERM_TAC THEN
   MATCH_MP_TAC copy_glue_alias THEN ASM_ARITH_TAC)
### list_copy_bwd_alias_eq
  (* and of an alias that goes backward *)
  (MATCH_MP_TAC num_WF THEN X_GEN_TAC `n:num` THEN DISCH_TAC THEN
   REPEAT GEN_TAC THEN STRIP_TAC THEN
   ONCE_REWRITE_TAC[list_copy_bwd_alias_def] THEN
   REWRITE_TAC[minus_def] THEN ASM_REWRITE_TAC[] THEN
   (ASM_CASES_TAC `n = 0` THENL
     [POP_ASSUM SUBST_ALL_TAC THEN
      REWRITE_TAC[SUB_0; TAKE_0; APPEND; TAKE_DROP];
      ALL_TAC]) THEN
   ASM_REWRITE_TAC[] THEN
   (ASM_CASES_TAC `n = 1` THENL
     [POP_ASSUM SUBST_ALL_TAC THEN ASM_SIMP_TAC[copy_base_bwd];
      ALL_TAC]) THEN
   ASM_REWRITE_TAC[] THEN
   (ASM_CASES_TAC `n = 2` THENL
     [POP_ASSUM SUBST_ALL_TAC THEN COPY_BNDS_B_TAC THEN
      ASM_SIMP_TAC[o_THM; SUB_0; copy_base_bwd; copy_step_bwd;
                   ARITH];
      ALL_TAC]) THEN
   ASM_REWRITE_TAC[] THEN
   (ASM_CASES_TAC `n = 3` THENL
     [POP_ASSUM SUBST_ALL_TAC THEN COPY_BNDS_B_TAC THEN
      ASM_SIMP_TAC[o_THM; SUB_0; copy_base_bwd; copy_step_bwd;
                   ARITH];
      ALL_TAC]) THEN
   ASM_REWRITE_TAC[] THEN
   COPY_BNDS_B_TAC THEN
   ASM_SIMP_TAC[o_THM; SUB_0; copy_base_bwd; copy_step_bwd;
                ARITH] THEN
   W(fun (asl,w) ->
     let args = snd(strip_comb(lhs w)) in
     FIRST_ASSUM(fun ih ->
       if not (is_forall(concl ih)) then fail() else
       MP_TAC(SPEC (hd args) ih))) THEN
   (ANTS_TAC THENL [ASM_ARITH_TAC; ALL_TAC]) THEN
   DISCH_THEN(fun ih2 ->
     W(fun (asl,w) ->
       let args = snd(strip_comb(lhs w)) in
       MP_TAC(SPECL (tl args) ih2))) THEN
   (ANTS_TAC THENL
     [REPEAT CONJ_TAC THEN COPY_LEN_TAC THEN
      ASM_REWRITE_TAC[LENGTH_APPEND; LENGTH_DROP] THEN
      ASM_ARITH_TAC;
      ALL_TAC]) THEN
   DISCH_THEN SUBST1_TAC THEN AP_TERM_TAC THEN
   MATCH_MP_TAC copy_glue_bwd_alias THEN ASM_ARITH_TAC)
### list_copy_alias_thm
  (* the same of an alias.  Of a copy of none the forward
     equation says nothing, because the destination may be above
     the source there, and the definition gives it of itself *)
  (REPEAT GEN_TAC THEN
   REWRITE_TAC[copy_array_def; I_THM; INT_OF_NUM_ADD; INT_ABS_NUM;
               NUM_OF_INT_OF_NUM; INT_OF_NUM_LT; LT] THEN
   COND_CASES_TAC THEN REWRITE_TAC[distinctness "option"] THEN
   CONV_TAC(TOP_DEPTH_CONV let_CONV) THEN MATCH_REDUCE_TAC THEN
   COND_CASES_TAC THEN REWRITE_TAC[distinctness "option"] THEN
   REWRITE_TAC[injectivity "option"] THEN
   DISCH_THEN(SUBST1_TAC o SYM) THEN
   REWRITE_TAC[list_copy_alias_def] THEN
   (COND_CASES_TAC THENL
     [(ASM_CASES_TAC `(yp:num) <= xp` THENL
        [W(fun (_,w) -> MP_TAC(PART_MATCH (lhs o rand)
             list_copy_fwd_alias_eq (lhand w))) THEN
         (ANTS_TAC THENL [ASM_ARITH_TAC; ALL_TAC]) THEN
         DISCH_THEN SUBST1_TAC THEN
         (SUBGOAL_THEN `n + yp = yp + n` SUBST1_TAC THENL
           [ARITH_TAC; ALL_TAC]) THEN
         REFL_TAC;
         (SUBGOAL_THEN `n = 0 /\ xp = 0` STRIP_ASSUME_TAC THENL
           [ASM_ARITH_TAC; ALL_TAC]) THEN
         ASM_REWRITE_TAC[] THEN
         ONCE_REWRITE_TAC[list_copy_fwd_alias_def] THEN
         (COND_CASES_TAC THENL
           [ALL_TAC;
            SUBGOAL_THEN `F` CONTR_TAC THEN ASM_ARITH_TAC]) THEN
         REWRITE_TAC[ARITH_EQ; TAKE_0; APPEND; ADD_CLAUSES;
                     TAKE_DROP]]);
      W(fun (_,w) -> MP_TAC(PART_MATCH (lhs o rand)
          list_copy_bwd_alias_eq (lhand w))) THEN
      (ANTS_TAC THENL [ASM_ARITH_TAC; ALL_TAC]) THEN
      DISCH_THEN SUBST1_TAC THEN
      (SUBGOAL_THEN `(((yp + n) - 1) + 1) - n = yp` SUBST1_TAC THENL
        [ASM_ARITH_TAC; ALL_TAC]) THEN
      (SUBGOAL_THEN `(((xp + n) - 1) + 1) - n = xp` SUBST1_TAC THENL
        [ASM_ARITH_TAC; ALL_TAC]) THEN
      (SUBGOAL_THEN `((yp + n) - 1) + 1 = yp + n` SUBST1_TAC THENL
        [ASM_ARITH_TAC; ALL_TAC]) THEN
      REFL_TAC]))
### copy_array_NONE_IMP
  (* the offsets are of naturals, so copy_array is NONE exactly when
     the source is too short and otherwise takes the n elements from
     the offset on, and list_copy_fwd_eq copies them into a list of
     n zeroes: the whole of it, so nothing of the zeroes is left *)
  (let take0 = prove
    (`!l:A list. TAKE 0 l = []`,
     LIST_INDUCT_TAC THEN REWRITE_TAC[TAKE]) in
   let dropall = prove
    (`!n (x:A). DROP n (REPLICATE n x) = []`,
     INDUCT_TAC THEN
     ASM_REWRITE_TAC[DROP; REPLICATE; NOT_SUC; SUC_SUB1]) in
   REPEAT GEN_TAC THEN
   REWRITE_TAC[copy_array_def; I_THM; INT_OF_NUM_ADD;
               INT_ABS_NUM; NUM_OF_INT_OF_NUM; INT_OF_NUM_LT;
               LT] THEN
   COND_CASES_TAC THEN
   REWRITE_TAC[distinctness "option"] THEN
   CONV_TAC(TOP_DEPTH_CONV let_CONV) THEN
   REWRITE_TAC[injectivity "option"] THEN
   DISCH_THEN(SUBST1_TAC o SYM) THEN
   W(fun (_,w) -> MP_TAC(PART_MATCH (lhs o rand)
       list_copy_fwd_eq (lhand w))) THEN
   REWRITE_TAC[LENGTH_REPLICATE; ADD_CLAUSES; LE_REFL] THEN
   ANTS_TAC THENL
    [ASM_ARITH_TAC;
     REWRITE_TAC[take0; dropall; APPEND; APPEND_NIL] THEN
     DISCH_THEN ACCEPT_TAC])
### word_copy_bwd_0
  (* a copy of no bytes is the memory itself, and good_dimindex puts
     the dimword above the four that the clause asks for *)
  (REWRITE_TAC[good_dimindex_def] THEN STRIP_TAC THEN
   GEN_REWRITE_TAC LAND_CONV [word_copy_bwd_def] THEN
   ASM_REWRITE_TAC[dimword; WORD_ULT; VAL_WORD; VAL_WORD_0] THEN
   CONV_TAC NUM_REDUCE_CONV)
### word_of_byte_0
  (REWRITE_TAC[word_of_byte_def] THEN
   CONV_TAC(TOP_DEPTH_CONV let_CONV) THEN
   COND_CASES_TAC THEN
   REWRITE_TAC[WORD_EQ_BITS_ALT; BIT_WORD_OR; BIT_WORD_SHL;
               BIT_WORD_0])
### last_bytes_0
  (* the bytes of zero written into zero leave zero: a byte set to
     zero in a word of zeroes is an or of words with no bit *)
  (let sb0 = prove
    (`!a be. set_byte a (n2w 0) (n2w 0:(N)word) be = n2w 0`,
     REPEAT GEN_TAC THEN REWRITE_TAC[set_byte_def] THEN
     CONV_TAC(TOP_DEPTH_CONV let_CONV) THEN
     REWRITE_TAC[word_slice_alt; WORD_EQ_BITS_ALT; BIT_WORD_OR;
                 BIT_WORD_SHL; BIT_WORD_0; BIT_WORD_SUBWORD;
                 BIT_WORD_ZX] THEN
     REWRITE_TAC[BIT_WORD_0]) in
   INDUCT_TAC THEN GEN_TAC THEN
   ONCE_REWRITE_TAC[last_bytes_def] THEN
   REWRITE_TAC[ARITH_RULE `~(SUC n = 0)`] THEN
   ASM_REWRITE_TAC[ARITH_RULE `SUC n - 1 = n`; sb0])
### LUPDATE_REPLICATE
  (INDUCT_TAC THEN GEN_TAC THEN REWRITE_TAC[REPLICATE; LUPDATE] THEN
   COND_CASES_TAC THEN ASM_REWRITE_TAC[])
### write_bytearray_isWord
  (* writing bytes leaves a word a word: the write either updates
     the address with a word or leaves the memory alone *)
  (let isw = prove
    (`!w. isWord (wordLang_Word w)`,
     GEN_TAC THEN REWRITE_TAC[isWord_def] THEN
     MATCH_REDUCE_TAC THEN REWRITE_TAC[]) in
   LIST_INDUCT_TAC THEN REPEAT GEN_TAC THEN DISCH_TAC THENL
    [REWRITE_TAC[write_bytearray_def] THEN
     FIRST_ASSUM ACCEPT_TAC;
     REWRITE_TAC[write_bytearray_def;
                 mem_store_byte_aux_def] THEN
     EVERY_CASE_TAC THEN
     POP_ASSUM MP_TAC THEN COND_CASES_TAC THEN
     REWRITE_TAC[distinctness "option"; injectivity "option"] THEN
     DISCH_THEN(SUBST1_TAC o SYM) THEN
     REWRITE_TAC[UPDATE] THEN
     COND_CASES_TAC THEN REWRITE_TAC[isw] THEN
     FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_REWRITE_TAC[]])
### memory_rel_space_max
  (* the space of the statement is the sp of the invariant itself:
     the store's NextFree and TriggerGC are the two ends of it, so
     their difference is the bytes in a word times it, and what is
     left to see is that it fits in a word, which the heap's own
     bound gives because the unused space is part of the heap *)
  (let hd_is n t =
   (try fst(dest_const(fst(strip_comb t))) = n
    with Failure _ -> false) in
 let grab asl p =
   tryfind (fun (_,th) ->
     if (try p th with Failure _ -> false) then th else fail())
     asl in
   DISCH_TAC THEN
   FIRST_ASSUM(fun mr ->
     if hd_is "memory_rel" (concl mr)
     then MP_TAC(REWRITE_RULE[memory_rel_def] mr)
     else fail()) THEN
   DISCH_THEN STRIP_ASSUME_TAC THEN
   FIRST_ASSUM(fun hm ->
     if hd_is "heap_in_memory_store" (concl hm)
     then MP_TAC(REWRITE_RULE[heap_in_memory_store_def] hm)
     else fail()) THEN
   DISCH_THEN STRIP_ASSUME_TAC THEN
   W(fun (asl,w) ->
     let look n = grab asl (fun th ->
       hd_is "FLOOKUP" (lhs (concl th)) &&
       fst(dest_const(rand(lhs(concl th)))) = n) in
     let hm = grab asl (fun th ->
       hd_is "heap_in_memory_store" (concl th)) in
     let args = snd(strip_comb (concl hm)) in
     EXISTS_TAC (rand (rand (rhs (concl (look "NextFree"))))) THEN
     EXISTS_TAC (rand (rand (rhs (concl (look "TriggerGC"))))) THEN
     EXISTS_TAC (el 2 args) THEN
     ASM_REWRITE_TAC[] THEN
     REPEAT CONJ_TAC THENL
      [REWRITE_TAC[GSYM WORD_ADD] THEN CONV_TAC WORD_RULE;
       REWRITE_TAC[memory_rel_def] THEN
       EXISTS_TAC (el 0 args) THEN EXISTS_TAC (el 9 args) THEN
       EXISTS_TAC (el 1 args) THEN EXISTS_TAC (el 2 args) THEN
       EXISTS_TAC (el 3 args) THEN EXISTS_TAC (el 4 args) THEN
       ASM_REWRITE_TAC[LE_REFL];
       DISCH_TAC THEN
       FIRST_ASSUM(fun wm ->
         if hd_is "word_ml_inv" (concl wm)
         then MP_TAC(REWRITE_RULE[word_ml_inv_def;
                                  abs_ml_inv_def;
                                  unused_space_inv_def] wm)
         else fail()) THEN
       DISCH_THEN STRIP_ASSUME_TAC THEN
       W(fun (asl,w) ->
         let hb = grab asl (fun th ->
           hd_is "<" (concl th) && hd_is "*" (lhand (concl th)) &&
           hd_is "+" (lhand (lhand (concl th)))) in
         TRANS_TAC LET_TRANS (lhand (concl hb))) THEN
       ASM_REWRITE_TAC[] THEN
       GEN_REWRITE_TAC LAND_CONV [MULT_SYM] THEN
       REWRITE_TAC[LE_MULT_RCANCEL] THEN DISJ1_TAC THEN
       W(fun (asl,w) ->
         let us = grab asl (fun th ->
           hd_is "<=" (concl th) && hd_is "+" (lhand (concl th))) in
         UNDISCH_TAC (concl us)) THEN
       ARITH_TAC]))
### get_lowerbits_ptrbits
  (* the bits of ptr_bits are below small_shift_length (that is what
     maxout_bits_IMP says of each of the two), so the word_bits of
     it is itself *)
  (let mb = REWRITE_RULE[word_index] maxout_bits_IMP in
   let bits_lt = prove
    (`!i. i < dimindex (:'a) /\ bit i (ptr_bits c x y:'a word)
          ==> i < small_shift_length c`,
     REWRITE_TAC[ptr_bits_def; small_shift_length_def;
                 BIT_WORD_OR] THEN
     REPEAT STRIP_TAC THEN
     FIRST_X_ASSUM(fun th ->
       MP_TAC(MATCH_MP mb
         (CONJ (ASSUME `i < dimindex (:'a)`) th))) THEN
     ARITH_TAC) in
   REWRITE_TAC[get_lowerbits_def] THEN MATCH_REDUCE_TAC THEN
   AP_THM_TAC THEN AP_TERM_TAC THEN
   REWRITE_TAC[WORD_EQ_BITS_ALT; word_bits; BIT_WORD_SUBWORD;
               ADD_CLAUSES] THEN
   GEN_TAC THEN DISCH_TAC THEN EQ_TAC THENL
    [SIMP_TAC[];
     DISCH_TAC THEN ASM_REWRITE_TAC[] THEN
     FIRST_ASSUM(fun th1 -> FIRST_ASSUM(fun th2 ->
       MP_TAC(MATCH_MP bits_lt (CONJ th2 th1)))) THEN
     ASM_ARITH_TAC])
### append_writes_LENGTH
  (LIST_INDUCT_TAC THEN REWRITE_TAC[NOT_CONS_NIL] THEN GEN_TAC THEN
   ONCE_REWRITE_TAC[append_writes_def] THEN
   CASES_ON_NAME "t" THEN MATCH_REDUCE_TAC THEN
   CONV_TAC(TOP_DEPTH_CONV let_CONV) THEN
   ASM_SIMP_TAC[LENGTH; NOT_CONS_NIL] THEN ARITH_TAC)
### ptr_bits_or_1_add_1
  (* the lowest bit of ptr_bits is clear, because both of the
     maxouts it ors are shifted up by at least one, so the or with
     one is the sum with one *)
  (CONV_TAC SYM_CONV THEN MATCH_MP_TAC WORD_ADD_OR THEN
   REWRITE_TAC[WORD_EQ_BITS_ALT; BIT_WORD_AND; BIT_WORD_0;
               BIT_WORD_1] THEN
   X_GEN_TAC `i:num` THEN DISCH_TAC THEN
   ASM_CASES_TAC `i = 0` THEN ASM_REWRITE_TAC[] THEN
   REWRITE_TAC[ptr_bits_def; BIT_WORD_OR;
               maxout_bits_def] THEN
   REPEAT COND_CASES_TAC THEN
   REWRITE_TAC[BIT_WORD_SHL; GSYM word_index] THEN
   ASM_SIMP_TAC[all_ones_bit;
                ARITH_RULE `0 < d <=> 1 <= d:num`; DIMINDEX_GE_1] THEN
   REWRITE_TAC[ARITH_RULE `~(1 + n <= 0)`;
               ARITH_RULE `~(1 <= 0)`] THEN
   CONV_TAC TAUT)
### all_ones_n2w
  (* and the same word is the mask of l ones shifted up by b, whose
     bits HOL Light's BIT_MASK_WORD gives *)
  (REWRITE_TAC[all_ones_def] THEN COND_CASES_TAC THENL
    [SUBGOAL_THEN `l = 0` SUBST1_TAC THENL
      [POP_ASSUM MP_TAC THEN ARITH_TAC; ALL_TAC] THEN
     CONV_TAC NUM_REDUCE_CONV THEN CONV_TAC WORD_RULE;
     ALL_TAC] THEN
   REWRITE_TAC[WORD_EQ_BITS_ALT; word_slice; word_bits;
               BIT_WORD_SHL; BIT_WORD_SUBWORD; BIT_WORD_NOT;
               BIT_WORD_0; BIT_MASK_WORD] THEN
   X_GEN_TAC `i:num` THEN DISCH_TAC THEN
   REWRITE_TAC[ARITH_RULE `MIN a b = if a <= b then a else b`] THEN
   REPEAT COND_CASES_TAC THEN ASM_REWRITE_TAC[] THEN
   POP_ASSUM_LIST(fun ths -> MAP_EVERY MP_TAC ths) THEN ARITH_TAC)
### ptr_bits_lemma
  (* the three parts of a pointer do not share a bit, so the or
     of them is their sum: the bits of a maxout_bits lie between
     its shift and its shift plus its width, so the ones of
     ptr_bits lie below the shift_length and above the zeroth *)
  (let bit_hi = prove
    (`!n r (i:num). n < 2 EXP r /\ r <= i
        ==> ~(bit i ((n2w n):(N)word))`,
     REPEAT GEN_TAC THEN STRIP_TAC THEN REWRITE_TAC[BIT_WORD] THEN
     SUBGOAL_THEN `n DIV 2 EXP i = 0` SUBST1_TAC THENL
      [MATCH_MP_TAC DIV_LT THEN
       TRANS_TAC LTE_TRANS `2 EXP r` THEN
       ASM_SIMP_TAC[LE_EXP; ARITH];
       REWRITE_TAC[ODD]]) in
   let bit_maxout = prove
    (`!n rep k j. bit j ((maxout_bits n rep k):(N)word)
        ==> k <= j /\ j < k + rep`,
     REPEAT GEN_TAC THEN REWRITE_TAC[maxout_bits_def] THEN
     COND_CASES_TAC THEN REWRITE_TAC[all_ones_def] THENL
      [REWRITE_TAC[BIT_WORD_SHL] THEN STRIP_TAC THEN
       CONJ_TAC THEN ASM_REWRITE_TAC[] THEN
       MATCH_MP_TAC(ARITH_RULE
         `k <= j /\ ~(rep <= j - k) ==> j < k + rep`) THEN
       ASM_REWRITE_TAC[] THEN DISCH_TAC THEN
       MP_TAC(ISPECL [`n:num`; `rep:num`; `j - k`] bit_hi) THEN
       ASM_REWRITE_TAC[] THEN ARITH_NO_BIT_TAC;
       COND_CASES_TAC THEN
       REWRITE_TAC[BIT_WORD_0; word_slice; word_bits; BIT_WORD_SHL;
                   BIT_WORD_SUBWORD] THEN
       STRIP_TAC THEN ASM_REWRITE_TAC[] THEN ARITH_NO_BIT_TAC]) in
   let bit_pb = prove
    (`!conf j. bit j ((ptr_bits conf 0 2):(N)word)
        ==> 1 <= j /\ j < small_shift_length conf`,
     REPEAT GEN_TAC THEN
     REWRITE_TAC[ptr_bits_def; small_shift_length_def;
                 BIT_WORD_OR] THEN
     DISCH_THEN(CONJUNCTS_THEN2 (K ALL_TAC) (DISJ_CASES_THEN
       (fun th -> MP_TAC(MATCH_MP bit_maxout th)))) THEN
     ARITH_TAC) in
   let sl = prove
    (`!conf. small_shift_length conf <= shift_length conf /\
             2 <= shift_length conf`,
     REWRITE_TAC[small_shift_length_def;
                 shift_length_def] THEN ARITH_TAC) in
   let pb1 = prove
    (`!conf. ((ptr_bits conf 0 2) && (n2w 1):(N)word) = n2w 0`,
     GEN_TAC THEN REWRITE_TAC[WORD_EQ_BITS_ALT] THEN
     X_GEN_TAC `j:num` THEN DISCH_TAC THEN
     REWRITE_TAC[BIT_WORD_AND; BIT_WORD_0; BIT_WORD_1] THEN
     REWRITE_TAC[TAUT `(p <=> F) <=> ~p`] THEN STRIP_TAC THEN
     FIRST_ASSUM(MP_TAC o MATCH_MP bit_pb) THEN
     ASM_REWRITE_TAC[] THEN ARITH_TAC) in
   let aw = prove
    (`!(w:(N)word) conf.
        (w << shift_length conf) &&
        (ptr_bits conf 0 2 || n2w 1) = n2w 0`,
     REPEAT GEN_TAC THEN REWRITE_TAC[WORD_EQ_BITS_ALT] THEN
     X_GEN_TAC `j:num` THEN DISCH_TAC THEN
     REWRITE_TAC[BIT_WORD_AND; BIT_WORD_OR; BIT_WORD_0; BIT_WORD_1;
                 BIT_WORD_SHL] THEN
     REWRITE_TAC[TAUT `(p <=> F) <=> ~p`] THEN STRIP_TAC THEN
     TRY(FIRST_ASSUM(MP_TAC o MATCH_MP bit_pb)) THEN
     MP_TAC(SPEC_ALL sl) THEN ARITH_NO_BIT_TAC) in
   let gen = prove
    (`!(w:(N)word) conf.
        (w << shift_length conf || ptr_bits conf 0 2 || n2w 1) =
        w << shift_length conf + ptr_bits conf 0 2 + n2w 1`,
     REPEAT GEN_TAC THEN
     REWRITE_TAC[GEN_ALL(MATCH_MP WORD_ADD_OR (SPEC_ALL pb1));
                 GEN_ALL(MATCH_MP WORD_ADD_OR (SPEC_ALL aw))]) in
   MATCH_ACCEPT_TAC gen)
### encode_header_lemma
  (* the four conditions of encode_header hold of the tag 0 and the
     length 2 (the length size is above one, so two is below two to
     that power), so the header is SOME of what make_header gives,
     and encode_header_IMP reads the length back off it *)
  (let gdcases =
     FIRST_ASSUM(DISJ_CASES_THEN SUBST1_TAC o
       REWRITE_RULE[good_dimindex_def]) in
   STRIP_TAC THEN
   SUBGOAL_THEN
     `0 < 2 EXP (dimindex (:'a) -
                 data_to_word_config_len_size c - 2) /\
      0 < dimword (:'a) DIV 16 /\
      2 < 2 EXP (dimindex (:'a) - 4) /\
      2 < 2 EXP (data_to_word_config_len_size c)`
     STRIP_ASSUME_TAC THENL
    [REPEAT CONJ_TAC THENL
      [REWRITE_TAC[LT_NZ; EXP_EQ_0; ARITH_EQ];
       REWRITE_TAC[dimword] THEN gdcases THEN
       CONV_TAC NUM_REDUCE_CONV;
       gdcases THEN CONV_TAC NUM_REDUCE_CONV;
       MATCH_MP_TAC LTE_TRANS THEN EXISTS_TAC `2 EXP 2` THEN
       CONJ_TAC THENL
        [CONV_TAC NUM_REDUCE_CONV;
         REWRITE_TAC[LE_EXP] THEN CONV_TAC NUM_REDUCE_CONV THEN
         ASM_ARITH_TAC]];
     ALL_TAC] THEN
   SUBGOAL_THEN
     `encode_header c 0 2 = SOME (make_header c ((n2w 0):'a word) 2)`
     ASSUME_TAC THENL
    [ASM_REWRITE_TAC[encode_header_def]; ALL_TAC] THEN
   ASM_REWRITE_TAC[] THEN
   FIRST_ASSUM(fun eh -> FIRST_ASSUM(fun ls -> FIRST_ASSUM(fun gd ->
     ACCEPT_TAC(CONJUNCT2(MATCH_MP encode_header_IMP
       (CONJ eh (CONJ ls gd))))))))
### bind_each_eq_tf
  (* the bindings that bind_each adds are above ts, so a timestamp
     below it keeps the value that tf gives it *)
  (INDUCT_TAC THEN REPEAT GEN_TAC THEN STRIP_TAC THEN
   REWRITE_TAC[bind_each_def] THEN
   REWRITE_TAC[FAPPLY_FUPDATE_THM] THEN
   COND_CASES_TAC THENL
    [SUBGOAL_THEN `F` CONTR_TAC THEN ASM_ARITH_TAC;
     FIRST_X_ASSUM MATCH_MP_TAC THEN CONJ_TAC THENL
      [GEN_TAC THEN DISCH_TAC THEN
       FIRST_X_ASSUM(MP_TAC o SPEC `t:num`) THEN
       ASM_REWRITE_TAC[] THEN ARITH_TAC;
       ASM_ARITH_TAC]])
### bind_each_FDOM
  (* bind_each ts ... n binds the n timestamps from ts up *)
  (INDUCT_TAC THEN REPEAT GEN_TAC THEN
   ASM_REWRITE_TAC[bind_each_def; FDOM_FUPDATE] THEN
   REWRITE_TAC[EXTENSION; IN_UNION; IN_INSERT; IN_ELIM_THM] THEN
   GEN_TAC THEN EQ_TAC THEN STRIP_TAC THEN
   ASM_REWRITE_TAC[] THEN
   TRY(DISJ2_TAC THEN ASM_ARITH_TAC) THEN
   TRY(DISJ1_TAC THEN ASM_ARITH_TAC) THEN
   ASM_ARITH_TAC)
### bind_each_eq_tf_FDOM
  (REWRITE_TAC[bind_each_FDOM; IN_UNION; IN_ELIM_THM] THEN
   REPEAT STRIP_TAC THEN ASM_REWRITE_TAC[] THEN ASM_ARITH_TAC)
### bind_each_eq_lt_FAPPLY
  (* a value below the first key that bind_each gives out is one of
     tf: the keys it gives are k, k + i, k + 2 * i, ... *)
  (INDUCT_TAC THEN REPEAT GEN_TAC THEN
   REWRITE_TAC[bind_each_def; FAPPLY_FUPDATE_THM] THEN
   COND_CASES_TAC THEN REWRITE_TAC[LT_REFL] THEN
   DISCH_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_ARITH_TAC)
### bind_each_eq_lt_FDOM
  (INDUCT_TAC THEN REPEAT GEN_TAC THEN
   REWRITE_TAC[bind_each_def; FAPPLY_FUPDATE_THM;
               FDOM_FUPDATE; IN_INSERT] THENL
    [CONV_TAC TAUT;
     COND_CASES_TAC THEN REWRITE_TAC[LT_REFL] THEN
     STRIP_TAC THEN
     FIRST_X_ASSUM(fun ih -> MP_TAC(SPECL
       [`tf:(num,num)fmap`; `ts + 1`; `k + i`; `i:num`; `x:num`]
       ih)) THEN
     ANTS_TAC THENL
      [CONJ_TAC THEN TRY(FIRST_ASSUM ACCEPT_TAC) THEN ASM_ARITH_TAC;
       DISCH_THEN ACCEPT_TAC]])
### bind_each_eq_gt_FAPPLY
  (* and a value above the last one is one of tf as well *)
  (INDUCT_TAC THEN REPEAT GEN_TAC THEN
   REWRITE_TAC[bind_each_def; FAPPLY_FUPDATE_THM;
               MULT_SUC] THEN
   COND_CASES_TAC THEN
   TRY(DISCH_THEN(fun th -> MP_TAC th THEN ARITH_TAC)) THEN
   DISCH_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_ARITH_TAC)
### bind_each_eq_gt_FDOM
  (INDUCT_TAC THEN REPEAT GEN_TAC THEN
   REWRITE_TAC[bind_each_def; FAPPLY_FUPDATE_THM;
               FDOM_FUPDATE; IN_INSERT; MULT_SUC] THENL
    [CONV_TAC TAUT;
     COND_CASES_TAC THENL
      [STRIP_TAC THEN ASM_ARITH_TAC;
       STRIP_TAC THEN
       FIRST_X_ASSUM(fun ih -> MP_TAC(SPECL
         [`tf:(num,num)fmap`; `ts + 1`; `k + i`; `i:num`; `x:num`]
         ih)) THEN
       ANTS_TAC THENL
        [CONJ_TAC THEN TRY(FIRST_ASSUM ACCEPT_TAC) THEN
         ASM_ARITH_TAC;
         DISCH_THEN ACCEPT_TAC]]])
### bind_each_eq_ge_FDOM
  (INDUCT_TAC THEN REPEAT GEN_TAC THEN
   REWRITE_TAC[bind_each_def; FAPPLY_FUPDATE_THM;
               FDOM_FUPDATE; IN_INSERT; MULT_SUC] THENL
    [CONV_TAC TAUT;
     COND_CASES_TAC THENL
      [STRIP_TAC THEN ASM_ARITH_TAC;
       STRIP_TAC THEN
       FIRST_X_ASSUM(fun ih -> MP_TAC(SPECL
         [`tf:(num,num)fmap`; `ts + 1`; `k + i`; `i:num`; `x:num`]
         ih)) THEN
       ANTS_TAC THENL
        [REPEAT CONJ_TAC THEN TRY(FIRST_ASSUM ACCEPT_TAC) THEN
         ASM_ARITH_TAC;
         DISCH_THEN ACCEPT_TAC]]])
### bind_each_fdom_limit
  (* bind_each binds the k timestamps from ts up, so a timestamp
     above ts + k is in neither it nor tf *)
  (INDUCT_TAC THEN REPEAT GEN_TAC THEN
   REWRITE_TAC[bind_each_def; FDOM_FUPDATE; IN_INSERT;
               DE_MORGAN_THM] THEN
   STRIP_TAC THENL
    [DISCH_TAC THEN
     FIRST_X_ASSUM(MP_TAC o SPEC `x:num`) THEN
     ASM_REWRITE_TAC[] THEN ASM_ARITH_TAC;
     CONJ_TAC THENL
      [ASM_ARITH_TAC;
       FIRST_X_ASSUM MATCH_MP_TAC THEN CONJ_TAC THENL
        [GEN_TAC THEN DISCH_TAC THEN
         FIRST_X_ASSUM(MP_TAC o SPEC `t:num`) THEN
         ASM_REWRITE_TAC[] THEN ARITH_TAC;
         ASM_ARITH_TAC]]])
### bind_each_FUPDATE
  (* the binding of the timestamps of a block does not touch a
     timestamp below the ones it binds, so an update of that one
     commutes with it (ml/lib/lemmas.ml has FUPDATE_COMMUTES) *)
  (INDUCT_TAC THEN REPEAT GEN_TAC THEN
   REWRITE_TAC[bind_each_def] THEN
   DISCH_TAC THEN
   FIRST_X_ASSUM(fun ih ->
     MP_TAC(SPECL [`i:num`; `tf:(num,num)fmap`; `ts1:num`;
                   `ts2 + 1`; `k1:num`; `k2 + i`] ih)) THEN
   ASM_REWRITE_TAC[ARITH_RULE `(ts1 < ts2 + 1) <=> ts1 <= ts2`] THEN
   ANTS_TAC THENL
    [ASM_ARITH_TAC;
     DISCH_THEN SUBST1_TAC THEN
     MATCH_MP_TAC FUPDATE_COMMUTES THEN ASM_ARITH_TAC])
### bind_each_MINUS
  (* the binding of each timestamp of a block gives the one at ts
     the clock k and the ones above it k + i, k + 2i, ...: taking k2
     off every one of them is the binding that starts k2 lower *)
  (INDUCT_TAC THEN REPEAT GEN_TAC THEN
    REWRITE_TAC[bind_each_def; IN_ELIM_THM] THEN
    STRIP_TAC THENL
     [ASM_ARITH_TAC; ALL_TAC] THEN
    ASM_CASES_TAC `(x:num) = ts` THENL
     [ASM_REWRITE_TAC[FAPPLY_FUPDATE_THM];
      ALL_TAC] THEN
    ASM_REWRITE_TAC[FAPPLY_FUPDATE_THM] THEN
    SUBGOAL_THEN `(k1 - k2) + i = (k1 + i) - k2` SUBST1_TAC THENL
     [ASM_ARITH_TAC; ALL_TAC] THEN
    FIRST_X_ASSUM MATCH_MP_TAC THEN
    ASM_REWRITE_TAC[IN_ELIM_THM] THEN
    REPEAT CONJ_TAC THEN TRY ASM_ARITH_TAC THEN
    GEN_TAC THEN DISCH_TAC THEN
    FIRST_ASSUM(fun fd -> FIRST_ASSUM(fun h ->
      MP_TAC(MATCH_MP fd h))) THEN
    ARITH_TAC)
### data_to_word_memoryProof_isSomeDataElement_heap_lookup
  (* the lookup falls in the first heap, or past the Unused in the
     second: the Unused itself holds no data element *)
  (let hlen_cl = prove
    (`heap_length [] = 0 /\
      (!x xs. heap_length (CONS x xs) =
              el_length x + heap_length xs)`,
     REWRITE_TAC[heap_length_def; MAP; SUM_DEF; ITLIST]) in
   let isde_rws = [isSomeDataElement_def;
                   distinctness "option"; injectivity "option";
                   distinctness "heap_element"] in
   let un_none = prove
    (`!sp m. ~(isSomeDataElement
                 (heap_lookup m [Unused sp:((A,B)heap_element)]))`,
     REPEAT GEN_TAC THEN
     REWRITE_TAC(heap_lookup_def :: el_length_def ::
                 isde_rws) THEN
     REPEAT COND_CASES_TAC THEN
     REWRITE_TAC(heap_lookup_def :: isde_rws)) in
   REPEAT GEN_TAC THEN
   REWRITE_TAC[GSYM APPEND_ASSOC;
               data_to_word_memoryProof_heap_lookup_APPEND] THEN
   COND_CASES_TAC THEN REWRITE_TAC[] THEN
   REWRITE_TAC[hlen_cl; ADD_CLAUSES] THEN
   COND_CASES_TAC THEN REWRITE_TAC[un_none] THEN
   DISCH_TAC THEN
   RULE_ASSUM_TAC(REWRITE_RULE[el_length_def]) THEN
   REWRITE_TAC[el_length_def] THEN ARITH_ASM_TAC)
### isSomeDataElement_heap_lookup_eq
  (* the heap that the list builds has the same elements whatever
     the address it starts at: the first block is a data element
     either way, and the lookup past it is the induction *)
  (let isde = prove
    (`!ys l d. isSomeDataElement (SOME (DataElement ys l d))`,
     REWRITE_TAC[isSomeDataElement_def] THEN MESON_TAC[]) in
   let isdeN = prove
    (`~isSomeDataElement NONE`,
     REWRITE_TAC[isSomeDataElement_def;
                 distinctness "option"]) in
   LIST_INDUCT_TAC THENL
    [REWRITE_TAC[list_to_BlockReps_def]; ALL_TAC] THEN
   REPEAT GEN_TAC THEN POP_ASSUM MP_TAC THEN
   REWRITE_TAC[list_to_BlockReps_def] THEN
   (fun (asl,w as gl) ->
      let scr = hd (filter is_var (match_scruts w)) in
      STRUCT_CASES_TAC(ISPEC scr list_CASES_v) gl) THEN
   MATCH_REDUCE_TAC THEN
   REWRITE_TAC[] THEN
   DISCH_TAC THEN
   ONCE_REWRITE_TAC[heap_lookup_def] THEN
   REWRITE_TAC[BlockRep_def; el_length_def; LENGTH] THEN
   CONV_TAC NUM_REDUCE_CONV THEN
   COND_CASES_TAC THEN ASM_REWRITE_TAC[isde] THEN
   COND_CASES_TAC THEN ASM_REWRITE_TAC[isdeN] THEN
   DISCH_TAC THEN
   FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_EXISTS_TAC THEN
   ASM_REWRITE_TAC[])
### bind_each_eq_INJ
  (* the binding gives each timestamp its own clock: the one at ts
     gets k and the ones above it more than k, which
     bind_each_eq_lt_FDOM says, so two of them with one clock are
     one timestamp *)
  (let eqlt = bind_each_eq_lt_FDOM in
    let bfd = bind_each_FDOM in
    let use_eqlt v =
      MP_TAC(SPECL [`n:num`; `tf:(num,num)fmap`; `ts + 1`; `k + i`;
                    `i:num`; v] eqlt) THEN
      ANTS_TAC THENL
       [CONJ_TAC THENL
         [REWRITE_TAC[bfd; IN_UNION; IN_ELIM_THM] THEN ASM_ARITH_TAC;
          FIRST_ASSUM(fun e -> REWRITE_TAC[GSYM e]) THEN ASM_ARITH_TAC];
        ASM_REWRITE_TAC[]] in
    INDUCT_TAC THEN REPEAT GEN_TAC THEN
    REWRITE_TAC[bind_each_def; IN_ELIM_THM] THENL
     [STRIP_TAC THEN ASM_ARITH_TAC; ALL_TAC] THEN
    REWRITE_TAC[FAPPLY_FUPDATE_THM] THEN
    ASM_CASES_TAC `(x:num) = ts` THEN ASM_CASES_TAC `(y:num) = ts` THEN
    ASM_REWRITE_TAC[] THEN STRIP_TAC THENL
     [use_eqlt `y:num`;
      use_eqlt `x:num`;
      FIRST_X_ASSUM MATCH_MP_TAC THEN
      MAP_EVERY EXISTS_TAC
        [`tf:(num,num)fmap`; `ts + 1`; `k + i`; `i:num`] THEN
      ASM_REWRITE_TAC[IN_ELIM_THM] THEN
      REPEAT CONJ_TAC THEN ASM_ARITH_TAC])
### all_ts_list_to_v_SUBSET
  (* the list that list_to_v builds is a Block of each timestamp
     from ts up, one for each element, and the timestamps of a
     Block on the stack are its own and the ones of its payload *)
  (SUBGOAL_THEN
     `!xs ts refs (tv:dataSem_v).
        {x | ts <= x /\ x < ts + LENGTH xs} SUBSET
        all_ts refs [list_to_v ts tv xs]`
     (fun th -> MATCH_ACCEPT_TAC th) THEN
   LIST_INDUCT_TAC THEN REPEAT GEN_TAC THENL
    [REWRITE_TAC[SUBSET; IN_ELIM_THM; LENGTH; ADD_CLAUSES] THEN
     GEN_TAC THEN MATCH_MP_TAC(TAUT `~p ==> (p ==> q)`) THEN
     ARITH_TAC;
     REWRITE_TAC[dataSem_list_to_v_def] THEN
     ONCE_REWRITE_TAC[all_ts_cons] THEN
     REWRITE_TAC[APPEND; APPEND_NIL] THEN
     ONCE_REWRITE_TAC[all_ts_head] THEN
     FIRST_X_ASSUM(MP_TAC o SPECL
       [`(ts:num) + 1`; `refs:(dataSem_v bvlSem_ref) spt`;
        `tv:dataSem_v`]) THEN
     REWRITE_TAC[SUBSET; IN_ELIM_THM; IN_INSERT; IN_UNION;
                 LENGTH] THEN
     DISCH_TAC THEN X_GEN_TAC `u:num` THEN STRIP_TAC THEN
     ASM_CASES_TAC `(u:num) = ts` THENL
      [DISJ1_TAC THEN FIRST_ASSUM ACCEPT_TAC;
       DISJ2_TAC THEN DISJ2_TAC THEN
       FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_ARITH_TAC]])
### all_ts_SUBSET_list_to_v
  (* and so are the timestamps of the elements and of the tail of
     the list, which are the same values in another order *)
  (let all_ts_perm = prove
    (`!refs (xs:dataSem_v list) ys.
        (!x. MEM x xs <=> MEM x ys)
        ==> all_ts refs xs = all_ts refs ys`,
     REPEAT GEN_TAC THEN DISCH_TAC THEN
     REWRITE_TAC[all_ts_def] THEN
     CONV_TAC(TOP_DEPTH_CONV let_CONV) THEN
     ASM_REWRITE_TAC[]) in
   SUBGOAL_THEN
     `!xs refs (tv:dataSem_v) stk ts.
        all_ts refs (CONS tv (xs ++ stk)) SUBSET
        all_ts refs (CONS (list_to_v ts tv xs) stk)`
     (fun th -> REPEAT GEN_TAC THEN MATCH_ACCEPT_TAC th) THEN
   LIST_INDUCT_TAC THEN REPEAT GEN_TAC THENL
    [REWRITE_TAC[dataSem_list_to_v_def; APPEND; SUBSET_REFL];
     REWRITE_TAC[dataSem_list_to_v_def] THEN
     ONCE_REWRITE_TAC[all_ts_cons] THEN
     REWRITE_TAC[APPEND] THEN
     SUBGOAL_THEN
       `all_ts refs (CONS (tv:dataSem_v) (CONS h (t ++ stk))) =
        all_ts refs (CONS tv (t ++ CONS h stk))`
       SUBST1_TAC THENL
      [MATCH_MP_TAC all_ts_perm THEN
       REWRITE_TAC[MEM; MEM_APPEND] THEN CONV_TAC TAUT;
       ALL_TAC] THEN
     SUBGOAL_THEN
       `all_ts refs (CONS (h:dataSem_v)
          (CONS (list_to_v ((ts:num) + 1) tv t) stk)) =
        all_ts refs (CONS (list_to_v (ts + 1) tv t) (CONS h stk))`
       SUBST1_TAC THENL
      [MATCH_MP_TAC all_ts_perm THEN REWRITE_TAC[MEM] THEN
       CONV_TAC TAUT;
       ALL_TAC] THEN
     FIRST_X_ASSUM(MP_TAC o SPECL
       [`refs:(dataSem_v bvlSem_ref) spt`; `tv:dataSem_v`;
        `CONS (h:dataSem_v) stk`; `(ts:num) + 1`]) THEN
     SET_TAC[]])
### new_all_ts_SUBSET_list_to_v
  (* and those timestamps are timestamps of the stack that the
     list is on, whatever else that stack holds *)
  (let all_ts_perm = prove
    (`!refs (xs:dataSem_v list) ys.
        (!x. MEM x xs <=> MEM x ys)
        ==> all_ts refs xs = all_ts refs ys`,
     REPEAT GEN_TAC THEN DISCH_TAC THEN
     REWRITE_TAC[all_ts_def] THEN
     CONV_TAC(TOP_DEPTH_CONV let_CONV) THEN
     ASM_REWRITE_TAC[]) in
   SUBGOAL_THEN
     `!xs refs (tv:dataSem_v) stk ts.
        {x | ts <= x /\ x < ts + LENGTH xs} SUBSET
        all_ts refs (CONS (list_to_v ts tv xs) stk)`
     (fun th -> REPEAT GEN_TAC THEN MATCH_ACCEPT_TAC th) THEN
   LIST_INDUCT_TAC THEN REPEAT GEN_TAC THENL
    [REWRITE_TAC[SUBSET; IN_ELIM_THM; LENGTH; ADD_CLAUSES] THEN
     GEN_TAC THEN MATCH_MP_TAC(TAUT `~p ==> (p ==> q)`) THEN
     ARITH_TAC;
     REWRITE_TAC[dataSem_list_to_v_def] THEN
     ONCE_REWRITE_TAC[all_ts_cons] THEN
     REWRITE_TAC[APPEND] THEN
     SUBGOAL_THEN
       `all_ts refs (CONS (h:dataSem_v)
          (CONS (list_to_v ((ts:num) + 1) tv t) stk)) =
        all_ts refs (CONS (list_to_v (ts + 1) tv t) (CONS h stk))`
       SUBST1_TAC THENL
      [MATCH_MP_TAC all_ts_perm THEN REWRITE_TAC[MEM] THEN
       CONV_TAC TAUT;
       ALL_TAC] THEN
     FIRST_X_ASSUM(MP_TAC o SPECL
       [`refs:(dataSem_v bvlSem_ref) spt`; `tv:dataSem_v`;
        `CONS (h:dataSem_v) stk`; `(ts:num) + 1`]) THEN
     REWRITE_TAC[SUBSET; IN_ELIM_THM; IN_INSERT; LENGTH] THEN
     DISCH_TAC THEN X_GEN_TAC `u:num` THEN STRIP_TAC THEN
     ASM_CASES_TAC `(u:num) = ts` THENL
      [DISJ1_TAC THEN FIRST_ASSUM ACCEPT_TAC;
       DISJ2_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
       ASM_ARITH_TAC]])
### FDOM_bind_each_lemma
  (* induction on the number of bindings: each one is a timestamp
     one higher than the last, and the domain grows by that one *)
  (let aux = prove
    (`!k tf ts h i. FDOM tf SUBSET {m | m < ts}
        ==> FDOM (bind_each tf ts h i k) SUBSET {m | m < ts + k}`,
     INDUCT_TAC THEN REPEAT GEN_TAC THEN DISCH_TAC THENL
      [ASM_REWRITE_TAC[bind_each_def; ADD_CLAUSES];
       REWRITE_TAC[bind_each_def; FDOM_FUPDATE;
                   INSERT_SUBSET; IN_ELIM_THM] THEN
       CONJ_TAC THENL
        [ARITH_TAC;
         FIRST_ASSUM(fun ih ->
           MP_TAC(SPECL [`tf:(num,num)fmap`; `ts + 1`; `h + i:num`;
                         `i:num`] ih)) THEN
         REWRITE_TAC[ARITH_RULE `(ts + 1) + k = ts + SUC k`] THEN
         DISCH_THEN MATCH_MP_TAC THEN
         FIRST_ASSUM(fun sub -> MP_TAC sub) THEN
         REWRITE_TAC[SUBSET; IN_ELIM_THM] THEN
         MESON_TAC[ARITH_RULE `!a b:num. a < b ==> a < b + 1`]]]) in
   REPEAT GEN_TAC THEN MATCH_ACCEPT_TAC(SPEC_ALL aux))
### v_all_vs_list_to_v1
  (* the list that list_to_v builds is a chain of conses, and the
     Blocks of the chain itself have the timestamps from ts on,
     which the Block of the goal is below; so a Block among the
     values of the chain is one of the values of the list or of the
     stack, which the induction follows cons by cons *)
  (
   let (vnil,vsing,vats,vcons) = v_all_vs_clauses () in
   let split = MEM_v_all_vs_split
   and ext_hd = MEM_v_all_vs_extend_hd
   and ext_tl = MEM_v_all_vs_extend_tl in
   let mem_app = prove
    (`!(x:dataSem_v) l1 l2.
        MEM x (v_all_vs (l1 ++ l2)) <=>
        MEM x (v_all_vs l1) \/ MEM x (v_all_vs l2)`,
     REWRITE_TAC[v_all_vs_append; MEM_APPEND]) in
   LIST_INDUCT_TAC THEN REPEAT GEN_TAC THEN
   REWRITE_TAC[dataSem_list_to_v_def; APPEND] THENL
    [DISCH_THEN(fun th -> ACCEPT_TAC(CONJUNCT2 th));
     STRIP_TAC THEN
     SUBGOAL_THEN `t1 < ts + 1` ASSUME_TAC THENL
      [ASM_ARITH_TAC; ALL_TAC] THEN
     FIRST_ASSUM(fun m ->
       let th = MATCH_MP split m in
       MP_TAC(REWRITE_RULE[vsing; MEM] th)) THEN
     STRIP_TAC THEN
     ASM_MESON_TAC[split; ext_hd; ext_tl; mem_app;
                   injectivity "dataSem_v"; LT_REFL]])
### blocks_unique_GT_ts
  (* blocks_unique gives the timestamp of a Block of the set as one
     below ts, and this one is not *)
  (REWRITE_TAC[blocks_unique_def] THEN REPEAT STRIP_TAC THEN
   ASM_MESON_TAC[ARITH_RULE `!a b:num. a >= b /\ a < b ==> F`])
### Block_NOT_IN_all_vs
  (* the chain of no elements is the value it ends with, which is
     on the stack, and of one more it is a Block of a later
     timestamp, whose values are the element's -- also on the stack
     -- and the rest of the chain's, which the induction
     hypothesis is about at one timestamp more *)
  ((let (_,vsing,_,_) = v_all_vs_clauses () in
    LIST_INDUCT_TAC THEN REPEAT GEN_TAC THEN DISCH_TAC THEN
    RULE_ASSUM_TAC(REWRITE_RULE[APPEND]) THEN
    REPEAT GEN_TAC THEN DISCH_TAC THEN
    REWRITE_TAC[dataSem_list_to_v_def] THENL
     [DISCH_TAC THEN ASM_MESON_TAC[av_in_cons];
      REWRITE_TAC[vsing; MEM; DE_MORGAN_THM] THEN CONJ_TAC THENL
       [DISCH_THEN(fun eq ->
          MP_TAC(REWRITE_RULE[injectivity "dataSem_v"] eq)) THEN
        ASM_ARITH_TAC;
        DISCH_TAC THEN
        FIRST_ASSUM(fun m ->
          if not (hd_is "MEM" (concl m)) then fail() else
          DISJ_CASES_THEN ASSUME_TAC
            (MATCH_MP MEM_v_all_vs_split m)) THEN
        FIRST_ASSUM(fun nin ->
          if not (is_neg (concl nin)) then fail() else
          FIRST_ASSUM(fun ih ->
            if not (is_forall (concl ih)) then fail() else
            let sh = MATCH_MP av_shrink2 nin in
            let th = MATCH_MP (MATCH_MP ih sh)
                       (ARITH_RULE `m + 1 > 0`) in
            MP_TAC(REWRITE_RULE
              [ARITH_RULE `t' + (m + 1) = (t' + m) + 1`] th))) THEN
        ASM_MESON_TAC[av_in_cons; av_in_tl]]]))
### v_all_vs_list_to_v2
  (* each of the two Blocks is the chain's first Block or a value
     of the rest of the chain, because the hypothesis says neither
     is a value of the list and the stack.  Two first Blocks are
     the same Block; a first Block and one of the rest cannot have
     the same timestamp (av_no_mix); and two of the rest are what
     the induction hypothesis is about *)
  ((let inj = injectivity "dataSem_v" in
    let blk th = hd(snd(strip_comb(concl th))) in
    let not_in x t =
      is_neg t && is_binary "IN" (dest_neg t) &&
      lhand(dest_neg t) = x in
    LIST_INDUCT_TAC THENL
     [REPEAT GEN_TAC THEN DISCH_THEN STRIP_ASSUME_TAC THEN
      RULE_ASSUM_TAC(REWRITE_RULE[dataSem_list_to_v_def; APPEND]) THEN
      ASM_MESON_TAC[av_in_stack];
      REPEAT GEN_TAC THEN DISCH_THEN STRIP_ASSUME_TAC THEN
      W(fun g ->
        let (asl,w) = g in
        let mems = map snd (filter (fun (_,th) ->
          hd_is "MEM" (concl th)) asl) in
        let d th =
          MATCH_MP av_decomp2
            (CONJ th (av_find (not_in (blk th)) g)) in
        let d1 = d (hd mems) and d2 = d (hd(tl mems)) in
        DISJ_CASES_THEN2
          (fun e1 ->
            DISJ_CASES_THEN2
              (fun e2 ->
                STRIP_ASSUME_TAC(REWRITE_RULE[inj] e1) THEN
                STRIP_ASSUME_TAC(REWRITE_RULE[inj] e2) THEN
                ASM_REWRITE_TAC[LENGTH] THEN ASM_ARITH_TAC)
              (fun c2 ->
                ASSUME_TAC c2 THEN
                SUBST_ALL_TAC(CONJUNCT1(REWRITE_RULE[inj] e1)) THEN
                ASM_MESON_TAC[av_no_mix])
              d2)
          (fun c1 ->
            DISJ_CASES_THEN2
              (fun e2 ->
                ASSUME_TAC c1 THEN
                SUBST_ALL_TAC(CONJUNCT1(REWRITE_RULE[inj] e2)) THEN
                ASM_MESON_TAC[av_no_mix])
              (fun c2 ->
                W(fun g2 ->
                  let nin th =
                    MATCH_MP av_shrink (REWRITE_RULE[APPEND]
                      (av_find (not_in (blk th)) g2)) in
                  FIRST_ASSUM(fun ih ->
                    if not (is_forall (concl ih)) then fail() else
                    MP_TAC(MATCH_MP ih
                      (CONJ c1 (CONJ (av_nn g2 (last(snd(strip_comb
                         (blk c1))))) (CONJ c2 (CONJ (av_nn g2
                         (last(snd(strip_comb (blk c2)))))
                           (CONJ (nin c1) (nin c2))))))))) THEN
                REWRITE_TAC[LENGTH] THEN STRIP_TAC THEN
                ASM_REWRITE_TAC[] THEN ASM_ARITH_TAC)
              d2)
          d1)]))
### blocks_unique_cons_multi
  (* a Block of the chain and the stack is below the chain's
     timestamps, and then it is a value of the list and the stack,
     of which the hypothesis speaks; or it is one of the chain's
     own, and then it is a value of the chain (av_in_mem) that the
     theorem before this one is about *)
  (DISCH_TAC THEN REWRITE_TAC[blocks_unique_def] THEN
   REPEAT GEN_TAC THEN STRIP_TAC THEN
   W(fun (asl,w) ->
     let third = rand(rand w) in
     ASM_CASES_TAC
       (mk_binary "<" (lhand third, lhand(rand third)))) THENL
    [W(fun g ->
       let lt = av_find (fun t -> is_binary "<" t) g in
       let ins = av_blocks g in
       let bu = REWRITE_RULE[blocks_unique_def]
                  (av_find (hd_is "blocks_unique") g) in
       let i1 = MATCH_MP av_in_shift (CONJ lt (el 0 ins))
       and i2 = MATCH_MP av_in_shift (CONJ lt (el 1 ins)) in
       STRIP_ASSUME_TAC(MATCH_MP bu
         (CONJ i1 (CONJ (av_nn g (av_xs_of (el 0 ins)))
           (CONJ i2 (av_nn g (av_xs_of (el 1 ins)))))))) THEN
     ASM_REWRITE_TAC[] THEN ASM_ARITH_TAC;
     W(fun g ->
       let notlt = av_find (fun t ->
         is_neg t && is_binary "<" (dest_neg t)) g in
       let ins = av_blocks g in
       let bu = av_find (hd_is "blocks_unique") g in
       let t1 = lhand(dest_neg(concl notlt))
       and ts = rand(dest_neg(concl notlt)) in
       let le = MP (ARITH_RULE (mk_imp(concl notlt,
                  mk_binary "<=" (ts,t1)))) notlt in
       let ge = MP (ARITH_RULE (mk_imp(concl notlt,
                  mk_binary ">=" (t1,ts)))) notlt in
       let mem inn = MATCH_MP av_in_mem
         (CONJ bu (CONJ le (CONJ (av_nn g (av_xs_of inn)) inn))) in
       let notin inn = SPEC (av_a_of inn)
         (MATCH_MP (GEN_ALL blocks_unique_GT_ts)
            (CONJ bu (CONJ ge (av_nn g (av_xs_of inn))))) in
       STRIP_ASSUME_TAC(MATCH_MP (GEN_ALL v_all_vs_list_to_v2)
         (CONJ (mem (el 0 ins)) (CONJ (av_nn g (av_xs_of (el 0 ins)))
           (CONJ (mem (el 1 ins)) (CONJ (av_nn g
             (av_xs_of (el 1 ins)))
             (CONJ (notin (el 0 ins)) (notin (el 1 ins))))))))) THEN
     ASM_REWRITE_TAC[] THEN ASM_ARITH_TAC])
### v_inv_v_to_list_lemma
  (* a list of at least one element is a Block of the cons tag with
     two elements, and the invariant of a Block that is not empty
     is a pointer at a BlockRep of as many elements *)
  (STRIP_TAC THEN
   CASES_ON_NAME "vs" THENL
    [RULE_ASSUM_TAC(REWRITE_RULE[]) THEN FIRST_ASSUM CONTR_TAC;
     ALL_TAC] THEN
   FIRST_ASSUM(fun th ->
     MP_TAC(SPEC_ALL(MATCH_MP v_to_list_SOME_CONS_IMP th))) THEN
   DISCH_THEN(X_CHOOSE_THEN `ts2:num`
     (X_CHOOSE_THEN `ys2:dataSem_v` STRIP_ASSUME_TAC)) THEN
   REPEAT SUBST_LHS_TAC THEN
   USE_CHANGED [v_inv_def] THEN
   REWRITE_TAC[NOT_CONS_NIL] THEN STRIP_TAC THEN
   FIRST_ASSUM(fun a2 ->
     let len = CONV_RULE NUM_REDUCE_CONV
       (REWRITE_RULE[LENGTH] (MATCH_MP LIST_REL_LENGTH a2)) in
     RULE_ASSUM_TAC(REWRITE_RULE[SYM len])) THEN
   FIRST_ASSUM(fun eq -> FIRST_ASSUM(fun hl ->
     MAP_EVERY EXISTS_TAC
       [rand(rator(rhs(concl eq))); rand(rand(rhs(concl hl)))] THEN
     ASM_REWRITE_TAC[])))
### walk_LENGTH
  (* the walk of the heap from the pointer of a list gives as many
     pointers as the list has elements: the induction is on the
     list, the cons of the value is what v_to_list_SOME_CONS_IMP
     gives, and v_inv of that cons names the BlockRep of two that
     the heap holds at the pointer.  Of a list of one the walk is
     the pointer alone; of a longer one it goes on at the pointer
     of the tail, which v_inv_v_to_list_lemma names, and the walk's
     choice of that pointer has only the one witness *)
  (let hd_is n t =
      (try fst(dest_const(fst(strip_comb t))) = n
       with Failure _ -> false) in
    let grab asl p =
      tryfind (fun (_,th) ->
        if (try p th with Failure _ -> false) then th else fail())
        asl in
    (* an ALL2 whose first list is a cons *)
    let all2cons1 = prove
     (`!P h t (l:(B)list).
         ALL2 P (CONS (h:A) t) l <=>
         ?a b. l = CONS a b /\ P h a /\ ALL2 P t b`,
      REPEAT GEN_TAC THEN
      STRUCT_CASES_TAC(ISPEC `l:(B)list` list_CASES) THEN
      REWRITE_TAC[ALL2; NOT_CONS_NIL; CONS_11] THEN MESON_TAC[]) in
    (* what HOL4's some binder is of a predicate with one witness *)
    let some_SOME = prove
     (`!(P:A->bool) x. P x /\ (!y. P y ==> y = x) ==> some P = SOME x`,
      REPEAT GEN_TAC THEN STRIP_TAC THEN REWRITE_TAC[some_DEF] THEN
      COND_CASES_TAC THENL
       [AP_TERM_TAC THEN MATCH_MP_TAC SELECT_UNIQUE THEN
        GEN_TAC THEN ASM_MESON_TAC[];
        ASM_MESON_TAC[]]) in
  LIST_INDUCT_TAC THENL
     [REPEAT GEN_TAC THEN REWRITE_TAC[]; ALL_TAC] THEN
    REPEAT GEN_TAC THEN
    DISCH_THEN(REPEAT_TCL CONJUNCTS_THEN ASSUME_TAC) THEN
    FIRST_ASSUM(fun th ->
      if hd_is "dataSem_v_to_list" (lhs (concl th))
      then MP_TAC(SPEC_ALL(MATCH_MP
             v_to_list_SOME_CONS_IMP th))
      else fail()) THEN
    DISCH_THEN STRIP_ASSUME_TAC THEN
    FIRST_X_ASSUM(fun e ->
      if is_eq (concl e) && is_var (lhs (concl e)) &&
         hd_is "dataSem_Block" (rhs (concl e))
      then SUBST_ALL_TAC e else fail()) THEN
    FIRST_X_ASSUM(fun vi ->
      if hd_is "v_inv" (concl vi)
      then MP_TAC(REWRITE_RULE[v_inv_def; NOT_CONS_NIL] vi)
      else fail()) THEN
    DISCH_THEN STRIP_ASSUME_TAC THEN
    FIRST_X_ASSUM(fun a2 ->
      if hd_is "ALL2" (concl a2)
      then MP_TAC(REWRITE_RULE[all2cons1; CONJUNCT1 ALL2_DEF] a2)
      else fail()) THEN
    DISCH_THEN STRIP_ASSUME_TAC THEN
    REPEAT(FIRST_X_ASSUM(fun e ->
      if is_eq (concl e) && is_var (lhs (concl e)) &&
         (hd_is "CONS" (rhs (concl e)) || hd_is "NIL" (rhs (concl e)))
      then SUBST_ALL_TAC e else fail())) THEN
    FIRST_X_ASSUM(fun e ->
      if is_eq (concl e) &&
         hd_is "gc_shared_Pointer" (lhs (concl e)) &&
         hd_is "gc_shared_Pointer" (rhs (concl e))
      then MP_TAC(REWRITE_RULE[injectivity "heap_address"] e)
      else fail()) THEN
    DISCH_THEN(CONJUNCTS_THEN2 (SUBST_ALL_TAC o SYM) (K ALL_TAC)) THEN
    CASES_ON_NAME "t" THENL
     [FIRST_X_ASSUM(fun e ->
        if is_eq (concl e) &&
           hd_is "data_to_word_memoryProof_walk" (lhs (concl e))
        then SUBST1_TAC(SYM e) else fail()) THEN
      REWRITE_TAC[LENGTH] THEN
      ONCE_REWRITE_TAC[data_to_word_memoryProof_walk_def] THEN
      REWRITE_TAC[LENGTH] THEN CONV_TAC NUM_REDUCE_CONV THEN
      REWRITE_TAC[LENGTH] THEN CONV_TAC NUM_REDUCE_CONV;
      ALL_TAC] THEN
    W(fun (asl,w) ->
      let vi,vl = tryfind (fun (_,th) ->
        if not (hd_is "v_inv" (concl th)) then fail() else
        (th, grab asl (fun u ->
           hd_is "dataSem_v_to_list" (lhs (concl u)) &&
           rand (lhs (concl u)) = el 1 (snd(strip_comb (concl th))) &&
           hd_is "CONS" (rand (rhs (concl u)))))) asl in
      let lst = rand (rhs (concl vl)) in
      let ne = ISPECL [lhand lst; rand lst] NOT_CONS_NIL in
      MP_TAC(MATCH_MP v_inv_v_to_list_lemma
               (CONJ vi (CONJ vl ne)))) THEN
    DISCH_THEN STRIP_ASSUME_TAC THEN
    FIRST_X_ASSUM(fun e ->
      if is_eq (concl e) && is_var (lhs (concl e)) &&
         hd_is "gc_shared_Pointer" (rhs (concl e))
      then SUBST_ALL_TAC e else fail()) THEN
    FIRST_X_ASSUM(fun e ->
      if is_eq (concl e) &&
         hd_is "data_to_word_memoryProof_walk" (lhs (concl e))
      then SUBST1_TAC(SYM e) else fail()) THEN
    REWRITE_TAC[LENGTH] THEN
    ONCE_REWRITE_TAC[data_to_word_memoryProof_walk_def] THEN
    REWRITE_TAC[ARITH_RULE `(SUC (SUC n) = 0) <=> F`;
                ARITH_RULE `(SUC (SUC n) = 1) <=> F`;
                ARITH_RULE `SUC (SUC n) - 1 = SUC n`] THEN
    W(fun (asl,w) ->
      let sm = find_term (hd_is "some") w in
      let ptr = lhand (find_term (hd_is "heap_lookup") sm) in
      let hl = grab asl (fun th ->
        hd_is "heap_lookup" (lhs (concl th)) &&
        lhand (lhs (concl th)) = ptr) in
      let xs = rand (rand (rhs (concl hl))) in
      let x1 = lhand xs in
      let y1 = lhand (rand xs) in
      let p2 = lhand y1 in
      SUBGOAL_THEN (mk_eq(sm, mk_icomb(`SOME`,p2))) SUBST1_TAC THENL
       [MATCH_MP_TAC some_SOME THEN
        CONV_TAC(TOP_DEPTH_CONV BETA_CONV) THEN
        CONJ_TAC THENL
         [MAP_EVERY EXISTS_TAC [x1; y1] THEN ASM_REWRITE_TAC[];
          X_GEN_TAC `q:num` THEN
          REWRITE_TAC[REWRITE_RULE[BlockRep_def] hl;
                      BlockRep_def] THEN
          REWRITE_TAC[LENGTH] THEN CONV_TAC NUM_REDUCE_CONV THEN
          REWRITE_TAC[injectivity "option";
                      injectivity "heap_element"; CONS_11; PAIR_EQ] THEN
          STRIP_TAC THEN
          FIRST_ASSUM(fun e1 -> FIRST_ASSUM(fun e2 ->
            let th = TRANS e1 e2 in
            if hd_is "gc_shared_Pointer" (lhs (concl th)) &&
               hd_is "gc_shared_Pointer" (rhs (concl th))
            then MP_TAC(REWRITE_RULE[injectivity "heap_address"] th)
            else fail())) THEN
          STRIP_TAC THEN ASM_REWRITE_TAC[]];
        ALL_TAC]) THEN
    MATCH_REDUCE_TAC THEN
    REWRITE_TAC[LENGTH] THEN
    W(fun (asl,w) ->
      let ih = grab asl (fun th -> is_forall (concl th)) in
      let wt = find_term (hd_is "data_to_word_memoryProof_walk") w in
      let lst = rand (rhs (el 1 (conjuncts
        (lhand (snd(strip_forall (concl ih))))))) in
      let vl = grab asl (fun th ->
        hd_is "dataSem_v_to_list" (lhs (concl th)) &&
        rand (rhs (concl th)) = lst) in
      MP_TAC(SPECL [el 2 (snd(strip_comb wt)); wt;
                    rand (lhs (concl vl));
                    el 3 (fst(strip_forall (concl ih)))] ih)) THEN
    ANTS_TAC THENL
     [ASM_REWRITE_TAC[LENGTH; NOT_CONS_NIL]; ALL_TAC] THEN
    DISCH_THEN SUBST1_TAC THEN
    REWRITE_TAC[LENGTH])
### BlockRep_heap_length
  (REWRITE_TAC[BlockRep_def; heap_length_CONS; heap_length_NIL;
               el_length_def; LENGTH] THEN ARITH_TAC)
### ALL_DISTINCT_FILTER_LENGTH
  (* the two filters take each element once, whether the list has
     repetitions or not *)
  (let lem = prove
    (`!xs:A list. LENGTH (FILTER ((~) o P) xs) + LENGTH (FILTER P xs)
                  = LENGTH xs`,
     LIST_INDUCT_TAC THEN REWRITE_TAC[FILTER; LENGTH; o_THM] THEN
     ASM_CASES_TAC `(P:A->bool) h` THEN ASM_REWRITE_TAC[LENGTH] THEN
     ASM_ARITH_TAC) in
   DISCH_TAC THEN MATCH_ACCEPT_TAC lem)
### walk_heap_lookup
  (* every pointer of the walk has a BlockRep of two at it: the
     same induction as walk_LENGTH, where each step reads the
     element of the heap off the v_inv of the cons *)
  (let hd_is n t =
      (try fst(dest_const(fst(strip_comb t))) = n
       with Failure _ -> false) in
    let grab asl p =
      tryfind (fun (_,th) ->
        if (try p th with Failure _ -> false) then th else fail())
        asl in
    (* an ALL2 whose first list is a cons *)
    let all2cons1 = prove
     (`!P h t (l:(B)list).
         ALL2 P (CONS (h:A) t) l <=>
         ?a b. l = CONS a b /\ P h a /\ ALL2 P t b`,
      REPEAT GEN_TAC THEN
      STRUCT_CASES_TAC(ISPEC `l:(B)list` list_CASES) THEN
      REWRITE_TAC[ALL2; NOT_CONS_NIL; CONS_11] THEN MESON_TAC[]) in
    (* what HOL4's some binder is of a predicate with one witness *)
    let some_SOME = prove
     (`!(P:A->bool) x. P x /\ (!y. P y ==> y = x) ==> some P = SOME x`,
      REPEAT GEN_TAC THEN STRIP_TAC THEN REWRITE_TAC[some_DEF] THEN
      COND_CASES_TAC THENL
       [AP_TERM_TAC THEN MATCH_MP_TAC SELECT_UNIQUE THEN
        GEN_TAC THEN ASM_MESON_TAC[];
        ASM_MESON_TAC[]]) in
    (* the heap_lookup of a pointer that the invariant gives *)
    let pwit =
      W(fun (asl,w) ->
        let p = lhand (find_term (hd_is "heap_lookup") w) in
        let hl = grab asl (fun th ->
          hd_is "heap_lookup" (lhs (concl th)) &&
          lhand (lhs (concl th)) = p) in
        let xs = rand (rand (rhs (concl hl))) in
        MAP_EVERY EXISTS_TAC [lhand xs; lhand (rand xs)] THEN
        ASM_REWRITE_TAC[]) in
  LIST_INDUCT_TAC THENL
     [REPEAT GEN_TAC THEN REWRITE_TAC[]; ALL_TAC] THEN
    REPEAT GEN_TAC THEN
    DISCH_THEN(REPEAT_TCL CONJUNCTS_THEN ASSUME_TAC) THEN
    FIRST_ASSUM(fun th ->
      if hd_is "dataSem_v_to_list" (lhs (concl th))
      then MP_TAC(SPEC_ALL(MATCH_MP
             v_to_list_SOME_CONS_IMP th))
      else fail()) THEN
    DISCH_THEN STRIP_ASSUME_TAC THEN
    FIRST_X_ASSUM(fun e ->
      if is_eq (concl e) && is_var (lhs (concl e)) &&
         hd_is "dataSem_Block" (rhs (concl e))
      then SUBST_ALL_TAC e else fail()) THEN
    FIRST_X_ASSUM(fun vi ->
      if hd_is "v_inv" (concl vi)
      then MP_TAC(REWRITE_RULE[v_inv_def; NOT_CONS_NIL] vi)
      else fail()) THEN
    DISCH_THEN STRIP_ASSUME_TAC THEN
    FIRST_X_ASSUM(fun a2 ->
      if hd_is "ALL2" (concl a2)
      then MP_TAC(REWRITE_RULE[all2cons1; CONJUNCT1 ALL2_DEF] a2)
      else fail()) THEN
    DISCH_THEN STRIP_ASSUME_TAC THEN
    REPEAT(FIRST_X_ASSUM(fun e ->
      if is_eq (concl e) && is_var (lhs (concl e)) &&
         (hd_is "CONS" (rhs (concl e)) || hd_is "NIL" (rhs (concl e)))
      then SUBST_ALL_TAC e else fail())) THEN
    FIRST_X_ASSUM(fun e ->
      if is_eq (concl e) &&
         hd_is "gc_shared_Pointer" (lhs (concl e)) &&
         hd_is "gc_shared_Pointer" (rhs (concl e))
      then MP_TAC(REWRITE_RULE[injectivity "heap_address"] e)
      else fail()) THEN
    DISCH_THEN(CONJUNCTS_THEN2 (SUBST_ALL_TAC o SYM) (K ALL_TAC)) THEN
    CASES_ON_NAME "t" THENL
     [FIRST_X_ASSUM(fun e ->
        if is_eq (concl e) &&
           hd_is "data_to_word_memoryProof_walk" (lhs (concl e))
        then SUBST1_TAC(SYM e) else fail()) THEN
      REWRITE_TAC[LENGTH] THEN
      ONCE_REWRITE_TAC[data_to_word_memoryProof_walk_def] THEN
      REWRITE_TAC[LENGTH] THEN CONV_TAC NUM_REDUCE_CONV THEN
      REWRITE_TAC[ALL] THEN pwit;
      ALL_TAC] THEN
    W(fun (asl,w) ->
      let vi,vl = tryfind (fun (_,th) ->
        if not (hd_is "v_inv" (concl th)) then fail() else
        (th, grab asl (fun u ->
           hd_is "dataSem_v_to_list" (lhs (concl u)) &&
           rand (lhs (concl u)) = el 1 (snd(strip_comb (concl th))) &&
           hd_is "CONS" (rand (rhs (concl u)))))) asl in
      let lst = rand (rhs (concl vl)) in
      let ne = ISPECL [lhand lst; rand lst] NOT_CONS_NIL in
      MP_TAC(MATCH_MP v_inv_v_to_list_lemma
               (CONJ vi (CONJ vl ne)))) THEN
    DISCH_THEN STRIP_ASSUME_TAC THEN
    FIRST_X_ASSUM(fun e ->
      if is_eq (concl e) && is_var (lhs (concl e)) &&
         hd_is "gc_shared_Pointer" (rhs (concl e))
      then SUBST_ALL_TAC e else fail()) THEN
    FIRST_X_ASSUM(fun e ->
      if is_eq (concl e) &&
         hd_is "data_to_word_memoryProof_walk" (lhs (concl e))
      then SUBST1_TAC(SYM e) else fail()) THEN
    REWRITE_TAC[LENGTH] THEN
    ONCE_REWRITE_TAC[data_to_word_memoryProof_walk_def] THEN
    REWRITE_TAC[ARITH_RULE `(SUC (SUC n) = 0) <=> F`;
                ARITH_RULE `(SUC (SUC n) = 1) <=> F`;
                ARITH_RULE `SUC (SUC n) - 1 = SUC n`] THEN
    W(fun (asl,w) ->
      let sm = find_term (hd_is "some") w in
      let ptr = lhand (find_term (hd_is "heap_lookup") sm) in
      let hl = grab asl (fun th ->
        hd_is "heap_lookup" (lhs (concl th)) &&
        lhand (lhs (concl th)) = ptr) in
      let xs = rand (rand (rhs (concl hl))) in
      let x1 = lhand xs in
      let y1 = lhand (rand xs) in
      let p2 = lhand y1 in
      SUBGOAL_THEN (mk_eq(sm, mk_icomb(`SOME`,p2))) SUBST1_TAC THENL
       [MATCH_MP_TAC some_SOME THEN
        CONV_TAC(TOP_DEPTH_CONV BETA_CONV) THEN
        CONJ_TAC THENL
         [MAP_EVERY EXISTS_TAC [x1; y1] THEN ASM_REWRITE_TAC[];
          X_GEN_TAC `q:num` THEN
          REWRITE_TAC[REWRITE_RULE[BlockRep_def] hl;
                      BlockRep_def] THEN
          REWRITE_TAC[LENGTH] THEN CONV_TAC NUM_REDUCE_CONV THEN
          REWRITE_TAC[injectivity "option";
                      injectivity "heap_element"; CONS_11; PAIR_EQ] THEN
          STRIP_TAC THEN
          FIRST_ASSUM(fun e1 -> FIRST_ASSUM(fun e2 ->
            let th = TRANS e1 e2 in
            if hd_is "gc_shared_Pointer" (lhs (concl th)) &&
               hd_is "gc_shared_Pointer" (rhs (concl th))
            then MP_TAC(REWRITE_RULE[injectivity "heap_address"] th)
            else fail())) THEN
          STRIP_TAC THEN ASM_REWRITE_TAC[]];
        ALL_TAC]) THEN
    MATCH_REDUCE_TAC THEN
    REWRITE_TAC[ALL] THEN
    CONJ_TAC THENL [pwit; ALL_TAC] THEN
    W(fun (asl,w) ->
      let ih = grab asl (fun th -> is_forall (concl th)) in
      let wt = find_term (hd_is "data_to_word_memoryProof_walk") w in
      let lst = rand (rhs (el 1 (conjuncts
        (lhand (snd(strip_forall (concl ih))))))) in
      let vl = grab asl (fun th ->
        hd_is "dataSem_v_to_list" (lhs (concl th)) &&
        rand (rhs (concl th)) = lst) in
      MP_TAC(SPECL [el 2 (snd(strip_comb wt)); wt;
                    rand (lhs (concl vl));
                    el 3 (fst(strip_forall (concl ih)))] ih)) THEN
    ANTS_TAC THENL
     [ASM_REWRITE_TAC[LENGTH; NOT_CONS_NIL]; ALL_TAC] THEN
    REWRITE_TAC[])
### walk_MEM
  (* the pointer of a non-empty list is in its walk: the walk of a
     list of one is the pointer alone, and of a longer one the
     pointer is its head *)
  (let hd_is n t =
      (try fst(dest_const(fst(strip_comb t))) = n
       with Failure _ -> false) in
    let grab asl p =
      tryfind (fun (_,th) ->
        if (try p th with Failure _ -> false) then th else fail())
        asl in
    (* an ALL2 whose first list is a cons *)
    let all2cons1 = prove
     (`!P h t (l:(B)list).
         ALL2 P (CONS (h:A) t) l <=>
         ?a b. l = CONS a b /\ P h a /\ ALL2 P t b`,
      REPEAT GEN_TAC THEN
      STRUCT_CASES_TAC(ISPEC `l:(B)list` list_CASES) THEN
      REWRITE_TAC[ALL2; NOT_CONS_NIL; CONS_11] THEN MESON_TAC[]) in
    (* what HOL4's some binder is of a predicate with one witness *)
    let some_SOME = prove
     (`!(P:A->bool) x. P x /\ (!y. P y ==> y = x) ==> some P = SOME x`,
      REPEAT GEN_TAC THEN STRIP_TAC THEN REWRITE_TAC[some_DEF] THEN
      COND_CASES_TAC THENL
       [AP_TERM_TAC THEN MATCH_MP_TAC SELECT_UNIQUE THEN
        GEN_TAC THEN ASM_MESON_TAC[];
        ASM_MESON_TAC[]]) in
  DISCH_THEN(REPEAT_TCL CONJUNCTS_THEN ASSUME_TAC) THEN
    CASES_ON_NAME "vs" THENL
     [FIRST_X_ASSUM(fun th -> CONTR_TAC(REWRITE_RULE[] th));
      ALL_TAC] THEN
    FIRST_ASSUM(fun th ->
      if hd_is "dataSem_v_to_list" (lhs (concl th))
      then MP_TAC(SPEC_ALL(MATCH_MP
             v_to_list_SOME_CONS_IMP th))
      else fail()) THEN
    DISCH_THEN STRIP_ASSUME_TAC THEN
    FIRST_X_ASSUM(fun e ->
      if is_eq (concl e) && is_var (lhs (concl e)) &&
         hd_is "dataSem_Block" (rhs (concl e))
      then SUBST_ALL_TAC e else fail()) THEN
    FIRST_X_ASSUM(fun vi ->
      if hd_is "v_inv" (concl vi)
      then MP_TAC(REWRITE_RULE[v_inv_def; NOT_CONS_NIL] vi)
      else fail()) THEN
    DISCH_THEN STRIP_ASSUME_TAC THEN
    FIRST_X_ASSUM(fun a2 ->
      if hd_is "ALL2" (concl a2)
      then MP_TAC(REWRITE_RULE[all2cons1; CONJUNCT1 ALL2_DEF] a2)
      else fail()) THEN
    DISCH_THEN STRIP_ASSUME_TAC THEN
    REPEAT(FIRST_X_ASSUM(fun e ->
      if is_eq (concl e) && is_var (lhs (concl e)) &&
         (hd_is "CONS" (rhs (concl e)) || hd_is "NIL" (rhs (concl e)))
      then SUBST_ALL_TAC e else fail())) THEN
    FIRST_X_ASSUM(fun e ->
      if is_eq (concl e) &&
         hd_is "gc_shared_Pointer" (lhs (concl e)) &&
         hd_is "gc_shared_Pointer" (rhs (concl e))
      then MP_TAC(REWRITE_RULE[injectivity "heap_address"] e)
      else fail()) THEN
    DISCH_THEN(CONJUNCTS_THEN2 (SUBST_ALL_TAC o SYM) (K ALL_TAC)) THEN
    CASES_ON_NAME "a1" THENL
     [REWRITE_TAC[LENGTH] THEN
      ONCE_REWRITE_TAC[data_to_word_memoryProof_walk_def] THEN
      REWRITE_TAC[LENGTH] THEN CONV_TAC NUM_REDUCE_CONV THEN
      REWRITE_TAC[MEM];
      ALL_TAC] THEN
    W(fun (asl,w) ->
      let vi,vl = tryfind (fun (_,th) ->
        if not (hd_is "v_inv" (concl th)) then fail() else
        (th, grab asl (fun u ->
           hd_is "dataSem_v_to_list" (lhs (concl u)) &&
           rand (lhs (concl u)) = el 1 (snd(strip_comb (concl th))) &&
           hd_is "CONS" (rand (rhs (concl u)))))) asl in
      let lst = rand (rhs (concl vl)) in
      let ne = ISPECL [lhand lst; rand lst] NOT_CONS_NIL in
      MP_TAC(MATCH_MP v_inv_v_to_list_lemma
               (CONJ vi (CONJ vl ne)))) THEN
    DISCH_THEN STRIP_ASSUME_TAC THEN
    FIRST_X_ASSUM(fun e ->
      if is_eq (concl e) && is_var (lhs (concl e)) &&
         hd_is "gc_shared_Pointer" (rhs (concl e))
      then SUBST_ALL_TAC e else fail()) THEN
    REWRITE_TAC[LENGTH] THEN
    ONCE_REWRITE_TAC[data_to_word_memoryProof_walk_def] THEN
    REWRITE_TAC[ARITH_RULE `(SUC (SUC n) = 0) <=> F`;
                ARITH_RULE `(SUC (SUC n) = 1) <=> F`;
                ARITH_RULE `SUC (SUC n) - 1 = SUC n`] THEN
    W(fun (asl,w) ->
      let sm = find_term (hd_is "some") w in
      let ptr = lhand (find_term (hd_is "heap_lookup") sm) in
      let hl = grab asl (fun th ->
        hd_is "heap_lookup" (lhs (concl th)) &&
        lhand (lhs (concl th)) = ptr) in
      let xs = rand (rand (rhs (concl hl))) in
      let x1 = lhand xs in
      let y1 = lhand (rand xs) in
      let p2 = lhand y1 in
      SUBGOAL_THEN (mk_eq(sm, mk_icomb(`SOME`,p2))) SUBST1_TAC THENL
       [MATCH_MP_TAC some_SOME THEN
        CONV_TAC(TOP_DEPTH_CONV BETA_CONV) THEN
        CONJ_TAC THENL
         [MAP_EVERY EXISTS_TAC [x1; y1] THEN ASM_REWRITE_TAC[];
          X_GEN_TAC `q:num` THEN
          REWRITE_TAC[REWRITE_RULE[BlockRep_def] hl;
                      BlockRep_def] THEN
          REWRITE_TAC[LENGTH] THEN CONV_TAC NUM_REDUCE_CONV THEN
          REWRITE_TAC[injectivity "option";
                      injectivity "heap_element"; CONS_11; PAIR_EQ] THEN
          STRIP_TAC THEN
          FIRST_ASSUM(fun e1 -> FIRST_ASSUM(fun e2 ->
            let th = TRANS e1 e2 in
            if hd_is "gc_shared_Pointer" (lhs (concl th)) &&
               hd_is "gc_shared_Pointer" (rhs (concl th))
            then MP_TAC(REWRITE_RULE[injectivity "heap_address"] th)
            else fail())) THEN
          STRIP_TAC THEN ASM_REWRITE_TAC[]];
        ALL_TAC]) THEN
    MATCH_REDUCE_TAC THEN
    REWRITE_TAC[MEM])
### v_to_list_same_LENGTH
  (* two values with the same root have lists of the same length:
     the induction is on the first list.  Of an empty one the value
     is the Block of nil_tag, whose root is a Data, and of a cons
     it is the Block of cons_tag, whose root is a Pointer, so the
     two lists are empty together; and when both are a cons the
     roots are the same pointer, so the heap gives them the same
     BlockRep, whose second element is the root of both tails *)
  (let hd_is n t =
      (try fst(dest_const(fst(strip_comb t))) = n
       with Failure _ -> false) in
    let safep p th = (try p th with Failure _ -> false) in
    let grab asl p =
      tryfind (fun (_,th) ->
        if (try p th with Failure _ -> false) then th else fail())
        asl in
    (* an ALL2 whose first list is a cons *)
    let all2cons1 = prove
     (`!P h t (l:(B)list).
         ALL2 P (CONS (h:A) t) l <=>
         ?a b. l = CONS a b /\ P h a /\ ALL2 P t b`,
      REPEAT GEN_TAC THEN
      STRUCT_CASES_TAC(ISPEC `l:(B)list` list_CASES) THEN
      REWRITE_TAC[ALL2; NOT_CONS_NIL; CONS_11] THEN MESON_TAC[]) in
    (* a value whose list is empty is the Block of nil_tag, and one
       whose list is a cons is the Block of cons_tag of two *)
    let vnil =
      FIRST_X_ASSUM(fun th ->
        if hd_is "dataSem_v_to_list" (lhs (concl th)) &&
           hd_is "NIL" (rand (rhs (concl th)))
        then MP_TAC(REWRITE_RULE[v_to_list_SOME_NIL_IFF] th)
        else fail()) THEN
      DISCH_THEN(CHOOSE_THEN SUBST_ALL_TAC) in
    let vcons =
      FIRST_X_ASSUM(fun th ->
        if hd_is "dataSem_v_to_list" (lhs (concl th)) &&
           hd_is "CONS" (rand (rhs (concl th)))
        then MP_TAC(SPEC_ALL(MATCH_MP
               v_to_list_SOME_CONS_IMP th))
        else fail()) THEN
      DISCH_THEN STRIP_ASSUME_TAC THEN
      FIRST_X_ASSUM(fun e ->
        if is_eq (concl e) && is_var (lhs (concl e)) &&
           hd_is "dataSem_Block" (rhs (concl e))
        then SUBST_ALL_TAC e else fail()) in
    (* the invariants of the values, taken apart *)
    let splitinv =
      RULE_ASSUM_TAC(REWRITE_RULE[v_inv_def; NOT_CONS_NIL;
                                  all2cons1; CONJUNCT1 ALL2_DEF]) THEN
      REPEAT(FIRST_X_ASSUM(fun th ->
        if is_conj (concl th) || is_exists (concl th)
        then STRIP_ASSUME_TAC th else fail())) THEN
      REPEAT(FIRST_X_ASSUM(fun e ->
        if is_eq (concl e) && is_var (lhs (concl e)) &&
           (hd_is "CONS" (rhs (concl e)) || hd_is "NIL" (rhs (concl e)))
        then SUBST_ALL_TAC e else fail())) in
    (* a Data and a Pointer of the same root is a contradiction *)
    let clash =
      FIRST_ASSUM(fun e1 -> FIRST_ASSUM(fun e2 ->
        CONTR_TAC(REWRITE_RULE[distinctness "heap_address"]
                    (TRANS (SYM e1) e2)))) in
  LIST_INDUCT_TAC THEN
    REPEAT GEN_TAC THEN
    DISCH_THEN(REPEAT_TCL CONJUNCTS_THEN ASSUME_TAC) THEN
    CASES_ON_NAME "ys" THEN
    REWRITE_TAC[LENGTH] THEN
    TRY(vnil THEN vcons THEN splitinv THEN clash THEN NO_TAC) THEN
    TRY(vcons THEN vnil THEN splitinv THEN clash THEN NO_TAC) THEN
    vcons THEN
    vcons THEN
    splitinv THEN
    W(fun (asl,w) ->
      let pes = filter (fun (_,th) -> safep (fun t ->
        is_eq (concl t) && is_var (lhs (concl t)) &&
        hd_is "gc_shared_Pointer" (rhs (concl t))) th) asl in
      MP_TAC(REWRITE_RULE[injectivity "heap_address"]
               (TRANS (SYM (snd (el 0 pes))) (snd (el 1 pes))))) THEN
    DISCH_THEN(CONJUNCTS_THEN2 SUBST_ALL_TAC (K ALL_TAC)) THEN
    W(fun (asl,w) ->
      let hls = filter (fun (_,th) -> safep (fun t ->
        hd_is "heap_lookup" (lhs (concl t))) th) asl in
      MP_TAC(REWRITE_RULE[BlockRep_def; injectivity "option";
                          injectivity "heap_element"; CONS_11;
                          PAIR_EQ; LENGTH]
               (TRANS (SYM (snd (el 0 hls))) (snd (el 1 hls))))) THEN
    DISCH_THEN STRIP_ASSUME_TAC THEN
    REPEAT(FIRST_X_ASSUM(fun e ->
      if is_eq (concl e) && is_var (lhs (concl e)) &&
         is_var (rhs (concl e))
      then SUBST_ALL_TAC e else fail())) THEN
    REWRITE_TAC[SUC_INJ] THEN
    W(fun (asl,w) ->
      MATCH_MP_TAC (grab asl (fun th -> is_forall (concl th)))) THEN
    W(fun (asl,w) ->
      let cs = conjuncts (snd(strip_exists w)) in
      let pick lst = grab asl (fun th -> safep (fun u ->
        hd_is "dataSem_v_to_list" (lhs (concl u)) &&
        rand (rhs (concl u)) = lst) th) in
      let vl1 = pick (rand (rhs (el 2 cs))) in
      let vl2 = pick (rand (rhs (el 3 cs))) in
      let w1 = rand (lhs (concl vl1)) in
      let w2 = rand (lhs (concl vl2)) in
      let vi1 = grab asl (fun th ->
        hd_is "v_inv" (concl th) &&
        el 1 (snd(strip_comb (concl th))) = w1) in
      let addr = fst(dest_pair
        (el 3 (snd(strip_comb (concl vi1))))) in
      MAP_EVERY EXISTS_TAC [addr; w1; w2]) THEN
    ASM_REWRITE_TAC[])
### block_drop_DROP
  (* induction on the number: a drop of none is the value itself,
     and one more goes down the tail of the cons that the list of
     the value is, which v_to_list_SOME_CONS_IMP names *)
  (let suc1 = ARITH_RULE `SUC n - 1 = n` in
   INDUCT_TAC THEN REPEAT GEN_TAC THEN STRIP_TAC THENL
    [REWRITE_TAC[block_drop_def] THEN MATCH_REDUCE_TAC THEN
     ASM_REWRITE_TAC[THE; DROP_0];
     CASES_ON_NAME "vs" THENL
      [FIRST_ASSUM(fun th -> CONTR_TAC(REWRITE_RULE[LENGTH; LT] th));
       ALL_TAC] THEN
     FIRST_ASSUM(fun th ->
       MP_TAC(SPEC_ALL(MATCH_MP v_to_list_SOME_CONS_IMP th))) THEN
     DISCH_THEN(X_CHOOSE_THEN `ts':num`
       (X_CHOOSE_THEN `ys:dataSem_v` STRIP_ASSUME_TAC)) THEN
     REPEAT SUBST_LHS_TAC THEN
     ONCE_REWRITE_TAC[block_drop_def] THEN
     MATCH_REDUCE_TAC THEN
     REWRITE_TAC[DROP; NOT_SUC; suc1] THEN
     FIRST_ASSUM MATCH_MP_TAC THEN ASM_REWRITE_TAC[] THEN
     RULE_ASSUM_TAC(REWRITE_RULE[LENGTH]) THEN ARITH_ASM_TAC])
### v_to_list_heap_length
  (* the walk of the heap from the pointer of the value gives one
     pointer per element of the list, they are distinct, and each
     holds a BlockRep of two: three words of the heap each.  The
     list of pointers is the walk itself, which the first premise
     of walk_LENGTH names, so the theorem is matched against the
     invariant and the walk is read off that instance *)
  (let wl = walk_LENGTH
   and wad = walk_ALL_DISTINCT
   and whl = walk_heap_lookup
   and hlb = heap_length_Blocks in
   STRIP_TAC THEN
   FIRST_ASSUM(fun vi -> FIRST_ASSUM(fun vl -> FIRST_ASSUM(fun ne ->
     MP_TAC(MATCH_MP v_inv_v_to_list_lemma
              (CONJ vi (CONJ vl ne)))))) THEN
   STRIP_TAC THEN REPEAT SUBST_LHS_TAC THEN
   FIRST_ASSUM(fun vi -> FIRST_ASSUM(fun vl -> FIRST_ASSUM(fun ne ->
     let w1 = PART_MATCH (hd o conjuncts o lhand) wl (concl vi) in
     let wt = lhs (last (conjuncts (lhand (concl w1)))) in
     let prem = CONJ vi (CONJ vl (CONJ ne (REFL wt))) in
     let len = SPEC_ALL(MATCH_MP wl prem)
     and ad = SPEC_ALL(MATCH_MP wad prem)
     and ev = SPEC_ALL(MATCH_MP whl prem) in
     MP_TAC(REWRITE_RULE[len] (MATCH_MP hlb (CONJ ad ev)))))) THEN
   REWRITE_TAC[])
### memory_rel_list_limit
  (* the heap holds three words per element of the list, and the
     heap in memory leaves room for the limit and three more *)
  (let mul_le = prove
    (`!a b d x. 3 * a <= b /\ (b + 3) * d + 1 < x
                ==> 3 * (a + 1) * d < x`,
     REPEAT GEN_TAC THEN STRIP_TAC THEN
     MATCH_MP_TAC LET_TRANS THEN EXISTS_TAC `(b + 3) * d` THEN
     CONJ_TAC THENL
      [REWRITE_TAC[MULT_ASSOC;
                   ARITH_RULE `3 * (a + 1) = 3 * a + 3`;
                   LE_MULT_RCANCEL] THEN
       DISJ1_TAC THEN ASM_ARITH_TAC;
       ASM_ARITH_TAC]) in
   MEMORY_REL_TAC THEN USE_CHANGED [heap_ok_def] THEN
   STRIP_TAC THEN
   SUBGOAL_THEN `3 * LENGTH (xs:(dataSem_v)list) <= limit'`
     MP_TAC THENL
    [ASM_CASES_TAC `xs:(dataSem_v)list = []` THENL
      [ASM_REWRITE_TAC[LENGTH] THEN ARITH_TAC;
       FIRST_ASSUM(fun vi -> FIRST_ASSUM(fun vl ->
         FIRST_ASSUM(fun ne ->
           MP_TAC(MATCH_MP v_to_list_heap_length
                    (CONJ vi (CONJ vl ne)))))) THEN
       ASM_REWRITE_TAC[]];
     ALL_TAC] THEN
   DISCH_TAC THEN
   FIRST_ASSUM(fun le -> FIRST_ASSUM(fun dw ->
     MATCH_ACCEPT_TAC(MATCH_MP mul_le (CONJ le dw)))))
### do_part_SOME_IMP_SOME
  (* every clause of do_part gives the timestamp back as a SOME,
     and the one of a Str gives it under a let *)
  (CASES_ON_NAME "h" THEN
   REWRITE_TAC[dataSem_do_part_def] THEN
   REPEAT(CHANGED_TAC
     (REWRITE_TAC[PAIR_EQ] THEN
      CONV_TAC(ONCE_DEPTH_CONV let_CONV) THEN
      REPEAT COND_CASES_TAC THEN REPEAT STRIP_TAC)) THEN
   RULE_ASSUM_TAC(CONV_RULE(TOP_DEPTH_CONV let_CONV)) THEN
   RULE_ASSUM_TAC(REWRITE_RULE[PAIR_EQ]) THEN
   REPEAT(FIRST_X_ASSUM(CONJUNCTS_THEN ASSUME_TAC)) THEN
   ASM_MESON_TAC[])
### memory_rel_IMP_MAP_UPDATE
  (MATCH_MP_TAC memory_rel_rearrange THEN
   GEN_TAC THEN REWRITE_TAC[MEM_APPEND; MEM_MAP; MEM] THEN
   STRIP_TAC THEN ASM_REWRITE_TAC[] THEN
   REWRITE_TAC[UPDATE] THEN
   CONV_TAC(DEPTH_CONV BETA_CONV) THEN
   COND_CASES_TAC THEN ASM_REWRITE_TAC[] THEN
   ASM_MESON_TAC[])
### data_to_word_memoryProof_ZIP_MAP_MAP
  (let aux = prove
    (`!(f:A->B) (g:A->C) xs.
        ZIP (MAP f xs) (MAP g xs) = MAP (\k. (f k,g k)) xs`,
     GEN_TAC THEN GEN_TAC THEN LIST_INDUCT_TAC THEN
     ASM_REWRITE_TAC[MAP; ZIP]) in
   REPEAT GEN_TAC THEN MATCH_ACCEPT_TAC aux)
### LENGTH_n2mw_LE_num_size
  (* the words of a number are at most its num_size: both
     recursions divide, n2mw by the size of a word and num_size by
     two to the thirty-two, and a word of a good size is at least
     that wide -- so a complete induction on the number does it,
     with the clause of num_size at a number below two to the
     thirty-two (which is two, and a number that small is one word)
     for the base.  The source has the induction theorem of the
     definition, which the port's cake_define does not make *)
  ((* the quotient of a number by two or more is smaller *)
   let divlt = prove
    (`!n d. ~(n = 0) /\ 2 <= d ==> n DIV d < n`,
     REPEAT GEN_TAC THEN STRIP_TAC THEN
     MP_TAC(SPECL [`n:num`; `d:num`] DIVISION) THEN
     ANTS_TAC THENL [ASM_ARITH_TAC; ALL_TAC] THEN
     ABBREV_TAC `q = n DIV d` THEN ABBREV_TAC `r = n MOD d` THEN
     STRIP_TAC THEN
     SUBGOAL_THEN `2 * q <= d * q` MP_TAC THENL
      [ASM_SIMP_TAC[LE_MULT_RCANCEL]; ALL_TAC] THEN
     ASM_ARITH_TAC) in
   (* a word of a good size holds a number of thirty-two bits *)
   let dw32 = prove
    (`good_dimindex (:'a) ==> 2 EXP 32 <= dimword (:'a)`,
     REWRITE_TAC[good_dimindex_def; dimword] THEN
     STRIP_TAC THEN ASM_REWRITE_TAC[] THEN
     CONV_TAC NUM_REDUCE_CONV) in
   let usedw32 =
     FIRST_ASSUM(fun gd -> MATCH_ACCEPT_TAC(MATCH_MP dw32 gd)) in
   MATCH_MP_TAC num_WF THEN
   X_GEN_TAC `n:num` THEN DISCH_TAC THEN
   X_GEN_TAC `m:num` THEN STRIP_TAC THEN
   ONCE_REWRITE_TAC[n2mw_def] THEN
   ONCE_REWRITE_TAC[num_size_def] THEN
   ASM_CASES_TAC `n = 0` THEN
   ASM_REWRITE_TAC[LENGTH] THEN
   TRY(COND_CASES_TAC THEN ARITH_TAC THEN NO_TAC) THEN
   REWRITE_TAC[LENGTH] THEN
   COND_CASES_TAC THEN
   (* m is below two to the thirty-two, and then so is n *)
   TRY(SUBGOAL_THEN `n DIV dimword (:'a) = 0` SUBST1_TAC THENL
        [MATCH_MP_TAC DIV_LT THEN
         TRANS_TAC LTE_TRANS `2 EXP 32` THEN
         CONJ_TAC THENL [ASM_ARITH_TAC; usedw32];
         ALL_TAC] THEN
       REWRITE_TAC[n2mw_def; LENGTH] THEN ARITH_TAC THEN
       NO_TAC) THEN
   (* and otherwise the induction hypothesis, at the quotients *)
   MATCH_MP_TAC(ARITH_RULE `k <= l ==> SUC k <= 1 + l`) THEN
   FIRST_X_ASSUM(fun ih ->
     MP_TAC(SPEC `n DIV dimword (:'a)` ih)) THEN
   ANTS_TAC THENL
    [MATCH_MP_TAC divlt THEN ASM_REWRITE_TAC[] THEN
     TRANS_TAC LE_TRANS `2 EXP 32` THEN
     CONJ_TAC THENL [CONV_TAC NUM_REDUCE_CONV; usedw32];
     ALL_TAC] THEN
   DISCH_THEN(fun th -> MP_TAC(SPEC `m DIV 2 EXP 32` th)) THEN
   ASM_REWRITE_TAC[] THEN
   ANTS_TAC THENL
    [TRANS_TAC LE_TRANS `m DIV dimword (:'a)` THEN CONJ_TAC THENL
      [MATCH_MP_TAC DIV_MONO THEN ASM_REWRITE_TAC[] THEN
       REWRITE_TAC[dimword; EXP_EQ_0; ARITH];
       MATCH_MP_TAC DIV_MONO2 THEN CONJ_TAC THEN
       TRY(REWRITE_TAC[EXP_EQ_0; ARITH] THEN NO_TAC) THEN
       usedw32];
     DISCH_THEN ACCEPT_TAC])
### least_notin_domain
  (* the domain of a tree is finite, so some number is not in it,
     and the least number that is not in it is one of those *)
  (let fin = prove
    (`!t:A spt. FINITE (domain t)`,
     MATCH_MP_TAC spt_INDUCT THEN
     SIMP_TAC[domain_def; FINITE_EMPTY; FINITE_INSERT;
              FINITE_UNION; FINITE_IMAGE]) in
   let notin = prove
    (`!s:num->bool. FINITE s ==> ?n. ~(n IN s)`,
     GEN_TAC THEN REWRITE_TAC[num_FINITE] THEN
     DISCH_THEN(X_CHOOSE_TAC `a:num`) THEN
     EXISTS_TAC `a + 1` THEN DISCH_TAC THEN
     FIRST_X_ASSUM(MP_TAC o SPEC `a + 1`) THEN
     ASM_REWRITE_TAC[] THEN ARITH_TAC) in
   let least_lemma = prove
    (`!s:num->bool. FINITE s ==> ~((LEAST (\n. ~(n IN s))) IN s)`,
     GEN_TAC THEN DISCH_TAC THEN
     MP_TAC(ISPEC `\n:num. ~(n IN s)` MINIMAL) THEN
     REWRITE_TAC[LEAST] THEN
     ASM_SIMP_TAC[notin] THEN
     DISCH_THEN(fun th -> REWRITE_TAC[CONJUNCT1 th])) in
   MATCH_ACCEPT_TAC (MATCH_MP least_lemma (SPEC_ALL fin)))
### word_and_lsr_0
  (REWRITE_TAC[word_index] THEN DISCH_TAC THEN
   REWRITE_TAC[WORD_EQ_BITS_ALT; BIT_WORD_0; BIT_WORD_AND;
               BIT_WORD_SHL] THEN
   REPEAT STRIP_TAC THEN
   FIRST_X_ASSUM(MP_TAC o SPEC `i:num`) THEN ASM_REWRITE_TAC[])
### byte_aligned_IMP_shift
  (* a byte aligned word is its own slice above the shift of the
     dimindex, and such a slice is the word shifted down and up
     again *)
  (let LOG2_RED =
     REPEATC(CHANGED_CONV(ONCE_DEPTH_CONV(REWR_CONV LOG2) THENC
                          NUM_REDUCE_CONV THENC REWRITE_CONV[])) in
   let key = prove
    (`!p (w:(N)word). word_slice (dimindex (:N) - 1) p w = w
        ==> w = word_shl (word_ushr w p) p`,
     REPEAT GEN_TAC THEN
     DISCH_THEN(fun th -> GEN_REWRITE_TAC LAND_CONV [GSYM th]) THEN
     REWRITE_TAC[word_slice; word_bits; WORD_EQ_BITS_ALT;
                 BIT_WORD_SHL; BIT_WORD_SUBWORD; BIT_WORD_USHR] THEN
     X_GEN_TAC `i:num` THEN DISCH_TAC THEN
     ASM_CASES_TAC `p:num <= i` THEN ASM_REWRITE_TAC[] THEN
     SUBGOAL_THEN
       `i - p < MIN ((dimindex (:N) - 1 + 1) - p) (dimindex (:N))`
       (fun th -> REWRITE_TAC[th]) THENL
      [REWRITE_TAC[ARITH_RULE
         `MIN a b = if a <= b then a else b`] THEN
       COND_CASES_TAC THEN ASM_ARITH_TAC;
       REWRITE_TAC[ARITH_RULE `p + (i - p) = (i - p) + p`]]) in
   REWRITE_TAC[byte_aligned_def; aligned_def;
               align_def] THEN
   STRIP_TAC THEN
   SUBGOAL_THEN `LOG2 (dimindex (:'a) DIV 8) =
                 backend_common_word_shift (:'a)`
     (fun th -> RULE_ASSUM_TAC(REWRITE_RULE[th])) THENL
    [FIRST_ASSUM(fun g -> MP_TAC g) THEN
     REWRITE_TAC[good_dimindex_def;
                 word_shift_def] THEN
     DISCH_THEN(DISJ_CASES_THEN SUBST1_TAC) THEN
     CONV_TAC NUM_REDUCE_CONV THEN CONV_TAC LOG2_RED;
     EXISTS_TAC
       `word_ushr (w:'a word) (backend_common_word_shift (:'a))` THEN
     MATCH_MP_TAC key THEN FIRST_ASSUM ACCEPT_TAC])
### make_cons_ptr_add
  (* and the same for the pointer of a cons, where the one that
     the lower bits already hold is absorbed first *)
  (let lb1 = prove
     (`!c (x:(N)word).
         word 1 || get_lowerbits c (wordLang_Word x) =
         get_lowerbits c (wordLang_Word x)`,
      REPEAT GEN_TAC THEN REWRITE_TAC[get_lowerbits_def] THEN
      MATCH_REDUCE_TAC THEN CONV_TAC WORD_BITWISE_RULE) in
    STRIP_TAC THEN
    REWRITE_TAC[make_cons_ptr_def] THEN
    AP_TERM_TAC THEN
    REWRITE_TAC[lb1] THEN
    CONV_TAC SYM_CONV THEN MATCH_MP_TAC WORD_ADD_OR THEN
    FIRST_ASSUM(fun ba -> FIRST_ASSUM(fun gd ->
      MP_TAC(MATCH_MP byte_aligned_IMP_shift
        (CONJ ba gd)))) THEN
    DISCH_THEN(REPEAT_TCL CHOOSE_THEN SUBST_ALL_TAC) THEN
    REWRITE_TAC[get_lowerbits_def] THEN
    MATCH_REDUCE_TAC THEN
    REWRITE_TAC[WORD_EQ_BITS_ALT; BIT_WORD_AND; BIT_WORD_OR;
                BIT_WORD_1; BIT_WORD_0; BIT_WORD_SHL; word_bits;
                BIT_WORD_SUBWORD;
                ARITH_RULE `MIN a b = if a <= b then a else b`] THEN
    X_GEN_TAC `i:num` THEN DISCH_TAC THEN
    REWRITE_TAC[shift_length_def;
                small_shift_length_def] THEN
    REPEAT COND_CASES_TAC THEN REWRITE_TAC[] THEN
    POP_ASSUM_LIST(fun ths -> MAP_EVERY MP_TAC ths) THEN
    REWRITE_TAC[shift_length_def;
                small_shift_length_def] THEN
    ARITH_TAC)
### make_ptr_add
  (* a byte aligned word is a word shifted up by the shift, so the
     pointer it makes has its lowest bit clear and the or with one
     is an add *)
  (STRIP_TAC THEN
    REWRITE_TAC[make_ptr_def] THEN
    AP_TERM_TAC THEN
    CONV_TAC SYM_CONV THEN MATCH_MP_TAC WORD_ADD_OR THEN
    FIRST_ASSUM(fun ba -> FIRST_ASSUM(fun gd ->
      MP_TAC(MATCH_MP byte_aligned_IMP_shift
        (CONJ ba gd)))) THEN
    DISCH_THEN(REPEAT_TCL CHOOSE_THEN SUBST_ALL_TAC) THEN
    REWRITE_TAC[WORD_EQ_BITS_ALT; BIT_WORD_AND; BIT_WORD_1;
                BIT_WORD_0; BIT_WORD_SHL] THEN
    X_GEN_TAC `i:num` THEN DISCH_TAC THEN
    ASM_CASES_TAC `(i:num) = 0` THEN ASM_REWRITE_TAC[] THEN
    FIRST_ASSUM(fun gd ->
      if can (find_term (fun t ->
        try fst(dest_const t) = "good_dimindex"
        with Failure _ -> false))
        (concl gd)
      then MP_TAC gd else failwith "no") THEN
    REWRITE_TAC[good_dimindex_def;
                word_shift_def] THEN
    DISCH_THEN(DISJ_CASES_THEN SUBST_ALL_TAC) THEN
    CONV_TAC NUM_REDUCE_CONV THEN
    POP_ASSUM_LIST(fun ths -> MAP_EVERY MP_TAC ths) THEN ARITH_TAC)
### byte_aligned_bytes_in_word
  (* the alignment of a word is the slice that drops its lowest
     bits, and the bytes in a word of a good dimindex are four or
     eight, which have no bit as low as that *)
  (let LOG2_RED =
     REPEATC(CHANGED_CONV(ONCE_DEPTH_CONV(REWR_CONV LOG2) THENC
                          NUM_REDUCE_CONV THENC REWRITE_CONV[])) in
   let slice_lemma = prove
    (`!h p (w:(N)word).
        dimindex (:N) <= h + 1 /\ (!i. i < p ==> ~word_bit i w)
        ==> word_slice h p w = w`,
     REPEAT GEN_TAC THEN STRIP_TAC THEN
     REWRITE_TAC[word_slice; word_bits; WORD_EQ_BITS_ALT;
                 BIT_WORD_SHL; BIT_WORD_SUBWORD] THEN
     X_GEN_TAC `i:num` THEN DISCH_TAC THEN
     ASM_CASES_TAC `p:num <= i` THENL
      [SUBGOAL_THEN `(p + (i - p) = i) /\
                     i - p < MIN ((h + 1) - p) (dimindex (:N))`
         STRIP_ASSUME_TAC THENL
        [CONJ_TAC THENL
          [ASM_ARITH_TAC;
           REWRITE_TAC[ARITH_RULE
             `MIN a b = if a <= b then a else b`] THEN
           COND_CASES_TAC THEN ASM_ARITH_TAC];
         ASM_REWRITE_TAC[]];
       ASM_REWRITE_TAC[] THEN
       FIRST_X_ASSUM(MP_TAC o SPEC `i:num`) THEN
       ASM_SIMP_TAC[ARITH_RULE `~(p <= i) ==> (i:num) < p`]]) in
   REWRITE_TAC[good_dimindex_def; byte_aligned_def;
               aligned_def; align_def;
               bytes_in_word_def] THEN
   DISCH_THEN(DISJ_CASES_THEN
     (fun th -> SUBST1_TAC th THEN ASSUME_TAC th)) THEN
   CONV_TAC NUM_REDUCE_CONV THEN CONV_TAC LOG2_RED THEN
   MATCH_MP_TAC slice_lemma THEN
   (CONJ_TAC THENL
     [ASM_REWRITE_TAC[] THEN ARITH_TAC;
      X_GEN_TAC `i:num` THEN DISCH_TAC THEN
      SUBGOAL_THEN `i = 0 \/ i = 1 \/ i = 2` MP_TAC THENL
       [ASM_ARITH_TAC;
        DISCH_THEN(REPEAT_TCL DISJ_CASES_THEN SUBST_ALL_TAC) THEN
        REWRITE_TAC[BIT_WORD] THEN CONV_TAC NUM_REDUCE_CONV THEN
        TRY(REWRITE_TAC[]) THEN TRY(ASM_ARITH_TAC)]]))
### byte_align_mult_bytes_in_word
  (* the bytes in a word are two to the shift, so a multiple of them
     is the word shifted up, and the alignment of a word shifted up
     is the word shifted down and up again, which is the word
     itself *)
  (
   let LOG2_RED =
     REPEATC(CHANGED_CONV(ONCE_DEPTH_CONV(REWR_CONV LOG2) THENC
                          NUM_REDUCE_CONV THENC REWRITE_CONV[])) in
   let slice_shl = prove
    (`!p (w:(N)word).
        word_slice (dimindex (:N) - 1) p w =
        word_shl (word_ushr w p) p`,
     REPEAT GEN_TAC THEN
     REWRITE_TAC[word_slice; word_bits; WORD_EQ_BITS_ALT;
                 BIT_WORD_SHL; BIT_WORD_SUBWORD; BIT_WORD_USHR] THEN
     X_GEN_TAC `i:num` THEN DISCH_TAC THEN
     ASM_CASES_TAC `p:num <= i` THEN ASM_REWRITE_TAC[] THEN
     SUBGOAL_THEN
       `i - p < MIN ((dimindex (:N) - 1 + 1) - p) (dimindex (:N))`
       (fun th -> REWRITE_TAC[th]) THENL
      [REWRITE_TAC[ARITH_RULE `MIN a b = if a <= b then a else b`] THEN
       COND_CASES_TAC THEN ASM_ARITH_TAC;
       REWRITE_TAC[ARITH_RULE `p + (i - p) = (i - p) + p`]]) in
   let shl_slice = prove
    (`!p (w:(N)word).
        word_slice (dimindex (:N) - 1) p (word_shl w p) =
        word_shl w p`,
     REPEAT GEN_TAC THEN REWRITE_TAC[slice_shl] THEN
     REWRITE_TAC[WORD_EQ_BITS_ALT; BIT_WORD_SHL; BIT_WORD_USHR] THEN
     X_GEN_TAC `i:num` THEN DISCH_TAC THEN
     ASM_CASES_TAC `p:num <= i` THEN
     ASM_SIMP_TAC[ARITH_RULE `p <= i ==> (i - p) + p = i`] THEN
     ASM_REWRITE_TAC[BIT_WORD_SHL]) in
   let mul_shl = prove
    (`!p d (w:(N)word). d = 2 EXP p ==> w * n2w d = word_shl w p`,
     REPEAT GEN_TAC THEN DISCH_THEN SUBST1_TAC THEN
     REWRITE_TAC[word_shl] THEN
     GEN_REWRITE_TAC (LAND_CONV o LAND_CONV) [GSYM WORD_VAL] THEN
     REWRITE_TAC[GSYM WORD_MUL]) in
   DISCH_TAC THEN
   SUBGOAL_THEN
     `dimindex (:'a) DIV 8 = 2 EXP (LOG2 (dimindex (:'a) DIV 8))`
     ASSUME_TAC THENL
    [FIRST_ASSUM(DISJ_CASES_THEN SUBST1_TAC o
       REWRITE_RULE[good_dimindex_def]) THEN
     CONV_TAC NUM_REDUCE_CONV THEN CONV_TAC LOG2_RED THEN
     CONV_TAC NUM_REDUCE_CONV;
     ALL_TAC] THEN
   REWRITE_TAC[byte_aligned_def;
               aligned_def; align_def;
               bytes_in_word_def] THEN
   CONJ_TAC THENL
    [ALL_TAC;
     SUBST1_TAC(WORD_RULE
       `n2w (dimindex (:'a) DIV 8) * (w:'a word) =
        w * n2w (dimindex (:'a) DIV 8)`)] THEN
   FIRST_ASSUM(fun f1 -> REWRITE_TAC[MATCH_MP mul_shl f1]) THEN
   MATCH_ACCEPT_TAC shl_slice)
### LESS_EQ_num_size
  (* the same as LENGTH_n2mw_LE_num_size, with the good_dimindex
     pulled out in front, as the source states it twice *)
  (DISCH_TAC THEN REPEAT GEN_TAC THEN DISCH_TAC THEN
   FIRST_ASSUM(fun le -> FIRST_ASSUM(fun gd ->
     MATCH_ACCEPT_TAC(MATCH_MP LENGTH_n2mw_LE_num_size
                        (CONJ gd le)))))
### part_to_words_add
  (* the four kinds of part, each written at the offset and at the
     offset plus a: what is not a pointer is written the same, and
     a pointer has the shifted a added to it, which is what
     word_cond_add does *)
  (REPEAT GEN_TAC THEN STRIP_TAC THEN CASES_ON_NAME "part" THEN
   REWRITE_TAC[part_to_words_def] THEN
   CONV_TAC(TOP_DEPTH_CONV let_CONV) THEN STRIP_TAC THEN
   TRY PAIRARG_TAC THEN
   RULE_ASSUM_TRY (CONV_RULE(TOP_DEPTH_CONV let_CONV)) THEN
   EVERY_CASE_COND_TAC THEN VAR_EQ_TAC THEN
   CONV_TAC(TOP_DEPTH_CONV let_CONV) THEN
   ASM_REWRITE_TAC[] THEN
   REPEAT(CHANGED_TAC(TRY MATCH_REDUCE_TAC THEN
     REWRITE_TAC[distinctness "option"])) THEN
   REWRITE_TAC[injectivity "option"; PAIR_EQ; GSYM CONJ_ASSOC] THEN
   TRY EXISTS_EQ_TAC THEN
   REWRITE_TAC[cond_add_F; cond_add_T; MAP; GSYM MAP_o; o_DEF] THEN
   ASM_REWRITE_TAC[] THEN
   TRY(ASM_SIMP_TAC[make_ptr_add; make_cons_ptr_add;
                    byte_aligned_add; get_lowerbits_ptrbits]) THEN
   REWRITE_TAC[cond_add_F; cond_add_T] THEN
   TRY(AP_TERM_TAC THEN REWRITE_TAC[shl_add] THEN
       CONV_TAC WORD_RULE))
### parts_to_words_add
  (* the parts one after the other: this part's words by the
     theorem before this one, and the rest by the induction
     hypothesis of the two maps with this part's word put in
     (ins_cond), at the offset that the words of this part move on
     by -- which is aligned (byte_aligned_add) and the same whether
     a is added before or after it *)
  (let gen = prove
    (`!parts' m i (off:'a word) a w ws m1.
        parts_to_words c m i parts' off = SOME (w,ws) /\
        byte_aligned off /\ byte_aligned a /\ good_dimindex (:'a) /\
        backend_common_word_shift (:'a) <= shift_length c /\
        (!j. SND (lookup_mem m1 j) =
             word_cond_add c a (lookup_mem m j))
        ==> (?v vs. parts_to_words c m1 i parts' (off + a) =
                      SOME (v,vs) /\
                    MAP SND vs = MAP (word_cond_add c a) ws /\
                    SND v = word_cond_add c a w)`,
     LIST_INDUCT_TAC THEN REPEAT GEN_TAC THEN
     REWRITE_TAC[parts_to_words_def] THENL
      [STRIP_TAC THEN
       RULE_ASSUM_TAC(REWRITE_RULE[injectivity "option";
                                   PAIR_EQ]) THEN
       SPLIT_ASM_TAC THEN VAR_EQ_TAC THEN
       REWRITE_TAC[injectivity "option"; PAIR_EQ;
                   GSYM CONJ_ASSOC] THEN
       EXISTS_EQ_TAC THEN ASM_REWRITE_TAC[MAP];
       STRIP_TAC THEN
       PW_SPLIT_CALL_TAC "part_to_words" THEN
       PW_SPLIT_CALL_TAC "parts_to_words" THEN
       RULE_ASSUM_TAC(REWRITE_RULE[injectivity "option";
                                   PAIR_EQ]) THEN
       SPLIT_ASM_TAC THEN VAR_EQ_TAC THEN
       W(fun g ->
         let pt = av_find (pw_is_lhs "part_to_words") g
         and gd = av_find (hd_is "good_dimindex") g
         and sh = av_find (is_binary "<=") g
         and cond = av_find is_cond g in
         let off = last(snd(strip_comb(lhs(concl pt)))) in
         let a = el 1 (snd(strip_comb(rhs(snd(strip_forall(concl
                   cond)))))) in
         let ba_off = av_find (fun t -> hd_is "byte_aligned" t &&
                                        rand t = off) g
         and ba_a = av_find (fun t -> hd_is "byte_aligned" t &&
                                      rand t = a) g in
         MP_TAC(MATCH_MP (MATCH_MP (SPEC_ALL part_to_words_add)
           (CONJ ba_off (CONJ ba_a (CONJ gd sh))))
           (CONJ pt cond))) THEN
       DISCH_THEN(REPEAT_TCL CHOOSE_THEN STRIP_ASSUME_TAC) THEN
       W(fun g ->
         let gd = av_find (hd_is "good_dimindex") g
         and sh = av_find (is_binary "<=") g
         and cond = av_find is_cond g
         and ih = av_find is_ih g
         and pw = av_find (pw_is_lhs "parts_to_words") g in
         let body = snd(strip_forall(concl cond)) in
         let m1t = el 0 (snd(strip_comb(rand(lhs body))))
         and mt = el 0 (snd(strip_comb(rand(rhs body)))) in
         let pt = av_find (fun t -> pw_is_lhs "part_to_words" t &&
                    el 1 (snd(strip_comb(lhs t))) = mt) g
         and pt1 = av_find (fun t -> pw_is_lhs "part_to_words" t &&
                     el 1 (snd(strip_comb(lhs t))) = m1t) g in
         let off = last(snd(strip_comb(lhs(concl pt)))) in
         let a = el 1 (snd(strip_comb(rhs body))) in
         let ba_a = av_find (fun t -> hd_is "byte_aligned" t &&
                                      rand t = a) g in
         let map_eq = av_find (fun t -> is_eq t &&
                                 hd_is "MAP" (lhs t)) g in
         let len_eq = MATCH_MP len_of_map map_eq in
         let snd_eq = av_find (fun t -> is_eq t &&
                                 hd_is "SND" (lhs t)) g in
         let off2 = last(snd(strip_comb(lhs(concl pw)))) in
         let ba2 = MATCH_MP byte_aligned_add
           (CONJ gd (CONJ (av_find (fun t ->
                             hd_is "byte_aligned" t &&
                             rand t = off) g)
              (SPEC (rand(rand off2)) (GEN_ALL(CONJUNCT2(MATCH_MP
                 byte_align_mult_bytes_in_word gd)))))) in
         let cond2 = MATCH_MP ins_cond (CONJ cond snd_eq) in
         let ith = MATCH_MP (SPEC_ALL ih)
           (CONJ pw (CONJ ba2 (CONJ ba_a (CONJ gd
              (CONJ sh cond2))))) in
         REWRITE_TAC[pt1] THEN
         CONV_TAC(ONCE_DEPTH_CONV MATCH_CONV) THEN
         REWRITE_TAC[len_eq] THEN
         SUBGOAL_THEN (mk_eq(mk_binop `(+):'a word->'a word->'a word`
                               (mk_binop
                                  `(+):'a word->'a word->'a word`
                                  off a) (rand off2),
                             mk_binop `(+):'a word->'a word->'a word`
                               off2 a)) SUBST1_TAC THENL
          [CONV_TAC WORD_RULE; ALL_TAC] THEN
         MP_TAC ith THEN
         DISCH_THEN(REPEAT_TCL CHOOSE_THEN STRIP_ASSUME_TAC) THEN
         W(fun g2 ->
           let pw2 = av_find (fun t ->
             pw_is_lhs "parts_to_words" t &&
             (try rand(last(snd(strip_comb(lhs t)))) = a
              with Failure _ -> false)) g2 in
           REWRITE_TAC[pw2] THEN MATCH_REDUCE_TAC THEN
           REWRITE_TAC[distinctness "option"; injectivity "option";
                       PAIR_EQ; GSYM CONJ_ASSOC] THEN
           EXISTS_EQ_TAC THEN
           ASM_REWRITE_TAC[MAP_APPEND]))]) in
   REPEAT GEN_TAC THEN MATCH_ACCEPT_TAC(SPEC_ALL gen))
### part_to_words_IMP_build_words
  (* the four kinds of part again, where the deep embedding writes
     what the shallow one writes: the header of a bignum differs
     (hdr_bits), the pointer of a cons is the same one written out
     (make_cons_ptr_add), and the words themselves are the deep
     ones without their flags *)
  (REPEAT GEN_TAC THEN CASES_ON_NAME "p" THEN
   REWRITE_TAC[part_to_words_def; build_part_words_def] THEN
   CONV_TAC(TOP_DEPTH_CONV let_CONV) THEN STRIP_TAC THEN
   TRY PAIRARG_TAC THEN
   RULE_ASSUM_TRY (CONV_RULE(TOP_DEPTH_CONV let_CONV)) THEN
   EVERY_CASE_COND_TAC THEN VAR_EQ_TAC THEN
   CONV_TAC(TOP_DEPTH_CONV let_CONV) THEN
   ASM_SIMP_TAC[GEN_ALL hdr_bits] THEN
   EVERY_CASE_COND_TAC THEN VAR_EQ_TAC THEN
   ASM_SIMP_TAC[MAP; GSYM MAP_o; o_DEF; SND; ETA_AX;
                make_cons_ptr_add; get_lowerbits_ptrbits])
### parts_to_words_IMP_build_words
  (* the parts one after the other, with the map, the index and the
     offset that the recursion changes generalised.  The offset of
     the next part is the one of this part and the words it wrote,
     which is aligned as well (byte_aligned_add), and the map with
     this part's word put in is the function of the shallow side
     with it put in (upd_lookup) *)
  (let gen = prove
    (`!parts' c m i (off:'a word) w ws.
        parts_to_words c m i parts' off = SOME (w,ws) /\
        good_dimindex (:'a) /\ byte_aligned off /\
        backend_common_word_shift (:'a) <= shift_length c
        ==> build_words c (\j. SND (lookup_mem m j)) i parts' off =
            SOME (SND w,MAP SND ws)`,
     LIST_INDUCT_TAC THEN REPEAT GEN_TAC THEN
     REWRITE_TAC[parts_to_words_def; build_words_def] THENL
      [STRIP_TAC THEN
       RULE_ASSUM_TAC(REWRITE_RULE[injectivity "option";
                                   PAIR_EQ]) THEN
       SPLIT_ASM_TAC THEN VAR_EQ_TAC THEN
       REWRITE_TAC[MAP] THEN BETA_TAC THEN REWRITE_TAC[];
       STRIP_TAC THEN
       PW_SPLIT_CALL_TAC "part_to_words" THEN
       PW_SPLIT_CALL_TAC "parts_to_words" THEN
       RULE_ASSUM_TAC(REWRITE_RULE[injectivity "option";
                                   PAIR_EQ]) THEN
       SPLIT_ASM_TAC THEN VAR_EQ_TAC THEN
       W(fun g ->
         let pt = av_find (pw_is_lhs "part_to_words") g
         and pw = av_find (pw_is_lhs "parts_to_words") g
         and gd = av_find (hd_is "good_dimindex") g
         and ba = av_find (hd_is "byte_aligned") g
         and sh = av_find (is_binary "<=") g
         and ih = av_find is_forall g in
         let pth = MATCH_MP part_to_words_IMP_build_words
                     (CONJ pt (CONJ gd (CONJ ba sh))) in
         let off2 = last(snd(strip_comb(lhs(concl pw)))) in
         let bal = MATCH_MP byte_aligned_add
           (CONJ gd (CONJ ba (SPEC (rand(rand off2))
              (GEN_ALL(CONJUNCT2(MATCH_MP
                 byte_align_mult_bytes_in_word gd)))))) in
         let ith = MATCH_MP (SPEC_ALL ih)
                     (CONJ pw (CONJ gd (CONJ bal sh))) in
         REWRITE_TAC[pth; LENGTH_MAP; GSYM upd_lookup; ith] THEN
         MATCH_REDUCE_TAC THEN REWRITE_TAC[MAP_APPEND])]) in
   REPEAT GEN_TAC THEN MATCH_ACCEPT_TAC(SPEC_ALL gen))
### part_to_words_LENGTH
  (* the four kinds of constant part, each written as a header and
     the words of its content: a small int writes nothing, a Con
     writes its elements, a W64 at most three words, and a string
     as many as its bytes fill *)
  (REPEAT GEN_TAC THEN CASES_ON_NAME "h" THEN
   REWRITE_TAC[part_to_words_def; part_space_req_def] THEN
   CONV_TAC(TOP_DEPTH_CONV let_CONV) THEN STRIP_TAC THEN
   TRY PAIRARG_TAC THEN
   RULE_ASSUM_TRY (CONV_RULE(TOP_DEPTH_CONV let_CONV)) THEN
   EVERY_CASE_COND_TAC THEN
   RULE_ASSUM_TAC(REWRITE_RULE[NULL_EQ]) THEN VAR_EQ_TAC THEN
   ASM_REWRITE_TAC[LENGTH; LENGTH_MAP; LENGTH_write_bytes;
                   LENGTH_REPLICATE] THEN
   TRY ASM_ARITH_TAC THEN
   FIRST
    [(* a list of no elements that is not empty *)
     SOLVED(SUBGOAL_THEN `F` CONTR_TAC THEN
            ASM_MESON_TAC[LENGTH_EQ_NIL]);
     (* a number below 2 EXP 29 that is not a small int *)
     SOLVED(SUBGOAL_THEN `F` CONTR_TAC THEN
            ASM_MESON_TAC[GEN_ALL small_29]);
     (* and otherwise the words of the number, which num_size
        bounds *)
     SOLVED
      (RULE_ASSUM_TAC(REWRITE_RULE[i2mw_def; PAIR_EQ]) THEN
       SPLIT_ASM_TAC THEN VAR_EQ_TAC THEN
       FIRST_ASSUM(fun gd ->
         if not (hd_is "good_dimindex" (concl gd)) then fail() else
         MATCH_MP_TAC(MATCH_MP LESS_EQ_num_size gd)) THEN
       REWRITE_TAC[LE_REFL]);
     (* the bytes of a string, of which a word holds four or
        eight *)
     SOLVED
      (REWRITE_TAC[byte_len_def; LENGTH_explode] THEN
       FIRST_ASSUM(fun gd ->
         if not (hd_is "good_dimindex" (concl gd)) then fail() else
         STRIP_ASSUME_TAC(REWRITE_RULE[good_dimindex_def] gd)) THEN
       ASM_REWRITE_TAC[ARITH_EQ] THEN
       MP_TAC(SPECL [`8`; `strlen a'`; `4`] DIV_MONO2) THEN
       REWRITE_TAC[ARITH] THEN ARITH_TAC)])
### const_parts_to_words_good_loc
  (* the parts one after the other, with the map generalised: the
     map starts empty, where every lookup is a word (good_loc_LN),
     and what each part puts in is good as well (part_gl), so the
     invariant holds all the way along (ins_loc) *)
  (let gen = prove
    (`!parts' m i (off:'a word) y0 y1 y2.
        (!k. good_loc s (SND (lookup_mem m k))) /\
        parts_to_words c m i parts' off = SOME ((y0,y1),y2)
        ==> good_loc s y1 /\ EVERY (good_loc s o SND) y2`,
     LIST_INDUCT_TAC THEN REPEAT GEN_TAC THEN
     REWRITE_TAC[parts_to_words_def] THENL
      [STRIP_TAC THEN
       RULE_ASSUM_TAC(REWRITE_RULE[injectivity "option";
                                   PAIR_EQ]) THEN
       SPLIT_ASM_TAC THEN VAR_EQ_TAC THEN
       W(fun g ->
         let inv = av_find is_forall g in
         let eq = av_find (fun t -> is_eq t &&
                             hd_is "lookup_mem" (lhs t)) g in
         let k = last(snd(strip_comb(lhs(concl eq)))) in
         REWRITE_TAC[ALL; o_DEF] THEN
         ACCEPT_TAC(REWRITE_RULE[eq; SND] (SPEC k inv)));
       STRIP_TAC THEN
       PW_SPLIT_CALL_TAC "part_to_words" THEN
       TRY(W(fun g ->
         let pt = av_find (pw_is_lhs "part_to_words") g in
         CASES_ON_TAC (fst(dest_pair(rand(rhs(concl pt))))))) THEN
       PW_SPLIT_CALL_TAC "parts_to_words" THEN
       RULE_ASSUM_TAC(REWRITE_RULE[injectivity "option";
                                   PAIR_EQ]) THEN
       SPLIT_ASM_TAC THEN VAR_EQ_TAC THEN
       W(fun g ->
         let inv = av_find is_forall g
         and pt = av_find (pw_is_lhs "part_to_words") g
         and pw = av_find (pw_is_lhs "parts_to_words") g in
         let gl = MATCH_MP (GEN_ALL part_gl) (CONJ inv pt) in
         let body = snd(strip_forall(concl inv)) in
         let st = el 0 (snd(strip_comb body))
         and sndf = rator(rand body) in
         let mp = el 1 (snd(strip_comb(lhs(concl pw)))) in
         let tm = mk_forall(`k:num`,
                    list_mk_icomb "good_loc"
                      [st; mk_comb(sndf,
                             list_mk_icomb "lookup_mem"
                               [mp; `k:num`])]) in
         (SUBGOAL_THEN tm ASSUME_TAC THENL
           [GEN_TAC THEN REWRITE_TAC[lookup_mem_insert] THEN
            COND_CASES_TAC THEN
            ASM_REWRITE_TAC[SND; CONJUNCT1 gl];
            ALL_TAC]) THEN
         W(fun g2 ->
           let inv2 = av_find (fun t -> t = tm) g2
           and ih = av_find is_ih g2 in
           MP_TAC(MATCH_MP ih (CONJ inv2 pw)) THEN MP_TAC gl)) THEN
       REWRITE_TAC[ALL_APPEND] THEN
       REPEAT STRIP_TAC THEN ASM_REWRITE_TAC[]]) in
   REWRITE_TAC[const_parts_to_words_def] THEN
   ASM_MESON_TAC[gen; good_loc_LN])
### const_parts_to_words_LENGTH
  (* the parts one after the other, each counted by
     part_to_words_LENGTH, with the map, the index and the offset
     that the recursion changes generalised *)
  (let sum_cons = prove
    (`!f h t. SUM (MAP f (CONS h t)) = f h + SUM (MAP f t)`,
     REWRITE_TAC[MAP; SUM_DEF; ITLIST]) in
   let gen = prove
    (`!parts' c m i (off:'a word) w ws.
        parts_to_words c m i parts' off = SOME (w,ws) /\
        good_dimindex (:'a)
        ==> LENGTH ws <= SUM (MAP part_space_req parts')`,
     LIST_INDUCT_TAC THEN REPEAT GEN_TAC THEN
     REWRITE_TAC[parts_to_words_def; sum_cons] THENL
      [STRIP_TAC THEN
       RULE_ASSUM_TAC(REWRITE_RULE[injectivity "option";
                                   PAIR_EQ]) THEN
       SPLIT_ASM_TAC THEN VAR_EQ_TAC THEN
       REWRITE_TAC[LENGTH; LE_0];
       STRIP_TAC THEN EVERY_CASE_TAC THEN
       RULE_ASSUM_TAC(REWRITE_RULE[injectivity "option";
                                   PAIR_EQ]) THEN
       SPLIT_ASM_TAC THEN VAR_EQ_TAC THEN
       REWRITE_TAC[LENGTH_APPEND] THEN
       MATCH_MP_TAC LE_ADD2 THEN CONJ_TAC THENL
        [FIRST_ASSUM(fun pt ->
           if not (hd_is "part_to_words" (lhs(concl pt)))
           then fail() else
           FIRST_ASSUM(fun gd ->
             if not (hd_is "good_dimindex" (concl gd)) then fail()
             else
             MATCH_ACCEPT_TAC(MATCH_MP part_to_words_LENGTH
               (CONJ pt gd))));
         FIRST_ASSUM(fun ih ->
           if not (is_forall (concl ih)) then fail() else
           FIRST_ASSUM(fun pw ->
             if not (hd_is "parts_to_words" (lhs(concl pw))) then
               fail() else
             FIRST_ASSUM(fun gd ->
               if not (hd_is "good_dimindex" (concl gd)) then
                 fail() else
               MATCH_ACCEPT_TAC(MATCH_MP (SPEC_ALL ih)
                 (CONJ pw gd)))))]]) in
   REWRITE_TAC[const_parts_to_words_def] THEN
   MATCH_ACCEPT_TAC(SPEC_ALL gen))
### word_xor_set_byte
  (let bsa = prove
    (`!h l (w:(N)word) j. j < dimindex (:N)
        ==> (bit j (word_slice_alt h l w) <=>
             l <= j /\ j < h /\ bit j w)`,
     REPEAT GEN_TAC THEN DISCH_TAC THEN
     REWRITE_TAC[word_slice_alt; BIT_WORD_SHL; BIT_WORD_SUBWORD] THEN
     REWRITE_TAC[ARITH_RULE `MIN a b = if a <= b then a else b`] THEN
     ASM_CASES_TAC `l:num <= j` THEN ASM_REWRITE_TAC[] THEN
     ASM_SIMP_TAC[ARITH_RULE `l <= j ==> l + j - l = j`] THEN
     COND_CASES_TAC THEN
     ASM_CASES_TAC `bit j (w:(N)word)` THEN ASM_REWRITE_TAC[] THEN
     ARITH_NO_BIT_TAC) in
   let bsb0 = prove
    (`!(a:(N)word) b (h:(N)word) bb j. j < dimindex (:N)
        ==> (bit j (set_byte a b h bb) <=>
             (if byte_index a bb <= j /\ j < byte_index a bb + 8
              then bit (j - byte_index a bb) b else bit j h))`,
     REPEAT GEN_TAC THEN DISCH_TAC THEN
     REWRITE_TAC[set_byte_def] THEN
     CONV_TAC(TOP_DEPTH_CONV let_CONV) THEN
     ASM_SIMP_TAC[BIT_WORD_OR; bsa; BIT_WORD_SHL; BIT_WORD_ZX;
                  DIMINDEX_8] THEN
     MP_TAC(REWRITE_RULE[DIMINDEX_8]
       (ISPECL [`b:(8)word`; `j - byte_index (a:(N)word) bb`]
          BIT_TRIVIAL)) THEN
     ASM_CASES_TAC `byte_index (a:(N)word) bb <= j` THEN
     ASM_CASES_TAC `j < byte_index (a:(N)word) bb + 8` THEN
     ASM_CASES_TAC `bit j (h:(N)word)` THEN
     ASM_CASES_TAC
       `bit (j - byte_index (a:(N)word) bb) (b:(8)word)` THEN
     ASM_REWRITE_TAC[] THEN ARITH_NO_BIT_TAC) in
   let gen = prove
    (`!(a:(N)word) h1 h2 w1 w2 bb.
        word_xor (set_byte a h1 w1 bb) (set_byte a h2 w2 bb) =
        set_byte a (word_xor h1 h2) (word_xor w1 w2) bb`,
     REPEAT GEN_TAC THEN
     REWRITE_TAC[WORD_EQ_BITS_ALT] THEN
     X_GEN_TAC `i:num` THEN DISCH_TAC THEN
     ASM_SIMP_TAC[BIT_WORD_XOR; bsb0] THEN
     COND_CASES_TAC THEN
     TRY(FIRST_X_ASSUM(CONJUNCTS_THEN ASSUME_TAC)) THEN
     ASM_SIMP_TAC[BIT_WORD_XOR; DIMINDEX_8;
                  ARITH_RULE `b <= i /\ i < b + 8 ==> i - b < 8`]) in
   MATCH_ACCEPT_TAC gen)
### xor_bytes_length
  (* the xor of two lists of bytes is as long as the second and at
     least as long as the first, by the induction of the
     definition; the case of the xor of the tails is what
     EVERY_CASE_TAC splits *)
  (let xb = xor_bytes_def in
   LIST_INDUCT_TAC THENL
    [REPEAT GEN_TAC THEN
     GEN_REWRITE_TAC (LAND_CONV o LAND_CONV) [xb] THEN
     MATCH_REDUCE_TAC THEN REWRITE_TAC[injectivity "option"] THEN
     DISCH_THEN(SUBST1_TAC o SYM) THEN REWRITE_TAC[LENGTH; LE_0];
     (fun (asl,w as gl) ->
        let ysv = fst(dest_forall w) in
        (X_GEN_TAC ysv THEN
         STRUCT_CASES_TAC(ISPEC ysv list_CASES_v)) gl) THEN
     GEN_TAC THEN
     GEN_REWRITE_TAC (LAND_CONV o LAND_CONV) [xb] THEN
     EVERY_CASE_TAC THEN
     REWRITE_TAC[distinctness "option"; injectivity "option"] THEN
     TRY(DISCH_THEN(SUBST1_TAC o SYM)) THEN
     REWRITE_TAC[LENGTH; LE_SUC; SUC_INJ] THEN
     FIRST_ASSUM(fun st -> FIRST_ASSUM(fun ih ->
       ACCEPT_TAC(MATCH_MP ih st)))])
### xor_bytes_drop
  (* dropping from both lists drops from the xor as well, by the
     induction of the definition *)
  (let xb = xor_bytes_def in
   SUBGOAL_THEN
     `!xs n ys zs. xor_bytes xs ys = SOME zs
        ==> xor_bytes (DROP n xs) (DROP n ys) = SOME (DROP n zs)`
     (fun th -> REPEAT GEN_TAC THEN MATCH_ACCEPT_TAC th) THEN
   LIST_INDUCT_TAC THENL
    [REPEAT GEN_TAC THEN
     GEN_REWRITE_TAC (LAND_CONV o LAND_CONV) [xb] THEN
     MATCH_REDUCE_TAC THEN REWRITE_TAC[injectivity "option"] THEN
     DISCH_THEN(SUBST1_TAC o SYM) THEN
     REWRITE_TAC[DROP] THEN
     GEN_REWRITE_TAC LAND_CONV [xb] THEN
     MATCH_REDUCE_TAC THEN REWRITE_TAC[];
     GEN_TAC THEN
     (fun (asl,w as gl) ->
        let ysv = fst(dest_forall w) in
        (X_GEN_TAC ysv THEN
         STRUCT_CASES_TAC(ISPEC ysv list_CASES_v)) gl) THEN
     GEN_TAC THEN
     GEN_REWRITE_TAC (LAND_CONV o LAND_CONV) [xb] THEN
     EVERY_CASE_TAC THEN
     REWRITE_TAC[distinctness "option"; injectivity "option"] THEN
     TRY(DISCH_THEN(SUBST1_TAC o SYM)) THEN
     REWRITE_TAC[DROP] THEN
     COND_CASES_TAC THEN ASM_REWRITE_TAC[] THENL
      [GEN_REWRITE_TAC LAND_CONV [xb] THEN
       ASM_REWRITE_TAC[] THEN MATCH_REDUCE_TAC THEN REWRITE_TAC[];
       FIRST_ASSUM(fun st -> FIRST_ASSUM(fun ih ->
         MATCH_ACCEPT_TAC(MATCH_MP ih st)))]])
### data_to_word_memoryProof_xor_bytes_xor_words
  (* the zeroes of make_zeros are as many as the lemma above asks
     for, and they are all zero *)
  (let all_zero = prove
    (`!n. ALL (\w. w = ((n2w 0):(N)word)) (REPLICATE n (n2w 0))`,
     INDUCT_TAC THEN ASM_REWRITE_TAC[REPLICATE; ALL]) in
   STRIP_TAC THEN MATCH_MP_TAC xor_bytes_xor_words THEN
   ASM_REWRITE_TAC[make_zeros_def; all_zero;
                   LENGTH_REPLICATE])
### xor_bytes_word_list
  (* the words of the two byte lists are as many as the zeroes, so
     xor_words_word_list is about them, and the xor of the two is
     the one of the result by xor_bytes_xor_words *)
  (REPEAT GEN_TAC THEN STRIP_TAC THEN
   ONCE_REWRITE_TAC[GSYM (ISPECL
     [`make_zeros vals1:('a word)list`; `vals1:(word8)list`;
      `be':bool`] LENGTH_write_bytes)] THEN
   MATCH_MP_TAC xor_words_word_list THEN
   EXISTS_TAC `write_bytes vals2 (make_zeros vals2:('a word)list)
                 be'` THEN
   ASM_REWRITE_TAC[LENGTH_write_bytes] THEN
   MATCH_MP_TAC data_to_word_memoryProof_xor_bytes_xor_words THEN
   ASM_REWRITE_TAC[])
### xor_bytes_word_list_alias
  (* and the same where the two lists are one *)
  (REPEAT GEN_TAC THEN STRIP_TAC THEN
   ONCE_REWRITE_TAC[GSYM (ISPECL
     [`make_zeros vals1:('a word)list`; `vals1:(word8)list`;
      `be':bool`] LENGTH_write_bytes)] THEN
   MATCH_MP_TAC xor_words_word_list_alias THEN
   ASM_REWRITE_TAC[LENGTH_write_bytes] THEN
   MATCH_MP_TAC data_to_word_memoryProof_xor_bytes_xor_words THEN
   ASM_REWRITE_TAC[])
### el_length_Bytes
  (REWRITE_TAC[bytes_def] THEN
   CONV_TAC(ONCE_DEPTH_CONV let_CONV) THEN
   REWRITE_TAC[el_length_def; LENGTH_write_bytes])
### blocks_unique_insert_ByteArray2
  (* a ByteArray holds no value of the language, so the insert adds
     no Block *)
  (let li = prove
    (`!k1 k2 v (t:(A)spt) y.
        (sptree_lookup k1 (sptree_insert k2 v t) = SOME y) <=>
        (k1 = k2 /\ v = y) \/
        (~(k1 = k2) /\ sptree_lookup k1 t = SOME y)`,
     REPEAT GEN_TAC THEN REWRITE_TAC[lookup_insert] THEN
     COND_CASES_TAC THEN
     ASM_REWRITE_TAC[injectivity "option"] THEN CONV_TAC TAUT) in
   let inc = prove
    (`!refs p2 fl2 res_vals s t a q.
        Block t a q IN
          all_vs (insert p2 (ByteArray fl2 res_vals) refs) s ==>
        Block t a q IN all_vs refs s`,
     REWRITE_TAC[all_vs_def; IN_UNION; IN_ELIM_THM; li;
                 distinctness "bvlSem_ref";
                 injectivity "bvlSem_ref"] THEN MESON_TAC[]) in
   REWRITE_TAC[blocks_unique_def] THEN DISCH_TAC THEN
   REPEAT GEN_TAC THEN STRIP_TAC THEN FIRST_ASSUM MATCH_MP_TAC THEN
   REPEAT CONJ_TAC THEN ASM_MESON_TAC[inc])
### compoare_aux_append_xs
  (* the same character in front of both strings and the index one
     further on compare the same characters: the induction is on the
     length that is left to compare, and the premise about the two
     lengths is not needed *)
  (let shift_lemma = prove
    (`!len start r (zz:char) l1 l2.
        compare_aux (implode (CONS zz l1)) (implode (CONS zz l2)) r
          (start + 1) len =
        compare_aux (implode l1) (implode l2) r start len`,
     let el_suc = prove
      (`!n h (t:A list). EL (n + 1) (CONS h t) = EL n t`,
       REWRITE_TAC[GSYM ADD1; EL; TL]) in
     INDUCT_TAC THEN REPEAT GEN_TAC THEN
     ONCE_REWRITE_TAC[compare_aux_def] THEN
     REWRITE_TAC[NOT_SUC; SUC_SUB1; strsub_def; el_suc] THEN
     ASM_REWRITE_TAC[]) in
   REPEAT GEN_TAC THEN DISCH_TAC THEN MATCH_ACCEPT_TAC shift_lemma)
### compoare_aux_append_ys
  (* and the same of the shorter second string *)
  (let shift_lemma = prove
    (`!len start r (zz:char) l1 l2.
        compare_aux (implode (CONS zz l1)) (implode (CONS zz l2)) r
          (start + 1) len =
        compare_aux (implode l1) (implode l2) r start len`,
     let el_suc = prove
      (`!n h (t:A list). EL (n + 1) (CONS h t) = EL n t`,
       REWRITE_TAC[GSYM ADD1; EL; TL]) in
     INDUCT_TAC THEN REPEAT GEN_TAC THEN
     ONCE_REWRITE_TAC[compare_aux_def] THEN
     REWRITE_TAC[NOT_SUC; SUC_SUB1; strsub_def; el_suc] THEN
     ASM_REWRITE_TAC[]) in
   REPEAT GEN_TAC THEN DISCH_TAC THEN MATCH_ACCEPT_TAC shift_lemma)
### compare_same
  (* the first characters are the same, so the comparison steps over
     them: the index goes up by one, which the shift of
     compoare_aux_append_xs takes off again, and the lengths are one
     less on both sides *)
  (let shift_lemma = prove
    (`!len start r (zz:char) l1 l2.
        compare_aux (implode (CONS zz l1)) (implode (CONS zz l2)) r
          (start + 1) len =
        compare_aux (implode l1) (implode l2) r start len`,
     let el_suc = prove
      (`!n h (t:A list). EL (n + 1) (CONS h t) = EL n t`,
       REWRITE_TAC[GSYM ADD1; EL; TL]) in
     INDUCT_TAC THEN REPEAT GEN_TAC THEN
     ONCE_REWRITE_TAC[compare_aux_def] THEN
     REWRITE_TAC[NOT_SUC; SUC_SUB1; strsub_def; el_suc] THEN
     ASM_REWRITE_TAC[]) in
   let first_eq = prove
    (`!r (zz:char) l1 l2 n.
        compare_aux (implode (CONS zz l1)) (implode (CONS zz l2)) r 0
          (SUC n) =
        compare_aux (implode l1) (implode l2) r 0 n`,
     REPEAT GEN_TAC THEN
     GEN_REWRITE_TAC LAND_CONV [compare_aux_def] THEN
     REWRITE_TAC[NOT_SUC; SUC_SUB1; strsub_def; EL; HD;
                 char_lt; LT_REFL; shift_lemma]) in
   REWRITE_TAC[mlstring_compare_def; strlen_def;
               LENGTH; LT_SUC; first_eq])
### str_cmp_cons
  (* each of the eight comparisons is the one of mlstring_compare,
     which compare_same takes off the first character, or a
     comparison of the lengths, which are one less *)
  (REWRITE_TAC[str_cmp_def] THEN
   CASES_ON_NAME "b" THEN CASES_ON_NAME "cmp" THEN
   MATCH_REDUCE_TAC THEN
   REWRITE_TAC[mlstring_lt_def; mlstring_le_def;
               mlstring_gt_def; mlstring_ge_def;
               fast_lt_def; fast_le_def;
               fast_gt_def; fast_ge_def;
               compare_same; strlen_def;
               LENGTH; SUC_INJ; LT_SUC; LE_SUC;
               GT; GE; ARITH_RULE `SUC m >= SUC n <=> m >= n`;
               ARITH_RULE `SUC m > SUC n <=> m > n`])
### MIN_SUC_SUC
  (ARITH_TAC)
### v_inv_related_lemma
  (* the attempt: the proof of the source names v_inv_def,
     small_int_def, ADDR_APPLY_def, gc_related_def, ADDR_MAP_def,
     Word64Rep_def.  What is here rewrites with them and closes by
     arithmetic, and the cheat is behind it until the proof is
     written.  A MESON over them is what the next round adds; it
     costs a load ten minutes to have it in every attempt and it
     closed none of them *)
  (ATTEMPT_TAC 2
    (REPEAT GEN_TAC THEN REPEAT STRIP_TAC THEN
     ASM_REWRITE_TAC[v_inv_def; small_int_def; ADDR_APPLY_def;
       gc_related_def; ADDR_MAP_def; Word64Rep_def] THEN
     TRY ASM_ARITH_TAC))
### bc_ref_inv_related
  (* the arms of the invariant, the step over the collection and
     v_inv_related for the values of a block are above the
     statement (tools/overrides.py): the lemmas about a
     collection of the heap share them.  What is left is which
     arm it is, and that the two maps of the new invariant are
     the old ones after the map of the collection *)
  (STRIP_TAC THEN
  (* the key has an address and the references a value, or the
     invariant does not hold of them *)
  NAMED_CASES_TAC (cake_as_vars (fun () ->
    `FLOOKUP (f:(num,num)fmap) n`)) [[]; ["x"]] THEN
  NAMED_CASES_TAC (cake_as_vars (fun () ->
    `sptree_lookup n (refs:((dataSem_v)bvlSem_ref)spt)`))
    [[]; ["rv"]] THEN
  TRY (SOLVED (FIRST_X_ASSUM (fun inv ->
    if not (hd_is "bc_ref_inv" (concl inv)) then fail() else
    MP_TAC (REWRITE_RULE[bc_ref_inv_def] inv)) THEN
    ASM_REWRITE_TAC[] THEN MATCH_REDUCE_TAC THEN
    CONV_TAC(TOP_DEPTH_CONV UNWIND_CONV) THEN REWRITE_TAC[])) THEN
  (* the key is in the old map and its address in the one of the
     collection *)
  SUBGOAL_THEN (cake_as_vars (fun () ->
    `(n:num) IN FDOM (f:(num,num)fmap) /\ FAPPLY f n = x`))
    STRIP_ASSUME_TAC THENL
   [FIRST_ASSUM (fun lk ->
      if not (hd_is "FLOOKUP" (lhand (concl lk))) then fail() else
      MP_TAC (REWRITE_RULE[FLOOKUP_DEF] lk)) THEN
    COND_CASES_TAC THEN
    ASM_REWRITE_TAC[distinctness "option"; injectivity "option"];
    ALL_TAC] THEN
  (* so the new map takes the key to the collected address *)
  SUBGOAL_THEN (cake_as_vars (fun () ->
    `FLOOKUP ((g:(num,num)fmap) f_o_f (f:(num,num)fmap)) (n:num) =
     SOME (FAPPLY g x)`))
    ASSUME_TAC THENL
   [ASM_REWRITE_TAC[FLOOKUP_f_o_f];
    ALL_TAC] THEN
  (* and the addresses that the arms speak of are the collected
     ones *)
  FIRST_ASSUM (fun eq ->
    let c = concl eq in
    if not (is_eq c) || not (hd_is "fmap_apply" (lhand c))
    then fail() else RULE_ASSUM_TRY (REWRITE_RULE[eq])) THEN
  (* the arm of the invariant is the one of the value that the
     references hold *)
  NAMED_CASES_TAC (cake_as_vars (fun () ->
    `rv:(dataSem_v)bvlSem_ref`))
    [["ys"]; ["flag"; "bs"]; ["ev"; "vv"];
     ["tg"; "fin"; "ll"; "cc"; "rr"]] THEN
  USE_ARM THEN
  (* the arm with a let: the count of the words of a byte array *)
  RULE_ASSUM_TRY (CONV_RULE(TOP_DEPTH_CONV let_CONV)) THEN
  TRY (CONV_TAC(TOP_DEPTH_CONV let_CONV)) THEN
  SPLIT_ASM_TAC THEN
  TRY (FIRST_X_ASSUM (fun ex ->
    if not (is_exists (concl ex)) then fail() else
    STRIP_ASSUME_TAC ex)) THEN
  REPEAT CONJ_TAC THEN TRY (FIRST_ASSUM ACCEPT_TAC) THEN
  (* the element of the new heap is the old one with its pointers
     mapped *)
  TRY (W(fun gl ->
    let lk = the_asm (fun c -> is_eq c &&
               hd_is "FLOOKUP" (lhand c) &&
               hd_is "f_o_f" (lhand (lhand c))) gl in
    let ap = rator (rand (rand (concl lk))) in
    let hl = the_asm (fun c -> is_eq c &&
               hd_is "heap_lookup" (lhand c)) gl in
    let blk = rand (rand (concl hl)) in
    let z = last (snd (strip_comb blk)) in
    if hd_is "ThunkBlock" blk
    then EXISTS_TAC (list_mk_icomb "ADDR_APPLY" [ap; z])
    else if hd_is "Bytes" blk then fail()
    else EXISTS_TAC (list_mk_icomb "ADDR_MAP" [ap; z]))) THEN
  REPEAT CONJ_TAC THEN TRY (FIRST_ASSUM ACCEPT_TAC) THEN
  (* its address *)
  TRY (SOLVED
        (REWRITE_TAC[RefBlock_def; BlockRep_def; ThunkBlock_def;
                     bytes_def] THEN
         TRY (CONV_TAC(TOP_DEPTH_CONV let_CONV)) THEN
         MOVE THEN
         ASM_REWRITE_TAC[addr1; ADDR_MAP_def;
           data_to_word_memoryProof_LENGTH_ADDR_MAP])) THEN
  (* the values of the elements of a block *)
  TRY (SOLVED
        (MOVE THEN
         REWRITE_TAC[EVERY2_ADDR_MAP] THEN
         FIRST_X_ASSUM (fun e2 ->
           if not (hd_is "ALL2" (concl e2)) then fail() else
           MP_TAC e2) THEN
         MATCH_MP_TAC EVERY2_IMP_EVERY2 THEN
         CONV_TAC(TOP_DEPTH_CONV BETA_CONV) THEN
         REPEAT STRIP_TAC THEN
         USE_V_REL)) THEN
  (* and the value of a thunk *)
  TRY (SOLVED (MOVE THEN USE_V_REL)) THEN
  (* the cell of a block that is not finalised is no timestamp's
     cell, and the map of the collection is injective on its
     domain, so the collected cell is none either *)
  DISCH_TAC THEN
  FIRST_X_ASSUM (fun imp ->
    let c = concl imp in
    if not (is_imp c) then fail() else
    MP_TAC (MATCH_MP imp (ASSUME (lhand c)))) THEN
  REWRITE_TAC[IN_IMAGE; CONJUNCT1 f_o_f_DEF; IN_ELIM_THM] THEN
  REPEAT STRIP_TAC THEN
  FIRST_X_ASSUM (fun no ->
    let c = concl no in
    if not (is_neg c) || not (is_exists (rand c)) then fail() else
    MP_TAC no) THEN
  REWRITE_TAC[] THEN
  W(fun gl ->
    let eq = the_asm (fun c -> is_eq c &&
               hd_is "fmap_apply" (lhand c) &&
               hd_is "fmap_apply" (rand c) &&
               hd_is "f_o_f" (lhand (rand c))) gl in
    EXISTS_TAC (rand (rand (concl eq)))) THEN
  CONJ_TAC THEN TRY (FIRST_ASSUM ACCEPT_TAC) THEN
  FIRST_ASSUM (fun gc ->
    if not (hd_is "gc_related" (concl gc)) then fail() else
    MATCH_MP_TAC (MATCH_MP G_INJ gc)) THEN
  REPEAT CONJ_TAC THEN TRY (FIRST_ASSUM ACCEPT_TAC) THEN
  ASM_SIMP_TAC[FAPPLY_f_o_f])
### gc_heap_inline_rel_v_inv_lemma
  (* the attempt: the proof of the source names v_inv_def,
     small_int_def, ThunkBlock_def,
     LIST_REL_gc_heap_inline_DataElement, Word64Rep_def,
     BlockRep_def.  What is here rewrites with them and closes by
     arithmetic, and the cheat is behind it until the proof is
     written.  A MESON over them is what the next round adds; it
     costs a load ten minutes to have it in every attempt and it
     closed none of them *)
  (ATTEMPT_TAC 2
    (REPEAT GEN_TAC THEN REPEAT STRIP_TAC THEN
     ASM_REWRITE_TAC[v_inv_def; small_int_def; ThunkBlock_def;
       LIST_REL_gc_heap_inline_DataElement; Word64Rep_def;
       BlockRep_def] THEN
     TRY ASM_ARITH_TAC))
### bc_stack_ref_inv_gc_inline
  (* the steps over the relation of the two heaps are above the
     statement (tools/overrides.py), with what reaches a
     reference.  The two maps of the invariant are the same
     ones: what changes is the heap, and the addresses that
     hold data are the same in both
     (gc_heap_inline_rel_heap_lookup) *)
  (STRIP_TAC THEN
   FIRST_X_ASSUM (fun gi ->
     if not (hd_is "gc_inline" (concl gi)) then fail() else
     STRIP_ASSUME_TAC (REWRITE_RULE[gc_inline_def] gi)) THEN
   FIRST_X_ASSUM (fun inv ->
     if not (hd_is "bc_stack_ref_inv" (concl inv)) then fail() else
     STRIP_ASSUME_TAC (REWRITE_RULE[bc_stack_ref_inv_def] inv)) THEN
   REWRITE_TAC[bc_stack_ref_inv_def] THEN
   W(fun gl ->
     let sub p = rand (lhand (concl (the_asm (fun c ->
       hd_is "SUBSET" c && hd_is p (rand c)) gl))) in
     EXISTS_TAC (sub "domain") THEN EXISTS_TAC (sub "all_ts")) THEN
   (* the addresses that hold data are the same in the two heaps *)
   W(fun gl ->
     let lr = the_asm (fun c -> hd_is "ALL2" c &&
                hd_is "gc_heap_inline_rel"
                  (el 0 (snd (strip_comb c)))) gl in
     RULE_ASSUM_TRY (REWRITE_RULE
       [MATCH_MP gc_heap_inline_rel_heap_lookup lr])) THEN
   REPEAT CONJ_TAC THEN TRY (FIRST_ASSUM ACCEPT_TAC) THENL
    [(* the roots of the new heap are the old ones' partners, and
        v_inv survives the relation *)
         (REWRITE_TAC[LIST_REL_EL_EQN] THEN
          RULE_ASSUM_TRY (REWRITE_RULE[LIST_REL_EL_EQN]) THEN
          SPLIT_ASM_TAC THEN
          CONJ_TAC THENL
           [ASM_MESON_TAC[];
            ALL_TAC] THEN
          X_GEN_TAC `i:num` THEN DISCH_TAC THEN
          CONV_TAC(TOP_DEPTH_CONV BETA_CONV) THEN
          AT_I "v_inv" THEN AT_I "gc_inline_rel" THEN
          RULE_ASSUM_TRY (CONV_RULE(TOP_DEPTH_CONV BETA_CONV)) THEN
          SURVIVES);
     (* and the invariant of a reference that the stack reaches *)
     X_GEN_TAC `m:num` THEN STRIP_TAC THEN
     FIRST_ASSUM (fun bri ->
       let b = snd (strip_forall (concl bri)) in
       if not (is_imp b) || not (hd_is "bc_ref_inv" (rand b))
       then fail() else MP_TAC (SPEC `m:num` bri)) THEN
     (ANTS_TAC THENL [ASM_REWRITE_TAC[]; ALL_TAC]) THEN
     DISCH_TAC THEN
     (* which arm of the invariant it is *)
     NAMED_CASES_TAC (cake_as_vars (fun () ->
       `FLOOKUP (f:(num,num)fmap) (m:num)`)) [[]; ["x"]] THEN
     NAMED_CASES_TAC (cake_as_vars (fun () ->
       `sptree_lookup m (refs:((dataSem_v)bvlSem_ref)spt)`))
       [[]; ["rv"]] THEN
     TRY (SOLVED (FIRST_X_ASSUM (fun inv ->
       if not (hd_is "bc_ref_inv" (concl inv)) then fail() else
       MP_TAC (REWRITE_RULE[bc_ref_inv_def] inv)) THEN
       ASM_REWRITE_TAC[] THEN MATCH_REDUCE_TAC THEN
       CONV_TAC(TOP_DEPTH_CONV UNWIND_CONV) THEN REWRITE_TAC[])) THEN
     NAMED_CASES_TAC (cake_as_vars (fun () ->
       `rv:(dataSem_v)bvlSem_ref`))
       [["ys"]; ["flag"; "bs"]; ["ev"; "vv"];
        ["tg"; "fin"; "ll"; "cc"; "rr"]] THEN
     USE_ARM THEN
     SPLIT_ASM_TAC THEN
     TRY (FIRST_X_ASSUM (fun ex ->
       if not (is_exists (concl ex)) then fail() else
       STRIP_ASSUME_TAC ex)) THEN
     RULE_ASSUM_TRY (CONV_RULE(TOP_DEPTH_CONV let_CONV)) THEN
     TRY (CONV_TAC(TOP_DEPTH_CONV let_CONV)) THEN
     REPEAT CONJ_TAC THEN TRY (FIRST_ASSUM ACCEPT_TAC) THEN
     MOVE_INLINE THEN
     (* a one-element list on the one side is one on the other *)
     TRY (W(fun gl ->
       let lr = the_asm (fun c -> hd_is "ALL2" c &&
                  hd_is "gc_inline_rel"
                    (el 0 (snd (strip_comb c)))) gl in
       let args = snd (strip_comb (concl lr)) in
       if not (hd_is "CONS" (el 1 args)) then fail() else
       CASES_ON_TAC (el 2 args))) THEN
     RULE_ASSUM_TRY (REWRITE_RULE[ALL2_DEF; HD; TL;
                                  NOT_CONS_NIL]) THEN
     TRY (FIRST_ASSUM CONTR_TAC) THEN
     SPLIT_ASM_TAC THEN VAR_EQ_TAC THEN
     (* the witness is what the relation gives for the element *)
     TRY (W(fun (asl,w as gl) ->
       let nh = the_asm (fun c -> is_eq c &&
                  hd_is "heap_lookup" (lhand c) &&
                  can (fun t -> hd_is "DataElement" (rand t))
                    (rand c)) gl in
       let ys2 = el 0 (snd (strip_comb (rand (rand (concl nh))))) in
       let v = fst (dest_exists w) in
       if type_of v = type_of ys2 then EXISTS_TAC ys2
       else EXISTS_TAC (lhand ys2))) THEN
     REPEAT CONJ_TAC THEN TRY (FIRST_ASSUM ACCEPT_TAC) THEN
     (* the element at the address *)
     W(fun (asl,w) ->
       if not (is_eq w && hd_is "heap_lookup" (lhand w)) then ALL_TAC
       else
        (REWRITE_TAC[RefBlock_def; BlockRep_def; ThunkBlock_def;
                     bytes_def] THEN
         TRY (CONV_TAC(TOP_DEPTH_CONV let_CONV)) THEN
         TRY (FIRST_ASSUM (fun lr ->
           if not (hd_is "ALL2" (concl lr)) then fail() else
           SUBST1_TAC (SYM (MATCH_MP LIST_REL_LENGTH lr)))) THEN
         ASM_REWRITE_TAC[])) THEN
     (* the values of the elements of a block *)
     W(fun (asl,w) -> if not (hd_is "ALL2" w) then ALL_TAC else
          (REWRITE_TAC[LIST_REL_EL_EQN] THEN
            RULE_ASSUM_TRY (REWRITE_RULE[LIST_REL_EL_EQN]) THEN
            SPLIT_ASM_TAC THEN
            REPEAT CONJ_TAC THEN
            TRY (SOLVED (POP_ASSUM_LIST (fun l ->
              MAP_EVERY ASSUME_TAC (filter
                (fun th -> let c = concl th in
                   hd_is "<" c ||
                   (is_eq c && (hd_is "LENGTH" (lhand c) ||
                                hd_is "LENGTH" (rand c)))) l)) THEN
              ASM_ARITH_TAC)) THEN
            X_GEN_TAC `i:num` THEN DISCH_TAC THEN
            CONV_TAC(TOP_DEPTH_CONV BETA_CONV) THEN
            AT_I "v_inv" THEN AT_I "gc_inline_rel" THEN
            RULE_ASSUM_TRY (CONV_RULE(TOP_DEPTH_CONV BETA_CONV)) THEN
            SURVIVES)) THEN
     (* and the value of a thunk *)
     W(fun (asl,w) ->
       if not (hd_is "v_inv" w) then ALL_TAC else SURVIVES)])
### bc_stack_ref_inv_gc_related_roots_heap
  (* the two maps of the new invariant are the old ones composed
     with the map of the collection (f_o_f, whose domain and whose
     application are f_o_f_DEF and FAPPLY_f_o_f of
     ml/lib/lemmas.ml).  The domains only shrink, the two
     injections compose, the roots of the new heap are the old ones
     mapped (EL_ADDR_MAP) with v_inv_related for each of them, and
     a reference that is reachable keeps its block by
     bc_ref_inv_related *)
  (STRIP_TAC THEN
   FIRST_X_ASSUM (fun gr ->
     if not (hd_is "gc_related_roots_heap" (concl gr)) then fail()
     else STRIP_ASSUME_TAC
            (REWRITE_RULE[gc_related_roots_heap_def] gr)) THEN
   FIRST_X_ASSUM (fun inv ->
     if not (hd_is "bc_stack_ref_inv" (concl inv)) then fail() else
     STRIP_ASSUME_TAC (REWRITE_RULE[bc_stack_ref_inv_def] inv)) THEN
   VAR_EQ_TAC THEN
   REWRITE_TAC[bc_stack_ref_inv_def] THEN
   (* the two maps of the new invariant are the old ones after the
      map of the collection *)
   W(fun (asl,w) ->
     let sub p = rand (lhand (concl (snd (find (fun (_,th) ->
       hd_is "SUBSET" (concl th) &&
       hd_is p (rand (concl th))) asl)))) in
     let gc = snd (find (fun (_,th) ->
       hd_is "gc_related" (concl th)) asl) in
     let g = el 0 (snd (strip_comb (concl gc))) in
     EXISTS_TAC (list_mk_icomb "f_o_f" [g; sub "domain"]) THEN
     EXISTS_TAC (list_mk_icomb "f_o_f" [g; sub "all_ts"])) THEN
   REPEAT CONJ_TAC THEN TRY (FIRST_ASSUM ACCEPT_TAC) THEN
   (* the domains only shrink *)
   TRY (SOLVED
         (REWRITE_TAC[SUBSET; f_o_f_DEF; IN_ELIM_THM] THEN
          REPEAT STRIP_TAC THEN
          FIRST_ASSUM (fun sub ->
            if not (hd_is "SUBSET" (concl sub)) then fail() else
            MATCH_MP_TAC (REWRITE_RULE[SUBSET; IN_ELIM_THM] sub))
          THEN
          FIRST_ASSUM ACCEPT_TAC)) THEN
   (* and the two injections compose *)
   TRY (SOLVED
         (POP_ASSUM_LIST (fun l ->
            MAP_EVERY ASSUME_TAC
              (filter (fun th ->
                 let c = concl th in
                 hd_is "INJ" c || hd_is "gc_related" c) l)) THEN
          RULE_ASSUM_TRY (REWRITE_RULE[gc_related_def]) THEN
          SPLIT_ASM_TAC THEN
          RULE_ASSUM_TRY (REWRITE_RULE[INJ; IN_ELIM_THM]) THEN
          SPLIT_ASM_TAC THEN
          REWRITE_TAC[INJ; f_o_f_DEF; IN_ELIM_THM] THEN
          REPEAT STRIP_TAC THEN
          ASM_SIMP_TAC[FAPPLY_f_o_f] THEN
          RULE_ASSUM_TRY (REWRITE_RULE[FAPPLY_f_o_f]) THEN
          ASM_MESON_TAC[FAPPLY_f_o_f])) THEN
   (* the roots of the new heap are the old ones mapped, and
      v_inv_related says the relation survives the map *)
   TRY (SOLVED
         (REWRITE_TAC[LIST_REL_EL_EQN; LENGTH_ADDR_MAP] THEN
          RULE_ASSUM_TRY (REWRITE_RULE[LIST_REL_EL_EQN]) THEN
          SPLIT_ASM_TAC THEN
          CONJ_TAC THEN TRY (FIRST_ASSUM ACCEPT_TAC) THEN
          X_GEN_TAC `i:num` THEN DISCH_TAC THEN
          W(fun (asl,w) ->
            let am = find_term (hd_is "ADDR_MAP") w in
            SUBGOAL_THEN (mk_binop `(<):num->num->bool` `i:num`
                            (list_mk_icomb "LENGTH" [rand am]))
              ASSUME_TAC THENL [ASM_ARITH_TAC; ALL_TAC]) THEN
          ASM_SIMP_TAC[EL_ADDR_MAP] THEN
          CONV_TAC(TOP_DEPTH_CONV BETA_CONV) THEN
          (* the old relation at the same index *)
          FIRST_ASSUM (fun lr ->
            let b = snd (strip_forall (concl lr)) in
            if not (is_imp b && can (find_term (hd_is "v_inv"))
                      (rand b)) then fail() else
            MP_TAC (SPEC `i:num` lr)) THEN
          (ANTS_TAC THENL [FIRST_ASSUM ACCEPT_TAC; ALL_TAC]) THEN
          DISCH_TAC THEN
          MATCH_MP_TAC (GEN_ALL (DISCH_ALL (CONJUNCT1
            (UNDISCH (SPEC_ALL (GEN_ALL v_inv_related)))))) THEN
          W(fun (asl,w) ->
            let gc = snd (find (fun (_,th) ->
              hd_is "gc_related" (concl th)) asl) in
            EXISTS_TAC (el 1 (snd (strip_comb (concl gc))))) THEN
          REPEAT CONJ_TAC THEN TRY (FIRST_ASSUM ACCEPT_TAC) THEN
          REPEAT STRIP_TAC THEN
          FIRST_X_ASSUM MATCH_MP_TAC THEN
          ASM_MESON_TAC[MEM_EL])) THEN
   (* and the invariant of a reference that is reachable *)
   REPEAT STRIP_TAC THEN
   FIRST_ASSUM (fun gc ->
     if not (hd_is "gc_related" (concl gc)) then fail() else
     MATCH_MP_TAC (GEN_ALL bc_ref_inv_related) THEN
     EXISTS_TAC (el 1 (snd (strip_comb (concl gc))))) THEN
   CONJ_TAC THENL [FIRST_ASSUM ACCEPT_TAC; ALL_TAC] THEN
   CONJ_TAC THENL
    [FIRST_X_ASSUM MATCH_MP_TAC THEN
     CONJ_TAC THEN TRY (FIRST_ASSUM ACCEPT_TAC) THEN
     ASM_MESON_TAC[f_o_f_DEF; IN_ELIM_THM];
     ASM_MESON_TAC[f_o_f_DEF; IN_ELIM_THM]])
### data_to_word_memoryProof_full_gc_thm
  (* what the collection leaves is what full_gc_related,
     full_gc_LENGTH and full_gc_ok say of it, and the three say it
     of one collection, so its value is one.  The heap it wrote
     holds data up to the space that is left, which is the
     expansion at its end; the stack and the references go over
     with bc_stack_ref_inv_related, where the inlining that its
     relation allows is the identity one and what is left is that
     the collection relates the roots and the heap; and the heap is
     reachable from the roots it returned
     (IMP_all_reachable_from_roots), because a pointer of the roots
     is an address that they reach *)
  ((* the values of a list are related to themselves by a reflexive
      relation *)
   let all2_refl = prove
    (`!(R:A->A->bool) l. (!x. R x x) ==> ALL2 R l l`,
     GEN_TAC THEN LIST_INDUCT_TAC THEN ASM_SIMP_TAC[ALL2]) in
   STRIP_TAC THEN SPLIT_ASM_TAC THEN
   (* what the invariant says of the stack *)
   FIRST_ASSUM (fun inv ->
     if not (hd_is "abs_ml_inv" (concl inv)) then fail() else
     STRIP_ASSUME_TAC (REWRITE_RULE[abs_ml_inv_def] inv)) THEN
   (* what the collection leaves: the heap it wrote, the map of the
      addresses it moved, and that both are good *)
   W(fun gl ->
     let ro = the_asm (hd_is "roots_ok") gl in
     let ho = the_asm (hd_is "heap_ok") gl in
     STRIP_ASSUME_TAC (MATCH_MP full_gc_related (CONJ ro ho)) THEN
     STRIP_ASSUME_TAC (MATCH_MP full_gc_LENGTH (CONJ ro ho)) THEN
     STRIP_ASSUME_TAC (MATCH_MP full_gc_ok (CONJ ro ho))) THEN
   (* the three say it of one collection, so its value is one *)
   W(fun gl ->
     let eqs = mapfilter (fun (_,th) ->
                 let c = concl th in
                 if is_eq c && hd_is "full_gc" (lhand c)
                 then th else fail()) (fst gl) in
     let e0 = hd eqs in
     MAP_EVERY (fun e ->
       if e = e0 then ALL_TAC else
       STRIP_ASSUME_TAC (REWRITE_RULE[e0; PAIR_EQ] e)) (tl eqs)) THEN
   REPEAT (FIRST_X_ASSUM (fun th ->
     let c = concl th in
     if is_eq c && is_var (lhand c) then SUBST_ALL_TAC th
     else if is_eq c && is_var (rand c) then SUBST_ALL_TAC (SYM th)
     else fail())) THEN
   (* the witnesses: what the collection returned *)
   W(fun gl ->
     let e0 = the_asm (fun c -> is_eq c &&
                hd_is "full_gc" (lhand c)) gl in
     let ps = tparts (rand (concl e0)) in
     MAP_EVERY EXISTS_TAC [el 0 ps; el 1 ps; el 2 ps]) THEN
   REPEAT CONJ_TAC THEN
   TRY (SOLVED (FIRST_ASSUM ACCEPT_TAC)) THEN
   (* the length of the heap it wrote is the length of what the
      roots reach *)
   TRY (SOLVED
         (W(fun gl ->
            let hl = the_asm (fun c -> is_eq c &&
                       hd_is "heap_length" (lhand c) &&
                       hd_is "heap_length" (rand c)) gl in
            let fd = the_asm (fun c -> is_eq c &&
                       hd_is "FDOM" (lhand c)) gl in
            ACCEPT_TAC (SYM (REWRITE_RULE[fd] hl))))) THEN
   (* the heap it wrote is reachable from the roots it returned *)
   TRY (SOLVED
         (MATCH_MP_TAC (GEN_ALL IMP_all_reachable_from_roots) THEN
          W(fun gl ->
            let fd = the_asm (fun c -> is_eq c &&
                       hd_is "FDOM" (lhand c)) gl in
            EXISTS_TAC (el 1 (snd (strip_comb
              (rand (concl fd)))))) THEN
          ASM_REWRITE_TAC[gc_related_APPEND_heap_expand;
                          isSomeDataElement_heap_lookup])) THEN
   (* and the invariant of the heap it wrote *)
   REWRITE_TAC[abs_ml_inv_def] THEN
   REPEAT CONJ_TAC THEN
   TRY (SOLVED (FIRST_ASSUM ACCEPT_TAC)) THEN
   (* the kind of the collection says only that the second part of
      the space is empty, and it is *)
   TRY (SOLVED
         (REWRITE_TAC[gc_kind_inv_def] THEN
          ASM_REWRITE_TAC[] THEN MATCH_REDUCE_TAC THEN
          REWRITE_TAC[])) THEN
   (* the space that is left is the expansion at the end of the
      heap, and the heap holds data up to it *)
   TRY (SOLVED
         (W(fun gl ->
            let dl = the_asm (fun c -> hd_is "ALL" c &&
                       hd_is "isDataElement"
                         (el 0 (snd (strip_comb c)))) gl in
            REWRITE_TAC[unused_space_inv_def; ADD_CLAUSES] THEN
            REPEAT CONJ_TAC THEN
            TRY (SOLVED
                  (DISCH_TAC THEN
                   REWRITE_TAC[heap_lookup_APPEND; LT_REFL;
                               SUB_REFL; heap_expand_def] THEN
                   ASM_REWRITE_TAC[heap_lookup_def])) THEN
            TRY (SOLVED
                  (REWRITE_TAC[heap_length_APPEND;
                               heap_length_heap_expand] THEN
                   ASM_ARITH_TAC)) THEN
            REWRITE_TAC[data_up_to_APPEND] THEN
            ACCEPT_TAC dl))) THEN
   (* the stack and the references: the inlining that the relation
      of the collection allows is the identity one, so what is left
      is that the collection relates the roots and the heap *)
   MATCH_MP_TAC (GEN_ALL bc_stack_ref_inv_related) THEN
   W(fun gl ->
     let bsi = the_asm (hd_is "bc_stack_ref_inv") gl in
     let ps = tparts (el 4 (snd (strip_comb (concl bsi)))) in
     let gc = the_asm (hd_is "gc_related") gl in
     let fm = el 0 (snd (strip_comb (concl gc))) in
     MAP_EVERY EXISTS_TAC [fm; el 0 ps; el 1 ps]) THEN
   CONJ_TAC THEN
   TRY (SOLVED (FIRST_ASSUM ACCEPT_TAC)) THEN
   REWRITE_TAC[gc_inline_related_def; gc_inline_def;
               gc_related_roots_heap_def] THEN
   W(fun (asl,w) ->
     let cs = conjuncts (snd (strip_exists w)) in
     EXISTS_TAC (el 1 (snd (strip_comb (el 0 cs)))) THEN
     EXISTS_TAC (el 1 (snd (strip_comb (el 1 cs))))) THEN
   REPEAT CONJ_TAC THEN
   (* the roots and the heap are related to themselves *)
   TRY (SOLVED
         (MATCH_MP_TAC all2_refl THEN
          MATCH_ACCEPT_TAC (CONJUNCT1 (SPEC_ALL
            (let (r,_,_) = gc_inline_rel in r))))) THEN
   TRY (SOLVED
         (MATCH_MP_TAC all2_refl THEN
          MATCH_ACCEPT_TAC (CONJUNCT1 (SPEC_ALL
            (let (r,_,_) = gc_heap_inline_rel in r))))) THEN
   (* the collection relates the heap it read and the heap it
      wrote, and the roots it returned are the ones it moved *)
   TRY (SOLVED (FIRST_ASSUM ACCEPT_TAC)) THEN
   TRY (SOLVED (REFL_TAC)) THEN
   (* and a pointer of the roots is an address that they reach *)
   REPEAT GEN_TAC THEN DISCH_TAC THEN
   W(fun gl ->
     let fd = the_asm (fun c -> is_eq c &&
                hd_is "FDOM" (lhand c)) gl in
     let m = the_asm (hd_is "MEM") gl in
     REWRITE_TAC[fd; IN; reachable_addresses_def] THEN
     EXISTS_TAC (rand (el 0 (snd (strip_comb (concl m))))) THEN
     EXISTS_TAC (lhand (el 0 (snd (strip_comb (concl m))))) THEN
     CONJ_TAC THENL
      [ACCEPT_TAC m;
       MATCH_ACCEPT_TAC (CONJUNCT1 (SPEC_ALL RTC_RULES))]))
### data_to_word_memoryProof_gen_gc_thm
  (* the same shape as full_gc_thm, with gen_gc_related and
     gen_gc_ok in place of the two of the full collection, and two
     things more: what the collection left in the heaps of its
     state (gen_gc_data_refs_split -- data that is no reference
     below the space, references above it), which is what the
     split of the kind of the collection asks for, and the
     generations that reset_gens makes, which all start where the
     first heap ends (gen_state_ok_reset) *)
  ((* the values of a list are related to themselves by a reflexive
      relation *)
   let all2_refl = prove
    (`!(R:A->A->bool) l. (!x. R x x) ==> ALL2 R l l`,
     GEN_TAC THEN LIST_INDUCT_TAC THEN ASM_SIMP_TAC[ALL2]) in
   (* the limit of the configuration that the collection is run
      with, and what it calls a reference *)
   let limit_make_gc_conf = prove
    (`gen_gc_conf_limit (make_gc_conf l) = l`,
     REWRITE_TAC (make_gc_conf_def :: record_thms "gen_gc_conf")) in
   STRIP_TAC THEN
   (* what the invariant says of the stack *)
   FIRST_ASSUM (fun inv ->
     if not (hd_is "abs_ml_inv" (concl inv)) then fail() else
     STRIP_ASSUME_TAC (REWRITE_RULE[abs_ml_inv_def] inv)) THEN
   (* the heap is good for the configuration that the collection is
      run with *)
   W(fun (asl,w as gl) ->
     let ho = the_asm (hd_is "heap_ok") gl in
     let cc = find_term (hd_is "make_gc_conf") w in
     SUBGOAL_THEN (list_mk_icomb "heap_ok"
         [el 0 (snd (strip_comb (concl ho)));
          list_mk_icomb "gen_gc_conf_limit" [cc]]) ASSUME_TAC THENL
      [REWRITE_TAC[limit_make_gc_conf] THEN ACCEPT_TAC ho;
       ALL_TAC]) THEN
   (* what the collection leaves: the state it wrote, the map of
      the addresses it moved, and that both are good *)
   W(fun gl ->
     let ro = the_asm (hd_is "roots_ok") gl in
     let ho = the_asm (fun c -> hd_is "heap_ok" c &&
                hd_is "gen_gc_conf_limit"
                  (el 1 (snd (strip_comb c)))) gl in
     STRIP_ASSUME_TAC (MATCH_MP gen_gc_related (CONJ ro ho)) THEN
     STRIP_ASSUME_TAC (MATCH_MP gen_gc_ok (CONJ ro ho))) THEN
   (* the two say it of one collection, so its value is one *)
   W(fun gl ->
     let eqs = mapfilter (fun (_,th) ->
                 let c = concl th in
                 if is_eq c && hd_is "gen_gc" (lhand c)
                 then th else fail()) (fst gl) in
     let e0 = hd eqs in
     MAP_EVERY (fun e ->
       if e = e0 then ALL_TAC else
       STRIP_ASSUME_TAC (REWRITE_RULE[e0; PAIR_EQ] e)) (tl eqs)) THEN
   REPEAT (FIRST_X_ASSUM (fun th ->
     let c = concl th in
     if is_eq c && is_var (lhand c) then SUBST_ALL_TAC th
     else if is_eq c && is_var (rand c) then SUBST_ALL_TAC (SYM th)
     else fail())) THEN
   (* what the collection left in the heaps of the state: data that
      is no reference below the space, references above it *)
   W(fun gl ->
     let e0 = the_asm (fun c -> is_eq c &&
                hd_is "gen_gc" (lhand c)) gl in
     let cc = el 0 (snd (strip_comb (lhand (concl e0)))) in
     (* what the configuration calls a reference, at the type of
        the collection that was run (entry 64) *)
     let tys = snd (dest_type
                 (hd (snd (dest_type (type_of cc))))) in
     let tv = genvar (el 0 tys) and rv = genvar (el 1 tys) in
     SUBGOAL_THEN (list_mk_forall([tv; rv], mk_eq (
         list_mk_icomb "gen_gc_conf_isRef" [cc; mk_pair (tv, rv)],
         list_mk_icomb "isMutTag" [tv])))
       (fun ir -> STRIP_ASSUME_TAC
          (MATCH_MP (GEN_ALL gen_gc_data_refs_split)
             (CONJ e0 ir))) THENL
      [REWRITE_TAC (make_gc_conf_def ::
                    record_thms "gen_gc_conf") THEN
       REWRITE_TAC[o_THM; FST];
       ALL_TAC]) THEN
   RULE_ASSUM_TRY (REWRITE_RULE[ALL_APPEND]) THEN
   SPLIT_ASM_TAC THEN
   (* the witnesses: what the collection returned *)
   W(fun gl ->
     let e0 = the_asm (fun c -> is_eq c &&
                hd_is "gen_gc" (lhand c)) gl in
     let ps = tparts (rand (concl e0)) in
     MAP_EVERY EXISTS_TAC [el 0 ps; el 1 ps]) THEN
   REPEAT CONJ_TAC THEN
   TRY (SOLVED (FIRST_ASSUM ACCEPT_TAC)) THEN
   (* the length of the heaps it wrote is the length of what the
      roots reach *)
   TRY (SOLVED
         (W(fun gl ->
            let hl = the_asm (fun c -> is_eq c &&
                       hd_is "heap_length" (lhand c) &&
                       hd_is "heap_length" (rand c)) gl in
            let fd = the_asm (fun c -> is_eq c &&
                       hd_is "FDOM" (lhand c)) gl in
            ACCEPT_TAC (REWRITE_RULE[fd] hl)))) THEN
   (* the heap it wrote is reachable from the roots it returned *)
   TRY (SOLVED
         (MATCH_MP_TAC (GEN_ALL IMP_all_reachable_from_roots) THEN
          W(fun gl ->
            let fd = the_asm (fun c -> is_eq c &&
                       hd_is "FDOM" (lhand c)) gl in
            EXISTS_TAC (el 1 (snd (strip_comb
              (rand (concl fd)))))) THEN
          ASM_REWRITE_TAC[])) THEN
   (* and the invariant of the heap it wrote *)
   REWRITE_TAC[abs_ml_inv_def] THEN
   REPEAT CONJ_TAC THEN
   TRY (SOLVED (FIRST_ASSUM ACCEPT_TAC)) THEN
   (* the heap is good, for the limit of the invariant *)
   TRY (SOLVED
         (W(fun gl ->
            let ho = the_asm (fun c -> hd_is "heap_ok" c &&
                       hd_is "gen_gc_conf_limit"
                         (el 1 (snd (strip_comb c)))) gl in
            ACCEPT_TAC (REWRITE_RULE[limit_make_gc_conf] ho)))) THEN
   (* the kind of the collection: the generations that reset_gens
      makes are good (gen_state_ok_reset), and the split at the end
      of the space has the data below it and the references above *)
   TRY (SOLVED
         (REWRITE_TAC[gc_kind_inv_def] THEN
          W(fun (asl,w) ->
            CASES_ON_TAC (find_term
              (hd_is "data_to_word_config_gc_kind") w)) THEN
          MATCH_REDUCE_TAC THEN
          TRY (SOLVED (REWRITE_TAC[])) THEN
          CONJ_TAC THENL
           [(* the state of the generations: the ones that
                reset_gens makes all start where the first heap
                ends, which is where the collection got to *)
            W(fun (asl,w as gl) ->
              let hla = the_asm (fun c -> is_eq c &&
                          hd_is "gc_state_a" (lhand c)) gl in
              ONCE_REWRITE_TAC[hla]) THEN
            W(fun (asl,w as gl) ->
              let ho = the_asm (fun c -> hd_is "heap_ok" c &&
                         hd_is "APPEND"
                           (el 0 (snd (strip_comb c)))) gl in
              (* the configuration is not fixed by the heap, so
                 the quantifier that MATCH_MP leaves is stripped *)
              let th = SPEC_ALL
                         (MATCH_MP (GEN_ALL gen_state_ok_reset)
                            ho) in
              let addr = el 1 (snd (strip_comb w)) in
              let addr2 = el 1 (snd (strip_comb (concl th))) in
              SUBGOAL_THEN (mk_eq (addr, addr2)) SUBST1_TAC THENL
               [ARITH_TAC; MATCH_ACCEPT_TAC th]);
            ALL_TAC] THEN
          (* the split of the heap it wrote *)
          W(fun (asl,w as gl) ->
            let hla = the_asm (fun c -> is_eq c &&
                        hd_is "gc_state_a" (lhand c)) gl in
            let hp = el 1 (snd (strip_comb
                       (lhand (hd (conjuncts
                          (snd (strip_exists w))))))) in
            let h1 = lhand hp in
            let hx = lhand (rand hp) in
            let r1 = rand (rand hp) in
            let pre = list_mk_icomb "APPEND" [h1; hx] in
            EXISTS_TAC pre THEN EXISTS_TAC r1 THEN
            REPEAT CONJ_TAC THENL
             [SUBGOAL_THEN (mk_eq (hp,
                  list_mk_icomb "APPEND" [pre; r1]))
                (fun e -> ONCE_REWRITE_TAC[e]) THENL
               [REWRITE_TAC[APPEND_ASSOC]; ALL_TAC] THEN
              SUBGOAL_THEN (mk_eq (el 0 (snd (strip_comb
                  (lhand (hd (conjuncts (snd (strip_exists w))))))),
                  list_mk_icomb "heap_length" [pre]))
                (fun e -> ONCE_REWRITE_TAC[e]) THENL
               [REWRITE_TAC[heap_length_APPEND;
                            heap_length_heap_expand; hla] THEN
                ARITH_TAC;
                ALL_TAC] THEN
              MATCH_ACCEPT_TAC heap_split_length;
              REWRITE_TAC[ALL_APPEND] THEN
              CONJ_TAC THEN
              TRY (SOLVED (MATCH_ACCEPT_TAC heap_expand_not_isRef)) THEN
              FIRST_ASSUM ACCEPT_TAC;
              FIRST_ASSUM ACCEPT_TAC]))) THEN
   (* the space that is left is the expansion in the middle of the
      heap, and the heap holds data up to it *)
   TRY (SOLVED
         (W(fun gl ->
            let hla = the_asm (fun c -> is_eq c &&
                        hd_is "gc_state_a" (lhand c)) gl in
            let dl = the_asm (fun c -> hd_is "ALL" c &&
                       hd_is "isDataElement"
                         (el 0 (snd (strip_comb c))) &&
                       hd_is "gc_state_h1"
                         (el 1 (snd (strip_comb c)))) gl in
            REWRITE_TAC[unused_space_inv_def; ADD_CLAUSES] THEN
            ONCE_REWRITE_TAC[hla] THEN
            REPEAT CONJ_TAC THEN
            TRY (SOLVED
                  (DISCH_TAC THEN
                   REWRITE_TAC[heap_lookup_APPEND; LT_REFL;
                               SUB_REFL;
                               heap_length_heap_expand] THEN
                   COND_CASES_TAC THEN
                   TRY (SOLVED (ASM_ARITH_TAC)) THEN
                   ASM_REWRITE_TAC[heap_expand_def;
                                   heap_lookup_def])) THEN
            TRY (SOLVED
                  (REWRITE_TAC[heap_length_APPEND;
                               heap_length_heap_expand] THEN
                   ARITH_TAC)) THEN
            REWRITE_TAC[data_up_to_APPEND] THEN
            ACCEPT_TAC dl))) THEN
   (* the stack and the references: the inlining that the relation
      of the collection allows is the identity one, so what is left
      is that the collection relates the roots and the heap *)
   MATCH_MP_TAC (GEN_ALL bc_stack_ref_inv_related) THEN
   W(fun gl ->
     let bsi = the_asm (hd_is "bc_stack_ref_inv") gl in
     let ps = tparts (el 4 (snd (strip_comb (concl bsi)))) in
     let gc = the_asm (hd_is "gc_related") gl in
     let fm = el 0 (snd (strip_comb (concl gc))) in
     MAP_EVERY EXISTS_TAC [fm; el 0 ps; el 1 ps]) THEN
   CONJ_TAC THEN
   TRY (SOLVED (FIRST_ASSUM ACCEPT_TAC)) THEN
   REWRITE_TAC[gc_inline_related_def; gc_inline_def;
               gc_related_roots_heap_def] THEN
   W(fun (asl,w) ->
     let cs = conjuncts (snd (strip_exists w)) in
     EXISTS_TAC (el 1 (snd (strip_comb (el 0 cs)))) THEN
     EXISTS_TAC (el 1 (snd (strip_comb (el 1 cs))))) THEN
   REPEAT CONJ_TAC THEN
   TRY (SOLVED
         (MATCH_MP_TAC all2_refl THEN
          MATCH_ACCEPT_TAC (CONJUNCT1 (SPEC_ALL
            (let (r,_,_) = gc_inline_rel in r))))) THEN
   TRY (SOLVED
         (MATCH_MP_TAC all2_refl THEN
          MATCH_ACCEPT_TAC (CONJUNCT1 (SPEC_ALL
            (let (r,_,_) = gc_heap_inline_rel in r))))) THEN
   TRY (SOLVED (FIRST_ASSUM ACCEPT_TAC)) THEN
   TRY (SOLVED (REFL_TAC)) THEN
   (* and a pointer of the roots is an address that they reach *)
   REPEAT GEN_TAC THEN DISCH_TAC THEN
   W(fun gl ->
     let fd = the_asm (fun c -> is_eq c &&
                hd_is "FDOM" (lhand c)) gl in
     let m = the_asm (hd_is "MEM") gl in
     REWRITE_TAC[fd; IN; reachable_addresses_def] THEN
     EXISTS_TAC (rand (el 0 (snd (strip_comb (concl m))))) THEN
     EXISTS_TAC (lhand (el 0 (snd (strip_comb (concl m))))) THEN
     CONJ_TAC THENL
      [ACCEPT_TAC m;
       MATCH_ACCEPT_TAC (CONJUNCT1 (SPEC_ALL RTC_RULES))]))
### gen_gc_partial_thm
  (* the third of the collection template, and the same shape as
     full_gc_thm and gen_gc_thm with the old generation in front.
     The steps above the statement (tools/overrides.py) give the
     fields of the configuration and heap_gen_ok of the heap, which
     is what partial_gc_related asks for beside roots_ok and
     heap_ok; what the collection left is then its theorem and
     partial_gc_IMP, and the five parts of the invariant are taken
     one at a time (THENL, so that each says where it broke):

     - a pointer of the roots it returned is an address of the heap
       it wrote, because it is the image of a pointer of the roots
       it was given (MEM_ADDR_MAP), that one is in the map, and the
       map goes into the addresses of the heap (gc_related);
     - the heap is good for the limit of the invariant, which is
       the limit of the configuration;
     - the generations that reset_gens makes all start where the
       heap it wrote ends (gen_state_ok_reset), and the split at
       the end of the space has the data below it and the
       references above -- what was below the generation and what
       the collection wrote hold no reference (ref_EVERY_d; a
       reference in what it wrote would be one in the generation it
       copied), the expansion holds none (isRef_heap_expand), and
       what is above the space is a reference because it was copied
       from one (similar_isRef);
     - the space that is left is the expansion between the heap it
       wrote and the references;
     - and the stack and the references go over with the inlining
       that the relation of the collection allows, which is the
       identity one (bc_stack_ref_inv_related) *)
  (let plain_heap_ok gl =
    the_asm (fun c -> hd_is "heap_ok" c &&
               not (hd_is "gen_gc_partial_conf_limit"
                      (el 1 (snd (strip_comb c))))) gl in
  STRIP_TAC THEN
  W(fun gl -> CASES_ON_TAC (var_by_name "gens" gl)) THEN
  FIRST_ASSUM (fun inv ->
    if not (hd_is "abs_ml_inv" (concl inv)) then fail() else
    STRIP_ASSUME_TAC (REWRITE_RULE[abs_ml_inv_def] inv)) THEN
  (* the heap is good for the limit of the configuration that the
     collection is run with *)
  W(fun (asl,w as gl) ->
    let cc = find_term (hd_is "make_partial_conf") w in
    let ho = plain_heap_ok gl in
    SUBGOAL_THEN (list_mk_icomb "heap_ok"
        [el 0 (snd (strip_comb (concl ho)));
         list_mk_icomb "gen_gc_partial_conf_limit" [cc]])
      ASSUME_TAC THENL
     [REWRITE_TAC[pconf_fields] THEN ACCEPT_TAC ho; ALL_TAC]) THEN
  (* and good for the generation it collects *)
  W(fun gl ->
    let gk = the_asm (hd_is "gc_kind_inv") gl in
    let us = the_asm (hd_is "unused_space_inv") gl in
    let ho = plain_heap_ok gl in
    let hg = the_asm (hd_is "has_gen") gl in
    let ke = the_asm (fun c -> is_eq c &&
               hd_is "data_to_word_config_gc_kind" (lhand c)) gl in
    ASSUME_TAC (MATCH_MP heap_gen_ok_inv
      (end_itlist CONJ [gk; us; ho; hg; ke]))) THEN
  (* what the collection leaves: the roots it mapped, the heap it
     wrote, the map of the addresses it moved, and that both the
     heap and the state are good *)
  W(fun gl ->
    let ro = the_asm (hd_is "roots_ok") gl in
    let ho = the_asm (fun c -> hd_is "heap_ok" c &&
               hd_is "gen_gc_partial_conf_limit"
                 (el 1 (snd (strip_comb c)))) gl in
    let hg = the_asm (hd_is "heap_gen_ok") gl in
    STRIP_ASSUME_TAC (MATCH_MP partial_gc_related
      (CONJ ro (CONJ ho hg)))) THEN
  (* and what it says of the lengths it wrote *)
  W(fun gl ->
    let pg = the_asm (fun c -> is_eq c &&
               hd_is "partial_gc" (lhand c)) gl in
    let ok = the_asm (hd_is "gc_state_ok") gl in
    STRIP_ASSUME_TAC (MATCH_MP
      (GEN_ALL gen_gc_partial_partial_gc_IMP) (CONJ pg ok))) THEN
  (* what the collection left below the generation is what was
     there: the segment of the heap that it names is the segment
     that heap_gen_ok names *)
  W(fun gl ->
    let hg = the_asm (hd_is "heap_gen_ok") gl in
    STRIP_ASSUME_TAC (REWRITE_RULE[heap_gen_ok_def] hg)) THEN
  W(fun gl ->
    let s1 = the_asm (fun c -> is_eq c &&
               hd_is "heap_segment" (rand c)) gl in
    let s2 = the_asm (fun c -> is_eq c &&
               hd_is "heap_segment" (lhand c)) gl in
    STRIP_ASSUME_TAC (REWRITE_RULE[injectivity "option"; PAIR_EQ]
      (TRANS s1 s2))) THEN
  REPEAT (FIRST_X_ASSUM (fun th ->
    let c = concl th in
    if is_eq c && is_var (lhand c) &&
       not (vfree_in (lhand c) (rand c))
    then SUBST_ALL_TAC th else fail())) THEN
  (* the witnesses: what the collection returned *)
  W(fun gl ->
    let e0 = the_asm (fun c -> is_eq c &&
               hd_is "partial_gc" (lhand c)) gl in
    let ps = tparts (rand (concl e0)) in
    MAP_EVERY EXISTS_TAC [el 0 ps; el 1 ps]) THEN
  REPEAT CONJ_TAC THENL
   [(* its value *)
    FIRST_ASSUM ACCEPT_TAC;
    (* the invariant of the heap it wrote *)
    REWRITE_TAC[abs_ml_inv_def] THEN REPEAT CONJ_TAC THENL
     [(* a pointer of the roots it returned is an address of the heap
     it wrote: it is the image of a pointer of the roots it was
     given (MEM_ADDR_MAP), that one is in the map (the condition
     of the collection) and the map goes into the addresses of the
     heap it wrote (gc_related) *)
  (REWRITE_TAC[roots_ok_def] THEN REPEAT GEN_TAC THEN
     DISCH_THEN (fun mm ->
       STRIP_ASSUME_TAC (MATCH_MP MEM_ADDR_MAP mm)) THEN
     W(fun gl ->
       let fd = the_asm (fun c -> is_forall c &&
                  can (find_term (hd_is "FDOM")) c &&
                  can (find_term (hd_is "MEM")) c) gl in
       let gr = the_asm (hd_is "gc_related") gl in
       let mm = the_asm (hd_is "MEM") gl in
       let inn = MATCH_MP (SPEC_ALL fd) mm in
       let inj = REWRITE_RULE[INJ; IN_ELIM_THM]
                   (CONJUNCT1 (REWRITE_RULE[gc_related_def] gr)) in
       MP_TAC (MATCH_MP (CONJUNCT1 inj) inn)) THEN
     ASM_REWRITE_TAC[])
      ;
  (* the heap is good, for the limit of the invariant *)
    (W(fun gl ->
       let ho = the_asm (fun c -> hd_is "heap_ok" c &&
                  hd_is "APPEND" (el 0 (snd (strip_comb c)))) gl in
       ACCEPT_TAC (REWRITE_RULE[pconf_fields] ho)))
      ;
  (* the kind of the collection: the generations that reset_gens
     makes all start where the heap it wrote ends, and the split
     at the end of the space has the data below it and the
     references above *)
  (W(fun (asl,w as gl) ->
     let av = el 1 (snd (strip_comb w)) in
     let hp = el 5 (snd (strip_comb w)) in
     SUBGOAL_THEN (mk_eq (av,
         list_mk_icomb "heap_length"
           [list_mk_icomb "APPEND"
              [lhand hp; lhand (rand hp)]])) SUBST1_TAC THENL
      [REWRITE_TAC[heap_length_APPEND] THEN ASM_ARITH_TAC;
       ALL_TAC]) THEN
   ONCE_REWRITE_TAC[APPEND_ASSOC] THEN
   REWRITE_TAC[gc_kind_inv_def] THEN
   W(fun gl ->
     let ke = the_asm (fun c -> is_eq c &&
                hd_is "data_to_word_config_gc_kind" (lhand c)) gl in
     REWRITE_TAC[ke]) THEN
   TRY SAFE_MATCH_REDUCE_TAC THEN
   CONJ_TAC THENL
    [(* the generations that reset_gens makes *)
     W(fun (asl,w as gl) ->
       let ho = the_asm (fun c -> hd_is "heap_ok" c &&
                  hd_is "APPEND" (el 0 (snd (strip_comb c)))) gl in
       let th = SPEC_ALL (MATCH_MP (GEN_ALL gen_state_ok_reset)
                  (ONCE_REWRITE_RULE[APPEND_ASSOC] ho)) in
       let addr = el 1 (snd (strip_comb w)) in
       let addr2 = el 1 (snd (strip_comb (concl th))) in
       SUBGOAL_THEN (mk_eq (addr, addr2)) SUBST1_TAC THENL
        [ARITH_TAC; MATCH_ACCEPT_TAC th]);
     (* and the split at the end of the space *)
     W(fun (asl,w as gl) ->
       let c0 = hd (conjuncts (snd (strip_exists w))) in
       let hp = el 1 (snd (strip_comb (lhand c0))) in
       let pre = list_mk_icomb "APPEND"
                   [lhand hp; lhand (rand hp)] in
       let r1 = rand (rand hp) in
       EXISTS_TAC pre THEN EXISTS_TAC r1 THEN
       REPEAT CONJ_TAC THENL
        [SUBGOAL_THEN (mk_eq (hp,
             list_mk_icomb "APPEND" [pre; r1]))
           (fun e -> ONCE_REWRITE_TAC[e]) THENL
          [REWRITE_TAC[APPEND_ASSOC]; ALL_TAC] THEN
         SUBGOAL_THEN (mk_eq (el 0 (snd (strip_comb (lhand c0))),
             list_mk_icomb "heap_length" [pre]))
           (fun e -> ONCE_REWRITE_TAC[e]) THENL
          [REWRITE_TAC[heap_length_APPEND;
                       heap_length_heap_expand] THEN ARITH_TAC;
           ALL_TAC] THEN
         MATCH_ACCEPT_TAC heap_split_length;
         (* nothing below the end of the space is a reference:
            what was below the generation, what the collection
            wrote, and the expansion *)
         REWRITE_TAC[ALL_APPEND] THEN
         REPEAT CONJ_TAC THEN
         TRY (SOLVED (MATCH_ACCEPT_TAC isRef_heap_expand)) THEN
         TRY (SOLVED (FIRST_ASSUM ACCEPT_TAC)) THEN
         TRY (SOLVED
           (W(fun (asl,w as gl) ->
              let lst = el 1 (snd (strip_comb w)) in
              let dl = the_asm (fun c -> hd_is "ALL" c &&
                         hd_is "isDataElement"
                           (el 0 (snd (strip_comb c))) &&
                         el 1 (snd (strip_comb c)) = lst) gl in
              let cond = the_asm (fun c -> is_forall c &&
                           can (find_term (hd_is
                             "gen_gc_partial_conf_isRef")) c &&
                           can (find_term (fun t -> t = lst)) c &&
                           is_neg
                             (rand (snd (strip_forall c)))) gl in
              ACCEPT_TAC (MATCH_MP (CONJUNCT1 ref_EVERY_d)
                            (CONJ dl cond))))) THEN
         (* what the collection wrote holds no reference, because
            a reference in it would be one in the generation it
            copied *)
         W(fun (asl,w as gl) ->
           let lst = el 1 (snd (strip_comb w)) in
           let dl = the_asm (fun c -> hd_is "ALL" c &&
                      hd_is "isDataElement"
                        (el 0 (snd (strip_comb c))) &&
                      el 1 (snd (strip_comb c)) = lst) gl in
           let cl = the_asm (fun c -> is_forall c &&
                      can (find_term (fun t -> t = lst)) c &&
                      is_imp (snd (strip_forall c)) &&
                      is_exists (rand (snd (strip_forall c)))) gl in
           let cu = the_asm (fun c -> is_forall c &&
                      can (find_term (hd_is
                        "gen_gc_partial_conf_isRef")) c &&
                      is_neg (rand (snd (strip_forall c))) &&
                      not (can (find_term (fun t -> t = lst)) c)) gl in
           let cur = el 1 (snd (strip_comb
                       (lhand (snd (strip_forall (concl cu)))))) in
           SUBGOAL_THEN (subst [lst,cur] (concl cu))
             (fun cond -> ACCEPT_TAC
                (MATCH_MP (CONJUNCT1 ref_EVERY_d)
                   (CONJ dl cond))) THENL
            [MESON_TAC[cl; cu]]);
         (* and everything above the space is a reference: the
            collection copied the references of the generation *)
         W(fun (asl,w as gl) ->
           let lst = el 1 (snd (strip_comb w)) in
           let sim = the_asm (fun c -> hd_is "ALL2" c &&
                       el 2 (snd (strip_comb c)) = lst) gl in
           let refs = el 1 (snd (strip_comb (concl sim))) in
           let dl = the_asm (fun c -> hd_is "ALL" c &&
                      hd_is "isDataElement"
                        (el 0 (snd (strip_comb c))) &&
                      el 1 (snd (strip_comb c)) = refs) gl in
           let cond = the_asm (fun c -> is_forall c &&
                        can (find_term (hd_is
                          "gen_gc_partial_conf_isRef")) c &&
                        can (find_term (fun t -> t = refs)) c &&
                        not (is_neg
                          (rand (snd (strip_forall c))))) gl in
           ACCEPT_TAC (MATCH_MP similar_isRef
             (CONJ sim (MATCH_MP (CONJUNCT2 ref_EVERY_d)
                          (CONJ dl cond)))))])])

      ;
  (* the space that is left is the expansion between the heap it
     wrote and the references: the collection got to the end of
     the old generation and of the heap it wrote *)
  (W(fun (asl,w as gl) ->
       let av = el 0 (snd (strip_comb w)) in
       let hp = el 2 (snd (strip_comb w)) in
       let old = lhand hp and h1 = lhand (rand hp) in
       SUBGOAL_THEN (mk_eq (av,
           list_mk_icomb "heap_length"
             [list_mk_icomb "APPEND" [old; h1]]))
         SUBST1_TAC THENL
        [REWRITE_TAC[heap_length_APPEND] THEN ASM_ARITH_TAC;
         ALL_TAC]) THEN
     ONCE_REWRITE_TAC[APPEND_ASSOC] THEN
     W(fun gl ->
       let dl = the_asm (fun c -> hd_is "ALL" c &&
                  hd_is "isDataElement"
                    (el 0 (snd (strip_comb c))) &&
                  hd_is "gc_state_h1"
                    (el 1 (snd (strip_comb c)))) gl in
       let dold = the_asm (fun c -> hd_is "ALL" c &&
                    hd_is "isDataElement"
                      (el 0 (snd (strip_comb c))) &&
                    hd_is "gc_state_old"
                      (el 1 (snd (strip_comb c)))) gl in
       REWRITE_TAC[unused_space_inv_def; ADD_CLAUSES] THEN
       REPEAT CONJ_TAC THEN
       TRY (SOLVED
         (DISCH_TAC THEN
          REWRITE_TAC[heap_lookup_APPEND; LT_REFL; SUB_REFL;
                      heap_length_heap_expand] THEN
          COND_CASES_TAC THEN
          TRY (SOLVED (ASM_ARITH_TAC)) THEN
          ASM_REWRITE_TAC[heap_expand_def; heap_lookup_def])) THEN
       TRY (SOLVED
         (REWRITE_TAC[heap_length_APPEND;
                      heap_length_heap_expand] THEN
          ARITH_TAC)) THEN
       TRY (SOLVED
         (REWRITE_TAC[data_up_to_APPEND; ALL_APPEND] THEN
          CONJ_TAC THEN
          TRY (SOLVED (ACCEPT_TAC dold)) THEN
          ACCEPT_TAC dl)) THEN
       ALL_TAC))

      ;
  (* the stack and the references go over with the inlining that
     the relation of the collection allows, which is the identity
     one *)
  (let all2_refl = prove
      (`!(R:A->A->bool) l. (!x. R x x) ==> ALL2 R l l`,
       GEN_TAC THEN LIST_INDUCT_TAC THEN ASM_SIMP_TAC[ALL2]) in
     MATCH_MP_TAC (GEN_ALL bc_stack_ref_inv_related) THEN
     W(fun gl ->
       let bsi = the_asm (hd_is "bc_stack_ref_inv") gl in
       let ps = tparts (el 4 (snd (strip_comb (concl bsi)))) in
       let gc = the_asm (hd_is "gc_related") gl in
       let fm = el 0 (snd (strip_comb (concl gc))) in
       MAP_EVERY EXISTS_TAC [fm; el 0 ps; el 1 ps]) THEN
     CONJ_TAC THEN
     TRY (SOLVED (FIRST_ASSUM ACCEPT_TAC)) THEN
     REWRITE_TAC[gc_inline_related_def; gc_inline_def;
                 gc_related_roots_heap_def] THEN
     W(fun (asl,w) ->
       let cs = conjuncts (snd (strip_exists w)) in
       EXISTS_TAC (el 1 (snd (strip_comb (el 0 cs)))) THEN
       EXISTS_TAC (el 1 (snd (strip_comb (el 1 cs))))) THEN
     REPEAT CONJ_TAC THEN
     TRY (SOLVED
       (MATCH_MP_TAC all2_refl THEN
        MATCH_ACCEPT_TAC (CONJUNCT1 (SPEC_ALL
          (let (r,_,_) = gc_inline_rel in r))))) THEN
     TRY (SOLVED
       (MATCH_MP_TAC all2_refl THEN
        MATCH_ACCEPT_TAC (CONJUNCT1 (SPEC_ALL
          (let (r,_,_) = gc_heap_inline_rel in r))))) THEN
     TRY (SOLVED (FIRST_ASSUM ACCEPT_TAC)) THEN
     TRY (SOLVED (REFL_TAC)) THEN
     FIRST_ASSUM MATCH_ACCEPT_TAC)
      ];
    (* and that its state is good *)
    FIRST_ASSUM ACCEPT_TAC])
### gc_combined_thm
  (* the three kinds of collection, each of them a theorem of its
     own: the one that does nothing leaves the heap as it is and
     says only that the space is empty (and that what the
     invariant then asks of the heap is that it holds data up to
     its start, which is nothing), the full collection is
     full_gc_thm and the generational one is gen_gc_partial_thm
     when it is partial and gen_gc_thm when it is not.  What is
     left over is the arithmetic of the heap that the collection
     wrote: it holds data, so its data length is its heap length,
     and the space it left is what the expansion adds *)
  ((* the limit of the configuration that the collection is run
      with is the limit of the invariant *)
   let limit_make_gc_conf = prove
    (`gen_gc_conf_limit (make_gc_conf l) = l`,
     REWRITE_TAC (make_gc_conf_def :: record_thms "gen_gc_conf")) in
   STRIP_TAC THEN SPLIT_ASM_TAC THEN
   (* what the invariant says of the stack, and the kind of the
      collection, of which there are three *)
   FIRST_ASSUM (fun inv ->
     if not (hd_is "abs_ml_inv" (concl inv)) then fail() else
     STRIP_ASSUME_TAC (REWRITE_RULE[abs_ml_inv_def] inv)) THEN
   W(fun (asl,w) ->
     CASES_ON_TAC (find_term
       (hd_is "data_to_word_config_gc_kind") w)) THEN
   RULE_ASSUM_TRY (CONV_RULE(TOP_DEPTH_CONV MATCH_CONV)) THEN
   REWRITE_TAC[gc_combined_def] THEN
   MATCH_REDUCE_TAC THEN
   (* the witnesses of the first two cases are read off the
      collection's own value *)
   REWRITE_TAC[limit_make_gc_conf] THEN
   W(fun (asl,w as gl) ->
     if not (can (find_term (hd_is "full_gc")) w) then ALL_TAC else
     (* the full collection: what full_gc_thm says of its result *)
     (let inv = the_asm (hd_is "abs_ml_inv") gl in
      let kd = the_asm (fun c -> is_eq c &&
                 hd_is "data_to_word_config_gc_kind" (lhand c)) gl in
      STRIP_ASSUME_TAC
        (MATCH_MP data_to_word_memoryProof_full_gc_thm
           (CONJ inv kd)))) THEN
   W(fun (asl,w) ->
     if not (can (find_term (hd_is "partial_gc")) w) ||
        not (can (find_term (hd_is "COND")) w) then ALL_TAC else
     COND_CASES_TAC) THEN
   (* the two generational collections: what their theorems say *)
   W(fun (asl,w as gl) ->
     if not (can (find_term (hd_is "partial_gc")) w) then ALL_TAC else
     (let inv = the_asm (hd_is "abs_ml_inv") gl in
      let kd = the_asm (fun c -> is_eq c &&
                 hd_is "data_to_word_config_gc_kind" (lhand c)) gl in
      (* the partial collection asks for a generation, which the
         hypothesis gives when the collection is a partial one *)
      let imp = the_asm (fun c -> is_imp c &&
                  hd_is "has_gen" (rand c)) gl in
      let dp = the_asm is_var gl in
      let hg = MP imp dp in
      STRIP_ASSUME_TAC (MATCH_MP gen_gc_partial_thm
        (CONJ inv (CONJ hg kd))))) THEN
   W(fun (asl,w as gl) ->
     if not (can (find_term (hd_is "gen_gc")) w) then ALL_TAC else
     (let inv = the_asm (hd_is "abs_ml_inv") gl in
      STRIP_ASSUME_TAC
        (MATCH_MP data_to_word_memoryProof_gen_gc_thm inv))) THEN
   (* the value of the collection, with the result of the one that
      was run put in.  The configuration that the partial
      collection is run with is a let of its own, so the lets come
      first and the equation of the result after them *)
   CONV_TAC(TOP_DEPTH_CONV let_CONV) THEN
   W(fun (asl,w) ->
     let eqs = mapfilter (fun (_,th) ->
                 let c = concl th in
                 if is_eq c &&
                    (hd_is "full_gc" (lhand c) ||
                     hd_is "partial_gc" (lhand c) ||
                     hd_is "gen_gc" (lhand c))
                 then th else fail()) asl in
     REWRITE_TAC eqs) THEN
   CONV_TAC(TOP_DEPTH_CONV let_CONV) THEN
   (* so the witnesses are the parts of that value *)
   W(fun (asl,w) ->
     let bod = snd (strip_exists w) in
     let vl = lhand (hd (conjuncts bod)) in
     let ps = tparts vl in
     MAP_EVERY EXISTS_TAC
       [el 0 ps; el 1 ps; el 4 ps; el 3 ps; el 2 ps]) THEN
   REWRITE_TAC[PAIR_EQ] THEN
   REPEAT CONJ_TAC THEN
   TRY (SOLVED (REWRITE_TAC[])) THEN
   (* a partial collection makes no claim about the heap it left:
      its kind is neither None nor Simple *)
   TRY (SOLVED (REWRITE_TAC[distinctness "gc_kind"])) THEN
   (* the invariant of the heap that the collection left *)
   TRY (SOLVED (FIRST_ASSUM ACCEPT_TAC)) THEN
   (* of a generational collection the generations are the ones
      that reset_gens makes, which for that kind is the list of its
      sizes with the address of the new heap in each *)
   TRY (SOLVED
         (W(fun gl ->
            let inv = the_asm (fun c -> hd_is "abs_ml_inv" c &&
                        can (find_term (hd_is "reset_gens")) c) gl in
            let kd = the_asm (fun c -> is_eq c &&
                       hd_is "data_to_word_config_gc_kind"
                         (lhand c)) gl in
            MATCH_ACCEPT_TAC
              (CONV_RULE(TOP_DEPTH_CONV MATCH_CONV)
                 (REWRITE_RULE[reset_gens_def; kd] inv))))) THEN
   (* of the collection that does nothing the space is empty, and
      what the invariant then asks of the heap is that it holds
      data up to its start, which is nothing *)
   TRY (SOLVED
         (REWRITE_TAC[abs_ml_inv_def] THEN
          REPEAT CONJ_TAC THEN
          TRY (SOLVED (FIRST_ASSUM ACCEPT_TAC)) THEN
          TRY (SOLVED
                (REWRITE_TAC[gc_kind_inv_def] THEN
                 ASM_REWRITE_TAC[] THEN MATCH_REDUCE_TAC THEN
                 W(fun gl ->
                   let gk = the_asm (hd_is "gc_kind_inv") gl in
                   MP_TAC (REWRITE_RULE[gc_kind_inv_def] gk)) THEN
                 ASM_REWRITE_TAC[] THEN MATCH_REDUCE_TAC THEN
                 REWRITE_TAC[])) THEN
          REWRITE_TAC[unused_space_inv_def; data_up_to_def;
                      heap_split_0; ADD_CLAUSES; LE_0] THEN
          W(fun (asl,w) ->
            let pr = rand (lhand (hd (conjuncts (snd
                       (strip_exists w))))) in
            EXISTS_TAC (lhand pr) THEN EXISTS_TAC (rand pr)) THEN
          REWRITE_TAC[ALL])) THEN
   (* and the claims that a collection which moves data makes: the
      heap it left is reachable from its roots and holds data up to
      the space that is left *)
   DISCH_THEN (K ALL_TAC) THEN
   CONJ_TAC THEN
   TRY (SOLVED (FIRST_ASSUM ACCEPT_TAC)) THEN
   (* the heap that the collection left holds data, so its data
      length is its heap length *)
   W(fun (asl,w) ->
     let dls = mapfilter (fun (_,th) ->
                 let c = concl th in
                 if hd_is "ALL" c &&
                    hd_is "isDataElement"
                      (el 0 (snd (strip_comb c)))
                 then MATCH_MP data_length_heap_length th
                 else fail()) asl in
     let hls = mapfilter (fun (_,th) ->
                 let c = concl th in
                 if is_eq c && hd_is "heap_length" (lhand c)
                 then th else fail()) asl in
     REWRITE_TAC (heap_length_APPEND :: heap_length_heap_expand ::
                  data_length_APPEND ::
                  data_length_APPEND_heap_expand ::
                  data_length_heap_expand :: dls @ hls)) THEN
   ARITH_TAC)
### IMP_heap_store_unused
  (* the steps are above the statement (tools/overrides.py).  The
     element fits in the unused space, so that space is not empty
     and the heap holds the unused element: heap_lookup_SPLIT cuts
     the heap at it and heap_store_lemma says what the store
     writes.  Of the ten things the theorem says, the lengths and
     the forward pointers and the data elements are arithmetic and
     rewriting, and the four lemmas about the regions of the store
     say the rest *)
  (STRIP_TAC THEN SPLIT_ASM_TAC THEN
    (* the unused space is not empty, because the element fits in it *)
    W(fun (asl,w as gl) ->
      let le = the_asm (fun c -> hd_is "<=" c &&
                 hd_is "el_length" (lhand c)) gl in
      let x = rand (lhand (concl le)) in
      let sp = rand (concl le) in
      SUBGOAL_THEN (mk_neg (mk_eq (sp, `0`))) ASSUME_TAC THENL
       [MP_TAC (ISPEC x el_length_GT_0) THEN MP_TAC le THEN ARITH_TAC;
        ALL_TAC]) THEN
    (* so the heap holds the unused element, and is what is before
       it, it, and what follows *)
    W(fun gl ->
      let us = the_asm (hd_is "unused_space_inv") gl in
      STRIP_ASSUME_TAC (REWRITE_RULE[unused_space_inv_def] us)) THEN
    W(fun gl ->
      let imp = the_asm (fun c -> is_imp c && is_neg (lhand c) &&
                  is_eq (rand c) &&
                  hd_is "heap_lookup" (lhand (rand c))) gl in
      let ne = the_asm (fun c -> is_neg c && is_eq (rand c) &&
                 rand (rand c) = `0`) gl in
      STRIP_ASSUME_TAC (MATCH_MP heap_lookup_SPLIT (MP imp ne))) THEN
    REPEAT (FIRST_X_ASSUM (fun e ->
      let c = concl e in
      if not (is_eq c) || not (is_var (lhand c)) then fail() else
      SUBST_ALL_TAC e)) THEN
    (* and the store writes the element into that space *)
    REWRITE_TAC[heap_store_unused_def] THEN
    ASM_REWRITE_TAC[heap_lookup_PREFIX] THEN
    REWRITE_TAC[heap_store_lemma] THEN
    W(fun (asl,w) ->
      let pr = lhand (hd (conjuncts (snd (strip_exists w)))) in
      EXISTS_TAC (lhand pr)) THEN
    REWRITE_TAC[PAIR_EQ] THEN
    (* the element written is at the end of what was unused *)
    W(fun (asl,w as gl) ->
      let le = the_asm (fun c -> hd_is "<=" c &&
                 hd_is "el_length" (lhand c)) gl in
      let e = lhand (concl le) in
      let sp = rand (concl le) in
      let hl = find_term (fun t -> hd_is "heap_length" t &&
                 is_var (rand t)) w in
      REWRITE_TAC[MP (ISPECL [hl; sp; e] (ARITH_RULE
        `!a s e. (e:num) <= s ==> (a + s) - e = a + (s - e)`)) le]) THEN
    (* what is before the space holds data, and the element written
       is no shorter than one *)
    W(fun gl ->
      let du = the_asm (hd_is "data_up_to") gl in
      let le = the_asm (fun c -> hd_is "<=" c &&
                 hd_is "el_length" (lhand c)) gl in
      ASSUME_TAC (REWRITE_RULE[data_up_to_APPEND] du) THEN
      ASSUME_TAC (ISPEC (rand (lhand (concl le))) el_length_GT_0)) THEN
    REPEAT CONJ_TAC THEN
    (* the length of what the store writes is the length of the
       element it replaces, and the heap is as long as it was *)
    TRY (SOLVED
          (REWRITE_TAC[heap_length_APPEND; heap_length_heap_expand;
                       heap_length_clauses; el_length_def;
                       ADD_CLAUSES] THEN
           ASM_ARITH_TAC)) THEN
    (* the forward pointers are the ones it had *)
    TRY (SOLVED
          (DISCH_TAC THEN
           REWRITE_TAC[FILTER_APPEND; FILTER; heap_expand_def] THEN
           COND_CASES_TAC THEN
           ASM_REWRITE_TAC[FILTER; APPEND; APPEND_NIL;
                           isForwardPointer_def])) THEN
    (* and the data elements are the ones it had, and the one
       written *)
    TRY (SOLVED
          (REPEAT GEN_TAC THEN
           REWRITE_TAC[heap_expand_def] THEN
           COND_CASES_TAC THEN
           (let ds = [distinctness "heap_element"] in
            REWRITE_TAC (MEM_APPEND :: MEM :: APPEND ::
                         ds @ map GSYM ds)) THEN
           MESON_TAC[])) THEN
    (* the element written is where the goal says, the space it went
       into held no data, and what held data still does *)
    W(fun (asl,w as gl) ->
      let le = the_asm (fun c -> hd_is "<=" c &&
                 hd_is "el_length" (lhand c)) gl in
      let one = the_asm (fun c -> hd_is "<=" c &&
                  lhand c = `1`) gl in
      let ne0 = the_asm (fun c -> is_neg c && is_eq (rand c) &&
                  rand (rand c) = `0`) gl in
      let e = lhand (concl le) in
      let sp = rand (concl le) in
      let x = rand e in
      let du = the_asm (hd_is "data_up_to") gl in
      let hp = el 1 (snd (strip_comb (concl du))) in
      let ha = lhand hp in
      let hb = rand (rand hp) in
      let args = [ha; sp; e; x; hb] in
      let hyp3 = CONJ ne0 (CONJ one le) in
      let hyp4 = CONJ ne0 (CONJ (REFL e) (CONJ one le)) in
      if hd_is "unused_space_inv" w then
        (* the space that is left is unused space, and what is before
           it still holds data *)
        (REWRITE_TAC[unused_space_inv_def] THEN
         REPEAT CONJ_TAC THENL
          [DISCH_TAC THEN
           W(fun gl ->
             let ne = the_asm (fun c -> is_neg c && is_eq (rand c) &&
                        rand (rand c) = `0` &&
                        hd_is "-" (lhand (rand c))) gl in
             ACCEPT_TAC (MP (ISPECL [ha; lhand (rand (concl ne)); x; hb]
                               heap_lookup_unused_left) ne));
           W(fun gl ->
             let bd = the_asm (fun c -> hd_is "<=" c &&
                        hd_is "heap_length" (rand c)) gl in
             MP_TAC bd) THEN
           REWRITE_TAC[heap_length_APPEND; heap_length_clauses;
                       heap_length_heap_expand; el_length_def;
                       ADD_CLAUSES] THEN
           ASM_ARITH_TAC;
           REWRITE_TAC[data_up_to_APPEND] THEN
           FIRST_ASSUM ACCEPT_TAC])
      else if is_eq w && hd_is "heap_lookup" (lhand w) then
        REWRITE_TAC[heap_lookup_at_end]
      else if is_neg w && hd_is "isSomeDataElement" (rand w) then
        ACCEPT_TAC (MATCH_MP (ISPECL [ha; sp; e; hb]
                                heap_lookup_in_unused) hyp3)
      else if is_imp w && hd_is "isDataElement" (lhand w) then
        (DISCH_TAC THEN
         W(fun gl ->
           let isd = the_asm (hd_is "isDataElement") gl in
           ACCEPT_TAC (MATCH_MP (ISPECL args isSome_store_unused)
             (CONJ ne0 (CONJ (REFL e) (CONJ one (CONJ le isd)))))))
      else if hd_is "heap_store_rel" w then
        ACCEPT_TAC (MATCH_MP (ISPECL args
                                heap_store_rel_store_unused) hyp4)
      else ALL_TAC))
### IMP_heap_store_unused_alt
  (* the steps are above the statement (tools/overrides.py).  The
     same shape as IMP_heap_store_unused, with the element at the
     start of what was unused instead of at its end: the space is
     not empty, heap_lookup_SPLIT cuts the heap at the unused
     element, heap_store_lemma says what the store writes, and the
     lemmas about the regions of the store say the rest *)
  (STRIP_TAC THEN SPLIT_ASM_TAC THEN
    (* the unused space is not empty, because the element fits in it *)
    W(fun (asl,w as gl) ->
      let le = the_asm (fun c -> hd_is "<=" c &&
                 hd_is "el_length" (lhand c)) gl in
      let x = rand (lhand (concl le)) in
      let sp = rand (concl le) in
      SUBGOAL_THEN (mk_neg (mk_eq (sp, `0`))) ASSUME_TAC THENL
       [MP_TAC (ISPEC x el_length_GT_0) THEN MP_TAC le THEN ARITH_TAC;
        ALL_TAC]) THEN
    (* so the heap holds the unused element, and is what is before
       it, it, and what follows *)
    W(fun gl ->
      let us = the_asm (hd_is "unused_space_inv") gl in
      STRIP_ASSUME_TAC (REWRITE_RULE[unused_space_inv_def] us)) THEN
    W(fun gl ->
      let imp = the_asm (fun c -> is_imp c && is_neg (lhand c) &&
                  is_eq (rand c) &&
                  hd_is "heap_lookup" (lhand (rand c))) gl in
      let ne = the_asm (fun c -> is_neg c && is_eq (rand c) &&
                 rand (rand c) = `0`) gl in
      STRIP_ASSUME_TAC (MATCH_MP heap_lookup_SPLIT (MP imp ne))) THEN
    REPEAT (FIRST_X_ASSUM (fun e ->
      let c = concl e in
      if not (is_eq c) || not (is_var (lhand c)) then fail() else
      SUBST_ALL_TAC e)) THEN
    (* and the store writes the element and the space that is left *)
    REWRITE_TAC[heap_store_unused_alt_def] THEN
    ASM_REWRITE_TAC[heap_lookup_PREFIX] THEN
    REWRITE_TAC[heap_store_lemma] THEN
    W(fun (asl,w) ->
      let pr = lhand (hd (conjuncts (snd (strip_exists w)))) in
      EXISTS_TAC (lhand pr)) THEN
    REWRITE_TAC[PAIR_EQ] THEN
    (* what is before the space holds data, and the element written
       is no shorter than one *)
    W(fun gl ->
      let du = the_asm (hd_is "data_up_to") gl in
      let le = the_asm (fun c -> hd_is "<=" c &&
                 hd_is "el_length" (lhand c)) gl in
      ASSUME_TAC (REWRITE_RULE[data_up_to_APPEND] du) THEN
      ASSUME_TAC (ISPEC (rand (lhand (concl le))) el_length_GT_0)) THEN
    REPEAT CONJ_TAC THEN
    (* the length of what the store writes is the length of the
       element it replaces, and the heap is as long as it was *)
    TRY (SOLVED
          (REWRITE_TAC[heap_length_APPEND; heap_length_heap_expand;
                       heap_length_clauses; el_length_def;
                       ADD_CLAUSES] THEN
           ASM_ARITH_TAC)) THEN
    (* the forward pointers are the ones it had *)
    TRY (SOLVED
          (DISCH_TAC THEN
           REWRITE_TAC[heap_expand_def] THEN
           COND_CASES_TAC THEN
           ASM_REWRITE_TAC[FILTER_APPEND; FILTER; APPEND; APPEND_NIL;
                           isForwardPointer_def] THEN
           TRY MATCH_REDUCE_TAC THEN
           ASM_REWRITE_TAC[FILTER; APPEND; APPEND_NIL])) THEN
    (* and the data elements are the ones it had, and the one
       written *)
    TRY (SOLVED
          (REPEAT GEN_TAC THEN
           REWRITE_TAC[heap_expand_def] THEN
           COND_CASES_TAC THEN
           (let ds = [distinctness "heap_element"] in
            REWRITE_TAC (MEM_APPEND :: MEM :: APPEND ::
                         ds @ map GSYM ds)) THEN
           MESON_TAC[])) THEN
    (* the element written is where the goal says, the space it went
       into held no data, and what held data still does *)
    W(fun (asl,w as gl) ->
      let le = the_asm (fun c -> hd_is "<=" c &&
                 hd_is "el_length" (lhand c)) gl in
      let one = the_asm (fun c -> hd_is "<=" c &&
                  lhand c = `1`) gl in
      let ne0 = the_asm (fun c -> is_neg c && is_eq (rand c) &&
                  rand (rand c) = `0`) gl in
      let ev = the_asm (fun c -> hd_is "ALL" c) gl in
      let e = lhand (concl le) in
      let sp = rand (concl le) in
      let x = rand e in
      let du = the_asm (hd_is "data_up_to") gl in
      let hp = el 1 (snd (strip_comb (concl du))) in
      let ha = lhand hp in
      let hb = rand (rand hp) in
      let args = [ha; sp; e; x; hb] in
      if is_imp w && hd_is "isDataElement" (lhand w) &&
         hd_is "unused_space_inv" (rand w) then
        (* the space that is left is unused space, and what is below
           it holds data: what was below it and the element *)
        (DISCH_TAC THEN
         REWRITE_TAC[unused_space_inv_def] THEN
         REPEAT CONJ_TAC THENL
          [DISCH_TAC THEN
           W(fun gl ->
             let ne = the_asm (fun c -> is_neg c && is_eq (rand c) &&
                        rand (rand c) = `0` &&
                        hd_is "-" (lhand (rand c))) gl in
             ACCEPT_TAC (MP (ISPECL [ha; lhand (rand (concl ne));
                                     x; hb]
                               heap_lookup_alt_unused) ne));
           W(fun gl ->
             let bd = the_asm (fun c -> hd_is "<=" c &&
                        hd_is "heap_length" (rand c)) gl in
             MP_TAC bd) THEN
           REWRITE_TAC[heap_length_APPEND; heap_length_clauses;
                       heap_length_heap_expand; el_length_def;
                       ADD_CLAUSES] THEN
           ASM_ARITH_TAC;
           W(fun gl ->
             let isd = the_asm (hd_is "isDataElement") gl in
             let hpg = el 1 (snd (strip_comb (snd gl))) in
             let he = rand (lhand (rand hpg)) in
             ACCEPT_TAC (MATCH_MP (ISPECL [ha; x; he; hb]
                            data_up_to_alt) (CONJ ev isd)))])
      else if is_eq w && hd_is "heap_lookup" (lhand w) then
        REWRITE_TAC[heap_lookup_alt_at_start]
      else if is_neg w && hd_is "isSomeDataElement" (rand w) then
        (REWRITE_TAC[heap_lookup_PREFIX; isSomeDataElement_def] THEN
         (let ds = [distinctness "heap_element"] in
          REWRITE_TAC (injectivity "option" ::
                       NOT_EXISTS_THM :: ds @ map GSYM ds)) THEN
         REWRITE_TAC[])
      else if is_imp w && hd_is "isDataElement" (lhand w) then
        (DISCH_TAC THEN
         W(fun gl ->
           let isd = the_asm (hd_is "isDataElement") gl in
           ACCEPT_TAC (MATCH_MP (ISPECL args isSome_store_unused_alt)
             (CONJ ne0 (CONJ (REFL e) (CONJ one (CONJ le isd)))))))
      else if hd_is "heap_store_rel" w then
        ACCEPT_TAC (MATCH_MP (ISPECL args heap_store_rel_alt)
          (CONJ ne0 (CONJ (REFL e) (CONJ one le))))
      else ALL_TAC))
### list_to_BlockReps_Pointer_lem
  (* the induction of the source over the list.  The element is a
     block of the rest of the list, which the induction hypothesis
     is about, or the block that points at the next one (and then
     the pointer is the address of the next block, which
     list_to_BlockReps_heap_lookup_0 says is an element), or the
     last block, which holds the tail of the list *)
  (LIST_INDUCT_TAC THEN REPEAT GEN_TAC THEN
   CONV_TAC(DEPTH_CONV let_CONV) THEN
   REWRITE_TAC[NOT_CONS_NIL] THEN
   CASES_ON_NAME "t" THENL
    [(* one element, whose block holds the head and the tail *)
     ONCE_REWRITE_TAC[list_to_BlockReps_def] THEN
     MATCH_REDUCE_TAC THEN
     REWRITE_TAC[MEM; BlockRep_def; injectivity "heap_element"] THEN
     STRIP_TAC THEN VAR_EQ_TAC THEN
     RULE_ASSUM_TAC(REWRITE_RULE[MEM]) THEN
     ASM_REWRITE_TAC[MEM] THEN ASM_MESON_TAC[];
     ALL_TAC] THEN
   STRIP_TAC THEN
   (* the block of the element is one of the three that
      list_to_BlockReps_MEM gives *)
   FIRST_ASSUM (fun a1 ->
     if not (hd_is "MEM" (concl a1) &&
             hd_is "list_to_BlockReps" (rand (concl a1))) then fail()
     else STRIP_ASSUME_TAC
            (MATCH_MP (GEN_ALL list_to_BlockReps_MEM) a1)) THENL
    [(* a block of the rest, which the induction hypothesis is
         about *)
     FIRST_X_ASSUM (fun ih ->
       if not (is_forall (concl ih)) then fail() else
       let ih2 = REWRITE_RULE[NOT_CONS_NIL]
                   (CONV_RULE(DEPTH_CONV let_CONV) ih) in
       FIRST_ASSUM (fun a1 -> FIRST_ASSUM (fun a2 ->
         MP_TAC (MATCH_MP ih2 (CONJ a1 a2))))) THEN
     STRIP_TAC THENL
      [ASM_MESON_TAC[];
       ASM_REWRITE_TAC[MEM] THEN ASM_MESON_TAC[];
       DISJ2_TAC THEN DISJ2_TAC THEN
       ONCE_REWRITE_TAC[list_to_BlockReps_def] THEN
       MATCH_REDUCE_TAC THEN
       REWRITE_TAC[heap_length_CONS; BlockRep_def; el_length_def;
                   LENGTH; heap_lookup_def] THEN
       CONV_TAC NUM_REDUCE_CONV THEN
       REPEAT CONJ_TAC THENL
        [ASM_ARITH_TAC;
         ASM_ARITH_TAC;
         ASM_SIMP_TAC[ARITH_RULE
                        `ptr > len + 3 ==> ~(ptr - len = 0)`;
                      ARITH_RULE
                        `ptr > len + 3 ==> ~(ptr - len < 3)`;
                      ARITH_RULE
                        `ptr > len + 3
                         ==> ptr - len - 3 = ptr - (len + 3)`] THEN
         FIRST_ASSUM ACCEPT_TAC]];
     (* or the block that points at the next one *)
     RULE_ASSUM_TAC(REWRITE_RULE[BlockRep_def;
                                 injectivity "heap_element"]) THEN
     SPLIT_ASM_TAC THEN VAR_EQ_TAC THEN
     RULE_ASSUM_TAC(REWRITE_RULE[MEM]) THEN
     FIRST_X_ASSUM (fun mm ->
       if not (is_disj (concl mm)) then fail() else
       DISJ_CASES_THEN2 (fun e -> REWRITE_TAC[MEM] THEN
                                  MESON_TAC[e])
         (fun e ->
           MP_TAC (REWRITE_RULE[injectivity "heap_address"] e))
         mm) THEN
     STRIP_TAC THEN VAR_EQ_TAC THEN
     DISJ2_TAC THEN DISJ2_TAC THEN
     REPEAT CONJ_TAC THENL
      [ASM_SIMP_TAC[GEN_ALL list_to_BlockReps_heap_length;
                    NOT_CONS_NIL; LENGTH] THEN
       ARITH_TAC;
       ARITH_TAC;
       ONCE_REWRITE_TAC[list_to_BlockReps_def] THEN
       MATCH_REDUCE_TAC THEN
       REWRITE_TAC[heap_lookup_def; BlockRep_def; el_length_def;
                   LENGTH] THEN
       CONV_TAC NUM_REDUCE_CONV THEN
       REWRITE_TAC[ARITH_RULE `(len + 3) - len = 3`] THEN
       CONV_TAC NUM_REDUCE_CONV THEN
       MATCH_MP_TAC (GEN_ALL list_to_BlockReps_heap_lookup_0) THEN
       REWRITE_TAC[NOT_CONS_NIL]];
     (* or the block that holds the tail *)
     RULE_ASSUM_TAC(REWRITE_RULE[BlockRep_def;
                                 injectivity "heap_element"]) THEN
     SPLIT_ASM_TAC THEN VAR_EQ_TAC THEN
     RULE_ASSUM_TAC(REWRITE_RULE[MEM]) THEN
     ASM_REWRITE_TAC[MEM] THEN ASM_MESON_TAC[]])
### v_inv_list_to_v_lem
  (* the attempt: the proof of the source names FDOM, list_to_v_def,
     list_to_BlockReps_def, v_inv_def, BlockRep_def,
     heap_length_APPEND.  What is here rewrites with them and closes
     by arithmetic, and the cheat is behind it until the proof is
     written.  A MESON over them is what the next round adds; it
     costs a load ten minutes to have it in every attempt and it
     closed none of them *)
  (ATTEMPT_TAC 2
    (REPEAT GEN_TAC THEN REPEAT STRIP_TAC THEN
     ASM_REWRITE_TAC[FDOM; list_to_v_def; list_to_BlockReps_def;
       v_inv_def; BlockRep_def; heap_length_APPEND] THEN
     TRY ASM_ARITH_TAC))
### cons_thm_alt
  (* the steps are above the statement (tools/overrides.py).  The
     timestamp of the block is one that the map of the timestamps
     does not have, because every one of its is below it; the roots
     of the values of the block are the front of the roots of the
     stack (LIST_REL_SPLIT1), the block fits in the unused space
     and IMP_heap_store_unused_alt writes it there.  The heap, the
     roots and the space are then as good as they were
     (gc_kind_store_unused_alt of the kind of the collection), the
     map of the timestamps gains the one of the block with the
     address it was written at, and of every reference that the
     stack reaches the invariant holds as it did
     (bc_ref_inv_step) *)
  (STRIP_TAC THEN SPLIT_ASM_TAC THEN
    (* what the invariant says of the stack that the block is built
       from *)
    FIRST_X_ASSUM (fun inv ->
      if not (hd_is "abs_ml_inv" (concl inv)) then fail() else
      STRIP_ASSUME_TAC (REWRITE_RULE[abs_ml_inv_def;
                                     bc_stack_ref_inv_def] inv)) THEN
    (* the timestamp of the block is fresh: every timestamp of the
       map is below it *)
    W(fun (asl,w as gl) ->
      let su = the_asm (fun c -> hd_is "SUBSET" c &&
                 hd_is "GSPEC" (rand c)) gl in
      let tf = rand (lhand (concl su)) in
      let bl = find_term (hd_is "dataSem_Block") w in
      let ts = el 0 (snd (strip_comb bl)) in
      SUBGOAL_THEN (mk_neg (list_mk_icomb "IN"
                      [ts; list_mk_icomb "FDOM" [tf]])) ASSUME_TAC THENL
       [MP_TAC su THEN REWRITE_TAC[SUBSET; IN_ELIM_THM] THEN
        MESON_TAC[LT_REFL];
        ALL_TAC]) THEN
    (* the roots of the values of the block, and the rest *)
    W(fun gl ->
      let e2 = the_asm (hd_is "ALL2") gl in
      STRIP_ASSUME_TAC (ONCE_REWRITE_RULE[LIST_REL_SPLIT1] e2)) THEN
    (* the roots of the block are as many as its values *)
    W(fun (asl,w as gl) ->
      let bl = find_term (hd_is "dataSem_Block") w in
      let xs = el 2 (snd (strip_comb bl)) in
      let e1 = the_asm (fun c -> hd_is "ALL2" c &&
                 el 1 (snd (strip_comb c)) = xs) gl in
      ASSUME_TAC (MATCH_MP LIST_REL_LENGTH e1)) THEN
    (* so the block fits in the unused space, and the store writes it
       there *)
    W(fun (asl,w as gl) ->
      let us = the_asm (hd_is "unused_space_inv") gl in
      let spsp = el 1 (snd (strip_comb (concl us))) in
      let bl = find_term (hd_is "dataSem_Block") w in
      let xs = el 2 (snd (strip_comb bl)) in
      let e1 = the_asm (fun c -> hd_is "ALL2" c &&
                 el 1 (snd (strip_comb c)) = xs) gl in
      let ys1 = el 2 (snd (strip_comb (concl e1))) in
      let br = rator (find_term (hd_is "BlockRep") w) in
      let el1 = mk_comb (br, ys1) in
      SUBGOAL_THEN (list_mk_icomb "<="
                      [list_mk_icomb "el_length" [el1]; spsp])
        (fun bd -> STRIP_ASSUME_TAC (MATCH_MP
           IMP_heap_store_unused_alt (CONJ us bd))) THENL
       [REWRITE_TAC[BlockRep_def; el_length_def] THEN
        ASM_ARITH_TAC;
        ALL_TAC]) THEN
    (* the block is a data element, which is what the two facts about
       the store ask for *)
    W(fun gl ->
      let st = the_asm (fun c -> is_eq c &&
                 hd_is "heap_store_unused_alt" (lhand c)) gl in
      let el1 = el 2 (snd (strip_comb (lhand (concl st)))) in
      let isd = is_data_el el1 in
      MAP_EVERY (fun th -> ASSUME_TAC (MP th isd))
        (mapfilter (fun (_,th) ->
           let c = concl th in
           if is_imp c && hd_is "isDataElement" (lhand c) then th
           else fail()) (fst gl))) THEN
    (* the witnesses: the roots of the block, the rest of them, and
       the heap that the store wrote *)
    W(fun (asl,w as gl) ->
      let st = the_asm (fun c -> is_eq c &&
                 hd_is "heap_store_unused_alt" (lhand c)) gl in
      let ys1 = el 1 (snd (strip_comb
                  (el 2 (snd (strip_comb (lhand (concl st))))))) in
      let heap2 = lhand (rand (concl st)) in
      let rts = the_asm (fun c -> is_eq c && is_var (lhand c) &&
                  hd_is "APPEND" (rand c)) gl in
      MAP_EVERY EXISTS_TAC [ys1; rand (rand (concl rts)); heap2]) THEN
    REPEAT CONJ_TAC THEN
    TRY (SOLVED (FIRST_ASSUM ACCEPT_TAC)) THEN
    TRY (SOLVED (W(fun gl ->
      let le = the_asm (fun c -> is_eq c &&
                 hd_is "LENGTH" (lhand c) &&
                 hd_is "LENGTH" (rand c)) gl in
      ACCEPT_TAC (SYM le)))) THEN
    (* and the invariant of the new heap and stack *)
    REWRITE_TAC[abs_ml_inv_def] THEN
    (* the addresses that hold data are the ones that did, and the
       one the store wrote *)
    W(fun gl ->
      let seq = the_asm (fun c -> is_eq c &&
                  hd_is "INSERT" (rand c)) gl in
      let ro = the_asm (hd_is "roots_ok") gl in
      ASSUME_TAC (REWRITE_RULE[EXTENSION; IN_INSERT; IN_ELIM_THM]
                    seq) THEN
      ASSUME_TAC (REWRITE_RULE[roots_ok_def] ro)) THEN
    REPEAT CONJ_TAC THEN
    (* the roots: the one of the block is the address it was written
       at, and the others are the ones they were *)
    TRY (SOLVED
          (REWRITE_TAC[roots_ok_def; MEM] THEN
           REPEAT STRIP_TAC THEN
           W(fun gl ->
             let iso = the_asm (fun c ->
                         let vs,bd = strip_forall c in
                         length vs = 1 && is_eq bd &&
                         hd_is "isSomeDataElement" (lhand bd)) gl in
             REWRITE_TAC[iso]) THEN
           TRY (SOLVED
                 (DISJ1_TAC THEN
                  FIRST_X_ASSUM (fun e ->
                    if not (is_eq (concl e)) ||
                       not (hd_is "gc_shared_Pointer" (rand (concl e)))
                    then fail() else
                    MP_TAC e) THEN
                  REWRITE_TAC[injectivity "heap_address"] THEN
                  MESON_TAC[])) THEN
           DISJ2_TAC THEN
           ASM_MESON_TAC[MEM_APPEND])) THEN
    (* the heap is good: it is as long as it was, it has no forward
       pointer, and the pointers of the block are roots of the stack *)
    TRY (SOLVED
          (REWRITE_TAC[heap_ok_def] THEN
           REPEAT CONJ_TAC THEN
           TRY (SOLVED
                 (W(fun gl ->
                    let ho = REWRITE_RULE[heap_ok_def]
                               (the_asm (hd_is "heap_ok") gl) in
                    let hl = the_asm (fun c -> is_eq c &&
                               hd_is "heap_length" (lhand c)) gl in
                    MP_TAC ho THEN REWRITE_TAC[hl] THEN
                    STRIP_TAC THEN ASM_REWRITE_TAC[]))) THEN
           TRY (SOLVED
                 (W(fun gl ->
                    let ho = REWRITE_RULE[heap_ok_def]
                               (the_asm (hd_is "heap_ok") gl) in
                    let impl = the_asm (fun c -> is_imp c &&
                                 is_neg (lhand c) &&
                                 hd_is "isForwardPointer"
                                   (rand (lhand c))) gl in
                    let st = the_asm (fun c -> is_eq c &&
                               hd_is "heap_store_unused_alt"
                                 (lhand c)) gl in
                    let el1 = el 2 (snd (strip_comb
                                (lhand (concl st)))) in
                    SUBGOAL_THEN (mk_neg (list_mk_icomb
                                    "isForwardPointer" [el1]))
                      (fun nf -> MP_TAC ho THEN
                         REWRITE_TAC[MP impl nf] THEN
                         STRIP_TAC THEN ASM_REWRITE_TAC[]) THEN
                    REWRITE_TAC[BlockRep_def; isForwardPointer_def] THEN
                    MATCH_REDUCE_TAC THEN REWRITE_TAC[]))) THEN
           (* the pointers: of the block they are its roots, which the
              stack had, and of any other element they are what they
              were *)
           REPEAT GEN_TAC THEN
           W(fun gl ->
             let mem = the_asm (fun c ->
                         let vs,bd = strip_forall c in
                         length vs = 3 && is_eq bd &&
                         hd_is "MEM" (lhand bd)) gl in
             REWRITE_TAC[mem]) THEN
           STRIP_TAC THEN
           W(fun gl ->
             let iso = the_asm (fun c ->
                         let vs,bd = strip_forall c in
                         length vs = 1 && is_eq bd &&
                         hd_is "isSomeDataElement" (lhand bd)) gl in
             REWRITE_TAC[iso]) THEN
           DISJ2_TAC THEN
           TRY (SOLVED
                 (W(fun gl ->
                    let eq = the_asm (fun c -> is_eq c &&
                               hd_is "BlockRep" (lhand c)) gl in
                    MP_TAC eq) THEN
                  REWRITE_TAC[BlockRep_def;
                              injectivity "heap_element"] THEN
                  STRIP_TAC THEN
                  ASM_MESON_TAC[MEM_APPEND])) THEN
           W(fun gl ->
             let ho = REWRITE_RULE[heap_ok_def]
                        (the_asm (hd_is "heap_ok") gl) in
             MP_TAC ho) THEN
           ASM_MESON_TAC[])) THEN
    (* the kind of the collection: the store into the unused space
       keeps it (gc_kind_store_unused_alt).  The statement says
       el_length (BlockRep tag rs) of the pointer and of the space
       with a type variable of its own, so the length of the block
       is worked out on both sides before they are matched
       (entry 61) *)
    W(fun (asl,w as gl) ->
      if not (hd_is "gc_kind_inv" w) then ALL_TAC else
      (let gk = the_asm (hd_is "gc_kind_inv") gl in
       let st = the_asm (fun c -> is_eq c &&
                  hd_is "heap_store_unused_alt" (lhand c)) gl in
       let el1 = el 2 (snd (strip_comb (lhand (concl st)))) in
       let sp = el 2 (snd (strip_comb (concl gk))) in
       let us2 = the_asm (fun c -> hd_is "unused_space_inv" c &&
                   can (find_term (hd_is "-")) c) gl in
       let nr = PART_MATCH I isRef_BlockRep
                  (mk_neg (list_mk_icomb
                     "data_to_word_memoryProof_isRef" [el1])) in
       let reduce th = CONV_RULE(TOP_DEPTH_CONV MATCH_CONV)
                         (REWRITE_RULE[BlockRep_def;
                                       el_length_def] th) in
       SUBGOAL_THEN (list_mk_icomb "<="
                       [list_mk_icomb "el_length" [el1]; sp])
         (fun bd ->
            REWRITE_TAC[BlockRep_def; el_length_def] THEN
            CONV_TAC(TOP_DEPTH_CONV MATCH_CONV) THEN
            MATCH_ACCEPT_TAC (reduce (MATCH_MP
              gc_kind_store_unused_alt
              (CONJ nr (CONJ bd (CONJ gk (CONJ st us2))))))) THEN
       REWRITE_TAC[BlockRep_def; el_length_def] THEN
       ASM_ARITH_TAC)) THEN
    (* the unused space: what the store lemma says, with the length
       of the block taken off the first part of it.  The statement
       says el_length (BlockRep tag rs) of the pointer and of the
       space with two type variables of its own, so both are reduced
       to the length of the block first (entry 61) *)
    W(fun (asl,w as gl) ->
      if not (hd_is "unused_space_inv" w) then ALL_TAC else
      (let us = the_asm (fun c -> hd_is "unused_space_inv" c &&
                  can (find_term (hd_is "-")) c) gl in
       REWRITE_TAC[BlockRep_def; el_length_def] THEN
       MP_TAC (REWRITE_RULE[BlockRep_def; el_length_def] us) THEN
       W(fun (asl,w) ->
         let usub = el 1 (snd (strip_comb (lhand w))) in
         let gsub = el 1 (snd (strip_comb (rand w))) in
         SUBGOAL_THEN (mk_eq (usub, gsub)) ASSUME_TAC THENL
          [ASM_ARITH_TAC; ASM_REWRITE_TAC[]]))) THEN
    (* the maps: the timestamp of the block into the one of the
       timestamps, and the addresses as they were *)
    REWRITE_TAC[bc_stack_ref_inv_def] THEN
    W(fun (asl,w as gl) ->
      let su = the_asm (fun c -> hd_is "SUBSET" c &&
                 hd_is "domain" (rand c)) gl in
      let f = rand (lhand (concl su)) in
      let tfsu = the_asm (fun c -> hd_is "SUBSET" c &&
                   hd_is "all_ts" (rand c)) gl in
      let tf = rand (lhand (concl tfsu)) in
      let st = the_asm (fun c -> is_eq c &&
                 hd_is "heap_store_unused_alt" (lhand c)) gl in
      let aa = el 0 (snd (strip_comb (lhand (concl st)))) in
      let bl = find_term (hd_is "dataSem_Block") w in
      let ts = el 0 (snd (strip_comb bl)) in
      EXISTS_TAC f THEN
      EXISTS_TAC (list_mk_icomb "|+" [tf; mk_pair (ts, aa)])) THEN
    REPEAT CONJ_TAC THEN
    TRY (SOLVED (FIRST_ASSUM ACCEPT_TAC)) THEN
    (* the map of the timestamps: the one of the block is fresh and
       its address the one the store wrote at *)
    W(fun (asl,w as gl) ->
      if not (hd_is "INJ" w) ||
         not (can (find_term (hd_is "|+")) w) then ALL_TAC else
      (let iso = the_asm (fun c ->
                   let vs,bd = strip_forall c in
                   length vs = 1 && is_eq bd &&
                   hd_is "isSomeDataElement" (lhand bd)) gl in
       let inj = the_asm (fun c -> hd_is "INJ" c &&
                   hd_is "fmap_apply" (el 0 (snd (strip_comb c))) &&
                   rand (el 0 (snd (strip_comb c))) =
                     lhand (rand (el 0 (snd (strip_comb w))))) gl in
       let nd = the_asm (fun c -> is_neg c &&
                  hd_is "isSomeDataElement" (rand c)) gl in
       MATCH_MP_TAC INJ_FUPDATE_fresh THEN
       EXISTS_TAC (rand (concl inj)) THEN
       REPEAT CONJ_TAC THEN
       TRY (SOLVED (FIRST_ASSUM ACCEPT_TAC)) THEN
       TRY (SOLVED (MP_TAC nd THEN REWRITE_TAC[IN_ELIM_THM])) THEN
       REWRITE_TAC[IN_ELIM_THM] THEN
       MATCH_ACCEPT_TAC iso)) THEN
    (* and the map of the addresses goes into the bigger set of
       addresses *)
    W(fun (asl,w as gl) ->
      if not (hd_is "INJ" w) then ALL_TAC else
      (let iso = the_asm (fun c ->
                   let vs,bd = strip_forall c in
                   length vs = 1 && is_eq bd &&
                   hd_is "isSomeDataElement" (lhand bd)) gl in
       let inj = the_asm (fun c -> hd_is "INJ" c &&
                   el 0 (snd (strip_comb c)) =
                     el 0 (snd (strip_comb w))) gl in
       MATCH_MP_TAC INJ_bigger THEN
       EXISTS_TAC (rand (concl inj)) THEN
       CONJ_TAC THENL
        [ACCEPT_TAC inj;
         REWRITE_TAC[IN_ELIM_THM] THEN
         REWRITE_TAC[iso] THEN MESON_TAC[]])) THEN
    (* the timestamps of the stack with the block on it are the
       ones it had and the block's own (all_ts_cons) *)
    TRY (SOLVED
          (REWRITE_TAC[FDOM_FUPDATE; all_ts_cons] THEN
           W(fun gl ->
             let su = the_asm (fun c -> hd_is "SUBSET" c &&
                        hd_is "all_ts" (rand c)) gl in
             MP_TAC su) THEN
           SET_TAC[])) THEN
    (* and they are below the timestamp that the new stack counts
       from *)
    TRY (SOLVED
          (REWRITE_TAC[FDOM_FUPDATE] THEN
           W(fun gl ->
             let su = the_asm (fun c -> hd_is "SUBSET" c &&
                        hd_is "GSPEC" (rand c)) gl in
             MP_TAC su) THEN
           REWRITE_TAC[SUBSET; IN_INSERT; IN_ELIM_THM] THEN
           MESON_TAC[ARITH_RULE `!m n. m < n ==> m < n + 1`;
                     ARITH_RULE `!n. n < n + 1`])) THEN
    (* the blocks of the stack stay unique, because the block is a
       new one (blocks_unique_cons_thm) *)
    TRY (SOLVED
          (REWRITE_TAC[all_vs_Block] THEN
           W(fun gl ->
             let bu = the_asm (hd_is "blocks_unique") gl in
             MATCH_ACCEPT_TAC (MATCH_MP blocks_unique_cons_thm
               bu)))) THEN
    (* the transfer that the allocation leaves: what the invariant
       said of a value it says of it with the block allocated
       (v_inv_cons_step) *)
    W(fun (asl,w as gl) ->
      let nd = the_asm (fun c -> is_neg c && hd_is "IN" (rand c) &&
                 hd_is "FDOM" (rand (rand c))) gl in
      let hsr = the_asm (hd_is "heap_store_rel") gl in
      let old = the_asm (fun c -> hd_is "ALL2" c &&
                  is_var (el 1 (snd (strip_comb c)))) gl in
      let pred = el 0 (snd (strip_comb (concl old))) in
      let v,b1 = dest_abs pred in
      let x,vtm = dest_abs b1 in
      let tf2 = find_term (hd_is "|+") w in
      ASSUME_TAC (GENL [v; x] (DISCH vtm
        (MATCH_MP v_inv_cons_step
          (CONJ (ASSUME vtm)
            (CONJ nd (CONJ hsr (REFL tf2)))))))) THEN
    (* the values of the stack with the pointer of the block on
       it *)
    W(fun (asl,w) ->
      if not (hd_is "ALL2" w) then ALL_TAC else
      (REWRITE_TAC[ALL2] THEN
       CONV_TAC(TOP_DEPTH_CONV BETA_CONV) THEN
       CONJ_TAC THENL
        [(* the block: its pointer is the address that the store
             wrote at, and its values the roots of the front *)
         W(fun (asl,w as gl) ->
           let st = the_asm (fun c -> is_eq c &&
                      hd_is "heap_store_unused_alt" (lhand c)) gl in
           let aa = el 0 (snd (strip_comb (lhand (concl st)))) in
           let ys1 = el 1 (snd (strip_comb
                       (el 2 (snd (strip_comb
                         (lhand (concl st))))))) in
           REWRITE_TAC[v_inv_def] THEN ASM_REWRITE_TAC[] THEN
           EXISTS_TAC aa THEN EXISTS_TAC ys1 THEN
           REPEAT CONJ_TAC THEN
           TRY (SOLVED (FIRST_ASSUM ACCEPT_TAC)) THEN
           TRY (SOLVED (REWRITE_TAC[FLOOKUP_UPDATE])) THEN
           TRY (SOLVED (W(fun gl ->
             let old = the_asm (fun c -> hd_is "ALL2" c &&
                         el 2 (snd (strip_comb c)) = ys1) gl in
             MATCH_ACCEPT_TAC (MATCH_MP EVERY2_v_inv_alloc_stack
               (CONJ (a_vtr gl) old))))) THEN
           W(fun gl ->
             let le = the_asm (fun c -> is_eq c &&
                        hd_is "LENGTH" (lhand c) &&
                        hd_is "LENGTH" (rand c)) gl in
             REWRITE_TAC[le]));
         (* and the rest of the stack, with the transfer *)
         W(fun (asl,w as gl) ->
           let stk = el 1 (snd (strip_comb w)) in
           let old = the_asm (fun c -> hd_is "ALL2" c &&
                       el 1 (snd (strip_comb c)) = stk) gl in
           MATCH_ACCEPT_TAC (MATCH_MP EVERY2_v_inv_alloc_stack
             (CONJ (a_vtr gl) old)))])) THEN
    (* and the invariant of every reference that the new stack
       reaches: the old stack reached it, and the allocation keeps
       what the invariant says of it (bc_ref_inv_step) *)
    REPEAT STRIP_TAC THEN
    W(fun (asl,w as gl) ->
      let rr = the_asm (fun c -> hd_is "reachable_refs" c) gl in
      ASSUME_TAC (MATCH_MP reachable_refs_cons rr)) THEN
    W(fun (asl,w as gl) ->
      let n = el 1 (snd (strip_comb w)) in
      let bri = the_asm (fun c ->
                  let vs,bd = strip_forall c in
                  length vs = 1 && is_imp bd &&
                  hd_is "bc_ref_inv" (rand bd)) gl in
      let rr = the_asm (fun c -> hd_is "reachable_refs" c &&
                 not (can (find_term (hd_is "dataSem_Block"))
                        (el 0 (snd (strip_comb c))))) gl in
      let inn = the_asm (fun c -> hd_is "IN" c &&
                  hd_is "FDOM" (rand c) &&
                  el 0 (snd (strip_comb c)) = n) gl in
      let inv = MP (SPEC n bri) (CONJ rr inn) in
      let hsr = the_asm (hd_is "heap_store_rel") gl in
      let stp = REWRITE_RULE[IMP_CONJ] bc_ref_inv_step in
      let th = MATCH_MP (MATCH_MP (MATCH_MP (MATCH_MP stp
                 (a_vtr gl)) inn) hsr) inv in
      MATCH_MP_TAC (REWRITE_RULE[IMP_IMP] th)) THEN
    REPEAT CONJ_TAC THEN
    TRY (SOLVED (REWRITE_TAC[])) THEN
    TRY (SOLVED (W(fun gl ->
      let nd = the_asm (fun c -> is_neg c && hd_is "IN" (rand c) &&
                 hd_is "FDOM" (rand (rand c))) gl in
      let nsd = the_asm (fun c -> is_neg c &&
                  hd_is "isSomeDataElement" (rand c)) gl in
      MATCH_ACCEPT_TAC (MATCH_MP IMAGE_FUPDATE_fresh
        (CONJ nd nsd))))) THEN
    MESON_TAC[])
### word64_alt_thm
  (* the attempt: the proof of the source names abs_ml_inv_def,
     el_length_def, Word64Rep_def, IMP_heap_store_unused_alt,
     roots_ok_def, heap_store_rel_def.  What is here rewrites with
     them and closes by arithmetic, and the cheat is behind it until
     the proof is written.  A MESON over them is what the next round
     adds; it costs a load ten minutes to have it in every attempt
     and it closed none of them *)
  (ATTEMPT_TAC 2
    (REPEAT GEN_TAC THEN REPEAT STRIP_TAC THEN
     ASM_REWRITE_TAC[abs_ml_inv_def; el_length_def;
       Word64Rep_def; IMP_heap_store_unused_alt; roots_ok_def;
       heap_store_rel_def] THEN
     TRY ASM_ARITH_TAC))
### bignum_alt_thm
  (* the attempt: the proof of the source names abs_ml_inv_def,
     el_length_def, IMP_heap_store_unused_alt, roots_ok_def,
     heap_store_rel_def, isSomeDataElement_def.  What is here
     rewrites with them and closes by arithmetic, and the cheat is
     behind it until the proof is written.  A MESON over them is
     what the next round adds; it costs a load ten minutes to have
     it in every attempt and it closed none of them *)
  (ATTEMPT_TAC 2
    (REPEAT GEN_TAC THEN REPEAT STRIP_TAC THEN
     ASM_REWRITE_TAC[abs_ml_inv_def; el_length_def;
       IMP_heap_store_unused_alt; roots_ok_def;
       heap_store_rel_def; isSomeDataElement_def] THEN
     TRY ASM_ARITH_TAC))
### mutcons_thm_alt
  (* the steps are above the statement (tools/overrides.py).  The
     roots of the values of the block are the front of the roots
     of the stack (LIST_REL_SPLIT1, after the appends are put to
     the left), the block fits in the unused space and
     IMP_heap_store_unused_alt writes it there; the heap, the
     roots and the space are then as good as they were, the map of
     the addresses gains the point of the block, and of the
     references the one written is the block itself while the
     others are what they were (bc_ref_inv_step) *)
  (STRIP_TAC THEN SPLIT_ASM_TAC THEN
    (* what the invariant says of the stack that the block is built
       from *)
    FIRST_X_ASSUM (fun inv ->
      if not (hd_is "abs_ml_inv" (concl inv)) then fail() else
      STRIP_ASSUME_TAC (REWRITE_RULE[abs_ml_inv_def;
                                     bc_stack_ref_inv_def] inv)) THEN
    (* the appends to the left, so that the values of the block and
       the rest of the stack are the two sides of one *)
    REWRITE_TAC[APPEND_ASSOC] THEN
    RULE_ASSUM_TRY (REWRITE_RULE[APPEND_ASSOC]) THEN
    (* the roots of the values of the block, and the rest *)
    W(fun gl ->
      let e2 = the_asm (hd_is "ALL2") gl in
      STRIP_ASSUME_TAC (ONCE_REWRITE_RULE[LIST_REL_SPLIT1] e2)) THEN
    (* the roots of the block are as many as its values *)
    W(fun gl ->
      let e1 = the_asm (fun c -> hd_is "ALL2" c &&
                 hd_is "APPEND" (el 1 (snd (strip_comb c)))) gl in
      ASSUME_TAC (MATCH_MP LIST_REL_LENGTH e1)) THEN
    (* so the block fits in the unused space, and the store writes it
       there *)
    W(fun (asl,w as gl) ->
      let us = the_asm (hd_is "unused_space_inv") gl in
      let spsp = el 1 (snd (strip_comb (concl us))) in
      let e1 = the_asm (fun c -> hd_is "ALL2" c &&
                 hd_is "APPEND" (el 1 (snd (strip_comb c)))) gl in
      let ys1 = el 2 (snd (strip_comb (concl e1))) in
      let bl = rator (find_term (hd_is "BlockRep") w) in
      let el1 = mk_comb (bl, ys1) in
      SUBGOAL_THEN (list_mk_icomb "<="
                      [list_mk_icomb "el_length" [el1]; spsp])
        (fun bd -> STRIP_ASSUME_TAC (MATCH_MP
           IMP_heap_store_unused_alt (CONJ us bd))) THENL
       [REWRITE_TAC[BlockRep_def; el_length_def] THEN
        ASM_ARITH_TAC;
        ALL_TAC]) THEN
    (* the block is a data element, which is what the two facts about
       the store ask for *)
    W(fun gl ->
      let st = the_asm (fun c -> is_eq c &&
                 hd_is "heap_store_unused_alt" (lhand c)) gl in
      let el1 = el 2 (snd (strip_comb (lhand (concl st)))) in
      let isd = is_data_el el1 in
      MAP_EVERY (fun th -> ASSUME_TAC (MP th isd))
        (mapfilter (fun (_,th) ->
           let c = concl th in
           if is_imp c && hd_is "isDataElement" (lhand c) then th
           else fail()) (fst gl))) THEN
    (* the witnesses: the roots of the block, the rest of them, and
       the heap that the store wrote *)
    W(fun (asl,w as gl) ->
      let st = the_asm (fun c -> is_eq c &&
                 hd_is "heap_store_unused_alt" (lhand c)) gl in
      let ys1 = el 1 (snd (strip_comb
                  (el 2 (snd (strip_comb (lhand (concl st))))))) in
      let heap2 = lhand (rand (concl st)) in
      let rts = the_asm (fun c -> is_eq c && is_var (lhand c) &&
                  hd_is "APPEND" (rand c)) gl in
      MAP_EVERY EXISTS_TAC [ys1; rand (rand (concl rts)); heap2]) THEN
    REPEAT CONJ_TAC THEN
    TRY (SOLVED (FIRST_ASSUM ACCEPT_TAC)) THEN
    TRY (SOLVED (W(fun gl ->
      let le = the_asm (fun c -> is_eq c &&
                 hd_is "LENGTH" (lhand c) &&
                 hd_is "LENGTH" (rand c)) gl in
      ACCEPT_TAC (SYM le)))) THEN
    (* and the invariant of the new heap and references *)
    REWRITE_TAC[abs_ml_inv_def] THEN
    (* the addresses that hold data are the ones that did, and the
       one the store wrote *)
    W(fun gl ->
      let seq = the_asm (fun c -> is_eq c &&
                  hd_is "INSERT" (rand c)) gl in
      let ro = the_asm (hd_is "roots_ok") gl in
      ASSUME_TAC (REWRITE_RULE[EXTENSION; IN_INSERT; IN_ELIM_THM]
                    seq) THEN
      ASSUME_TAC (REWRITE_RULE[roots_ok_def] ro)) THEN
    REPEAT CONJ_TAC THEN
    (* the roots: the one of the block is the address it was written
       at, and the others are the ones they were *)
    TRY (SOLVED
          (REWRITE_TAC[roots_ok_def; MEM] THEN
           REPEAT STRIP_TAC THEN
           W(fun gl ->
             let iso = the_asm (fun c ->
                         let vs,bd = strip_forall c in
                         length vs = 1 && is_eq bd &&
                         hd_is "isSomeDataElement" (lhand bd)) gl in
             REWRITE_TAC[iso]) THEN
           TRY (SOLVED
                 (DISJ1_TAC THEN
                  FIRST_X_ASSUM (fun e ->
                    if not (is_eq (concl e)) ||
                       not (hd_is "gc_shared_Pointer" (rand (concl e)))
                    then fail() else
                    MP_TAC e) THEN
                  REWRITE_TAC[injectivity "heap_address"] THEN
                  MESON_TAC[])) THEN
           DISJ2_TAC THEN
           ASM_MESON_TAC[MEM_APPEND])) THEN
    (* the heap is good: it is as long as it was, it has no forward
       pointer, and the pointers of the block are roots of the stack *)
    TRY (SOLVED
          (REWRITE_TAC[heap_ok_def] THEN
           REPEAT CONJ_TAC THEN
           TRY (SOLVED
                 (W(fun gl ->
                    let ho = REWRITE_RULE[heap_ok_def]
                               (the_asm (hd_is "heap_ok") gl) in
                    let hl = the_asm (fun c -> is_eq c &&
                               hd_is "heap_length" (lhand c)) gl in
                    MP_TAC ho THEN REWRITE_TAC[hl] THEN
                    STRIP_TAC THEN ASM_REWRITE_TAC[]))) THEN
           TRY (SOLVED
                 (W(fun gl ->
                    let ho = REWRITE_RULE[heap_ok_def]
                               (the_asm (hd_is "heap_ok") gl) in
                    let impl = the_asm (fun c -> is_imp c &&
                                 is_neg (lhand c) &&
                                 hd_is "isForwardPointer"
                                   (rand (lhand c))) gl in
                    let st = the_asm (fun c -> is_eq c &&
                               hd_is "heap_store_unused_alt"
                                 (lhand c)) gl in
                    let el1 = el 2 (snd (strip_comb
                                (lhand (concl st)))) in
                    SUBGOAL_THEN (mk_neg (list_mk_icomb
                                    "isForwardPointer" [el1]))
                      (fun nf -> MP_TAC ho THEN
                         REWRITE_TAC[MP impl nf] THEN
                         STRIP_TAC THEN ASM_REWRITE_TAC[]) THEN
                    REWRITE_TAC[BlockRep_def; isForwardPointer_def] THEN
                    MATCH_REDUCE_TAC THEN REWRITE_TAC[]))) THEN
           (* the pointers: of the block they are its roots, which the
              stack had, and of any other element they are what they
              were *)
           REPEAT GEN_TAC THEN
           W(fun gl ->
             let mem = the_asm (fun c ->
                         let vs,bd = strip_forall c in
                         length vs = 3 && is_eq bd &&
                         hd_is "MEM" (lhand bd)) gl in
             REWRITE_TAC[mem]) THEN
           STRIP_TAC THEN
           W(fun gl ->
             let iso = the_asm (fun c ->
                         let vs,bd = strip_forall c in
                         length vs = 1 && is_eq bd &&
                         hd_is "isSomeDataElement" (lhand bd)) gl in
             REWRITE_TAC[iso]) THEN
           DISJ2_TAC THEN
           TRY (SOLVED
                 (W(fun gl ->
                    let eq = the_asm (fun c -> is_eq c &&
                               hd_is "BlockRep" (lhand c)) gl in
                    MP_TAC eq) THEN
                  REWRITE_TAC[BlockRep_def;
                              injectivity "heap_element"] THEN
                  STRIP_TAC THEN
                  ASM_MESON_TAC[MEM_APPEND])) THEN
           W(fun gl ->
             let ho = REWRITE_RULE[heap_ok_def]
                        (the_asm (hd_is "heap_ok") gl) in
             MP_TAC ho) THEN
           ASM_MESON_TAC[])) THEN
    (* the kind of the collection: this block is not in a heap that a
       generational collection goes through *)
    TRY (SOLVED
          (W(fun gl ->
             let gk = the_asm (hd_is "gc_kind_inv") gl in
             let ng = the_asm (fun c ->
                        let vs,bd = strip_forall c in
                        length vs = 1 && is_neg bd) gl in
             MATCH_ACCEPT_TAC (MATCH_MP gc_kind_not_gen_any
               (CONJ gk ng))))) THEN
    (* the unused space: what the store lemma says, with the length
       of the block taken off the first part of it.  The statement
       says el_length (BlockRep tag rs) of the pointer and of the
       space with two type variables of its own, so both are reduced
       to the length of the block first (entry 61) *)
    W(fun (asl,w as gl) ->
      if not (hd_is "unused_space_inv" w) then ALL_TAC else
      (let us = the_asm (fun c -> hd_is "unused_space_inv" c &&
                  can (find_term (hd_is "-")) c) gl in
       REWRITE_TAC[BlockRep_def; el_length_def] THEN
       MP_TAC (REWRITE_RULE[BlockRep_def; el_length_def] us) THEN
       W(fun (asl,w) ->
         let usub = el 1 (snd (strip_comb (lhand w))) in
         let gsub = el 1 (snd (strip_comb (rand w))) in
         SUBGOAL_THEN (mk_eq (usub, gsub)) ASSUME_TAC THENL
          [ASM_ARITH_TAC; ASM_REWRITE_TAC[]]))) THEN
    (* the maps: the address of the block put into the first one, and
       the timestamps as they were *)
    REWRITE_TAC[bc_stack_ref_inv_def] THEN
    W(fun (asl,w as gl) ->
      let su = the_asm (fun c -> hd_is "SUBSET" c &&
                 hd_is "domain" (rand c)) gl in
      let f = rand (lhand (concl su)) in
      let tfsu = the_asm (fun c -> hd_is "SUBSET" c &&
                   hd_is "all_ts" (rand c)) gl in
      let tf = rand (lhand (concl tfsu)) in
      let st = the_asm (fun c -> is_eq c &&
                 hd_is "heap_store_unused_alt" (lhand c)) gl in
      let aa = el 0 (snd (strip_comb (lhand (concl st)))) in
      let ins = find_term (hd_is "sptree_insert") w in
      let ptr = el 0 (snd (strip_comb ins)) in
      EXISTS_TAC (list_mk_icomb "|+" [f; mk_pair (ptr, aa)]) THEN
      EXISTS_TAC tf) THEN
    REPEAT CONJ_TAC THEN
    TRY (SOLVED (FIRST_ASSUM ACCEPT_TAC)) THEN
    (* the point is fresh in the map, because the references have no
       value for it *)
    W(fun gl ->
      let su = the_asm (fun c -> hd_is "SUBSET" c &&
                 hd_is "domain" (rand c)) gl in
      let nd = the_asm (fun c -> is_neg c && hd_is "IN" (rand c) &&
                 hd_is "domain" (rand (rand c))) gl in
      let fm = rand (lhand (concl su)) in
      let ptr = el 0 (snd (strip_comb (rand (concl nd)))) in
      SUBGOAL_THEN (mk_neg (list_mk_icomb "IN"
                      [ptr; list_mk_icomb "FDOM" [fm]]))
        ASSUME_TAC THENL
       [MP_TAC su THEN MP_TAC nd THEN REWRITE_TAC[SUBSET] THEN
        MESON_TAC[];
        ALL_TAC]) THEN
    (* the addresses of the maps: the one of the block is fresh *)
    W(fun (asl,w as gl) ->
      if not (hd_is "INJ" w) ||
         not (can (find_term (hd_is "|+")) w) then ALL_TAC else
      (let iso = the_asm (fun c ->
                   let vs,bd = strip_forall c in
                   length vs = 1 && is_eq bd &&
                   hd_is "isSomeDataElement" (lhand bd)) gl in
       let inj = the_asm (fun c -> hd_is "INJ" c &&
                   hd_is "fmap_apply" (el 0 (snd (strip_comb c))) &&
                   rand (el 0 (snd (strip_comb c))) =
                     lhand (rand (el 0 (snd (strip_comb w))))) gl in
       let nd = the_asm (fun c -> is_neg c &&
                  hd_is "isSomeDataElement" (rand c)) gl in
       MATCH_MP_TAC INJ_FUPDATE_fresh THEN
       EXISTS_TAC (rand (concl inj)) THEN
       REPEAT CONJ_TAC THEN
       TRY (SOLVED (FIRST_ASSUM ACCEPT_TAC)) THEN
       TRY (SOLVED (MP_TAC nd THEN REWRITE_TAC[IN_ELIM_THM])) THEN
       REWRITE_TAC[IN_ELIM_THM] THEN
       MATCH_ACCEPT_TAC iso)) THEN
    (* the domain of the references has the new point in it *)
    TRY (SOLVED
          (REWRITE_TAC[FDOM_FUPDATE; domain_insert] THEN
           W(fun gl ->
             let su = the_asm (fun c -> hd_is "SUBSET" c &&
                        hd_is "domain" (rand c)) gl in
             MP_TAC su) THEN
           SET_TAC[])) THEN
    (* the timestamps are in the bigger set of addresses *)
    W(fun (asl,w as gl) ->
      if not (hd_is "INJ" w) then ALL_TAC else
      (let iso = the_asm (fun c ->
                   let vs,bd = strip_forall c in
                   length vs = 1 && is_eq bd &&
                   hd_is "isSomeDataElement" (lhand bd)) gl in
       let inj = the_asm (fun c -> hd_is "INJ" c &&
                   el 0 (snd (strip_comb c)) =
                     el 0 (snd (strip_comb w))) gl in
       MATCH_MP_TAC INJ_bigger THEN
       EXISTS_TAC (rand (concl inj)) THEN
       CONJ_TAC THENL
        [ACCEPT_TAC inj;
         REWRITE_TAC[IN_ELIM_THM] THEN
         REWRITE_TAC[iso] THEN MESON_TAC[]])) THEN
    (* the timestamps of the stack with the block on it *)
    TRY (SOLVED
          (MATCH_MP_TAC SUBSET_TRANS THEN
           W(fun gl ->
             let su = the_asm (fun c -> hd_is "SUBSET" c &&
                        hd_is "all_ts" (rand c)) gl in
             let nd = the_asm (fun c -> is_neg c &&
                        hd_is "IN" (rand c) &&
                        hd_is "domain" (rand (rand c))) gl in
             EXISTS_TAC (rand (concl su)) THEN
             CONJ_TAC THENL
              [ACCEPT_TAC su;
               MATCH_ACCEPT_TAC (MATCH_MP
                 (REWRITE_RULE[APPEND_ASSOC] all_ts_mutcons)
                 nd)]))) THEN
    (* and the blocks of the stack stay unique *)
    TRY (SOLVED
          (W(fun gl ->
             let bu = the_asm (hd_is "blocks_unique") gl in
             MATCH_ACCEPT_TAC (MATCH_MP
               (REWRITE_RULE[APPEND_ASSOC] blocks_unique_mutcons)
               bu)))) THEN
    (* the transfer that the allocation leaves: what the invariant
       said of a value it says of it with the block allocated
       (v_inv_MutCons_step) *)
    W(fun (asl,w as gl) ->
      let nd = the_asm (fun c -> is_neg c && hd_is "IN" (rand c) &&
                 hd_is "domain" (rand (rand c))) gl in
      let su = the_asm (fun c -> hd_is "SUBSET" c &&
                 hd_is "domain" (rand c)) gl in
      let hsr = the_asm (hd_is "heap_store_rel") gl in
      let old = the_asm (fun c -> hd_is "ALL2" c &&
                  is_var (el 1 (snd (strip_comb c)))) gl in
      let pred = el 0 (snd (strip_comb (concl old))) in
      let v,b1 = dest_abs pred in
      let x,vtm = dest_abs b1 in
      ASSUME_TAC (GENL [v; x] (DISCH vtm
        (MATCH_MP v_inv_MutCons_step
          (CONJ (ASSUME vtm) (CONJ nd (CONJ su hsr))))))) THEN
    (* and the two other transfers: what a value says of a thunk,
       and what the references hold at another point *)
    W(fun (asl,w as gl) ->
      let nd = the_asm (fun c -> is_neg c && hd_is "IN" (rand c) &&
                 hd_is "domain" (rand (rand c))) gl in
      let ins = find_term (hd_is "sptree_insert") w in
      let iargs = snd (strip_comb ins) in
      let fvs = frees (concl dest_thunk_insert_fresh) in
      let pk n = find (fun u -> fst (dest_var u) = n) fvs in
      let dtf = INST [el 2 iargs, pk "refs"; el 0 iargs, pk "ptr";
                      el 1 iargs, pk "x"] dest_thunk_insert_fresh in
      let hyp = rand (lhand (concl dtf)) in
      ASSUME_TAC (GEN (pk "v")
        (DISCH hyp (MATCH_MP dtf (CONJ nd (ASSUME hyp))))) THEN
      W(fun (asl,w) ->
        let m = genvar `:num` in
        let tr = mk_forall(m,
                   mk_imp(mk_neg (mk_eq (m, el 0 iargs)),
                          mk_eq (list_mk_icomb "sptree_lookup"
                                   [m; ins],
                                 list_mk_icomb "sptree_lookup"
                                   [m; el 2 iargs]))) in
        SUBGOAL_THEN tr ASSUME_TAC THENL
         [REPEAT STRIP_TAC THEN ASM_REWRITE_TAC[lookup_insert];
          ALL_TAC])) THEN
    (* the values of the stack with the pointer of the block on it *)
    W(fun (asl,w) ->
      if not (hd_is "ALL2" w) then ALL_TAC else
      (REWRITE_TAC[ALL2] THEN
       CONV_TAC(TOP_DEPTH_CONV BETA_CONV) THEN
       CONJ_TAC THENL
        [REWRITE_TAC[v_inv_def] THEN DISJ1_TAC THEN
         REWRITE_TAC[FDOM_FUPDATE; IN_INSERT; lookup_insert;
                     FAPPLY_FUPDATE_THM; ref_ptr_annot_def] THEN
         REPEAT CONJ_TAC THEN
         TRY MATCH_REDUCE_TAC THEN
         (let ds = [distinctness "option"; distinctness "bvlSem_ref"] in
          REWRITE_TAC (injectivity "option" ::
                       injectivity "heap_address" ::
                       LENGTH_APPEND :: LENGTH ::
                       ds @ map GSYM ds)) THEN
         TRY (SOLVED (REWRITE_TAC[])) THEN
         TRY (SOLVED (ARITH_TAC)) THEN
         AP_TERM_TAC THEN AP_TERM_TAC THEN ARITH_TAC;
         W(fun gl ->
           let old = the_asm (fun c -> hd_is "ALL2" c &&
                       is_var (el 1 (snd (strip_comb c)))) gl in
           MATCH_ACCEPT_TAC (MATCH_MP EVERY2_v_inv_alloc_stack
             (CONJ (a_vtr gl) old)))])) THEN
    (* and the invariant of each reference that the new stack
       reaches: the point of the block, or one that the old stack
       reached *)
    W(fun (asl,w) ->
      if not (is_forall w) then ALL_TAC else
      (REPEAT STRIP_TAC THEN
       W(fun (asl,w) ->
         let ins = find_term (hd_is "sptree_insert") w in
         let ptr = el 0 (snd (strip_comb ins)) in
         let n = el 1 (snd (strip_comb w)) in
         ASM_CASES_TAC (mk_eq (n, ptr))) THEN
       TRY VAR_EQ_TAC THEN
       W(fun (asl,w) ->
         let n = el 1 (snd (strip_comb w)) in
         let ins = find_term (hd_is "sptree_insert") w in
         if not (n = el 0 (snd (strip_comb ins))) then ALL_TAC else
       (* the point of the block: its element is the block, and no
          timestamp has its address *)
             (W(fun (asl,w as gl) ->
                let ins = find_term (hd_is "sptree_insert") w in
                let iargs = snd (strip_comb ins) in
                let ptr = el 0 iargs in
                let fm = el 0 (tparts (el 3 (snd (strip_comb w)))) in
                let st = the_asm (fun c -> is_eq c &&
                           hd_is "heap_store_unused_alt"
                             (lhand c)) gl in
                let aa = el 0 (snd (strip_comb (lhand (concl st)))) in
                SUBGOAL_THEN (mk_eq (list_mk_icomb "FLOOKUP" [fm; ptr],
                                list_mk_icomb "SOME" [aa]))
                  ASSUME_TAC THENL
                 [REWRITE_TAC[FLOOKUP_UPDATE]; ALL_TAC] THEN
                SUBGOAL_THEN
                  (mk_eq (list_mk_icomb "sptree_lookup" [ptr; ins],
                          list_mk_icomb "SOME" [el 1 iargs]))
                  ASSUME_TAC THENL
                 [REWRITE_TAC[lookup_insert]; ALL_TAC]) THEN
              W(fun gl ->
                let lk1 = the_asm (fun c -> is_eq c &&
                            hd_is "FLOOKUP" (lhand c)) gl in
                let lk2 = the_asm (fun c -> is_eq c &&
                            hd_is "sptree_lookup" (lhand c) &&
                            hd_is "sptree_insert"
                              (rand (lhand c))) gl in
                REWRITE_TAC[MATCH_MP arm_MB (CONJ lk1 lk2)]) THEN
              REWRITE_TAC[APPEND_ASSOC] THEN
              REPEAT CONJ_TAC THEN
              TRY (SOLVED (FIRST_ASSUM ACCEPT_TAC)) THEN
              (* no timestamp has the address of the block, because it
                 held no data *)
              W(fun (asl,w) ->
                if not (is_neg w) ||
                   not (hd_is "IN" (rand w)) then ALL_TAC else
                (REWRITE_TAC[IN_IMAGE] THEN
                 STRIP_TAC THEN
                 W(fun gl ->
                   let inj = the_asm (fun c -> hd_is "INJ" c &&
                               hd_is "fmap_apply"
                                 (el 0 (snd (strip_comb c))) &&
                               not (can (find_term
                                 (hd_is "|+")) c)) gl in
                   let nd = the_asm (fun c -> is_neg c &&
                              hd_is "isSomeDataElement"
                                (rand c)) gl in
                   let eqa = the_asm (fun c -> is_eq c &&
                               hd_is "fmap_apply" (rand c)) gl in
                   let inn = the_asm (fun c -> hd_is "IN" c &&
                               hd_is "FDOM" (rand c)) gl in
                   POP_ASSUM_LIST (K ALL_TAC) THEN
                   MP_TAC (REWRITE_RULE[INJ; IN_ELIM_THM] inj) THEN
                   MP_TAC nd THEN MP_TAC eqa THEN MP_TAC inn THEN
                   MESON_TAC[]))) THEN
              (* and the element is the block, with the values that
                 the stack gave it *)
              W(fun (asl,w as gl) ->
                let hl = the_asm (fun c -> is_eq c &&
                           hd_is "heap_lookup" (lhand c) &&
                           hd_is "SOME" (rand c) &&
                           hd_is "BlockRep" (rand (rand c))) gl in
                let ys1 = el 1 (snd (strip_comb
                            (rand (rand (concl hl))))) in
                let old = the_asm (fun c -> hd_is "ALL2" c &&
                            el 2 (snd (strip_comb c)) = ys1) gl in
                let sw = CONV_RULE(TOP_DEPTH_CONV BETA_CONV)
                           (MATCH_MP EVERY2_SWAP old) in
                EXISTS_TAC ys1 THEN
                CONJ_TAC THENL
                 [ACCEPT_TAC hl;
                  MATCH_ACCEPT_TAC (MATCH_MP EVERY2_v_inv_alloc
                    (CONJ (a_vtr gl) sw))]))) THEN
       W(fun (asl,w) ->
         let n = el 1 (snd (strip_comb w)) in
         let ins = find_term (hd_is "sptree_insert") w in
         if n = el 0 (snd (strip_comb ins)) then ALL_TAC else
       (* and a reference that the old stack reached: it is in the
          domain of the map that the block was not put into *)
       (W(fun (asl,w as gl) ->
                let n = el 1 (snd (strip_comb w)) in
                let innu = the_asm (fun c -> hd_is "IN" c &&
                             hd_is "FDOM" (rand c) &&
                             el 0 (snd (strip_comb c)) = n) gl in
                let fm = lhand (rand (rand (concl innu))) in
                SUBGOAL_THEN (list_mk_icomb "IN"
                                [n; list_mk_icomb "FDOM" [fm]])
                  ASSUME_TAC THENL
                 [MP_TAC innu THEN
                  REWRITE_TAC[FDOM_FUPDATE; IN_INSERT] THEN
                  ASM_MESON_TAC[];
                  ALL_TAC]) THEN
        W(fun (asl,w as gl) ->
                let rr = the_asm (fun c -> hd_is "reachable_refs" c &&
                           hd_is "sptree_insert"
                             (el 1 (snd (strip_comb c)))) gl in
                let neq = the_asm (fun c -> is_neg c &&
                            is_eq (rand c)) gl in
                let nd = the_asm (fun c -> is_neg c &&
                           hd_is "IN" (rand c) &&
                           hd_is "domain" (rand (rand c))) gl in
                ASSUME_TAC (MATCH_MP
                  (REWRITE_RULE[APPEND_ASSOC] reachable_refs_MutCons)
                  (CONJ rr (CONJ neq nd)))) THEN
              W(fun (asl,w as gl) ->
                let n = el 1 (snd (strip_comb w)) in
                let bri = the_asm (fun c ->
                  let vs,bd = strip_forall c in
                  length vs = 1 && is_imp bd &&
                  hd_is "bc_ref_inv" (rand bd)) gl in
                let rr = the_asm (fun c -> hd_is "reachable_refs" c &&
                  not (hd_is "sptree_insert"
                         (el 1 (snd (strip_comb c))))) gl in
                let nin = the_asm (fun c -> hd_is "IN" c &&
                  hd_is "FDOM" (rand c) &&
                  el 0 (snd (strip_comb c)) = n &&
                  not (can (find_term (hd_is "|+")) c)) gl in
                let inv = MP (SPEC n bri) (CONJ rr nin) in
                let neq = the_asm (fun c -> is_neg c &&
                            is_eq (rand c) &&
                            lhand (rand c) = n) gl in
                let hsr = the_asm (hd_is "heap_store_rel") gl in
                let inn = the_asm (fun c -> hd_is "IN" c &&
                            hd_is "FDOM" (rand c) &&
                            el 0 (snd (strip_comb c)) = n &&
                            not (can (find_term (hd_is "|+")) c)) gl in
                (MATCH_MP_TAC (REWRITE_RULE[IMP_IMP]
                   (MATCH_MP (MATCH_MP (MATCH_MP (MATCH_MP
                     (REWRITE_RULE[IMP_CONJ] bc_ref_inv_step)
                     (a_vtr gl)) inn) hsr) inv)) THEN
                 REPEAT CONJ_TAC THEN
                 TRY (SOLVED
                       (ACCEPT_TAC (MATCH_MP (a_ltr gl) neq))) THEN
                 TRY (SOLVED (ACCEPT_TAC (a_dtr gl))) THEN
                 TRY (SOLVED (MESON_TAC[])) THEN
                 ASM_REWRITE_TAC[FLOOKUP_UPDATE])))))) THEN
    ALL_TAC)
### v_inv_Thunk_insert_lemma
(* the thunk that the store wrote holds the new value, and the
   invariant of a value survives it: the induction is the one that
   the lemmas about a change of the refs share
   (V_INV_REFS_TAC_IH), where the induction hypothesis asks for
   everything the lemma asks and for the v_inv of the value.  Of a
   Number, a Word64 or a Block the element is where it was, because
   the element that the store wrote is a thunk and theirs is not
   (the tags differ), and of a reference there are the three cases
   of v_inv: a plain reference is not the thunk of the insert (that
   one is a thunk already) and the refs say of it what they said; a
   thunk is either the one that the insert changes, whose value is
   the new one and whose element is the one the store wrote, or
   another one, whose element the store left (the map of the
   addresses is one to one, so its address is not the one that was
   written); and a thunk whose value the root is was evaluated,
   which the one of the insert is not.  That a value which is no
   thunk of the refs is none of the new refs is the local lemma *)
  ((let hd_is n t =
     (try fst(dest_const(fst(strip_comb t))) = n
      with Failure _ -> false) in
  let grab asl p =
    tryfind (fun (_,th) ->
      if (try p th with Failure _ -> false) then th else fail())
      asl in
  let rl = v_inv_ck_rules in
  let opt = [distinctness "option"; injectivity "option"] in
  let rfs = [distinctness "bvlSem_ref"; injectivity "bvlSem_ref";
             distinctness "dataSem_dest_thunk_ret"] in
  (* a value that is no thunk of the refs is none of the new refs:
     a reference to the thunk that the insert changes was one
     already *)
  let dtp = prove
   (`!u. dest_thunk u refs = NotThunk /\
         lookup ptr refs = SOME (Thunk NotEvaluated v)
         ==> dest_thunk u (insert ptr (Thunk ev h) refs) =
             NotThunk`,
    GEN_TAC THEN CASES_ON_NAME "u" THEN
    ONCE_REWRITE_TAC[dataSem_dest_thunk_def] THEN
    CONV_TAC (ONCE_DEPTH_CONV MATCH_CONV) THEN
    REWRITE_TAC[] THEN STRIP_TAC THEN
    ASM_CASES_TAC `a1:num = ptr` THEN
    ASM_REWRITE_TAC[lookup_insert] THEN
    (* the thunk that the insert changes was a thunk already *)
    SUBGOAL_THEN `F` CONTR_TAC THEN
    FIRST_X_ASSUM (fun dt ->
      if hd_is "_MATCH" (lhand (concl dt)) then MP_TAC dt
      else fail()) THEN
    ASM_REWRITE_TAC[] THEN
    CONV_TAC (ONCE_DEPTH_CONV MATCH_CONV) THEN
    COND_CASES_TAC THEN REWRITE_TAC(opt @ rfs)) in
  (* the address of another reference is not the one of the thunk
     that the store wrote, because the map of the addresses is one
     to one *)
  let addr_ne =
    W(fun (asl,gl) ->
      let inj = grab asl (fun th -> hd_is "INJ" (concl th)) in
      let fd = CONJUNCT2 (REWRITE_RULE[INJ] inj) in
      let nn = rand (lhand (dest_neg gl)) in
      MP_TAC (SPECL [nn; `ptr:num`] fd) THEN
      ASM_REWRITE_TAC[] THEN CONV_TAC TAUT) in
  (* a lookup of the old heap is one of the new heap, away from
     the thunk that the store wrote: away from it because the
     element there is a thunk and the elements of the cases are
     not *)
  let notp =
    DISCH_TAC THEN FIRST_X_ASSUM SUBST_ALL_TAC THEN
    FIRST_ASSUM (fun thk ->
      if not (hd_is "ThunkBlock" (rand (rhs (concl thk))))
      then fail() else
      FIRST_ASSUM (fun l ->
        if concl l = concl thk then fail() else
        MP_TAC (TRANS (SYM l) thk))) THEN
    REWRITE_TAC[injectivity "option"; ThunkBlock_def; bignum_def;
                Word64Rep_def; BlockRep_def] THEN
    TRY PAIRARG_TAC THEN
    CONV_TAC (TOP_DEPTH_CONV let_CONV) THEN
    TRY COND_CASES_TAC THEN
    REWRITE_TAC[injectivity "heap_element"; PAIR_EQ;
                distinctness "data_to_word_memoryProof_tag"] in
  let hp =
    FIRST_ASSUM (fun pres ->
      MATCH_MP_TAC pres THEN CONJ_TAC THENL
       [notp; FIRST_ASSUM MATCH_ACCEPT_TAC]) in
  (* the induction hypothesis, which asks for the v_inv of the
     value and for everything the lemma asks *)
  let ih_tac =
    W(fun (asl,gl) ->
      let nz = grab asl (fun th ->
        try is_neg (concl th) && is_eq (rand (concl th)) &&
            rhs (rand (concl th)) = `0`
        with Failure _ -> false) in
      let ck = lhs (rand (concl nz)) in
      let lt = MP (SPEC ck (ARITH_RULE
                 `!n. ~(n = 0) ==> n - 1 < n`)) nz in
      let ih = grab asl (fun th ->
        try is_forall (concl th) &&
            hd_is "<" (lhand (body (rand (concl th))))
        with Failure _ -> false) in
      let ih' = MP (SPEC (mk_binop `(-):num->num->num` ck `1`) ih)
                  lt in
      let big = grab asl (fun th -> is_conj (concl th)) in
      FIRST_ASSUM (fun vi ->
        if not (hd_is "v_inv" (concl vi)) then fail() else
        ACCEPT_TAC (MATCH_MP ih' (CONJ vi big)))) in
  (* the lemma's own hypotheses, one by one *)
  let prep =
    FIRST_ASSUM (fun ds ->
      if is_conj (concl ds) then MAP_EVERY ASSUME_TAC (CONJUNCTS ds)
      else fail()) in
  (* a plain reference is not the thunk that the insert changes, so
     the refs say of it what they said *)
  let d5 =
    REPEAT SUBST_LHS_TAC THEN
    W(fun (asl,gl) ->
      let nn = rand (el 2 (snd (strip_comb gl))) in
      let nq = mk_neg (mk_eq (nn, `ptr:num`)) in
      SUBGOAL_THEN nq ASSUME_TAC THENL
       [DISCH_TAC THEN FIRST_X_ASSUM SUBST_ALL_TAC THEN
        ASM_MESON_TAC[];
        ALL_TAC]) THEN
    W(fun (asl,gl) ->
      let nn = rand (el 2 (snd (strip_comb gl))) in
      let nq = mk_neg (mk_eq (nn, `ptr:num`)) in
      let lkeq = MP (prove (mk_imp (nq,
                    mk_eq (list_mk_icomb "sptree_lookup"
                      [nn; el 3 (snd (strip_comb gl))],
                      list_mk_icomb "sptree_lookup"
                        [nn; `refs:(dataSem_v bvlSem_ref) spt`])),
                    DISCH_TAC THEN REWRITE_TAC[lookup_insert] THEN
                    ASM_REWRITE_TAC[])) (ASSUME nq) in
      SUBST1_TAC (SYM lkeq) THEN
      MATCH_MP_TAC (el 4 rl) THEN
      ASM_REWRITE_TAC[lkeq]) in
  (* the thunk of a reference: the one that the insert changes
     holds the new value, whose v_inv the lemma gives, and another
     one holds what it held, at an address that the store left *)
  let d6 =
    NOT_VAR_TAC THEN REPEAT SUBST_LHS_TAC THEN
    W(fun (asl,gl) ->
      let nn = rand (el 2 (snd (strip_comb gl))) in
      ASM_CASES_TAC (mk_eq (nn, `ptr:num`))) THEN
    POP_ASSUM (fun pq ->
      if is_neg (concl pq) then ASSUME_TAC pq else
      SUBST_ALL_TAC pq) THENL
     [(* the thunk that the insert changes *)
      FIRST_ASSUM (fun lk ->
        if not (try hd_is "sptree_lookup" (lhs (concl lk)) &&
                    lhand (lhs (concl lk)) = `ptr:num`
                with Failure _ -> false) then fail() else
        FIRST_ASSUM (fun lk2 ->
          if concl lk2 = concl lk then fail() else
          if not (try hd_is "sptree_lookup" (lhs (concl lk2)) &&
                      lhand (lhs (concl lk2)) = `ptr:num`
                  with Failure _ -> false) then fail() else
          MP_TAC (TRANS (SYM lk2) lk))) THEN
      REWRITE_TAC(opt @ rfs) THEN
      DISCH_THEN (REPEAT_TCL CONJUNCTS_THEN
        (fun th -> TRY (SUBST_ALL_TAC (SYM th)))) THEN
      MATCH_MP_TAC (el 5 rl) THEN
      W(fun (asl,gl) ->
        (* the element that the store wrote, whose mode is the
           variable of the statement *)
        let hl2 = grab asl (fun th ->
          try hd_is "heap_lookup" (lhs (concl th)) &&
              hd_is "ThunkBlock" (rand (rhs (concl th))) &&
              is_var (el 0 (snd (strip_comb
                (rand (rhs (concl th))))))
          with Failure _ -> false) in
        let tbs = snd (strip_comb (rand (rhs (concl hl2)))) in
        let ins = find_term (hd_is "sptree_insert") gl in
        let thk = el 1 (snd (strip_comb ins)) in
        MAP_EVERY EXISTS_TAC
          [el 0 tbs; rand thk; el 1 tbs]) THEN
      REPEAT CONJ_TAC THENL
       [REWRITE_TAC[lookup_insert];
        DISCH_TAC THEN
        FIRST_ASSUM (fun dt ->
          if not (is_imp (concl dt)) then fail() else
          MATCH_MP_TAC dtp THEN CONJ_TAC THENL
           [MATCH_MP_TAC dt THEN FIRST_ASSUM MATCH_ACCEPT_TAC;
            FIRST_ASSUM MATCH_ACCEPT_TAC]);
        FIRST_ASSUM MATCH_ACCEPT_TAC;
        FIRST_ASSUM MATCH_ACCEPT_TAC;
        DISCH_TAC THEN ih_tac];
      (* another reference, whose element the store left *)
      MATCH_MP_TAC (el 5 rl) THEN
      W(fun (asl,gl) ->
        let lk = grab asl (fun th ->
          try hd_is "sptree_lookup" (lhs (concl th)) &&
              hd_is "bvlSem_Thunk" (rand (rhs (concl th)))
          with Failure _ -> false) in
        let hl = grab asl (fun th ->
          try hd_is "heap_lookup" (lhs (concl th)) &&
              hd_is "ThunkBlock" (rand (rhs (concl th))) &&
              not (rand (lhand (lhs (concl th))) = `ptr:num`)
          with Failure _ -> false) in
        MAP_EVERY EXISTS_TAC
          [lhand (rand (rhs (concl lk)));
           rand (rand (rhs (concl lk)));
           rand (rand (rhs (concl hl)))]) THEN
      REPEAT CONJ_TAC THENL
       [W(fun (asl,gl) ->
          REWRITE_TAC[lookup_insert] THEN
          ASM_REWRITE_TAC[] THEN FIRST_ASSUM MATCH_ACCEPT_TAC);
        DISCH_TAC THEN
        MATCH_MP_TAC dtp THEN CONJ_TAC THENL
         [FIRST_ASSUM (fun dt ->
            if not (is_imp (concl dt)) then fail() else
            MATCH_MP_TAC dt THEN FIRST_ASSUM MATCH_ACCEPT_TAC);
          FIRST_ASSUM MATCH_ACCEPT_TAC];
        FIRST_ASSUM MATCH_ACCEPT_TAC;
        FIRST_ASSUM (fun pres ->
          MATCH_MP_TAC pres THEN CONJ_TAC THENL
           [addr_ne; FIRST_ASSUM MATCH_ACCEPT_TAC]);
        DISCH_TAC THEN ih_tac]] in
  (* and the thunk whose value the root is: it is not the one that
     the insert changes, because that one is not evaluated *)
  let d7 =
    NOT_VAR_TAC THEN REPEAT SUBST_LHS_TAC THEN
    W(fun (asl,gl) ->
      let nn = rand (el 2 (snd (strip_comb gl))) in
      let nq = mk_neg (mk_eq (nn, `ptr:num`)) in
      SUBGOAL_THEN nq ASSUME_TAC THENL
       [DISCH_TAC THEN FIRST_X_ASSUM SUBST_ALL_TAC THEN
        FIRST_ASSUM (fun lk ->
          if not (try hd_is "sptree_lookup" (lhs (concl lk)) &&
                      hd_is "bvlSem_Thunk" (rand (rhs (concl lk)))
                  with Failure _ -> false) then fail() else
          FIRST_ASSUM (fun lk2 ->
            if concl lk2 = concl lk then fail() else
            if not (try hd_is "sptree_lookup" (lhs (concl lk2)) &&
                        hd_is "bvlSem_Thunk"
                          (rand (rhs (concl lk2)))
                    with Failure _ -> false) then fail() else
            MP_TAC (TRANS (SYM lk2) lk))) THEN
        REWRITE_TAC(opt @ rfs) THEN
        REWRITE_TAC[distinctness "thunk_mode"];
        ALL_TAC]) THEN
    MATCH_MP_TAC (el 6 rl) THEN
    W(fun (asl,gl) ->
      let lk = grab asl (fun th ->
        try hd_is "sptree_lookup" (lhs (concl th)) &&
            hd_is "bvlSem_Thunk" (rand (rhs (concl th)))
        with Failure _ -> false) in
      EXISTS_TAC (rand (rand (rhs (concl lk))))) THEN
    REPEAT CONJ_TAC THENL
     [REWRITE_TAC[lookup_insert] THEN
      ASM_REWRITE_TAC[] THEN FIRST_ASSUM MATCH_ACCEPT_TAC;
      MATCH_MP_TAC dtp THEN CONJ_TAC THEN
      FIRST_ASSUM MATCH_ACCEPT_TAC;
      DISCH_TAC THEN ih_tac] in
  V_INV_REFS_TAC_IH ih_tac (FIRST_ASSUM MATCH_ACCEPT_TAC) prep hp
    d5 d6 d7))
### update_ref_thm
  (* the steps that this proof and the three after it take are
     above the statement (tools/overrides.py).  The roots split
     where the pointer of the reference is, the store writes the
     new values into its element, and the heap and the references
     are then as good as they were; of the reference written the
     invariant is the array of the new values and of any other one
     its element, which the store did not touch *)
  (STRIP_TAC THEN
   (* what the invariant says of the stack with the pointer in it *)
   FIRST_X_ASSUM (fun inv ->
     if not (hd_is "abs_ml_inv" (concl inv)) then fail() else
     STRIP_ASSUME_TAC (REWRITE_RULE[abs_ml_inv_def;
                                    bc_stack_ref_inv_def] inv)) THEN
   (* the roots split where the pointer is *)
   FIRST_ASSUM (fun lr ->
     if not (hd_is "ALL2" (concl lr)) then fail() else
     STRIP_ASSUME_TAC (MATCH_MP EVERY2_APPEND_CONS lr)) THEN
   RULE_ASSUM_TRY (CONV_RULE(TOP_DEPTH_CONV BETA_CONV)) THEN
   (* and the root of the pointer is the address of its reference *)
   FIRST_ASSUM (fun vr ->
     let c = concl vr in
     if not (hd_is "v_inv" c) ||
        not (hd_is "dataSem_RefPtr"
               (el 1 (snd (strip_comb c))))
        then fail()
     else STRIP_ASSUME_TAC (REWRITE_RULE[v_inv_def] vr)) THEN
   RULE_ASSUM_TRY (REWRITE_RULE ref_rws) THEN
   ASM_FS_TAC THEN
   RULE_ASSUM_TRY (REWRITE_RULE ref_rws) THEN
   TRY (FIRST_ASSUM CONTR_TAC) THEN
   SPLIT_ASM_TAC THEN
   (* the reference has an address, and it is reachable, so the
      invariant holds of it *)
   SUBGOAL_THEN (cake_as_vars (fun () ->
     `FLOOKUP (f:(num,num)fmap) (ptr:num) = SOME (FAPPLY f ptr:num)`))
     ASSUME_TAC THENL
    [ASM_REWRITE_TAC[FLOOKUP_DEF]; ALL_TAC] THEN
   SUBGOAL_THEN (cake_as_vars (fun () ->
     `reachable_refs (xs ++ (RefPtr b ptr :: stack)) refs ptr`))
     ASSUME_TAC THENL
    [FIRST
      [SOLVED (MATCH_MP_TAC (GEN_ALL reach_refptr) THEN
               REWRITE_TAC[MEM_APPEND; MEM]);
       SOLVED (MATCH_MP_TAC (GEN_ALL reach_refptr) THEN
               EXISTS_TAC `b:bool` THEN
               REWRITE_TAC[MEM_APPEND; MEM]);
       SOLVED (REWRITE_TAC[reachable_refs_def] THEN
               EXISTS_TAC (cake_as_vars (fun () ->
                 `RefPtr b ptr:dataSem_v`)) THEN
               EXISTS_TAC `ptr:num` THEN
               REWRITE_TAC[MEM_APPEND; MEM; get_refs_def] THEN
               MESON_TAC[RTC_RULES])];
     ALL_TAC] THEN
   FIRST_ASSUM (fun bri ->
     let bd = snd (strip_forall (concl bri)) in
     if not (is_imp bd) || not (hd_is "bc_ref_inv" (rand bd))
     then fail() else MP_TAC (SPEC `ptr:num` bri)) THEN
   (ANTS_TAC THENL
     [CONJ_TAC THEN FIRST_ASSUM ACCEPT_TAC; ALL_TAC]) THEN
   (* which is the arm of a ValueArray *)
   W(fun gl ->
     let lk1 = the_asm (fun c -> is_eq c &&
                 hd_is "FLOOKUP" (lhand c)) gl in
     let lk2 = the_asm (fun c -> is_eq c &&
                 hd_is "sptree_lookup" (lhand c)) gl in
     DISCH_THEN (fun inv ->
       STRIP_ASSUME_TAC
         (REWRITE_RULE[MATCH_MP arm_VA (CONJ lk1 lk2)] inv))) THEN
   (* the lengths of the array, of its values and of their roots *)
   ASSUM_LIST (fun l -> MAP_EVERY ASSUME_TAC
     (mapfilter (MATCH_MP LIST_REL_LENGTH) l)) THEN
   (* the store of the new values into the reference *)
   W(fun gl ->
     let sp = the_asm (fun c -> is_eq c &&
                hd_is "APPEND" (rand c)) gl in
     let t1 = lhand (rand (concl sp)) in
     let hl = the_asm (fun c -> is_eq c &&
                hd_is "heap_lookup" (lhand c) &&
                can (fun t -> hd_is "RefBlock" (rand t)) (rand c)) gl in
     let zs = rand (rand (rand (concl hl))) in
     SUBGOAL_THEN (mk_eq (list_mk_icomb "LENGTH" [zs],
                          list_mk_icomb "LENGTH" [t1]))
       (fun le -> STRIP_ASSUME_TAC
         (MATCH_MP heap_store_RefBlock (CONJ le hl)) THEN
         ASSUME_TAC le THEN ASSUME_TAC (SYM le)) THENL
      [POP_ASSUM_LIST (fun l -> MAP_EVERY ASSUME_TAC (filter
         (fun t -> let c = concl t in
            is_eq c && (hd_is "LENGTH" (lhand c) ||
                        hd_is "LENGTH" (rand c))) l)) THEN
       ASM_ARITH_TAC;
       ALL_TAC]) THEN
   (* the witnesses: the address of the reference, the roots of the
      new values, the rest of the roots and the new heap *)
   W(fun gl ->
     let sp = the_asm (fun c -> is_eq c &&
                hd_is "APPEND" (rand c)) gl in
     let t1 = lhand (rand (concl sp)) in
     let t2 = rand (rand (rand (concl sp))) in
     let pt = the_asm (fun c -> is_eq c &&
                hd_is "gc_shared_Pointer" (rand c)) gl in
     let p = lhand (rand (concl pt)) in
     let u = rand (rand (concl pt)) in
     let st = the_asm (fun c -> is_eq c &&
                hd_is "heap_store" (lhand c)) gl in
     let h2 = lhand (rand (concl st)) in
     MAP_EVERY EXISTS_TAC [p; t1; t2; h2; u]) THEN
   REPEAT CONJ_TAC THEN
   TRY (SOLVED (ASM_REWRITE_TAC[])) THEN
   (* and the invariant of the new heap and references *)
   REWRITE_TAC[abs_ml_inv_def; bc_stack_ref_inv_def] THEN
   REPEAT CONJ_TAC THEN TRY (SOLVED (ASM_REWRITE_TAC[])) THEN
   (* the roots and the heap are as good as they were *)
   (* the roots are the ones of the split *)
   W(fun gl ->
     let sp = the_asm (fun c -> is_eq c &&
                hd_is "APPEND" (rand c)) gl in
     ONCE_REWRITE_TAC[sp]) THEN
   TRY (SOLVED
         (W(fun gl ->
            let iso = the_asm (fun c ->
              let bd = snd (strip_forall c) in
              is_eq bd && hd_is "isSomeDataElement" (lhand bd)) gl in
            let ro = the_asm (hd_is "roots_ok") gl in
            ACCEPT_TAC (MATCH_MP roots_ok_iso (CONJ ro iso))))) THEN
   TRY (SOLVED
         (W(fun gl ->
            let sp = the_asm (fun c -> is_eq c &&
                       hd_is "APPEND" (rand c)) gl in
            let iso = the_asm (fun c ->
              let bd = snd (strip_forall c) in
              is_eq bd && hd_is "isSomeDataElement" (lhand bd)) gl in
            let ro = REWRITE_RULE[sp] (the_asm (hd_is "roots_ok") gl) in
            let ho = the_asm (hd_is "heap_ok") gl in
            let hlen = the_asm (fun c -> is_eq c &&
                         hd_is "heap_length" (lhand c)) gl in
            let flt = the_asm (fun c -> is_eq c &&
                        hd_is "FILTER" (lhand c)) gl in
            let mm = the_asm (fun c ->
              let bd = snd (strip_forall c) in
              is_imp bd && is_disj (rand bd)) gl in
            ACCEPT_TAC (MATCH_MP heap_ok_store_ref
              (CONJ ho (CONJ ro (CONJ iso (CONJ hlen
                (CONJ flt mm))))))))) THEN
   (* and the unused space is where it was *)
   TRY (SOLVED
         (W(fun gl ->
            let us = the_asm (hd_is "unused_space_inv") gl in
            let ri = the_asm (hd_is "RefBlock_inv") gl in
            let hlen = the_asm (fun c -> is_eq c &&
                         hd_is "heap_length" (lhand c)) gl in
            let st = the_asm (fun c -> is_eq c &&
                       hd_is "heap_store" (lhand c)) gl in
            ACCEPT_TAC (MATCH_MP unused_store_ref
              (CONJ us (CONJ ri (CONJ hlen st))))))) THEN
   (* the kind of the collection: the store is above the nursery and
      writes a reference where one was (gc_kind_store_ref) *)
   TRY (SOLVED
         (W(fun gl ->
            let gk = the_asm (hd_is "gc_kind_inv") gl in
            let st = the_asm (fun c -> is_eq c &&
                       hd_is "heap_store" (lhand c)) gl in
            let hl = the_asm (fun c -> is_eq c &&
                       hd_is "heap_lookup" (lhand c) &&
                       can (fun t -> hd_is "RefBlock" (rand t))
                         (rand c) &&
                       el 1 (snd (strip_comb (lhand c))) =
                         el 2 (snd (strip_comb
                                  (lhand (concl st))))) gl in
            let zs = rand (rand (rand (concl hl))) in
            let len = the_asm (fun c -> is_eq c &&
                        hd_is "LENGTH" (lhand c) &&
                        rand c = list_mk_icomb "LENGTH" [zs]) gl in
            MATCH_ACCEPT_TAC (MATCH_MP gc_kind_store_ref
              (CONJ gk (CONJ st (CONJ hl len))))))) THEN
   (* the maps of the new invariant: the addresses are the ones they
      were, and the timestamps are cut to the ones of the new
      references and stack *)
   W(fun (asl,w as gl) ->
     if not (is_exists w) then ALL_TAC else
     (let sub p = rand (lhand (concl (the_asm (fun c ->
        hd_is "SUBSET" c && hd_is p (rand c)) gl))) in
      let ats = find_term (hd_is "all_ts") w in
      EXISTS_TAC (sub "domain") THEN
      EXISTS_TAC (list_mk_icomb "DRESTRICT" [sub "all_ts"; ats]))) THEN
   REPEAT CONJ_TAC THEN TRY (SOLVED (FIRST_ASSUM ACCEPT_TAC)) THEN
   (* the addresses of the maps are the ones of the old heap *)
   TRY (SOLVED
         (W(fun gl ->
            let iso = the_asm (fun c ->
              let bd = snd (strip_forall c) in
              is_eq bd && hd_is "isSomeDataElement" (lhand bd)) gl in
            ONCE_REWRITE_TAC[iso]) THEN
          FIRST [SOLVED (FIRST_ASSUM ACCEPT_TAC);
                 SOLVED (W(fun (asl,w as gl) ->
                   let dr = find_term (hd_is "DRESTRICT") w in
                   let inj = the_asm (fun c -> hd_is "INJ" c &&
                     rand (el 0 (snd (strip_comb c))) = lhand dr) gl in
                   MATCH_ACCEPT_TAC
                     (MATCH_MP INJ_DRESTRICT inj)))])) THEN
   (* the domain of the references has the key in it *)
   TRY (SOLVED
         (REWRITE_TAC[domain_insert] THEN
          MATCH_MP_TAC SUBSET_TRANS THEN
          W(fun gl ->
            let su = the_asm (fun c -> hd_is "SUBSET" c &&
                       hd_is "domain" (rand c)) gl in
            EXISTS_TAC (rand (concl su))) THEN
          CONJ_TAC THEN TRY (FIRST_ASSUM ACCEPT_TAC) THEN
          SET_TAC[])) THEN
   (* the timestamps of the restricted map are of the stack, and
      below the counter *)
   TRY (SOLVED
         (REWRITE_TAC[(CONJUNCT1 o SPEC_ALL) DRESTRICT_DEF] THEN
          FIRST [SOLVED (REWRITE_TAC[INTER_SUBSET]);
                 SOLVED (MATCH_MP_TAC SUBSET_TRANS THEN
                         W(fun gl ->
                           let su = the_asm (fun c ->
                             hd_is "SUBSET" c &&
                             hd_is "FDOM" (lhand c)) gl in
                           EXISTS_TAC (lhand (concl su))) THEN
                         CONJ_TAC THEN
                         TRY (FIRST_ASSUM ACCEPT_TAC) THEN
                         REWRITE_TAC[INTER_SUBSET])])) THEN
   (* the blocks of the stack stay unique *)
   TRY (SOLVED
         (W(fun gl ->
            let bu = the_asm (hd_is "blocks_unique") gl in
            ACCEPT_TAC (MATCH_MP blocks_unique_update_ref bu)))) THEN
   (* the values of the stack: the update of the reference and the
      cut of the timestamps leave what the invariant says of them
      (v_inv_update_ref) *)
   W(fun (asl,w) -> if not (hd_is "ALL2" w) then ALL_TAC else
         (MATCH_MP_TAC EVERY2_MEM_MONO THEN
          W(fun (asl,w as gl) ->
            let bod = snd (strip_exists w) in
            let l1 = el 1 (snd (strip_comb (last (conjuncts bod)))) in
            let old = the_asm (fun c -> hd_is "ALL2" c &&
                        el 1 (snd (strip_comb c)) = l1) gl in
            EXISTS_TAC (el 0 (snd (strip_comb (concl old))))) THEN
          CONJ_TAC THENL
           [REPEAT GEN_TAC THEN
            CONV_TAC(TOP_DEPTH_CONV BETA_CONV) THEN
            STRIP_TAC THEN
            W(fun (asl,w as gl) ->
              let gargs = snd (strip_comb w) in
              let x = el 1 gargs in
              let y = el 0 (tparts (el 3 gargs)) in
              let vi = the_asm (fun c -> hd_is "v_inv" c &&
                         el 1 (snd (strip_comb c)) = x &&
                         el 0 (tparts (el 3 (snd (strip_comb c))))
                           = y) gl in
              let ri = the_asm (hd_is "RefBlock_inv") gl in
              let lk = the_asm (fun c -> is_eq c &&
                         hd_is "sptree_lookup" (lhand c)) gl in
              let mz = the_asm (fun c -> hd_is "MEM" c &&
                         hd_is "ZIP" (rand c)) gl in
              let l1 = el 0 (snd (strip_comb (rand (concl mz)))) in
              let le = the_asm (fun c -> is_eq c &&
                         lhand c = list_mk_icomb "LENGTH" [l1]) gl in
              MATCH_ACCEPT_TAC (MATCH_MP v_inv_update_ref
                (CONJ ri (CONJ lk (CONJ vi
                  (MATCH_MP mem_zip_left (CONJ le mz)))))));
            FIRST_ASSUM ACCEPT_TAC])) THEN
   (* and the invariant of each reference that the stack reaches:
      it was reachable before the update (reachable_refs_UPDATE) *)
   W(fun (asl,w) -> if not (is_forall w) then ALL_TAC else
     (REPEAT STRIP_TAC THEN
      FIRST_X_ASSUM (fun rr ->
        if not (hd_is "reachable_refs" (concl rr)) then fail() else
        ASSUME_TAC (MATCH_MP reachable_refs_UPDATE rr)) THEN
      (* what the old invariant says of it *)
      W(fun (asl,w as gl) ->
        let n = el 1 (snd (strip_comb w)) in
        let bri = the_asm (fun c ->
          let vs,bd = strip_forall c in
          length vs = 1 && is_imp bd &&
          hd_is "bc_ref_inv" (rand bd)) gl in
        let rr = the_asm (fun c -> hd_is "reachable_refs" c &&
          not (hd_is "sptree_insert"
                 (el 1 (snd (strip_comb c))))) gl in
        let nin = the_asm (fun c -> hd_is "IN" c &&
          hd_is "FDOM" (rand c) &&
          el 0 (snd (strip_comb c)) = n) gl in
        ASSUME_TAC (MP (SPEC n bri) (CONJ rr nin))) THEN
      (* the reference written, or another one *)
      W(fun (asl,w as gl) ->
        ASM_CASES_TAC (mk_eq (el 1 (snd (strip_comb w)),
                              g_ptr gl))) THEN
      TRY VAR_EQ_TAC THEN
      (* the one written: its values are the new ones
         (bc_ref_inv_update_ref_at) *)
      TRY (SOLVED
            (W(fun gl ->
               let lk1 = the_asm (fun c -> is_eq c &&
                           hd_is "FLOOKUP" (lhand c)) gl in
               let hl2 = a_hlnew gl in
               let rs = rand (rand (rand (concl hl2))) in
               let ev = CONV_RULE(TOP_DEPTH_CONV BETA_CONV)
                          (MATCH_MP EVERY2_SWAP
                            (the_asm (fun c -> hd_is "ALL2" c &&
                               el 2 (snd (strip_comb c)) = rs) gl)) in
               MATCH_ACCEPT_TAC (MATCH_MP bc_ref_inv_update_ref_at
                 (CONJ (a_ri gl) (CONJ lk1 (CONJ hl2
                   (CONJ (a_lkptr gl) ev)))))))) THEN
      (* another one: its element did not move, because the store
         only touched the address of the one written
         (bc_ref_inv_update_ref_other) *)
      TRY (SOLVED
            (W(fun (asl,w as gl) ->
               let fm = el 0 (tparts (el 3 (snd (strip_comb w)))) in
               let inj = the_asm (fun c -> hd_is "INJ" c &&
                           rand (el 0 (snd (strip_comb c))) = fm) gl in
               let pin = the_asm (fun c -> hd_is "IN" c &&
                           hd_is "FDOM" (rand c) &&
                           el 0 (snd (strip_comb c)) = g_ptr gl) gl in
               let neq = the_asm (fun c -> is_neg c && is_eq (rand c) &&
                           rand (rand c) = g_ptr gl) gl in
               let inv = the_asm (fun c -> hd_is "bc_ref_inv" c) gl in
               MATCH_ACCEPT_TAC (MATCH_MP bc_ref_inv_update_ref_other
                 (CONJ inj (CONJ pin (CONJ neq (CONJ (a_ri gl)
                   (CONJ (a_tr gl) (CONJ (a_lkptr gl) inv)))))))))) THEN
      ALL_TAC)))
### update_ref_thm1
  (* the steps are above the statement and above update_ref_thm
     (tools/overrides.py).  The proof is the one of update_ref_thm
     with the store of one value in place of the store of the whole
     array: the element keeps its values but the one written, whose
     root is the head of the roots of the stack's values, and the
     array of the new references keeps its values but that one *)
  (STRIP_TAC THEN
   (* what the invariant says of the stack with the pointer in it *)
   FIRST_X_ASSUM (fun inv ->
     if not (hd_is "abs_ml_inv" (concl inv)) then fail() else
     STRIP_ASSUME_TAC (REWRITE_RULE[abs_ml_inv_def;
                                    bc_stack_ref_inv_def] inv)) THEN
   (* the roots split where the pointer is *)
   FIRST_ASSUM (fun lr ->
     if not (hd_is "ALL2" (concl lr)) then fail() else
     STRIP_ASSUME_TAC (MATCH_MP EVERY2_APPEND_CONS lr)) THEN
   RULE_ASSUM_TRY (CONV_RULE(TOP_DEPTH_CONV BETA_CONV)) THEN
   (* and the root of the pointer is the address of its reference *)
   FIRST_ASSUM (fun vr ->
     let c = concl vr in
     if not (hd_is "v_inv" c) ||
        not (hd_is "dataSem_RefPtr"
               (el 1 (snd (strip_comb c))))
        then fail()
     else STRIP_ASSUME_TAC (REWRITE_RULE[v_inv_def] vr)) THEN
   RULE_ASSUM_TRY (REWRITE_RULE ref_rws) THEN
   ASM_FS_TAC THEN
   RULE_ASSUM_TRY (REWRITE_RULE ref_rws) THEN
   TRY (FIRST_ASSUM CONTR_TAC) THEN
   SPLIT_ASM_TAC THEN
   (* the reference has an address, and it is reachable, so the
      invariant holds of it *)
   SUBGOAL_THEN (cake_as_vars (fun () ->
     `FLOOKUP (f:(num,num)fmap) (ptr:num) = SOME (FAPPLY f ptr:num)`))
     ASSUME_TAC THENL
    [ASM_REWRITE_TAC[FLOOKUP_DEF]; ALL_TAC] THEN
   SUBGOAL_THEN (cake_as_vars (fun () ->
     `reachable_refs (xs ++ (RefPtr b ptr :: stack)) refs ptr`))
     ASSUME_TAC THENL
    [FIRST
      [SOLVED (MATCH_MP_TAC (GEN_ALL reach_refptr) THEN
               REWRITE_TAC[MEM_APPEND; MEM]);
       SOLVED (MATCH_MP_TAC (GEN_ALL reach_refptr) THEN
               EXISTS_TAC `b:bool` THEN
               REWRITE_TAC[MEM_APPEND; MEM]);
       SOLVED (REWRITE_TAC[reachable_refs_def] THEN
               EXISTS_TAC (cake_as_vars (fun () ->
                 `RefPtr b ptr:dataSem_v`)) THEN
               EXISTS_TAC `ptr:num` THEN
               REWRITE_TAC[MEM_APPEND; MEM; get_refs_def] THEN
               MESON_TAC[RTC_RULES])];
     ALL_TAC] THEN
   FIRST_ASSUM (fun bri ->
     let bd = snd (strip_forall (concl bri)) in
     if not (is_imp bd) || not (hd_is "bc_ref_inv" (rand bd))
     then fail() else MP_TAC (SPEC `ptr:num` bri)) THEN
   (ANTS_TAC THENL
     [CONJ_TAC THEN FIRST_ASSUM ACCEPT_TAC; ALL_TAC]) THEN
   (* which is the arm of a ValueArray *)
   W(fun gl ->
     let lk1 = the_asm (fun c -> is_eq c &&
                 hd_is "FLOOKUP" (lhand c)) gl in
     let lk2 = the_asm (fun c -> is_eq c &&
                 hd_is "sptree_lookup" (lhand c)) gl in
     DISCH_THEN (fun inv ->
       STRIP_ASSUME_TAC
         (REWRITE_RULE[MATCH_MP arm_VA (CONJ lk1 lk2)] inv))) THEN
   (* the lengths of the array, of its values and of their roots *)
   ASSUM_LIST (fun l -> MAP_EVERY ASSUME_TAC
     (mapfilter (MATCH_MP LIST_REL_LENGTH) l)) THEN
   (* the roots of the stack's values are not empty either *)
   W(fun gl ->
     let sp = the_asm (fun c -> is_eq c &&
                hd_is "APPEND" (rand c)) gl in
     let t1 = lhand (rand (concl sp)) in
     SUBGOAL_THEN (list_mk_icomb "<"
                     [`0`; list_mk_icomb "LENGTH" [t1]])
       ASSUME_TAC THENL
      [POP_ASSUM_LIST (fun l -> MAP_EVERY ASSUME_TAC (filter
         (fun t -> let c = concl t in
            (is_eq c && (hd_is "LENGTH" (lhand c) ||
                         hd_is "LENGTH" (rand c))) ||
            hd_is "<" c) l)) THEN
       ASM_ARITH_TAC;
       ALL_TAC]) THEN
   (* the store of the new value into its place in the element *)
   W(fun (asl,w as gl) ->
     let sp = the_asm (fun c -> is_eq c &&
                hd_is "APPEND" (rand c)) gl in
     let t1 = lhand (rand (concl sp)) in
     let hl = the_asm (fun c -> is_eq c &&
                hd_is "heap_lookup" (lhand c) &&
                can (fun t -> hd_is "RefBlock" (rand t)) (rand c)) gl in
     let zs = rand (rand (rand (concl hl))) in
     let i = el 1 (snd (strip_comb
               (find_term (hd_is "LUPDATE") w))) in
     let ws = list_mk_icomb "LUPDATE"
                [list_mk_icomb "HD" [t1]; i; zs] in
     SUBGOAL_THEN (mk_eq (list_mk_icomb "LENGTH" [zs],
                          list_mk_icomb "LENGTH" [ws]))
       (fun le -> STRIP_ASSUME_TAC
         (MATCH_MP heap_store_RefBlock (CONJ le hl)) THEN
         ASSUME_TAC le THEN ASSUME_TAC (SYM le)) THENL
      [REWRITE_TAC[LENGTH_LUPDATE];
       ALL_TAC]) THEN
   (* the witnesses: the address of the reference, the roots of the
      new values, the rest of the roots and the new heap *)
   W(fun gl ->
     let sp = the_asm (fun c -> is_eq c &&
                hd_is "APPEND" (rand c)) gl in
     let t1 = lhand (rand (concl sp)) in
     let t2 = rand (rand (rand (concl sp))) in
     let pt = the_asm (fun c -> is_eq c &&
                hd_is "gc_shared_Pointer" (rand c)) gl in
     let p = lhand (rand (concl pt)) in
     let u = rand (rand (concl pt)) in
     let st = the_asm (fun c -> is_eq c &&
                hd_is "heap_store" (lhand c)) gl in
     let h2 = lhand (rand (concl st)) in
     let zs = rand (rand (rand (concl (a_hlold gl)))) in
     MAP_EVERY EXISTS_TAC [p; t1; t2; zs; h2; u]) THEN
   REPEAT CONJ_TAC THEN
   TRY (SOLVED (FIRST_ASSUM ACCEPT_TAC)) THEN
   TRY (SOLVED (ASM_REWRITE_TAC[])) THEN
   (* the values of the element are the ones the heap holds there *)
   TRY (SOLVED
         (W(fun gl ->
            REWRITE_TAC[heap_deref_def; a_hlold gl; RefBlock_def]) THEN
          MATCH_REDUCE_TAC THEN REWRITE_TAC[])) THEN
   (* and the invariant of the new heap and references *)
   REWRITE_TAC[abs_ml_inv_def; bc_stack_ref_inv_def] THEN
   REPEAT CONJ_TAC THEN
   TRY (SOLVED (FIRST_ASSUM ACCEPT_TAC)) THEN
   TRY (SOLVED (ASM_REWRITE_TAC[])) THEN
   (* the roots and the heap are as good as they were *)
   (* the roots are the ones of the split *)
   W(fun gl ->
     let sp = the_asm (fun c -> is_eq c &&
                hd_is "APPEND" (rand c)) gl in
     ONCE_REWRITE_TAC[sp]) THEN
   TRY (SOLVED
         (W(fun gl ->
            let iso = the_asm (fun c ->
              let bd = snd (strip_forall c) in
              is_eq bd && hd_is "isSomeDataElement" (lhand bd)) gl in
            let ro = the_asm (hd_is "roots_ok") gl in
            ACCEPT_TAC (MATCH_MP roots_ok_iso (CONJ ro iso))))) THEN
   TRY (SOLVED
         (W(fun gl ->
            let sp = the_asm (fun c -> is_eq c &&
                       hd_is "APPEND" (rand c)) gl in
            let iso = the_asm (fun c ->
              let bd = snd (strip_forall c) in
              is_eq bd && hd_is "isSomeDataElement" (lhand bd)) gl in
            let ro = REWRITE_RULE[sp] (the_asm (hd_is "roots_ok") gl) in
            let ho = the_asm (hd_is "heap_ok") gl in
            let hlen = the_asm (fun c -> is_eq c &&
                         hd_is "heap_length" (lhand c)) gl in
            let flt = the_asm (fun c -> is_eq c &&
                        hd_is "FILTER" (lhand c)) gl in
            let mm = the_asm (fun c ->
              let bd = snd (strip_forall c) in
              is_imp bd && is_disj (rand bd)) gl in
            let rs = lhand (el 0 (snd (strip_comb (concl ro)))) in
            let i = el 1 (snd (strip_comb (find_term
                      (hd_is "LUPDATE") (concl mm)))) in
            let pw = INST [i,`i:num`]
                       (MATCH_MP ptrs_store_LUPDATE
                         (CONJ ho (CONJ ro (CONJ (a_pos rs gl)
                           (a_hlold gl))))) in
            ACCEPT_TAC (MATCH_MP heap_ok_store_ws
              (CONJ ho (CONJ pw (CONJ iso (CONJ hlen
                (CONJ flt mm))))))))) THEN
   (* and the unused space is where it was *)
   TRY (SOLVED
         (W(fun gl ->
            let us = the_asm (hd_is "unused_space_inv") gl in
            let ri = the_asm (hd_is "RefBlock_inv") gl in
            let hlen = the_asm (fun c -> is_eq c &&
                         hd_is "heap_length" (lhand c)) gl in
            let st = the_asm (fun c -> is_eq c &&
                       hd_is "heap_store" (lhand c)) gl in
            ACCEPT_TAC (MATCH_MP unused_store_ref
              (CONJ us (CONJ ri (CONJ hlen st))))))) THEN
   (* the kind of the collection: the store is above the nursery and
      writes a reference where one was (gc_kind_store_ref) *)
   TRY (SOLVED
         (W(fun gl ->
            let gk = the_asm (hd_is "gc_kind_inv") gl in
            let st = the_asm (fun c -> is_eq c &&
                       hd_is "heap_store" (lhand c)) gl in
            let hl = the_asm (fun c -> is_eq c &&
                       hd_is "heap_lookup" (lhand c) &&
                       can (fun t -> hd_is "RefBlock" (rand t))
                         (rand c) &&
                       el 1 (snd (strip_comb (lhand c))) =
                         el 2 (snd (strip_comb
                                  (lhand (concl st))))) gl in
            let zs = rand (rand (rand (concl hl))) in
            let len = the_asm (fun c -> is_eq c &&
                        hd_is "LENGTH" (lhand c) &&
                        rand c = list_mk_icomb "LENGTH" [zs]) gl in
            MATCH_ACCEPT_TAC (MATCH_MP gc_kind_store_ref
              (CONJ gk (CONJ st (CONJ hl len))))))) THEN
   (* the maps of the new invariant: the addresses are the ones they
      were, and the timestamps are cut to the ones of the new
      references and stack *)
   W(fun (asl,w as gl) ->
     if not (is_exists w) then ALL_TAC else
     (let sub p = rand (lhand (concl (the_asm (fun c ->
        hd_is "SUBSET" c && hd_is p (rand c)) gl))) in
      let ats = find_term (hd_is "all_ts") w in
      EXISTS_TAC (sub "domain") THEN
      EXISTS_TAC (list_mk_icomb "DRESTRICT" [sub "all_ts"; ats]))) THEN
   REPEAT CONJ_TAC THEN TRY (SOLVED (FIRST_ASSUM ACCEPT_TAC)) THEN
   (* the addresses of the maps are the ones of the old heap *)
   TRY (SOLVED
         (W(fun gl ->
            let iso = the_asm (fun c ->
              let bd = snd (strip_forall c) in
              is_eq bd && hd_is "isSomeDataElement" (lhand bd)) gl in
            ONCE_REWRITE_TAC[iso]) THEN
          FIRST [SOLVED (FIRST_ASSUM ACCEPT_TAC);
                 SOLVED (W(fun (asl,w as gl) ->
                   let dr = find_term (hd_is "DRESTRICT") w in
                   let inj = the_asm (fun c -> hd_is "INJ" c &&
                     rand (el 0 (snd (strip_comb c))) = lhand dr) gl in
                   MATCH_ACCEPT_TAC
                     (MATCH_MP INJ_DRESTRICT inj)))])) THEN
   (* the domain of the references has the key in it *)
   TRY (SOLVED
         (REWRITE_TAC[domain_insert] THEN
          MATCH_MP_TAC SUBSET_TRANS THEN
          W(fun gl ->
            let su = the_asm (fun c -> hd_is "SUBSET" c &&
                       hd_is "domain" (rand c)) gl in
            EXISTS_TAC (rand (concl su))) THEN
          CONJ_TAC THEN TRY (FIRST_ASSUM ACCEPT_TAC) THEN
          SET_TAC[])) THEN
   (* the timestamps of the restricted map are of the stack, and
      below the counter *)
   TRY (SOLVED
         (REWRITE_TAC[(CONJUNCT1 o SPEC_ALL) DRESTRICT_DEF] THEN
          FIRST [SOLVED (REWRITE_TAC[INTER_SUBSET]);
                 SOLVED (MATCH_MP_TAC SUBSET_TRANS THEN
                         W(fun gl ->
                           let su = the_asm (fun c ->
                             hd_is "SUBSET" c &&
                             hd_is "FDOM" (lhand c)) gl in
                           EXISTS_TAC (lhand (concl su))) THEN
                         CONJ_TAC THEN
                         TRY (FIRST_ASSUM ACCEPT_TAC) THEN
                         REWRITE_TAC[INTER_SUBSET])])) THEN
   (* the blocks of the stack stay unique *)
   TRY (SOLVED
         (W(fun (asl,w as gl) ->
            let bu = the_asm (hd_is "blocks_unique") gl in
            let le = a_pos (rand (el 0 (snd (strip_comb
                       (find_term (hd_is "LUPDATE") w))))) gl in
            ACCEPT_TAC (MATCH_MP blocks_unique_update_ref1
              (CONJ le (CONJ (a_lkptr gl) bu)))))) THEN
   (* the values of the stack: the update of the reference and the
      cut of the timestamps leave what the invariant says of them
      (v_inv_update_ref) *)
   W(fun (asl,w) -> if not (hd_is "ALL2" w) then ALL_TAC else
         (MATCH_MP_TAC EVERY2_MEM_MONO THEN
          W(fun (asl,w as gl) ->
            let bod = snd (strip_exists w) in
            let l1 = el 1 (snd (strip_comb (last (conjuncts bod)))) in
            let old = the_asm (fun c -> hd_is "ALL2" c &&
                        el 1 (snd (strip_comb c)) = l1) gl in
            EXISTS_TAC (el 0 (snd (strip_comb (concl old))))) THEN
          CONJ_TAC THENL
           [REPEAT GEN_TAC THEN
            CONV_TAC(TOP_DEPTH_CONV BETA_CONV) THEN
            STRIP_TAC THEN
            W(fun (asl,w as gl) ->
              let gargs = snd (strip_comb w) in
              let x = el 1 gargs in
              let y = el 0 (tparts (el 3 gargs)) in
              let vi = the_asm (fun c -> hd_is "v_inv" c &&
                         el 1 (snd (strip_comb c)) = x &&
                         el 0 (tparts (el 3 (snd (strip_comb c))))
                           = y) gl in
              let ri = the_asm (hd_is "RefBlock_inv") gl in
              let lk = the_asm (fun c -> is_eq c &&
                         hd_is "sptree_lookup" (lhand c)) gl in
              let mz = the_asm (fun c -> hd_is "MEM" c &&
                         hd_is "ZIP" (rand c)) gl in
              let l1 = el 0 (snd (strip_comb (rand (concl mz)))) in
              let le = the_asm (fun c -> is_eq c &&
                         lhand c = list_mk_icomb "LENGTH" [l1]) gl in
              MATCH_ACCEPT_TAC (MATCH_MP v_inv_update_ref
                (CONJ ri (CONJ lk (CONJ vi
                  (MATCH_MP mem_zip_left (CONJ le mz)))))));
            FIRST_ASSUM ACCEPT_TAC])) THEN
   (* and the invariant of each reference that the stack reaches:
      it was reachable before the update (reachable_refs_UPDATE) *)
   W(fun (asl,w) -> if not (is_forall w) then ALL_TAC else
     (REPEAT STRIP_TAC THEN
      W(fun gl ->
        let rr = the_asm (fun c -> hd_is "reachable_refs" c &&
                   hd_is "sptree_insert"
                     (el 1 (snd (strip_comb c)))) gl in
        let le = a_pos (rand (el 0 (snd (strip_comb (find_term
                   (hd_is "LUPDATE") (concl rr)))))) gl in
        ASSUME_TAC (MATCH_MP reach_refs_update_ref1
          (CONJ rr (CONJ (a_lkptr gl) le)))) THEN
      (* what the old invariant says of it *)
      W(fun (asl,w as gl) ->
        let n = el 1 (snd (strip_comb w)) in
        let bri = the_asm (fun c ->
          let vs,bd = strip_forall c in
          length vs = 1 && is_imp bd &&
          hd_is "bc_ref_inv" (rand bd)) gl in
        let rr = the_asm (fun c -> hd_is "reachable_refs" c &&
          not (hd_is "sptree_insert"
                 (el 1 (snd (strip_comb c))))) gl in
        let nin = the_asm (fun c -> hd_is "IN" c &&
          hd_is "FDOM" (rand c) &&
          el 0 (snd (strip_comb c)) = n) gl in
        ASSUME_TAC (MP (SPEC n bri) (CONJ rr nin))) THEN
      (* the reference written, or another one *)
      W(fun (asl,w as gl) ->
        ASM_CASES_TAC (mk_eq (el 1 (snd (strip_comb w)),
                              g_ptr gl))) THEN
      TRY VAR_EQ_TAC THEN
      (* the one written: its values are the new ones
         (bc_ref_inv_update_ref_at) *)
      TRY (SOLVED
            (W(fun gl ->
               let lk1 = the_asm (fun c -> is_eq c &&
                           hd_is "FLOOKUP" (lhand c)) gl in
               let hl2 = a_hlnew gl in
               let largs = snd (strip_comb
                             (rand (rand (rand (concl hl2))))) in
               let t1 = rand (el 0 largs) in
               let zs = el 2 largs in
               let old = the_asm (fun c -> hd_is "ALL2" c &&
                           el 1 (snd (strip_comb c)) = zs) gl in
               let spl = the_asm (fun c -> hd_is "ALL2" c &&
                           el 2 (snd (strip_comb c)) = t1) gl in
               let ev = CONV_RULE(TOP_DEPTH_CONV BETA_CONV)
                          (MATCH_MP EVERY2_HD
                            (CONJ spl (a_pos
                               (el 1 (snd (strip_comb (concl spl))))
                               gl))) in
               MATCH_ACCEPT_TAC (MATCH_MP bc_ref_inv_update_ref_at1
                 (CONJ (a_ri gl) (CONJ lk1 (CONJ hl2
                   (CONJ (a_lkptr gl) (CONJ old ev))))))))) THEN
      (* another one: its element did not move, because the store
         only touched the address of the one written
         (bc_ref_inv_update_ref_other) *)
      TRY (SOLVED
            (W(fun (asl,w as gl) ->
               let fm = el 0 (tparts (el 3 (snd (strip_comb w)))) in
               let inj = the_asm (fun c -> hd_is "INJ" c &&
                           rand (el 0 (snd (strip_comb c))) = fm) gl in
               let pin = the_asm (fun c -> hd_is "IN" c &&
                           hd_is "FDOM" (rand c) &&
                           el 0 (snd (strip_comb c)) = g_ptr gl) gl in
               let neq = the_asm (fun c -> is_neg c && is_eq (rand c) &&
                           rand (rand c) = g_ptr gl) gl in
               let inv = the_asm (fun c -> hd_is "bc_ref_inv" c) gl in
               MATCH_ACCEPT_TAC (MATCH_MP bc_ref_inv_update_ref_other
                 (CONJ inj (CONJ pin (CONJ neq (CONJ (a_ri gl)
                   (CONJ (a_tr gl) (CONJ (a_lkptr gl) inv)))))))))) THEN
      ALL_TAC)))
### update_thunk_thm
  (* the steps are above the statement and above update_ref_thm
     (tools/overrides.py).  The two roots in front of the rest are
     the root of the value and the address of the reference, which
     the relation of the pointer gives together with the thunk in
     the heap and the relation of its value; the store writes the
     new thunk into that element, and the heap and the references
     are then as good as they were.  Of the reference written the
     invariant is the thunk stored and of any other one its
     element, which the store did not touch *)
  (STRIP_TAC THEN
    (* what the invariant says of the stack with the thunk and the
       pointer on it *)
    FIRST_X_ASSUM (fun inv ->
      if not (hd_is "abs_ml_inv" (concl inv)) then fail() else
      STRIP_ASSUME_TAC (REWRITE_RULE[abs_ml_inv_def;
                                     bc_stack_ref_inv_def] inv)) THEN
    (* the roots are the two of the values in front and the rest *)
    SPLIT_ROOTS_TAC THEN SPLIT_ROOTS_TAC THEN
    (* and the root of the pointer is the address of its reference *)
    FIRST_ASSUM (fun vr ->
      let c = concl vr in
      if not (hd_is "v_inv" c) ||
         not (hd_is "dataSem_RefPtr" (el 1 (snd (strip_comb c))))
      then fail()
      else STRIP_ASSUME_TAC (REWRITE_RULE[v_inv_def] vr)) THEN
    (* of the three ways a pointer is related -- the reference is no
       thunk, it is one and the root is its address, or it is an
       evaluated one and the root is its value's -- only the second
       is left, because the reference holds a thunk that was not
       evaluated *)
    (let rws = distinctness "thunk_mode" :: ref_rws in
     RULE_ASSUM_TRY (REWRITE_RULE rws) THEN
     TRY (FIRST_ASSUM CONTR_TAC) THEN
     (* the reference is a thunk, so the first way is out *)
     TRY (SOLVED
           (W(fun gl ->
              let nt = the_asm (fun c ->
                         length (fst (strip_forall c)) = 2 &&
                         is_neg (snd (strip_forall c))) gl in
              let lk = the_asm (fun c -> is_eq c &&
                         hd_is "sptree_lookup" (lhand c) &&
                         hd_is "SOME" (rand c)) gl in
              let args = snd (strip_comb (rand (rand (concl lk)))) in
              CONTR_TAC (MP (NOT_ELIM
                (SPECL [el 0 args; el 1 args] nt)) lk)))) THEN
     (* and the two lookups of the key agree, which leaves the
        second way and puts the third out *)
     TRY (W(fun (asl,_) ->
       let lks = mapfilter (fun (_,th) ->
                   let c = concl th in
                   if is_eq c && hd_is "sptree_lookup" (lhand c) &&
                      hd_is "SOME" (rand c) then th else fail()) asl in
       if length lks < 2 then fail() else
       MP_TAC (TRANS (SYM (el 0 lks)) (el 1 lks)) THEN
       REWRITE_TAC (injectivity "option" ::
                    injectivity "bvlSem_ref" :: rws) THEN
       STRIP_TAC)) THEN
     SPLIT_ASM_TAC THEN
     TRY VAR_EQ_TAC) THEN
    (* the reference has an address *)
    (SUBGOAL_THEN (cake_as_vars (fun () ->
       `FLOOKUP (f:(num,num)fmap) (ptr:num) = SOME (FAPPLY f ptr:num)`))
       ASSUME_TAC THENL
      [ASM_REWRITE_TAC[FLOOKUP_DEF]; ALL_TAC]) THEN
    (* the root of the value on the stack and the element that the
       reference holds are what the pointer's relation gives: the
       thunk that was not evaluated is in the heap and its value is
       related (v_inv_def, the second of the three ways) *)
    (* the store of the new thunk into the element *)
    W(fun (asl,w as gl) ->
      let rts = lhand (hd (conjuncts (snd (strip_exists w)))) in
      let r = el 0 (snd (strip_comb rts)) in
      let hl = the_asm (fun c -> is_eq c &&
                 hd_is "heap_lookup" (lhand c) &&
                 can (fun t -> hd_is "ThunkBlock" (rand t))
                   (rand c)) gl in
      let th0 = MATCH_MP heap_store_ThunkBlock hl in
      let hv = find_term (fun t -> is_var t &&
                 fst (dest_var t) = "h") (concl th0) in
      STRIP_ASSUME_TAC (INST [r,hv] th0)) THEN
    (* the witnesses: the root of the value, the address of the
       reference, the rest of the roots, the value the element held
       and the new heap *)
    W(fun (asl,w as gl) ->
      let rts = lhand (hd (conjuncts (snd (strip_exists w)))) in
      let rargs = snd (strip_comb rts) in
      let r = el 0 rargs in
      let targs = snd (strip_comb (el 1 rargs)) in
      let pargs = snd (strip_comb (el 0 targs)) in
      let p = el 0 pargs in
      let u = el 1 pargs in
      let roots2 = el 1 targs in
      let st = the_asm (fun c -> is_eq c &&
                 hd_is "heap_store" (lhand c)) gl in
      let heap = el 2 (snd (strip_comb (lhand (concl st)))) in
      let h2 = lhand (rand (concl st)) in
      let hl = the_asm (fun c -> is_eq c &&
                 hd_is "heap_lookup" (lhand c) &&
                 el 1 (snd (strip_comb (lhand c))) = heap &&
                 can (fun t -> hd_is "ThunkBlock" (rand t))
                   (rand c)) gl in
      let hlD = REWRITE_RULE[ThunkBlock_def] hl in
      let lst = el 0 (snd (strip_comb (rand (rand (concl hlD))))) in
      MAP_EVERY EXISTS_TAC [p; r; roots2; lst; h2; u]) THEN
    REPEAT CONJ_TAC THEN
    TRY (SOLVED (FIRST_ASSUM ACCEPT_TAC)) THEN
    TRY (SOLVED (ASM_REWRITE_TAC[])) THEN
    (* the value that the element held *)
    TRY (SOLVED
          (W(fun gl ->
             let st = the_asm (fun c -> is_eq c &&
                        hd_is "heap_store" (lhand c)) gl in
             let heap = el 2 (snd (strip_comb (lhand (concl st)))) in
             let hl = the_asm (fun c -> is_eq c &&
                        hd_is "heap_lookup" (lhand c) &&
                        el 1 (snd (strip_comb (lhand c))) = heap &&
                        can (fun t -> hd_is "ThunkBlock" (rand t))
                          (rand c)) gl in
             REWRITE_TAC[thunk_deref_def; hl; ThunkBlock_def]) THEN
           MATCH_REDUCE_TAC THEN REWRITE_TAC[])) THEN
    (* and the invariant of the new heap and references *)
    REWRITE_TAC[abs_ml_inv_def; bc_stack_ref_inv_def] THEN
    REPEAT CONJ_TAC THEN
    TRY (SOLVED (FIRST_ASSUM ACCEPT_TAC)) THEN
    TRY (SOLVED (ASM_REWRITE_TAC[])) THEN
    (* the roots are the ones they were, of a heap as good *)
    TRY (SOLVED
          (W(fun gl ->
             let iso = the_asm (fun c ->
               let bd = snd (strip_forall c) in
               is_eq bd && hd_is "isSomeDataElement" (lhand bd)) gl in
             let ro = the_asm (hd_is "roots_ok") gl in
             ACCEPT_TAC (MATCH_MP roots_ok_iso (CONJ ro iso))))) THEN
    (* the heap is good: the pointer written is a root *)
    TRY (SOLVED
          (W(fun gl ->
             let ho = the_asm (hd_is "heap_ok") gl in
             let ro = REWRITE_RULE[roots_ok_def]
                        (the_asm (hd_is "roots_ok") gl) in
             let iso = the_asm (fun c ->
               let bd = snd (strip_forall c) in
               is_eq bd && hd_is "isSomeDataElement" (lhand bd)) gl in
             let hlen = the_asm (fun c -> is_eq c &&
                          hd_is "heap_length" (lhand c)) gl in
             let flt = the_asm (fun c -> is_eq c &&
                         hd_is "FILTER" (lhand c)) gl in
             let mm = REWRITE_RULE[ThunkBlock_def] (the_asm (fun c ->
                        let bd = snd (strip_forall c) in
                        is_imp bd && is_disj (rand bd)) gl) in
             let dj = hd (disjuncts
                        (rand (snd (strip_forall (concl mm))))) in
             let ws = el 0 (snd (strip_comb (rand dj))) in
             let vs,bd = strip_forall (concl ro) in
             let pw = list_mk_forall(vs,
                        mk_imp(list_mk_icomb "MEM"
                                 [lhand (lhand bd); ws], rand bd)) in
             SUBGOAL_THEN pw (fun pwt ->
               ACCEPT_TAC (MATCH_MP heap_ok_store_el
                 (CONJ ho (CONJ pwt (CONJ iso (CONJ hlen
                   (CONJ flt mm))))))) THEN
             MP_TAC ro THEN POP_ASSUM_LIST (K ALL_TAC) THEN
             REWRITE_TAC[MEM] THEN MESON_TAC[]))) THEN
    (* the kind of the collection survives the store *)
    TRY (SOLVED
          (W(fun gl ->
             let gk = the_asm (hd_is "gc_kind_inv") gl in
             let st = the_asm (fun c -> is_eq c &&
                        hd_is "heap_store" (lhand c)) gl in
             let heap = el 2 (snd (strip_comb (lhand (concl st)))) in
             let hl = the_asm (fun c -> is_eq c &&
                        hd_is "heap_lookup" (lhand c) &&
                        el 1 (snd (strip_comb (lhand c))) = heap &&
                        can (fun t -> hd_is "ThunkBlock" (rand t))
                          (rand c)) gl in
             MATCH_ACCEPT_TAC (MATCH_MP gc_kind_store_thunk
               (CONJ gk (CONJ st hl)))))) THEN
    (* and the unused space is where it was: the unused element is
       not a data element, so it is not the thunk written *)
    TRY (SOLVED
          (W(fun gl ->
             let us = the_asm (hd_is "unused_space_inv") gl in
             let hlen = the_asm (fun c -> is_eq c &&
                          hd_is "heap_length" (lhand c)) gl in
             let st = the_asm (fun c -> is_eq c &&
                        hd_is "heap_store" (lhand c)) gl in
             let heap = el 2 (snd (strip_comb (lhand (concl st)))) in
             let el2 = lhand (el 1 (snd (strip_comb
                         (lhand (concl st))))) in
             let hl = the_asm (fun c -> is_eq c &&
                        hd_is "heap_lookup" (lhand c) &&
                        el 1 (snd (strip_comb (lhand c))) = heap &&
                        can (fun t -> hd_is "ThunkBlock" (rand t))
                          (rand c)) gl in
             let el1 = rand (rand (concl hl)) in
             SUBGOAL_THEN (list_mk_icomb "isDataElement" [el1])
               (fun isd1 ->
                  SUBGOAL_THEN (list_mk_icomb "isDataElement" [el2])
                    (fun isd2 -> ACCEPT_TAC (MATCH_MP unused_store_el
                      (CONJ us (CONJ hlen (CONJ hl (CONJ isd1
                        (CONJ isd2 (CONJ (a_tr gl) st)))))))) THEN
                  REWRITE_TAC[isDataElement_def; ThunkBlock_def] THEN
                  MESON_TAC[]) THEN
             REWRITE_TAC[isDataElement_def; ThunkBlock_def] THEN
             MESON_TAC[]))) THEN
    (* the maps of the new invariant: the addresses are the ones they
       were, and the timestamps are cut to the ones of the new
       references and stack *)
    W(fun (asl,w as gl) ->
      if not (is_exists w) then ALL_TAC else
      (let sub p = rand (lhand (concl (the_asm (fun c ->
         hd_is "SUBSET" c && hd_is p (rand c)) gl))) in
       let ats = find_term (hd_is "all_ts") w in
       EXISTS_TAC (sub "domain") THEN
       EXISTS_TAC (list_mk_icomb "DRESTRICT" [sub "all_ts"; ats]))) THEN
    REPEAT CONJ_TAC THEN TRY (SOLVED (FIRST_ASSUM ACCEPT_TAC)) THEN
    (* the addresses of the maps are the ones of the old heap *)
    TRY (SOLVED
          (W(fun gl ->
             let iso = the_asm (fun c ->
               let bd = snd (strip_forall c) in
               is_eq bd && hd_is "isSomeDataElement" (lhand bd)) gl in
             ONCE_REWRITE_TAC[iso]) THEN
           FIRST [SOLVED (FIRST_ASSUM ACCEPT_TAC);
                  SOLVED (W(fun (asl,w as gl) ->
                    let dr = find_term (hd_is "DRESTRICT") w in
                    let inj = the_asm (fun c -> hd_is "INJ" c &&
                      rand (el 0 (snd (strip_comb c))) = lhand dr) gl in
                    MATCH_ACCEPT_TAC
                      (MATCH_MP INJ_DRESTRICT inj)))])) THEN
    (* the domain of the references has the key in it *)
    TRY (SOLVED
          (REWRITE_TAC[domain_insert] THEN
           MATCH_MP_TAC SUBSET_TRANS THEN
           W(fun gl ->
             let su = the_asm (fun c -> hd_is "SUBSET" c &&
                        hd_is "domain" (rand c)) gl in
             EXISTS_TAC (rand (concl su))) THEN
           CONJ_TAC THEN TRY (FIRST_ASSUM ACCEPT_TAC) THEN
           SET_TAC[])) THEN
    (* the timestamps of the restricted map are of the stack, and
       below the counter *)
    TRY (SOLVED
          (REWRITE_TAC[(CONJUNCT1 o SPEC_ALL) DRESTRICT_DEF] THEN
           FIRST [SOLVED (REWRITE_TAC[INTER_SUBSET]);
                  SOLVED (MATCH_MP_TAC SUBSET_TRANS THEN
                          W(fun gl ->
                            let su = the_asm (fun c ->
                              hd_is "SUBSET" c &&
                              hd_is "FDOM" (lhand c)) gl in
                            EXISTS_TAC (lhand (concl su))) THEN
                          CONJ_TAC THEN
                          TRY (FIRST_ASSUM ACCEPT_TAC) THEN
                          REWRITE_TAC[INTER_SUBSET])])) THEN
    (* the blocks of the stack stay unique *)
    TRY (SOLVED
          (W(fun gl ->
             let bu = the_asm (hd_is "blocks_unique") gl in
             MATCH_ACCEPT_TAC
               (MATCH_MP blocks_unique_update_thunk bu)))) THEN
    (* the transfers that the update of the thunk leaves: what the
       invariant says of a value, what a value says of a thunk, and
       what the references hold at another key (TH_trans) *)
    W(fun (asl,w as gl) ->
      let st = the_asm (fun c -> is_eq c &&
                 hd_is "heap_store" (lhand c)) gl in
      let heap = el 2 (snd (strip_comb (lhand (concl st)))) in
      let hl = the_asm (fun c -> is_eq c &&
                 hd_is "heap_lookup" (lhand c) &&
                 el 1 (snd (strip_comb (lhand c))) = heap &&
                 can (fun t -> hd_is "ThunkBlock" (rand t))
                   (rand c)) gl in
      let hl2 = the_asm (fun c -> is_eq c &&
                  hd_is "heap_lookup" (lhand c) &&
                  not (el 1 (snd (strip_comb (lhand c))) = heap) &&
                  can (fun t -> hd_is "ThunkBlock" (rand t))
                    (rand c)) gl in
      let y = el 1 (snd (strip_comb (rand (rand (concl hl))))) in
      let q = el 1 (snd (strip_comb (rand (rand (concl hl2))))) in
      let lk = the_asm (fun c -> is_eq c &&
                 hd_is "sptree_lookup" (lhand c) &&
                 not (hd_is "sptree_insert" (rand (lhand c)))) gl in
      let ptr = el 0 (snd (strip_comb (lhand (concl lk)))) in
      let fm = el 0 (snd (strip_comb (lhand (concl
                 (the_asm (fun c -> is_eq c &&
                    hd_is "FLOOKUP" (lhand c)) gl))))) in
      let inj = the_asm (fun c -> hd_is "INJ" c &&
                  rand (el 0 (snd (strip_comb c))) = fm) gl in
      let pin = the_asm (fun c -> hd_is "IN" c &&
                  hd_is "FDOM" (rand c) &&
                  el 0 (snd (strip_comb c)) = ptr) gl in
      let viy = the_asm (fun c -> hd_is "v_inv" c &&
                  el 0 (tparts (el 3 (snd (strip_comb c)))) = y) gl in
      let viq = the_asm (fun c -> hd_is "v_inv" c &&
                  el 0 (tparts (el 3 (snd (strip_comb c)))) = q) gl in
      let hv = el 1 (snd (strip_comb (concl viq))) in
      let dt = the_asm (fun c -> is_imp c &&
                 (try hd_is "dataSem_dest_thunk" (lhand (rand c)) &&
                      el 0 (snd (strip_comb (lhand (rand c)))) = hv
                  with Failure _ -> false)) gl in
      MAP_EVERY ASSUME_TAC (CONJUNCTS (MATCH_MP TH_trans
        (CONJ inj (CONJ pin (CONJ lk (CONJ hl (CONJ viy
          (CONJ dt (CONJ st (CONJ hl2
            (CONJ (a_tr gl) viq)))))))))))) THEN
    (* the values of the stack: the thunk's value and the pointer in
       front of it, and the rest *)
    W(fun (asl,w) -> if not (hd_is "ALL2" w) then ALL_TAC else
      (REWRITE_TAC[ALL2] THEN
       CONV_TAC(TOP_DEPTH_CONV BETA_CONV) THEN
       REPEAT CONJ_TAC THEN
       TRY (SOLVED
             (W(fun (asl,w as gl) ->
                let args = snd (strip_comb w) in
                let v1 = el 1 args in
                let ats = find_term (hd_is "all_ts") w in
                let vi = the_asm (fun c -> hd_is "v_inv" c &&
                           el 1 (snd (strip_comb c)) = v1 &&
                           not (el 2 (snd (strip_comb c)) =
                                  lhand ats)) gl in
                SUBGOAL_THEN
                  (list_mk_icomb "MEM" [v1; rand ats])
                  (fun mm -> MATCH_ACCEPT_TAC (MATCH_MP
                     v_inv_update_gen
                     (CONJ (a_vtr gl) (CONJ vi
                       (MP (SPECL [v1; rand ats; lhand ats]
                             MEM_stack_all_vs) mm))))) THEN
                REWRITE_TAC[MEM]))) THEN
       W(fun (asl,w as gl) ->
         let old = the_asm (fun c -> hd_is "ALL2" c &&
                     el 1 (snd (strip_comb c)) =
                       el 1 (snd (strip_comb w))) gl in
         let ats = find_term (hd_is "all_ts") w in
         let vs = el 1 (snd (strip_comb w)) in
         let v = genvar (hd (snd (dest_type (type_of (rand ats))))) in
         SUBGOAL_THEN
           (mk_forall(v, mk_imp(list_mk_icomb "MEM" [v; vs],
              list_mk_icomb "IN"
                [v; list_mk_icomb "all_vs" [lhand ats; rand ats]])))
           (fun mem -> ACCEPT_TAC (MATCH_MP EVERY2_v_inv_update_stack
              (CONJ (a_vtr gl) (CONJ mem old)))) THEN
         REPEAT STRIP_TAC THEN
         W(fun gl ->
           let mm = the_asm (hd_is "MEM") gl in
           let v1 = el 0 (snd (strip_comb (concl mm))) in
           SUBGOAL_THEN (list_mk_icomb "MEM" [v1; rand ats])
             (fun m2 -> MATCH_ACCEPT_TAC (MP (SPECL [v1; rand ats;
                          lhand ats] MEM_stack_all_vs) m2)) THEN
           ASM_REWRITE_TAC[MEM])))) THEN
    (* and the invariant of each reference that the stack reaches:
       it was reachable before the update
       (reachable_refs_Thunk_UPDATE) *)
    W(fun (asl,w) -> if not (is_forall w) then ALL_TAC else
      (REPEAT STRIP_TAC THEN
       W(fun gl ->
         let rr = the_asm (fun c -> hd_is "reachable_refs" c &&
                    hd_is "sptree_insert"
                      (el 1 (snd (strip_comb c)))) gl in
         ASSUME_TAC (MATCH_MP reachable_refs_Thunk_UPDATE rr)) THEN
       W(fun (asl,w as gl) ->
         let n = el 1 (snd (strip_comb w)) in
         let bri = the_asm (fun c ->
           let vs,bd = strip_forall c in
           length vs = 1 && is_imp bd &&
           hd_is "bc_ref_inv" (rand bd)) gl in
         let rr = the_asm (fun c -> hd_is "reachable_refs" c &&
           not (hd_is "sptree_insert"
                  (el 1 (snd (strip_comb c))))) gl in
         let nin = the_asm (fun c -> hd_is "IN" c &&
           hd_is "FDOM" (rand c) &&
           el 0 (snd (strip_comb c)) = n) gl in
         ASSUME_TAC (MP (SPEC n bri) (CONJ rr nin))) THEN
       (* the reference written, or another one *)
       W(fun (asl,w as gl) ->
         ASM_CASES_TAC (mk_eq (el 1 (snd (strip_comb w)),
                               g_ptr gl))) THEN
       TRY VAR_EQ_TAC THEN
       (* the one written: the thunk that the update stored *)
       TRY (SOLVED
             (W(fun (asl,w as gl) ->
                let lk1 = the_asm (fun c -> is_eq c &&
                            hd_is "FLOOKUP" (lhand c)) gl in
                let p = rand (rand (concl lk1)) in
                let hl2 = the_asm (fun c -> is_eq c &&
                            hd_is "heap_lookup" (lhand c) &&
                            el 0 (snd (strip_comb (lhand c))) = p &&
                            can (fun t -> hd_is "ThunkBlock" (rand t))
                              (rand c)) gl in
                let q = el 1 (snd (strip_comb
                          (rand (rand (concl hl2))))) in
                let viq = the_asm (fun c -> hd_is "v_inv" c &&
                            el 0 (tparts (el 3 (snd (strip_comb c))))
                              = q) gl in
                let hv = el 1 (snd (strip_comb (concl viq))) in
                let dt = the_asm (fun c -> is_imp c &&
                           (try hd_is "dataSem_dest_thunk"
                                  (lhand (rand c)) &&
                                el 0 (snd (strip_comb
                                  (lhand (rand c)))) = hv
                            with Failure _ -> false)) gl in
                let ats = find_term (hd_is "all_ts") w in
                SUBGOAL_THEN (list_mk_icomb "MEM" [hv; rand ats])
                  (fun mm -> MATCH_ACCEPT_TAC (MATCH_MP
                     bc_ref_inv_update_thunk_at
                     (CONJ lk1 (CONJ hl2 (CONJ dt (CONJ viq
                       (CONJ mm (CONJ (a_vtr gl) (a_dtr gl))))))))) THEN
                REWRITE_TAC[MEM]))) THEN
       (* another one: its element did not move *)
       TRY (SOLVED
             (W(fun (asl,w as gl) ->
                let fm = el 0 (tparts (el 3 (snd (strip_comb w)))) in
                let inj = the_asm (fun c -> hd_is "INJ" c &&
                            rand (el 0 (snd (strip_comb c))) = fm) gl in
                let pin = the_asm (fun c -> hd_is "IN" c &&
                            hd_is "FDOM" (rand c) &&
                            el 0 (snd (strip_comb c)) = g_ptr gl) gl in
                let neq = the_asm (fun c -> is_neg c &&
                            is_eq (rand c) &&
                            rand (rand c) = g_ptr gl) gl in
                let inv = the_asm (hd_is "bc_ref_inv") gl in
                MATCH_ACCEPT_TAC (MATCH_MP bc_ref_inv_update_other_gen
                  (CONJ inj (CONJ pin (CONJ neq (CONJ (a_vtr gl)
                    (CONJ (a_dtr gl) (CONJ (a_ltr gl)
                      (CONJ (a_tr gl) inv))))))))))))) THEN
    ALL_TAC)
### update_mutblock_thm
  (* the steps are above the statement and above update_ref_thm
     (tools/overrides.py).  The two roots in front of the rest are
     the root of the value and the address of the reference, which
     v_inv of the pointer gives in the first of its three ways,
     because the reference holds a mutable block; the invariant of
     that reference gives the element of the heap and the values it
     holds, the store writes the value into the place of the hole
     (LUPDATE), and the heap and the references are then as good as
     they were.  Of the reference written the invariant is the
     block with the hole filled and of any other one its element,
     which the store did not touch *)
  (STRIP_TAC THEN
    (* what the invariant says of the stack with the value and the
       pointer on it *)
    FIRST_X_ASSUM (fun inv ->
      if not (hd_is "abs_ml_inv" (concl inv)) then fail() else
      STRIP_ASSUME_TAC (REWRITE_RULE[abs_ml_inv_def;
                                     bc_stack_ref_inv_def] inv)) THEN
    (* the roots are the two of the values in front and the rest *)
    SPLIT_ROOTS_TAC THEN SPLIT_ROOTS_TAC THEN
    (* and the root of the pointer is the address of its reference *)
    FIRST_ASSUM (fun vr ->
      let c = concl vr in
      if not (hd_is "v_inv" c) ||
         not (hd_is "dataSem_RefPtr" (el 1 (snd (strip_comb c))))
      then fail()
      else STRIP_ASSUME_TAC (REWRITE_RULE[v_inv_def] vr)) THEN
    (* of the three ways a pointer is related only the first is
       left, because the reference holds a mutable block: the two
       that are about a thunk say the reference holds one *)
    (let rws = distinctness "thunk_mode" :: ref_rws in
     RULE_ASSUM_TRY (REWRITE_RULE rws) THEN
     TRY (FIRST_ASSUM CONTR_TAC) THEN
     (* the reference is no thunk, so the first way is the one *)
     TRY (SOLVED
           (W(fun gl ->
              let nt = the_asm (fun c ->
                         length (fst (strip_forall c)) = 2 &&
                         is_neg (snd (strip_forall c))) gl in
              let lk = the_asm (fun c -> is_eq c &&
                         hd_is "sptree_lookup" (lhand c) &&
                         hd_is "SOME" (rand c)) gl in
              let args = snd (strip_comb (rand (rand (concl lk)))) in
              CONTR_TAC (MP (NOT_ELIM
                (SPECL [el 0 args; el 1 args] nt)) lk)))) THEN
     (* and the two lookups of the key agree, which leaves the
        second way and puts the third out *)
     TRY (W(fun (asl,_) ->
       let lks = mapfilter (fun (_,th) ->
                   let c = concl th in
                   if is_eq c && hd_is "sptree_lookup" (lhand c) &&
                      hd_is "SOME" (rand c) then th else fail()) asl in
       if length lks < 2 then fail() else
       MP_TAC (TRANS (SYM (el 0 lks)) (el 1 lks)) THEN
       REWRITE_TAC (injectivity "option" ::
                    injectivity "bvlSem_ref" :: rws) THEN
       STRIP_TAC)) THEN
     SPLIT_ASM_TAC THEN
     TRY VAR_EQ_TAC) THEN
    (* the reference has an address *)
    (SUBGOAL_THEN (cake_as_vars (fun () ->
       `FLOOKUP (f:(num,num)fmap) (ptr:num) = SOME (FAPPLY f ptr:num)`))
       ASSUME_TAC THENL
      [ASM_REWRITE_TAC[FLOOKUP_DEF]; ALL_TAC]) THEN
    (* and it is reachable, so the invariant holds of it *)
    (SUBGOAL_THEN (cake_as_vars (fun () ->
       `reachable_refs (h :: RefPtr F ptr :: stack) refs ptr`))
       ASSUME_TAC THENL
      [MATCH_MP_TAC (GEN_ALL reach_refptr) THEN
       FIRST [EXISTS_TAC `F`; ALL_TAC] THEN
       REWRITE_TAC[MEM];
       ALL_TAC]) THEN
    W(fun (asl,w as gl) ->
      let bri = the_asm (fun c ->
        let vs,bd = strip_forall c in
        length vs = 1 && is_imp bd &&
        hd_is "bc_ref_inv" (rand bd)) gl in
      let rr = the_asm (hd_is "reachable_refs") gl in
      let n = el 2 (snd (strip_comb (concl rr))) in
      let nin = the_asm (fun c -> hd_is "IN" c &&
                  hd_is "FDOM" (rand c) &&
                  el 0 (snd (strip_comb c)) = n) gl in
      ASSUME_TAC (MP (SPEC n bri) (CONJ rr nin))) THEN
    (* which is the arm of a mutable block: the element of the heap,
       the values it holds, and that no timestamp points at it *)
    W(fun gl ->
      let lk1 = the_asm (fun c -> is_eq c &&
                  hd_is "FLOOKUP" (lhand c)) gl in
      let lk2 = the_asm (fun c -> is_eq c &&
                  hd_is "sptree_lookup" (lhand c)) gl in
      FIRST_X_ASSUM (fun inv ->
        if not (hd_is "bc_ref_inv" (concl inv)) then fail() else
        STRIP_ASSUME_TAC
          (REWRITE_RULE[MATCH_MP arm_MB (CONJ lk1 lk2)] inv))) THEN
    RULE_ASSUM_TRY (REWRITE_RULE[]) THEN
    (* the store of the value into the hole of the block *)
    W(fun (asl,w as gl) ->
      let hl = the_asm (fun c -> is_eq c &&
                 hd_is "heap_lookup" (lhand c) &&
                 can (fun t -> hd_is "BlockRep" (rand t))
                   (rand c)) gl in
      let zs = rand (rand (rand (concl hl))) in
      let rts = lhand (hd (conjuncts (snd (strip_exists w)))) in
      let rr = el 0 (snd (strip_comb rts)) in
      let i = el 1 (snd (strip_comb
                (find_term (hd_is "LUPDATE") w))) in
      let ws = list_mk_icomb "LUPDATE" [rr; i; zs] in
      SUBGOAL_THEN (mk_eq (list_mk_icomb "LENGTH" [zs],
                           list_mk_icomb "LENGTH" [ws]))
        (fun le -> STRIP_ASSUME_TAC
          (MATCH_MP heap_store_BlockRep (CONJ le hl)) THEN
          ASSUME_TAC le THEN ASSUME_TAC (SYM le)) THENL
       [REWRITE_TAC[LENGTH_LUPDATE];
        ALL_TAC]) THEN
    (* the witnesses: the address of the reference, the root of the
       value, the rest of the roots, the values the element held and
       the new heap *)
    W(fun (asl,w as gl) ->
      let rts = lhand (hd (conjuncts (snd (strip_exists w)))) in
      let rargs = snd (strip_comb rts) in
      let rr = el 0 rargs in
      let targs = snd (strip_comb (el 1 rargs)) in
      let pargs = snd (strip_comb (el 0 targs)) in
      let st = the_asm (fun c -> is_eq c &&
                 hd_is "heap_store" (lhand c)) gl in
      let heap = el 2 (snd (strip_comb (lhand (concl st)))) in
      let hl = the_asm (fun c -> is_eq c &&
                 hd_is "heap_lookup" (lhand c) &&
                 el 1 (snd (strip_comb (lhand c))) = heap &&
                 can (fun t -> hd_is "BlockRep" (rand t))
                   (rand c)) gl in
      MAP_EVERY EXISTS_TAC
        [el 0 pargs; rr; el 1 targs;
         rand (rand (rand (concl hl))); lhand (rand (concl st));
         el 1 pargs]) THEN
    REPEAT CONJ_TAC THEN
    TRY (SOLVED (FIRST_ASSUM ACCEPT_TAC)) THEN
    (* the number of the values of the element, which a rewrite with
       the assumptions cannot be let at: the lengths of the element
       and of the list stored are each other's *)
    TRY (SOLVED
          (W(fun gl ->
             let old = the_asm (fun c -> hd_is "ALL2" c &&
                         hd_is "APPEND"
                           (el 2 (snd (strip_comb c)))) gl in
             MP_TAC (MATCH_MP LIST_REL_LENGTH old)) THEN
           REWRITE_TAC[LENGTH_APPEND; LENGTH] THEN ARITH_TAC)) THEN
    TRY (SOLVED (ASM_REWRITE_TAC[])) THEN
    (* and the invariant of the new heap and references *)
    REWRITE_TAC[abs_ml_inv_def; bc_stack_ref_inv_def] THEN
    REPEAT CONJ_TAC THEN
    TRY (SOLVED (FIRST_ASSUM ACCEPT_TAC)) THEN
    TRY (SOLVED (ASM_REWRITE_TAC[])) THEN
    (* the roots are the ones they were, of a heap as good *)
    TRY (SOLVED
          (W(fun gl ->
             let iso = the_asm (fun c ->
               let bd = snd (strip_forall c) in
               is_eq bd && hd_is "isSomeDataElement" (lhand bd)) gl in
             let ro = the_asm (hd_is "roots_ok") gl in
             ACCEPT_TAC (MATCH_MP roots_ok_iso (CONJ ro iso))))) THEN
    (* the heap is good: the pointers of the element written are the
       root put in and the ones it had (ptrs_store_el) *)
    TRY (SOLVED
          (W(fun gl ->
             let ho = the_asm (hd_is "heap_ok") gl in
             let ro = REWRITE_RULE[roots_ok_def]
                        (the_asm (hd_is "roots_ok") gl) in
             let iso = the_asm (fun c ->
               let bd = snd (strip_forall c) in
               is_eq bd && hd_is "isSomeDataElement" (lhand bd)) gl in
             let hlen = the_asm (fun c -> is_eq c &&
                          hd_is "heap_length" (lhand c)) gl in
             let flt = the_asm (fun c -> is_eq c &&
                         hd_is "FILTER" (lhand c)) gl in
             let mm = REWRITE_RULE[BlockRep_def] (the_asm (fun c ->
                        let bd = snd (strip_forall c) in
                        is_imp bd && is_disj (rand bd)) gl) in
             let dj = hd (disjuncts
                        (rand (snd (strip_forall (concl mm))))) in
             let ws = el 0 (snd (strip_comb (rand dj))) in
             let st = the_asm (fun c -> is_eq c &&
                        hd_is "heap_store" (lhand c)) gl in
             let heap = el 2 (snd (strip_comb (lhand (concl st)))) in
             let hl = REWRITE_RULE[BlockRep_def] (the_asm (fun c ->
                        is_eq c && hd_is "heap_lookup" (lhand c) &&
                        el 1 (snd (strip_comb (lhand c))) = heap &&
                        can (fun t -> hd_is "BlockRep" (rand t))
                          (rand c)) gl) in
             let w0 = el 0 (snd (strip_comb ws)) in
             let vs,bd = strip_forall (concl ro) in
             let pt = list_mk_forall(vs,
                        mk_imp(mk_eq (w0, lhand (lhand bd)),
                               rand bd)) in
             SUBGOAL_THEN pt (fun ptt ->
               let p1 = MATCH_MP ptrs_store_el
                          (CONJ ho (CONJ ptt hl)) in
               let iv = find_term (fun t -> is_var t &&
                          fst (dest_var t) = "i") (concl p1) in
               ACCEPT_TAC (MATCH_MP heap_ok_store_el
                 (CONJ ho (CONJ (INST [el 1 (snd (strip_comb ws)),iv]
                                   p1)
                   (CONJ iso (CONJ hlen (CONJ flt mm))))))) THEN
             MP_TAC ro THEN POP_ASSUM_LIST (K ALL_TAC) THEN
             REWRITE_TAC[MEM] THEN MESON_TAC[]))) THEN
    (* the kind of the collection: a mutable block is not in a heap
       that a generational collection goes through (gc_kind_not_gen) *)
    TRY (SOLVED
          (W(fun gl ->
             let gk = the_asm (hd_is "gc_kind_inv") gl in
             let ng = the_asm (fun c ->
                        let vs,bd = strip_forall c in
                        length vs = 1 && is_neg bd) gl in
             MATCH_ACCEPT_TAC (MATCH_MP gc_kind_not_gen
               (CONJ gk ng))))) THEN
    (* and the unused space is where it was: the unused element is
       not a data element, so it is not the block written *)
    TRY (SOLVED
          (W(fun gl ->
             let us = the_asm (hd_is "unused_space_inv") gl in
             let hlen = the_asm (fun c -> is_eq c &&
                          hd_is "heap_length" (lhand c)) gl in
             let st = the_asm (fun c -> is_eq c &&
                        hd_is "heap_store" (lhand c)) gl in
             let heap = el 2 (snd (strip_comb (lhand (concl st)))) in
             let el2 = lhand (el 1 (snd (strip_comb
                         (lhand (concl st))))) in
             let hl = the_asm (fun c -> is_eq c &&
                        hd_is "heap_lookup" (lhand c) &&
                        el 1 (snd (strip_comb (lhand c))) = heap &&
                        can (fun t -> hd_is "BlockRep" (rand t))
                          (rand c)) gl in
             let el1 = rand (rand (concl hl)) in
             SUBGOAL_THEN (list_mk_icomb "isDataElement" [el1])
               (fun isd1 ->
                  SUBGOAL_THEN (list_mk_icomb "isDataElement" [el2])
                    (fun isd2 -> ACCEPT_TAC (MATCH_MP unused_store_el
                      (CONJ us (CONJ hlen (CONJ hl (CONJ isd1
                        (CONJ isd2 (CONJ (a_tr gl) st)))))))) THEN
                  REWRITE_TAC[isDataElement_def; BlockRep_def] THEN
                  MESON_TAC[]) THEN
             REWRITE_TAC[isDataElement_def; BlockRep_def] THEN
             MESON_TAC[]))) THEN
    (* the maps of the new invariant: the addresses are the ones they
       were, and the timestamps are cut to the ones of the new
       references and stack *)
    W(fun (asl,w as gl) ->
      if not (is_exists w) then ALL_TAC else
      (let sub p = rand (lhand (concl (the_asm (fun c ->
         hd_is "SUBSET" c && hd_is p (rand c)) gl))) in
       let ats = find_term (hd_is "all_ts") w in
       EXISTS_TAC (sub "domain") THEN
       EXISTS_TAC (list_mk_icomb "DRESTRICT" [sub "all_ts"; ats]))) THEN
    REPEAT CONJ_TAC THEN TRY (SOLVED (FIRST_ASSUM ACCEPT_TAC)) THEN
    (* the addresses of the maps are the ones of the old heap *)
    TRY (SOLVED
          (W(fun gl ->
             let iso = the_asm (fun c ->
               let bd = snd (strip_forall c) in
               is_eq bd && hd_is "isSomeDataElement" (lhand bd)) gl in
             ONCE_REWRITE_TAC[iso]) THEN
           FIRST [SOLVED (FIRST_ASSUM ACCEPT_TAC);
                  SOLVED (W(fun (asl,w as gl) ->
                    let dr = find_term (hd_is "DRESTRICT") w in
                    let inj = the_asm (fun c -> hd_is "INJ" c &&
                      rand (el 0 (snd (strip_comb c))) = lhand dr) gl in
                    MATCH_ACCEPT_TAC
                      (MATCH_MP INJ_DRESTRICT inj)))])) THEN
    (* the domain of the references has the key in it *)
    TRY (SOLVED
          (REWRITE_TAC[domain_insert] THEN
           MATCH_MP_TAC SUBSET_TRANS THEN
           W(fun gl ->
             let su = the_asm (fun c -> hd_is "SUBSET" c &&
                        hd_is "domain" (rand c)) gl in
             EXISTS_TAC (rand (concl su))) THEN
           CONJ_TAC THEN TRY (FIRST_ASSUM ACCEPT_TAC) THEN
           SET_TAC[])) THEN
    (* the timestamps of the restricted map are of the stack, and
       below the counter *)
    TRY (SOLVED
          (REWRITE_TAC[(CONJUNCT1 o SPEC_ALL) DRESTRICT_DEF] THEN
           FIRST [SOLVED (REWRITE_TAC[INTER_SUBSET]);
                  SOLVED (MATCH_MP_TAC SUBSET_TRANS THEN
                          W(fun gl ->
                            let su = the_asm (fun c ->
                              hd_is "SUBSET" c &&
                              hd_is "FDOM" (lhand c)) gl in
                            EXISTS_TAC (lhand (concl su))) THEN
                          CONJ_TAC THEN
                          TRY (FIRST_ASSUM ACCEPT_TAC) THEN
                          REWRITE_TAC[INTER_SUBSET])])) THEN
    (* the blocks of the stack stay unique *)
    TRY (SOLVED
          (W(fun gl ->
             let bu = the_asm (hd_is "blocks_unique") gl in
             MATCH_ACCEPT_TAC (MATCH_MP blocks_unique_update_mutblock
               (CONJ (a_lkptr gl) bu))))) THEN
    (* the transfers that the update of the hole leaves: what the
       invariant says of a value, what a value says of a thunk, and
       what the references hold at another key (MB_trans) *)
    W(fun (asl,w as gl) ->
      let st = the_asm (fun c -> is_eq c &&
                 hd_is "heap_store" (lhand c)) gl in
      let heap = el 2 (snd (strip_comb (lhand (concl st)))) in
      let hl = the_asm (fun c -> is_eq c &&
                 hd_is "heap_lookup" (lhand c) &&
                 el 1 (snd (strip_comb (lhand c))) = heap &&
                 can (fun t -> hd_is "BlockRep" (rand t))
                   (rand c)) gl in
      let nim = the_asm (fun c -> is_neg c &&
                  hd_is "IN" (rand c)) gl in
      let trs = CONJUNCTS (MATCH_MP MB_trans
                  (CONJ hl (CONJ (MATCH_MP IMAGE_NOT_point nim)
                    (CONJ (a_tr gl) (a_lkptr gl))))) in
      (* the block that the update puts in is as unfinalised as the
         one it replaces, which only the conclusion of MB_trans
         says, so the transfers have to be told (entry 55) *)
      let fv = find_term (fun t -> is_var t &&
                 fst (dest_var t) = "fin2") (concl (hd trs)) in
      let fin = el 1 (snd (strip_comb
                  (rand (rand (concl (a_lkptr gl)))))) in
      MAP_EVERY ASSUME_TAC (map (INST [fin,fv]) trs)) THEN
    (* the values of the stack: the value put in the hole and the
       pointer in front of it, and the rest *)
    W(fun (asl,w) -> if not (hd_is "ALL2" w) then ALL_TAC else
      (REWRITE_TAC[ALL2] THEN
       CONV_TAC(TOP_DEPTH_CONV BETA_CONV) THEN
       REPEAT CONJ_TAC THEN
       TRY (SOLVED
             (W(fun (asl,w as gl) ->
                let args = snd (strip_comb w) in
                let v1 = el 1 args in
                let ats = find_term (hd_is "all_ts") w in
                let vi = the_asm (fun c -> hd_is "v_inv" c &&
                           el 1 (snd (strip_comb c)) = v1 &&
                           not (el 2 (snd (strip_comb c)) =
                                  lhand ats)) gl in
                SUBGOAL_THEN
                  (list_mk_icomb "MEM" [v1; rand ats])
                  (fun mm -> MATCH_ACCEPT_TAC (MATCH_MP
                     v_inv_update_gen
                     (CONJ (a_vtr gl) (CONJ vi
                       (MP (SPECL [v1; rand ats; lhand ats]
                             MEM_stack_all_vs) mm))))) THEN
                REWRITE_TAC[MEM]))) THEN
       W(fun (asl,w as gl) ->
         let old = the_asm (fun c -> hd_is "ALL2" c &&
                     el 1 (snd (strip_comb c)) =
                       el 1 (snd (strip_comb w))) gl in
         let ats = find_term (hd_is "all_ts") w in
         let vs = el 1 (snd (strip_comb w)) in
         let v = genvar (hd (snd (dest_type (type_of (rand ats))))) in
         SUBGOAL_THEN
           (mk_forall(v, mk_imp(list_mk_icomb "MEM" [v; vs],
              list_mk_icomb "IN"
                [v; list_mk_icomb "all_vs" [lhand ats; rand ats]])))
           (fun mem -> ACCEPT_TAC (MATCH_MP EVERY2_v_inv_update_stack
              (CONJ (a_vtr gl) (CONJ mem old)))) THEN
         REPEAT STRIP_TAC THEN
         W(fun gl ->
           let mm = the_asm (hd_is "MEM") gl in
           let v1 = el 0 (snd (strip_comb (concl mm))) in
           SUBGOAL_THEN (list_mk_icomb "MEM" [v1; rand ats])
             (fun m2 -> MATCH_ACCEPT_TAC (MP (SPECL [v1; rand ats;
                          lhand ats] MEM_stack_all_vs) m2)) THEN
           ASM_REWRITE_TAC[MEM])))) THEN
    (* and the invariant of each reference that the stack reaches:
       it was reachable before the update
       (reachable_refs_MutBlock_UPDATE) *)
    W(fun (asl,w) -> if not (is_forall w) then ALL_TAC else
      (REPEAT STRIP_TAC THEN
       W(fun gl ->
         let rr = the_asm (fun c -> hd_is "reachable_refs" c &&
                    hd_is "sptree_insert"
                      (el 1 (snd (strip_comb c)))) gl in
         ASSUME_TAC (MATCH_MP reachable_refs_MutBlock_UPDATE
           (CONJ (a_lkptr gl) rr))) THEN
       W(fun (asl,w as gl) ->
         let n = el 1 (snd (strip_comb w)) in
         let bri = the_asm (fun c ->
           let vs,bd = strip_forall c in
           length vs = 1 && is_imp bd &&
           hd_is "bc_ref_inv" (rand bd)) gl in
         let rr = the_asm (fun c -> hd_is "reachable_refs" c &&
           not (hd_is "sptree_insert"
                  (el 1 (snd (strip_comb c))))) gl in
         let nin = the_asm (fun c -> hd_is "IN" c &&
           hd_is "FDOM" (rand c) &&
           el 0 (snd (strip_comb c)) = n) gl in
         ASSUME_TAC (MP (SPEC n bri) (CONJ rr nin))) THEN
       (* the reference written, or another one *)
       W(fun (asl,w as gl) ->
         ASM_CASES_TAC (mk_eq (el 1 (snd (strip_comb w)),
                               g_ptr gl))) THEN
       TRY VAR_EQ_TAC THEN
       (* the one written: the block with the hole filled *)
       TRY (SOLVED
             (W(fun (asl,w as gl) ->
                let lk1 = the_asm (fun c -> is_eq c &&
                            hd_is "FLOOKUP" (lhand c)) gl in
                let p = rand (rand (concl lk1)) in
                let hl2 = the_asm (fun c -> is_eq c &&
                            hd_is "heap_lookup" (lhand c) &&
                            el 0 (snd (strip_comb (lhand c))) = p &&
                            can (fun t -> hd_is "BlockRep" (rand t))
                              (rand c) &&
                            can (find_term (hd_is "LUPDATE"))
                              (rand c)) gl in
                let lup = find_term (hd_is "LUPDATE") (concl hl2) in
                let old = the_asm (fun c -> hd_is "ALL2" c &&
                            el 1 (snd (strip_comb c)) =
                              el 2 (snd (strip_comb lup))) gl in
                let vi = the_asm (fun c -> hd_is "v_inv" c &&
                           el 0 (tparts (el 3 (snd (strip_comb c)))) =
                             el 0 (snd (strip_comb lup))) gl in
                let gk = the_asm (fun c ->
                           length (fst (strip_forall c)) = 1 &&
                           is_neg (snd (strip_forall c))) gl in
                let nim = the_asm (fun c -> is_neg c &&
                            hd_is "IN" (rand c)) gl in
                let ats = find_term (hd_is "all_ts") w in
                let ins = lhand ats in
                let bargs = snd (strip_comb
                              (el 1 (snd (strip_comb ins)))) in
                let vls = list_mk_icomb "APPEND"
                            [el 2 bargs; list_mk_icomb "APPEND"
                              [mk_flist [el 3 bargs]; el 4 bargs]] in
                let v = genvar (type_of (el 3 bargs)) in
                SUBGOAL_THEN
                  (mk_forall(v, mk_imp(list_mk_icomb "MEM" [v; vls],
                     list_mk_icomb "IN"
                       [v; list_mk_icomb "all_vs" [ins; rand ats]])))
                  (fun mem -> MATCH_ACCEPT_TAC (MATCH_MP
                     bc_ref_inv_update_mutblock_at
                     (CONJ lk1 (CONJ hl2 (CONJ (a_lkptr gl)
                       (CONJ old (CONJ vi (CONJ gk (CONJ nim
                         (CONJ (a_vtr gl) mem)))))))))) THEN
                REPEAT STRIP_TAC THEN
                W(fun (asl,w as gl) ->
                  let iargs = snd (strip_comb
                                (find_term (hd_is "sptree_insert")
                                   w)) in
                  let mm = the_asm (hd_is "MEM") gl in
                  SUBGOAL_THEN
                    (mk_eq (list_mk_icomb "sptree_lookup"
                              [el 0 iargs;
                               find_term (hd_is "sptree_insert") w],
                            list_mk_icomb "SOME" [el 1 iargs]))
                    (fun lkn -> MATCH_ACCEPT_TAC
                       (MATCH_MP MEM_mutblock_all_vs
                         (CONJ lkn mm))) THEN
                  REWRITE_TAC[lookup_insert])))) THEN
       (* another one: its element did not move *)
       TRY (SOLVED
             (W(fun (asl,w as gl) ->
                let fm = el 0 (tparts (el 3 (snd (strip_comb w)))) in
                let inj = the_asm (fun c -> hd_is "INJ" c &&
                            rand (el 0 (snd (strip_comb c))) = fm) gl in
                let pin = the_asm (fun c -> hd_is "IN" c &&
                            hd_is "FDOM" (rand c) &&
                            el 0 (snd (strip_comb c)) = g_ptr gl) gl in
                let neq = the_asm (fun c -> is_neg c &&
                            is_eq (rand c) &&
                            rand (rand c) = g_ptr gl) gl in
                let inv = the_asm (hd_is "bc_ref_inv") gl in
                MATCH_ACCEPT_TAC (MATCH_MP bc_ref_inv_update_other_gen
                  (CONJ inj (CONJ pin (CONJ neq (CONJ (a_vtr gl)
                    (CONJ (a_dtr gl) (CONJ (a_ltr gl)
                      (CONJ (a_tr gl) inv))))))))))))) THEN
    ALL_TAC)
### update_byte_ref_thm
  (* the steps are above the statement (tools/overrides.py).  The
     root of the pointer is the address of its reference, which
     v_inv of a pointer gives in the first of its three ways,
     because the reference holds an array of bytes, and the
     annotation that such a root carries is zero; the invariant of
     the reference gives the element of the heap that holds the
     bytes, and heap_lookup_SPLIT cuts the heap at it.  The store
     writes an element of the length it replaces, so the heap, the
     roots and the unused space are as good as they were, and of
     the reference written the invariant is the element with the
     bytes put in while of any other one it is the element it had,
     which the store did not touch *)
  (STRIP_TAC THEN
    (* what the invariant says of the stack with the pointer on it *)
    FIRST_X_ASSUM (fun inv ->
      if not (hd_is "abs_ml_inv" (concl inv)) then fail() else
      STRIP_ASSUME_TAC (REWRITE_RULE[abs_ml_inv_def;
                                     bc_stack_ref_inv_def] inv)) THEN
    (* the roots are the one of the pointer and the rest *)
    SPLIT_ROOTS_TAC THEN
    (* and the root of the pointer is the address of its reference *)
    FIRST_ASSUM (fun vr ->
      let c = concl vr in
      if not (hd_is "v_inv" c) ||
         not (hd_is "dataSem_RefPtr" (el 1 (snd (strip_comb c))))
      then fail()
      else STRIP_ASSUME_TAC (REWRITE_RULE[v_inv_def] vr)) THEN
    (* of the three ways a pointer is related only the first is left,
       because the reference holds an array of bytes: the two that
       are about a thunk say the reference holds one *)
    (let rws = distinctness "thunk_mode" :: ref_rws in
     RULE_ASSUM_TRY (REWRITE_RULE rws) THEN
     TRY (FIRST_ASSUM CONTR_TAC) THEN
     TRY (W(fun (asl,_) ->
       let lks = mapfilter (fun (_,th) ->
                   let c = concl th in
                   if is_eq c && hd_is "sptree_lookup" (lhand c) &&
                      hd_is "SOME" (rand c) then th else fail()) asl in
       if length lks < 2 then fail() else
       MP_TAC (TRANS (SYM (el 0 lks)) (el 1 lks)) THEN
       REWRITE_TAC (injectivity "option" ::
                    injectivity "bvlSem_ref" :: rws) THEN
       STRIP_TAC)) THEN
     SPLIT_ASM_TAC THEN
     TRY VAR_EQ_TAC) THEN
    (* the annotation that the root of an array of bytes carries is
       zero *)
    W(fun gl ->
      let lk = the_asm (fun c -> is_eq c &&
                 hd_is "sptree_lookup" (lhand c) &&
                 hd_is "SOME" (rand c)) gl in
      let an = MATCH_MP ref_ptr_annot_ByteArray lk in
      RULE_ASSUM_TRY (REWRITE_RULE[an]) THEN REWRITE_TAC[an]) THEN
    (* the reference has an address *)
    (SUBGOAL_THEN (cake_as_vars (fun () ->
       `FLOOKUP (f:(num,num)fmap) (ptr:num) = SOME (FAPPLY f ptr:num)`))
       ASSUME_TAC THENL
      [ASM_REWRITE_TAC[FLOOKUP_DEF]; ALL_TAC]) THEN
    (* and it is reachable, so the invariant holds of it *)
    (SUBGOAL_THEN (cake_as_vars (fun () ->
       `reachable_refs (RefPtr b ptr :: stack) refs ptr`))
       ASSUME_TAC THENL
      [MATCH_MP_TAC (GEN_ALL reach_refptr) THEN
       FIRST [EXISTS_TAC (cake_as_vars (fun () -> `b:bool`));
              ALL_TAC] THEN
       REWRITE_TAC[MEM];
       ALL_TAC]) THEN
    W(fun (asl,w as gl) ->
      let bri = the_asm (fun c ->
        let vs,bd = strip_forall c in
        length vs = 1 && is_imp bd &&
        hd_is "bc_ref_inv" (rand bd)) gl in
      let rr = the_asm (hd_is "reachable_refs") gl in
      let n = el 2 (snd (strip_comb (concl rr))) in
      let nin = the_asm (fun c -> hd_is "IN" c &&
                  hd_is "FDOM" (rand c) &&
                  el 0 (snd (strip_comb c)) = n) gl in
      ASSUME_TAC (MP (SPEC n bri) (CONJ rr nin))) THEN
    (* which is the arm of an array of bytes: the element of the heap
       that holds the bytes *)
    W(fun gl ->
      let lk1 = the_asm (fun c -> is_eq c &&
                  hd_is "FLOOKUP" (lhand c)) gl in
      let lk2 = the_asm (fun c -> is_eq c &&
                  hd_is "sptree_lookup" (lhand c) &&
                  hd_is "SOME" (rand c)) gl in
      FIRST_X_ASSUM (fun inv ->
        if not (hd_is "bc_ref_inv" (concl inv)) then fail() else
        ASSUME_TAC (CONV_RULE(TOP_DEPTH_CONV let_CONV)
          (REWRITE_RULE[MATCH_MP arm_BA (CONJ lk1 lk2)] inv)))) THEN
    (* so the heap is the element and what is around it *)
    W(fun gl ->
      let hl = the_asm (fun c -> is_eq c &&
                 hd_is "heap_lookup" (lhand c) &&
                 hd_is "SOME" (rand c)) gl in
      STRIP_ASSUME_TAC (ONCE_REWRITE_RULE[APPEND_SINGLE]
        (MATCH_MP heap_lookup_SPLIT hl))) THEN
    FIRST_X_ASSUM (fun e ->
      let c = concl e in
      if not (is_eq c) || not (is_var (lhand c)) ||
         not (hd_is "APPEND" (rand c)) then fail() else
      SUBST_ALL_TAC e) THEN
    (* the witnesses: the rest of the roots, the heap around the
       element, and the bytes that the element holds *)
    W(fun (asl,w as gl) ->
      let hl = the_asm (fun c -> is_eq c &&
                 hd_is "heap_lookup" (lhand c) &&
                 hd_is "SOME" (rand c)) gl in
      let old = el 1 (snd (strip_comb (lhand (concl hl)))) in
      let u = lhand (lhand (rand old)) in
      let rts = lhand (hd (conjuncts (snd (strip_exists w)))) in
      let rts = if not (is_var rts) then rts else
                rand (concl (the_asm (fun c -> is_eq c &&
                               lhand c = rts) gl)) in
      MAP_EVERY EXISTS_TAC
        [rand rts; lhand old; rand (rand old);
         el 3 (snd (strip_comb u))]) THEN
    REPEAT CONJ_TAC THEN
    TRY (SOLVED (ASM_REWRITE_TAC[])) THEN
    TRY (SOLVED (REWRITE_TAC[LENGTH_REPLICATE])) THEN
    (* the addresses that hold data are the ones that held data *)
    (W(fun (asl,w as gl) ->
       let nw = byte_heap w in
       let old = byte_heap (concl (the_asm (hd_is "heap_ok") gl)) in
       let n = genvar `:num` in
       let iso h = list_mk_icomb "isSomeDataElement"
                     [list_mk_icomb "heap_lookup" [n; h]] in
       SUBGOAL_THEN (mk_forall(n, mk_eq (iso nw, iso old)))
         ASSUME_TAC) THENL
     [MATCH_ACCEPT_TAC isSomeDataElement_byte_update; ALL_TAC]) THEN
    (* the elements that the store did not write are where they were
       (heap_lookup_byte_other), and what the invariant, a thunk and
       the other references say is what they said (BA_trans) *)
    W(fun gl ->
      let hl = the_asm (fun c -> is_eq c &&
                 hd_is "heap_lookup" (lhand c) &&
                 hd_is "SOME" (rand c)) gl in
      let pe = the_asm (fun c -> is_eq c &&
                 hd_is "fmap_apply" (lhand c) &&
                 hd_is "heap_length" (rand c)) gl in
      let le = the_asm (fun c -> is_eq c &&
                 hd_is "LENGTH" (lhand c)) gl in
      let lk = the_asm (fun c -> is_eq c &&
                 hd_is "sptree_lookup" (lhand c) &&
                 hd_is "SOME" (rand c)) gl in
      MAP_EVERY ASSUME_TAC
        (MATCH_MP heap_lookup_byte_other (CONJ hl (CONJ pe le)) ::
         CONJUNCTS (MATCH_MP BA_trans (CONJ lk (CONJ hl le))))) THEN
    (* and the invariant of the new heap and references *)
    REWRITE_TAC[abs_ml_inv_def; bc_stack_ref_inv_def] THEN
    REPEAT CONJ_TAC THEN
    TRY (SOLVED (FIRST_ASSUM ACCEPT_TAC)) THEN
    (* the roots are the ones they were, of a heap as good *)
    TRY (SOLVED
          (W(fun gl ->
             let iso = the_asm (fun c ->
               let bd = snd (strip_forall c) in
               is_eq bd && hd_is "isSomeDataElement" (lhand bd)) gl in
             let ro = the_asm (hd_is "roots_ok") gl in
             ACCEPT_TAC (MATCH_MP roots_ok_iso (CONJ ro iso))))) THEN
    (* the heap stays good (heap_ok_byte_update) *)
    TRY (SOLVED
          (W(fun gl ->
             let ho = the_asm (hd_is "heap_ok") gl in
             let le = the_asm (fun c -> is_eq c &&
                        hd_is "LENGTH" (lhand c)) gl in
             MATCH_ACCEPT_TAC (MATCH_MP heap_ok_byte_update
               (CONJ ho le))))) THEN
    (* the kind of the collection (gc_kind_byte_update) *)
    TRY (SOLVED
          (W(fun gl ->
             let gk = the_asm (hd_is "gc_kind_inv") gl in
             let le = the_asm (fun c -> is_eq c &&
                        hd_is "LENGTH" (lhand c)) gl in
             MATCH_ACCEPT_TAC (MATCH_MP gc_kind_byte_update
               (CONJ gk le))))) THEN
    (* and the unused space (unused_space_inv_byte_update) *)
    TRY (SOLVED
          (W(fun gl ->
             let us = the_asm (hd_is "unused_space_inv") gl in
             MATCH_ACCEPT_TAC (MATCH_MP unused_space_inv_byte_update
               us)))) THEN
    (* the maps of the new invariant: the addresses are the ones they
       were, and the timestamps are cut to the ones of the new
       references and stack *)
    W(fun (asl,w as gl) ->
      if not (is_exists w) then ALL_TAC else
      (let sub p = rand (lhand (concl (the_asm (fun c ->
         hd_is "SUBSET" c && hd_is p (rand c)) gl))) in
       let ats = find_term (hd_is "all_ts") w in
       EXISTS_TAC (sub "domain") THEN
       EXISTS_TAC (list_mk_icomb "DRESTRICT" [sub "all_ts"; ats]))) THEN
    REPEAT CONJ_TAC THEN TRY (SOLVED (FIRST_ASSUM ACCEPT_TAC)) THEN
    (* the addresses of the maps are the ones of the old heap *)
    TRY (SOLVED
          (W(fun gl ->
             let iso = the_asm (fun c ->
               let bd = snd (strip_forall c) in
               is_eq bd && hd_is "isSomeDataElement" (lhand bd)) gl in
             ONCE_REWRITE_TAC[iso]) THEN
           FIRST [SOLVED (FIRST_ASSUM ACCEPT_TAC);
                  SOLVED (W(fun (asl,w as gl) ->
                    let dr = find_term (hd_is "DRESTRICT") w in
                    let inj = the_asm (fun c -> hd_is "INJ" c &&
                      rand (el 0 (snd (strip_comb c))) = lhand dr) gl in
                    MATCH_ACCEPT_TAC
                      (MATCH_MP INJ_DRESTRICT inj)))])) THEN
    (* the domain of the references has the key in it *)
    TRY (SOLVED
          (REWRITE_TAC[domain_insert] THEN
           MATCH_MP_TAC SUBSET_TRANS THEN
           W(fun gl ->
             let su = the_asm (fun c -> hd_is "SUBSET" c &&
                        hd_is "domain" (rand c)) gl in
             EXISTS_TAC (rand (concl su))) THEN
           CONJ_TAC THEN TRY (FIRST_ASSUM ACCEPT_TAC) THEN
           SET_TAC[])) THEN
    (* the timestamps of the restricted map are of the stack, and
       below the counter *)
    TRY (SOLVED
          (REWRITE_TAC[(CONJUNCT1 o SPEC_ALL) DRESTRICT_DEF] THEN
           FIRST [SOLVED (REWRITE_TAC[INTER_SUBSET]);
                  SOLVED (MATCH_MP_TAC SUBSET_TRANS THEN
                          W(fun gl ->
                            let su = the_asm (fun c ->
                              hd_is "SUBSET" c &&
                              hd_is "FDOM" (lhand c)) gl in
                            EXISTS_TAC (lhand (concl su))) THEN
                          CONJ_TAC THEN
                          TRY (FIRST_ASSUM ACCEPT_TAC) THEN
                          REWRITE_TAC[INTER_SUBSET])])) THEN
    (* the blocks of the stack stay unique *)
    TRY (SOLVED
          (W(fun gl ->
             let bu = the_asm (hd_is "blocks_unique") gl in
             MATCH_ACCEPT_TAC (MATCH_MP blocks_unique_insert_ByteArray
               bu)))) THEN
    (* the values of the stack: the pointer in front and the rest *)
    W(fun (asl,w) -> if not (hd_is "ALL2" w) then ALL_TAC else
      (REWRITE_TAC[ALL2] THEN
       CONV_TAC(TOP_DEPTH_CONV BETA_CONV) THEN
       REPEAT CONJ_TAC THEN
       TRY (SOLVED
             (W(fun (asl,w as gl) ->
                let args = snd (strip_comb w) in
                let v1 = el 1 args in
                let ats = find_term (hd_is "all_ts") w in
                let vi = the_asm (fun c -> hd_is "v_inv" c &&
                           el 1 (snd (strip_comb c)) = v1 &&
                           not (el 2 (snd (strip_comb c)) =
                                  lhand ats)) gl in
                SUBGOAL_THEN
                  (list_mk_icomb "MEM" [v1; rand ats])
                  (fun mm -> MATCH_ACCEPT_TAC (MATCH_MP
                     v_inv_update_gen
                     (CONJ (a_vtr gl) (CONJ vi
                       (MP (SPECL [v1; rand ats; lhand ats]
                             MEM_stack_all_vs) mm))))) THEN
                REWRITE_TAC[MEM]))) THEN
       W(fun (asl,w as gl) ->
         let old = the_asm (fun c -> hd_is "ALL2" c &&
                     el 1 (snd (strip_comb c)) =
                       el 1 (snd (strip_comb w))) gl in
         let ats = find_term (hd_is "all_ts") w in
         let vs = el 1 (snd (strip_comb w)) in
         let v = genvar (hd (snd (dest_type (type_of (rand ats))))) in
         SUBGOAL_THEN
           (mk_forall(v, mk_imp(list_mk_icomb "MEM" [v; vs],
              list_mk_icomb "IN"
                [v; list_mk_icomb "all_vs" [lhand ats; rand ats]])))
           (fun mem -> ACCEPT_TAC (MATCH_MP EVERY2_v_inv_update_stack
              (CONJ (a_vtr gl) (CONJ mem old)))) THEN
         REPEAT STRIP_TAC THEN
         W(fun gl ->
           let mm = the_asm (hd_is "MEM") gl in
           let v1 = el 0 (snd (strip_comb (concl mm))) in
           SUBGOAL_THEN (list_mk_icomb "MEM" [v1; rand ats])
             (fun m2 -> MATCH_ACCEPT_TAC (MP (SPECL [v1; rand ats;
                          lhand ats] MEM_stack_all_vs) m2)) THEN
           ASM_REWRITE_TAC[MEM])))) THEN
    (* and the invariant of each reference that the stack reaches: it
       was reachable before the store (reach_refs_update_byte) *)
    W(fun (asl,w) -> if not (is_forall w) then ALL_TAC else
      (REPEAT STRIP_TAC THEN
       W(fun gl ->
         let rr = the_asm (fun c -> hd_is "reachable_refs" c &&
                    hd_is "sptree_insert"
                      (el 1 (snd (strip_comb c)))) gl in
         ASSUME_TAC (MATCH_MP reach_refs_update_byte
           (CONJ rr (a_lkptr gl)))) THEN
       W(fun (asl,w as gl) ->
         let n = el 1 (snd (strip_comb w)) in
         let bri = the_asm (fun c ->
           let vs,bd = strip_forall c in
           length vs = 1 && is_imp bd &&
           hd_is "bc_ref_inv" (rand bd)) gl in
         let rr = the_asm (fun c -> hd_is "reachable_refs" c &&
           not (hd_is "sptree_insert"
                  (el 1 (snd (strip_comb c))))) gl in
         let nin = the_asm (fun c -> hd_is "IN" c &&
           hd_is "FDOM" (rand c) &&
           el 0 (snd (strip_comb c)) = n) gl in
         ASSUME_TAC (MP (SPEC n bri) (CONJ rr nin))) THEN
       (* the reference written, or another one *)
       W(fun (asl,w as gl) ->
         ASM_CASES_TAC (mk_eq (el 1 (snd (strip_comb w)),
                               g_ptr gl))) THEN
       TRY VAR_EQ_TAC THEN
       (* the one written: the element holds the bytes put in *)
       TRY (SOLVED
             (W(fun gl ->
                let lk1 = the_asm (fun c -> is_eq c &&
                            hd_is "FLOOKUP" (lhand c)) gl in
                let hl = the_asm (fun c -> is_eq c &&
                           hd_is "heap_lookup" (lhand c) &&
                           hd_is "SOME" (rand c)) gl in
                let pe = the_asm (fun c -> is_eq c &&
                           hd_is "fmap_apply" (lhand c) &&
                           hd_is "heap_length" (rand c)) gl in
                let le = the_asm (fun c -> is_eq c &&
                           hd_is "LENGTH" (lhand c)) gl in
                let ws = el 3 (snd (strip_comb
                           (rand (rand (concl hl))))) in
                MATCH_ACCEPT_TAC (MATCH_MP bc_ref_inv_update_byte_at
                  (CONJ lk1 (CONJ hl (CONJ pe (CONJ (a_lkptr gl)
                    (CONJ le (REFL ws)))))))))) THEN
       (* another one: its element did not move *)
       TRY (SOLVED
             (W(fun (asl,w as gl) ->
                let fm = el 0 (tparts (el 3 (snd (strip_comb w)))) in
                let inj = the_asm (fun c -> hd_is "INJ" c &&
                            rand (el 0 (snd (strip_comb c))) = fm) gl in
                let pin = the_asm (fun c -> hd_is "IN" c &&
                            hd_is "FDOM" (rand c) &&
                            el 0 (snd (strip_comb c)) = g_ptr gl) gl in
                let neq = the_asm (fun c -> is_neg c &&
                            is_eq (rand c) &&
                            rand (rand c) = g_ptr gl) gl in
                let inv = the_asm (hd_is "bc_ref_inv") gl in
                MATCH_ACCEPT_TAC (MATCH_MP bc_ref_inv_update_other_gen
                  (CONJ inj (CONJ pin (CONJ neq (CONJ (a_vtr gl)
                    (CONJ (a_dtr gl) (CONJ (a_ltr gl)
                      (CONJ (a_tr gl) inv))))))))))))) THEN
    ALL_TAC)
### new_ref_thm
  (* the steps are above the statement (tools/overrides.py).  The
     roots of the values of the array are the front of the roots of
     the stack (EVERY2_APPEND_IMP_APPEND), the array fits in the
     unused space and IMP_heap_store_unused writes it at the top of
     it; the heap, the roots and the space are then as good as they
     were (gc_kind_store_unused of the kind of the collection,
     where the array is a reference and so belongs below the
     split), the map of the addresses gains the key of the array
     with the address it was written at, and of every reference
     that the stack reaches the invariant holds as it did
     (bc_ref_inv_step) -- while the array itself is the element
     that the store wrote, with the values that the stack gave
     it *)
  (STRIP_TAC THEN SPLIT_ASM_TAC THEN
    (* what the invariant says of the stack that the array is
       built from *)
    FIRST_X_ASSUM (fun inv ->
      if not (hd_is "abs_ml_inv" (concl inv)) then fail() else
      STRIP_ASSUME_TAC (REWRITE_RULE[abs_ml_inv_def;
                                     bc_stack_ref_inv_def] inv)) THEN
    (* the roots of the values of the array, and the rest *)
    W(fun gl ->
      let e2 = the_asm (hd_is "ALL2") gl in
      STRIP_ASSUME_TAC (MATCH_MP EVERY2_APPEND_IMP_APPEND e2)) THEN
    (* the roots of the array are as many as its values, and its
       element is a word longer than they are *)
    W(fun (asl,w as gl) ->
      let va = find_term (hd_is "bvlSem_ValueArray") w in
      let xs = el 0 (snd (strip_comb va)) in
      let e1 = the_asm (fun c -> hd_is "ALL2" c &&
                 el 1 (snd (strip_comb c)) = xs) gl in
      let ys1 = el 2 (snd (strip_comb (concl e1))) in
      let rb = rator (find_term (hd_is "RefBlock") w) in
      let el1 = mk_comb (rb, ys1) in
      ASSUME_TAC (MATCH_MP LIST_REL_LENGTH e1) THEN
      SUBGOAL_THEN (mk_eq (list_mk_icomb "el_length" [el1],
                      list_mk_icomb "+"
                        [list_mk_icomb "LENGTH" [ys1];
                         mk_small_numeral 1])) ASSUME_TAC THENL
       [REWRITE_TAC[RefBlock_def; el_length_def] THEN
        MATCH_REDUCE_TAC THEN REWRITE_TAC[];
        ALL_TAC]) THEN
    (* so it fits in the unused space, and the store writes it at
       the top of it *)
    W(fun (asl,w as gl) ->
      let us = the_asm (hd_is "unused_space_inv") gl in
      let spsp = el 1 (snd (strip_comb (concl us))) in
      let le = the_asm (fun c -> is_eq c &&
                 hd_is "el_length" (lhand c)) gl in
      let el1 = el 0 (snd (strip_comb (lhand (concl le)))) in
      SUBGOAL_THEN (list_mk_icomb "<="
                      [list_mk_icomb "el_length" [el1]; spsp])
        (fun bd -> STRIP_ASSUME_TAC (MATCH_MP
           IMP_heap_store_unused (CONJ us bd))) THENL
       [REWRITE_TAC[le] THEN ASM_ARITH_TAC;
        ALL_TAC]) THEN
    (* the element is a data element, which is what the two facts
       about the store ask for *)
    W(fun gl ->
      let st = the_asm (fun c -> is_eq c &&
                 hd_is "heap_store_unused" (lhand c)) gl in
      let el1 = el 2 (snd (strip_comb (lhand (concl st)))) in
      let isd = is_data_el el1 in
      MAP_EVERY (fun th -> ASSUME_TAC (MP th isd))
        (mapfilter (fun (_,th) ->
           let c = concl th in
           if is_imp c && hd_is "isDataElement" (lhand c) then th
           else fail()) (fst gl))) THEN
    (* the witnesses: the roots of the array, the rest of them and
       the heap that the store wrote *)
    W(fun (asl,w as gl) ->
      let st = the_asm (fun c -> is_eq c &&
                 hd_is "heap_store_unused" (lhand c)) gl in
      let ys1 = el 0 (snd (strip_comb
                  (el 2 (snd (strip_comb (lhand (concl st))))))) in
      let heap2 = lhand (rand (concl st)) in
      let rts = the_asm (fun c -> is_eq c && is_var (lhand c) &&
                  hd_is "APPEND" (rand c)) gl in
      EXISTS_TAC (genvar (type_of (fst (dest_exists w)))) THEN
      MAP_EVERY EXISTS_TAC
        [ys1; rand (rand (concl rts)); heap2]) THEN
    REPEAT CONJ_TAC THEN
    TRY (SOLVED (FIRST_ASSUM ACCEPT_TAC)) THEN
    TRY (SOLVED (W(fun gl ->
      let le = the_asm (fun c -> is_eq c &&
                 hd_is "LENGTH" (lhand c) &&
                 hd_is "LENGTH" (rand c)) gl in
      ACCEPT_TAC (SYM le)))) THEN
    (* and the invariant of the new heap, stack and references *)
    REWRITE_TAC[abs_ml_inv_def] THEN
    (* the length of the element in the terms that the statement
       uses: the roots of the array are as many as its values, so
       the address the store wrote at is the one the statement
       names *)
    W(fun gl ->
      let le = the_asm (fun c -> is_eq c &&
                 hd_is "el_length" (lhand c)) gl in
      let lenq = the_asm (fun c -> is_eq c &&
                   hd_is "LENGTH" (lhand c) &&
                   hd_is "LENGTH" (rand c)) gl in
      let le2 = REWRITE_RULE[GSYM lenq] le in
      RULE_ASSUM_TRY (REWRITE_RULE[le2]) THEN ASSUME_TAC le2) THEN
    (* the addresses that hold data are the ones that did, and the
       one the store wrote *)
    W(fun gl ->
      let seq = the_asm (fun c -> is_eq c &&
                  hd_is "INSERT" (rand c)) gl in
      let ro = the_asm (hd_is "roots_ok") gl in
      ASSUME_TAC (REWRITE_RULE[EXTENSION; IN_INSERT; IN_ELIM_THM]
                    seq) THEN
      ASSUME_TAC (REWRITE_RULE[roots_ok_def] ro)) THEN
    REPEAT CONJ_TAC THEN
    (* the roots: the one of the array is the address it was
       written at, and the others are the ones they were *)
    TRY (SOLVED
          (REWRITE_TAC[roots_ok_def; MEM_APPEND; MEM] THEN
           REPEAT STRIP_TAC THEN
           W(fun gl ->
             let iso = the_asm (fun c ->
                         let vs,bd = strip_forall c in
                         length vs = 1 && is_eq bd &&
                         hd_is "isSomeDataElement" (lhand bd)) gl in
             REWRITE_TAC[iso]) THEN
           TRY (SOLVED
                 (DISJ1_TAC THEN
                  FIRST_X_ASSUM (fun e ->
                    if not (is_eq (concl e)) ||
                       not (hd_is "gc_shared_Pointer"
                              (rand (concl e)))
                    then fail() else
                    MP_TAC e) THEN
                  REWRITE_TAC[injectivity "heap_address"] THEN
                  MESON_TAC[])) THEN
           DISJ2_TAC THEN
           W(fun gl ->
             let ro = the_asm (fun c ->
                        let vs,bd = strip_forall c in
                        length vs = 2 && is_imp bd &&
                        hd_is "MEM" (lhand bd)) gl in
             let m = the_asm (fun c -> hd_is "MEM" c &&
                       hd_is "gc_shared_Pointer"
                         (el 0 (snd (strip_comb c)))) gl in
             let rts = the_asm (fun c -> is_eq c &&
                         is_var (lhand c) &&
                         hd_is "APPEND" (rand c)) gl in
             SUBGOAL_THEN (list_mk_icomb "MEM"
                 [el 0 (snd (strip_comb (concl m)));
                  lhand (concl rts)])
               (fun mr -> ACCEPT_TAC (MATCH_MP ro mr)) THEN
             ASM_REWRITE_TAC[MEM_APPEND]))) THEN
    (* the heap is good: it is as long as it was, it has no forward
       pointer, and the pointers of the array are roots of the
       stack *)
    TRY (SOLVED
          (REWRITE_TAC[heap_ok_def] THEN
           REPEAT CONJ_TAC THEN
           TRY (SOLVED
                 (W(fun gl ->
                    let ho = REWRITE_RULE[heap_ok_def]
                               (the_asm (hd_is "heap_ok") gl) in
                    let hl = the_asm (fun c -> is_eq c &&
                               hd_is "heap_length" (lhand c)) gl in
                    MP_TAC ho THEN REWRITE_TAC[hl] THEN
                    STRIP_TAC THEN ASM_REWRITE_TAC[]))) THEN
           TRY (SOLVED
                 (W(fun gl ->
                    let ho = REWRITE_RULE[heap_ok_def]
                               (the_asm (hd_is "heap_ok") gl) in
                    let impl = the_asm (fun c -> is_imp c &&
                                 is_neg (lhand c) &&
                                 hd_is "isForwardPointer"
                                   (rand (lhand c))) gl in
                    let st = the_asm (fun c -> is_eq c &&
                               hd_is "heap_store_unused"
                                 (lhand c)) gl in
                    let el1 = el 2 (snd (strip_comb
                                (lhand (concl st)))) in
                    SUBGOAL_THEN (mk_neg (list_mk_icomb
                                    "isForwardPointer" [el1]))
                      (fun nf -> MP_TAC ho THEN
                         REWRITE_TAC[MP impl nf] THEN
                         STRIP_TAC THEN ASM_REWRITE_TAC[]) THEN
                    REWRITE_TAC[RefBlock_def;
                                isForwardPointer_def] THEN
                    MATCH_REDUCE_TAC THEN REWRITE_TAC[]))) THEN
           REPEAT GEN_TAC THEN
           W(fun gl ->
             let mem = the_asm (fun c ->
                         let vs,bd = strip_forall c in
                         length vs = 3 && is_eq bd &&
                         hd_is "MEM" (lhand bd)) gl in
             REWRITE_TAC[mem]) THEN
           STRIP_TAC THEN
           W(fun gl ->
             let iso = the_asm (fun c ->
                         let vs,bd = strip_forall c in
                         length vs = 1 && is_eq bd &&
                         hd_is "isSomeDataElement" (lhand bd)) gl in
             REWRITE_TAC[iso]) THEN
           DISJ2_TAC THEN
           TRY (SOLVED
                 (W(fun gl ->
                    let eq = the_asm (fun c -> is_eq c &&
                               hd_is "RefBlock" (lhand c)) gl in
                    MP_TAC eq) THEN
                  REWRITE_TAC[RefBlock_def;
                              injectivity "heap_element"] THEN
                  STRIP_TAC THEN
                  W(fun gl ->
                    let ro = the_asm (fun c ->
                               let vs,bd = strip_forall c in
                               length vs = 2 && is_imp bd &&
                               hd_is "MEM" (lhand bd)) gl in
                    let m = the_asm (fun c -> hd_is "MEM" c &&
                              hd_is "gc_shared_Pointer"
                                (el 0 (snd (strip_comb c)))) gl in
                    let rts = the_asm (fun c -> is_eq c &&
                                is_var (lhand c) &&
                                hd_is "APPEND" (rand c)) gl in
                    SUBGOAL_THEN (list_mk_icomb "MEM"
                        [el 0 (snd (strip_comb (concl m)));
                         lhand (concl rts)])
                      (fun mr -> ACCEPT_TAC (MATCH_MP ro mr)) THEN
                    ASM_REWRITE_TAC[MEM_APPEND]))) THEN
           W(fun gl ->
             let ho = REWRITE_RULE[heap_ok_def]
                        (the_asm (hd_is "heap_ok") gl) in
             let m1 = the_asm (fun c -> hd_is "MEM" c &&
                        hd_is "DataElement"
                          (el 0 (snd (strip_comb c)))) gl in
             let m2 = the_asm (fun c -> hd_is "MEM" c &&
                        hd_is "gc_shared_Pointer"
                          (el 0 (snd (strip_comb c)))) gl in
             MESON_TAC[ho; m1; m2]))) THEN
    (* the kind of the collection: the store at the top of the
       unused space keeps it, and the array is a reference *)
    W(fun (asl,w as gl) ->
      if not (hd_is "gc_kind_inv" w) then ALL_TAC else
      (let gk = the_asm (hd_is "gc_kind_inv") gl in
       let st = the_asm (fun c -> is_eq c &&
                  hd_is "heap_store_unused" (lhand c)) gl in
       let el1 = el 2 (snd (strip_comb (lhand (concl st)))) in
       let sp = el 2 (snd (strip_comb (concl gk))) in
       let le = the_asm (fun c -> is_eq c &&
                  hd_is "el_length" (lhand c)) gl in
       let us2 = REWRITE_RULE[GSYM le]
                   (the_asm (fun c -> hd_is "unused_space_inv" c &&
                      can (find_term (hd_is "-")) c) gl) in
       let ir = PART_MATCH I isRef_RefBlock
                  (list_mk_icomb
                     "data_to_word_memoryProof_isRef" [el1]) in
       SUBGOAL_THEN (list_mk_icomb "<="
                       [list_mk_icomb "el_length" [el1]; sp])
         (fun bd -> MATCH_ACCEPT_TAC (REWRITE_RULE[le] (MATCH_MP
            gc_kind_store_unused
            (CONJ ir (CONJ bd (CONJ gk (CONJ st us2))))))) THEN
       REWRITE_TAC[le] THEN ASM_ARITH_TAC)) THEN
    (* the unused space: what the store lemma says, with the length
       of the array taken off *)
    W(fun (asl,w as gl) ->
      if not (hd_is "unused_space_inv" w) then ALL_TAC else
      (let us = the_asm (fun c -> hd_is "unused_space_inv" c &&
                  can (find_term (hd_is "-")) c) gl in
       MP_TAC us THEN
       W(fun (asl,w) ->
         let usub = el 1 (snd (strip_comb (lhand w))) in
         let gsub = el 1 (snd (strip_comb (rand w))) in
         (* the two spaces are the same, and only that equation is
            rewritten with: the lengths of the values and of the
            roots are equal as well, and rewriting with that would
            take the two sides apart again *)
         SUBGOAL_THEN (mk_eq (usub, gsub))
           (fun e -> REWRITE_TAC[e]) THEN
         ASM_ARITH_TAC))) THEN
    (* the maps: the key of the array with the address it was
       written at, and the timestamps as they were *)
    REWRITE_TAC[bc_stack_ref_inv_def] THEN
    (* the key is fresh in the map of the addresses *)
    W(fun (asl,w as gl) ->
      let su = the_asm (fun c -> hd_is "SUBSET" c &&
                 hd_is "domain" (rand c)) gl in
      let nd = the_asm (fun c -> is_neg c && hd_is "IN" (rand c) &&
                 hd_is "domain" (rand (rand c))) gl in
      let fm = rand (lhand (concl su)) in
      let ptr = el 0 (snd (strip_comb (rand (concl nd)))) in
      SUBGOAL_THEN (mk_neg (list_mk_icomb "IN"
                      [ptr; list_mk_icomb "FDOM" [fm]]))
        ASSUME_TAC THENL
       [MP_TAC su THEN MP_TAC nd THEN REWRITE_TAC[SUBSET] THEN
        MESON_TAC[];
        ALL_TAC]) THEN
    W(fun (asl,w as gl) ->
      let su = the_asm (fun c -> hd_is "SUBSET" c &&
                 hd_is "domain" (rand c)) gl in
      let f = rand (lhand (concl su)) in
      let tfsu = the_asm (fun c -> hd_is "SUBSET" c &&
                   hd_is "all_ts" (rand c)) gl in
      let tf = rand (lhand (concl tfsu)) in
      let hl = the_asm (fun c -> is_eq c &&
                 hd_is "heap_lookup" (lhand c) &&
                 hd_is "SOME" (rand c) &&
                 hd_is "RefBlock" (rand (rand c))) gl in
      let aa = el 0 (snd (strip_comb (lhand (concl hl)))) in
      let ins = find_term (hd_is "sptree_insert") w in
      let ptr = el 0 (snd (strip_comb ins)) in
      EXISTS_TAC (list_mk_icomb "|+" [f; mk_pair (ptr, aa)]) THEN
      EXISTS_TAC tf) THEN
    REPEAT CONJ_TAC THEN
    TRY (SOLVED (FIRST_ASSUM ACCEPT_TAC)) THEN
    (* the map of the addresses with the key at the address, which
       held no data *)
    W(fun (asl,w as gl) ->
      if not (hd_is "INJ" w) ||
         not (can (find_term (hd_is "|+")) w) then ALL_TAC else
      (let iso = the_asm (fun c ->
                   let vs,bd = strip_forall c in
                   length vs = 1 && is_eq bd &&
                   hd_is "isSomeDataElement" (lhand bd)) gl in
       let inj = the_asm (fun c -> hd_is "INJ" c &&
                   hd_is "fmap_apply" (el 0 (snd (strip_comb c))) &&
                   rand (el 0 (snd (strip_comb c))) =
                     lhand (rand (el 0 (snd (strip_comb w))))) gl in
       let nd = the_asm (fun c -> is_neg c &&
                  hd_is "isSomeDataElement" (rand c)) gl in
       MATCH_MP_TAC INJ_FUPDATE_fresh THEN
       EXISTS_TAC (rand (concl inj)) THEN
       REPEAT CONJ_TAC THEN
       TRY (SOLVED (FIRST_ASSUM ACCEPT_TAC)) THEN
       TRY (SOLVED (MP_TAC nd THEN REWRITE_TAC[IN_ELIM_THM])) THEN
       REWRITE_TAC[IN_ELIM_THM] THEN
       MATCH_ACCEPT_TAC iso)) THEN
    (* and the map of the timestamps goes into the bigger set of
       addresses *)
    W(fun (asl,w as gl) ->
      if not (hd_is "INJ" w) then ALL_TAC else
      (let iso = the_asm (fun c ->
                   let vs,bd = strip_forall c in
                   length vs = 1 && is_eq bd &&
                   hd_is "isSomeDataElement" (lhand bd)) gl in
       let inj = the_asm (fun c -> hd_is "INJ" c &&
                   el 0 (snd (strip_comb c)) =
                     el 0 (snd (strip_comb w))) gl in
       MATCH_MP_TAC INJ_bigger THEN
       EXISTS_TAC (rand (concl inj)) THEN
       CONJ_TAC THENL
        [ACCEPT_TAC inj;
         REWRITE_TAC[IN_ELIM_THM] THEN
         REWRITE_TAC[iso] THEN MESON_TAC[]])) THEN
    (* the domain of the references has the key of the array *)
    TRY (SOLVED
          (REWRITE_TAC[FDOM_FUPDATE; domain_insert] THEN
           W(fun gl ->
             let su = the_asm (fun c -> hd_is "SUBSET" c &&
                        hd_is "domain" (rand c)) gl in
             MP_TAC su) THEN
           SET_TAC[])) THEN
    (* the timestamps of the new references and stack are more than
       the ones of the old (all_ts_insert_SUBSET) *)
    TRY (SOLVED
          (MATCH_MP_TAC SUBSET_TRANS THEN
           W(fun gl ->
             let su = the_asm (fun c -> hd_is "SUBSET" c &&
                        hd_is "all_ts" (rand c)) gl in
             let nd = the_asm (fun c -> is_neg c &&
                        hd_is "IN" (rand c) &&
                        hd_is "domain" (rand (rand c))) gl in
             EXISTS_TAC (rand (concl su)) THEN
             CONJ_TAC THENL
              [ACCEPT_TAC su;
               MATCH_MP_TAC all_ts_insert_SUBSET THEN
               CONJ_TAC THENL
                [ACCEPT_TAC nd;
                 REWRITE_TAC[MEM_APPEND; MEM] THEN
                 MESON_TAC[]]]))) THEN
    (* and the blocks of the stack stay unique *)
    TRY (SOLVED
          (W(fun gl ->
             let bu = the_asm (hd_is "blocks_unique") gl in
             MATCH_ACCEPT_TAC (MATCH_MP blocks_unique_new_ref
               bu)))) THEN
    (* the transfer that the allocation leaves: what the invariant
       said of a value it says of it with the array written
       (v_inv_new_ref_step) *)
    W(fun (asl,w as gl) ->
      let nd = the_asm (fun c -> is_neg c && hd_is "IN" (rand c) &&
                 hd_is "domain" (rand (rand c))) gl in
      let su = the_asm (fun c -> hd_is "SUBSET" c &&
                 hd_is "domain" (rand c)) gl in
      let hsr = the_asm (hd_is "heap_store_rel") gl in
      let old = the_asm (hd_is "ALL2") gl in
      let pred = el 0 (snd (strip_comb (concl old))) in
      let v,b1 = dest_abs pred in
      let x,vtm = dest_abs b1 in
      let f2 = find_term (hd_is "|+") w in
      let refs2 = find_term (hd_is "sptree_insert") w in
      ASSUME_TAC (GENL [v; x] (DISCH vtm
        (MATCH_MP v_inv_new_ref_step
          (CONJ (ASSUME vtm) (CONJ nd (CONJ su (CONJ hsr
            (CONJ (REFL f2) (REFL refs2)))))))))) THEN
    (* the values of the stack with the pointer of the array in
       the middle of it *)
    W(fun (asl,w) ->
      if not (hd_is "ALL2" w) then ALL_TAC else
      (MATCH_MP_TAC EVERY2_APPEND_CONS_IMP THEN
       REPEAT CONJ_TAC THEN
       (* the values of the array and the rest of the stack, with
          the transfer *)
       TRY (SOLVED (W(fun (asl,w as gl) ->
         let vs = el 1 (snd (strip_comb w)) in
         let old = the_asm (fun c -> hd_is "ALL2" c &&
                     el 1 (snd (strip_comb c)) = vs) gl in
         MATCH_ACCEPT_TAC (MATCH_MP EVERY2_v_inv_alloc_stack
           (CONJ (a_vtr gl) old))))) THEN
       (* and the pointer of the array itself *)
       CONV_TAC(TOP_DEPTH_CONV BETA_CONV) THEN
       (* of a pointer that is no thunk only the first disjunct of
          the relation is left *)
       REWRITE_TAC[v_inv_def] THEN TRY DISJ1_TAC THEN
       REWRITE_TAC[FDOM_FUPDATE; IN_INSERT; lookup_insert;
                   FAPPLY_FUPDATE_THM; ref_ptr_annot_def] THEN
       REPEAT CONJ_TAC THEN
       TRY MATCH_REDUCE_TAC THEN
       (let ds = [distinctness "option";
                  distinctness "bvlSem_ref"] in
        REWRITE_TAC (injectivity "option" ::
                     injectivity "heap_address" ::
                     ds @ map GSYM ds)) THEN
       REWRITE_TAC[])) THEN
    (* and the invariant of every reference that the new stack
       reaches: the array itself, or one that the old stack
       reached *)
    REPEAT STRIP_TAC THEN
    W(fun (asl,w) ->
      let ins = find_term (hd_is "sptree_insert") w in
      let ptr = el 0 (snd (strip_comb ins)) in
      let n = el 1 (snd (strip_comb w)) in
      ASM_CASES_TAC (mk_eq (n, ptr))) THENL
     [(* the array itself: its key has the address the store wrote
          at, and its element is the one it wrote, with the values
          that the stack gave it *)
      FIRST_X_ASSUM SUBST_ALL_TAC THEN
      W(fun (asl,w as gl) ->
        let hl = the_asm (fun c -> is_eq c &&
                   hd_is "heap_lookup" (lhand c) &&
                   hd_is "SOME" (rand c) &&
                   hd_is "RefBlock" (rand (rand c))) gl in
        let aa = el 0 (snd (strip_comb (lhand (concl hl)))) in
        let fm = el 0 (tparts (el 3 (snd (strip_comb w)))) in
        let ptr = el 1 (snd (strip_comb w)) in
        let ins = el 2 (snd (strip_comb w)) in
        SUBGOAL_THEN (mk_eq (list_mk_icomb "FLOOKUP" [fm; ptr],
                             list_mk_icomb "SOME" [aa]))
          ASSUME_TAC THENL
         [REWRITE_TAC[FLOOKUP_UPDATE]; ALL_TAC] THEN
        SUBGOAL_THEN
          (mk_eq (list_mk_icomb "sptree_lookup" [ptr; ins],
                  list_mk_icomb "SOME"
                    [el 1 (snd (strip_comb ins))])) ASSUME_TAC THENL
         [REWRITE_TAC[lookup_insert]; ALL_TAC]) THEN
      W(fun gl ->
        let lk1 = the_asm (fun c -> is_eq c &&
                    hd_is "FLOOKUP" (lhand c)) gl in
        let lk2 = the_asm (fun c -> is_eq c &&
                    hd_is "sptree_lookup" (lhand c) &&
                    hd_is "sptree_insert" (rand (lhand c))) gl in
        REWRITE_TAC[MATCH_MP arm_VA (CONJ lk1 lk2)]) THEN
      W(fun (asl,w as gl) ->
        let hl = the_asm (fun c -> is_eq c &&
                   hd_is "heap_lookup" (lhand c) &&
                   hd_is "SOME" (rand c) &&
                   hd_is "RefBlock" (rand (rand c))) gl in
        let ys1 = el 0 (snd (strip_comb (rand (rand (concl hl))))) in
        let old = the_asm (fun c -> hd_is "ALL2" c &&
                    el 2 (snd (strip_comb c)) = ys1) gl in
        let sw = CONV_RULE(TOP_DEPTH_CONV BETA_CONV)
                   (MATCH_MP EVERY2_SWAP old) in
        EXISTS_TAC ys1 THEN
        CONJ_TAC THENL
         [ACCEPT_TAC hl;
          MATCH_ACCEPT_TAC (MATCH_MP EVERY2_v_inv_alloc
            (CONJ (a_vtr gl) sw))]);
      (* and a reference that the old stack reached: it is in the
         domain of the map that the key was not in *)
      W(fun (asl,w as gl) ->
        let rr = the_asm (hd_is "reachable_refs") gl in
        let nd = the_asm (fun c -> is_neg c && hd_is "IN" (rand c) &&
                   hd_is "domain" (rand (rand c))) gl in
        let neq = the_asm (fun c -> is_neg c && is_eq (rand c)) gl in
        ASSUME_TAC (MATCH_MP reachable_refs_new_ref
          (CONJ rr (CONJ neq nd)))) THEN
      W(fun (asl,w as gl) ->
        let n = el 1 (snd (strip_comb w)) in
        let innu = the_asm (fun c -> hd_is "IN" c &&
                     hd_is "FDOM" (rand c) &&
                     el 0 (snd (strip_comb c)) = n) gl in
        let fm = lhand (rand (rand (concl innu))) in
        SUBGOAL_THEN (list_mk_icomb "IN"
                        [n; list_mk_icomb "FDOM" [fm]])
          ASSUME_TAC THENL
         [MP_TAC innu THEN
          REWRITE_TAC[FDOM_FUPDATE; IN_INSERT] THEN
          ASM_REWRITE_TAC[];
          ALL_TAC]) THEN
      W(fun (asl,w as gl) ->
        let n = el 1 (snd (strip_comb w)) in
        let bri = the_asm (fun c ->
          let vs,bd = strip_forall c in
          length vs = 1 && is_imp bd &&
          hd_is "bc_ref_inv" (rand bd)) gl in
        let rr = the_asm (fun c -> hd_is "reachable_refs" c &&
          not (can (find_term (hd_is "sptree_insert")) c)) gl in
        let inn = the_asm (fun c -> hd_is "IN" c &&
          hd_is "FDOM" (rand c) &&
          el 0 (snd (strip_comb c)) = n &&
          not (can (find_term (hd_is "|+")) c)) gl in
        let inv = MP (SPEC n bri) (CONJ rr inn) in
        let hsr = the_asm (hd_is "heap_store_rel") gl in
        let stp = REWRITE_RULE[IMP_CONJ] bc_ref_inv_step in
        let th = MATCH_MP (MATCH_MP (MATCH_MP (MATCH_MP stp
                   (a_vtr gl)) inn) hsr) inv in
        MATCH_MP_TAC (REWRITE_RULE[IMP_IMP] th)) THEN
      REPEAT CONJ_TAC THEN
      (* the lookup of the references away from the key *)
      TRY (SOLVED (ASM_REWRITE_TAC[lookup_insert])) THEN
      (* the lookup of the map away from the key *)
      TRY (SOLVED (ASM_REWRITE_TAC[FLOOKUP_UPDATE])) THEN
      (* the timestamps did not change *)
      TRY (SOLVED (MESON_TAC[])) THEN
      (* and a thunk of the old references is one of the new *)
      W(fun gl ->
        let nd = the_asm (fun c -> is_neg c && hd_is "IN" (rand c) &&
                   hd_is "domain" (rand (rand c))) gl in
        GEN_TAC THEN DISCH_THEN (fun dt ->
          MATCH_ACCEPT_TAC (MATCH_MP dest_thunk_insert_fresh
            (CONJ nd dt))))])
### new_thunk_thm
  (* the steps are above the statement (tools/overrides.py).  The
     root of the value of the thunk is the first of the roots of
     the stack (EVERY2_CONS_IMP), the element is two words long and
     IMP_heap_store_unused writes it at the top of the unused
     space; the heap, the roots and the space are then as good as
     they were (gc_kind_store_unused of the kind of the collection,
     where the thunk is a reference), the map of the addresses
     gains the key of the thunk with the address it was written at,
     and of every reference that the stack reaches the invariant
     holds as it did (bc_ref_inv_step) -- while the thunk itself is
     the element that the store wrote, with the value that the
     stack gave it *)
  (let DT_TAC =
     (* the value of the thunk is no thunk of the new references
        either: it is none of the old ones, and the key is fresh *)
     DISCH_TAC THEN
     MATCH_MP_TAC dest_thunk_insert_fresh THEN
     CONJ_TAC THENL
      [FIRST_ASSUM ACCEPT_TAC;
       W(fun gl ->
         let impl = the_asm (fun c -> is_imp c && is_eq (lhand c) &&
                      (try hd_is "Evaluated" (rand (lhand c))
                       with Failure _ -> false)) gl in
         let ee = the_asm (fun c -> is_eq c &&
                    hd_is "Evaluated" (rand c)) gl in
         ACCEPT_TAC (MP impl ee))] in
   STRIP_TAC THEN SPLIT_ASM_TAC THEN
    (* what the invariant says of the stack that the thunk is
       built from *)
    FIRST_X_ASSUM (fun inv ->
      if not (hd_is "abs_ml_inv" (concl inv)) then fail() else
      STRIP_ASSUME_TAC (REWRITE_RULE[abs_ml_inv_def;
                                     bc_stack_ref_inv_def] inv)) THEN
    (* the root of the value of the thunk, and the rest *)
    W(fun gl ->
      let e2 = the_asm (hd_is "ALL2") gl in
      STRIP_ASSUME_TAC (MATCH_MP EVERY2_CONS_IMP e2)) THEN
    (* the element is two words long, so it fits in the unused
       space, and the store writes it at the top of it *)
    W(fun (asl,w as gl) ->
      let us = the_asm (hd_is "unused_space_inv") gl in
      let spsp = el 1 (snd (strip_comb (concl us))) in
      let rts = the_asm (fun c -> is_eq c && is_var (lhand c) &&
                  hd_is "CONS" (rand c)) gl in
      let tb = rator (find_term (hd_is "ThunkBlock") w) in
      let el1 = mk_comb (tb, lhand (rand (concl rts))) in
      SUBGOAL_THEN (list_mk_icomb "<="
                      [list_mk_icomb "el_length" [el1]; spsp])
        (fun bd -> STRIP_ASSUME_TAC (MATCH_MP
           IMP_heap_store_unused (CONJ us bd))) THENL
       [REWRITE_TAC[el_length_ThunkBlock] THEN ASM_ARITH_TAC;
        ALL_TAC]) THEN
    (* the element is a data element, which is what the two facts
       about the store ask for *)
    W(fun gl ->
      let st = the_asm (fun c -> is_eq c &&
                 hd_is "heap_store_unused" (lhand c)) gl in
      let el1 = el 2 (snd (strip_comb (lhand (concl st)))) in
      let isd = is_data_el el1 in
      MAP_EVERY (fun th -> ASSUME_TAC (MP th isd))
        (mapfilter (fun (_,th) ->
           let c = concl th in
           if is_imp c && hd_is "isDataElement" (lhand c) then th
           else fail()) (fst gl))) THEN
    (* the witnesses: the root of the value, the rest of the roots
       and the heap that the store wrote *)
    W(fun (asl,w as gl) ->
      let st = the_asm (fun c -> is_eq c &&
                 hd_is "heap_store_unused" (lhand c)) gl in
      let heap2 = lhand (rand (concl st)) in
      let rts = the_asm (fun c -> is_eq c && is_var (lhand c) &&
                  hd_is "CONS" (rand c)) gl in
      EXISTS_TAC (genvar (type_of (fst (dest_exists w)))) THEN
      MAP_EVERY EXISTS_TAC
        [lhand (rand (concl rts)); rand (rand (concl rts)); heap2]) THEN
    REPEAT CONJ_TAC THEN
    TRY (SOLVED (FIRST_ASSUM ACCEPT_TAC)) THEN
    (* and the invariant of the new heap, stack and references *)
    REWRITE_TAC[abs_ml_inv_def] THEN
    (* the length of the element in the terms that the statement
       uses *)
    RULE_ASSUM_TRY (REWRITE_RULE[el_length_ThunkBlock]) THEN
    (* the addresses that hold data are the ones that did, and the
       one the store wrote *)
    W(fun gl ->
      let seq = the_asm (fun c -> is_eq c &&
                  hd_is "INSERT" (rand c)) gl in
      let ro = the_asm (hd_is "roots_ok") gl in
      ASSUME_TAC (REWRITE_RULE[EXTENSION; IN_INSERT; IN_ELIM_THM]
                    seq) THEN
      ASSUME_TAC (REWRITE_RULE[roots_ok_def] ro)) THEN
    REPEAT CONJ_TAC THEN
    (* the roots: the one of the thunk is the address it was
       written at, and the others are the ones they were *)
    TRY (SOLVED
          (REWRITE_TAC[roots_ok_def; MEM] THEN
           REPEAT STRIP_TAC THEN
           W(fun gl ->
             let iso = the_asm (fun c ->
                         let vs,bd = strip_forall c in
                         length vs = 1 && is_eq bd &&
                         hd_is "isSomeDataElement" (lhand bd)) gl in
             REWRITE_TAC[iso]) THEN
           TRY (SOLVED
                 (DISJ1_TAC THEN
                  FIRST_X_ASSUM (fun e ->
                    if not (is_eq (concl e)) ||
                       not (hd_is "gc_shared_Pointer"
                              (rand (concl e)))
                    then fail() else
                    MP_TAC e) THEN
                  REWRITE_TAC[injectivity "heap_address"] THEN
                  MESON_TAC[])) THEN
           DISJ2_TAC THEN
           W(fun gl ->
             let ro = the_asm (fun c ->
                        let vs,bd = strip_forall c in
                        length vs = 2 && is_imp bd &&
                        hd_is "MEM" (lhand bd)) gl in
             let rts = the_asm (fun c -> is_eq c &&
                         is_var (lhand c) &&
                         hd_is "CONS" (rand c)) gl in
             (* the root is the value of the thunk, which the old
                roots had in front, or one of the others *)
             let pt = tryfind (fun (_,th) ->
                        let c = concl th in
                        if hd_is "MEM" c &&
                           hd_is "gc_shared_Pointer"
                             (el 0 (snd (strip_comb c)))
                        then el 0 (snd (strip_comb c))
                        else if is_eq c &&
                           hd_is "gc_shared_Pointer" (lhand c)
                        then lhand c
                        else fail()) (fst gl) in
             SUBGOAL_THEN (list_mk_icomb "MEM"
                 [pt; lhand (concl rts)])
               (fun mr -> ACCEPT_TAC (MATCH_MP ro mr)) THEN
             ASM_REWRITE_TAC[MEM]))) THEN
    (* the heap is good: it is as long as it was, it has no forward
       pointer, and the pointer of the thunk is a root of the
       stack *)
    TRY (SOLVED
          (REWRITE_TAC[heap_ok_def] THEN
           REPEAT CONJ_TAC THEN
           TRY (SOLVED
                 (W(fun gl ->
                    let ho = REWRITE_RULE[heap_ok_def]
                               (the_asm (hd_is "heap_ok") gl) in
                    let hl = the_asm (fun c -> is_eq c &&
                               hd_is "heap_length" (lhand c)) gl in
                    MP_TAC ho THEN REWRITE_TAC[hl] THEN
                    STRIP_TAC THEN ASM_REWRITE_TAC[]))) THEN
           TRY (SOLVED
                 (W(fun gl ->
                    let ho = REWRITE_RULE[heap_ok_def]
                               (the_asm (hd_is "heap_ok") gl) in
                    let impl = the_asm (fun c -> is_imp c &&
                                 is_neg (lhand c) &&
                                 hd_is "isForwardPointer"
                                   (rand (lhand c))) gl in
                    let st = the_asm (fun c -> is_eq c &&
                               hd_is "heap_store_unused"
                                 (lhand c)) gl in
                    let el1 = el 2 (snd (strip_comb
                                (lhand (concl st)))) in
                    SUBGOAL_THEN (mk_neg (list_mk_icomb
                                    "isForwardPointer" [el1]))
                      (fun nf -> MP_TAC ho THEN
                         REWRITE_TAC[MP impl nf] THEN
                         STRIP_TAC THEN ASM_REWRITE_TAC[]) THEN
                    REWRITE_TAC[ThunkBlock_def;
                                isForwardPointer_def] THEN
                    MATCH_REDUCE_TAC THEN REWRITE_TAC[]))) THEN
           REPEAT GEN_TAC THEN
           W(fun gl ->
             let mem = the_asm (fun c ->
                         let vs,bd = strip_forall c in
                         length vs = 3 && is_eq bd &&
                         hd_is "MEM" (lhand bd)) gl in
             REWRITE_TAC[mem]) THEN
           STRIP_TAC THEN
           W(fun gl ->
             let iso = the_asm (fun c ->
                         let vs,bd = strip_forall c in
                         length vs = 1 && is_eq bd &&
                         hd_is "isSomeDataElement" (lhand bd)) gl in
             REWRITE_TAC[iso]) THEN
           DISJ2_TAC THEN
           TRY (SOLVED
                 (W(fun gl ->
                    let eq = the_asm (fun c -> is_eq c &&
                               hd_is "ThunkBlock" (lhand c)) gl in
                    MP_TAC eq) THEN
                  REWRITE_TAC[ThunkBlock_def;
                              injectivity "heap_element"] THEN
                  STRIP_TAC THEN
                  W(fun gl ->
                    let ro = the_asm (fun c ->
                               let vs,bd = strip_forall c in
                               length vs = 2 && is_imp bd &&
                               hd_is "MEM" (lhand bd)) gl in
                    let m = the_asm (fun c -> hd_is "MEM" c &&
                              hd_is "gc_shared_Pointer"
                                (el 0 (snd (strip_comb c)))) gl in
                    let rts = the_asm (fun c -> is_eq c &&
                                is_var (lhand c) &&
                                hd_is "CONS" (rand c)) gl in
                    let eq = the_asm (fun c -> is_eq c &&
                               hd_is "CONS" (lhand c)) gl in
                    SUBGOAL_THEN (list_mk_icomb "MEM"
                        [el 0 (snd (strip_comb (concl m)));
                         lhand (concl rts)])
                      (fun mr -> ACCEPT_TAC (MATCH_MP ro mr)) THEN
                    MESON_TAC[m; rts; eq; MEM]))) THEN
           W(fun gl ->
             let ho = REWRITE_RULE[heap_ok_def]
                        (the_asm (hd_is "heap_ok") gl) in
             let m1 = the_asm (fun c -> hd_is "MEM" c &&
                        hd_is "DataElement"
                          (el 0 (snd (strip_comb c)))) gl in
             let m2 = the_asm (fun c -> hd_is "MEM" c &&
                        hd_is "gc_shared_Pointer"
                          (el 0 (snd (strip_comb c)))) gl in
             MESON_TAC[ho; m1; m2]))) THEN
    (* the kind of the collection: the store at the top of the
       unused space keeps it, and the thunk is a reference *)
    W(fun (asl,w as gl) ->
      if not (hd_is "gc_kind_inv" w) then ALL_TAC else
      (let gk = the_asm (hd_is "gc_kind_inv") gl in
       let st = the_asm (fun c -> is_eq c &&
                  hd_is "heap_store_unused" (lhand c)) gl in
       let el1 = el 2 (snd (strip_comb (lhand (concl st)))) in
       let sp = el 2 (snd (strip_comb (concl gk))) in
       (* the length of the element, at the type of the heap that
          the store wrote (entry 61) *)
       let elt = PART_MATCH lhs el_length_ThunkBlock
                   (list_mk_icomb "el_length" [el1]) in
       let us2 = REWRITE_RULE[GSYM elt]
                   (the_asm (fun c -> hd_is "unused_space_inv" c &&
                      can (find_term (hd_is "-")) c) gl) in
       let ir = PART_MATCH I isRef_ThunkBlock
                  (list_mk_icomb
                     "data_to_word_memoryProof_isRef" [el1]) in
       SUBGOAL_THEN (list_mk_icomb "<="
                       [list_mk_icomb "el_length" [el1]; sp])
         (fun bd -> MATCH_ACCEPT_TAC (REWRITE_RULE[elt] (MATCH_MP
            gc_kind_store_unused
            (CONJ ir (CONJ bd (CONJ gk (CONJ st us2))))))) THEN
       REWRITE_TAC[elt] THEN ASM_ARITH_TAC)) THEN
    (* the unused space: what the store lemma says, with the length
       of the thunk taken off *)
    W(fun (asl,w as gl) ->
      if not (hd_is "unused_space_inv" w) then ALL_TAC else
      (let us = the_asm (fun c -> hd_is "unused_space_inv" c &&
                  can (find_term (hd_is "-")) c) gl in
       MP_TAC us THEN
       W(fun (asl,w) ->
         let usub = el 1 (snd (strip_comb (lhand w))) in
         let gsub = el 1 (snd (strip_comb (rand w))) in
         SUBGOAL_THEN (mk_eq (usub, gsub))
           (fun e -> REWRITE_TAC[e]) THEN
         ASM_ARITH_TAC))) THEN
    (* the maps: the key of the thunk with the address it was
       written at, and the timestamps as they were *)
    REWRITE_TAC[bc_stack_ref_inv_def] THEN
    (* the key is fresh in the map of the addresses *)
    W(fun (asl,w as gl) ->
      let su = the_asm (fun c -> hd_is "SUBSET" c &&
                 hd_is "domain" (rand c)) gl in
      let nd = the_asm (fun c -> is_neg c && hd_is "IN" (rand c) &&
                 hd_is "domain" (rand (rand c))) gl in
      let fm = rand (lhand (concl su)) in
      let ptr = el 0 (snd (strip_comb (rand (concl nd)))) in
      SUBGOAL_THEN (mk_neg (list_mk_icomb "IN"
                      [ptr; list_mk_icomb "FDOM" [fm]]))
        ASSUME_TAC THENL
       [MP_TAC su THEN MP_TAC nd THEN REWRITE_TAC[SUBSET] THEN
        MESON_TAC[];
        ALL_TAC]) THEN
    W(fun (asl,w as gl) ->
      let su = the_asm (fun c -> hd_is "SUBSET" c &&
                 hd_is "domain" (rand c)) gl in
      let f = rand (lhand (concl su)) in
      let tfsu = the_asm (fun c -> hd_is "SUBSET" c &&
                   hd_is "all_ts" (rand c)) gl in
      let tf = rand (lhand (concl tfsu)) in
      let hl = the_asm (fun c -> is_eq c &&
                 hd_is "heap_lookup" (lhand c) &&
                 hd_is "SOME" (rand c) &&
                 hd_is "ThunkBlock" (rand (rand c))) gl in
      let aa = el 0 (snd (strip_comb (lhand (concl hl)))) in
      let ins = find_term (hd_is "sptree_insert") w in
      let ptr = el 0 (snd (strip_comb ins)) in
      EXISTS_TAC (list_mk_icomb "|+" [f; mk_pair (ptr, aa)]) THEN
      EXISTS_TAC tf) THEN
    REPEAT CONJ_TAC THEN
    TRY (SOLVED (FIRST_ASSUM ACCEPT_TAC)) THEN
    (* the map of the addresses with the key at the address, which
       held no data *)
    W(fun (asl,w as gl) ->
      if not (hd_is "INJ" w) ||
         not (can (find_term (hd_is "|+")) w) then ALL_TAC else
      (let iso = the_asm (fun c ->
                   let vs,bd = strip_forall c in
                   length vs = 1 && is_eq bd &&
                   hd_is "isSomeDataElement" (lhand bd)) gl in
       let inj = the_asm (fun c -> hd_is "INJ" c &&
                   hd_is "fmap_apply" (el 0 (snd (strip_comb c))) &&
                   rand (el 0 (snd (strip_comb c))) =
                     lhand (rand (el 0 (snd (strip_comb w))))) gl in
       let nd = the_asm (fun c -> is_neg c &&
                  hd_is "isSomeDataElement" (rand c)) gl in
       MATCH_MP_TAC INJ_FUPDATE_fresh THEN
       EXISTS_TAC (rand (concl inj)) THEN
       REPEAT CONJ_TAC THEN
       TRY (SOLVED (FIRST_ASSUM ACCEPT_TAC)) THEN
       TRY (SOLVED (MP_TAC nd THEN REWRITE_TAC[IN_ELIM_THM])) THEN
       REWRITE_TAC[IN_ELIM_THM] THEN
       MATCH_ACCEPT_TAC iso)) THEN
    (* and the map of the timestamps goes into the bigger set of
       addresses *)
    W(fun (asl,w as gl) ->
      if not (hd_is "INJ" w) then ALL_TAC else
      (let iso = the_asm (fun c ->
                   let vs,bd = strip_forall c in
                   length vs = 1 && is_eq bd &&
                   hd_is "isSomeDataElement" (lhand bd)) gl in
       let inj = the_asm (fun c -> hd_is "INJ" c &&
                   el 0 (snd (strip_comb c)) =
                     el 0 (snd (strip_comb w))) gl in
       MATCH_MP_TAC INJ_bigger THEN
       EXISTS_TAC (rand (concl inj)) THEN
       CONJ_TAC THENL
        [ACCEPT_TAC inj;
         REWRITE_TAC[IN_ELIM_THM] THEN
         REWRITE_TAC[iso] THEN MESON_TAC[]])) THEN
    (* the domain of the references has the key of the thunk *)
    TRY (SOLVED
          (REWRITE_TAC[FDOM_FUPDATE; domain_insert] THEN
           W(fun gl ->
             let su = the_asm (fun c -> hd_is "SUBSET" c &&
                        hd_is "domain" (rand c)) gl in
             MP_TAC su) THEN
           SET_TAC[])) THEN
    (* the timestamps of the new references and stack are more than
       the ones of the old (all_ts_insert_SUBSET) *)
    TRY (SOLVED
          (MATCH_MP_TAC SUBSET_TRANS THEN
           W(fun gl ->
             let su = the_asm (fun c -> hd_is "SUBSET" c &&
                        hd_is "all_ts" (rand c)) gl in
             let nd = the_asm (fun c -> is_neg c &&
                        hd_is "IN" (rand c) &&
                        hd_is "domain" (rand (rand c))) gl in
             EXISTS_TAC (rand (concl su)) THEN
             CONJ_TAC THENL
              [ACCEPT_TAC su;
               MATCH_MP_TAC all_ts_insert_SUBSET THEN
               CONJ_TAC THENL
                [ACCEPT_TAC nd;
                 REWRITE_TAC[MEM] THEN MESON_TAC[]]]))) THEN
    (* and the blocks of the stack stay unique *)
    TRY (SOLVED
          (W(fun gl ->
             let bu = the_asm (hd_is "blocks_unique") gl in
             MATCH_ACCEPT_TAC (MATCH_MP blocks_unique_new_thunk
               bu)))) THEN
    (* the transfer that the allocation leaves: what the invariant
       said of a value it says of it with the thunk written
       (v_inv_new_thunk_step) *)
    W(fun (asl,w as gl) ->
      let nd = the_asm (fun c -> is_neg c && hd_is "IN" (rand c) &&
                 hd_is "domain" (rand (rand c))) gl in
      let su = the_asm (fun c -> hd_is "SUBSET" c &&
                 hd_is "domain" (rand c)) gl in
      let hsr = the_asm (hd_is "heap_store_rel") gl in
      let dt = the_asm (fun c -> is_imp c && is_eq (lhand c) &&
                 (try hd_is "Evaluated" (rand (lhand c))
                  with Failure _ -> false)) gl in
      let old = the_asm (hd_is "ALL2") gl in
      let pred = el 0 (snd (strip_comb (concl old))) in
      let v0,b1 = dest_abs pred in
      let x0,bod = dest_abs b1 in
      (* the value that the thunk holds is named v as well, and it
         is free in the assumption about it, so the two variables
         of the transfer are fresh ones *)
      let v1 = genvar (type_of v0) and x1 = genvar (type_of x0) in
      let vtm = vsubst [v1,v0; x1,x0] bod in
      let f2 = find_term (hd_is "|+") w in
      let refs2 = find_term (hd_is "sptree_insert") w in
      ASSUME_TAC (GENL [v1; x1] (DISCH vtm
        (MATCH_MP v_inv_new_thunk_step
          (CONJ (ASSUME vtm) (CONJ nd (CONJ su (CONJ hsr
            (CONJ dt (CONJ (REFL f2) (REFL refs2))))))))))) THEN
    (* the values of the stack with the pointer of the thunk in
       it *)
    W(fun (asl,w) ->
      if not (hd_is "ALL2" w) then ALL_TAC else
      (REWRITE_TAC[ALL2] THEN
       CONV_TAC(TOP_DEPTH_CONV BETA_CONV) THEN
       REPEAT CONJ_TAC THEN
       (* the value of the thunk and the rest of the stack, with
          the transfer *)
       TRY (SOLVED (W(fun gl ->
         let vi = the_asm (hd_is "v_inv") gl in
         MATCH_ACCEPT_TAC (MATCH_MP (a_vtr gl) vi)))) THEN
       TRY (SOLVED (W(fun (asl,w as gl) ->
         let vs = el 1 (snd (strip_comb w)) in
         let old = the_asm (fun c -> hd_is "ALL2" c &&
                     el 1 (snd (strip_comb c)) = vs) gl in
         MATCH_ACCEPT_TAC (MATCH_MP EVERY2_v_inv_alloc_stack
           (CONJ (a_vtr gl) old))))) THEN
       (* and the pointer of the thunk itself: of a pointer that
          is a thunk the second disjunct of the relation is the one
          that holds, and its witnesses are the mode of the thunk,
          its value and the root of the value *)
       W(fun (asl,w as gl) ->
         let hl = the_asm (fun c -> is_eq c &&
                    hd_is "heap_lookup" (lhand c) &&
                    hd_is "SOME" (rand c) &&
                    hd_is "ThunkBlock" (rand (rand c))) gl in
         let md = el 0 (snd (strip_comb (rand (rand (concl hl))))) in
         let vi = the_asm (fun c -> hd_is "v_inv" c &&
                    not (can (find_term (hd_is "|+")) c)) gl in
         let vargs = snd (strip_comb (concl vi)) in
         REWRITE_TAC[v_inv_def] THEN
         DISJ2_TAC THEN DISJ1_TAC THEN
         MAP_EVERY EXISTS_TAC
           [md; el 1 vargs; el 0 (tparts (el 3 vargs))]) THEN
       REWRITE_TAC[FDOM_FUPDATE; IN_INSERT; lookup_insert;
                   FAPPLY_FUPDATE_THM] THEN
       REPEAT CONJ_TAC THEN
       TRY MATCH_REDUCE_TAC THEN
       TRY (SOLVED (REWRITE_TAC[])) THEN
       TRY (SOLVED (FIRST_ASSUM ACCEPT_TAC)) THEN
       (* the value of the thunk is still no thunk *)
       TRY (SOLVED DT_TAC) THEN
       (* and what the invariant says of the value goes over with
          the transfer *)
       W(fun gl ->
         let vi = the_asm (fun c -> hd_is "v_inv" c &&
                    not (can (find_term (hd_is "|+")) c)) gl in
         MATCH_ACCEPT_TAC (MATCH_MP (a_vtr gl) vi)))) THEN
    (* and the invariant of every reference that the new stack
       reaches: the thunk itself, or one that the old stack
       reached *)
    REPEAT STRIP_TAC THEN
    W(fun (asl,w) ->
      let ins = find_term (hd_is "sptree_insert") w in
      let ptr = el 0 (snd (strip_comb ins)) in
      let n = el 1 (snd (strip_comb w)) in
      ASM_CASES_TAC (mk_eq (n, ptr))) THENL
     [(* the thunk itself: its key has the address the store wrote
          at, and its element is the one it wrote, with the value
          that the stack gave it *)
      FIRST_X_ASSUM SUBST_ALL_TAC THEN
      W(fun (asl,w as gl) ->
        let hl = the_asm (fun c -> is_eq c &&
                   hd_is "heap_lookup" (lhand c) &&
                   hd_is "SOME" (rand c) &&
                   hd_is "ThunkBlock" (rand (rand c))) gl in
        let aa = el 0 (snd (strip_comb (lhand (concl hl)))) in
        let fm = el 0 (tparts (el 3 (snd (strip_comb w)))) in
        let ptr = el 1 (snd (strip_comb w)) in
        let ins = el 2 (snd (strip_comb w)) in
        SUBGOAL_THEN (mk_eq (list_mk_icomb "FLOOKUP" [fm; ptr],
                             list_mk_icomb "SOME" [aa]))
          ASSUME_TAC THENL
         [REWRITE_TAC[FLOOKUP_UPDATE]; ALL_TAC] THEN
        SUBGOAL_THEN
          (mk_eq (list_mk_icomb "sptree_lookup" [ptr; ins],
                  list_mk_icomb "SOME"
                    [el 1 (snd (strip_comb ins))])) ASSUME_TAC THENL
         [REWRITE_TAC[lookup_insert]; ALL_TAC]) THEN
      W(fun gl ->
        let lk1 = the_asm (fun c -> is_eq c &&
                    hd_is "FLOOKUP" (lhand c)) gl in
        let lk2 = the_asm (fun c -> is_eq c &&
                    hd_is "sptree_lookup" (lhand c) &&
                    hd_is "sptree_insert" (rand (lhand c))) gl in
        REWRITE_TAC[MATCH_MP arm_TH (CONJ lk1 lk2)]) THEN
      W(fun (asl,w as gl) ->
        let hl = the_asm (fun c -> is_eq c &&
                   hd_is "heap_lookup" (lhand c) &&
                   hd_is "SOME" (rand c) &&
                   hd_is "ThunkBlock" (rand (rand c))) gl in
        EXISTS_TAC (rand (rand (rand (concl hl))))) THEN
      REPEAT CONJ_TAC THEN
      TRY (SOLVED (FIRST_ASSUM ACCEPT_TAC)) THEN
      (* the value of the thunk is still no thunk, and what the
         invariant says of it goes over with the transfer *)
      TRY (SOLVED DT_TAC) THEN
      W(fun gl ->
        let vi = the_asm (hd_is "v_inv") gl in
        MATCH_ACCEPT_TAC (MATCH_MP (a_vtr gl) vi));
      (* and a reference that the old stack reached: it is in the
         domain of the map that the key was not in *)
      W(fun (asl,w as gl) ->
        let rr = the_asm (hd_is "reachable_refs") gl in
        let nd = the_asm (fun c -> is_neg c && hd_is "IN" (rand c) &&
                   hd_is "domain" (rand (rand c))) gl in
        let neq = the_asm (fun c -> is_neg c && is_eq (rand c)) gl in
        ASSUME_TAC (MATCH_MP reachable_refs_new_thunk
          (CONJ rr (CONJ neq nd)))) THEN
      W(fun (asl,w as gl) ->
        let n = el 1 (snd (strip_comb w)) in
        let innu = the_asm (fun c -> hd_is "IN" c &&
                     hd_is "FDOM" (rand c) &&
                     el 0 (snd (strip_comb c)) = n) gl in
        let fm = lhand (rand (rand (concl innu))) in
        SUBGOAL_THEN (list_mk_icomb "IN"
                        [n; list_mk_icomb "FDOM" [fm]])
          ASSUME_TAC THENL
         [MP_TAC innu THEN
          REWRITE_TAC[FDOM_FUPDATE; IN_INSERT] THEN
          ASM_REWRITE_TAC[];
          ALL_TAC]) THEN
      W(fun (asl,w as gl) ->
        let n = el 1 (snd (strip_comb w)) in
        let bri = the_asm (fun c ->
          let vs,bd = strip_forall c in
          length vs = 1 && is_imp bd &&
          hd_is "bc_ref_inv" (rand bd)) gl in
        let rr = the_asm (fun c -> hd_is "reachable_refs" c &&
          not (can (find_term (hd_is "sptree_insert")) c)) gl in
        let inn = the_asm (fun c -> hd_is "IN" c &&
          hd_is "FDOM" (rand c) &&
          el 0 (snd (strip_comb c)) = n &&
          not (can (find_term (hd_is "|+")) c)) gl in
        let inv = MP (SPEC n bri) (CONJ rr inn) in
        let hsr = the_asm (hd_is "heap_store_rel") gl in
        let stp = REWRITE_RULE[IMP_CONJ] bc_ref_inv_step in
        let th = MATCH_MP (MATCH_MP (MATCH_MP (MATCH_MP stp
                   (a_vtr gl)) inn) hsr) inv in
        MATCH_MP_TAC (REWRITE_RULE[IMP_IMP] th)) THEN
      REPEAT CONJ_TAC THEN
      (* the lookup of the references away from the key *)
      TRY (SOLVED (ASM_REWRITE_TAC[lookup_insert])) THEN
      (* the lookup of the map away from the key *)
      TRY (SOLVED (ASM_REWRITE_TAC[FLOOKUP_UPDATE])) THEN
      (* the timestamps did not change *)
      TRY (SOLVED (MESON_TAC[])) THEN
      (* and a thunk of the old references is one of the new *)
      W(fun gl ->
        let nd = the_asm (fun c -> is_neg c && hd_is "IN" (rand c) &&
                   hd_is "domain" (rand (rand c))) gl in
        GEN_TAC THEN DISCH_THEN (fun dt ->
          MATCH_ACCEPT_TAC (MATCH_MP dest_thunk_insert_fresh
            (CONJ nd dt))))])
### deref_thm
  (* the steps are above the statement (tools/overrides.py).  The
     roots are a cons whose head is what the relation gives the
     pointer: of a pointer to a reference the address of its
     element, and of a pointer to a thunk the address of the thunk
     -- while a thunk that has been evaluated away is the value
     itself, and of that kind the claim is nothing.  The references
     reach the key, because the pointer is a root of the stack, so
     bc_ref_inv says what the heap holds at the address: of an
     array of values a RefBlock, of a thunk a ThunkBlock.  The
     value that the dereference reads is the element of that at the
     index (heap_el_data), it is a pointer of a good heap
     (roots_ok_data), the timestamps only grow (all_ts_mono), the
     blocks stay unique (blocks_unique_deref1 and the second of
     them) and a reference that the value reaches is one that the
     pointer reaches (reach_ref) *)
  (STRIP_TAC THEN
   (* what the invariant says of the stack with the pointer at its
      head *)
   FIRST_X_ASSUM (fun inv ->
     if not (hd_is "abs_ml_inv" (concl inv)) then fail() else
     STRIP_ASSUME_TAC (REWRITE_RULE[abs_ml_inv_def;
                                    bc_stack_ref_inv_def] inv)) THEN
   (* the roots are a cons, and its head is the pointer's *)
   W(fun gl ->
     let lr = the_asm (fun c -> hd_is "ALL2" c) gl in
     CASES_ON_TAC (el 2 (snd (strip_comb (concl lr))))) THEN
   RULE_ASSUM_TRY (REWRITE_RULE[ALL2_DEF; HD; TL; NOT_CONS_NIL]) THEN
   TRY (FIRST_ASSUM CONTR_TAC) THEN
   SPLIT_ASM_TAC THEN
   (* the witnesses: the head of the roots and its tail *)
   W(fun (asl,w) ->
     let cns = lhs (hd (conjuncts (snd (strip_exists w)))) in
     EXISTS_TAC (lhand cns) THEN EXISTS_TAC (rand cns)) THEN
   (* the relation of the pointer: a pointer to the reference, a
      pointer to a thunk, or the value of a thunk that has been
      evaluated away *)
   FIRST_ASSUM (fun vi ->
     if not (hd_is "v_inv" (concl vi)) then fail() else
     STRIP_ASSUME_TAC (REWRITE_RULE[v_inv_def] vi)) THEN
   REPEAT CONJ_TAC THEN
   TRY (SOLVED REFL_TAC) THEN
   (* the key of the pointer is one of the references: it is a key
      of the map of the addresses, or the references hold a thunk
      for it *)
   TRY (SOLVED
         (W(fun gl ->
            let inn = the_asm (fun c -> hd_is "IN" c &&
                        hd_is "FDOM" (rand c)) gl in
            let su = the_asm (fun c -> hd_is "SUBSET" c &&
                       hd_is "domain" (rand c)) gl in
            MP_TAC inn THEN MP_TAC su) THEN
          REWRITE_TAC[SUBSET] THEN MESON_TAC[])) THEN
   TRY (SOLVED
         (REWRITE_TAC[domain_lookup] THEN
          W(fun gl ->
            let lk = the_asm (fun c -> is_eq c &&
                       hd_is "sptree_lookup" (lhand c)) gl in
            MESON_TAC[lk]))) THEN
   (* and what the references hold at the key decides the claim *)
   W(fun (asl,w) ->
     NAMED_CASES_TAC (find_term (hd_is "sptree_lookup") w)
       [[]; ["rv"]]) THEN
   (* the references have a value for the key, so the lookup is no
      NONE *)
   TRY (SOLVED
         (W(fun gl ->
            let lk = the_asm (fun c -> is_eq c &&
                       hd_is "sptree_lookup" (lhand c) &&
                       not (hd_is "SOME" (rand c))) gl in
            let inn = the_asm (fun c -> hd_is "IN" c &&
                        hd_is "FDOM" (rand c)) gl in
            let su = the_asm (fun c -> hd_is "SUBSET" c &&
                       hd_is "domain" (rand c)) gl in
            MP_TAC (REWRITE_RULE[lookup_NONE_domain] lk) THEN
            MP_TAC inn THEN MP_TAC su THEN
            REWRITE_TAC[SUBSET] THEN MESON_TAC[]))) THEN
   TRY (SOLVED
         (W(fun gl ->
            let lk = the_asm (fun c -> is_eq c &&
                       hd_is "sptree_lookup" (lhand c) &&
                       not (hd_is "SOME" (rand c))) gl in
            let lk2 = the_asm (fun c -> is_eq c &&
                        hd_is "sptree_lookup" (lhand c) &&
                        hd_is "SOME" (rand c)) gl in
            MP_TAC lk THEN MP_TAC lk2 THEN
            REWRITE_TAC[distinctness "option"] THEN
            MESON_TAC[]))) THEN
   NAMED_CASES_TAC (cake_as_vars (fun () ->
     `rv:(dataSem_v)bvlSem_ref`))
     [["vl"]; ["flag"; "bs"]; ["md"; "vv"]; ["tg"; "fin"; "ll";
      "cc"; "rr"]] THEN
   (* of an array of bytes and of a mutable block there is nothing
      to say, and of a thunk only when it has not been evaluated *)
   RULE_ASSUM_TRY (CONV_RULE(TOP_DEPTH_CONV MATCH_CONV)) THEN
   (* the kind that the case gives and the one of the relation are
      the same, so their fields are the same as well *)
   RULE_ASSUM_TRY (REWRITE_RULE[injectivity "option";
                               injectivity "bvlSem_ref";
                               distinctness "option";
                               distinctness "bvlSem_ref"]) THEN
   TRY (FIRST_ASSUM CONTR_TAC) THEN
   SPLIT_ASM_TAC THEN
   REPEAT (FIRST_X_ASSUM (fun th ->
     let c = concl th in
     if is_eq c && is_var (lhand c) &&
        (is_var (rand c) ||
         (try fst (dest_type (type_of (lhand c))) = "thunk_mode"
          with Failure _ -> false))
     then SUBST_ALL_TAC th else fail())) THEN
   (* a pointer to a thunk is one that the source marks with F *)
   REPEAT (FIRST_X_ASSUM (fun th ->
     let c = concl th in
     if is_neg c && is_var (rand c)
     then SUBST_ALL_TAC (EQF_INTRO th) else fail())) THEN
   (* the value of the key, which THE of its lookup is *)
   REWRITE_TAC[THE] THEN
   MATCH_REDUCE_TAC THEN
   TRY (SOLVED (REWRITE_TAC[])) THEN
   (* and of a thunk whether it has been evaluated: of one that
      has there is nothing to say either *)
   W(fun (asl,w) ->
     let md = fun t -> is_var t &&
                (try fst (dest_type (type_of t)) = "thunk_mode"
                 with Failure _ -> false) in
     if not (can (find_term md) w) then ALL_TAC else
     CASES_ON_TAC (find_term md w)) THEN
   REWRITE_TAC[distinctness "thunk_mode"] THEN
   MATCH_REDUCE_TAC THEN
   TRY (SOLVED (REWRITE_TAC[])) THEN
   (* the kind that the case gives and the kind that the relation
      of the pointer gives are the same one *)
   TRY (SOLVED
         (W(fun gl ->
            let bad = the_asm (fun c ->
                        let vs,bd = strip_forall c in
                        length vs = 2 && is_neg bd &&
                        is_conj (rand bd)) gl in
            MP_TAC bad) THEN
          MESON_TAC[])) THEN
   (* the references reach the key, because the pointer of the
      stack is a root that has it *)
   W(fun (asl,w as gl) ->
     let bri = the_asm (fun c ->
                 let vs,bd = strip_forall c in
                 length vs = 1 && is_imp bd &&
                 hd_is "bc_ref_inv" (rand bd)) gl in
     let inn = the_asm (fun c -> hd_is "IN" c &&
                 hd_is "FDOM" (rand c)) gl in
     let n = el 0 (snd (strip_comb (concl inn))) in
     SUBGOAL_THEN (lhand (lhand (concl (SPEC n bri))))
       ASSUME_TAC THENL
      [REWRITE_TAC[reachable_refs_def] THEN
       W(fun (asl,w) ->
         let rp = find_term (hd_is "dataSem_RefPtr") w in
         EXISTS_TAC rp THEN EXISTS_TAC (rand rp)) THEN
       REWRITE_TAC[MEM; get_refs_def] THEN
       MATCH_ACCEPT_TAC (CONJUNCT1 (SPEC_ALL RTC_RULES));
       ALL_TAC]) THEN
   (* what the heap holds at the address of the key: of an array of
      values a RefBlock, of a thunk a ThunkBlock *)
   W(fun (asl,w as gl) ->
     let inn = the_asm (fun c -> hd_is "IN" c &&
                 hd_is "FDOM" (rand c)) gl in
     let n = el 0 (snd (strip_comb (concl inn))) in
     let fm = rand (rand (concl inn)) in
     let bri = the_asm (fun c ->
                 let vs,bd = strip_forall c in
                 length vs = 1 && is_imp bd &&
                 hd_is "bc_ref_inv" (rand bd)) gl in
     let rr = the_asm (hd_is "reachable_refs") gl in
     let flk = ASSUME (mk_eq (list_mk_icomb "FLOOKUP" [fm; n],
                 list_mk_icomb "SOME"
                   [list_mk_icomb "fmap_apply" [fm; n]])) in
     SUBGOAL_THEN (concl flk) ASSUME_TAC THENL
      [ASM_REWRITE_TAC[FLOOKUP_DEF]; ALL_TAC] THEN
     ASSUME_TAC (MP (SPEC n bri) (CONJ rr inn))) THEN
   W(fun gl ->
     let lk = the_asm (fun c -> is_eq c &&
                hd_is "sptree_lookup" (lhand c) &&
                hd_is "SOME" (rand c)) gl in
     let flk = the_asm (fun c -> is_eq c &&
                 hd_is "FLOOKUP" (lhand c)) gl in
     let inv = the_asm (hd_is "bc_ref_inv") gl in
     let arm = tryfind (fun a -> MATCH_MP a (CONJ flk lk))
                 [arm_VA; arm_TH] in
     STRIP_ASSUME_TAC (REWRITE_RULE[arm] inv)) THEN
   (* the index is below the length of the element, which is as
      long as the array of values *)
   W(fun gl ->
     let e2 = the_asm (fun c -> hd_is "ALL2" c &&
                is_abs (el 0 (snd (strip_comb c)))) gl in
     ASSUME_TAC (MATCH_MP LIST_REL_LENGTH e2)) THEN
   REPEAT STRIP_TAC THEN
   (* the root to add is the element of the heap's element at the
      index, and of a thunk it is the one value it holds *)
   W(fun (asl,w as gl) ->
     let hl = the_asm (fun c -> is_eq c &&
                hd_is "heap_lookup" (lhand c) &&
                hd_is "SOME" (rand c)) gl in
     let el1 = rand (rand (concl hl)) in
     let args = snd (strip_comb el1) in
     let zs = last args in
     let bod = snd (strip_exists w) in
     let idx = lhand (lhand (hd (conjuncts bod))) in
     if hd_is "ThunkBlock" el1
     then EXISTS_TAC zs
     else EXISTS_TAC (list_mk_icomb "EL" [idx; zs])) THEN
   CONJ_TAC THEN
   (* what the heap reads at the index *)
   TRY (SOLVED
         (W(fun (asl,w as gl) ->
            let hl = the_asm (fun c -> is_eq c &&
                       hd_is "heap_lookup" (lhand c) &&
                       hd_is "SOME" (rand c)) gl in
            let rq = the_asm (fun c -> is_eq c && is_var (lhand c) &&
                       hd_is "gc_shared_Pointer" (rand c)) gl in
            let hl2 = REWRITE_RULE[RefBlock_def;
                                   ThunkBlock_def] hl in
            let ys = el 0 (snd (strip_comb
                       (rand (rand (concl hl2))))) in
            let idx = lhand (lhand w) in
            SUBGOAL_THEN (list_mk_icomb "<"
                [idx; list_mk_icomb "LENGTH" [ys]])
              (fun ltx ->
                 ONCE_REWRITE_TAC[rq] THEN
                 MATCH_ACCEPT_TAC (REWRITE_RULE[EL; HD]
                   (MATCH_MP heap_el_data (CONJ hl2 ltx)))) THEN
            REWRITE_TAC[LENGTH] THEN ASM_ARITH_TAC))) THEN
   (* and the invariant of the stack with that value in front *)
   REWRITE_TAC[abs_ml_inv_def; bc_stack_ref_inv_def] THEN
   REPEAT CONJ_TAC THEN
   TRY (SOLVED (FIRST_ASSUM ACCEPT_TAC)) THEN
   (* the new root is a pointer of a good heap *)
   TRY (SOLVED
         (W(fun (asl,w as gl) ->
            let ho = the_asm (hd_is "heap_ok") gl in
            let hl = the_asm (fun c -> is_eq c &&
                       hd_is "heap_lookup" (lhand c) &&
                       hd_is "SOME" (rand c)) gl in
            let hl2 = REWRITE_RULE[RefBlock_def;
                                   ThunkBlock_def] hl in
            let ys = el 0 (snd (strip_comb
                       (rand (rand (concl hl2))))) in
            let ro = the_asm (hd_is "roots_ok") gl in
            let hd0 = lhand (el 0 (snd (strip_comb w))) in
            let idx = if hd_is "EL" hd0 then lhand hd0
                      else mk_small_numeral 0 in
            SUBGOAL_THEN (list_mk_icomb "<"
                [idx; list_mk_icomb "LENGTH" [ys]])
              (fun ltx -> MATCH_ACCEPT_TAC (REWRITE_RULE[EL; HD]
                 (MATCH_MP roots_ok_data
                    (CONJ ho (CONJ hl2 (CONJ ltx ro)))))) THEN
            REWRITE_TAC[LENGTH] THEN ASM_ARITH_TAC))) THEN
   (* the two maps are the ones they were *)
   W(fun gl ->
     let sub p = rand (lhand (concl (the_asm (fun c ->
       hd_is "SUBSET" c && hd_is p (rand c)) gl))) in
     EXISTS_TAC (sub "domain") THEN EXISTS_TAC (sub "all_ts")) THEN
   REPEAT CONJ_TAC THEN
   TRY (SOLVED (FIRST_ASSUM ACCEPT_TAC)) THEN
   (* the timestamps of the stack only grow *)
   TRY (SOLVED
         (MATCH_MP_TAC SUBSET_TRANS THEN
          W(fun gl ->
            let s = the_asm (fun c -> hd_is "SUBSET" c &&
                      hd_is "all_ts" (rand c)) gl in
            EXISTS_TAC (rand (concl s))) THEN
          CONJ_TAC THEN TRY (FIRST_ASSUM ACCEPT_TAC) THEN
          MATCH_ACCEPT_TAC all_ts_mono)) THEN
   (* the blocks of the stack stay unique, because the value is one
      of a reference that the stack has already *)
   TRY (SOLVED
         (W(fun gl ->
            let lk = the_asm (fun c -> is_eq c &&
                       hd_is "sptree_lookup" (lhand c) &&
                       hd_is "SOME" (rand c)) gl in
            let bu = the_asm (hd_is "blocks_unique") gl in
            let lt = try [the_asm (hd_is "<") gl]
                     with Failure _ -> [] in
            MATCH_ACCEPT_TAC (tryfind (fun f -> f ())
              [(fun () -> MATCH_MP blocks_unique_deref1
                  (CONJ lk bu));
               (fun () -> MATCH_MP blocks_unique_deref2
                  (CONJ (hd lt) (CONJ lk bu)))])))) THEN
   (* the values of the stack with the value in front: of an array
      of values the relation of its values, the other way round
      (entry 53), gives it at the index; of a thunk the relation of
      its value is the one the arm gave *)
   W(fun (asl,w) ->
     if not (hd_is "ALL2" w) then ALL_TAC else
     (let gp = el 0 (snd (strip_comb w)) in
      let olds = mapfilter (fun (_,th) ->
                   let c = concl th in
                   if hd_is "ALL2" c &&
                      not (el 0 (snd (strip_comb c)) = gp)
                   then CONV_RULE(TOP_DEPTH_CONV BETA_CONV)
                          (MATCH_MP EVERY2_SWAP th)
                   else fail()) asl in
      MAP_EVERY ASSUME_TAC olds THEN
      FIRST
       [(MATCH_MP_TAC all2_el_cons THEN
         CONV_TAC(TOP_DEPTH_CONV BETA_CONV) THEN
         REPEAT CONJ_TAC THEN
         TRY (SOLVED (FIRST_ASSUM ACCEPT_TAC)) THEN
         ASM_ARITH_TAC);
        (REWRITE_TAC[ALL2] THEN
         CONV_TAC(TOP_DEPTH_CONV BETA_CONV) THEN
         REPEAT CONJ_TAC THEN
         TRY (SOLVED (FIRST_ASSUM ACCEPT_TAC)))])) THEN
   (* and a reference that the value reaches is one that the
      pointer reaches, because the pointer has an edge to it *)
   REPEAT STRIP_TAC THEN
   FIRST_X_ASSUM (fun bri ->
     let b = snd (strip_forall (concl bri)) in
     if not (is_imp b) || not (hd_is "bc_ref_inv" (rand b))
     then fail() else MATCH_MP_TAC bri) THEN
   CONJ_TAC THEN
   TRY (SOLVED (FIRST_ASSUM ACCEPT_TAC)) THEN
   MATCH_MP_TAC (GEN_ALL reach_ref) THEN
   (* the value whose references are the ones to account for *)
   W(fun (asl,w as gl) ->
     if not (is_exists w) then ALL_TAC else
     (let rr = the_asm (fun c -> hd_is "reachable_refs" c &&
                 not (hd_is "dataSem_RefPtr"
                        (lhand (el 0 (snd (strip_comb c)))))) gl in
      EXISTS_TAC (lhand (el 0 (snd (strip_comb (concl rr))))))) THEN
   CONJ_TAC THEN
   TRY (SOLVED (FIRST_ASSUM ACCEPT_TAC)) THEN
   (* the edge of the pointer lands at every reference of the
      value, because what the key holds has the value in it *)
   GEN_TAC THEN DISCH_TAC THEN
   W(fun gl ->
     let lk = the_asm (fun c -> is_eq c &&
                hd_is "sptree_lookup" (lhand c) &&
                hd_is "SOME" (rand c)) gl in
     REWRITE_TAC[ref_edge_def; lk]) THEN
   MATCH_REDUCE_TAC THEN
   REWRITE_TAC[EL; HD] THEN
   W(fun gl ->
     let m = the_asm (fun c -> hd_is "MEM" c &&
               hd_is "get_refs" (rand c)) gl in
     let vv = el 0 (snd (strip_comb (rand (concl m)))) in
     MATCH_MP_TAC (GEN_ALL refs_in_block) THEN
     EXISTS_TAC vv THEN
     CONJ_TAC THENL
      [FIRST [SOLVED (MATCH_MP_TAC MEM_EL THEN ASM_ARITH_TAC);
              SOLVED (REWRITE_TAC[MEM])];
       ACCEPT_TAC m]))
### el_thm
  (* the steps that this lemma and the ones after it take are
     above the statement (tools/overrides.py).  The roots are a
     cons whose head is the Block's pointer, the element of the
     payload at the index is the element of its representation
     there, and the invariant of the new stack is the old one
     with that value in front *)
  (STRIP_TAC THEN
   (* what the invariant says of the stack with the Block at its
      head *)
   FIRST_X_ASSUM (fun inv ->
     if not (hd_is "abs_ml_inv" (concl inv)) then fail() else
     STRIP_ASSUME_TAC (REWRITE_RULE[abs_ml_inv_def;
                                    bc_stack_ref_inv_def] inv)) THEN
   (* the roots are a cons, and its head is the Block's *)
   W(fun gl ->
     let lr = the_asm (fun c -> hd_is "ALL2" c) gl in
     CASES_ON_TAC (el 2 (snd (strip_comb (concl lr))))) THEN
   RULE_ASSUM_TRY (REWRITE_RULE[ALL2_DEF; HD; TL; NOT_CONS_NIL]) THEN
   TRY (FIRST_ASSUM CONTR_TAC) THEN
   SPLIT_ASM_TAC THEN
   (* the payload is not empty, because the index is below its
      length *)
   SUBGOAL_THEN `~((xs:dataSem_v list) = [])` ASSUME_TAC THENL
    [REWRITE_TAC[GSYM LENGTH_EQ_NIL] THEN ASM_ARITH_TAC;
     ALL_TAC] THEN
   (* the Block is a pointer at its representation in the heap; the
      invariant of the Block itself is kept, because the values of
      the new stack ask for it *)
   FIRST_ASSUM (fun vb ->
     if not (hd_is "v_inv" (concl vb)) then fail() else
     STRIP_ASSUME_TAC (REWRITE_RULE[v_inv_def;
       ASSUME `~((xs:dataSem_v list) = [])`] vb)) THEN
   VAR_EQ_TAC THEN
   (* the witnesses: the head of the roots, its tail, and the
      element of the Block's representation at the index *)
   W(fun (asl,w as gl) ->
     let cns = lhs (hd (conjuncts (snd (strip_exists w)))) in
     let ys = el 1 (snd (strip_comb (rand (rand
                (concl (blockrep_asm gl)))))) in
     EXISTS_TAC (lhand cns) THEN EXISTS_TAC (rand cns) THEN
     EXISTS_TAC (list_mk_icomb "EL" [`i:num`; ys])) THEN
   (* the payload and its representation are of a length *)
   FIRST_ASSUM (fun lr ->
     if not (hd_is "ALL2" (concl lr)) then fail() else
     ASSUME_TAC (MATCH_MP LIST_REL_LENGTH lr)) THEN
   (* so the index is below the length of the representation *)
   W(fun gl ->
     let lt = the_asm (hd_is "<") gl in
     let le = the_asm (fun c -> is_eq c &&
                hd_is "LENGTH" (lhand c)) gl in
     SUBGOAL_THEN (mk_binop `(<):num->num->bool`
                     (lhand (concl lt)) (rand (concl le)))
       ASSUME_TAC THENL [ASM_ARITH_TAC; ALL_TAC]) THEN
   REPEAT CONJ_TAC THEN
   TRY (SOLVED REFL_TAC) THEN
   (* what the heap holds at the index *)
   TRY (SOLVED
         (W(fun gl ->
            let hl = blockrep_asm gl in
            let lt = the_asm (fun c -> hd_is "<" c &&
                       hd_is "LENGTH" (rand c)) gl in
            MATCH_ACCEPT_TAC (MATCH_MP heap_el_block
              (CONJ hl lt))))) THEN
   (* the invariant with the element on the stack *)
   REWRITE_TAC[abs_ml_inv_def; bc_stack_ref_inv_def] THEN
   REPEAT CONJ_TAC THEN TRY (FIRST_ASSUM ACCEPT_TAC) THEN
   (* the new root is a pointer of the Block's element, and the
      pointers of a good heap are addresses of it *)
   TRY (SOLVED
         (W(fun gl ->
            let ho = the_asm (hd_is "heap_ok") gl in
            let hl = blockrep_asm gl in
            let lt = the_asm (fun c -> hd_is "<" c &&
                       hd_is "LENGTH" (rand c)) gl in
            let ro = the_asm (hd_is "roots_ok") gl in
            MATCH_ACCEPT_TAC (MATCH_MP roots_ok_el
              (CONJ ho (CONJ hl (CONJ lt ro))))))) THEN
   (* the two maps are the same ones *)
   W(fun gl ->
     let sub p = rand (lhand (concl (the_asm (fun c ->
       hd_is "SUBSET" c && hd_is p (rand c)) gl))) in
     EXISTS_TAC (sub "domain") THEN EXISTS_TAC (sub "all_ts")) THEN
   REPEAT CONJ_TAC THEN TRY (FIRST_ASSUM ACCEPT_TAC) THEN
   (* the timestamps of the stack only grow *)
   TRY (SOLVED
         (MATCH_MP_TAC SUBSET_TRANS THEN
          W(fun gl ->
            let s = the_asm (fun c -> hd_is "SUBSET" c &&
                      hd_is "all_ts" (rand c)) gl in
            EXISTS_TAC (rand (concl s))) THEN
          CONJ_TAC THEN TRY (FIRST_ASSUM ACCEPT_TAC) THEN
          MATCH_ACCEPT_TAC all_ts_mono)) THEN
   (* the blocks of the stack stay unique *)
   TRY (SOLVED
         (MATCH_MP_TAC (GEN_ALL blocks_unique_el) THEN
          CONJ_TAC THEN FIRST_ASSUM ACCEPT_TAC)) THEN
   (* the values of the stack are the old ones and the element *)
   (* the values of the stack are the old ones and the element,
      which the relation of the payload gives at the index
      (all2_el_cons) *)
   TRY (SOLVED
         (MATCH_MP_TAC all2_el_cons THEN
          CONV_TAC(TOP_DEPTH_CONV BETA_CONV) THEN
          REPEAT CONJ_TAC THEN TRY (FIRST_ASSUM ACCEPT_TAC) THEN
          POP_ASSUM_LIST (fun l -> MAP_EVERY ASSUME_TAC (filter
            (fun t -> let c = concl t in
               hd_is "<" c ||
               (is_eq c && (hd_is "LENGTH" (lhand c) ||
                            hd_is "LENGTH" (rand c)))) l)) THEN
          ASM_ARITH_TAC)) THEN
   (* and a reference that the element reaches is one that the
      Block reaches *)
   REPEAT STRIP_TAC THEN
   FIRST_X_ASSUM (fun bri ->
     let b = snd (strip_forall (concl bri)) in
     if not (is_imp b) || not (hd_is "bc_ref_inv" (rand b))
     then fail() else MATCH_MP_TAC bri) THEN
   CONJ_TAC THEN TRY (FIRST_ASSUM ACCEPT_TAC) THEN
   MATCH_MP_TAC (GEN_ALL reach_block) THEN
   W(fun gl ->
     let rr = the_asm (hd_is "reachable_refs") gl in
     EXISTS_TAC (lhand (el 0 (snd (strip_comb (concl rr)))))) THEN
   CONJ_TAC THEN TRY (FIRST_ASSUM ACCEPT_TAC) THEN
   MEM_CLOSE)
### new_byte_alt_thm
  (* the steps are above the statement (tools/overrides.py).  The
     element is a word longer than the words it holds, so it fits
     in the unused space and IMP_heap_store_unused_alt writes it
     there; the heap, the roots and the space are then as good as
     they were (gc_kind_store_unused_alt of the kind of the
     collection, where an array of bytes is no reference), the map
     of the addresses gains the key of the array with the address
     it was written at, and of every reference that the stack
     reaches the invariant holds as it did (bc_ref_inv_step) --
     while the array itself is the element that the store wrote *)
  (STRIP_TAC THEN SPLIT_ASM_TAC THEN
    (* what the invariant says of the stack *)
    FIRST_X_ASSUM (fun inv ->
      if not (hd_is "abs_ml_inv" (concl inv)) then fail() else
      STRIP_ASSUME_TAC (REWRITE_RULE[abs_ml_inv_def;
                                     bc_stack_ref_inv_def] inv)) THEN
    (* the element written is a word longer than the words it
       holds *)
    W(fun (asl,w) ->
      let byt = find_term (hd_is "Bytes") w in
      let wsn = el 0 (snd (strip_comb
                  (el 3 (snd (strip_comb byt))))) in
      SUBGOAL_THEN (mk_eq (list_mk_icomb "el_length" [byt],
                      list_mk_icomb "+" [wsn; mk_small_numeral 1]))
        ASSUME_TAC THENL
       [REWRITE_TAC[bytes_def] THEN
        CONV_TAC(ONCE_DEPTH_CONV let_CONV) THEN
        REWRITE_TAC[el_length_def] THEN MATCH_REDUCE_TAC THEN
        REWRITE_TAC[LENGTH_write_bytes; LENGTH_REPLICATE];
        ALL_TAC]) THEN
    (* so it fits in the unused space, and the store writes it
       there *)
    W(fun (asl,w as gl) ->
      let us = the_asm (hd_is "unused_space_inv") gl in
      let spsp = el 1 (snd (strip_comb (concl us))) in
      let le = the_asm (fun c -> is_eq c &&
                 hd_is "el_length" (lhand c)) gl in
      let el1 = el 0 (snd (strip_comb (lhand (concl le)))) in
      SUBGOAL_THEN (list_mk_icomb "<="
                      [list_mk_icomb "el_length" [el1]; spsp])
        (fun bd -> STRIP_ASSUME_TAC (MATCH_MP
           IMP_heap_store_unused_alt (CONJ us bd))) THENL
       [REWRITE_TAC[le] THEN ASM_ARITH_TAC;
        ALL_TAC]) THEN
    (* the element is a data element, which is what the two facts
       about the store ask for *)
    W(fun gl ->
      let st = the_asm (fun c -> is_eq c &&
                 hd_is "heap_store_unused_alt" (lhand c)) gl in
      let el1 = el 2 (snd (strip_comb (lhand (concl st)))) in
      let isd = is_data_el el1 in
      MAP_EVERY (fun th -> ASSUME_TAC (MP th isd))
        (mapfilter (fun (_,th) ->
           let c = concl th in
           if is_imp c && hd_is "isDataElement" (lhand c) then th
           else fail()) (fst gl))) THEN
    (* the witness: the heap that the store wrote *)
    W(fun (asl,w as gl) ->
      let st = the_asm (fun c -> is_eq c &&
                 hd_is "heap_store_unused_alt" (lhand c)) gl in
      EXISTS_TAC (lhand (rand (concl st)))) THEN
    REPEAT CONJ_TAC THEN
    TRY (SOLVED (FIRST_ASSUM ACCEPT_TAC)) THEN
    (* and the invariant of the new heap, stack and references *)
    REWRITE_TAC[abs_ml_inv_def] THEN
    (* the addresses that hold data are the ones that did, and the
       one the store wrote *)
    W(fun gl ->
      let seq = the_asm (fun c -> is_eq c &&
                  hd_is "INSERT" (rand c)) gl in
      let ro = the_asm (hd_is "roots_ok") gl in
      ASSUME_TAC (REWRITE_RULE[EXTENSION; IN_INSERT; IN_ELIM_THM]
                    seq) THEN
      ASSUME_TAC (REWRITE_RULE[roots_ok_def] ro)) THEN
    REPEAT CONJ_TAC THEN
    (* the roots: the one of the array is the address it was
       written at, and the others are the ones they were *)
    TRY (SOLVED
          (REWRITE_TAC[roots_ok_def; MEM] THEN
           REPEAT STRIP_TAC THEN
           W(fun gl ->
             let iso = the_asm (fun c ->
                         let vs,bd = strip_forall c in
                         length vs = 1 && is_eq bd &&
                         hd_is "isSomeDataElement" (lhand bd)) gl in
             REWRITE_TAC[iso]) THEN
           TRY (SOLVED
                 (DISJ1_TAC THEN
                  FIRST_X_ASSUM (fun e ->
                    if not (is_eq (concl e)) ||
                       not (hd_is "gc_shared_Pointer" (rand (concl e)))
                    then fail() else
                    MP_TAC e) THEN
                  REWRITE_TAC[injectivity "heap_address"] THEN
                  MESON_TAC[])) THEN
           DISJ2_TAC THEN
           ASM_MESON_TAC[MEM_APPEND])) THEN
    (* the heap is good: it is as long as it was, it has no forward
       pointer, and the element written holds no pointer at all *)
    TRY (SOLVED
          (REWRITE_TAC[heap_ok_def] THEN
           REPEAT CONJ_TAC THEN
           TRY (SOLVED
                 (W(fun gl ->
                    let ho = REWRITE_RULE[heap_ok_def]
                               (the_asm (hd_is "heap_ok") gl) in
                    let hl = the_asm (fun c -> is_eq c &&
                               hd_is "heap_length" (lhand c)) gl in
                    MP_TAC ho THEN REWRITE_TAC[hl] THEN
                    STRIP_TAC THEN ASM_REWRITE_TAC[]))) THEN
           TRY (SOLVED
                 (W(fun gl ->
                    let ho = REWRITE_RULE[heap_ok_def]
                               (the_asm (hd_is "heap_ok") gl) in
                    let impl = the_asm (fun c -> is_imp c &&
                                 is_neg (lhand c) &&
                                 hd_is "isForwardPointer"
                                   (rand (lhand c))) gl in
                    let st = the_asm (fun c -> is_eq c &&
                               hd_is "heap_store_unused_alt"
                                 (lhand c)) gl in
                    let el1 = el 2 (snd (strip_comb
                                (lhand (concl st)))) in
                    SUBGOAL_THEN (mk_neg (list_mk_icomb
                                    "isForwardPointer" [el1]))
                      (fun nf -> MP_TAC ho THEN
                         REWRITE_TAC[MP impl nf] THEN
                         STRIP_TAC THEN ASM_REWRITE_TAC[]) THEN
                    REWRITE_TAC[bytes_def] THEN
                    CONV_TAC(ONCE_DEPTH_CONV let_CONV) THEN
                    REWRITE_TAC[isForwardPointer_def] THEN
                    MATCH_REDUCE_TAC THEN REWRITE_TAC[]))) THEN
           (* the pointers: the element written holds none, and of
              any other element they are what they were *)
           REPEAT GEN_TAC THEN
           W(fun gl ->
             let mem = the_asm (fun c ->
                         let vs,bd = strip_forall c in
                         length vs = 3 && is_eq bd &&
                         hd_is "MEM" (lhand bd)) gl in
             REWRITE_TAC[mem]) THEN
           STRIP_TAC THEN
           W(fun gl ->
             let iso = the_asm (fun c ->
                         let vs,bd = strip_forall c in
                         length vs = 1 && is_eq bd &&
                         hd_is "isSomeDataElement" (lhand bd)) gl in
             REWRITE_TAC[iso]) THEN
           DISJ2_TAC THEN
           TRY (SOLVED
                 (W(fun gl ->
                    let eq = the_asm (fun c -> is_eq c &&
                               hd_is "Bytes" (lhand c)) gl in
                    MP_TAC eq) THEN
                  REWRITE_TAC[bytes_def] THEN
                  CONV_TAC(ONCE_DEPTH_CONV let_CONV) THEN
                  REWRITE_TAC[injectivity "heap_element"] THEN
                  STRIP_TAC THEN
                  ASM_MESON_TAC[MEM])) THEN
           W(fun gl ->
             let ho = REWRITE_RULE[heap_ok_def]
                        (the_asm (hd_is "heap_ok") gl) in
             MP_TAC ho) THEN
           ASM_MESON_TAC[])) THEN
    (* the kind of the collection: the store into the unused space
       keeps it, and an array of bytes is no reference *)
    W(fun (asl,w as gl) ->
      if not (hd_is "gc_kind_inv" w) then ALL_TAC else
      (let gk = the_asm (hd_is "gc_kind_inv") gl in
       let st = the_asm (fun c -> is_eq c &&
                  hd_is "heap_store_unused_alt" (lhand c)) gl in
       let el1 = el 2 (snd (strip_comb (lhand (concl st)))) in
       let sp = el 2 (snd (strip_comb (concl gk))) in
       let le = the_asm (fun c -> is_eq c &&
                  hd_is "el_length" (lhand c)) gl in
       let us2 = the_asm (fun c -> hd_is "unused_space_inv" c &&
                   can (find_term (hd_is "-")) c) gl in
       let nr = PART_MATCH I isRef_Bytes
                  (mk_neg (list_mk_icomb
                     "data_to_word_memoryProof_isRef" [el1])) in
       SUBGOAL_THEN (list_mk_icomb "<="
                       [list_mk_icomb "el_length" [el1]; sp])
         (fun bd -> MATCH_ACCEPT_TAC (REWRITE_RULE[le] (MATCH_MP
            gc_kind_store_unused_alt
            (CONJ nr (CONJ bd (CONJ gk (CONJ st us2))))))) THEN
       REWRITE_TAC[le] THEN ASM_ARITH_TAC)) THEN
    (* the unused space: what the store lemma says, with the length
       of the element taken off *)
    W(fun (asl,w as gl) ->
      if not (hd_is "unused_space_inv" w) then ALL_TAC else
      (let us = the_asm (fun c -> hd_is "unused_space_inv" c &&
                  can (find_term (hd_is "-")) c) gl in
       let le = the_asm (fun c -> is_eq c &&
                  hd_is "el_length" (lhand c)) gl in
       MP_TAC (REWRITE_RULE[le] us) THEN
       W(fun (asl,w) ->
         let usub = el 1 (snd (strip_comb (lhand w))) in
         let gsub = el 1 (snd (strip_comb (rand w))) in
         let uadd = el 0 (snd (strip_comb (lhand w))) in
         let gadd = el 0 (snd (strip_comb (rand w))) in
         SUBGOAL_THEN (mk_eq (uadd, gadd)) ASSUME_TAC THENL
          [ASM_ARITH_TAC;
           SUBGOAL_THEN (mk_eq (usub, gsub)) ASSUME_TAC THENL
            [ASM_ARITH_TAC; ASM_REWRITE_TAC[]]]))) THEN
    (* the maps: the key of the array with the address it was
       written at, and the timestamps as they were *)
    REWRITE_TAC[bc_stack_ref_inv_def] THEN
    (* the key is fresh in the map of the addresses *)
    W(fun (asl,w as gl) ->
      let su = the_asm (fun c -> hd_is "SUBSET" c &&
                 hd_is "domain" (rand c)) gl in
      let nd = the_asm (fun c -> is_neg c && hd_is "IN" (rand c) &&
                 hd_is "domain" (rand (rand c))) gl in
      let fm = rand (lhand (concl su)) in
      let ptr = el 0 (snd (strip_comb (rand (concl nd)))) in
      SUBGOAL_THEN (mk_neg (list_mk_icomb "IN"
                      [ptr; list_mk_icomb "FDOM" [fm]]))
        ASSUME_TAC THENL
       [MP_TAC su THEN MP_TAC nd THEN REWRITE_TAC[SUBSET] THEN
        MESON_TAC[];
        ALL_TAC]) THEN
    W(fun (asl,w as gl) ->
      let su = the_asm (fun c -> hd_is "SUBSET" c &&
                 hd_is "domain" (rand c)) gl in
      let f = rand (lhand (concl su)) in
      let tfsu = the_asm (fun c -> hd_is "SUBSET" c &&
                   hd_is "all_ts" (rand c)) gl in
      let tf = rand (lhand (concl tfsu)) in
      let st = the_asm (fun c -> is_eq c &&
                 hd_is "heap_store_unused_alt" (lhand c)) gl in
      let aa = el 0 (snd (strip_comb (lhand (concl st)))) in
      let ins = find_term (hd_is "sptree_insert") w in
      let ptr = el 0 (snd (strip_comb ins)) in
      EXISTS_TAC (list_mk_icomb "|+" [f; mk_pair (ptr, aa)]) THEN
      EXISTS_TAC tf) THEN
    REPEAT CONJ_TAC THEN
    TRY (SOLVED (FIRST_ASSUM ACCEPT_TAC)) THEN
    (* the map of the addresses with the key at the address, which
       held no data *)
    W(fun (asl,w as gl) ->
      if not (hd_is "INJ" w) ||
         not (can (find_term (hd_is "|+")) w) then ALL_TAC else
      (let iso = the_asm (fun c ->
                   let vs,bd = strip_forall c in
                   length vs = 1 && is_eq bd &&
                   hd_is "isSomeDataElement" (lhand bd)) gl in
       let inj = the_asm (fun c -> hd_is "INJ" c &&
                   hd_is "fmap_apply" (el 0 (snd (strip_comb c))) &&
                   rand (el 0 (snd (strip_comb c))) =
                     lhand (rand (el 0 (snd (strip_comb w))))) gl in
       let nd = the_asm (fun c -> is_neg c &&
                  hd_is "isSomeDataElement" (rand c)) gl in
       MATCH_MP_TAC INJ_FUPDATE_fresh THEN
       EXISTS_TAC (rand (concl inj)) THEN
       REPEAT CONJ_TAC THEN
       TRY (SOLVED (FIRST_ASSUM ACCEPT_TAC)) THEN
       TRY (SOLVED (MP_TAC nd THEN REWRITE_TAC[IN_ELIM_THM])) THEN
       REWRITE_TAC[IN_ELIM_THM] THEN
       MATCH_ACCEPT_TAC iso)) THEN
    (* and the map of the timestamps goes into the bigger set of
       addresses *)
    W(fun (asl,w as gl) ->
      if not (hd_is "INJ" w) then ALL_TAC else
      (let iso = the_asm (fun c ->
                   let vs,bd = strip_forall c in
                   length vs = 1 && is_eq bd &&
                   hd_is "isSomeDataElement" (lhand bd)) gl in
       let inj = the_asm (fun c -> hd_is "INJ" c &&
                   el 0 (snd (strip_comb c)) =
                     el 0 (snd (strip_comb w))) gl in
       MATCH_MP_TAC INJ_bigger THEN
       EXISTS_TAC (rand (concl inj)) THEN
       CONJ_TAC THENL
        [ACCEPT_TAC inj;
         REWRITE_TAC[IN_ELIM_THM] THEN
         REWRITE_TAC[iso] THEN MESON_TAC[]])) THEN
    (* the domain of the references has the key of the array *)
    TRY (SOLVED
          (REWRITE_TAC[FDOM_FUPDATE; domain_insert] THEN
           W(fun gl ->
             let su = the_asm (fun c -> hd_is "SUBSET" c &&
                        hd_is "domain" (rand c)) gl in
             MP_TAC su) THEN
           SET_TAC[])) THEN
    (* the timestamps of the new references and stack are more than
       the ones of the old (all_ts_insert_SUBSET) *)
    TRY (SOLVED
          (MATCH_MP_TAC SUBSET_TRANS THEN
           W(fun gl ->
             let su = the_asm (fun c -> hd_is "SUBSET" c &&
                        hd_is "all_ts" (rand c)) gl in
             let nd = the_asm (fun c -> is_neg c &&
                        hd_is "IN" (rand c) &&
                        hd_is "domain" (rand (rand c))) gl in
             EXISTS_TAC (rand (concl su)) THEN
             CONJ_TAC THENL
              [ACCEPT_TAC su;
               MATCH_MP_TAC all_ts_insert_SUBSET THEN
               CONJ_TAC THENL
                [ACCEPT_TAC nd;
                 REWRITE_TAC[MEM] THEN MESON_TAC[]]]))) THEN
    (* and the blocks of the stack stay unique *)
    TRY (SOLVED
          (W(fun gl ->
             let bu = the_asm (hd_is "blocks_unique") gl in
             MATCH_ACCEPT_TAC (MATCH_MP blocks_unique_new_byte_alt
               bu)))) THEN
    (* the transfer that the allocation leaves: what the invariant
       said of a value it says of it with the array written
       (v_inv_new_byte_step) *)
    W(fun (asl,w as gl) ->
      let nd = the_asm (fun c -> is_neg c && hd_is "IN" (rand c) &&
                 hd_is "domain" (rand (rand c))) gl in
      let su = the_asm (fun c -> hd_is "SUBSET" c &&
                 hd_is "domain" (rand c)) gl in
      let hsr = the_asm (hd_is "heap_store_rel") gl in
      let old = the_asm (hd_is "ALL2") gl in
      let pred = el 0 (snd (strip_comb (concl old))) in
      let v,b1 = dest_abs pred in
      let x,vtm = dest_abs b1 in
      let f2 = find_term (hd_is "|+") w in
      let refs2 = find_term (hd_is "sptree_insert") w in
      ASSUME_TAC (GENL [v; x] (DISCH vtm
        (MATCH_MP v_inv_new_byte_step
          (CONJ (ASSUME vtm) (CONJ nd (CONJ su (CONJ hsr
            (CONJ (REFL f2) (REFL refs2)))))))))) THEN
    (* the values of the stack with the pointer of the array on
       it *)
    W(fun (asl,w) ->
      if not (hd_is "ALL2" w) then ALL_TAC else
      (REWRITE_TAC[ALL2] THEN
       CONV_TAC(TOP_DEPTH_CONV BETA_CONV) THEN
       CONJ_TAC THENL
        [REWRITE_TAC[v_inv_def] THEN DISJ1_TAC THEN
         REWRITE_TAC[FDOM_FUPDATE; IN_INSERT; lookup_insert;
                     FAPPLY_FUPDATE_THM; ref_ptr_annot_def] THEN
         REPEAT CONJ_TAC THEN
         TRY MATCH_REDUCE_TAC THEN
         (let ds = [distinctness "option";
                    distinctness "bvlSem_ref"] in
          REWRITE_TAC (injectivity "option" ::
                       injectivity "heap_address" ::
                       ds @ map GSYM ds)) THEN
         REWRITE_TAC[];
         W(fun gl ->
           let old = the_asm (hd_is "ALL2") gl in
           MATCH_ACCEPT_TAC (MATCH_MP EVERY2_v_inv_alloc_stack
             (CONJ (a_vtr gl) old)))])) THEN
    (* and the invariant of every reference that the new stack
       reaches: the array itself, or one that the old stack
       reached *)
    REPEAT STRIP_TAC THEN
    W(fun (asl,w) ->
      let ins = find_term (hd_is "sptree_insert") w in
      let ptr = el 0 (snd (strip_comb ins)) in
      let n = el 1 (snd (strip_comb w)) in
      ASM_CASES_TAC (mk_eq (n, ptr))) THENL
     [(* the array itself: its key has the address the store wrote
          at, and the element is the one it wrote *)
      FIRST_X_ASSUM SUBST_ALL_TAC THEN
      W(fun (asl,w as gl) ->
        let st = the_asm (fun c -> is_eq c &&
                   hd_is "heap_store_unused_alt" (lhand c)) gl in
        let aa = el 0 (snd (strip_comb (lhand (concl st)))) in
        let fm = el 0 (tparts (el 3 (snd (strip_comb w)))) in
        let ptr = el 1 (snd (strip_comb w)) in
        let ins = el 2 (snd (strip_comb w)) in
        SUBGOAL_THEN (mk_eq (list_mk_icomb "FLOOKUP" [fm; ptr],
                             list_mk_icomb "SOME" [aa]))
          ASSUME_TAC THENL
         [REWRITE_TAC[FLOOKUP_UPDATE]; ALL_TAC] THEN
        SUBGOAL_THEN
          (mk_eq (list_mk_icomb "sptree_lookup" [ptr; ins],
                  list_mk_icomb "SOME"
                    [el 1 (snd (strip_comb ins))])) ASSUME_TAC THENL
         [REWRITE_TAC[lookup_insert]; ALL_TAC]) THEN
      W(fun gl ->
        let lk1 = the_asm (fun c -> is_eq c &&
                    hd_is "FLOOKUP" (lhand c)) gl in
        let lk2 = the_asm (fun c -> is_eq c &&
                    hd_is "sptree_lookup" (lhand c) &&
                    hd_is "sptree_insert" (rand (lhand c))) gl in
        REWRITE_TAC[MATCH_MP arm_BA (CONJ lk1 lk2)]) THEN
      CONV_TAC(TOP_DEPTH_CONV let_CONV) THEN
      W(fun gl ->
        let ab = the_asm (hd_is "Abbrev") gl in
        REWRITE_TAC[GSYM (REWRITE_RULE[abbrev_def] ab)]) THEN
      FIRST_ASSUM ACCEPT_TAC;
      (* and a reference that the old stack reached: it is in the
         domain of the map that the key was not in *)
      W(fun (asl,w as gl) ->
        let rr = the_asm (hd_is "reachable_refs") gl in
        let nd = the_asm (fun c -> is_neg c && hd_is "IN" (rand c) &&
                   hd_is "domain" (rand (rand c))) gl in
        let neq = the_asm (fun c -> is_neg c && is_eq (rand c)) gl in
        ASSUME_TAC (REWRITE_RULE[EQF_INTRO neq]
          (MATCH_MP reachable_refs_new_byte (CONJ rr nd)))) THEN
      W(fun (asl,w as gl) ->
        let n = el 1 (snd (strip_comb w)) in
        let innu = the_asm (fun c -> hd_is "IN" c &&
                     hd_is "FDOM" (rand c) &&
                     el 0 (snd (strip_comb c)) = n) gl in
        let fm = lhand (rand (rand (concl innu))) in
        SUBGOAL_THEN (list_mk_icomb "IN"
                        [n; list_mk_icomb "FDOM" [fm]])
          ASSUME_TAC THENL
         [MP_TAC innu THEN
          REWRITE_TAC[FDOM_FUPDATE; IN_INSERT] THEN
          ASM_MESON_TAC[];
          ALL_TAC]) THEN
      W(fun (asl,w as gl) ->
        let n = el 1 (snd (strip_comb w)) in
        let bri = the_asm (fun c ->
          let vs,bd = strip_forall c in
          length vs = 1 && is_imp bd &&
          hd_is "bc_ref_inv" (rand bd)) gl in
        let rr = the_asm (fun c -> hd_is "reachable_refs" c &&
          not (can (find_term (hd_is "sptree_insert")) c)) gl in
        let inn = the_asm (fun c -> hd_is "IN" c &&
          hd_is "FDOM" (rand c) &&
          el 0 (snd (strip_comb c)) = n &&
          not (can (find_term (hd_is "|+")) c)) gl in
        let inv = MP (SPEC n bri) (CONJ rr inn) in
        let hsr = the_asm (hd_is "heap_store_rel") gl in
        let stp = REWRITE_RULE[IMP_CONJ] bc_ref_inv_step in
        let th = MATCH_MP (MATCH_MP (MATCH_MP (MATCH_MP stp
                   (a_vtr gl)) inn) hsr) inv in
        MATCH_MP_TAC (REWRITE_RULE[IMP_IMP] th)) THEN
      REPEAT CONJ_TAC THEN
      (* the lookup of the references away from the key *)
      TRY (SOLVED (ASM_REWRITE_TAC[lookup_insert])) THEN
      (* the lookup of the map away from the key *)
      TRY (SOLVED (ASM_REWRITE_TAC[FLOOKUP_UPDATE])) THEN
      (* the timestamps did not change *)
      TRY (SOLVED (MESON_TAC[])) THEN
      (* and a thunk of the old references is one of the new *)
      W(fun gl ->
        let nd = the_asm (fun c -> is_neg c && hd_is "IN" (rand c) &&
                   hd_is "domain" (rand (rand c))) gl in
        GEN_TAC THEN DISCH_THEN (fun dt ->
          MATCH_ACCEPT_TAC (MATCH_MP dest_thunk_insert_fresh
            (CONJ nd dt))))])
### abs_ml_inv_stack_permute
  (* the steps are above the statement (tools/overrides.py).  The
     heap and the references are the ones they were, so the heap,
     the unused space and the kind of the collection say what they
     said; the roots of the new stack are among the old ones
     (roots_ok_subset), its pairs are pairs of the old stack
     (EVERY2_stack_permute, blocks_unique_stack_permute) and what
     it reaches the old stack reached
     (reachable_refs_stack_subset); and the timestamps are cut to
     the ones of the new stack, which the invariant of a value and
     of a reference survive (EVERY2_v_inv_restrict,
     bc_ref_inv_restrict) *)
  (REPEAT GEN_TAC THEN STRIP_TAC THEN SPLIT_ASM_TAC THEN
    (* the pairs of the new stack are pairs of the old *)
    W(fun gl ->
      let sub = the_asm (hd_is "SUBSET") gl in
      ASSUME_TAC (REWRITE_RULE[SUBSET; IN_SET_OF_LIST] sub)) THEN
    (* and what the invariant says of the old stack *)
    FIRST_X_ASSUM (fun inv ->
      if not (hd_is "abs_ml_inv" (concl inv)) then fail() else
      STRIP_ASSUME_TAC (REWRITE_RULE[abs_ml_inv_def;
                                     bc_stack_ref_inv_def] inv)) THEN
    REWRITE_TAC[abs_ml_inv_def; bc_stack_ref_inv_def] THEN
    REPEAT CONJ_TAC THEN
    TRY (SOLVED (FIRST_ASSUM ACCEPT_TAC)) THEN
    (* the roots are good, because they are among the old ones *)
    TRY (SOLVED
          (W(fun (asl,w as gl) ->
             let ro = the_asm (hd_is "roots_ok") gl in
             let sub = the_asm (fun c ->
                         length (fst (strip_forall c)) = 1 &&
                         is_imp (snd (strip_forall c)) &&
                         hd_is "MEM"
                           (lhand (snd (strip_forall c)))) gl in
             let xs = el 1 (snd (strip_comb
                        (rand (snd (strip_forall (concl sub)))))) in
             let rs2 = el 0 (snd (strip_comb w)) in
             let margs = snd (strip_comb (lhand rs2)) in
             let mem = MP (ISPECL [el 0 margs; el 1 margs; xs;
                                   rand rs2] MEM_MAP_subset) sub in
             ACCEPT_TAC (MATCH_MP roots_ok_subset (CONJ mem ro))))) THEN
    (* the maps: the addresses are the ones they were and the
       timestamps are cut to the ones of the new stack *)
    W(fun (asl,w as gl) ->
      if not (is_exists w) then ALL_TAC else
      (let sub p = rand (lhand (concl (the_asm (fun c ->
         hd_is "SUBSET" c && hd_is p (rand c)) gl))) in
       let ats = find_term (hd_is "all_ts") w in
       EXISTS_TAC (sub "domain") THEN
       EXISTS_TAC (list_mk_icomb "DRESTRICT" [sub "all_ts"; ats]))) THEN
    REPEAT CONJ_TAC THEN TRY (SOLVED (FIRST_ASSUM ACCEPT_TAC)) THEN
    (* the addresses of the restricted map are the ones it had *)
    TRY (SOLVED
          (W(fun (asl,w as gl) ->
             let dr = find_term (hd_is "DRESTRICT") w in
             let inj = the_asm (fun c -> hd_is "INJ" c &&
               rand (el 0 (snd (strip_comb c))) = lhand dr) gl in
             MATCH_ACCEPT_TAC (MATCH_MP INJ_DRESTRICT inj)))) THEN
    (* the timestamps of the restricted map are of the new stack, and
       below the counter *)
    TRY (SOLVED
          (REWRITE_TAC[(CONJUNCT1 o SPEC_ALL) DRESTRICT_DEF] THEN
           FIRST [SOLVED (REWRITE_TAC[INTER_SUBSET]);
                  SOLVED (MATCH_MP_TAC SUBSET_TRANS THEN
                          W(fun gl ->
                            let su = the_asm (fun c ->
                              hd_is "SUBSET" c &&
                              hd_is "FDOM" (lhand c)) gl in
                            EXISTS_TAC (lhand (concl su))) THEN
                          CONJ_TAC THEN
                          TRY (FIRST_ASSUM ACCEPT_TAC) THEN
                          REWRITE_TAC[INTER_SUBSET])])) THEN
    (* the blocks of the stack stay unique *)
    TRY (SOLVED
          (W(fun gl ->
             let bu = the_asm (hd_is "blocks_unique") gl in
             let sub = the_asm (fun c -> hd_is "SUBSET" c &&
                         hd_is "set_of_list" (lhand c)) gl in
             MATCH_ACCEPT_TAC (MATCH_MP blocks_unique_stack_permute
               (CONJ sub bu))))) THEN
    (* the values of the new stack are related to their roots, with
       the timestamps cut *)
    W(fun (asl,w as gl) ->
      if not (hd_is "ALL2" w) then ALL_TAC else
      (let ats = find_term (hd_is "all_ts") w in
       let vs = el 1 (snd (strip_comb w)) in
       let old = the_asm (fun c -> hd_is "ALL2" c) gl in
       let sub = the_asm (fun c ->
                   length (fst (strip_forall c)) = 1 &&
                   is_imp (snd (strip_forall c)) &&
                   hd_is "MEM" (lhand (snd (strip_forall c)))) gl in
       let perm = MATCH_MP EVERY2_stack_permute (CONJ sub old) in
       let v = genvar (hd (snd (dest_type (type_of vs)))) in
       SUBGOAL_THEN
         (mk_forall(v, mk_imp(list_mk_icomb "MEM" [v; vs],
            list_mk_icomb "IN"
              [v; list_mk_icomb "all_vs" [lhand ats; rand ats]])))
         (fun mem -> ACCEPT_TAC (MATCH_MP EVERY2_v_inv_restrict
            (CONJ mem perm))) THEN
       REPEAT STRIP_TAC THEN
       W(fun gl ->
         let mm = the_asm (hd_is "MEM") gl in
         let v1 = el 0 (snd (strip_comb (concl mm))) in
         MATCH_ACCEPT_TAC (MP (SPECL [v1; rand ats; lhand ats]
                                 MEM_stack_all_vs) mm)))) THEN
    (* and the invariant of each reference that the new stack
       reaches: the old stack reached it as well *)
    W(fun (asl,w) -> if not (is_forall w) then ALL_TAC else
      (REPEAT STRIP_TAC THEN
       W(fun (asl,w as gl) ->
         let rr = the_asm (hd_is "reachable_refs") gl in
         let sub = the_asm (fun c ->
                     length (fst (strip_forall c)) = 1 &&
                     is_imp (snd (strip_forall c)) &&
                     hd_is "MEM" (lhand (snd (strip_forall c)))) gl in
         let xs = el 1 (snd (strip_comb
                    (rand (snd (strip_forall (concl sub)))))) in
         let st = el 0 (snd (strip_comb (concl rr))) in
         let margs = snd (strip_comb (lhand st)) in
         let mem = MP (ISPECL [el 0 margs; el 1 margs; xs; rand st]
                         MEM_MAP_subset) sub in
         let old = list_mk_icomb "APPEND"
                     [list_mk_icomb "MAP" [el 0 margs; xs];
                      rand st] in
         SUBGOAL_THEN (list_mk_icomb "SUBSET"
                         [list_mk_icomb "set_of_list" [st];
                          list_mk_icomb "set_of_list" [old]])
           (fun ss -> ASSUME_TAC (MATCH_MP reachable_refs_stack_subset
              (CONJ rr ss))) THENL
          [REWRITE_TAC[SUBSET; IN_SET_OF_LIST] THEN ACCEPT_TAC mem;
           ALL_TAC]) THEN
       W(fun (asl,w as gl) ->
         let n = el 1 (snd (strip_comb w)) in
         let bri = the_asm (fun c ->
           let vs,bd = strip_forall c in
           length vs = 1 && is_imp bd &&
           hd_is "bc_ref_inv" (rand bd)) gl in
         let rr = the_asm (fun c -> hd_is "reachable_refs" c &&
           can (find_term (fun t -> is_var t &&
                  fst (dest_var t) = "xs")) c) gl in
         let nin = the_asm (fun c -> hd_is "IN" c &&
           hd_is "FDOM" (rand c) &&
           el 0 (snd (strip_comb c)) = n) gl in
         MATCH_ACCEPT_TAC (MATCH_MP bc_ref_inv_restrict
           (MP (SPEC n bri) (CONJ rr nin)))))))
### word_ml_inv_rearrange
  (* the steps are above the statement (tools/overrides.py).  The
     roots of the new stack are the ones that the old stack gave
     its pairs: the lookup of a pair in the association of the old
     stack with its roots finds it, and the invariant and the
     relation between the values and the roots then come from
     abs_ml_inv_rearrange and EVERY2_rearrange_roots *)
  (STRIP_TAC THEN
    REWRITE_TAC[word_ml_inv_def] THEN
    DISCH_THEN (CHOOSE_THEN STRIP_ASSUME_TAC) THEN
    (* the roots are as many as the pairs of the stack *)
    W(fun gl ->
      let e2 = the_asm (hd_is "ALL2") gl in
      ASSUME_TAC (REWRITE_RULE[LENGTH_MAP]
                    (MATCH_MP LIST_REL_LENGTH e2))) THEN
    (* and the root of a pair of the new stack is the one that the
       old stack gave it *)
    W(fun (asl,w as gl) ->
      let inv = the_asm (hd_is "abs_ml_inv") gl in
      let iargs = snd (strip_comb (concl inv)) in
      let xs = rand (el 1 iargs) in
      let hs = el 0 (tparts (el 3 iargs)) in
      let e2 = the_asm (hd_is "ALL2") gl in
      let le = the_asm (fun c -> is_eq c &&
                 hd_is "LENGTH" (lhand c)) gl in
      let sub = the_asm (fun c ->
                  length (fst (strip_forall c)) = 1 &&
                  is_imp (snd (strip_forall c)) &&
                  hd_is "MEM" (rand (snd (strip_forall c)))) gl in
      let ys = el 1 (snd (strip_comb
                 (lhand (snd (strip_forall (concl sub)))))) in
      let v = genvar (hd (snd (dest_type (type_of ys)))) in
      let g = mk_abs (v, list_mk_icomb "THE"
                [list_mk_icomb "ALOOKUP"
                   [list_mk_icomb "ZIP" [xs; hs]; v]]) in
      EXISTS_TAC (list_mk_icomb "MAP" [g; ys]) THEN
      CONJ_TAC THENL
       [MATCH_ACCEPT_TAC (MATCH_MP abs_ml_inv_rearrange
          (CONJ sub (CONJ le inv)));
        MATCH_ACCEPT_TAC (MATCH_MP EVERY2_rearrange_roots
          (CONJ sub (CONJ le e2)))]))
### get_real_addr_get_addr
(* the address of a pointer: the heap fits below the shift
   (LE_RDIV_EQ of the bound of the statement) and the pointer is
   inside the heap (heap_lookup_LESS), so no bit of it is as high
   as the shift, and the shift down of the address that get_addr
   built gives the pointer back -- the lower bits that get_addr
   put in are below the small shift and the shift down loses them
   (the local lemma, by the bits of the two sides).  The simple
   address shifts the pointer up by the word shift again, which is
   the multiplication by bytes_in_word
   (bytes_in_word_mul_eq_shift), and get_real_addr does the same
   in the two cases where the shift it uses leaves the word shift;
   where the shift is the word shift itself the address is the
   pointer and the one bit that get_addr adds (or_1,
   WORD_ADD_OR), which the subtraction of the one takes off *)
  ((let hd_is n t =
     (try fst(dest_const(fst(strip_comb t))) = n
      with Failure _ -> false) in
  let grab asl p =
    tryfind (fun (_,th) ->
      if (try p th with Failure _ -> false) then th else fail())
      asl in
  (* a word that is not shifted *)
  let shl0 = prove
   (`!(x:'a word). x << 0 = x`,
    GEN_TAC THEN
    REWRITE_TAC[WORD_EQ_BITS_ALT; BIT_WORD_SHL; SUB_0; LE_0] THEN
    X_GEN_TAC `i:num` THEN DISCH_TAC THEN ASM_REWRITE_TAC[]) in
  let divlt = prove
   (`!m n. m < n ==> m DIV n = 0`,
    REPEAT GEN_TAC THEN DISCH_TAC THEN
    SUBGOAL_THEN `~(n = 0)` (fun nz ->
      REWRITE_TAC[MP (SPECL [`m:num`; `n:num`] DIV_EQ_0) nz]) THENL
     [ASM_ARITH_TAC; FIRST_ASSUM ACCEPT_TAC]) in
  (* a pointer that fits below the shift has no bit that high *)
  let ptbits = prove
   (`!n s. n * 2 EXP s < dimword (:'a)
           ==> !i. word_bit i ((n2w n):'a word)
                   ==> i + s < dimindex (:'a)`,
    REPEAT GEN_TAC THEN DISCH_TAC THEN
    X_GEN_TAC `i:num` THEN REWRITE_TAC[BIT_WORD] THEN STRIP_TAC THEN
    SUBGOAL_THEN `2 EXP i <= n` ASSUME_TAC THENL
     [REWRITE_TAC[GSYM NOT_LT] THEN DISCH_TAC THEN
      FIRST_X_ASSUM (fun odd ->
        if not (hd_is "ODD" (concl odd)) then fail() else
        MP_TAC odd) THEN
      ASM_SIMP_TAC[divlt; ODD];
      ALL_TAC] THEN
    SUBGOAL_THEN `2 EXP (i + s) <= n * 2 EXP s` MP_TAC THENL
     [REWRITE_TAC[EXP_ADD] THEN ASM_SIMP_TAC[LE_MULT_RCANCEL];
      ALL_TAC] THEN
    MP_TAC (SPECL [`2`; `dimindex (:'a)`; `i + s`] LE_EXP) THEN
    CONV_TAC NUM_REDUCE_CONV THEN
    MP_TAC (ASSUME `n * 2 EXP s < dimword (:'a)`) THEN
    REWRITE_TAC[dimword] THEN ARITH_TAC) in
  (* and the lower bits of a pointer are below the small shift *)
  let lowbits = prove
   (`!i x. word_bit i (get_lowerbits c x)
           ==> i < small_shift_length c`,
    REPEAT GEN_TAC THEN CASES_ON_NAME "x" THEN
    REWRITE_TAC[get_lowerbits_def] THEN
    TRY SAFE_MATCH_REDUCE_TAC THEN
    REWRITE_TAC[BIT_WORD_OR; BIT_WORD_1; word_bits;
                BIT_WORD_SUBWORD; small_shift_length_def] THEN
    STRIP_TAC THEN ASM_ARITH_TAC) in
  (* so the shift down of a pointer that was shifted up leaves the
     pointer shifted up by what is left: the lower bits vanish and
     the bits of the pointer are low enough that the shift up kept
     them *)
  let l1 = prove
   (`!n (lw:'a word) k t.
       (!i. word_bit i lw ==> i < t) /\
       (!i. word_bit i ((n2w n):'a word)
            ==> i + (k + t) < dimindex (:'a))
       ==> ((n2w n) << (k + t) || lw) >>> t =
           ((n2w n):'a word) << k`,
    REPEAT GEN_TAC THEN
    DISCH_THEN (CONJUNCTS_THEN2 (LABEL_TAC "lw")
      (LABEL_TAC "pt")) THEN
    REWRITE_TAC[WORD_EQ_BITS_ALT] THEN
    X_GEN_TAC `i:num` THEN DISCH_TAC THEN
    REWRITE_TAC[BIT_WORD_USHR; BIT_WORD_OR; BIT_WORD_SHL] THEN
    SUBGOAL_THEN `~(word_bit (i + t) (lw:'a word))`
      (fun th -> REWRITE_TAC[th]) THENL
     [USE_THEN "lw" (fun h1 -> MP_TAC (SPEC `i + t` h1)) THEN
      MATCH_MP_TAC (TAUT `~q ==> (p ==> q) ==> ~p`) THEN ARITH_TAC;
      ALL_TAC] THEN
    REWRITE_TAC[ARITH_RULE `(i + t) - (k + t) = i - k`;
                ARITH_RULE `(k + t <= i + t) <=> k <= i`] THEN
    ASM_CASES_TAC `word_bit (i - k) ((n2w n):'a word)` THEN
    ASM_REWRITE_TAC[] THEN
    USE_THEN "pt" (fun h2 ->
      MP_TAC (MP (SPEC `i - k` h2)
        (ASSUME `word_bit (i - k) ((n2w n):'a word)`))) THEN
    MP_TAC (ASSUME `i < dimindex (:'a)`) THEN ARITH_TAC) in
  (* the address that the shift down and up gives *)
  let shift_step kk extra =
    W(fun (asl,gl) ->
      let ushr = find_term (hd_is "word_ushr") gl in
      let x = lhand ushr and tt = rand ushr in
      let shl = lhand x and lw = rand x in
      let s = rand shl in
      let nn = rand (lhand shl) in
      let ptf = grab asl (fun th ->
        try is_forall (concl th) &&
            hd_is "bit" (lhand (body (rand (concl th))))
        with Failure _ -> false) in
      let mkp tm tac =
        if extra = [] then prove (tm, tac) else
        MP (prove (mk_imp (end_itlist (curry mk_conj)
                             (map concl extra), tm),
             DISCH_THEN (REPEAT_TCL CONJUNCTS_THEN ASSUME_TAC) THEN
             tac))
           (end_itlist CONJ extra) in
      let lwf = mkp (mk_forall (`i:num`,
                  mk_imp (list_mk_icomb "bit" [`i:num`; lw],
                    mk_binop `(<):num->num->bool` `i:num` tt)))
                  (GEN_TAC THEN
                   DISCH_THEN (fun b ->
                     MP_TAC (MATCH_MP lowbits b)) THEN
                   REWRITE_TAC[small_shift_length_def;
                               shift_length_def] THEN
                   ASM_ARITH_TAC) in
      let seq = mkp (mk_eq (mk_binop `(+):num->num->num` kk tt, s))
                  (REWRITE_TAC[shift_length_def] THEN
                   ASM_ARITH_TAC) in
      let inst = REWRITE_RULE[seq] (SPECL [nn; lw; kk; tt] l1) in
      REWRITE_TAC[MP inst (CONJ lwf ptf); shl0]) in
  (* and the address that the word shift of a pointer is *)
  let fin =
    W(fun (asl,gl) ->
      let gd = grab asl (fun th ->
        hd_is "good_dimindex" (concl th)) in
      REWRITE_TAC[GSYM (MATCH_MP bytes_in_word_mul_eq_shift gd)] THEN
      CONV_TAC WORD_RULE) in
  STRIP_TAC THEN
  (* the pointer is inside the heap, which fits below the shift *)
  SUBGOAL_THEN `n * 2 EXP shift_length c < dimword (:'a)`
    ASSUME_TAC THENL
   [W(fun (asl,gl) ->
      let hl = grab asl (fun th ->
        try hd_is "<=" (concl th) &&
            hd_is "heap_length" (lhand (concl th))
        with Failure _ -> false) in
      let lk = grab asl (fun th ->
        try hd_is "heap_lookup" (lhs (concl th))
        with Failure _ -> false) in
      let tp = rand (rand (concl hl)) in
      let hh = lhand (concl hl) in
      let nz = prove (mk_neg (mk_eq (tp, `0`)),
                REWRITE_TAC[EXP_EQ_0] THEN ARITH_TAC) in
      let hl2 = REWRITE_RULE[MP (SPECL [tp; `dimword (:'a)`; hh]
                                  LE_RDIV_EQ) nz] hl in
      let lt = MATCH_MP heap_lookup_LESS lk in
      let mono = EQ_MP (SYM (SPECL [`n:num`; hh; tp]
                          LT_MULT_RCANCEL)) (CONJ lt nz) in
      MP_TAC hl2 THEN MP_TAC mono THEN
      REWRITE_TAC[MULT_SYM] THEN ARITH_TAC);
    ALL_TAC] THEN
  (* so no bit of it is as high as the shift *)
  SUBGOAL_THEN
    `!i. word_bit i ((n2w n):'a word)
         ==> i + shift_length c < dimindex (:'a)` ASSUME_TAC THENL
   [FIRST_ASSUM (fun th ->
      if not (try hd_is "<" (concl th) &&
                  hd_is "dimword" (rand (concl th))
              with Failure _ -> false) then fail() else
      ACCEPT_TAC (MATCH_MP ptbits th));
    ALL_TAC] THEN
  (* the two addresses that the store of the heap gives *)
  W(fun (asl,gl) ->
    let flk = grab asl (fun th ->
      try hd_is "FLOOKUP" (lhs (concl th))
      with Failure _ -> false) in
    REWRITE_TAC[get_real_simple_addr_def; get_real_addr_def;
                flk]) THEN
  TRY SAFE_MATCH_REDUCE_TAC THEN
  CONV_TAC (TOP_DEPTH_CONV let_CONV) THEN
  REWRITE_TAC[get_addr_def; injectivity "option"] THEN
  CONJ_TAC THENL
   [(* the simple address: the shift down gives the pointer and
        the shift up the bytes it stands for *)
    shift_step `0` [] THEN fin;
    ALL_TAC] THEN
  COND_CASES_TAC THEN
  TRY (REWRITE_TAC[injectivity "option"]) THENL
   [(* the pointer is the address and the one bit, which the
        subtraction takes off *)
    W(fun (asl,gl) ->
      let cnd = grab asl (fun th ->
        try is_conj (concl th) &&
            hd_is "backend_common_word_shift" (lhs (lhand (concl th)))
        with Failure _ -> false) in
      let cs = CONJUNCTS cnd in
      let lb = MP (prove (mk_imp (mk_conj (concl (el 1 cs),
                                           concl (el 2 cs)),
                    `get_lowerbits c w = ((n2w 1):'a word)`),
                    CASES_ON_NAME "w" THEN
                    REWRITE_TAC[get_lowerbits_def] THEN
                    TRY SAFE_MATCH_REDUCE_TAC THEN
                    STRIP_TAC THEN
                    ASM_REWRITE_TAC[small_shift_length_def] THEN
                    CONV_TAC NUM_REDUCE_CONV THEN
                    REWRITE_TAC[or_1]))
                (CONJ (el 1 cs) (el 2 cs)) in
      let dis = prove
                 (`((n2w n) << shift_length c) && (n2w 1) =
                   ((n2w 0):'a word)`,
                  MP_TAC (prove (`1 <= shift_length c`,
                    REWRITE_TAC[shift_length_def] THEN
                    ARITH_TAC)) THEN
                  REWRITE_TAC[WORD_EQ_BITS_ALT; BIT_WORD_AND;
                              BIT_WORD_1; BIT_WORD_0;
                              BIT_WORD_SHL] THEN
                  REPEAT STRIP_TAC THEN ASM_ARITH_TAC) in
      REWRITE_TAC[lb] THEN
      REWRITE_TAC[GSYM (MATCH_MP WORD_ADD_OR dis)] THEN
      REWRITE_TAC[GSYM (el 0 cs)]) THEN
    fin;
    ALL_TAC] THEN
  COND_CASES_TAC THEN
  TRY (REWRITE_TAC[injectivity "option"]) THENL
   [(* the shift down is the one that leaves the word shift *)
    W(fun (asl,gl) ->
      let cnd = grab asl (fun th ->
        try hd_is "<=" (concl th) &&
            hd_is "backend_common_word_shift" (lhand (concl th))
        with Failure _ -> false) in
      shift_step (lhand (concl cnd)) [cnd]) THEN
    fin;
    (* and above the word shift the two shifts are the simple
       address again *)
    shift_step `0` [] THEN fin]))
### gc_kind_update_Ref
  (* the steps are above the statement (tools/overrides.py).  The
     element written is a reference of the length of the one it
     replaces, so it is at or above the pointer (heap_lookup_at and
     heap_lookup_heap_split put it in the half that holds the
     references), and the halves of the split and the state of the
     generations are then the ones they were *)
    (* the element and what follows it, as an append of three *)
  (REWRITE_TAC[gc_kind_inv_def; APPEND_SINGLE] THEN
    STRIP_TAC THEN
    RULE_ASSUM_TRY (REWRITE_RULE[APPEND_SINGLE]) THEN
    W(fun (asl,w) ->
      CASES_ON_TAC (find_term
        (hd_is "data_to_word_config_gc_kind") w)) THEN
    RULE_ASSUM_TRY (CONV_RULE(TOP_DEPTH_CONV MATCH_CONV)) THEN
    MATCH_REDUCE_TAC THEN
    TRY (SOLVED (FIRST_ASSUM ACCEPT_TAC)) THEN
    SPLIT_ASM_TAC THEN
    REPEAT (FIRST_X_ASSUM (fun th ->
      if is_exists (concl th) then CHOOSE_TAC th else fail())) THEN
    SPLIT_ASM_TAC THEN
    (* the element is at or above the pointer, because the first half
       of the split holds no reference and this element is one *)
    W(fun (asl,w as gl) ->
      let hs = the_asm (fun c -> is_eq c &&
                 hd_is "heap_split" (lhand c)) gl in
      let args = snd (strip_comb (lhand (concl hs))) in
      let k = el 0 args in
      let hp = el 1 args in
      let lk = ISPECL [lhand hp; lhand (lhand (rand hp));
                       rand (rand hp)] heap_lookup_at in
      SUBGOAL_THEN (mk_neg (list_mk_icomb "<"
                      [list_mk_icomb "heap_length" [lhand hp]; k]))
        ASSUME_TAC THENL
       [MP_TAC (MATCH_MP heap_lookup_heap_split (CONJ hs lk)) THEN
        COND_CASES_TAC THENL
         [DISCH_TAC THEN
          W(fun gl ->
            let ev = the_asm (fun c -> hd_is "ALL" c &&
                       is_abs (el 0 (snd (strip_comb c)))) gl in
            let m = the_asm (hd_is "MEM") gl in
            MP_TAC (MATCH_MP (REWRITE_RULE[GSYM ALL_MEM] ev) m)) THEN
          CONV_TAC(TOP_DEPTH_CONV BETA_CONV) THEN
          REWRITE_TAC[isRef_RefTag];
          DISCH_THEN (K ALL_TAC) THEN ASM_REWRITE_TAC[]];
        ALL_TAC]) THEN
    (* the two elements are of one length *)
    W(fun (asl,w as gl) ->
      let hs = the_asm (fun c -> is_eq c &&
                 hd_is "heap_split" (lhand c)) gl in
      let hp = el 1 (snd (strip_comb (lhand (concl hs)))) in
      let u = lhand (lhand (rand hp)) in
      let uargs = snd (strip_comb u) in
      let vt = find_term (fun t -> hd_is "DataElement" t &&
                 not (t = u)) w in
      ASSUME_TAC (ISPECL [el 0 uargs; el 0 (snd (strip_comb vt));
                          el 1 uargs; el 2 uargs]
                    el_length_DataElement)) THEN
    CONJ_TAC THENL
     [(* the state of the generations (gen_state_ok_replace) *)
      W(fun (asl,w as gl) ->
        let gs = the_asm (hd_is "gen_state_ok") gl in
        let le = the_asm (fun c -> is_eq c &&
                   hd_is "el_length" (lhand c)) gl in
        let nlt = the_asm (fun c -> is_neg c && hd_is "<" (rand c) &&
                    hd_is "heap_length" (lhand (rand c))) gl in
        let a = el 0 (snd (strip_comb (concl gs))) in
        let hl = lhand (rand (concl nlt)) in
        SUBGOAL_THEN (mk_neg (list_mk_icomb "<" [hl; a]))
          (fun n2 -> MATCH_ACCEPT_TAC (MATCH_MP gen_state_ok_replace
             (CONJ gs (CONJ le n2)))) THEN
        MP_TAC nlt THEN ARITH_TAC);
      (* and the halves of the split: the first is the one it was and
         the second has the element written in it, which is a
         reference as the one it replaces was *)
      W(fun (asl,w as gl) ->
        let hs = the_asm (fun c -> is_eq c &&
                   hd_is "heap_split" (lhand c)) gl in
        let le = the_asm (fun c -> is_eq c &&
                   hd_is "el_length" (lhand c)) gl in
        let nlt = the_asm (fun c -> is_neg c && hd_is "<" (rand c) &&
                    hd_is "heap_length" (lhand (rand c))) gl in
        STRIP_ASSUME_TAC (MATCH_MP heap_split_replace3
          (CONJ hs (CONJ le nlt)))) THEN
      W(fun (asl,w as gl) ->
        let vt = find_term (fun t -> hd_is "DataElement" t &&
                   not (can (find_term (fun s -> is_var s &&
                          fst (dest_var s) = "y")) t)) w in
        let hs2 = the_asm (fun c -> is_eq c &&
                    hd_is "heap_split" (lhand c) &&
                    can (find_term (fun t -> t = vt)) (lhand c)) gl in
        let pr = rand (rand (concl hs2)) in
        EXISTS_TAC (lhand pr) THEN EXISTS_TAC (rand pr)) THEN
      REPEAT CONJ_TAC THEN
      TRY (SOLVED (FIRST_ASSUM ACCEPT_TAC)) THEN
      REWRITE_TAC[GSYM ALL_MEM] THEN
      REPEAT STRIP_TAC THEN
      W(fun gl ->
        let bd = the_asm (fun c ->
                   length (fst (strip_forall c)) = 1 &&
                   is_imp (snd (strip_forall c)) &&
                   is_disj (rand (snd (strip_forall c)))) gl in
        let m = the_asm (hd_is "MEM") gl in
        STRIP_ASSUME_TAC (MATCH_MP (SPEC_ALL bd) m)) THEN
      TRY (SOLVED
            (W(fun gl ->
               let ev = the_asm (fun c -> hd_is "ALL" c &&
                          not (is_abs
                                 (el 0 (snd (strip_comb c))))) gl in
               let m = the_asm (fun c -> hd_is "MEM" c) gl in
               ACCEPT_TAC (MATCH_MP (REWRITE_RULE[GSYM ALL_MEM] ev)
                 m)))) THEN
      ASM_REWRITE_TAC[isRef_RefTag]])
### memory_rel_Update'
(* the same write as memory_rel_Update, of which this is the
   statement with the offset of the index in place of the Number
   root that holds it: so the proof is that one without the step
   that reads the index off a root (no small integer, no
   get_real_offset_thm), and the cell of the write is the one that
   the split of the payload at the index puts in front *)
  ((let hd_is n t =
     (try fst(dest_const(fst(strip_comb t))) = n
      with Failure _ -> false) in
   let rec facs t =
     if hd_is "STAR" t then
       let args = snd(strip_comb t) in
       facs (el 0 args) @ facs (el 1 args)
     else [t] in
   let rec remove1 t = function
       [] -> []
     | h :: rest -> if h = t then rest else h :: remove1 t rest in
   let grab asl p =
     tryfind (fun (_,th) ->
       if (try p th with Failure _ -> false) then th else fail())
       asl in
   let is_hl th = hd_is "heap_lookup" (lhs (concl th)) in
   let swapmul a =
     let args = snd(strip_comb (rand a)) in
     let mul = fst(strip_comb (rand a)) in
     mk_comb(rator a, mk_comb(mk_comb(mul,el 1 args),el 0 args)) in
   let sepfront names =
     W(fun (asl,w) ->
       let pred = rator (lhand w) in
       let fs = facs pred in
       let picked = map (fun n -> find (hd_is n) fs) names in
       let rest = filter (fun t -> not (mem t picked)) fs in
       let st = fst(strip_comb pred) in
       let mk a b = mk_comb(mk_comb(st,a),b) in
       let target = itlist mk picked (end_itlist mk rest) in
       SUBGOAL_THEN (mk_eq(pred,target)) SUBST1_TAC THENL
        [REWRITE_TAC[STAR_AC]; ALL_TAC]) in
   let killthunk =
     TRY(FIRST_ASSUM(fun t1 -> FIRST_ASSUM(fun t2 ->
       CONTR_TAC(REWRITE_RULE[injectivity "option";
                              distinctness "bvlSem_ref"]
                   (TRANS (SYM t1) t2))))) in
   let refinv ptr root =
     FIRST_X_ASSUM(fun th ->
       if is_forall (concl th) &&
          hd_is "bc_ref_inv" (rand (snd(strip_forall(concl th))))
       then MP_TAC(SPEC ptr th) else fail()) THEN
     ANTS_TAC THENL
      [CONJ_TAC THENL
        [REWRITE_TAC[reachable_refs_def; MEM] THEN
         EXISTS_TAC root THEN EXISTS_TAC ptr THEN
         REWRITE_TAC[get_refs_def; MEM;
                     CONJUNCT1(SPEC_ALL RTC_RULES)];
         ASM_REWRITE_TAC[]];
       ALL_TAC] THEN
     REWRITE_TAC[bc_ref_inv_def] THEN
     ASM_SIMP_TAC[FLOOKUP_DEF] THEN
     MATCH_REDUCE_TAC in
   let all2cons = prove
    (`!P h t (l:(A)list).
        ALL2 P l (CONS (h:B) t) <=>
        ?a b. l = CONS a b /\ P a h /\ ALL2 P b t`,
     REPEAT GEN_TAC THEN
     STRUCT_CASES_TAC(ISPEC `l:(A)list` list_CASES) THEN
     REWRITE_TAC[ALL2; NOT_CONS_NIL; CONS_11] THEN MESON_TAC[]) in
   let addreq = WORD_RULE
     `!(a:(N)word) i.
        (a + bytes_in_word) + n2w i * bytes_in_word =
        a + bytes_in_word + bytes_in_word * n2w i` in
   (* the address of the heap element, without the existential of
      the goal: this proof fills the existentials at the end *)
   let realaddr_noex =
     W(fun (asl,w) ->
       let hl = grab asl is_hl in
       let hlen = grab asl (fun th ->
         hd_is "heap_length" (lhand (concl th))) in
       let cu = grab asl (fun th ->
         hd_is "FLOOKUP" (lhs (concl th)) &&
         fst(dest_const(rand(lhs(concl th)))) = "CurrHeap") in
       let gd = grab asl (fun th ->
         hd_is "good_dimindex" (concl th)) in
       let gat = tryfind (fun t ->
         find_term (fun u ->
           hd_is "get_addr" u && length (snd(strip_comb u)) = 3) t)
         (w :: map (fun (_,th) -> concl th) asl) in
       let mm = MATCH_MP get_real_addr_get_addr
                  (CONJ hlen (CONJ hl (CONJ cu gd))) in
       let wv = find (fun v -> fst(dest_var v) = "w")
                  (frees (concl mm)) in
       let th = SPEC (last (snd(strip_comb gat))) (GEN wv mm) in
       let a = rand (rhs (concl (CONJUNCT1 th))) in
       STRIP_ASSUME_TAC(REWRITE_RULE[WORD_RULE (mk_eq(a,swapmul a))]
                          th)) in
  DISCH_THEN(REPEAT_TCL CONJUNCTS_THEN ASSUME_TAC) THEN
   SUBGOAL_THEN `~(vals:(dataSem_v)list = [])` ASSUME_TAC THENL
    [DISCH_TAC THEN VAR_EQ_TAC THEN
     FIRST_X_ASSUM(fun th ->
       if (try hd_is "<" (concl th) with Failure _ -> false)
       then MP_TAC(REWRITE_RULE[LENGTH; LT] th) else fail()) THEN
     REWRITE_TAC[];
     ALL_TAC] THEN
   FIRST_ASSUM(fun mr ->
     if hd_is "memory_rel" (concl mr)
     then MP_TAC(REWRITE_RULE[memory_rel_def;
                              word_ml_inv_def; MAP; FST] mr)
     else fail()) THEN
   DISCH_THEN STRIP_ASSUME_TAC THEN
   FIRST_X_ASSUM(fun a2 ->
     if hd_is "ALL2" (concl a2)
     then MP_TAC(REWRITE_RULE[MAP; all2cons] a2) else fail()) THEN
   DISCH_THEN STRIP_ASSUME_TAC THEN
   VAR_EQ_TAC THEN
   FIRST_ASSUM(fun am ->
     if hd_is "abs_ml_inv" (concl am)
     then MP_TAC(REWRITE_RULE[abs_ml_inv_def;
                              bc_stack_ref_inv_def] am)
     else fail()) THEN
   DISCH_THEN STRIP_ASSUME_TAC THEN
   FIRST_X_ASSUM(fun a2 ->
     if hd_is "ALL2" (concl a2) &&
        can (find_term (hd_is "v_inv")) (concl a2)
     then MP_TAC(REWRITE_RULE[ALL2; NOT_CONS_NIL; HD; TL] a2)
     else fail()) THEN
   DISCH_THEN STRIP_ASSUME_TAC THEN
   FIRST_X_ASSUM(fun vi ->
     if hd_is "v_inv" (concl vi) &&
        hd_is "dataSem_RefPtr" (el 1 (snd(strip_comb (concl vi))))
     then MP_TAC(REWRITE_RULE[v_inv_def] vi)
     else fail()) THEN
   DISCH_THEN STRIP_ASSUME_TAC THEN
   killthunk THEN
   FIRST_X_ASSUM(fun e ->
     if is_eq (concl e) && is_var (lhs (concl e)) &&
        hd_is "gc_shared_Pointer" (rhs (concl e))
     then SUBST_ALL_TAC e else fail()) THEN
   RULE_ASSUM_TAC(REWRITE_RULE(word_addr_clauses ())) THEN
   REWRITE_TAC(word_addr_clauses ()) THEN
   refinv `nn:num` `RefPtr bl nn:dataSem_v` THEN
   ASM_REWRITE_TAC[] THEN
   CONV_TAC(TOP_DEPTH_CONV let_CONV) THEN
   DISCH_THEN STRIP_ASSUME_TAC THEN
   FIRST_ASSUM(fun th ->
     if hd_is "heap_in_memory_store" (concl th)
     then MP_TAC(REWRITE_RULE[heap_in_memory_store_def] th)
     else fail()) THEN
   DISCH_THEN STRIP_ASSUME_TAC THEN
   realaddr_noex THEN
   FIRST_ASSUM(fun lr ->
     if hd_is "ALL2" (concl lr) &&
        can (find_term (hd_is "v_inv")) (concl lr)
     then ASSUME_TAC(MATCH_MP LIST_REL_LENGTH lr) else fail()) THEN
   W(fun (asl,w) ->
     let lt = grab asl (fun th ->
       hd_is "<" (concl th) && hd_is "LENGTH" (rand (concl th))) in
     let le = grab asl (fun th ->
       hd_is "=" (concl th) && hd_is "LENGTH" (lhs (concl th)) &&
       hd_is "LENGTH" (rhs (concl th))) in
     MP_TAC(MATCH_MP LESS_LENGTH
              (REWRITE_RULE[GSYM le] lt))) THEN
   DISCH_THEN STRIP_ASSUME_TAC THEN
   VAR_EQ_TAC THEN
   W(fun (asl,w) ->
     MP_TAC(MATCH_MP heap_lookup_SPLIT
              (grab asl is_hl))) THEN
   DISCH_THEN STRIP_ASSUME_TAC THEN
   VAR_EQ_TAC THEN
   TRY(FIRST_X_ASSUM(fun th ->
     if (try hd_is "fmap_apply" (lhs (concl th))
         with Failure _ -> false)
     then SUBST_ALL_TAC th else fail())) THEN
   FIRST_X_ASSUM(fun th ->
     if (try hd_is "STAR" (rator (concl th)) with Failure _ -> false)
     then MP_TAC th else fail()) THEN
   REWRITE_TAC[word_heap_APPEND; word_heap_def;
               RefBlock_def] THEN
   CONV_TAC(TOP_DEPTH_CONV let_CONV) THEN
   REWRITE_TAC[word_el_def] THEN
   CONV_TAC(TOP_DEPTH_CONV let_CONV) THEN
   REWRITE_TAC[word_payload_def] THEN
   CONV_TAC(TOP_DEPTH_CONV let_CONV) THEN
   REWRITE_TAC[MAP_APPEND; MAP; word_list_APPEND;
               word_list_def; LENGTH_MAP] THEN
   ASM_REWRITE_TAC[addreq] THEN
   (* the condition of the payload bounds the length of the block *)
   REPEAT(sepfront ["cond"] THEN REWRITE_TAC[cond_STAR] THEN
          DISCH_THEN(CONJUNCTS_THEN2 STRIP_ASSUME_TAC MP_TAC)) THEN
   W(fun (asl,w) ->
     let ga = grab asl (fun th ->
       hd_is "get_real_addr" (lhs (concl th))) in
     let base = rand (rhs (concl ga)) in
     let pred = rator (lhand w) in
     let fs = facs pred in
     let one = find (fun t ->
       hd_is "set_sep_one" t &&
       not (fst(dest_pair (rand t)) = base)) fs in
     let rest = remove1 one fs in
     let st = fst(strip_comb pred) in
     let mk a b = mk_comb(mk_comb(st,a),b) in
     SUBGOAL_THEN (mk_eq(pred, mk one (end_itlist mk rest)))
       SUBST1_TAC THENL [REWRITE_TAC[STAR_AC]; ALL_TAC]) THEN
   DISCH_THEN(fun sep ->
     STRIP_ASSUME_TAC(MATCH_MP read_fun2set sep) THEN
     ASSUME_TAC sep) THEN
   ASM_REWRITE_TAC[] THEN
   RULE_ASSUM_TAC(REWRITE_RULE(word_addr_clauses ())) THEN
   REWRITE_TAC(word_addr_clauses ()) THEN
   (* the invariant with the value stored in the reference *)
   W(fun (asl,gl) ->
     let am = grab asl (fun th -> hd_is "abs_ml_inv" (concl th)) in
     let stk = el 1 (snd(strip_comb (concl am))) in
     let hv = lhand stk in
     let xsv = find (fun v -> fst(dest_var v) = "xs")
                 (frees (concl update_ref_thm1)) in
     let urt = REWRITE_RULE[LENGTH_EQ_1]
                 (CONV_RULE NUM_REDUCE_CONV
                   (REWRITE_RULE[APPEND; HD; LENGTH]
                     (INST [mk_list([hv],type_of hv),xsv]
                       update_ref_thm1))) in
     let lk = grab asl (fun th ->
       hd_is "sptree_lookup" (lhs (concl th))) in
     let lt = grab asl (fun th ->
       hd_is "<" (concl th) && hd_is "LENGTH" (rand (concl th))) in
     MP_TAC(MATCH_MP urt (CONJ am (CONJ lk lt)))) THEN
   DISCH_THEN STRIP_ASSUME_TAC THEN
   (* the existentials: the root of the pointer and the address *)
   W(fun (asl,w) ->
     let cs = conjuncts (snd(strip_exists w)) in
     let ga = grab asl (fun th ->
       hd_is "get_real_addr" (lhs (concl th))) in
     EXISTS_TAC (rand (lhs (el 0 cs))) THEN
     EXISTS_TAC (rand (rhs (concl ga))) THEN
     ASM_REWRITE_TAC[]) THEN
   (* the root of the value, and the pointer of the store is the
      address of the element *)
   REPEAT (FIRST_X_ASSUM (fun e ->
     if not (try is_eq (concl e) && is_var (lhs (concl e)) &&
                 hd_is "CONS" (rhs (concl e))
             with Failure _ -> false) then fail() else
     SUBST_ALL_TAC e)) THEN
   RULE_ASSUM_TRY (REWRITE_RULE[APPEND; HD]) THEN
   FIRST_X_ASSUM (fun e ->
     if not (try is_eq (concl e) && hd_is "CONS" (lhs (concl e)) &&
                 hd_is "CONS" (rhs (concl e)) &&
                 can (find_term (hd_is "gc_shared_Pointer"))
                   (rhs (concl e))
             with Failure _ -> false) then fail() else
     STRIP_ASSUME_TAC (REWRITE_RULE[CONS_11;
       injectivity "heap_address"] e)) THEN
   REPEAT (FIRST_X_ASSUM (fun e ->
     if not (try is_eq (concl e) && is_var (lhs (concl e)) &&
                 is_var (rhs (concl e)) &&
                 not (lhs (concl e) = rhs (concl e))
             with Failure _ -> false) then fail() else
     SUBST_ALL_TAC e)) THEN
   FIRST_X_ASSUM (fun e ->
     if not (try is_eq (concl e) && is_var (rhs (concl e)) &&
                 hd_is "heap_length" (lhs (concl e))
             with Failure _ -> false) then fail() else
     SUBST_ALL_TAC (SYM e)) THEN
   (* the payload of the element is the list that the index split *)
   W(fun (asl,gl) ->
     let hd0 = grab asl (fun th ->
       hd_is "heap_deref" (lhs (concl th))) in
     let hl = grab asl is_hl in
     MP_TAC (REWRITE_RULE[heap_deref_def; hl; RefBlock_def] hd0)) THEN
   MATCH_REDUCE_TAC THEN
   REWRITE_TAC[injectivity "option"] THEN
   DISCH_THEN (SUBST_ALL_TAC o SYM) THEN
   (* the new heap is the old one with the element written *)
   W(fun (asl,gl) ->
     let hs = grab asl (fun th ->
       hd_is "heap_store" (lhs (concl th))) in
     let args = snd(strip_comb (lhs (concl hs))) in
     let xs = rand (lhand (el 1 args)) in
     let ys = rand (lhand (rand (el 2 args))) in
     let hap = lhand (el 2 args) in
     let lenth = prove (mk_eq (mk_icomb (`LENGTH`,xs),
                               mk_icomb (`LENGTH`,ys)),
                  REWRITE_TAC[LENGTH_LUPDATE]) in
     let inst = MATCH_MP (ISPEC hap heap_store_RefBlock_thm)
                  lenth in
     SUBST_ALL_TAC (SYM (REWRITE_RULE[PAIR_EQ]
       (REWRITE_RULE[inst] hs)))) THEN
   RULE_ASSUM_TRY (REWRITE_RULE[LUPDATE_LENGTH]) THEN
   (* the invariant of the new heap *)
   REWRITE_TAC[memory_rel_def] THEN
   W(fun (asl,gl) ->
     let hm = grab asl (fun th ->
       hd_is "heap_in_memory_store" (concl th)) in
     let args = snd(strip_comb (concl hm)) in
     let ai = grab asl (fun th ->
       hd_is "abs_ml_inv" (concl th) &&
       (try hd_is "sptree_insert"
              (el 2 (snd(strip_comb (concl th))))
        with Failure _ -> false)) in
     let nh = el 1 (tparts (el 3 (snd(strip_comb (concl ai))))) in
     EXISTS_TAC nh THEN EXISTS_TAC (el 9 args) THEN
     EXISTS_TAC (el 1 args) THEN EXISTS_TAC (el 2 args) THEN
     EXISTS_TAC (el 3 args) THEN EXISTS_TAC (el 4 args)) THEN
   REPEAT CONJ_TAC THENL
    [ALL_TAC;
     (* the roots of the invariant, with the root of the value *)
     REWRITE_TAC[word_ml_inv_def] THEN
     W(fun (asl,gl) ->
       let ai = grab asl (fun th ->
         hd_is "abs_ml_inv" (concl th) &&
         (try hd_is "sptree_insert"
                (el 2 (snd(strip_comb (concl th))))
          with Failure _ -> false)) in
       EXISTS_TAC
         (el 0 (tparts (el 3 (snd(strip_comb (concl ai))))))) THEN
     REWRITE_TAC[MAP; FST; SND; ALL2; HD; TL; NOT_CONS_NIL] THEN
     CONV_TAC(TOP_DEPTH_CONV BETA_CONV) THEN
     REWRITE_TAC(word_addr_clauses ()) THEN
     (* the annotation of the pointer is the one of the array *)
     TRY (FIRST_ASSUM (fun an ->
       if not (try hd_is "ref_ptr_annot" (lhs (concl an))
               with Failure _ -> false) then fail() else
       FIRST_ASSUM (fun lk ->
         if not (try hd_is "sptree_lookup" (lhs (concl lk))
                 with Failure _ -> false) then fail() else
         REWRITE_TAC[REWRITE_RULE[lk] an]))) THEN
     ASM_REWRITE_TAC[] THEN
     REPEAT CONJ_TAC THEN TRY (FIRST_ASSUM ACCEPT_TAC);
     FIRST_ASSUM ACCEPT_TAC;
     FIRST_ASSUM ACCEPT_TAC] THEN
   (* the store, whose memory is the one written *)
   REWRITE_TAC[heap_in_memory_store_def] THEN
   W(fun (asl,gl) ->
     let nh = rand (find_term (fun t ->
       hd_is "heap_length" t && hd_is "APPEND" (rand t)) gl) in
     let oh = rand (lhs (concl (grab asl is_hl))) in
     if nh = oh then ALL_TAC else
     SUBGOAL_THEN (mk_eq (mk_icomb (`heap_length`,nh),
                          mk_icomb (`heap_length`,oh)))
       (fun le -> REWRITE_TAC[le]) THENL
      [REWRITE_TAC[heap_length_APPEND; heap_length_CONS;
                   heap_length_NIL; RefBlock_def; el_length_def;
                   LENGTH_APPEND; LENGTH] THEN ARITH_TAC;
       ALL_TAC]) THEN
   REPEAT CONJ_TAC THEN TRY (FIRST_ASSUM ACCEPT_TAC) THEN
   W(fun (asl,gl) ->
     let cu = grab asl (fun th ->
       hd_is "FLOOKUP" (lhs (concl th)) &&
       fst(dest_const (rand (lhs (concl th)))) = "CurrHeap") in
     let ot = grab asl (fun th ->
       hd_is "FLOOKUP" (lhs (concl th)) &&
       fst(dest_const (rand (lhs (concl th)))) = "OtherHeap") in
     MAP_EVERY EXISTS_TAC [rand (rand (rhs (concl cu)));
                           rand (rand (rhs (concl ot)))]) THEN
   REPEAT CONJ_TAC THEN TRY (FIRST_ASSUM ACCEPT_TAC) THEN
   (* the heap of the write, with the cell of the new root *)
   REWRITE_TAC[word_heap_APPEND; word_heap_def; RefBlock_def] THEN
   CONV_TAC(TOP_DEPTH_CONV let_CONV) THEN
   REWRITE_TAC[word_el_def] THEN
   CONV_TAC(TOP_DEPTH_CONV let_CONV) THEN
   REWRITE_TAC[word_payload_def] THEN
   CONV_TAC(TOP_DEPTH_CONV let_CONV) THEN
   REWRITE_TAC[MAP_APPEND; MAP; word_list_APPEND;
               word_list_def; LENGTH_MAP] THEN
   ASM_REWRITE_TAC[addreq] THEN
   REWRITE_TAC[emp_STAR; STAR_emp; STAR_ASSOC] THEN
   (* the element is as long as the array of the reference *)
   RULE_ASSUM_TRY (REWRITE_RULE[el_length_def]) THEN
   REWRITE_TAC[el_length_def; LENGTH_APPEND; LENGTH] THEN
   W(fun (asl,gl) ->
     let le = grab asl (fun th ->
       is_eq (concl th) && hd_is "LENGTH" (lhs (concl th)) &&
       hd_is "APPEND" (rand (lhs (concl th))) &&
       hd_is "LENGTH" (rhs (concl th))) in
     REWRITE_TAC[REWRITE_RULE[LENGTH_APPEND; LENGTH] le]) THEN
   W(fun (asl,gl) ->
     let pred = rator gl in
     let fs = facs pred in
     let cell = find (hd_is "cond") fs in
     let rest = filter (fun t -> not (t = cell)) fs in
     let st = fst(strip_comb pred) in
     let mk a b = mk_comb(mk_comb(st,a),b) in
     SUBGOAL_THEN (mk_eq (pred, mk cell (end_itlist mk rest)))
       SUBST1_TAC THENL
      [REWRITE_TAC[STAR_AC; emp_STAR; STAR_emp]; ALL_TAC]) THEN
   REWRITE_TAC[cond_STAR] THEN
   CONJ_TAC THENL
    [REWRITE_TAC[LENGTH_APPEND; LENGTH] THEN
     RULE_ASSUM_TRY (REWRITE_RULE[LENGTH_APPEND; LENGTH]) THEN
     ASM_REWRITE_TAC[] THEN TRY ASM_ARITH_TAC;
     ALL_TAC] THEN
   (* the write of the root into the cell of the element *)
   W(fun (asl,gl) ->
     let wv = rand (rator (fst (dest_pair (rand (rand gl))))) in
     FIRST_ASSUM (fun sep ->
       if not (try hd_is "STAR" (rator (concl sep))
               with Failure _ -> false) then fail() else
       let th = SPEC wv (MATCH_MP write_fun2set sep) in
       let eq = prove (mk_eq (rator gl, rator (concl th)),
                 REWRITE_TAC[STAR_AC; emp_STAR; STAR_emp]) in
       ACCEPT_TAC (REWRITE_RULE[GSYM eq] th)))))
### memory_rel_Update
(* the write of one value into the array of a reference: the whole
   opening of memory_rel_Deref carries over, because the statements
   agree up to what is done with the cell -- the roots, bc_ref_inv
   (through reachable_refs) for the element of the reference,
   get_real_addr_get_addr for its address, LESS_LENGTH to split the
   payload at the index, and the small-integer case of the v_inv of
   the Number root, whose word is four times the index, for
   get_real_offset_thm.  Then update_ref_thm1 at a stack of one
   value (what the source writes as an instance at [xx], with
   LENGTH_EQ_1 for its root) gives the invariant of the stored
   array; the pointer of its store is the address of the element,
   because the roots of the two agree, and heap_deref says its
   payload is the list that the index split.  So
   heap_store_RefBlock_thm (whose condition is LENGTH_LUPDATE)
   makes the new heap, LUPDATE_LENGTH puts the root in the place of
   the index, and the write of write_fun2set is the cell that
   read_fun2set read -- the element keeps its header, because the
   array keeps its length *)
  ((let hd_is n t =
     (try fst(dest_const(fst(strip_comb t))) = n
      with Failure _ -> false) in
   let rec facs t =
     if hd_is "STAR" t then
       let args = snd(strip_comb t) in
       facs (el 0 args) @ facs (el 1 args)
     else [t] in
   let rec remove1 t = function
       [] -> []
     | h :: rest -> if h = t then rest else h :: remove1 t rest in
   let grab asl p =
     tryfind (fun (_,th) ->
       if (try p th with Failure _ -> false) then th else fail())
       asl in
   let is_hl th = hd_is "heap_lookup" (lhs (concl th)) in
   let swapmul a =
     let args = snd(strip_comb (rand a)) in
     let mul = fst(strip_comb (rand a)) in
     mk_comb(rator a, mk_comb(mk_comb(mul,el 1 args),el 0 args)) in
   let sepfront names =
     W(fun (asl,w) ->
       let pred = rator (lhand w) in
       let fs = facs pred in
       let picked = map (fun n -> find (hd_is n) fs) names in
       let rest = filter (fun t -> not (mem t picked)) fs in
       let st = fst(strip_comb pred) in
       let mk a b = mk_comb(mk_comb(st,a),b) in
       let target = itlist mk picked (end_itlist mk rest) in
       SUBGOAL_THEN (mk_eq(pred,target)) SUBST1_TAC THENL
        [REWRITE_TAC[STAR_AC]; ALL_TAC]) in
   let killthunk =
     TRY(FIRST_ASSUM(fun t1 -> FIRST_ASSUM(fun t2 ->
       CONTR_TAC(REWRITE_RULE[injectivity "option";
                              distinctness "bvlSem_ref"]
                   (TRANS (SYM t1) t2))))) in
   let refinv ptr root =
     FIRST_X_ASSUM(fun th ->
       if is_forall (concl th) &&
          hd_is "bc_ref_inv" (rand (snd(strip_forall(concl th))))
       then MP_TAC(SPEC ptr th) else fail()) THEN
     ANTS_TAC THENL
      [CONJ_TAC THENL
        [REWRITE_TAC[reachable_refs_def; MEM] THEN
         EXISTS_TAC root THEN EXISTS_TAC ptr THEN
         REWRITE_TAC[get_refs_def; MEM;
                     CONJUNCT1(SPEC_ALL RTC_RULES)];
         ASM_REWRITE_TAC[]];
       ALL_TAC] THEN
     REWRITE_TAC[bc_ref_inv_def] THEN
     ASM_SIMP_TAC[FLOOKUP_DEF] THEN
     MATCH_REDUCE_TAC in
   let all2cons = prove
    (`!P h t (l:(A)list).
        ALL2 P l (CONS (h:B) t) <=>
        ?a b. l = CONS a b /\ P a h /\ ALL2 P b t`,
     REPEAT GEN_TAC THEN
     STRUCT_CASES_TAC(ISPEC `l:(A)list` list_CASES) THEN
     REWRITE_TAC[ALL2; NOT_CONS_NIL; CONS_11] THEN MESON_TAC[]) in
   let addreq = WORD_RULE
     `!(a:(N)word) i.
        (a + bytes_in_word) + n2w i * bytes_in_word =
        a + bytes_in_word + bytes_in_word * n2w i` in
   (* the Smallnum of a natural number is four times it, and the and
      with the complement of one leaves such a word alone *)
   let smn = prove
    (`!n. Smallnum (&n) = (n2w (4 * n)):(N)word`,
     GEN_TAC THEN REWRITE_TAC[smallnum_def] THEN
     REWRITE_TAC[INT_ARITH `~((&n:int) < &0)`] THEN
     REWRITE_TAC[INT_OF_NUM_MUL; NUM_OF_INT_OF_NUM]) in
   let and4 = prove
    (`!n. word_and (n2w (4 * n)) (word_not (word 1)) =
          (n2w (4 * n)):(N)word`,
     GEN_TAC THEN
     REWRITE_TAC[WORD_EQ_BITS_ALT; BIT_WORD_AND; BIT_WORD_NOT;
                 BIT_WORD_1] THEN
     X_GEN_TAC `i:num` THEN DISCH_TAC THEN
     ASM_CASES_TAC `(i:num) = 0` THEN ASM_REWRITE_TAC[] THEN
     TRY(REWRITE_TAC[BIT_WORD; EXP; DIV_1; ODD_MULT] THEN
       CONV_TAC NUM_REDUCE_CONV THEN NO_TAC) THEN
     TRY(CONV_TAC TAUT)) in
   (* the address of the heap element, without the existential of
      the goal: this proof fills the existentials at the end *)
   let realaddr_noex =
     W(fun (asl,w) ->
       let hl = grab asl is_hl in
       let hlen = grab asl (fun th ->
         hd_is "heap_length" (lhand (concl th))) in
       let cu = grab asl (fun th ->
         hd_is "FLOOKUP" (lhs (concl th)) &&
         fst(dest_const(rand(lhs(concl th)))) = "CurrHeap") in
       let gd = grab asl (fun th ->
         hd_is "good_dimindex" (concl th)) in
       let gat = tryfind (fun t ->
         find_term (fun u ->
           hd_is "get_addr" u && length (snd(strip_comb u)) = 3) t)
         (w :: map (fun (_,th) -> concl th) asl) in
       let mm = MATCH_MP get_real_addr_get_addr
                  (CONJ hlen (CONJ hl (CONJ cu gd))) in
       let wv = find (fun v -> fst(dest_var v) = "w")
                  (frees (concl mm)) in
       let th = SPEC (last (snd(strip_comb gat))) (GEN wv mm) in
       let a = rand (rhs (concl (CONJUNCT1 th))) in
       STRIP_ASSUME_TAC(REWRITE_RULE[WORD_RULE (mk_eq(a,swapmul a))]
                          th)) in
   let offeq = WORD_RULE
     `!(x:(N)word) i.
        x + (bytes_in_word + n2w i * bytes_in_word) =
        x + bytes_in_word + bytes_in_word * n2w i` in
   let smallidx = prove
    (`!(i:num) n.
        good_dimindex (:'a) /\ i < n /\
        n < 2 EXP (dimindex (:'a) - 4)
        ==> small_int (:'a) (&i)`,
     REPEAT GEN_TAC THEN
     REWRITE_TAC[small_int_def; dimword;
                 good_dimindex_def] THEN
     DISCH_THEN(CONJUNCTS_THEN2 MP_TAC STRIP_ASSUME_TAC) THEN
     DISCH_THEN(DISJ_CASES_THEN SUBST_ALL_TAC) THEN
     RULE_ASSUM_TAC(CONV_RULE NUM_REDUCE_CONV) THEN
     CONV_TAC NUM_REDUCE_CONV THEN
     CONJ_TAC THEN
     TRY(MATCH_MP_TAC INT_LE_TRANS THEN EXISTS_TAC `&0:int` THEN
         REWRITE_TAC[INT_POS; INT_NEG_LE0; INT_POS] THEN NO_TAC) THEN
     REWRITE_TAC[INT_OF_NUM_LT] THEN ASM_ARITH_TAC) in
  DISCH_THEN(REPEAT_TCL CONJUNCTS_THEN ASSUME_TAC) THEN
   SUBGOAL_THEN `~(vals:(dataSem_v)list = [])` ASSUME_TAC THENL
    [DISCH_TAC THEN VAR_EQ_TAC THEN
     FIRST_X_ASSUM(fun th ->
       if (try hd_is "<" (concl th) with Failure _ -> false)
       then MP_TAC(REWRITE_RULE[LENGTH; LT] th) else fail()) THEN
     REWRITE_TAC[];
     ALL_TAC] THEN
   FIRST_ASSUM(fun mr ->
     if hd_is "memory_rel" (concl mr)
     then MP_TAC(REWRITE_RULE[memory_rel_def;
                              word_ml_inv_def; MAP; FST] mr)
     else fail()) THEN
   DISCH_THEN STRIP_ASSUME_TAC THEN
   FIRST_X_ASSUM(fun a2 ->
     if hd_is "ALL2" (concl a2)
     then MP_TAC(REWRITE_RULE[MAP; all2cons] a2) else fail()) THEN
   DISCH_THEN STRIP_ASSUME_TAC THEN
   VAR_EQ_TAC THEN
   FIRST_ASSUM(fun am ->
     if hd_is "abs_ml_inv" (concl am)
     then MP_TAC(REWRITE_RULE[abs_ml_inv_def;
                              bc_stack_ref_inv_def] am)
     else fail()) THEN
   DISCH_THEN STRIP_ASSUME_TAC THEN
   FIRST_X_ASSUM(fun a2 ->
     if hd_is "ALL2" (concl a2) &&
        can (find_term (hd_is "v_inv")) (concl a2)
     then MP_TAC(REWRITE_RULE[ALL2; NOT_CONS_NIL; HD; TL] a2)
     else fail()) THEN
   DISCH_THEN STRIP_ASSUME_TAC THEN
   FIRST_X_ASSUM(fun vi ->
     if hd_is "v_inv" (concl vi) &&
        hd_is "dataSem_RefPtr" (el 1 (snd(strip_comb (concl vi))))
     then MP_TAC(REWRITE_RULE[v_inv_def] vi)
     else fail()) THEN
   DISCH_THEN STRIP_ASSUME_TAC THEN
   killthunk THEN
   FIRST_X_ASSUM(fun e ->
     if is_eq (concl e) && is_var (lhs (concl e)) &&
        hd_is "gc_shared_Pointer" (rhs (concl e))
     then SUBST_ALL_TAC e else fail()) THEN
   RULE_ASSUM_TAC(REWRITE_RULE(word_addr_clauses ())) THEN
   REWRITE_TAC(word_addr_clauses ()) THEN
   refinv `nn:num` `RefPtr bl nn:dataSem_v` THEN
   ASM_REWRITE_TAC[] THEN
   CONV_TAC(TOP_DEPTH_CONV let_CONV) THEN
   DISCH_THEN STRIP_ASSUME_TAC THEN
   FIRST_ASSUM(fun th ->
     if hd_is "heap_in_memory_store" (concl th)
     then MP_TAC(REWRITE_RULE[heap_in_memory_store_def] th)
     else fail()) THEN
   DISCH_THEN STRIP_ASSUME_TAC THEN
   realaddr_noex THEN
   FIRST_ASSUM(fun lr ->
     if hd_is "ALL2" (concl lr) &&
        can (find_term (hd_is "v_inv")) (concl lr)
     then ASSUME_TAC(MATCH_MP LIST_REL_LENGTH lr) else fail()) THEN
   W(fun (asl,w) ->
     let lt = grab asl (fun th ->
       hd_is "<" (concl th) && hd_is "LENGTH" (rand (concl th))) in
     let le = grab asl (fun th ->
       hd_is "=" (concl th) && hd_is "LENGTH" (lhs (concl th)) &&
       hd_is "LENGTH" (rhs (concl th))) in
     MP_TAC(MATCH_MP LESS_LENGTH
              (REWRITE_RULE[GSYM le] lt))) THEN
   DISCH_THEN STRIP_ASSUME_TAC THEN
   VAR_EQ_TAC THEN
   W(fun (asl,w) ->
     MP_TAC(MATCH_MP heap_lookup_SPLIT
              (grab asl is_hl))) THEN
   DISCH_THEN STRIP_ASSUME_TAC THEN
   VAR_EQ_TAC THEN
   TRY(FIRST_X_ASSUM(fun th ->
     if (try hd_is "fmap_apply" (lhs (concl th))
         with Failure _ -> false)
     then SUBST_ALL_TAC th else fail())) THEN
   FIRST_X_ASSUM(fun th ->
     if (try hd_is "STAR" (rator (concl th)) with Failure _ -> false)
     then MP_TAC th else fail()) THEN
   REWRITE_TAC[word_heap_APPEND; word_heap_def;
               RefBlock_def] THEN
   CONV_TAC(TOP_DEPTH_CONV let_CONV) THEN
   REWRITE_TAC[word_el_def] THEN
   CONV_TAC(TOP_DEPTH_CONV let_CONV) THEN
   REWRITE_TAC[word_payload_def] THEN
   CONV_TAC(TOP_DEPTH_CONV let_CONV) THEN
   REWRITE_TAC[MAP_APPEND; MAP; word_list_APPEND;
               word_list_def; LENGTH_MAP] THEN
   ASM_REWRITE_TAC[addreq] THEN
   (* the condition of the payload bounds the length of the block *)
   REPEAT(sepfront ["cond"] THEN REWRITE_TAC[cond_STAR] THEN
          DISCH_THEN(CONJUNCTS_THEN2 STRIP_ASSUME_TAC MP_TAC)) THEN
   W(fun (asl,w) ->
     let ga = grab asl (fun th ->
       hd_is "get_real_addr" (lhs (concl th))) in
     let base = rand (rhs (concl ga)) in
     let pred = rator (lhand w) in
     let fs = facs pred in
     let one = find (fun t ->
       hd_is "set_sep_one" t &&
       not (fst(dest_pair (rand t)) = base)) fs in
     let rest = remove1 one fs in
     let st = fst(strip_comb pred) in
     let mk a b = mk_comb(mk_comb(st,a),b) in
     SUBGOAL_THEN (mk_eq(pred, mk one (end_itlist mk rest)))
       SUBST1_TAC THENL [REWRITE_TAC[STAR_AC]; ALL_TAC]) THEN
   DISCH_THEN(fun sep ->
     STRIP_ASSUME_TAC(MATCH_MP read_fun2set sep) THEN
     ASSUME_TAC sep) THEN
   ASM_REWRITE_TAC[] THEN
   (* the index is a small integer, because it is below the length
      that the header of the block encodes *)
   W(fun (asl,w) ->
     let bd = grab asl (fun th ->
       hd_is "<" (concl th) && hd_is "LENGTH" (lhand (concl th)) &&
       hd_is "EXP" (rand (concl th))) in
     let lt0 = grab asl (fun th ->
       hd_is "<" (concl th) && hd_is "LENGTH" (lhand (concl th)) &&
       hd_is "LENGTH" (rand (concl th))) in
     let lt = try REWRITE_RULE[grab asl (fun th ->
                    hd_is "=" (concl th) &&
                    hd_is "LENGTH" (lhs (concl th)) &&
                    hd_is "LENGTH" (rhs (concl th)))] lt0
              with Failure _ -> lt0 in
     let gd = grab asl (fun th ->
       hd_is "good_dimindex" (concl th)) in
     ASSUME_TAC(MATCH_MP smallidx (CONJ gd (CONJ lt bd)))) THEN
   FIRST_X_ASSUM(fun vi ->
     if hd_is "v_inv" (concl vi) &&
        hd_is "dataSem_Number" (el 1 (snd(strip_comb (concl vi))))
     then MP_TAC(REWRITE_RULE[v_inv_def] vi)
     else fail()) THEN
   FIRST_ASSUM(fun si ->
     if hd_is "small_int" (concl si) then REWRITE_TAC[si]
     else fail()) THEN
   DISCH_THEN(fun eq ->
     RULE_ASSUM_TAC(REWRITE_RULE[eq]) THEN REWRITE_TAC[eq]) THEN
   RULE_ASSUM_TAC(REWRITE_RULE
     (word_addr_clauses () @ [smn; and4])) THEN
   REWRITE_TAC(word_addr_clauses () @ [smn; and4]) THEN
   (* the invariant with the value stored in the reference *)
   W(fun (asl,gl) ->
     let am = grab asl (fun th -> hd_is "abs_ml_inv" (concl th)) in
     let stk = el 1 (snd(strip_comb (concl am))) in
     let hv = lhand stk in
     let xsv = find (fun v -> fst(dest_var v) = "xs")
                 (frees (concl update_ref_thm1)) in
     let urt = REWRITE_RULE[LENGTH_EQ_1]
                 (CONV_RULE NUM_REDUCE_CONV
                   (REWRITE_RULE[APPEND; HD; LENGTH]
                     (INST [mk_list([hv],type_of hv),xsv]
                       update_ref_thm1))) in
     let lk = grab asl (fun th ->
       hd_is "sptree_lookup" (lhs (concl th))) in
     let lt = grab asl (fun th ->
       hd_is "<" (concl th) && hd_is "LENGTH" (rand (concl th))) in
     MP_TAC(MATCH_MP urt (CONJ am (CONJ lk lt)))) THEN
   DISCH_THEN STRIP_ASSUME_TAC THEN
   (* the existentials: the roots, the address and the offset *)
   W(fun (asl,w) ->
     let cs = conjuncts (snd(strip_exists w)) in
     let ga = grab asl (fun th ->
       hd_is "get_real_addr" (lhs (concl th))) in
     let gd = grab asl (fun th ->
       hd_is "good_dimindex" (concl th)) in
     let ro0 = MATCH_MP get_real_offset_thm gd in
     let iv = find (fun v -> type_of v = `:num`) (frees (concl ro0)) in
     let ro = INST [rand (rand (rand (lhs (el 1 cs)))),iv] ro0 in
     EXISTS_TAC (rand (lhs (el 0 cs))) THEN
     EXISTS_TAC (rand (lhs (el 1 cs))) THEN
     EXISTS_TAC (rand (rhs (concl ga))) THEN
     EXISTS_TAC (rand (rhs (concl ro))) THEN
     ASM_REWRITE_TAC[ro; offeq]) THEN
   (* the root of the value, and the pointer of the store is the
      address of the element *)
   REPEAT (FIRST_X_ASSUM (fun e ->
     if not (try is_eq (concl e) && is_var (lhs (concl e)) &&
                 hd_is "CONS" (rhs (concl e))
             with Failure _ -> false) then fail() else
     SUBST_ALL_TAC e)) THEN
   RULE_ASSUM_TRY (REWRITE_RULE[APPEND; HD]) THEN
   FIRST_X_ASSUM (fun e ->
     if not (try is_eq (concl e) && hd_is "CONS" (lhs (concl e)) &&
                 hd_is "CONS" (rhs (concl e)) &&
                 can (find_term (hd_is "gc_shared_Pointer"))
                   (rhs (concl e))
             with Failure _ -> false) then fail() else
     STRIP_ASSUME_TAC (REWRITE_RULE[CONS_11;
       injectivity "heap_address"] e)) THEN
   REPEAT (FIRST_X_ASSUM (fun e ->
     if not (try is_eq (concl e) && is_var (lhs (concl e)) &&
                 is_var (rhs (concl e)) &&
                 not (lhs (concl e) = rhs (concl e))
             with Failure _ -> false) then fail() else
     SUBST_ALL_TAC e)) THEN
   FIRST_X_ASSUM (fun e ->
     if not (try is_eq (concl e) && is_var (rhs (concl e)) &&
                 hd_is "heap_length" (lhs (concl e))
             with Failure _ -> false) then fail() else
     SUBST_ALL_TAC (SYM e)) THEN
   (* the payload of the element is the list that the index split *)
   W(fun (asl,gl) ->
     let hd0 = grab asl (fun th ->
       hd_is "heap_deref" (lhs (concl th))) in
     let hl = grab asl is_hl in
     MP_TAC (REWRITE_RULE[heap_deref_def; hl; RefBlock_def] hd0)) THEN
   MATCH_REDUCE_TAC THEN
   REWRITE_TAC[injectivity "option"] THEN
   DISCH_THEN (SUBST_ALL_TAC o SYM) THEN
   (* the new heap is the old one with the element written *)
   W(fun (asl,gl) ->
     let hs = grab asl (fun th ->
       hd_is "heap_store" (lhs (concl th))) in
     let args = snd(strip_comb (lhs (concl hs))) in
     let xs = rand (lhand (el 1 args)) in
     let ys = rand (lhand (rand (el 2 args))) in
     let hap = lhand (el 2 args) in
     let lenth = prove (mk_eq (mk_icomb (`LENGTH`,xs),
                               mk_icomb (`LENGTH`,ys)),
                  REWRITE_TAC[LENGTH_LUPDATE]) in
     let inst = MATCH_MP (ISPEC hap heap_store_RefBlock_thm)
                  lenth in
     SUBST_ALL_TAC (SYM (REWRITE_RULE[PAIR_EQ]
       (REWRITE_RULE[inst] hs)))) THEN
   RULE_ASSUM_TRY (REWRITE_RULE[LUPDATE_LENGTH]) THEN
   (* the invariant of the new heap *)
   REWRITE_TAC[memory_rel_def] THEN
   W(fun (asl,gl) ->
     let hm = grab asl (fun th ->
       hd_is "heap_in_memory_store" (concl th)) in
     let args = snd(strip_comb (concl hm)) in
     let ai = grab asl (fun th ->
       hd_is "abs_ml_inv" (concl th) &&
       (try hd_is "sptree_insert"
              (el 2 (snd(strip_comb (concl th))))
        with Failure _ -> false)) in
     let nh = el 1 (tparts (el 3 (snd(strip_comb (concl ai))))) in
     EXISTS_TAC nh THEN EXISTS_TAC (el 9 args) THEN
     EXISTS_TAC (el 1 args) THEN EXISTS_TAC (el 2 args) THEN
     EXISTS_TAC (el 3 args) THEN EXISTS_TAC (el 4 args)) THEN
   REPEAT CONJ_TAC THENL
    [ALL_TAC;
     (* the roots of the invariant, with the root of the value *)
     REWRITE_TAC[word_ml_inv_def] THEN
     W(fun (asl,gl) ->
       let ai = grab asl (fun th ->
         hd_is "abs_ml_inv" (concl th) &&
         (try hd_is "sptree_insert"
                (el 2 (snd(strip_comb (concl th))))
          with Failure _ -> false)) in
       EXISTS_TAC
         (el 0 (tparts (el 3 (snd(strip_comb (concl ai))))))) THEN
     REWRITE_TAC[MAP; FST; SND; ALL2; HD; TL; NOT_CONS_NIL] THEN
     CONV_TAC(TOP_DEPTH_CONV BETA_CONV) THEN
     REWRITE_TAC(word_addr_clauses () @ [smn; and4]) THEN
     (* the annotation of the pointer is the one of the array *)
     TRY (FIRST_ASSUM (fun an ->
       if not (try hd_is "ref_ptr_annot" (lhs (concl an))
               with Failure _ -> false) then fail() else
       FIRST_ASSUM (fun lk ->
         if not (try hd_is "sptree_lookup" (lhs (concl lk))
                 with Failure _ -> false) then fail() else
         REWRITE_TAC[REWRITE_RULE[lk] an]))) THEN
     ASM_REWRITE_TAC[] THEN
     REPEAT CONJ_TAC THEN TRY (FIRST_ASSUM ACCEPT_TAC);
     FIRST_ASSUM ACCEPT_TAC;
     FIRST_ASSUM ACCEPT_TAC] THEN
   (* the store, whose memory is the one written *)
   REWRITE_TAC[heap_in_memory_store_def] THEN
   W(fun (asl,gl) ->
     let nh = rand (find_term (fun t ->
       hd_is "heap_length" t && hd_is "APPEND" (rand t)) gl) in
     let oh = rand (lhs (concl (grab asl is_hl))) in
     if nh = oh then ALL_TAC else
     SUBGOAL_THEN (mk_eq (mk_icomb (`heap_length`,nh),
                          mk_icomb (`heap_length`,oh)))
       (fun le -> REWRITE_TAC[le]) THENL
      [REWRITE_TAC[heap_length_APPEND; heap_length_CONS;
                   heap_length_NIL; RefBlock_def; el_length_def;
                   LENGTH_APPEND; LENGTH] THEN ARITH_TAC;
       ALL_TAC]) THEN
   REPEAT CONJ_TAC THEN TRY (FIRST_ASSUM ACCEPT_TAC) THEN
   W(fun (asl,gl) ->
     let cu = grab asl (fun th ->
       hd_is "FLOOKUP" (lhs (concl th)) &&
       fst(dest_const (rand (lhs (concl th)))) = "CurrHeap") in
     let ot = grab asl (fun th ->
       hd_is "FLOOKUP" (lhs (concl th)) &&
       fst(dest_const (rand (lhs (concl th)))) = "OtherHeap") in
     MAP_EVERY EXISTS_TAC [rand (rand (rhs (concl cu)));
                           rand (rand (rhs (concl ot)))]) THEN
   REPEAT CONJ_TAC THEN TRY (FIRST_ASSUM ACCEPT_TAC) THEN
   (* the heap of the write, with the cell of the new root *)
   REWRITE_TAC[word_heap_APPEND; word_heap_def; RefBlock_def] THEN
   CONV_TAC(TOP_DEPTH_CONV let_CONV) THEN
   REWRITE_TAC[word_el_def] THEN
   CONV_TAC(TOP_DEPTH_CONV let_CONV) THEN
   REWRITE_TAC[word_payload_def] THEN
   CONV_TAC(TOP_DEPTH_CONV let_CONV) THEN
   REWRITE_TAC[MAP_APPEND; MAP; word_list_APPEND;
               word_list_def; LENGTH_MAP] THEN
   ASM_REWRITE_TAC[addreq] THEN
   REWRITE_TAC[emp_STAR; STAR_emp; STAR_ASSOC] THEN
   (* the element is as long as the array of the reference *)
   RULE_ASSUM_TRY (REWRITE_RULE[el_length_def]) THEN
   REWRITE_TAC[el_length_def; LENGTH_APPEND; LENGTH] THEN
   W(fun (asl,gl) ->
     let le = grab asl (fun th ->
       is_eq (concl th) && hd_is "LENGTH" (lhs (concl th)) &&
       hd_is "APPEND" (rand (lhs (concl th))) &&
       hd_is "LENGTH" (rhs (concl th))) in
     REWRITE_TAC[REWRITE_RULE[LENGTH_APPEND; LENGTH] le]) THEN
   W(fun (asl,gl) ->
     let pred = rator gl in
     let fs = facs pred in
     let cell = find (hd_is "cond") fs in
     let rest = filter (fun t -> not (t = cell)) fs in
     let st = fst(strip_comb pred) in
     let mk a b = mk_comb(mk_comb(st,a),b) in
     SUBGOAL_THEN (mk_eq (pred, mk cell (end_itlist mk rest)))
       SUBST1_TAC THENL
      [REWRITE_TAC[STAR_AC; emp_STAR; STAR_emp]; ALL_TAC]) THEN
   REWRITE_TAC[cond_STAR] THEN
   CONJ_TAC THENL
    [REWRITE_TAC[LENGTH_APPEND; LENGTH] THEN
     RULE_ASSUM_TRY (REWRITE_RULE[LENGTH_APPEND; LENGTH]) THEN
     ASM_REWRITE_TAC[] THEN TRY ASM_ARITH_TAC;
     ALL_TAC] THEN
   (* the write of the root into the cell of the element *)
   W(fun (asl,gl) ->
     let wv = rand (rator (fst (dest_pair (rand (rand gl))))) in
     FIRST_ASSUM (fun sep ->
       if not (try hd_is "STAR" (rator (concl sep))
               with Failure _ -> false) then fail() else
       let th = SPEC wv (MATCH_MP write_fun2set sep) in
       let eq = prove (mk_eq (rator gl, rator (concl th)),
                 REWRITE_TAC[STAR_AC; emp_STAR; STAR_emp]) in
       ACCEPT_TAC (REWRITE_RULE[GSYM eq] th)))))
### memory_rel_UpdateCons
(* the write into the hole of an unfinalised mutable block, which
   mirrors memory_rel_Update: the same opening (the roots, the
   address of the element, the payload split at the index and the
   small-integer case of the Number root, with get_real_offset_thm
   for its offset), but the pointer of a mutable block is never
   compare-by-pointer -- the source argues that by contradiction,
   and so does this, with v_inv_RefPtr_T, which says a RefPtr T is
   no mutable block.  Then update_mutblock_thm gives the invariant
   of the stored block together with the element of the heap and
   the roots of the two values in front, so no bc_ref_inv is
   needed here; the length of the payload is the one the header
   encodes (encode_header, as in memory_rel_El) and the index is
   below it, which makes it a small integer.
   heap_store_BlockRep_thm makes the new heap, LUPDATE_LENGTH puts
   the root in the place of the hole, and the write of
   write_fun2set is the cell that read_fun2set read *)
  ((let hd_is n t =
     (try fst(dest_const(fst(strip_comb t))) = n
      with Failure _ -> false) in
   let rec facs t =
     if hd_is "STAR" t then
       let args = snd(strip_comb t) in
       facs (el 0 args) @ facs (el 1 args)
     else [t] in
   let rec remove1 t = function
       [] -> []
     | h :: rest -> if h = t then rest else h :: remove1 t rest in
   let grab asl p =
     tryfind (fun (_,th) ->
       if (try p th with Failure _ -> false) then th else fail())
       asl in
   let is_hl th = hd_is "heap_lookup" (lhs (concl th)) in
   let swapmul a =
     let args = snd(strip_comb (rand a)) in
     let mul = fst(strip_comb (rand a)) in
     mk_comb(rator a, mk_comb(mk_comb(mul,el 1 args),el 0 args)) in
   let sepfront names =
     W(fun (asl,w) ->
       let pred = rator (lhand w) in
       let fs = facs pred in
       let picked = map (fun n -> find (hd_is n) fs) names in
       let rest = filter (fun t -> not (mem t picked)) fs in
       let st = fst(strip_comb pred) in
       let mk a b = mk_comb(mk_comb(st,a),b) in
       let target = itlist mk picked (end_itlist mk rest) in
       SUBGOAL_THEN (mk_eq(pred,target)) SUBST1_TAC THENL
        [REWRITE_TAC[STAR_AC]; ALL_TAC]) in
   let all2cons = prove
    (`!P h t (l:(A)list).
        ALL2 P l (CONS (h:B) t) <=>
        ?a b. l = CONS a b /\ P a h /\ ALL2 P b t`,
     REPEAT GEN_TAC THEN
     STRUCT_CASES_TAC(ISPEC `l:(A)list` list_CASES) THEN
     REWRITE_TAC[ALL2; NOT_CONS_NIL; CONS_11] THEN MESON_TAC[]) in
   let addreq = WORD_RULE
     `!(a:(N)word) i.
        (a + bytes_in_word) + n2w i * bytes_in_word =
        a + bytes_in_word + bytes_in_word * n2w i` in
   (* the Smallnum of a natural number is four times it, and the and
      with the complement of one leaves such a word alone *)
   let smn = prove
    (`!n. Smallnum (&n) = (n2w (4 * n)):(N)word`,
     GEN_TAC THEN REWRITE_TAC[smallnum_def] THEN
     REWRITE_TAC[INT_ARITH `~((&n:int) < &0)`] THEN
     REWRITE_TAC[INT_OF_NUM_MUL; NUM_OF_INT_OF_NUM]) in
   let and4 = prove
    (`!n. word_and (n2w (4 * n)) (word_not (word 1)) =
          (n2w (4 * n)):(N)word`,
     GEN_TAC THEN
     REWRITE_TAC[WORD_EQ_BITS_ALT; BIT_WORD_AND; BIT_WORD_NOT;
                 BIT_WORD_1] THEN
     X_GEN_TAC `i:num` THEN DISCH_TAC THEN
     ASM_CASES_TAC `(i:num) = 0` THEN ASM_REWRITE_TAC[] THEN
     TRY(REWRITE_TAC[BIT_WORD; EXP; DIV_1; ODD_MULT] THEN
       CONV_TAC NUM_REDUCE_CONV THEN NO_TAC) THEN
     TRY(CONV_TAC TAUT)) in
   (* the address of the heap element, without the existential of
      the goal: this proof fills the existentials at the end *)
   let realaddr_noex =
     W(fun (asl,w) ->
       let hl = grab asl is_hl in
       let hlen = grab asl (fun th ->
         hd_is "heap_length" (lhand (concl th))) in
       let cu = grab asl (fun th ->
         hd_is "FLOOKUP" (lhs (concl th)) &&
         fst(dest_const(rand(lhs(concl th)))) = "CurrHeap") in
       let gd = grab asl (fun th ->
         hd_is "good_dimindex" (concl th)) in
       let gat = tryfind (fun t ->
         find_term (fun u ->
           hd_is "get_addr" u && length (snd(strip_comb u)) = 3) t)
         (w :: map (fun (_,th) -> concl th) asl) in
       let mm = MATCH_MP get_real_addr_get_addr
                  (CONJ hlen (CONJ hl (CONJ cu gd))) in
       let wv = find (fun v -> fst(dest_var v) = "w")
                  (frees (concl mm)) in
       let th = SPEC (last (snd(strip_comb gat))) (GEN wv mm) in
       let a = rand (rhs (concl (CONJUNCT1 th))) in
       STRIP_ASSUME_TAC(REWRITE_RULE[WORD_RULE (mk_eq(a,swapmul a))]
                          th)) in
   let offeq = WORD_RULE
     `!(x:(N)word) i.
        x + (bytes_in_word + n2w i * bytes_in_word) =
        x + bytes_in_word + bytes_in_word * n2w i` in
   (* the length a header encodes is below two to the dimindex
      less four, and an index into such a list is a small integer *)
   let enchdr = prove
    (`!c tag len (h:'a word).
        encode_header c tag len = SOME h
        ==> len < 2 EXP (dimindex (:'a) - 4)`,
     REPEAT GEN_TAC THEN REWRITE_TAC[encode_header_def] THEN
     COND_CASES_TAC THEN REWRITE_TAC[distinctness "option"] THEN
     DISCH_THEN(K ALL_TAC) THEN ASM_REWRITE_TAC[]) in
   let smallidx = prove
    (`!(i:num) n.
        good_dimindex (:'a) /\ i < n /\
        n < 2 EXP (dimindex (:'a) - 4)
        ==> small_int (:'a) (&i)`,
     REPEAT GEN_TAC THEN
     REWRITE_TAC[small_int_def; dimword;
                 good_dimindex_def] THEN
     DISCH_THEN(CONJUNCTS_THEN2 MP_TAC STRIP_ASSUME_TAC) THEN
     DISCH_THEN(DISJ_CASES_THEN SUBST_ALL_TAC) THEN
     RULE_ASSUM_TAC(CONV_RULE NUM_REDUCE_CONV) THEN
     CONV_TAC NUM_REDUCE_CONV THEN
     CONJ_TAC THEN
     TRY(MATCH_MP_TAC INT_LE_TRANS THEN EXISTS_TAC `&0:int` THEN
         REWRITE_TAC[INT_POS; INT_NEG_LE0; INT_POS] THEN NO_TAC) THEN
     REWRITE_TAC[INT_OF_NUM_LT] THEN ASM_ARITH_TAC) in
  DISCH_THEN(REPEAT_TCL CONJUNCTS_THEN ASSUME_TAC) THEN
   (* the index is the length of the values before the hole *)
   FIRST_X_ASSUM (fun e ->
     if not (try is_eq (concl e) && is_var (lhs (concl e)) &&
                 hd_is "LENGTH" (rhs (concl e))
             with Failure _ -> false) then fail() else
     SUBST_ALL_TAC e) THEN
   (* the invariant of the stack *)
   FIRST_ASSUM(fun mr ->
     if hd_is "memory_rel" (concl mr)
     then MP_TAC(REWRITE_RULE[memory_rel_def;
                              word_ml_inv_def; MAP; FST] mr)
     else fail()) THEN
   DISCH_THEN STRIP_ASSUME_TAC THEN
   FIRST_X_ASSUM(fun a2 ->
     if hd_is "ALL2" (concl a2)
     then MP_TAC(REWRITE_RULE[MAP; all2cons] a2) else fail()) THEN
   DISCH_THEN STRIP_ASSUME_TAC THEN
   VAR_EQ_TAC THEN
   (* a pointer to a mutable block is never compare-by-pointer *)
   W(fun (asl,gl) ->
     let ai = grab asl (fun th -> hd_is "abs_ml_inv" (concl th)) in
     let stk = el 1 (snd(strip_comb (concl ai))) in
     let blv = lhand (lhand (rand stk)) in
     SUBGOAL_THEN (mk_eq (blv,`F`)) SUBST_ALL_TAC THENL
      [ASM_CASES_TAC blv THENL
        [RULE_ASSUM_TAC (REWRITE_RULE[ASSUME blv]) THEN
         FIRST_ASSUM (fun ai2 ->
           if not (hd_is "abs_ml_inv" (concl ai2)) then fail() else
           STRIP_ASSUME_TAC (REWRITE_RULE[abs_ml_inv_def;
             bc_stack_ref_inv_def] ai2)) THEN
         FIRST_X_ASSUM (fun a2 ->
           if not (hd_is "ALL2" (concl a2) &&
                   can (find_term (hd_is "v_inv")) (concl a2))
           then fail() else
           STRIP_ASSUME_TAC (REWRITE_RULE[ALL2; NOT_CONS_NIL;
             HD; TL] a2)) THEN
         FIRST_X_ASSUM (fun vi ->
           if not (hd_is "v_inv" (concl vi) &&
                   hd_is "dataSem_RefPtr"
                     (el 1 (snd(strip_comb (concl vi)))))
           then fail() else
           STRIP_ASSUME_TAC (REWRITE_RULE[v_inv_RefPtr_T] vi)) THEN
         FIRST_ASSUM (fun fa ->
           if not (is_forall (concl fa)) then fail() else
           FIRST_ASSUM (fun lk ->
             if not (try hd_is "sptree_lookup" (lhs (concl lk))
                     with Failure _ -> false) then fail() else
             let args = snd(strip_comb (rand (rhs (concl lk)))) in
             CONTR_TAC (REWRITE_RULE[lk] (SPECL args fa))));
         ASM_REWRITE_TAC[]];
       ALL_TAC]) THEN
   (* what the invariant says of the values of the stack *)
   FIRST_ASSUM(fun am ->
     if hd_is "abs_ml_inv" (concl am)
     then MP_TAC(REWRITE_RULE[abs_ml_inv_def;
                              bc_stack_ref_inv_def] am)
     else fail()) THEN
   DISCH_THEN STRIP_ASSUME_TAC THEN
   FIRST_X_ASSUM(fun a2 ->
     if hd_is "ALL2" (concl a2) &&
        can (find_term (hd_is "v_inv")) (concl a2)
     then MP_TAC(REWRITE_RULE[ALL2; NOT_CONS_NIL; HD; TL] a2)
     else fail()) THEN
   DISCH_THEN STRIP_ASSUME_TAC THEN
   (* the store of the value into the hole of the block *)
   W(fun (asl,gl) ->
     let ai = grab asl (fun th -> hd_is "abs_ml_inv" (concl th)) in
     let lk = grab asl (fun th ->
       try hd_is "sptree_lookup" (lhs (concl th))
       with Failure _ -> false) in
     MP_TAC (MATCH_MP (GEN_ALL update_mutblock_thm) (CONJ ai lk))) THEN
   DISCH_THEN STRIP_ASSUME_TAC THEN
   (* the two roots in front are the value and the block *)
   FIRST_X_ASSUM (fun e ->
     if not (try is_eq (concl e) && hd_is "CONS" (lhs (concl e)) &&
                 hd_is "CONS" (rhs (concl e)) &&
                 can (find_term (hd_is "gc_shared_Pointer"))
                   (rhs (concl e))
             with Failure _ -> false) then fail() else
     STRIP_ASSUME_TAC (REWRITE_RULE[CONS_11] e)) THEN
   REPEAT (FIRST_X_ASSUM (fun e ->
     if not (try is_eq (concl e) && is_var (lhs (concl e)) &&
                 (is_var (rhs (concl e)) ||
                  hd_is "gc_shared_Pointer" (rhs (concl e)))
             with Failure _ -> false) then fail() else
     SUBST_ALL_TAC e)) THEN
   RULE_ASSUM_TAC(REWRITE_RULE(word_addr_clauses ())) THEN
   REWRITE_TAC(word_addr_clauses ()) THEN
   FIRST_ASSUM(fun th ->
     if hd_is "heap_in_memory_store" (concl th)
     then MP_TAC(REWRITE_RULE[heap_in_memory_store_def] th)
     else fail()) THEN
   DISCH_THEN STRIP_ASSUME_TAC THEN
   realaddr_noex THEN
   (* the payload of the block splits at the hole *)
   W(fun (asl,gl) ->
     let le = grab asl (fun th ->
       try is_eq (concl th) && hd_is "LENGTH" (lhs (concl th)) &&
           hd_is "+" (rhs (concl th))
       with Failure _ -> false) in
     let lt = REWRITE_RULE[GSYM le]
                (ARITH_RULE (mk_binop `(<):num->num->bool`
                   (lhand (rhs (concl le))) (rhs (concl le)))) in
     MP_TAC (MATCH_MP LESS_LENGTH lt)) THEN
   DISCH_THEN STRIP_ASSUME_TAC THEN
   VAR_EQ_TAC THEN
   FIRST_X_ASSUM (fun e ->
     if not (try is_eq (concl e) && hd_is "LENGTH" (lhs (concl e)) &&
                 hd_is "LENGTH" (rhs (concl e))
             with Failure _ -> false) then fail() else
     RULE_ASSUM_TRY (REWRITE_RULE[SYM e]) THEN
     REWRITE_TAC[SYM e]) THEN
   (* and the heap splits at the block *)
   W(fun (asl,gl) ->
     MP_TAC (MATCH_MP heap_lookup_SPLIT (grab asl is_hl))) THEN
   DISCH_THEN STRIP_ASSUME_TAC THEN
   VAR_EQ_TAC THEN
   FIRST_X_ASSUM(fun th ->
     if (try hd_is "STAR" (rator (concl th)) with Failure _ -> false)
     then MP_TAC th else fail()) THEN
   REWRITE_TAC[word_heap_APPEND; word_heap_def; BlockRep_def] THEN
   CONV_TAC(TOP_DEPTH_CONV let_CONV) THEN
   REWRITE_TAC[word_el_def] THEN
   CONV_TAC(TOP_DEPTH_CONV let_CONV) THEN
   REWRITE_TAC[word_payload_def] THEN
   CONV_TAC(TOP_DEPTH_CONV let_CONV) THEN
   REWRITE_TAC[MAP_APPEND; MAP; word_list_APPEND;
               word_list_def; LENGTH_MAP] THEN
   ASM_REWRITE_TAC[addreq] THEN
   REPEAT(sepfront ["cond"] THEN REWRITE_TAC[cond_STAR] THEN
          DISCH_THEN(CONJUNCTS_THEN2 STRIP_ASSUME_TAC MP_TAC)) THEN
   W(fun (asl,w) ->
     let ga = grab asl (fun th ->
       hd_is "get_real_addr" (lhs (concl th))) in
     let base = rand (rhs (concl ga)) in
     let pred = rator (lhand w) in
     let fs = facs pred in
     let one = find (fun t ->
       hd_is "set_sep_one" t &&
       not (fst(dest_pair (rand t)) = base)) fs in
     let rest = remove1 one fs in
     let st = fst(strip_comb pred) in
     let mk a b = mk_comb(mk_comb(st,a),b) in
     SUBGOAL_THEN (mk_eq(pred, mk one (end_itlist mk rest)))
       SUBST1_TAC THENL [REWRITE_TAC[STAR_AC]; ALL_TAC]) THEN
   DISCH_THEN(fun sep ->
     STRIP_ASSUME_TAC(MATCH_MP read_fun2set sep) THEN
     ASSUME_TAC sep) THEN
   ASM_REWRITE_TAC[] THEN
   (* the index is a small integer, because it is below the length
      that the header of the block encodes *)
   W(fun (asl,w) ->
     let eh = grab asl (fun th ->
       hd_is "encode_header" (lhs (concl th))) in
     let le = grab asl (fun th ->
       try is_eq (concl th) && hd_is "LENGTH" (lhs (concl th)) &&
           hd_is "+" (rhs (concl th))
       with Failure _ -> false) in
     let bd = MATCH_MP enchdr eh in
     let lt = prove (mk_binop `(<):num->num->bool`
                       (lhand (rhs (concl le))) (lhand (concl bd)),
                REWRITE_TAC[LENGTH_APPEND; LENGTH] THEN ARITH_TAC) in
     let gd = grab asl (fun th ->
       hd_is "good_dimindex" (concl th)) in
     ASSUME_TAC(MATCH_MP smallidx (CONJ gd (CONJ lt bd)))) THEN
   FIRST_X_ASSUM(fun vi ->
     if hd_is "v_inv" (concl vi) &&
        hd_is "dataSem_Number" (el 1 (snd(strip_comb (concl vi))))
     then MP_TAC(REWRITE_RULE[v_inv_def] vi)
     else fail()) THEN
   FIRST_ASSUM(fun si ->
     if hd_is "small_int" (concl si) then REWRITE_TAC[si]
     else fail()) THEN
   DISCH_THEN(fun eq ->
     RULE_ASSUM_TAC(REWRITE_RULE[eq]) THEN REWRITE_TAC[eq]) THEN
   RULE_ASSUM_TAC(REWRITE_RULE
     (word_addr_clauses () @ [smn; and4])) THEN
   REWRITE_TAC(word_addr_clauses () @ [smn; and4]) THEN
   (* the existentials: the roots, the address and the offset *)
   W(fun (asl,w) ->
     let cs = conjuncts (snd(strip_exists w)) in
     let ga = grab asl (fun th ->
       hd_is "get_real_addr" (lhs (concl th))) in
     let gd = grab asl (fun th ->
       hd_is "good_dimindex" (concl th)) in
     let ro0 = MATCH_MP get_real_offset_thm gd in
     let iv = find (fun v -> type_of v = `:num`) (frees (concl ro0)) in
     let ro = INST [rand (rand (rand (lhs (el 1 cs)))),iv] ro0 in
     EXISTS_TAC (rand (lhs (el 0 cs))) THEN
     EXISTS_TAC (rand (lhs (el 1 cs))) THEN
     EXISTS_TAC (rand (rhs (concl ga))) THEN
     EXISTS_TAC (rand (rhs (concl ro))) THEN
     ASM_REWRITE_TAC[ro; offeq]) THEN
   (* the new heap is the old one with the hole written *)
   W(fun (asl,gl) ->
     let hs = grab asl (fun th ->
       hd_is "heap_store" (lhs (concl th))) in
     let args = snd(strip_comb (lhs (concl hs))) in
     let xs = rand (lhand (el 1 args)) in
     let ys = rand (lhand (rand (el 2 args))) in
     let hap = lhand (el 2 args) in
     let lenth = prove (mk_eq (mk_icomb (`LENGTH`,xs),
                               mk_icomb (`LENGTH`,ys)),
                  REWRITE_TAC[LENGTH_LUPDATE]) in
     let inst = MATCH_MP (ISPEC hap heap_store_BlockRep_thm)
                  lenth in
     SUBST_ALL_TAC (SYM (REWRITE_RULE[PAIR_EQ]
       (REWRITE_RULE[inst] hs)))) THEN
   RULE_ASSUM_TRY (REWRITE_RULE[LUPDATE_LENGTH]) THEN
   (* the invariant of the new heap *)
   REWRITE_TAC[memory_rel_def] THEN
   W(fun (asl,gl) ->
     let hm = grab asl (fun th ->
       hd_is "heap_in_memory_store" (concl th)) in
     let args = snd(strip_comb (concl hm)) in
     let ai = grab asl (fun th ->
       hd_is "abs_ml_inv" (concl th) &&
       (try hd_is "sptree_insert"
              (el 2 (snd(strip_comb (concl th))))
        with Failure _ -> false)) in
     let nh = el 1 (tparts (el 3 (snd(strip_comb (concl ai))))) in
     EXISTS_TAC nh THEN EXISTS_TAC (el 9 args) THEN
     EXISTS_TAC (el 1 args) THEN EXISTS_TAC (el 2 args) THEN
     EXISTS_TAC (el 3 args) THEN EXISTS_TAC (el 4 args)) THEN
   REPEAT CONJ_TAC THENL
    [ALL_TAC;
     (* the roots of the invariant, with the root of the value *)
     REWRITE_TAC[word_ml_inv_def] THEN
     W(fun (asl,gl) ->
       let ai = grab asl (fun th ->
         hd_is "abs_ml_inv" (concl th) &&
         (try hd_is "sptree_insert"
                (el 2 (snd(strip_comb (concl th))))
          with Failure _ -> false)) in
       EXISTS_TAC
         (el 0 (tparts (el 3 (snd(strip_comb (concl ai))))))) THEN
     REWRITE_TAC[MAP; FST; SND; ALL2; HD; TL; NOT_CONS_NIL] THEN
     CONV_TAC(TOP_DEPTH_CONV BETA_CONV) THEN
     REWRITE_TAC(word_addr_clauses () @ [smn; and4]) THEN
     TRY (FIRST_ASSUM (fun an ->
       if not (try hd_is "ref_ptr_annot" (lhs (concl an))
               with Failure _ -> false) then fail() else
       FIRST_ASSUM (fun lk ->
         if not (try hd_is "sptree_lookup" (lhs (concl lk))
                 with Failure _ -> false) then fail() else
         REWRITE_TAC[REWRITE_RULE[lk] an]))) THEN
     ASM_REWRITE_TAC[] THEN
     REPEAT CONJ_TAC THEN TRY (FIRST_ASSUM ACCEPT_TAC);
     FIRST_ASSUM ACCEPT_TAC;
     FIRST_ASSUM ACCEPT_TAC] THEN
   (* the store, whose memory is the one written *)
   REWRITE_TAC[heap_in_memory_store_def] THEN
   W(fun (asl,gl) ->
     let nh = rand (find_term (fun t ->
       hd_is "heap_length" t && hd_is "APPEND" (rand t)) gl) in
     let oh = rand (lhs (concl (grab asl is_hl))) in
     if nh = oh then ALL_TAC else
     SUBGOAL_THEN (mk_eq (mk_icomb (`heap_length`,nh),
                          mk_icomb (`heap_length`,oh)))
       (fun le -> REWRITE_TAC[le]) THENL
      [REWRITE_TAC[heap_length_APPEND; heap_length_CONS;
                   heap_length_NIL; BlockRep_def; el_length_def;
                   LENGTH_APPEND; LENGTH] THEN ARITH_TAC;
       ALL_TAC]) THEN
   REPEAT CONJ_TAC THEN TRY (FIRST_ASSUM ACCEPT_TAC) THEN
   W(fun (asl,gl) ->
     let cu = grab asl (fun th ->
       hd_is "FLOOKUP" (lhs (concl th)) &&
       fst(dest_const (rand (lhs (concl th)))) = "CurrHeap") in
     let ot = grab asl (fun th ->
       hd_is "FLOOKUP" (lhs (concl th)) &&
       fst(dest_const (rand (lhs (concl th)))) = "OtherHeap") in
     MAP_EVERY EXISTS_TAC [rand (rand (rhs (concl cu)));
                           rand (rand (rhs (concl ot)))]) THEN
   REPEAT CONJ_TAC THEN TRY (FIRST_ASSUM ACCEPT_TAC) THEN
   (* the heap of the write, with the cell of the new root *)
   REWRITE_TAC[word_heap_APPEND; word_heap_def; BlockRep_def] THEN
   CONV_TAC(TOP_DEPTH_CONV let_CONV) THEN
   REWRITE_TAC[word_el_def] THEN
   CONV_TAC(TOP_DEPTH_CONV let_CONV) THEN
   REWRITE_TAC[word_payload_def] THEN
   CONV_TAC(TOP_DEPTH_CONV let_CONV) THEN
   REWRITE_TAC[MAP_APPEND; MAP; word_list_APPEND;
               word_list_def; LENGTH_MAP] THEN
   ASM_REWRITE_TAC[addreq] THEN
   REWRITE_TAC[emp_STAR; STAR_emp; STAR_ASSOC] THEN
   (* the element is as long as it was *)
   RULE_ASSUM_TRY (REWRITE_RULE[el_length_def]) THEN
   REWRITE_TAC[el_length_def; LENGTH_APPEND; LENGTH] THEN
   W(fun (asl,gl) ->
     let le = grab asl (fun th ->
       is_eq (concl th) && hd_is "LENGTH" (lhs (concl th)) &&
       hd_is "APPEND" (rand (lhs (concl th)))) in
     REWRITE_TAC[REWRITE_RULE[LENGTH_APPEND; LENGTH] le]) THEN
   W(fun (asl,gl) ->
     let pred = rator gl in
     let fs = facs pred in
     let cell = find (hd_is "cond") fs in
     let rest = filter (fun t -> not (t = cell)) fs in
     let st = fst(strip_comb pred) in
     let mk a b = mk_comb(mk_comb(st,a),b) in
     SUBGOAL_THEN (mk_eq (pred, mk cell (end_itlist mk rest)))
       SUBST1_TAC THENL
      [REWRITE_TAC[STAR_AC; emp_STAR; STAR_emp]; ALL_TAC]) THEN
   REWRITE_TAC[cond_STAR] THEN
   CONJ_TAC THENL
    [REWRITE_TAC[LENGTH_APPEND; LENGTH] THEN
     ASM_REWRITE_TAC[] THEN TRY ASM_ARITH_TAC;
     ALL_TAC] THEN
   (* the write of the root into the cell of the hole *)
   W(fun (asl,gl) ->
     let wv = rand (rator (fst (dest_pair (rand (rand gl))))) in
     FIRST_ASSUM (fun sep ->
       if not (try hd_is "STAR" (rator (concl sep))
               with Failure _ -> false) then fail() else
       let th = SPEC wv (MATCH_MP write_fun2set sep) in
       let eq = prove (mk_eq (rator gl, rator (concl th)),
                 REWRITE_TAC[STAR_AC; emp_STAR; STAR_emp]) in
       ACCEPT_TAC (REWRITE_RULE[GSYM eq] th)))))
### memory_rel_UpdateThunk_NotEvaluated
(* the proof of the source names memory_rel_def, word_ml_inv_def,
   update_thunk_thm, LENGTH_EQ_1 and word_addr_def, and writes the
   cell with HOL4's SEP_W_TAC.  Here update_thunk_thm (at
   NotEvaluated, where its last hypothesis is vacuous) gives the
   roots -- the root of the value and the pointer of the reference
   -- and the store of the new thunk; roots_ok says the heap has a
   data element at that pointer, which thunk_deref makes the thunk
   that was not evaluated, and heap_lookup_SPLIT and
   heap_store_lemma make the old heap and the new one the same but
   for that element.  The address is get_real_addr_get_addr's, the
   cell of the value is the second of the element (its cond says
   the element has one word), and the write of the root into it is
   write_fun2set: the header of the new element is the header of
   the old one, because both hold one word *)
  (let len1 = prove
   (`!l. LENGTH (l:(A)list) = 1 <=> ?x. l = [x]`,
    GEN_TAC THEN
    STRUCT_CASES_TAC (ISPEC `l:(A)list` list_CASES) THEN
    REWRITE_TAC[LENGTH; CONS_11; NOT_CONS_NIL; ARITH_EQ] THEN
    REWRITE_TAC[ARITH_RULE `SUC n = 1 <=> n = 0`; LENGTH_EQ_NIL] THEN
    MESON_TAC[]) in

  let rec facs t =
    if hd_is "STAR" t then
      let args = snd (strip_comb t) in
      facs (el 0 args) @ facs (el 1 args)
    else [t] in

  let sfront nm sep =
    let pred = rator (concl sep) in
    let fs = facs pred in
    let cell = find (hd_is nm) fs in
    let rest = filter (fun t -> not (t = cell)) fs in
    let st = fst (strip_comb pred) in
    let mk x y = mk_comb (mk_comb (st,x),y) in
    let target = mk cell (end_itlist mk rest) in
    let eq = prove (mk_eq (pred,target), REWRITE_TAC[STAR_AC]) in
    REWRITE_RULE[eq] sep in
  let grab asl p =
    tryfind (fun (_,th) ->
      if (try p th with Failure _ -> false) then th else fail())
      asl in
  let nev = prove (`~(NotEvaluated = Evaluated)`,
    MESON_TAC[distinctness "thunk_mode"]) in
  let utn = REWRITE_RULE[EQF_INTRO nev]
    (INST [`NotEvaluated`,`ev:thunk_mode`] update_thunk_thm) in
  STRIP_TAC THEN
  FIRST_ASSUM (fun mr ->
    if hd_is "memory_rel" (concl mr)
    then STRIP_ASSUME_TAC (REWRITE_RULE[memory_rel_def] mr)
    else fail()) THEN
  FIRST_ASSUM (fun h ->
    if hd_is "heap_in_memory_store" (concl h)
    then STRIP_ASSUME_TAC
           (REWRITE_RULE[heap_in_memory_store_def] h)
    else fail()) THEN
  FIRST_ASSUM (fun wi ->
    if hd_is "word_ml_inv" (concl wi)
    then STRIP_ASSUME_TAC (REWRITE_RULE[word_ml_inv_def] wi)
    else fail()) THEN
  RULE_ASSUM_TRY (REWRITE_RULE[MAP; FST; SND]) THEN
  FIRST_ASSUM (fun ai ->
    if not (hd_is "abs_ml_inv" (concl ai)) then fail() else
    FIRST_ASSUM (fun lk ->
      if not (try hd_is "sptree_lookup" (lhs (concl lk))
              with Failure _ -> false) then fail() else
      STRIP_ASSUME_TAC (MATCH_MP (GEN_ALL utn) (CONJ ai lk)))) THEN
  (* the roots are the root of the value and the pointer *)
  FIRST_ASSUM (fun e ->
    if not (try is_eq (concl e) && is_var (lhs (concl e)) &&
                hd_is "CONS" (rhs (concl e))
            with Failure _ -> false) then fail() else
    SUBST_ALL_TAC e) THEN
  RULE_ASSUM_TRY (REWRITE_RULE[ALL2]) THEN
  REPEAT (FIRST_X_ASSUM (CONJUNCTS_THEN ASSUME_TAC)) THEN
  (* the heap has a data element at the pointer *)
  FIRST_ASSUM (fun ai ->
    if not (hd_is "abs_ml_inv" (concl ai) &&
            not (hd_is "sptree_insert"
                   (el 2 (snd (strip_comb (concl ai))))))
    then fail() else
    STRIP_ASSUME_TAC (REWRITE_RULE[abs_ml_inv_def] ai)) THEN
  FIRST_ASSUM (fun rk ->
    if not (hd_is "roots_ok" (concl rk)) then fail() else
    MP_TAC (REWRITE_RULE[roots_ok_def; MEM] rk)) THEN
  W(fun (asl,gl) ->
    let td = grab asl (fun th ->
      try hd_is "thunk_deref" (lhs (concl th))
      with Failure _ -> false) in
    let pp = lhand (lhs (concl td)) in
    let wa = grab asl (fun th ->
      try hd_is "word_addr" (lhs (concl th)) &&
          hd_is "gc_shared_Pointer" (rand (lhs (concl th))) &&
          lhand (rand (lhs (concl th))) = pp
      with Failure _ -> false) in
    let uu = rand (rand (lhs (concl wa))) in
    DISCH_THEN (fun rk -> MP_TAC (SPECL [pp; uu] rk))) THEN
  REWRITE_TAC[] THEN
  REWRITE_TAC[isSomeDataElement_def] THEN
  DISCH_THEN STRIP_ASSUME_TAC THEN
  (* which is the thunk that was not evaluated *)
  FIRST_ASSUM (fun hl ->
    if not (try is_eq (concl hl) &&
                hd_is "heap_lookup" (lhs (concl hl))
            with Failure _ -> false) then fail() else
    FIRST_ASSUM (fun td ->
      if not (try hd_is "thunk_deref" (lhs (concl td))
              with Failure _ -> false) then fail() else
      MP_TAC (REWRITE_RULE[thunk_deref_def; hl] td))) THEN
  EVERY_CASE_TAC THEN
  REWRITE_TAC[distinctness "option"; injectivity "option"] THEN
  DISCH_THEN (SUBST_ALL_TAC o SYM) THEN
  (* the heap splits at the pointer *)
  FIRST_ASSUM (fun hl ->
    if not (try is_eq (concl hl) &&
                hd_is "heap_lookup" (lhs (concl hl))
            with Failure _ -> false) then fail() else
    STRIP_ASSUME_TAC (MATCH_MP heap_lookup_SPLIT hl)) THEN
  REPEAT (FIRST_X_ASSUM (fun e ->
    if not (try is_eq (concl e) && is_var (lhs (concl e)) &&
                (hd_is "APPEND" (rhs (concl e)) ||
                 hd_is "heap_length" (rhs (concl e)))
            with Failure _ -> false) then fail() else
    SUBST_ALL_TAC e)) THEN
  (* and the store put the new thunk there *)
  FIRST_ASSUM (fun hs ->
    if not (try is_eq (concl hs) &&
                hd_is "heap_store" (lhs (concl hs))
            with Failure _ -> false) then fail() else
    MP_TAC (REWRITE_RULE[heap_store_lemma; PAIR_EQ;
              ThunkBlock_def; heap_length_def; el_length_def; MAP;
              SUM_DEF; ITLIST] hs)) THEN
  CONV_TAC NUM_REDUCE_CONV THEN
  DISCH_THEN STRIP_ASSUME_TAC THEN
  (* the element has one word *)
  SUBGOAL_THEN `l = 1` SUBST_ALL_TAC THENL
   [ASM_ARITH_TAC; ALL_TAC] THEN
  (* the address of the pointer *)
  FIRST_ASSUM (fun hb ->
    if not (try hd_is "<=" (concl hb) with Failure _ -> false)
    then fail() else
    FIRST_ASSUM (fun hl ->
      if not (try is_eq (concl hl) &&
                  hd_is "heap_lookup" (lhs (concl hl))
              with Failure _ -> false) then fail() else
      FIRST_ASSUM (fun ch ->
        if not (try is_eq (concl ch) &&
                    hd_is "FLOOKUP" (lhs (concl ch))
                with Failure _ -> false) then fail() else
        FIRST_ASSUM (fun gd ->
          if not (hd_is "good_dimindex" (concl gd)) then fail() else
          STRIP_ASSUME_TAC (MATCH_MP (GEN_ALL get_real_addr_get_addr)
            (CONJ hb (CONJ hl (CONJ ch gd)))))))) THEN
  RULE_ASSUM_TRY (REWRITE_RULE(word_addr_clauses ())) THEN
  W(fun (asl,gl) ->
    let wa = grab asl (fun th ->
      try is_eq (concl th) &&
          hd_is "wordLang_Word" (lhs (concl th)) &&
          hd_is "get_addr" (rand (lhs (concl th)))
      with Failure _ -> false) in
    let uu = rand (rand (lhs (concl wa))) in
    let fa = grab asl (fun th ->
      is_forall (concl th) &&
      (try can (find_term (hd_is "get_real_addr")) (concl th)
       with Failure _ -> false)) in
    STRIP_ASSUME_TAC (SPEC uu fa)) THEN
  (* so the goal is about that address *)
  W(fun (asl,gl) ->
    let wa = grab asl (fun th ->
      try is_eq (concl th) &&
          hd_is "wordLang_Word" (lhs (concl th)) &&
          hd_is "get_addr" (rand (lhs (concl th)))
      with Failure _ -> false) in
    let pw = rand (lhs (concl wa)) in
    let gra = grab asl (fun th ->
      try is_eq (concl th) &&
          hd_is "get_real_addr" (lhs (concl th))
      with Failure _ -> false) in
    let xv = rand (rhs (concl gra)) in
    MAP_EVERY EXISTS_TAC [pw; xv]) THEN
  (* the two cells of the thunk *)
  FIRST_ASSUM (fun sep ->
    if not (try hd_is "STAR" (rator (concl sep))
            with Failure _ -> false) then fail() else
    MP_TAC (REWRITE_RULE[word_heap_APPEND; word_heap_def;
      word_el_def; el_length_def] sep)) THEN
  CONV_TAC (TOP_DEPTH_CONV let_CONV) THEN
  REWRITE_TAC[word_payload_def] THEN
  CONV_TAC (TOP_DEPTH_CONV let_CONV) THEN
  REWRITE_TAC[word_list_def; STAR_ASSOC] THEN
  DISCH_THEN (fun sep ->
     STRIP_ASSUME_TAC (REWRITE_RULE[cond_STAR]
       (sfront "cond" sep))) THEN
  FIRST_ASSUM (fun le ->
    if not (try is_eq (concl le) && hd_is "LENGTH" (lhs (concl le))
            with Failure _ -> false) then fail() else
    STRIP_ASSUME_TAC (REWRITE_RULE[len1] le)) THEN
  REPEAT (FIRST_X_ASSUM (fun e ->
    if not (try is_eq (concl e) && is_var (lhs (concl e)) &&
                hd_is "CONS" (rhs (concl e))
            with Failure _ -> false) then fail() else
    SUBST_ALL_TAC e)) THEN
  RULE_ASSUM_TRY (REWRITE_RULE[MAP; word_list_def; STAR_ASSOC;
                              emp_STAR; STAR_emp]) THEN
  (* the cell of the value is in the memory and can be written *)
  FIRST_ASSUM (fun sep ->
    if not (try hd_is "STAR" (rator (concl sep))
            with Failure _ -> false) then fail() else
    let isp t = hd_is "set_sep_one" t &&
      (try let a = fst (dest_pair (rand t)) in
           hd_is "word_add" a && hd_is "bytes_in_word" (rand a)
       with Failure _ -> false) in
    let pred = rator (concl sep) in
    let fs = facs pred in
    let cell = find isp fs in
    let rest = filter (fun t -> not (t = cell)) fs in
    let st = fst (strip_comb pred) in
    let mk x y = mk_comb (mk_comb (st,x),y) in
    let target = mk cell (end_itlist mk rest) in
    let eq = prove (mk_eq (pred,target), REWRITE_TAC[STAR_AC]) in
    let sep' = REWRITE_RULE[eq] sep in
    STRIP_ASSUME_TAC (MATCH_MP read_fun2set sep') THEN
    ASSUME_TAC (MATCH_MP write_fun2set sep')) THEN
  (* the first three conjuncts *)
  REPEAT CONJ_TAC THENL
   [FIRST_ASSUM (fun wa ->
      if not (try is_eq (concl wa) &&
                  hd_is "wordLang_Word" (lhs (concl wa)) &&
                  hd_is "get_addr" (rand (lhs (concl wa)))
              with Failure _ -> false) then fail() else
      ACCEPT_TAC (SYM wa));
    FIRST_ASSUM ACCEPT_TAC;
    W(fun (asl,gl) ->
      let ind = grab asl (fun th ->
         try hd_is "IN" (concl th) &&
             hd_is "word_add" (lhand (concl th))
        with Failure _ -> false) in
      SUBST1_TAC (WORD_RULE (mk_eq (lhand gl, lhand (concl ind)))) THEN
      ACCEPT_TAC ind);
    ALL_TAC] THEN
  (* the invariant with the new thunk in the heap *)
  REWRITE_TAC[memory_rel_def] THEN
  W(fun (asl,gl) ->
    let ai = grab asl (fun th ->
      hd_is "abs_ml_inv" (concl th) &&
      (try hd_is "sptree_insert"
             (el 2 (snd (strip_comb (concl th))))
       with Failure _ -> false)) in
    let args = snd (strip_comb (concl ai)) in
    let ps = tparts (el 3 args) in
    MAP_EVERY EXISTS_TAC [el 1 ps; el 4 args; el 3 ps; el 4 ps;
                          el 5 ps; el 6 ps]) THEN
  REPEAT CONJ_TAC THEN TRY (FIRST_ASSUM ACCEPT_TAC) THEN
  TRY (REWRITE_TAC[word_ml_inv_def] THEN
       W(fun (asl,gl) ->
         let ai = grab asl (fun th ->
           hd_is "abs_ml_inv" (concl th) &&
           (try hd_is "sptree_insert"
                  (el 2 (snd (strip_comb (concl th))))
            with Failure _ -> false)) in
         EXISTS_TAC (el 0 (tparts (el 3 (snd (strip_comb
           (concl ai))))))) THEN
       REWRITE_TAC[MAP; FST; SND; ALL2] THEN
       REWRITE_TAC(word_addr_clauses ()) THEN
       ASM_REWRITE_TAC[] THEN NO_TAC) THEN
  (* the store, whose memory is the written one *)
  REWRITE_TAC[heap_in_memory_store_def] THEN
  RULE_ASSUM_TRY (REWRITE_RULE[LENGTH]) THEN
  (* the new heap is as long as the old one *)
  W(fun (asl,gl) ->
    let h2 = grab asl (fun th ->
      try is_eq (concl th) && hd_is "APPEND" (lhs (concl th))
      with Failure _ -> false) in
    let sep = grab asl (fun th ->
      try hd_is "STAR" (rator (concl th)) &&
          length (filter (hd_is "word_heap")
                    (facs (rator (concl th)))) = 2
      with Failure _ -> false) in
    let oldheap = el 1 (snd (strip_comb
      (hd (filter (hd_is "word_heap")
             (facs (rator (concl sep))))))) in
    let hl t = mk_icomb (`heap_length`, t) in
    SUBGOAL_THEN (mk_eq (hl (rhs (concl h2)), hl oldheap))
      (fun le -> REWRITE_TAC[le]) THENL
     [REWRITE_TAC[SYM h2; APPEND] THEN
      REWRITE_TAC[heap_length_APPEND] THEN
      REWRITE_TAC[heap_length_CONS; el_length_def] THEN
      ARITH_TAC;
      ALL_TAC]) THEN
  REPEAT CONJ_TAC THEN TRY (FIRST_ASSUM ACCEPT_TAC) THEN
  FIRST_ASSUM (fun sep ->
    if not (try hd_is "STAR" (rator (concl sep))
            with Failure _ -> false) then fail() else
    let fs = facs (rator (concl sep)) in
    let whs = filter (hd_is "word_heap") fs in
    if not (length whs = 2) then fail() else
    MAP_EVERY EXISTS_TAC
      [el 0 (snd (strip_comb (el 0 whs)));
       el 0 (snd (strip_comb (el 1 whs)))]) THEN
  REPEAT CONJ_TAC THEN TRY (FIRST_ASSUM ACCEPT_TAC) THEN
  FIRST_ASSUM (fun h2 ->
    if not (try is_eq (concl h2) && hd_is "APPEND" (lhs (concl h2))
            with Failure _ -> false) then fail() else
    REWRITE_TAC[SYM h2]) THEN
  REWRITE_TAC[word_heap_APPEND; word_heap_def; word_el_def;
              el_length_def] THEN
  CONV_TAC (TOP_DEPTH_CONV let_CONV) THEN
  REWRITE_TAC[word_payload_def] THEN
  CONV_TAC (TOP_DEPTH_CONV let_CONV) THEN
  REWRITE_TAC[word_list_def; MAP; LENGTH; STAR_ASSOC] THEN
  W(fun (asl,gl) ->
    let pred = rator gl in
    let fs = facs pred in
    let cell = find (hd_is "cond") fs in
    let rest = filter (fun t -> not (t = cell)) fs in
    let st = fst (strip_comb pred) in
    let mk x y = mk_comb (mk_comb (st,x),y) in
    let target = mk cell (end_itlist mk rest) in
    SUBGOAL_THEN (mk_eq (pred,target)) SUBST1_TAC THENL
     [REWRITE_TAC[STAR_AC]; ALL_TAC]) THEN
  REWRITE_TAC[cond_STAR] THEN
  CONJ_TAC THENL
   [REWRITE_TAC[LENGTH] THEN CONV_TAC NUM_REDUCE_CONV THEN
    RULE_ASSUM_TRY (REWRITE_RULE[LENGTH]) THEN
    RULE_ASSUM_TRY (CONV_RULE NUM_REDUCE_CONV) THEN
    ASM_REWRITE_TAC[] THEN TRY (CONV_TAC NUM_REDUCE_CONV);
    ALL_TAC] THEN
  ASM_REWRITE_TAC[] THEN
  CONV_TAC NUM_REDUCE_CONV THEN
  REWRITE_TAC[heap_length_CONS; heap_length_NIL; el_length_def] THEN
  CONV_TAC NUM_REDUCE_CONV THEN
  REWRITE_TAC[emp_STAR; STAR_emp; STAR_ASSOC] THEN
  RULE_ASSUM_TRY (CONV_RULE NUM_REDUCE_CONV) THEN
  RULE_ASSUM_TRY (REWRITE_RULE[emp_STAR; STAR_emp; STAR_ASSOC]) THEN
  (* the address of the write, as the cell of the thunk has it *)
  W(fun (asl,gl) ->
    let upd = fst (dest_pair (rand (rand gl))) in
    let gaddr = lhand (rator upd) in
    let ind = grab asl (fun th ->
      try hd_is "IN" (concl th) &&
          hd_is "word_add" (lhand (concl th))
      with Failure _ -> false) in
    let taddr = lhand (concl ind) in
    if gaddr = taddr then ALL_TAC
    else SUBST1_TAC (WORD_RULE (mk_eq (gaddr, taddr)))) THEN
  W(fun (asl,gl) ->
    let pred = rator gl in
    let wv = rand (rator (fst (dest_pair (rand (rand gl))))) in
    FIRST_ASSUM (fun wth ->
      let th = (try SPEC wv wth with Failure _ -> wth) in
      let wp = rator (concl th) in
      if not (hd_is "STAR" wp) then fail() else
      let eq = prove (mk_eq (pred,wp),
                REWRITE_TAC[STAR_AC; emp_STAR; STAR_emp]) in
      ACCEPT_TAC (REWRITE_RULE[GSYM eq] th))))
### memory_rel_UpdateThunk_Evaluated
(* the same proof as memory_rel_UpdateThunk_NotEvaluated, which the
   source names the same theorems for -- memory_rel_def,
   word_ml_inv_def, update_thunk_thm, LENGTH_EQ_1, word_addr_def,
   thunk_deref_def, get_real_addr_get_addr, heap_lookup_SPLIT and
   the store lemma -- but now the mode of the thunk changes, so the
   header of the new element is another word than the header of the
   old one: encode_header_def says the hdr of the statement is
   make_header of n2w 14, thunk_tag_bits_lemma says the bits of an
   evaluated thunk with the six are that same word, and so the two
   cells that write_fun2set writes are the header and the root of
   the value; the cond of the new element is the length that
   encode_header_IMP reads back off the hdr (what HOL4 does with
   SEP_R_TAC and SEP_W_TAC) *)
  (let len1 = prove
   (`!l. LENGTH (l:(A)list) = 1 <=> ?x. l = [x]`,
    GEN_TAC THEN
    STRUCT_CASES_TAC (ISPEC `l:(A)list` list_CASES) THEN
    REWRITE_TAC[LENGTH; CONS_11; NOT_CONS_NIL; ARITH_EQ] THEN
    REWRITE_TAC[ARITH_RULE `SUC n = 1 <=> n = 0`; LENGTH_EQ_NIL] THEN
    MESON_TAC[]) in

  let rec facs t =
    if hd_is "STAR" t then
      let args = snd (strip_comb t) in
      facs (el 0 args) @ facs (el 1 args)
    else [t] in

  let sfront nm sep =
    let pred = rator (concl sep) in
    let fs = facs pred in
    let cell = find (hd_is nm) fs in
    let rest = filter (fun t -> not (t = cell)) fs in
    let st = fst (strip_comb pred) in
    let mk x y = mk_comb (mk_comb (st,x),y) in
    let target = mk cell (end_itlist mk rest) in
    let eq = prove (mk_eq (pred,target), REWRITE_TAC[STAR_AC]) in
    REWRITE_RULE[eq] sep in
  let grab asl p =
    tryfind (fun (_,th) ->
      if (try p th with Failure _ -> false) then th else fail())
      asl in
  let utn = INST [`Evaluated`,`ev:thunk_mode`] update_thunk_thm in
  let indm =
    W(fun (asl,gl) ->
      tryfind (fun (_,th) ->
        if not (try hd_is "IN" (concl th)
                with Failure _ -> false) then fail() else
        let eq = WORD_RULE (mk_eq (lhand gl, lhand (concl th))) in
        SUBST1_TAC eq THEN ACCEPT_TAC th) asl) in
  let someif = prove
   (`!p (x:A) y. (if p then SOME x else NONE) = SOME y ==> x = y`,
    REPEAT GEN_TAC THEN COND_CASES_TAC THEN
    REWRITE_TAC[distinctness "option"; injectivity "option"]) in
  STRIP_TAC THEN
  (* what encode_header gave back is make_header of the tag *)
  FIRST_ASSUM (fun eh ->
    if not (try hd_is "encode_header" (lhs (concl eh))
            with Failure _ -> false) then fail() else
    ASSUME_TAC (CONV_RULE NUM_REDUCE_CONV (MATCH_MP someif
      (REWRITE_RULE[encode_header_def] eh)))) THEN
  FIRST_ASSUM (fun mr ->
    if hd_is "memory_rel" (concl mr)
    then STRIP_ASSUME_TAC (REWRITE_RULE[memory_rel_def] mr)
    else fail()) THEN
  FIRST_ASSUM (fun h ->
    if hd_is "heap_in_memory_store" (concl h)
    then STRIP_ASSUME_TAC
           (REWRITE_RULE[heap_in_memory_store_def] h)
    else fail()) THEN
  FIRST_ASSUM (fun wi ->
    if hd_is "word_ml_inv" (concl wi)
    then STRIP_ASSUME_TAC (REWRITE_RULE[word_ml_inv_def] wi)
    else fail()) THEN
  RULE_ASSUM_TRY (REWRITE_RULE[MAP; FST; SND]) THEN
  FIRST_ASSUM (fun ai ->
    if not (hd_is "abs_ml_inv" (concl ai)) then fail() else
    FIRST_ASSUM (fun lk ->
      if not (try hd_is "sptree_lookup" (lhs (concl lk))
              with Failure _ -> false) then fail() else
      FIRST_ASSUM (fun dt ->
        if not (try hd_is "dataSem_dest_thunk" (lhs (concl dt)) ||
                    hd_is "dest_thunk" (lhs (concl dt))
                with Failure _ -> false) then fail() else
        STRIP_ASSUME_TAC (MATCH_MP (GEN_ALL utn)
          (CONJ ai (CONJ lk
             (DISCH `(Evaluated:thunk_mode) = Evaluated` dt))))))) THEN
  REWRITE_TAC[UPDATE_LIST_THM; FST; SND] THEN
  (* the roots are the root of the value and the pointer *)
  FIRST_ASSUM (fun e ->
    if not (try is_eq (concl e) && is_var (lhs (concl e)) &&
                hd_is "CONS" (rhs (concl e))
            with Failure _ -> false) then fail() else
    SUBST_ALL_TAC e) THEN
  RULE_ASSUM_TRY (REWRITE_RULE[ALL2]) THEN
  REPEAT (FIRST_X_ASSUM (CONJUNCTS_THEN ASSUME_TAC)) THEN
  (* the heap has a data element at the pointer *)
  FIRST_ASSUM (fun ai ->
    if not (hd_is "abs_ml_inv" (concl ai) &&
            not (hd_is "sptree_insert"
                   (el 2 (snd (strip_comb (concl ai))))))
    then fail() else
    STRIP_ASSUME_TAC (REWRITE_RULE[abs_ml_inv_def] ai)) THEN
  FIRST_ASSUM (fun rk ->
    if not (hd_is "roots_ok" (concl rk)) then fail() else
    MP_TAC (REWRITE_RULE[roots_ok_def; MEM] rk)) THEN
  W(fun (asl,gl) ->
    let td = grab asl (fun th ->
      try hd_is "thunk_deref" (lhs (concl th))
      with Failure _ -> false) in
    let pp = lhand (lhs (concl td)) in
    let wa = grab asl (fun th ->
      try hd_is "word_addr" (lhs (concl th)) &&
          hd_is "gc_shared_Pointer" (rand (lhs (concl th))) &&
          lhand (rand (lhs (concl th))) = pp
      with Failure _ -> false) in
    let uu = rand (rand (lhs (concl wa))) in
    DISCH_THEN (fun rk -> MP_TAC (SPECL [pp; uu] rk))) THEN
  REWRITE_TAC[] THEN
  REWRITE_TAC[isSomeDataElement_def] THEN
  DISCH_THEN STRIP_ASSUME_TAC THEN
  (* which is the thunk that was not evaluated *)
  FIRST_ASSUM (fun hl ->
    if not (try is_eq (concl hl) &&
                hd_is "heap_lookup" (lhs (concl hl))
            with Failure _ -> false) then fail() else
    FIRST_ASSUM (fun td ->
      if not (try hd_is "thunk_deref" (lhs (concl td))
              with Failure _ -> false) then fail() else
      MP_TAC (REWRITE_RULE[thunk_deref_def; hl] td))) THEN
  EVERY_CASE_TAC THEN
  REWRITE_TAC[distinctness "option"; injectivity "option"] THEN
  DISCH_THEN (SUBST_ALL_TAC o SYM) THEN
  (* the heap splits at the pointer *)
  FIRST_ASSUM (fun hl ->
    if not (try is_eq (concl hl) &&
                hd_is "heap_lookup" (lhs (concl hl))
            with Failure _ -> false) then fail() else
    STRIP_ASSUME_TAC (MATCH_MP heap_lookup_SPLIT hl)) THEN
  REPEAT (FIRST_X_ASSUM (fun e ->
    if not (try is_eq (concl e) && is_var (lhs (concl e)) &&
                (hd_is "APPEND" (rhs (concl e)) ||
                 hd_is "heap_length" (rhs (concl e)))
            with Failure _ -> false) then fail() else
    SUBST_ALL_TAC e)) THEN
  (* and the store put the new thunk there *)
  FIRST_ASSUM (fun hs ->
    if not (try is_eq (concl hs) &&
                hd_is "heap_store" (lhs (concl hs))
            with Failure _ -> false) then fail() else
    MP_TAC (REWRITE_RULE[heap_store_lemma; PAIR_EQ;
              ThunkBlock_def; heap_length_def; el_length_def; MAP;
              SUM_DEF; ITLIST] hs)) THEN
  CONV_TAC NUM_REDUCE_CONV THEN
  DISCH_THEN STRIP_ASSUME_TAC THEN
  (* the element has one word *)
  SUBGOAL_THEN `l = 1` SUBST_ALL_TAC THENL
   [ASM_ARITH_TAC; ALL_TAC] THEN
  (* the address of the pointer *)
  FIRST_ASSUM (fun hb ->
    if not (try hd_is "<=" (concl hb) with Failure _ -> false)
    then fail() else
    FIRST_ASSUM (fun hl ->
      if not (try is_eq (concl hl) &&
                  hd_is "heap_lookup" (lhs (concl hl))
              with Failure _ -> false) then fail() else
      FIRST_ASSUM (fun ch ->
        if not (try is_eq (concl ch) &&
                    hd_is "FLOOKUP" (lhs (concl ch))
                with Failure _ -> false) then fail() else
        FIRST_ASSUM (fun gd ->
          if not (hd_is "good_dimindex" (concl gd)) then fail() else
          STRIP_ASSUME_TAC (MATCH_MP (GEN_ALL get_real_addr_get_addr)
            (CONJ hb (CONJ hl (CONJ ch gd)))))))) THEN
  RULE_ASSUM_TRY (REWRITE_RULE(word_addr_clauses ())) THEN
  W(fun (asl,gl) ->
    let wa = grab asl (fun th ->
      try is_eq (concl th) &&
          hd_is "wordLang_Word" (lhs (concl th)) &&
          hd_is "get_addr" (rand (lhs (concl th)))
      with Failure _ -> false) in
    let uu = rand (rand (lhs (concl wa))) in
    let fa = grab asl (fun th ->
      is_forall (concl th) &&
      (try can (find_term (hd_is "get_real_addr")) (concl th)
       with Failure _ -> false)) in
    STRIP_ASSUME_TAC (SPEC uu fa)) THEN
  (* so the goal is about that address *)
  W(fun (asl,gl) ->
    let wa = grab asl (fun th ->
      try is_eq (concl th) &&
          hd_is "wordLang_Word" (lhs (concl th)) &&
          hd_is "get_addr" (rand (lhs (concl th)))
      with Failure _ -> false) in
    let pw = rand (lhs (concl wa)) in
    let gra = grab asl (fun th ->
      try is_eq (concl th) &&
          hd_is "get_real_addr" (lhs (concl th))
      with Failure _ -> false) in
    let xv = rand (rhs (concl gra)) in
    MAP_EVERY EXISTS_TAC [pw; xv]) THEN
  (* the two cells of the thunk *)
  FIRST_ASSUM (fun sep ->
    if not (try hd_is "STAR" (rator (concl sep))
            with Failure _ -> false) then fail() else
    MP_TAC (REWRITE_RULE[word_heap_APPEND; word_heap_def;
      word_el_def; el_length_def] sep)) THEN
  CONV_TAC (TOP_DEPTH_CONV let_CONV) THEN
  REWRITE_TAC[word_payload_def] THEN
  CONV_TAC (TOP_DEPTH_CONV let_CONV) THEN
  REWRITE_TAC[word_list_def; STAR_ASSOC] THEN
  DISCH_THEN (fun sep ->
     STRIP_ASSUME_TAC (REWRITE_RULE[cond_STAR]
       (sfront "cond" sep))) THEN
  FIRST_ASSUM (fun le ->
    if not (try is_eq (concl le) && hd_is "LENGTH" (lhs (concl le))
            with Failure _ -> false) then fail() else
    STRIP_ASSUME_TAC (REWRITE_RULE[len1] le)) THEN
  REPEAT (FIRST_X_ASSUM (fun e ->
    if not (try is_eq (concl e) && is_var (lhs (concl e)) &&
                hd_is "CONS" (rhs (concl e))
            with Failure _ -> false) then fail() else
    SUBST_ALL_TAC e)) THEN
  RULE_ASSUM_TRY (REWRITE_RULE[MAP; word_list_def; STAR_ASSOC;
                              emp_STAR; STAR_emp]) THEN
  (* the two cells of the thunk, read and then written *)
  FIRST_ASSUM (fun sep ->
    if not (try hd_is "STAR" (rator (concl sep))
            with Failure _ -> false) then fail() else
    let front sp cell =
      let pred = rator (concl sp) in
      let fs = facs pred in
      let rest = filter (fun t -> not (t = cell)) fs in
      let st = fst (strip_comb pred) in
      let mk x y = mk_comb (mk_comb (st,x),y) in
      let target = mk cell (end_itlist mk rest) in
      let eq = prove (mk_eq (pred,target),
                REWRITE_TAC[STAR_AC; emp_STAR; STAR_emp]) in
      REWRITE_RULE[eq] sp in
    let ispay t = (try let a = fst (dest_pair (rand t)) in
                       hd_is "word_add" a &&
                       hd_is "bytes_in_word" (rand a)
                   with Failure _ -> false) in
    let cells = filter (hd_is "set_sep_one")
                  (facs (rator (concl sep))) in
    let hdrc = find (fun t -> not (ispay t)) cells in
    MAP_EVERY STRIP_ASSUME_TAC
      (map (fun c -> MATCH_MP read_fun2set (front sep c)) cells) THEN
    W(fun (asl,gl) ->
      let mrl = last (conjuncts gl) in
      let upd1 = el 6 (snd (strip_comb mrl)) in
      let wv1 = rand (rator (rand upd1)) in
      let wh1 = SPEC wv1 (MATCH_MP write_fun2set (front sep hdrc)) in
      let payc = find ispay (facs (rator (concl wh1))) in
      ASSUME_TAC (MATCH_MP write_fun2set (front wh1 payc)))) THEN
  (* the first four conjuncts *)
  REPEAT CONJ_TAC THENL
   [FIRST_ASSUM (fun wa ->
      if not (try is_eq (concl wa) &&
                  hd_is "wordLang_Word" (lhs (concl wa)) &&
                  hd_is "get_addr" (rand (lhs (concl wa)))
              with Failure _ -> false) then fail() else
      ACCEPT_TAC (SYM wa));
    FIRST_ASSUM ACCEPT_TAC;
    indm; indm;
    ALL_TAC] THEN
  (* the invariant with the new thunk in the heap *)
  REWRITE_TAC[memory_rel_def] THEN
  W(fun (asl,gl) ->
    let ai = grab asl (fun th ->
      hd_is "abs_ml_inv" (concl th) &&
      (try hd_is "sptree_insert"
             (el 2 (snd (strip_comb (concl th))))
       with Failure _ -> false)) in
    let args = snd (strip_comb (concl ai)) in
    let ps = tparts (el 3 args) in
    MAP_EVERY EXISTS_TAC [el 1 ps; el 4 args; el 3 ps; el 4 ps;
                          el 5 ps; el 6 ps]) THEN
  REPEAT CONJ_TAC THEN TRY (FIRST_ASSUM ACCEPT_TAC) THEN
  TRY (REWRITE_TAC[word_ml_inv_def] THEN
       W(fun (asl,gl) ->
         let ai = grab asl (fun th ->
           hd_is "abs_ml_inv" (concl th) &&
           (try hd_is "sptree_insert"
                  (el 2 (snd (strip_comb (concl th))))
            with Failure _ -> false)) in
         EXISTS_TAC (el 0 (tparts (el 3 (snd (strip_comb
           (concl ai))))))) THEN
       REWRITE_TAC[MAP; FST; SND; ALL2] THEN
       REWRITE_TAC(word_addr_clauses ()) THEN
       ASM_REWRITE_TAC[] THEN NO_TAC) THEN
  (* the store, whose memory is the written one *)
  REWRITE_TAC[heap_in_memory_store_def] THEN
  RULE_ASSUM_TRY (REWRITE_RULE[LENGTH]) THEN
  (* the new heap is as long as the old one *)
  W(fun (asl,gl) ->
    let h2 = grab asl (fun th ->
      try is_eq (concl th) && hd_is "APPEND" (lhs (concl th))
      with Failure _ -> false) in
    let sep = grab asl (fun th ->
      try hd_is "STAR" (rator (concl th)) &&
          length (filter (hd_is "word_heap")
                    (facs (rator (concl th)))) = 2
      with Failure _ -> false) in
    let oldheap = el 1 (snd (strip_comb
      (hd (filter (hd_is "word_heap")
             (facs (rator (concl sep))))))) in
    let hl t = mk_icomb (`heap_length`, t) in
    SUBGOAL_THEN (mk_eq (hl (rhs (concl h2)), hl oldheap))
      (fun le -> REWRITE_TAC[le]) THENL
     [REWRITE_TAC[SYM h2; APPEND] THEN
      REWRITE_TAC[heap_length_APPEND] THEN
      REWRITE_TAC[heap_length_CONS; el_length_def] THEN
      ARITH_TAC;
      ALL_TAC]) THEN
  REPEAT CONJ_TAC THEN TRY (FIRST_ASSUM ACCEPT_TAC) THEN
  FIRST_ASSUM (fun sep ->
    if not (try hd_is "STAR" (rator (concl sep))
            with Failure _ -> false) then fail() else
    let fs = facs (rator (concl sep)) in
    let whs = filter (hd_is "word_heap") fs in
    if not (length whs = 2) then fail() else
    MAP_EVERY EXISTS_TAC
      [el 0 (snd (strip_comb (el 0 whs)));
       el 0 (snd (strip_comb (el 1 whs)))]) THEN
  REPEAT CONJ_TAC THEN TRY (FIRST_ASSUM ACCEPT_TAC) THEN
  FIRST_ASSUM (fun h2 ->
    if not (try is_eq (concl h2) && hd_is "APPEND" (lhs (concl h2))
            with Failure _ -> false) then fail() else
    REWRITE_TAC[SYM h2]) THEN
  REWRITE_TAC[word_heap_APPEND; word_heap_def; word_el_def;
              el_length_def] THEN
  CONV_TAC (TOP_DEPTH_CONV let_CONV) THEN
  REWRITE_TAC[word_payload_def] THEN
  CONV_TAC (TOP_DEPTH_CONV let_CONV) THEN
  REWRITE_TAC[word_list_def; MAP; LENGTH; STAR_ASSOC] THEN
  REWRITE_TAC[thunk_tag_bits_lemma] THEN
  FIRST_ASSUM (fun mh ->
    if not (try is_eq (concl mh) &&
                hd_is "make_header" (lhs (concl mh))
            with Failure _ -> false) then fail() else
    REWRITE_TAC[mh]) THEN
  W(fun (asl,gl) ->
    let pred = rator gl in
    let fs = facs pred in
    let cell = find (hd_is "cond") fs in
    let rest = filter (fun t -> not (t = cell)) fs in
    let st = fst (strip_comb pred) in
    let mk x y = mk_comb (mk_comb (st,x),y) in
    let target = mk cell (end_itlist mk rest) in
    SUBGOAL_THEN (mk_eq (pred,target)) SUBST1_TAC THENL
     [REWRITE_TAC[STAR_AC]; ALL_TAC]) THEN
  REWRITE_TAC[cond_STAR] THEN
  CONJ_TAC THENL
   [(* the length that encode_header_IMP reads back off the hdr *)
    REWRITE_TAC[LENGTH] THEN CONV_TAC NUM_REDUCE_CONV THEN
    SUBGOAL_THEN (cake_as_vars (fun () ->
      `data_to_word_config_len_size c + 5 < dimindex (:'a)`))
      ASSUME_TAC THENL [ASM_ARITH_TAC; ALL_TAC] THEN
    FIRST_ASSUM (fun eh ->
      if not (try hd_is "encode_header" (lhs (concl eh))
              with Failure _ -> false) then fail() else
      FIRST_ASSUM (fun c2 ->
        if not (try hd_is "<" (concl c2) &&
                    hd_is "+" (lhand (concl c2))
                with Failure _ -> false) then fail() else
        FIRST_ASSUM (fun gd ->
          if not (hd_is "good_dimindex" (concl gd)) then fail()
          else STRIP_ASSUME_TAC (MATCH_MP encode_header_IMP
            (CONJ eh (CONJ c2 gd)))))) THEN
    ASM_REWRITE_TAC[];
    ALL_TAC] THEN
  ASM_REWRITE_TAC[] THEN
  CONV_TAC NUM_REDUCE_CONV THEN
  REWRITE_TAC[heap_length_CONS; heap_length_NIL; el_length_def] THEN
  CONV_TAC NUM_REDUCE_CONV THEN
  REWRITE_TAC[emp_STAR; STAR_emp; STAR_ASSOC] THEN
  RULE_ASSUM_TRY (CONV_RULE NUM_REDUCE_CONV) THEN
  RULE_ASSUM_TRY (REWRITE_RULE[emp_STAR; STAR_emp; STAR_ASSOC]) THEN
  (* the address of the write, as the cell of the thunk has it *)
  W(fun (asl,gl) ->
    let upd = fst (dest_pair (rand (rand gl))) in
    let ia = lhand (rator (rand upd)) in
    let cells = filter (hd_is "set_sep_one") (facs (rator gl)) in
    let addrs = map (fun c -> fst (dest_pair (rand c))) cells in
    let targ = find (fun a ->
      can WORD_RULE (mk_eq (ia,a))) addrs in
    if targ = ia then ALL_TAC
    else SUBST1_TAC (WORD_RULE (mk_eq (ia,targ)))) THEN
  W(fun (asl,gl) ->
    let upd = fst (dest_pair (rand (rand gl))) in
    let gaddr = lhand (rator upd) in
    let ind = grab asl (fun th ->
      try hd_is "IN" (concl th) &&
          hd_is "word_add" (lhand (concl th))
      with Failure _ -> false) in
    let taddr = lhand (concl ind) in
    if gaddr = taddr then ALL_TAC
    else SUBST1_TAC (WORD_RULE (mk_eq (gaddr, taddr)))) THEN
  W(fun (asl,gl) ->
    let pred = rator gl in
    let wv = rand (rator (fst (dest_pair (rand (rand gl))))) in
    FIRST_ASSUM (fun wth ->
      let th = (try SPEC wv wth with Failure _ -> wth) in
      let wp = rator (concl th) in
      if not (hd_is "STAR" wp) then fail() else
      let eq = prove (mk_eq (pred,wp),
                REWRITE_TAC[STAR_AC; emp_STAR; STAR_emp]) in
      ACCEPT_TAC (REWRITE_RULE[GSYM eq] th))))
### memory_rel_Word64_alt
(* the allocation of a word of sixty-four bits, which is
   memory_rel_Cons1 with word64_alt_thm in place of cons_thm_alt:
   the roots of the values of the stack split off the rest
   (EVERY2_SWAP and EVERY2_APPEND_IMP_APPEND), the element is the
   Word64Rep that the statement says it is -- its words are the
   data of its tag, so no root of it is a pointer -- and the words
   that store_list_thm writes are the header and those.  The
   pointer is make_ptr of the offset, as in memory_rel_Ref, and
   the condition of the payload is that the header encodes the
   length (encode_header_IMP) and is a SOME *)
  ((let hd_is n t =
     (try fst(dest_const(fst(strip_comb t))) = n
      with Failure _ -> false) in
  let rec facs t =
    if hd_is "STAR" t then
      let args = snd(strip_comb t) in
      facs (el 0 args) @ facs (el 1 args)
    else [t] in
  let grab asl p =
    tryfind (fun (_,th) ->
      if (try p th with Failure _ -> false) then th else fail())
      asl in
  let front sp cell =
    let pred = rator (concl sp) in
    let fs = facs pred in
    let rest = filter (fun t -> not (t = cell)) fs in
    let st = fst(strip_comb pred) in
    let mk x y = mk_comb(mk_comb(st,x),y) in
    let target = mk cell (end_itlist mk rest) in
    let eq = prove (mk_eq (pred,target),
              REWRITE_TAC[STAR_AC; emp_STAR; STAR_emp]) in
    REWRITE_RULE[eq] sp in
  (* two steps of an address in one *)
  let addsum = prove
   (`!(a:'a word) x y.
       a + bytes_in_word * n2w x + bytes_in_word * n2w y =
       a + bytes_in_word * n2w (x + y)`,
    REWRITE_TAC[WORD_ADD] THEN CONV_TAC WORD_RULE) in
  (* the bits of a zero word are zero *)
  let bits0 = prove
   (`!h l. word_bits h l ((n2w 0):(N)word) = n2w 0`,
    REWRITE_TAC[word_bits; WORD_EQ_BITS_ALT; BIT_WORD_SUBWORD;
                BIT_WORD_0] THEN
    CONV_TAC TAUT) in
  let someif = prove
   (`!p (x:A) y. (if p then SOME x else NONE) = SOME y ==> x = y`,
    REPEAT GEN_TAC THEN COND_CASES_TAC THEN
    REWRITE_TAC[distinctness "option"; injectivity "option"]) in
  (* the numeric facts that the assumptions give *)
  let numfacts asl =
    mapfilter (fun (_,th) ->
      let c = concl th in
      if (try hd_is "<=" c || hd_is "<" c ||
              (is_eq c && hd_is "LENGTH" (lhs c) &&
               hd_is "LENGTH" (rhs c))
          with Failure _ -> false) then th else fail()) asl in
  let addreq asl t1 t2 =
      let fs = numfacts asl in
      let extra = (try
        let lt = grab asl (fun th ->
          try hd_is "<" (concl th) &&
              hd_is "LENGTH" (lhand (concl th))
          with Failure _ -> false) in
        let spe = grab asl (fun th ->
          try hd_is "<=" (concl th) && is_var (lhand (concl th)) &&
              is_var (rand (concl th))
          with Failure _ -> false) in
        [MATCH_MP (ARITH_RULE
           `!a b c:num. a < b /\ b <= c ==> a + 1 <= c`)
           (CONJ lt spe)]
        with Failure _ -> []) in
      let cnd = end_itlist CONJ (fs @ extra) in
      MP (prove (mk_imp (concl cnd, mk_eq (t1,t2)),
            DISCH_THEN (REPEAT_TCL CONJUNCTS_THEN
              (fun th -> ASSUME_TAC
                 (REWRITE_RULE[LENGTH; ADD1] th))) THEN
            ASM_REWRITE_TAC[el_length_def; LENGTH; ADD1] THEN
            REWRITE_TAC[WORD_SUB; WORD_ADD] THEN
            ASM_SIMP_TAC[ARITH_RULE
              `!l s h:num. l <= s ==> l <= h + s`;
              ARITH_RULE
              `!a b c:num. a <= b /\ b <= c ==> a <= c`] THEN
            CONV_TAC WORD_RULE)) cnd in
  let wordeq =
    W(fun (asl,gl) ->
      REWRITE_TAC[addreq asl (rand (rand (lhs gl)))
                    (rand (rand (rhs gl)))]) in
  (* a store that says the same of a key, with the numbers of the
     new element in place of the old ones *)
  let numeq =
    W(fun (asl,gl) ->
      let fl = grab asl (fun th ->
        try hd_is "FLOOKUP" (lhs (concl th)) &&
            rand (lhs (concl th)) = rand (lhs gl) &&
            not (concl th = gl)
        with Failure _ -> false) in
      let isn t = (try hd_is "word" t &&
                       type_of (rand t) = `:num` &&
                       not (is_numeral (rand t))
                   with Failure _ -> false) in
      let ge = find_term isn (rhs gl) in
      let fe = find_term isn (rhs (concl fl)) in
      let fs = numfacts asl in
      let cnd = end_itlist CONJ fs in
      let eq = MP (prove (mk_imp (concl cnd,
                    mk_eq (rand ge, rand fe)),
                  DISCH_THEN (REPEAT_TCL CONJUNCTS_THEN
                    ASSUME_TAC) THEN
                  REWRITE_TAC[el_length_def; LENGTH; ADD1] THEN
                  ASM_ARITH_TAC)) cnd in
      REWRITE_TAC[eq] THEN FIRST_ASSUM ACCEPT_TAC) in
  CONV_TAC (TOP_DEPTH_CONV let_CONV) THEN
  DISCH_THEN (REPEAT_TCL CONJUNCTS_THEN ASSUME_TAC) THEN
  (* what the invariant says of the stack *)
  FIRST_ASSUM (fun mr ->
    if hd_is "memory_rel" (concl mr)
    then MP_TAC (REWRITE_RULE[memory_rel_def; word_ml_inv_def] mr)
    else fail()) THEN
  DISCH_THEN STRIP_ASSUME_TAC THEN
  (* the roots of the values and the roots of the stack *)
  RULE_ASSUM_TRY (REWRITE_RULE[MAP_APPEND]) THEN
  W(fun (asl,gl) ->
    let a2 = grab asl (fun th ->
      try hd_is "ALL2" (concl th) &&
          hd_is "APPEND" (el 2 (snd(strip_comb (concl th))))
      with Failure _ -> false) in
    STRIP_ASSUME_TAC (MATCH_MP EVERY2_APPEND_IMP_APPEND
      (MATCH_MP EVERY2_SWAP a2))) THEN
  REPEAT (FIRST_X_ASSUM (fun e ->
    if not (try is_eq (concl e) && is_var (lhs (concl e)) &&
                hd_is "APPEND" (rhs (concl e))
            with Failure _ -> false) then fail() else
    SUBST_ALL_TAC e)) THEN
  REPEAT (FIRST_X_ASSUM (fun a2 ->
    if not (try hd_is "ALL2" (concl a2) &&
                hd_is "MAP" (el 1 (snd(strip_comb (concl a2))))
            with Failure _ -> false) then fail() else
    ASSUME_TAC (CONV_RULE (TOP_DEPTH_CONV BETA_CONV)
      (MATCH_MP EVERY2_SWAP a2)) THEN
    ASSUME_TAC (MATCH_MP LIST_REL_LENGTH a2))) THEN
  (* the element that holds the word *)
  W(fun (asl,gl) ->
    let ai = grab asl (fun th -> hd_is "abs_ml_inv" (concl th)) in
    let lt = grab asl (fun th ->
      try hd_is "<" (concl th) && hd_is "LENGTH" (lhand (concl th))
      with Failure _ -> false) in
    let spe = grab asl (fun th ->
      try hd_is "<=" (concl th) &&
          lhand (concl th) = rand (concl lt)
      with Failure _ -> false) in
    let bnd = MATCH_MP (ARITH_RULE
                `!b c d:num. b < c /\ c <= d ==> b < d`)
                (CONJ lt spe) in
    let mfst = lhand (el 1 (snd(strip_comb (concl ai)))) in
    let rts = lhand (el 0 (tparts
                (el 3 (snd(strip_comb (concl ai)))))) in
    let lmap = REWRITE_CONV[LENGTH_MAP]
                 (mk_icomb (`LENGTH`,mfst)) in
    let leq = grab asl (fun th ->
      try is_eq (concl th) && hd_is "LENGTH" (lhs (concl th)) &&
          rhs (concl th) = mk_icomb (`LENGTH`,rts)
      with Failure _ -> false) in
    let le = TRANS lmap (REWRITE_RULE[LENGTH_MAP] leq) in
    let wr = grab asl (fun th ->
      try is_eq (concl th) && hd_is "Word64Rep" (lhs (concl th))
      with Failure _ -> false) in
    MP_TAC (MATCH_MP (GEN_ALL word64_alt_thm)
      (CONJ ai (CONJ le (CONJ wr bnd))))) THEN
  DISCH_THEN STRIP_ASSUME_TAC THEN
  (* the element is the one the statement says it is *)
  W(fun (asl,gl) ->
    let wr = grab asl (fun th ->
      try is_eq (concl th) && hd_is "Word64Rep" (lhs (concl th))
      with Failure _ -> false) in
    RULE_ASSUM_TRY (REWRITE_RULE[wr]) THEN REWRITE_TAC[wr]) THEN
  (* the ends of the heap that the store holds *)
  FIRST_ASSUM (fun hs ->
    if hd_is "heap_in_memory_store" (concl hs)
    then STRIP_ASSUME_TAC
           (REWRITE_RULE[heap_in_memory_store_def] hs)
    else fail()) THEN
  (* the unused space of the heap, where the element goes *)
  FIRST_ASSUM (fun hu ->
    if not (try hd_is "heap_store_unused_alt" (lhs (concl hu))
            with Failure _ -> false) then fail() else
    MP_TAC (REWRITE_RULE[heap_store_unused_alt_def] hu)) THEN
  COND_CASES_TAC THEN REWRITE_TAC[PAIR_EQ] THEN
  DISCH_THEN STRIP_ASSUME_TAC THEN
  FIRST_X_ASSUM (fun cnd ->
    if not (is_conj (concl cnd)) then fail() else
    if not (try hd_is "heap_lookup" (lhs (lhand (concl cnd)))
            with Failure _ -> false) then fail() else
    STRIP_ASSUME_TAC cnd) THEN
  (* so the heap splits there *)
  FIRST_ASSUM (fun hl ->
    if not (try hd_is "heap_lookup" (lhs (concl hl))
            with Failure _ -> false) then fail() else
    STRIP_ASSUME_TAC (MATCH_MP heap_lookup_SPLIT hl)) THEN
  REPEAT (FIRST_X_ASSUM (fun e ->
    if not (try is_eq (concl e) && is_var (lhs (concl e)) &&
                (hd_is "APPEND" (rhs (concl e)) ||
                 hd_is "heap_length" (rhs (concl e)))
            with Failure _ -> false) then fail() else
    SUBST_ALL_TAC e)) THEN
  (* and the store writes the element at the end of the space *)
  FIRST_ASSUM (fun hs ->
    if not (try hd_is "heap_store" (lhs (concl hs))
            with Failure _ -> false) then fail() else
    MP_TAC (REWRITE_RULE[heap_store_lemma; PAIR_EQ] hs)) THEN
  DISCH_THEN STRIP_ASSUME_TAC THEN
  (* the words of the unused space, and its end where the element
     goes *)
  W(fun (asl,gl) ->
    let bnd = grab asl (fun th ->
      try hd_is "<=" (concl th) &&
          hd_is "el_length" (lhand (concl th))
      with Failure _ -> false) in
    let e1 = CONV_RULE NUM_REDUCE_CONV
               (REWRITE_RULE[el_length_def] bnd) in
    let eq1 = MATCH_MP (ARITH_RULE
                `!k s:num. k + 1 <= s ==> (s - 1) + 1 = s`) e1 in
    let eq3 = MATCH_MP (ARITH_RULE
                `!k s:num. k + 1 <= s
                           ==> (k + 1) + (s - (k + 1)) = s`) e1 in
    let sep = grab asl (fun th ->
      try hd_is "STAR" (rator (concl th))
      with Failure _ -> false) in
    let sep1 = REWRITE_RULE[word_heap_APPEND; word_heap_def;
                 word_el_def; el_length_def; eq1] sep in
    let addr = el 0 (snd(strip_comb (find (fun t ->
                 hd_is "word_list_exists" t)
                 (facs (rator (concl sep1)))))) in
    let wle = REWRITE_RULE[eq3]
                (ISPECL [lhand (lhs (concl eq3));
                         rand (lhs (concl eq3)); addr]
                   word_list_exists_ADD) in
    let sep2 = REWRITE_RULE[wle; STAR_ASSOC] sep1 in
    ASSUME_TAC sep2) THEN
  (* the words of the element are as many as its roots, and its
     address is the end of the heap less them *)
  W(fun (asl,gl) ->
    let sep = grab asl (fun th ->
      try hd_is "STAR" (rator (concl th)) &&
          length (filter (hd_is "word_list_exists")
                   (facs (rator (concl th)))) = 2
      with Failure _ -> false) in
    let bnd = grab asl (fun th ->
      try hd_is "<=" (concl th) &&
          hd_is "el_length" (lhand (concl th))
      with Failure _ -> false) in
    let e1 = CONV_RULE NUM_REDUCE_CONV
               (REWRITE_RULE[el_length_def] bnd) in
    let cells = filter (hd_is "word_list_exists")
                  (facs (rator (concl sep))) in
    let count = el 1 (snd(strip_comb (el 0 cells))) in
    let xs = el 1 (snd(strip_comb (find_term
               (hd_is "data_to_word_memoryProof_store_list") gl))) in
    let lenq = prove (mk_eq (count, mk_icomb (`LENGTH`,xs)),
                REWRITE_TAC[LENGTH] THEN ARITH_TAC) in
    let sep4 = REWRITE_RULE[lenq] sep in
    let bnd2 = REWRITE_RULE[lenq] e1 in
    ASSUME_TAC sep4 THEN ASSUME_TAC bnd2 THEN
    REWRITE_TAC[lenq]) THEN
  (* which the store writes there *)
  W(fun (asl,gl) ->
    let iscell t = hd_is "word_list_exists" t &&
                   hd_is "LENGTH" (el 1 (snd(strip_comb t))) in
    let sep = grab asl (fun th ->
      try hd_is "STAR" (rator (concl th)) &&
          exists iscell (facs (rator (concl th)))
      with Failure _ -> false) in
    let cell = find iscell (facs (rator (concl sep))) in
    STRIP_ASSUME_TAC (MATCH_MP store_list_thm (front sep cell))) THEN
  (* the ends of the heap, and the memory that the store wrote *)
  W(fun (asl,gl) ->
    let flk n = grab asl (fun th ->
      try hd_is "FLOOKUP" (lhs (concl th)) &&
          fst (dest_const (rand (lhs (concl th)))) = n
      with Failure _ -> false) in
    let sl = grab asl (fun th ->
      try hd_is "data_to_word_memoryProof_store_list"
            (lhs (concl th))
      with Failure _ -> false) in
    MAP_EVERY EXISTS_TAC
      [rand (rand (rhs (concl (flk "NextFree"))));
       rand (rand (rhs (concl (flk "CurrHeap"))));
       rand (rhs (concl sl))]) THEN
  (* the address of the element is the end of the heap less the
     words it takes *)
  W(fun (asl,gl) ->
    let sl = find_term
               (hd_is "data_to_word_memoryProof_store_list") gl in
    let t1 = el 0 (snd(strip_comb sl)) in
    let iscell t = hd_is "misc_word_list" t &&
                   hd_is "CONS" (el 1 (snd(strip_comb t))) in
    let sep = grab asl (fun th ->
      try hd_is "STAR" (rator (concl th)) &&
          exists iscell (facs (rator (concl th)))
      with Failure _ -> false) in
    let t2 = el 0 (snd(strip_comb
               (find iscell (facs (rator (concl sep)))))) in
    let bnd = grab asl (fun th ->
      try hd_is "<=" (concl th) &&
          hd_is "LENGTH" (lhand (concl th))
      with Failure _ -> false) in
    let eq = MP (prove (mk_imp (concl bnd, mk_eq (t1,t2)),
                  DISCH_TAC THEN ASM_SIMP_TAC[WORD_SUB] THEN
                  REWRITE_TAC[WORD_ADD] THEN
                  CONV_TAC WORD_RULE)) bnd in
    REWRITE_TAC[eq]) THEN
  REPEAT CONJ_TAC THEN TRY (FIRST_ASSUM ACCEPT_TAC) THEN
  (* the invariant with the new element in the heap *)
  REWRITE_TAC[memory_rel_def] THEN
  W(fun (asl,gl) ->
    let ai = grab asl (fun th ->
      hd_is "abs_ml_inv" (concl th) &&
      (try hd_is "CONS" (el 1 (snd(strip_comb (concl th))))
       with Failure _ -> false)) in
    let args = snd(strip_comb (concl ai)) in
    let ps = tparts (el 3 args) in
    MAP_EVERY EXISTS_TAC
      [el 1 ps; el 4 args; el 3 ps; el 4 ps; el 5 ps; el 6 ps]) THEN
  REPEAT CONJ_TAC THENL
   [ALL_TAC;
    (* the roots: the pointer of the new reference and the rest *)
    REWRITE_TAC[word_ml_inv_def] THEN
    W(fun (asl,gl) ->
      let ai = grab asl (fun th ->
        hd_is "abs_ml_inv" (concl th) &&
        (try hd_is "CONS" (el 1 (snd(strip_comb (concl th))))
         with Failure _ -> false)) in
      EXISTS_TAC
        (el 0 (tparts (el 3 (snd(strip_comb (concl ai))))))) THEN
    REWRITE_TAC[MAP; FST; SND; ALL2] THEN
    CONV_TAC (TOP_DEPTH_CONV BETA_CONV) THEN
    REPEAT CONJ_TAC THEN TRY (FIRST_ASSUM ACCEPT_TAC) THEN
    (* the word of the pointer is the one make_ptr builds *)
    W(fun (asl,gl) ->
      let mp = rhs gl in
      let sub = el 1 (snd(strip_comb mp)) in
      let aterm = lhand sub in
      let bwterm = rand aterm in
      let pt = lhand (rand (lhs gl)) in
      let mulp = mk_comb (rator bwterm,
                   mk_comb (rator (rand bwterm), pt)) in
      SUBST1_TAC (addreq asl sub mulp)) THEN
    W(fun (asl,gl) ->
      let gd = grab asl (fun th ->
        hd_is "good_dimindex" (concl th)) in
      REWRITE_TAC(word_addr_clauses ()) THEN
      REWRITE_TAC[make_ptr_def; get_addr_def;
                  get_lowerbits_def] THEN
      MATCH_REDUCE_TAC THEN
      REWRITE_TAC[MATCH_MP bytes_in_word_mul_eq_shift gd;
                  WORD_SHL_COMPOSE; bits0] THEN
      ASM_SIMP_TAC[ARITH_RULE
        `!a b:num. a <= b ==> a + (b - a) = b`] THEN
      REWRITE_TAC[WORD_OR_0; WORD_ADD_0]);
    FIRST_ASSUM ACCEPT_TAC;
    W(fun (asl,gl) ->
      let spe = grab asl (fun th ->
        try hd_is "<=" (concl th) && is_var (lhand (concl th)) &&
            is_var (rand (concl th))
        with Failure _ -> false) in
      let les = mapfilter (fun (_,th) ->
        if (try is_eq (concl th) &&
                hd_is "LENGTH" (lhs (concl th)) &&
                hd_is "LENGTH" (rhs (concl th))
            with Failure _ -> false) then th else fail()) asl in
      MP_TAC (end_itlist CONJ (spe :: les))) THEN
    REWRITE_TAC[el_length_def; LENGTH; ADD1] THEN
    ARITH_TAC] THEN
  (* the store of the new heap: its length is the old one *)
  REWRITE_TAC[heap_in_memory_store_def] THEN
  W(fun (asl,gl) ->
    let hu = grab asl (fun th ->
      try hd_is "heap_store_unused_alt" (lhs (concl th))
      with Failure _ -> false) in
    REWRITE_TAC[MATCH_MP heap_store_unused_alt_IMP_length hu]) THEN
  W(fun (asl,gl) ->
    let dis = CONJUNCTS (distinctness "store_name") in
    REWRITE_TAC([FLOOKUP_UPDATE; FDOM_FUPDATE; IN_INSERT] @
                dis @ map GSYM dis)) THEN
  REPEAT CONJ_TAC THEN TRY (FIRST_ASSUM ACCEPT_TAC) THEN
  (* the two heaps of the store *)
  W(fun (asl,gl) ->
    let flk n = grab asl (fun th ->
      try hd_is "FLOOKUP" (lhs (concl th)) &&
          fst (dest_const (rand (lhs (concl th)))) = n
      with Failure _ -> false) in
    MAP_EVERY EXISTS_TAC
      [rand (rand (rhs (concl (flk "CurrHeap"))));
       rand (rand (rhs (concl (flk "OtherHeap"))))]) THEN
  REPEAT CONJ_TAC THEN TRY (FIRST_ASSUM ACCEPT_TAC) THEN
  TRY (wordeq THEN NO_TAC) THEN
  TRY (numeq THEN NO_TAC) THEN
  (* the heap with the new element, which the store wrote *)
  FIRST_ASSUM (fun h2 ->
    if not (try is_eq (concl h2) && hd_is "APPEND" (lhs (concl h2)) &&
                is_var (rhs (concl h2))
            with Failure _ -> false) then fail() else
    SUBST1_TAC (SYM h2)) THEN
  REWRITE_TAC[word_heap_APPEND; word_heap_heap_expand;
              word_heap_def; heap_length_APPEND;
              heap_length_heap_expand] THEN
  REWRITE_TAC[word_el_def] THEN
  CONV_TAC (TOP_DEPTH_CONV let_CONV) THEN
  REWRITE_TAC[word_payload_def] THEN
  CONV_TAC (TOP_DEPTH_CONV let_CONV) THEN
  REWRITE_TAC[word_list_def; LENGTH_MAP; el_length_def;
              heap_length_NIL; STAR_ASSOC; emp_STAR; STAR_emp] THEN
  (* the words of the element are the roots of the values, and its
     header is the one that encode_header gave *)
  W(fun (asl,gl) ->
    let eh = grab asl (fun th ->
      try hd_is "encode_header" (lhs (concl th))
      with Failure _ -> false) in
    let mh = CONV_RULE NUM_REDUCE_CONV (MATCH_MP someif
               (REWRITE_RULE[encode_header_def] eh)) in
    let les = mapfilter (fun (_,th) ->
      if (try is_eq (concl th) &&
              hd_is "LENGTH" (lhs (concl th)) &&
              hd_is "LENGTH" (rhs (concl th))
          with Failure _ -> false) then th else fail()) asl in
    REWRITE_TAC(mh :: les)) THEN
  (* the condition of the payload, which the header's length says *)
  W(fun (asl,gl) ->
    let pred = rator gl in
    let fs = facs pred in
    let cell = find (hd_is "cond") fs in
    let rest = filter (fun t -> not (t = cell)) fs in
    let st = fst(strip_comb pred) in
    let mk a b = mk_comb(mk_comb(st,a),b) in
    SUBGOAL_THEN (mk_eq (pred, mk cell (end_itlist mk rest)))
      SUBST1_TAC THENL
     [REWRITE_TAC[STAR_AC; emp_STAR; STAR_emp]; ALL_TAC]) THEN
  REWRITE_TAC[cond_STAR] THEN
  CONJ_TAC THENL
   [W(fun (asl,gl) ->
      let eh = grab asl (fun th ->
        try hd_is "encode_header" (lhs (concl th))
        with Failure _ -> false) in
      let ls7 = grab asl (fun th ->
        try hd_is "<" (concl th) &&
            hd_is "+" (lhand (concl th)) &&
            hd_is "data_to_word_config_len_size"
              (lhand (lhand (concl th)))
        with Failure _ -> false) in
      let ls = MATCH_MP (ARITH_RULE
                 `!a b:num. a + 7 < b ==> a + 5 < b`) ls7 in
      let gd = grab asl (fun th ->
        hd_is "good_dimindex" (concl th)) in
      STRIP_ASSUME_TAC (MATCH_MP encode_header_IMP
        (CONJ eh (CONJ ls gd)))) THEN
    W(fun (asl,gl) ->
      let eh = grab asl (fun th ->
        try hd_is "encode_header" (lhs (concl th))
        with Failure _ -> false) in
      let mh = CONV_RULE NUM_REDUCE_CONV (MATCH_MP someif
                 (REWRITE_RULE[encode_header_def] eh)) in
      REWRITE_TAC[mh]) THEN
    ASM_REWRITE_TAC[IS_SOME];
    ALL_TAC] THEN
  (* and the words at the address the store wrote them to *)
  W(fun (asl,gl) ->
    let iscell t = hd_is "misc_word_list" t &&
                   hd_is "CONS" (el 1 (snd(strip_comb t))) in
    let sl = grab asl (fun th ->
      try hd_is "STAR" (rator (concl th)) &&
          exists iscell (facs (rator (concl th)))
      with Failure _ -> false) in
    let bnd = REWRITE_RULE[LENGTH; ADD1] (grab asl (fun th ->
      try hd_is "<=" (concl th) &&
          hd_is "LENGTH" (lhand (concl th))
      with Failure _ -> false)) in
    let arith = MATCH_MP (ARITH_RULE
                  `!l s:num. l <= s ==> l + (s - l) = s`) bnd in
    let sl2 = REWRITE_RULE[LENGTH; ADD1; word_list_def;
                word_heap_heap_expand; STAR_ASSOC; emp_STAR;
                STAR_emp; addsum] sl in
    REWRITE_TAC[heap_length_CONS; heap_length_NIL; el_length_def;
                ARITH_RULE `!n:num. n + 0 = n`; addsum;
                arith] THEN
    W(fun (asl2,gl2) ->
      let eq = prove (mk_eq (rator gl2, rator (concl sl2)),
                REWRITE_TAC[STAR_AC; emp_STAR; STAR_emp]) in
      ACCEPT_TAC (REWRITE_RULE[GSYM eq] sl2)))))
### IMP_memory_rel_bignum_alt
(* the allocation of a bignum, which is memory_rel_Word64_alt with
   bignum_alt_thm in place of word64_alt_thm: the element is the
   Bignum that the statement says it is, its words are the data of
   its tag (a list of words that the store writes as it is), and
   the word of its header is the one encode_header encoded -- the
   n2w of the w2n of it is the word itself (WORD_VAL) *)
  ((let hd_is n t =
     (try fst(dest_const(fst(strip_comb t))) = n
      with Failure _ -> false) in
  let rec facs t =
    if hd_is "STAR" t then
      let args = snd(strip_comb t) in
      facs (el 0 args) @ facs (el 1 args)
    else [t] in
  let grab asl p =
    tryfind (fun (_,th) ->
      if (try p th with Failure _ -> false) then th else fail())
      asl in
  let front sp cell =
    let pred = rator (concl sp) in
    let fs = facs pred in
    let rest = filter (fun t -> not (t = cell)) fs in
    let st = fst(strip_comb pred) in
    let mk x y = mk_comb(mk_comb(st,x),y) in
    let target = mk cell (end_itlist mk rest) in
    let eq = prove (mk_eq (pred,target),
              REWRITE_TAC[STAR_AC; emp_STAR; STAR_emp]) in
    REWRITE_RULE[eq] sp in
  (* two steps of an address in one *)
  let addsum = prove
   (`!(a:'a word) x y.
       a + bytes_in_word * n2w x + bytes_in_word * n2w y =
       a + bytes_in_word * n2w (x + y)`,
    REWRITE_TAC[WORD_ADD] THEN CONV_TAC WORD_RULE) in
  (* the bits of a zero word are zero *)
  let bits0 = prove
   (`!h l. word_bits h l ((n2w 0):(N)word) = n2w 0`,
    REWRITE_TAC[word_bits; WORD_EQ_BITS_ALT; BIT_WORD_SUBWORD;
                BIT_WORD_0] THEN
    CONV_TAC TAUT) in
  let someif = prove
   (`!p (x:A) y. (if p then SOME x else NONE) = SOME y ==> x = y`,
    REPEAT GEN_TAC THEN COND_CASES_TAC THEN
    REWRITE_TAC[distinctness "option"; injectivity "option"]) in
  (* the numeric facts that the assumptions give *)
  let numfacts asl =
    mapfilter (fun (_,th) ->
      let c = concl th in
      if (try hd_is "<=" c || hd_is "<" c ||
              (is_eq c && hd_is "LENGTH" (lhs c) &&
               hd_is "LENGTH" (rhs c))
          with Failure _ -> false) then th else fail()) asl in
  let addreq asl t1 t2 =
      let fs = numfacts asl in
      let extra = (try
        let lt = grab asl (fun th ->
          try hd_is "<" (concl th) &&
              hd_is "LENGTH" (lhand (concl th))
          with Failure _ -> false) in
        let spe = grab asl (fun th ->
          try hd_is "<=" (concl th) && is_var (lhand (concl th)) &&
              is_var (rand (concl th))
          with Failure _ -> false) in
        [MATCH_MP (ARITH_RULE
           `!a b c:num. a < b /\ b <= c ==> a + 1 <= c`)
           (CONJ lt spe)]
        with Failure _ -> []) in
      let cnd = end_itlist CONJ (fs @ extra) in
      MP (prove (mk_imp (concl cnd, mk_eq (t1,t2)),
            DISCH_THEN (REPEAT_TCL CONJUNCTS_THEN
              (fun th -> ASSUME_TAC
                 (REWRITE_RULE[LENGTH; ADD1] th))) THEN
            ASM_REWRITE_TAC[el_length_def; LENGTH; LENGTH_MAP;
                            ADD1] THEN
            REWRITE_TAC[WORD_SUB; WORD_ADD] THEN
            ASM_SIMP_TAC[ARITH_RULE
              `!l s h:num. l <= s ==> l <= h + s`;
              ARITH_RULE
              `!a b c:num. a <= b /\ b <= c ==> a <= c`] THEN
            CONV_TAC WORD_RULE)) cnd in
  let wordeq =
    W(fun (asl,gl) ->
      REWRITE_TAC[addreq asl (rand (rand (lhs gl)))
                    (rand (rand (rhs gl)))]) in
  (* a store that says the same of a key, with the numbers of the
     new element in place of the old ones *)
  let numeq =
    W(fun (asl,gl) ->
      let fl = grab asl (fun th ->
        try hd_is "FLOOKUP" (lhs (concl th)) &&
            rand (lhs (concl th)) = rand (lhs gl) &&
            not (concl th = gl)
        with Failure _ -> false) in
      let isn t = (try hd_is "word" t &&
                       type_of (rand t) = `:num` &&
                       not (is_numeral (rand t))
                   with Failure _ -> false) in
      let ge = find_term isn (rhs gl) in
      let fe = find_term isn (rhs (concl fl)) in
      let fs = numfacts asl in
      let cnd = end_itlist CONJ fs in
      let eq = MP (prove (mk_imp (concl cnd,
                    mk_eq (rand ge, rand fe)),
                  DISCH_THEN (REPEAT_TCL CONJUNCTS_THEN
                    ASSUME_TAC) THEN
                  REWRITE_TAC[el_length_def; LENGTH; LENGTH_MAP;
                              ADD1] THEN
                  ASM_ARITH_TAC)) cnd in
      REWRITE_TAC[eq] THEN FIRST_ASSUM ACCEPT_TAC) in
  CONV_TAC (TOP_DEPTH_CONV let_CONV) THEN
  DISCH_THEN (REPEAT_TCL CONJUNCTS_THEN ASSUME_TAC) THEN
  (* what the invariant says of the stack *)
  FIRST_ASSUM (fun mr ->
    if hd_is "memory_rel" (concl mr)
    then MP_TAC (REWRITE_RULE[memory_rel_def; word_ml_inv_def] mr)
    else fail()) THEN
  DISCH_THEN STRIP_ASSUME_TAC THEN
  (* the roots of the values and the roots of the stack *)
  RULE_ASSUM_TRY (REWRITE_RULE[MAP_APPEND]) THEN
  W(fun (asl,gl) ->
    let a2 = grab asl (fun th ->
      try hd_is "ALL2" (concl th) &&
          hd_is "APPEND" (el 2 (snd(strip_comb (concl th))))
      with Failure _ -> false) in
    STRIP_ASSUME_TAC (MATCH_MP EVERY2_APPEND_IMP_APPEND
      (MATCH_MP EVERY2_SWAP a2))) THEN
  REPEAT (FIRST_X_ASSUM (fun e ->
    if not (try is_eq (concl e) && is_var (lhs (concl e)) &&
                hd_is "APPEND" (rhs (concl e))
            with Failure _ -> false) then fail() else
    SUBST_ALL_TAC e)) THEN
  REPEAT (FIRST_X_ASSUM (fun a2 ->
    if not (try hd_is "ALL2" (concl a2) &&
                hd_is "MAP" (el 1 (snd(strip_comb (concl a2))))
            with Failure _ -> false) then fail() else
    ASSUME_TAC (CONV_RULE (TOP_DEPTH_CONV BETA_CONV)
      (MATCH_MP EVERY2_SWAP a2)) THEN
    ASSUME_TAC (MATCH_MP LIST_REL_LENGTH a2))) THEN
  (* the element that holds the word *)
  W(fun (asl,gl) ->
    let ai = grab asl (fun th -> hd_is "abs_ml_inv" (concl th)) in
    let lt = grab asl (fun th ->
      try hd_is "<" (concl th) && hd_is "LENGTH" (lhand (concl th))
      with Failure _ -> false) in
    let spe = grab asl (fun th ->
      try hd_is "<=" (concl th) &&
          lhand (concl th) = rand (concl lt)
      with Failure _ -> false) in
    let bnd = MATCH_MP (ARITH_RULE
                `!b c d:num. b < c /\ c <= d ==> b < d`)
                (CONJ lt spe) in
    let mfst = lhand (el 1 (snd(strip_comb (concl ai)))) in
    let rts = lhand (el 0 (tparts
                (el 3 (snd(strip_comb (concl ai)))))) in
    let lmap = REWRITE_CONV[LENGTH_MAP]
                 (mk_icomb (`LENGTH`,mfst)) in
    let leq = grab asl (fun th ->
      try is_eq (concl th) && hd_is "LENGTH" (lhs (concl th)) &&
          rhs (concl th) = mk_icomb (`LENGTH`,rts)
      with Failure _ -> false) in
    let le = TRANS lmap (REWRITE_RULE[LENGTH_MAP] leq) in
    let wr = grab asl (fun th ->
      try is_eq (concl th) && hd_is "Bignum" (lhs (concl th))
      with Failure _ -> false) in
    let si = grab asl (fun th ->
      try hd_is "small_int" (dest_neg (concl th))
      with Failure _ -> false) in
    let xs = rand (rand (rhs (concl wr))) in
    let bnd2 = EQ_MP (SYM (REWRITE_CONV[LENGTH_MAP]
                 (mk_binop `(<):num->num->bool`
                    (mk_icomb (`LENGTH`,xs)) (rand (concl bnd)))))
                 bnd in
    MP_TAC (MATCH_MP (GEN_ALL bignum_alt_thm)
      (CONJ ai (CONJ le (CONJ si (CONJ wr bnd2)))))) THEN
  DISCH_THEN STRIP_ASSUME_TAC THEN
  (* the element is the one the statement says it is *)
  W(fun (asl,gl) ->
    let wr = grab asl (fun th ->
      try is_eq (concl th) && hd_is "Bignum" (lhs (concl th))
      with Failure _ -> false) in
    RULE_ASSUM_TRY (REWRITE_RULE[wr]) THEN REWRITE_TAC[wr]) THEN
  (* the ends of the heap that the store holds *)
  FIRST_ASSUM (fun hs ->
    if hd_is "heap_in_memory_store" (concl hs)
    then STRIP_ASSUME_TAC
           (REWRITE_RULE[heap_in_memory_store_def] hs)
    else fail()) THEN
  (* the unused space of the heap, where the element goes *)
  FIRST_ASSUM (fun hu ->
    if not (try hd_is "heap_store_unused_alt" (lhs (concl hu))
            with Failure _ -> false) then fail() else
    MP_TAC (REWRITE_RULE[heap_store_unused_alt_def] hu)) THEN
  COND_CASES_TAC THEN REWRITE_TAC[PAIR_EQ] THEN
  DISCH_THEN STRIP_ASSUME_TAC THEN
  FIRST_X_ASSUM (fun cnd ->
    if not (is_conj (concl cnd)) then fail() else
    if not (try hd_is "heap_lookup" (lhs (lhand (concl cnd)))
            with Failure _ -> false) then fail() else
    STRIP_ASSUME_TAC cnd) THEN
  (* so the heap splits there *)
  FIRST_ASSUM (fun hl ->
    if not (try hd_is "heap_lookup" (lhs (concl hl))
            with Failure _ -> false) then fail() else
    STRIP_ASSUME_TAC (MATCH_MP heap_lookup_SPLIT hl)) THEN
  REPEAT (FIRST_X_ASSUM (fun e ->
    if not (try is_eq (concl e) && is_var (lhs (concl e)) &&
                (hd_is "APPEND" (rhs (concl e)) ||
                 hd_is "heap_length" (rhs (concl e)))
            with Failure _ -> false) then fail() else
    SUBST_ALL_TAC e)) THEN
  (* and the store writes the element at the end of the space *)
  FIRST_ASSUM (fun hs ->
    if not (try hd_is "heap_store" (lhs (concl hs))
            with Failure _ -> false) then fail() else
    MP_TAC (REWRITE_RULE[heap_store_lemma; PAIR_EQ] hs)) THEN
  DISCH_THEN STRIP_ASSUME_TAC THEN
  (* the words of the unused space, and its end where the element
     goes *)
  W(fun (asl,gl) ->
    let bnd = grab asl (fun th ->
      try hd_is "<=" (concl th) &&
          hd_is "el_length" (lhand (concl th))
      with Failure _ -> false) in
    let e1 = CONV_RULE NUM_REDUCE_CONV
               (REWRITE_RULE[el_length_def] bnd) in
    let eq1 = MATCH_MP (ARITH_RULE
                `!k s:num. k + 1 <= s ==> (s - 1) + 1 = s`) e1 in
    let eq3 = MATCH_MP (ARITH_RULE
                `!k s:num. k + 1 <= s
                           ==> (k + 1) + (s - (k + 1)) = s`) e1 in
    let sep = grab asl (fun th ->
      try hd_is "STAR" (rator (concl th))
      with Failure _ -> false) in
    let sep1 = REWRITE_RULE[word_heap_APPEND; word_heap_def;
                 word_el_def; el_length_def; eq1] sep in
    let addr = el 0 (snd(strip_comb (find (fun t ->
                 hd_is "word_list_exists" t)
                 (facs (rator (concl sep1)))))) in
    let wle = REWRITE_RULE[eq3]
                (ISPECL [lhand (lhs (concl eq3));
                         rand (lhs (concl eq3)); addr]
                   word_list_exists_ADD) in
    let sep2 = REWRITE_RULE[wle; STAR_ASSOC] sep1 in
    ASSUME_TAC sep2) THEN
  (* the words of the element are as many as its roots, and its
     address is the end of the heap less them *)
  W(fun (asl,gl) ->
    let sep = grab asl (fun th ->
      try hd_is "STAR" (rator (concl th)) &&
          length (filter (hd_is "word_list_exists")
                   (facs (rator (concl th)))) = 2
      with Failure _ -> false) in
    let bnd = grab asl (fun th ->
      try hd_is "<=" (concl th) &&
          hd_is "el_length" (lhand (concl th))
      with Failure _ -> false) in
    let e1 = CONV_RULE NUM_REDUCE_CONV
               (REWRITE_RULE[el_length_def] bnd) in
    let cells = filter (hd_is "word_list_exists")
                  (facs (rator (concl sep))) in
    let count = el 1 (snd(strip_comb (el 0 cells))) in
    let xs = el 1 (snd(strip_comb (find_term
               (hd_is "data_to_word_memoryProof_store_list") gl))) in
    let lenq = prove (mk_eq (count, mk_icomb (`LENGTH`,xs)),
                REWRITE_TAC[LENGTH; LENGTH_MAP] THEN
                ARITH_TAC) in
    let sep4 = REWRITE_RULE[lenq] sep in
    let bnd2 = REWRITE_RULE[lenq] e1 in
    ASSUME_TAC sep4 THEN ASSUME_TAC bnd2 THEN
    REWRITE_TAC[lenq]) THEN
  (* which the store writes there *)
  W(fun (asl,gl) ->
    let iscell t = hd_is "word_list_exists" t &&
                   hd_is "LENGTH" (el 1 (snd(strip_comb t))) in
    let sep = grab asl (fun th ->
      try hd_is "STAR" (rator (concl th)) &&
          exists iscell (facs (rator (concl th)))
      with Failure _ -> false) in
    let cell = find iscell (facs (rator (concl sep))) in
    STRIP_ASSUME_TAC (MATCH_MP store_list_thm (front sep cell))) THEN
  (* the ends of the heap, and the memory that the store wrote *)
  W(fun (asl,gl) ->
    let flk n = grab asl (fun th ->
      try hd_is "FLOOKUP" (lhs (concl th)) &&
          fst (dest_const (rand (lhs (concl th)))) = n
      with Failure _ -> false) in
    let sl = grab asl (fun th ->
      try hd_is "data_to_word_memoryProof_store_list"
            (lhs (concl th))
      with Failure _ -> false) in
    MAP_EVERY EXISTS_TAC
      [rand (rand (rhs (concl (flk "NextFree"))));
       rand (rand (rhs (concl (flk "CurrHeap"))));
       rand (rhs (concl sl))]) THEN
  (* the address of the element is the end of the heap less the
     words it takes *)
  W(fun (asl,gl) ->
    let sl = find_term
               (hd_is "data_to_word_memoryProof_store_list") gl in
    let t1 = el 0 (snd(strip_comb sl)) in
    let iscell t = hd_is "misc_word_list" t &&
                   el 1 (snd(strip_comb t)) =
                     el 1 (snd(strip_comb sl)) in
    let sep = grab asl (fun th ->
      try hd_is "STAR" (rator (concl th)) &&
          exists iscell (facs (rator (concl th)))
      with Failure _ -> false) in
    let t2 = el 0 (snd(strip_comb
               (find iscell (facs (rator (concl sep)))))) in
    let bnd = grab asl (fun th ->
      try hd_is "<=" (concl th) &&
          hd_is "LENGTH" (lhand (concl th))
      with Failure _ -> false) in
    let eq = MP (prove (mk_imp (concl bnd, mk_eq (t1,t2)),
                  DISCH_TAC THEN ASM_SIMP_TAC[WORD_SUB] THEN
                  REWRITE_TAC[WORD_ADD] THEN
                  CONV_TAC WORD_RULE)) bnd in
    REWRITE_TAC[eq]) THEN
  REPEAT CONJ_TAC THEN TRY (FIRST_ASSUM ACCEPT_TAC) THEN
  (* the invariant with the new element in the heap *)
  REWRITE_TAC[memory_rel_def] THEN
  W(fun (asl,gl) ->
    let ai = grab asl (fun th ->
      hd_is "abs_ml_inv" (concl th) &&
      (try hd_is "CONS" (el 1 (snd(strip_comb (concl th))))
       with Failure _ -> false)) in
    let args = snd(strip_comb (concl ai)) in
    let ps = tparts (el 3 args) in
    MAP_EVERY EXISTS_TAC
      [el 1 ps; el 4 args; el 3 ps; el 4 ps; el 5 ps; el 6 ps]) THEN
  REPEAT CONJ_TAC THENL
   [ALL_TAC;
    (* the roots: the pointer of the new reference and the rest *)
    REWRITE_TAC[word_ml_inv_def] THEN
    W(fun (asl,gl) ->
      let ai = grab asl (fun th ->
        hd_is "abs_ml_inv" (concl th) &&
        (try hd_is "CONS" (el 1 (snd(strip_comb (concl th))))
         with Failure _ -> false)) in
      EXISTS_TAC
        (el 0 (tparts (el 3 (snd(strip_comb (concl ai))))))) THEN
    REWRITE_TAC[MAP; FST; SND; ALL2] THEN
    CONV_TAC (TOP_DEPTH_CONV BETA_CONV) THEN
    REPEAT CONJ_TAC THEN TRY (FIRST_ASSUM ACCEPT_TAC) THEN
    (* the word of the pointer is the one make_ptr builds *)
    W(fun (asl,gl) ->
      let mp = rhs gl in
      let sub = el 1 (snd(strip_comb mp)) in
      let aterm = lhand sub in
      let bwterm = rand aterm in
      let pt = lhand (rand (lhs gl)) in
      let mulp = mk_comb (rator bwterm,
                   mk_comb (rator (rand bwterm), pt)) in
      SUBST1_TAC (addreq asl sub mulp)) THEN
    W(fun (asl,gl) ->
      let gd = grab asl (fun th ->
        hd_is "good_dimindex" (concl th)) in
      REWRITE_TAC(word_addr_clauses ()) THEN
      REWRITE_TAC[make_ptr_def; get_addr_def;
                  get_lowerbits_def] THEN
      MATCH_REDUCE_TAC THEN
      REWRITE_TAC[MATCH_MP bytes_in_word_mul_eq_shift gd;
                  WORD_SHL_COMPOSE; bits0] THEN
      ASM_SIMP_TAC[ARITH_RULE
        `!a b:num. a <= b ==> a + (b - a) = b`] THEN
      REWRITE_TAC[WORD_OR_0; WORD_ADD_0]);
    FIRST_ASSUM ACCEPT_TAC;
    W(fun (asl,gl) ->
      let spe = grab asl (fun th ->
        try hd_is "<=" (concl th) && is_var (lhand (concl th)) &&
            is_var (rand (concl th))
        with Failure _ -> false) in
      let les = mapfilter (fun (_,th) ->
        if (try is_eq (concl th) &&
                hd_is "LENGTH" (lhs (concl th)) &&
                hd_is "LENGTH" (rhs (concl th))
            with Failure _ -> false) then th else fail()) asl in
      MP_TAC (end_itlist CONJ (spe :: les))) THEN
    REWRITE_TAC[el_length_def; LENGTH; LENGTH_MAP; ADD1] THEN
    ARITH_TAC] THEN
  (* the store of the new heap: its length is the old one *)
  REWRITE_TAC[heap_in_memory_store_def] THEN
  W(fun (asl,gl) ->
    let hu = grab asl (fun th ->
      try hd_is "heap_store_unused_alt" (lhs (concl th))
      with Failure _ -> false) in
    REWRITE_TAC[MATCH_MP heap_store_unused_alt_IMP_length hu]) THEN
  W(fun (asl,gl) ->
    let dis = CONJUNCTS (distinctness "store_name") in
    REWRITE_TAC([FLOOKUP_UPDATE; FDOM_FUPDATE; IN_INSERT] @
                dis @ map GSYM dis)) THEN
  REPEAT CONJ_TAC THEN TRY (FIRST_ASSUM ACCEPT_TAC) THEN
  (* the two heaps of the store *)
  W(fun (asl,gl) ->
    let flk n = grab asl (fun th ->
      try hd_is "FLOOKUP" (lhs (concl th)) &&
          fst (dest_const (rand (lhs (concl th)))) = n
      with Failure _ -> false) in
    MAP_EVERY EXISTS_TAC
      [rand (rand (rhs (concl (flk "CurrHeap"))));
       rand (rand (rhs (concl (flk "OtherHeap"))))]) THEN
  REPEAT CONJ_TAC THEN TRY (FIRST_ASSUM ACCEPT_TAC) THEN
  TRY (wordeq THEN NO_TAC) THEN
  TRY (numeq THEN NO_TAC) THEN
  (* the heap with the new element, which the store wrote *)
  FIRST_ASSUM (fun h2 ->
    if not (try is_eq (concl h2) && hd_is "APPEND" (lhs (concl h2)) &&
                is_var (rhs (concl h2))
            with Failure _ -> false) then fail() else
    SUBST1_TAC (SYM h2)) THEN
  REWRITE_TAC[word_heap_APPEND; word_heap_heap_expand;
              word_heap_def; heap_length_APPEND;
              heap_length_heap_expand] THEN
  REWRITE_TAC[word_el_def] THEN
  CONV_TAC (TOP_DEPTH_CONV let_CONV) THEN
  REWRITE_TAC[word_payload_def] THEN
  CONV_TAC (TOP_DEPTH_CONV let_CONV) THEN
  REWRITE_TAC[word_list_def; LENGTH_MAP; el_length_def;
              heap_length_NIL; STAR_ASSOC; emp_STAR; STAR_emp] THEN
  (* the words of the element are the roots of the values, and its
     header is the one that encode_header gave *)
  W(fun (asl,gl) ->
    let eh = grab asl (fun th ->
      try hd_is "encode_header" (lhs (concl th))
      with Failure _ -> false) in
    let mh = REWRITE_RULE[WORD_VAL] (CONV_RULE NUM_REDUCE_CONV
               (MATCH_MP someif
                  (REWRITE_RULE[encode_header_def] eh))) in
    let les = mapfilter (fun (_,th) ->
      if (try is_eq (concl th) &&
              hd_is "LENGTH" (lhs (concl th)) &&
              hd_is "LENGTH" (rhs (concl th))
          with Failure _ -> false) then th else fail()) asl in
    REWRITE_TAC(WORD_VAL :: mh :: les)) THEN
  (* the condition of the payload, which the header's length says *)
  W(fun (asl,gl) ->
    let pred = rator gl in
    let fs = facs pred in
    let cell = find (hd_is "cond") fs in
    let rest = filter (fun t -> not (t = cell)) fs in
    let st = fst(strip_comb pred) in
    let mk a b = mk_comb(mk_comb(st,a),b) in
    SUBGOAL_THEN (mk_eq (pred, mk cell (end_itlist mk rest)))
      SUBST1_TAC THENL
     [REWRITE_TAC[STAR_AC; emp_STAR; STAR_emp]; ALL_TAC]) THEN
  REWRITE_TAC[cond_STAR] THEN
  CONJ_TAC THENL
   [W(fun (asl,gl) ->
      let eh = grab asl (fun th ->
        try hd_is "encode_header" (lhs (concl th))
        with Failure _ -> false) in
      let ls7 = grab asl (fun th ->
        try hd_is "<" (concl th) &&
            hd_is "+" (lhand (concl th)) &&
            hd_is "data_to_word_config_len_size"
              (lhand (lhand (concl th)))
        with Failure _ -> false) in
      let ls = MATCH_MP (ARITH_RULE
                 `!a b:num. a + 7 < b ==> a + 5 < b`) ls7 in
      let gd = grab asl (fun th ->
        hd_is "good_dimindex" (concl th)) in
      STRIP_ASSUME_TAC (MATCH_MP encode_header_IMP
        (CONJ eh (CONJ ls gd)))) THEN
    W(fun (asl,gl) ->
      let eh = grab asl (fun th ->
        try hd_is "encode_header" (lhs (concl th))
        with Failure _ -> false) in
      let mh = REWRITE_RULE[WORD_VAL] (CONV_RULE NUM_REDUCE_CONV
                 (MATCH_MP someif
                    (REWRITE_RULE[encode_header_def] eh))) in
      REWRITE_TAC[WORD_VAL; mh]) THEN
    ASM_REWRITE_TAC[IS_SOME];
    ALL_TAC] THEN
  (* and the words at the address the store wrote them to *)
  W(fun (asl,gl) ->
    let iscell = hd_is "misc_word_list" in
    let sl = grab asl (fun th ->
      try hd_is "STAR" (rator (concl th)) &&
          exists iscell (facs (rator (concl th)))
      with Failure _ -> false) in
    let bnd = REWRITE_RULE[LENGTH; LENGTH_MAP; ADD1]
                (grab asl (fun th ->
      try hd_is "<=" (concl th) &&
          hd_is "LENGTH" (lhand (concl th))
      with Failure _ -> false)) in
    let arith = MATCH_MP (ARITH_RULE
                  `!l s:num. l <= s ==> l + (s - l) = s`) bnd in
    let sl2 = REWRITE_RULE[MAP; LENGTH; LENGTH_MAP; ADD1;
                word_list_def; word_heap_heap_expand; STAR_ASSOC;
                emp_STAR; STAR_emp; addsum] sl in
    REWRITE_TAC[heap_length_CONS; heap_length_NIL; el_length_def;
                ARITH_RULE `!n:num. n + 0 = n`; addsum;
                arith] THEN
    W(fun (asl2,gl2) ->
      let eq = prove (mk_eq (rator gl2, rator (concl sl2)),
                REWRITE_TAC[STAR_AC; emp_STAR; STAR_emp]) in
      ACCEPT_TAC (REWRITE_RULE[GSYM eq] sl2)))))
### memory_rel_Cons1
(* the allocation of a block, which is memory_rel_Ref at the other
   end of the unused space: cons_thm_alt gives the invariant of the
   stack with the block in the place of its values (so no pop_thm
   is wanted here) and the store of the element at the start of the
   space, which heap_store_unused_alt writes there, and the words
   of the space split (word_list_exists_ADD) into the element's own
   and what stays unused.  store_list_thm writes the header and the
   roots of the values at NextFree, which the store moves on by
   them; the header is the one encode_header gave, with the shift
   of two that the tag of a block is encoded with, and the pointer
   of the block is make_cons_ptr of the offset -- the shift of
   bytes_in_word_mul_eq_shift composed with make_cons_ptr's is the
   shift of get_addr, and the one bit that make_cons_ptr ors in is
   one of the lower bits of the pointer (get_lowerbits_or_1) *)
  ((let hd_is n t =
     (try fst(dest_const(fst(strip_comb t))) = n
      with Failure _ -> false) in
  let rec facs t =
    if hd_is "STAR" t then
      let args = snd(strip_comb t) in
      facs (el 0 args) @ facs (el 1 args)
    else [t] in
  let grab asl p =
    tryfind (fun (_,th) ->
      if (try p th with Failure _ -> false) then th else fail())
      asl in
  let front sp cell =
    let pred = rator (concl sp) in
    let fs = facs pred in
    let rest = filter (fun t -> not (t = cell)) fs in
    let st = fst(strip_comb pred) in
    let mk x y = mk_comb(mk_comb(st,x),y) in
    let target = mk cell (end_itlist mk rest) in
    let eq = prove (mk_eq (pred,target),
              REWRITE_TAC[STAR_AC; emp_STAR; STAR_emp]) in
    REWRITE_RULE[eq] sp in
  (* an ALL2 over two appends of matching lengths *)
  let all2app = prove
   (`!(P:A->B->bool) xs1 ys1 xs2 ys2.
       LENGTH xs1 = LENGTH ys1
       ==> (ALL2 P (xs1 ++ xs2) (ys1 ++ ys2) <=>
            ALL2 P xs1 ys1 /\ ALL2 P xs2 ys2)`,
    GEN_TAC THEN LIST_INDUCT_TAC THENL
     [X_GEN_TAC `ys1:(B)list` THEN
      STRUCT_CASES_TAC (ISPEC `ys1:(B)list` list_CASES) THEN
      REWRITE_TAC[LENGTH; APPEND; ALL2; NOT_SUC;
                  ARITH_RULE `~(0 = SUC n)`];
      X_GEN_TAC `ys1:(B)list` THEN
      STRUCT_CASES_TAC (ISPEC `ys1:(B)list` list_CASES) THEN
      REWRITE_TAC[LENGTH; APPEND; ALL2; NOT_SUC;
                  ARITH_RULE `~(SUC n = 0)`; SUC_INJ] THEN
      REPEAT GEN_TAC THEN DISCH_TAC THEN
      ASM_SIMP_TAC[] THEN CONV_TAC TAUT]) in
  (* two steps of an address in one *)
  let addsum = prove
   (`!(a:'a word) x y.
       a + bytes_in_word * n2w x + bytes_in_word * n2w y =
       a + bytes_in_word * n2w (x + y)`,
    REWRITE_TAC[WORD_ADD] THEN CONV_TAC WORD_RULE) in
  (* the shift of two that the tag of a block is encoded with *)
  let shl2 = prove
   (`!t. ((n2w t):(N)word) << 2 = n2w (4 * t)`,
    GEN_TAC THEN REWRITE_TAC[word_shl; VAL_WORD] THEN
    CONV_TAC NUM_REDUCE_CONV THEN
    REWRITE_TAC[WORD_EQ; CONG] THEN CONV_TAC MOD_DOWN_CONV THEN
    REWRITE_TAC[MULT_AC]) in
  let someif = prove
   (`!p (x:A) y. (if p then SOME x else NONE) = SOME y ==> x = y`,
    REPEAT GEN_TAC THEN COND_CASES_TAC THEN
    REWRITE_TAC[distinctness "option"; injectivity "option"]) in
  (* the numeric facts that the assumptions give *)
  let numfacts asl =
    mapfilter (fun (_,th) ->
      let c = concl th in
      if (try hd_is "<=" c || hd_is "<" c ||
              (is_eq c && hd_is "LENGTH" (lhs c) &&
               hd_is "LENGTH" (rhs c))
          with Failure _ -> false) then th else fail()) asl in
  let addreq asl t1 t2 =
      let fs = numfacts asl in
      let extra = (try
        let lt = grab asl (fun th ->
          try hd_is "<" (concl th) &&
              hd_is "LENGTH" (lhand (concl th))
          with Failure _ -> false) in
        let spe = grab asl (fun th ->
          try hd_is "<=" (concl th) && is_var (lhand (concl th)) &&
              is_var (rand (concl th))
          with Failure _ -> false) in
        [MATCH_MP (ARITH_RULE
           `!a b c:num. a < b /\ b <= c ==> a + 1 <= c`)
           (CONJ lt spe)]
        with Failure _ -> []) in
      let cnd = end_itlist CONJ (fs @ extra) in
      MP (prove (mk_imp (concl cnd, mk_eq (t1,t2)),
            DISCH_THEN (REPEAT_TCL CONJUNCTS_THEN
              (fun th -> ASSUME_TAC
                 (REWRITE_RULE[LENGTH; ADD1] th))) THEN
            ASM_REWRITE_TAC[BlockRep_def; el_length_def;
                            LENGTH; ADD1] THEN
            REWRITE_TAC[WORD_SUB; WORD_ADD] THEN
            ASM_SIMP_TAC[ARITH_RULE
              `!l s h:num. l <= s ==> l <= h + s`;
              ARITH_RULE
              `!a b c:num. a <= b /\ b <= c ==> a <= c`] THEN
            CONV_TAC WORD_RULE)) cnd in
  let wordeq =
    W(fun (asl,gl) ->
      REWRITE_TAC[addreq asl (rand (rand (lhs gl)))
                    (rand (rand (rhs gl)))]) in
  (* a store that says the same of a key, with the numbers of the
     new element in place of the old ones *)
  let numeq =
    W(fun (asl,gl) ->
      let fl = grab asl (fun th ->
        try hd_is "FLOOKUP" (lhs (concl th)) &&
            rand (lhs (concl th)) = rand (lhs gl) &&
            not (concl th = gl)
        with Failure _ -> false) in
      let isn t = (try hd_is "word" t &&
                       type_of (rand t) = `:num` &&
                       not (is_numeral (rand t))
                   with Failure _ -> false) in
      let ge = find_term isn (rhs gl) in
      let fe = find_term isn (rhs (concl fl)) in
      let fs = numfacts asl in
      let cnd = end_itlist CONJ fs in
      let eq = MP (prove (mk_imp (concl cnd,
                    mk_eq (rand ge, rand fe)),
                  DISCH_THEN (REPEAT_TCL CONJUNCTS_THEN
                    ASSUME_TAC) THEN
                  REWRITE_TAC[BlockRep_def; el_length_def;
                              LENGTH; ADD1] THEN
                  ASM_ARITH_TAC)) cnd in
      REWRITE_TAC[eq] THEN FIRST_ASSUM ACCEPT_TAC) in
  CONV_TAC (TOP_DEPTH_CONV let_CONV) THEN
  DISCH_THEN (REPEAT_TCL CONJUNCTS_THEN ASSUME_TAC) THEN
  (* what the invariant says of the stack *)
  FIRST_ASSUM (fun mr ->
    if hd_is "memory_rel" (concl mr)
    then MP_TAC (REWRITE_RULE[memory_rel_def; word_ml_inv_def] mr)
    else fail()) THEN
  DISCH_THEN STRIP_ASSUME_TAC THEN
  (* the values and the words that the ZIP of the stack holds *)
  W(fun (asl,gl) ->
    let le = grab asl (fun th ->
      try is_eq (concl th) && hd_is "LENGTH" (lhs (concl th)) &&
          hd_is "LENGTH" (rhs (concl th))
      with Failure _ -> false) in
    RULE_ASSUM_TRY (REWRITE_RULE[MAP_APPEND;
      MATCH_MP MAP_FST_ZIP le; MATCH_MP MAP_SND_ZIP le])) THEN
  (* the block that the cons makes of the values *)
  W(fun (asl,gl) ->
    let ai = grab asl (fun th -> hd_is "abs_ml_inv" (concl th)) in
    let ne = grab asl (fun th ->
      try hd_is "NIL" (rhs (dest_neg (concl th)))
      with Failure _ -> false) in
    let lt = grab asl (fun th ->
      try hd_is "<" (concl th) && hd_is "LENGTH" (lhand (concl th))
      with Failure _ -> false) in
    let le = grab asl (fun th ->
      try is_eq (concl th) && hd_is "LENGTH" (lhs (concl th)) &&
          hd_is "LENGTH" (rhs (concl th))
      with Failure _ -> false) in
    let spe = grab asl (fun th ->
      try hd_is "<=" (concl th) &&
          lhand (concl th) = rand (concl lt)
      with Failure _ -> false) in
    let bnd = MATCH_MP (ARITH_RULE
                `!a b c d:num. a = b /\ b < c /\ c <= d
                               ==> a < d`)
                (CONJ le (CONJ lt spe)) in
    let tg = el 2 (snd(strip_comb (find_term
               (hd_is "make_cons_ptr") gl))) in
    MP_TAC (SPEC tg (MATCH_MP (GEN_ALL cons_thm_alt)
      (CONJ ai (CONJ bnd ne))))) THEN
  DISCH_THEN STRIP_ASSUME_TAC THEN
  (* the ends of the heap that the store holds *)
  FIRST_ASSUM (fun hs ->
    if hd_is "heap_in_memory_store" (concl hs)
    then STRIP_ASSUME_TAC
           (REWRITE_RULE[heap_in_memory_store_def] hs)
    else fail()) THEN
  (* the unused space of the heap, where the element goes *)
  FIRST_ASSUM (fun hu ->
    if not (try hd_is "heap_store_unused_alt" (lhs (concl hu))
            with Failure _ -> false) then fail() else
    MP_TAC (REWRITE_RULE[heap_store_unused_alt_def] hu)) THEN
  COND_CASES_TAC THEN REWRITE_TAC[PAIR_EQ] THEN
  DISCH_THEN STRIP_ASSUME_TAC THEN
  FIRST_X_ASSUM (fun cnd ->
    if not (is_conj (concl cnd)) then fail() else
    if not (try hd_is "heap_lookup" (lhs (lhand (concl cnd)))
            with Failure _ -> false) then fail() else
    STRIP_ASSUME_TAC cnd) THEN
  (* so the heap splits there *)
  FIRST_ASSUM (fun hl ->
    if not (try hd_is "heap_lookup" (lhs (concl hl))
            with Failure _ -> false) then fail() else
    STRIP_ASSUME_TAC (MATCH_MP heap_lookup_SPLIT hl)) THEN
  REPEAT (FIRST_X_ASSUM (fun e ->
    if not (try is_eq (concl e) && is_var (lhs (concl e)) &&
                (hd_is "APPEND" (rhs (concl e)) ||
                 hd_is "heap_length" (rhs (concl e)))
            with Failure _ -> false) then fail() else
    SUBST_ALL_TAC e)) THEN
  (* and the store writes the element at the end of the space *)
  FIRST_ASSUM (fun hs ->
    if not (try hd_is "heap_store" (lhs (concl hs))
            with Failure _ -> false) then fail() else
    MP_TAC (REWRITE_RULE[heap_store_lemma; PAIR_EQ] hs)) THEN
  DISCH_THEN STRIP_ASSUME_TAC THEN
  (* the words of the unused space, and its end where the element
     goes *)
  W(fun (asl,gl) ->
    let bnd = grab asl (fun th ->
      try hd_is "<=" (concl th) &&
          hd_is "el_length" (lhand (concl th))
      with Failure _ -> false) in
    let e1 = REWRITE_RULE[BlockRep_def; el_length_def] bnd in
    let eq1 = MATCH_MP (ARITH_RULE
                `!k s:num. k + 1 <= s ==> (s - 1) + 1 = s`) e1 in
    let eq3 = MATCH_MP (ARITH_RULE
                `!k s:num. k + 1 <= s
                           ==> (k + 1) + (s - (k + 1)) = s`) e1 in
    let sep = grab asl (fun th ->
      try hd_is "STAR" (rator (concl th))
      with Failure _ -> false) in
    let sep1 = REWRITE_RULE[word_heap_APPEND; word_heap_def;
                 word_el_def; el_length_def; eq1] sep in
    let addr = el 0 (snd(strip_comb (find (fun t ->
                 hd_is "word_list_exists" t)
                 (facs (rator (concl sep1)))))) in
    let wle = REWRITE_RULE[eq3]
                (ISPECL [lhand (lhs (concl eq3));
                         rand (lhs (concl eq3)); addr]
                   word_list_exists_ADD) in
    let sep2 = REWRITE_RULE[wle; STAR_ASSOC] sep1 in
    ASSUME_TAC sep2) THEN
  (* the words of the element are as many as its roots, and its
     address is the end of the heap less them *)
  W(fun (asl,gl) ->
    let sep = grab asl (fun th ->
      try hd_is "STAR" (rator (concl th)) &&
          length (filter (hd_is "word_list_exists")
                   (facs (rator (concl th)))) = 2
      with Failure _ -> false) in
    let bnd = grab asl (fun th ->
      try hd_is "<=" (concl th) &&
          hd_is "el_length" (lhand (concl th))
      with Failure _ -> false) in
    let e1 = REWRITE_RULE[BlockRep_def; el_length_def] bnd in
    let rsl = rand (lhand (lhand (concl e1))) in
    let l1 = grab asl (fun th ->
      try is_eq (concl th) && lhs (concl th) =
            mk_icomb (`LENGTH`,rsl)
      with Failure _ -> false) in
    let l2 = grab asl (fun th ->
      try is_eq (concl th) && lhs (concl th) = rhs (concl l1) &&
          hd_is "LENGTH" (rhs (concl th))
      with Failure _ -> false) in
    let rw = TRANS l1 l2 in
    let xs = el 1 (snd(strip_comb (find_term
               (hd_is "data_to_word_memoryProof_store_list") gl))) in
    let lenq = prove (mk_eq (mk_binop `(+):num->num->num`
                  (rhs (concl rw)) `1`, mk_icomb (`LENGTH`,xs)),
                REWRITE_TAC[LENGTH] THEN ARITH_TAC) in
    let sep4 = REWRITE_RULE[lenq] (REWRITE_RULE[rw] sep) in
    let bnd2 = REWRITE_RULE[lenq] (REWRITE_RULE[rw] e1) in
    ASSUME_TAC sep4 THEN ASSUME_TAC bnd2 THEN
    REWRITE_TAC[lenq]) THEN
  (* which the store writes there *)
  W(fun (asl,gl) ->
    let iscell t = hd_is "word_list_exists" t &&
                   hd_is "LENGTH" (el 1 (snd(strip_comb t))) in
    let sep = grab asl (fun th ->
      try hd_is "STAR" (rator (concl th)) &&
          exists iscell (facs (rator (concl th)))
      with Failure _ -> false) in
    let cell = find iscell (facs (rator (concl sep))) in
    STRIP_ASSUME_TAC (MATCH_MP store_list_thm (front sep cell))) THEN
  (* the ends of the heap, and the memory that the store wrote *)
  W(fun (asl,gl) ->
    let flk n = grab asl (fun th ->
      try hd_is "FLOOKUP" (lhs (concl th)) &&
          fst (dest_const (rand (lhs (concl th)))) = n
      with Failure _ -> false) in
    let sl = grab asl (fun th ->
      try hd_is "data_to_word_memoryProof_store_list"
            (lhs (concl th))
      with Failure _ -> false) in
    MAP_EVERY EXISTS_TAC
      [rand (rand (rhs (concl (flk "NextFree"))));
       rand (rand (rhs (concl (flk "CurrHeap"))));
       rand (rhs (concl sl))]) THEN
  (* the address of the element is the end of the heap less the
     words it takes *)
  W(fun (asl,gl) ->
    let sl = find_term
               (hd_is "data_to_word_memoryProof_store_list") gl in
    let t1 = el 0 (snd(strip_comb sl)) in
    let iscell t = hd_is "misc_word_list" t &&
                   hd_is "CONS" (el 1 (snd(strip_comb t))) in
    let sep = grab asl (fun th ->
      try hd_is "STAR" (rator (concl th)) &&
          exists iscell (facs (rator (concl th)))
      with Failure _ -> false) in
    let t2 = el 0 (snd(strip_comb
               (find iscell (facs (rator (concl sep)))))) in
    let bnd = grab asl (fun th ->
      try hd_is "<=" (concl th) &&
          hd_is "LENGTH" (lhand (concl th))
      with Failure _ -> false) in
    let eq = MP (prove (mk_imp (concl bnd, mk_eq (t1,t2)),
                  DISCH_TAC THEN ASM_SIMP_TAC[WORD_SUB] THEN
                  REWRITE_TAC[WORD_ADD] THEN
                  CONV_TAC WORD_RULE)) bnd in
    REWRITE_TAC[eq]) THEN
  REPEAT CONJ_TAC THEN TRY (FIRST_ASSUM ACCEPT_TAC) THEN
  (* the roots of the element and the roots of the stack *)
  REPEAT (FIRST_X_ASSUM (fun e ->
    if not (try is_eq (concl e) && is_var (lhs (concl e)) &&
                hd_is "APPEND" (rhs (concl e))
            with Failure _ -> false) then fail() else
    SUBST_ALL_TAC e)) THEN
  W(fun (asl,gl) ->
    let a2 = grab asl (fun th ->
      hd_is "ALL2" (concl th) &&
      hd_is "APPEND" (el 1 (snd(strip_comb (concl th))))) in
    let rsl = lhand (el 1 (snd(strip_comb (concl a2)))) in
    let l1 = grab asl (fun th ->
      try is_eq (concl th) && lhs (concl th) =
            mk_icomb (`LENGTH`,rsl)
      with Failure _ -> false) in
    let l2 = grab asl (fun th ->
      try is_eq (concl th) && lhs (concl th) = rhs (concl l1) &&
          hd_is "LENGTH" (rhs (concl th))
      with Failure _ -> false) in
    STRIP_ASSUME_TAC
      (REWRITE_RULE[MATCH_MP all2app (TRANS l1 l2)] a2)) THEN

  (* the invariant with the new element in the heap *)
  REWRITE_TAC[memory_rel_def] THEN
  W(fun (asl,gl) ->
    let ai = grab asl (fun th ->
      hd_is "abs_ml_inv" (concl th) &&
      (try hd_is "CONS" (el 1 (snd(strip_comb (concl th)))) &&
           hd_is "dataSem_Block"
             (lhand (el 1 (snd(strip_comb (concl th)))))
       with Failure _ -> false)) in
    let args = snd(strip_comb (concl ai)) in
    let ps = tparts (el 3 args) in
    MAP_EVERY EXISTS_TAC
      [el 1 ps; el 4 args; el 3 ps; el 4 ps; el 5 ps; el 6 ps]) THEN
  REPEAT CONJ_TAC THENL
   [ALL_TAC;
    (* the roots: the pointer of the new reference and the rest *)
    REWRITE_TAC[word_ml_inv_def] THEN
    W(fun (asl,gl) ->
      let ai = grab asl (fun th ->
        hd_is "abs_ml_inv" (concl th) &&
        (try hd_is "CONS" (el 1 (snd(strip_comb (concl th)))) &&
             hd_is "dataSem_Block"
               (lhand (el 1 (snd(strip_comb (concl th)))))
         with Failure _ -> false)) in
      EXISTS_TAC
        (el 0 (tparts (el 3 (snd(strip_comb (concl ai))))))) THEN
    REWRITE_TAC[MAP; FST; SND; ALL2] THEN
    CONV_TAC (TOP_DEPTH_CONV BETA_CONV) THEN
    REPEAT CONJ_TAC THEN TRY (FIRST_ASSUM ACCEPT_TAC) THEN
    (* the word of the pointer is the one make_ptr builds *)
    W(fun (asl,gl) ->
      let mp = rhs gl in
      let sub = el 1 (snd(strip_comb mp)) in
      let aterm = lhand sub in
      let bwterm = rand aterm in
      let pt = lhand (rand (lhs gl)) in
      let mulp = mk_comb (rator bwterm,
                   mk_comb (rator (rand bwterm), pt)) in
      SUBST1_TAC (addreq asl sub mulp)) THEN
    W(fun (asl,gl) ->
      let gd = grab asl (fun th ->
        hd_is "good_dimindex" (concl th)) in
      REWRITE_TAC(word_addr_clauses ()) THEN
      REWRITE_TAC[make_cons_ptr_def; get_addr_def] THEN
      REWRITE_TAC[MATCH_MP bytes_in_word_mul_eq_shift gd;
                  WORD_SHL_COMPOSE] THEN
      ASM_SIMP_TAC[ARITH_RULE
        `!a b:num. a <= b ==> a + (b - a) = b`] THEN
      AP_TERM_TAC THEN
      GEN_REWRITE_TAC (LAND_CONV o ONCE_DEPTH_CONV)
        [get_lowerbits_or_1] THEN
      WORD_BITWISE_TAC);
    FIRST_ASSUM ACCEPT_TAC;
    W(fun (asl,gl) ->
      let spe = grab asl (fun th ->
        try hd_is "<=" (concl th) && is_var (lhand (concl th)) &&
            is_var (rand (concl th))
        with Failure _ -> false) in
      let les = mapfilter (fun (_,th) ->
        if (try is_eq (concl th) &&
                hd_is "LENGTH" (lhs (concl th)) &&
                hd_is "LENGTH" (rhs (concl th))
            with Failure _ -> false) then th else fail()) asl in
      MP_TAC (end_itlist CONJ (spe :: les))) THEN
    REWRITE_TAC[BlockRep_def; el_length_def; LENGTH; ADD1] THEN
    ARITH_TAC] THEN
  (* the store of the new heap: its length is the old one *)
  REWRITE_TAC[heap_in_memory_store_def] THEN
  W(fun (asl,gl) ->
    let hu = grab asl (fun th ->
      try hd_is "heap_store_unused_alt" (lhs (concl th))
      with Failure _ -> false) in
    REWRITE_TAC[MATCH_MP heap_store_unused_alt_IMP_length hu]) THEN
  W(fun (asl,gl) ->
    let dis = CONJUNCTS (distinctness "store_name") in
    REWRITE_TAC([FLOOKUP_UPDATE; FDOM_FUPDATE; IN_INSERT] @
                dis @ map GSYM dis)) THEN
  REPEAT CONJ_TAC THEN TRY (FIRST_ASSUM ACCEPT_TAC) THEN
  (* the two heaps of the store *)
  W(fun (asl,gl) ->
    let flk n = grab asl (fun th ->
      try hd_is "FLOOKUP" (lhs (concl th)) &&
          fst (dest_const (rand (lhs (concl th)))) = n
      with Failure _ -> false) in
    MAP_EVERY EXISTS_TAC
      [rand (rand (rhs (concl (flk "CurrHeap"))));
       rand (rand (rhs (concl (flk "OtherHeap"))))]) THEN
  REPEAT CONJ_TAC THEN TRY (FIRST_ASSUM ACCEPT_TAC) THEN
  TRY (wordeq THEN NO_TAC) THEN
  TRY (numeq THEN NO_TAC) THEN
  (* the heap with the new element, which the store wrote *)
  FIRST_ASSUM (fun h2 ->
    if not (try is_eq (concl h2) && hd_is "APPEND" (lhs (concl h2)) &&
                is_var (rhs (concl h2))
            with Failure _ -> false) then fail() else
    SUBST1_TAC (SYM h2)) THEN
  REWRITE_TAC[word_heap_APPEND; word_heap_heap_expand;
              word_heap_def; heap_length_APPEND;
              heap_length_heap_expand; BlockRep_def] THEN
  REWRITE_TAC[word_el_def] THEN
  CONV_TAC (TOP_DEPTH_CONV let_CONV) THEN
  REWRITE_TAC[word_payload_def] THEN
  CONV_TAC (TOP_DEPTH_CONV let_CONV) THEN
  REWRITE_TAC[word_list_def; LENGTH_MAP; el_length_def;
              heap_length_NIL; STAR_ASSOC; emp_STAR; STAR_emp] THEN
  (* the words of the element are the roots of the values, and its
     header is the one that encode_header gave *)
  W(fun (asl,gl) ->
    let a2 = grab asl (fun th ->
      try hd_is "ALL2" (concl th) &&
          not (hd_is "MAP" (el 2 (snd(strip_comb (concl th)))))
      with Failure _ -> false) in
    let a2args = snd(strip_comb (concl a2)) in
    let fterm = rator (lhs (snd(strip_abs (el 0 a2args)))) in
    let mapeq = EQ_MP (ISPECL [el 1 a2args; el 2 a2args; fterm]
                  EVERY2_f_EQ) a2 in
    let eh = grab asl (fun th ->
      try hd_is "encode_header" (lhs (concl th))
      with Failure _ -> false) in
    let mh = CONV_RULE NUM_REDUCE_CONV (MATCH_MP someif
               (REWRITE_RULE[encode_header_def] eh)) in
    let les = mapfilter (fun (_,th) ->
      if (try is_eq (concl th) &&
              hd_is "LENGTH" (lhs (concl th)) &&
              hd_is "LENGTH" (rhs (concl th))
          with Failure _ -> false) then th else fail()) asl in
    REWRITE_TAC(shl2 :: mapeq :: mh :: les)) THEN
  (* the condition of the payload, which the header's length says *)
  W(fun (asl,gl) ->
    let pred = rator gl in
    let fs = facs pred in
    let cell = find (hd_is "cond") fs in
    let rest = filter (fun t -> not (t = cell)) fs in
    let st = fst(strip_comb pred) in
    let mk a b = mk_comb(mk_comb(st,a),b) in
    SUBGOAL_THEN (mk_eq (pred, mk cell (end_itlist mk rest)))
      SUBST1_TAC THENL
     [REWRITE_TAC[STAR_AC; emp_STAR; STAR_emp]; ALL_TAC]) THEN
  REWRITE_TAC[cond_STAR] THEN
  CONJ_TAC THENL
   [W(fun (asl,gl) ->
      let eh = grab asl (fun th ->
        try hd_is "encode_header" (lhs (concl th))
        with Failure _ -> false) in
      let ls7 = grab asl (fun th ->
        try hd_is "<" (concl th) &&
            hd_is "+" (lhand (concl th)) &&
            hd_is "data_to_word_config_len_size"
              (lhand (lhand (concl th)))
        with Failure _ -> false) in
      let ls = MATCH_MP (ARITH_RULE
                 `!a b:num. a + 7 < b ==> a + 5 < b`) ls7 in
      let gd = grab asl (fun th ->
        hd_is "good_dimindex" (concl th)) in
      STRIP_ASSUME_TAC (MATCH_MP encode_header_IMP
        (CONJ eh (CONJ ls gd)))) THEN
    W(fun (asl,gl) ->
      let eh = grab asl (fun th ->
        try hd_is "encode_header" (lhs (concl th))
        with Failure _ -> false) in
      let mh = CONV_RULE NUM_REDUCE_CONV (MATCH_MP someif
                 (REWRITE_RULE[encode_header_def] eh)) in
      REWRITE_TAC[shl2; ARITH_RULE `!t:num. t * 4 = 4 * t`;
                  mh]) THEN
    ASM_REWRITE_TAC[];
    ALL_TAC] THEN
  (* and the words at the address the store wrote them to *)
  W(fun (asl,gl) ->
    let iscell t = hd_is "misc_word_list" t &&
                   hd_is "CONS" (el 1 (snd(strip_comb t))) in
    let sl = grab asl (fun th ->
      try hd_is "STAR" (rator (concl th)) &&
          exists iscell (facs (rator (concl th)))
      with Failure _ -> false) in
    let bnd = REWRITE_RULE[LENGTH; ADD1] (grab asl (fun th ->
      try hd_is "<=" (concl th) &&
          hd_is "LENGTH" (lhand (concl th))
      with Failure _ -> false)) in
    let arith = MATCH_MP (ARITH_RULE
                  `!l s:num. l <= s ==> l + (s - l) = s`) bnd in
    let sl2 = REWRITE_RULE[LENGTH; ADD1; word_list_def;
                word_heap_heap_expand; STAR_ASSOC; emp_STAR;
                STAR_emp; addsum] sl in
    REWRITE_TAC[heap_length_CONS; heap_length_NIL; el_length_def;
                ARITH_RULE `!n:num. n + 0 = n`; addsum;
                arith] THEN
    W(fun (asl2,gl2) ->
      let eq = prove (mk_eq (rator gl2, rator (concl sl2)),
                REWRITE_TAC[STAR_AC; emp_STAR; STAR_emp]) in
      ACCEPT_TAC (REWRITE_RULE[GSYM eq] sl2)))))
### memory_rel_MutCons
(* the allocation of an unfinalised mutable block, which is
   memory_rel_Cons1 with mutcons_thm in place of cons_thm_alt: the
   values of the block are the three parts that the index splits
   them into, the reference of the statement holds the block, and
   the pointer of it is make_cons_ptr of the offset as it is there *)
  ((let hd_is n t =
     (try fst(dest_const(fst(strip_comb t))) = n
      with Failure _ -> false) in
  let rec facs t =
    if hd_is "STAR" t then
      let args = snd(strip_comb t) in
      facs (el 0 args) @ facs (el 1 args)
    else [t] in
  let grab asl p =
    tryfind (fun (_,th) ->
      if (try p th with Failure _ -> false) then th else fail())
      asl in
  let front sp cell =
    let pred = rator (concl sp) in
    let fs = facs pred in
    let rest = filter (fun t -> not (t = cell)) fs in
    let st = fst(strip_comb pred) in
    let mk x y = mk_comb(mk_comb(st,x),y) in
    let target = mk cell (end_itlist mk rest) in
    let eq = prove (mk_eq (pred,target),
              REWRITE_TAC[STAR_AC; emp_STAR; STAR_emp]) in
    REWRITE_RULE[eq] sp in
  (* an ALL2 over two appends of matching lengths *)
  let all2app = prove
   (`!(P:A->B->bool) xs1 ys1 xs2 ys2.
       LENGTH xs1 = LENGTH ys1
       ==> (ALL2 P (xs1 ++ xs2) (ys1 ++ ys2) <=>
            ALL2 P xs1 ys1 /\ ALL2 P xs2 ys2)`,
    GEN_TAC THEN LIST_INDUCT_TAC THENL
     [X_GEN_TAC `ys1:(B)list` THEN
      STRUCT_CASES_TAC (ISPEC `ys1:(B)list` list_CASES) THEN
      REWRITE_TAC[LENGTH; APPEND; ALL2; NOT_SUC;
                  ARITH_RULE `~(0 = SUC n)`];
      X_GEN_TAC `ys1:(B)list` THEN
      STRUCT_CASES_TAC (ISPEC `ys1:(B)list` list_CASES) THEN
      REWRITE_TAC[LENGTH; APPEND; ALL2; NOT_SUC;
                  ARITH_RULE `~(SUC n = 0)`; SUC_INJ] THEN
      REPEAT GEN_TAC THEN DISCH_TAC THEN
      ASM_SIMP_TAC[] THEN CONV_TAC TAUT]) in
  (* two steps of an address in one *)
  let addsum = prove
   (`!(a:'a word) x y.
       a + bytes_in_word * n2w x + bytes_in_word * n2w y =
       a + bytes_in_word * n2w (x + y)`,
    REWRITE_TAC[WORD_ADD] THEN CONV_TAC WORD_RULE) in
  (* the shift of two that the tag of a block is encoded with *)
  let shl2 = prove
   (`!t. ((n2w t):(N)word) << 2 = n2w (4 * t)`,
    GEN_TAC THEN REWRITE_TAC[word_shl; VAL_WORD] THEN
    CONV_TAC NUM_REDUCE_CONV THEN
    REWRITE_TAC[WORD_EQ; CONG] THEN CONV_TAC MOD_DOWN_CONV THEN
    REWRITE_TAC[MULT_AC]) in
  let someif = prove
   (`!p (x:A) y. (if p then SOME x else NONE) = SOME y ==> x = y`,
    REPEAT GEN_TAC THEN COND_CASES_TAC THEN
    REWRITE_TAC[distinctness "option"; injectivity "option"]) in
  (* the numeric facts that the assumptions give *)
  let numfacts asl =
    mapfilter (fun (_,th) ->
      let c = concl th in
      if (try hd_is "<=" c || hd_is "<" c ||
              (is_eq c && hd_is "LENGTH" (lhs c) &&
               hd_is "LENGTH" (rhs c))
          with Failure _ -> false) then th else fail()) asl in
  let addreq asl t1 t2 =
      let fs = numfacts asl in
      let extra = (try
        let lt = grab asl (fun th ->
          try hd_is "<" (concl th) &&
              hd_is "LENGTH" (lhand (concl th))
          with Failure _ -> false) in
        let spe = grab asl (fun th ->
          try hd_is "<=" (concl th) && is_var (lhand (concl th)) &&
              is_var (rand (concl th))
          with Failure _ -> false) in
        [MATCH_MP (ARITH_RULE
           `!a b c:num. a < b /\ b <= c ==> a + 1 <= c`)
           (CONJ lt spe)]
        with Failure _ -> []) in
      let cnd = end_itlist CONJ (fs @ extra) in
      MP (prove (mk_imp (concl cnd, mk_eq (t1,t2)),
            DISCH_THEN (REPEAT_TCL CONJUNCTS_THEN
              (fun th -> ASSUME_TAC
                 (REWRITE_RULE[LENGTH; ADD1] th))) THEN
            ASM_REWRITE_TAC[BlockRep_def; el_length_def;
                            LENGTH; ADD1] THEN
            REWRITE_TAC[WORD_SUB; WORD_ADD] THEN
            ASM_SIMP_TAC[ARITH_RULE
              `!l s h:num. l <= s ==> l <= h + s`;
              ARITH_RULE
              `!a b c:num. a <= b /\ b <= c ==> a <= c`] THEN
            CONV_TAC WORD_RULE)) cnd in
  let wordeq =
    W(fun (asl,gl) ->
      REWRITE_TAC[addreq asl (rand (rand (lhs gl)))
                    (rand (rand (rhs gl)))]) in
  (* a store that says the same of a key, with the numbers of the
     new element in place of the old ones *)
  let numeq =
    W(fun (asl,gl) ->
      let fl = grab asl (fun th ->
        try hd_is "FLOOKUP" (lhs (concl th)) &&
            rand (lhs (concl th)) = rand (lhs gl) &&
            not (concl th = gl)
        with Failure _ -> false) in
      let isn t = (try hd_is "word" t &&
                       type_of (rand t) = `:num` &&
                       not (is_numeral (rand t))
                   with Failure _ -> false) in
      let ge = find_term isn (rhs gl) in
      let fe = find_term isn (rhs (concl fl)) in
      let fs = numfacts asl in
      let cnd = end_itlist CONJ fs in
      let eq = MP (prove (mk_imp (concl cnd,
                    mk_eq (rand ge, rand fe)),
                  DISCH_THEN (REPEAT_TCL CONJUNCTS_THEN
                    ASSUME_TAC) THEN
                  REWRITE_TAC[BlockRep_def; el_length_def;
                              LENGTH; ADD1] THEN
                  ASM_ARITH_TAC)) cnd in
      REWRITE_TAC[eq] THEN FIRST_ASSUM ACCEPT_TAC) in
  CONV_TAC (TOP_DEPTH_CONV let_CONV) THEN
  DISCH_THEN (REPEAT_TCL CONJUNCTS_THEN ASSUME_TAC) THEN
  (* what the invariant says of the stack *)
  FIRST_ASSUM (fun mr ->
    if hd_is "memory_rel" (concl mr)
    then MP_TAC (REWRITE_RULE[memory_rel_def; word_ml_inv_def] mr)
    else fail()) THEN
  DISCH_THEN STRIP_ASSUME_TAC THEN
  (* the values and the words that the ZIP of the stack holds *)
  W(fun (asl,gl) ->
    let le = grab asl (fun th ->
      try is_eq (concl th) && hd_is "LENGTH" (lhs (concl th)) &&
          hd_is "LENGTH" (rhs (concl th))
      with Failure _ -> false) in
    RULE_ASSUM_TRY (REWRITE_RULE[MAP_APPEND;
      MATCH_MP MAP_FST_ZIP le; MATCH_MP MAP_SND_ZIP le])) THEN
  (* the block that the cons makes of the values *)
  W(fun (asl,gl) ->
    let ai = grab asl (fun th -> hd_is "abs_ml_inv" (concl th)) in
    let lt = grab asl (fun th ->
      try hd_is "<" (concl th) && hd_is "LENGTH" (lhand (concl th))
      with Failure _ -> false) in
    let le = grab asl (fun th ->
      try is_eq (concl th) && hd_is "LENGTH" (lhs (concl th)) &&
          hd_is "LENGTH" (rhs (concl th))
      with Failure _ -> false) in
    let spe = grab asl (fun th ->
      try hd_is "<=" (concl th) &&
          lhand (concl th) = rand (concl lt)
      with Failure _ -> false) in
    let bnd = MATCH_MP (ARITH_RULE
                `!a b c d:num. a = b /\ b < c /\ c <= d
                               ==> a < d`)
                (CONJ le (CONJ lt spe)) in
    let ix = grab asl (fun th ->
      try hd_is "<" (concl th) && is_var (lhand (concl th)) &&
          hd_is "LENGTH" (rand (concl th))
      with Failure _ -> false) in
    let nd = grab asl (fun th ->
      try hd_is "IN" (dest_neg (concl th))
      with Failure _ -> false) in
    let gk = grab asl (fun th -> is_forall (concl th)) in
    let tg = el 2 (snd(strip_comb (find_term
               (hd_is "make_cons_ptr") gl))) in
    MP_TAC (SPEC tg (MATCH_MP (GEN_ALL mutcons_thm)
      (CONJ ai (CONJ bnd (CONJ ix (CONJ nd gk))))))) THEN
  DISCH_THEN STRIP_ASSUME_TAC THEN
  (* the ends of the heap that the store holds *)
  FIRST_ASSUM (fun hs ->
    if hd_is "heap_in_memory_store" (concl hs)
    then STRIP_ASSUME_TAC
           (REWRITE_RULE[heap_in_memory_store_def] hs)
    else fail()) THEN
  (* the unused space of the heap, where the element goes *)
  FIRST_ASSUM (fun hu ->
    if not (try hd_is "heap_store_unused_alt" (lhs (concl hu))
            with Failure _ -> false) then fail() else
    MP_TAC (REWRITE_RULE[heap_store_unused_alt_def] hu)) THEN
  COND_CASES_TAC THEN REWRITE_TAC[PAIR_EQ] THEN
  DISCH_THEN STRIP_ASSUME_TAC THEN
  FIRST_X_ASSUM (fun cnd ->
    if not (is_conj (concl cnd)) then fail() else
    if not (try hd_is "heap_lookup" (lhs (lhand (concl cnd)))
            with Failure _ -> false) then fail() else
    STRIP_ASSUME_TAC cnd) THEN
  (* so the heap splits there *)
  FIRST_ASSUM (fun hl ->
    if not (try hd_is "heap_lookup" (lhs (concl hl))
            with Failure _ -> false) then fail() else
    STRIP_ASSUME_TAC (MATCH_MP heap_lookup_SPLIT hl)) THEN
  REPEAT (FIRST_X_ASSUM (fun e ->
    if not (try is_eq (concl e) && is_var (lhs (concl e)) &&
                (hd_is "APPEND" (rhs (concl e)) ||
                 hd_is "heap_length" (rhs (concl e)))
            with Failure _ -> false) then fail() else
    SUBST_ALL_TAC e)) THEN
  (* and the store writes the element at the end of the space *)
  FIRST_ASSUM (fun hs ->
    if not (try hd_is "heap_store" (lhs (concl hs))
            with Failure _ -> false) then fail() else
    MP_TAC (REWRITE_RULE[heap_store_lemma; PAIR_EQ] hs)) THEN
  DISCH_THEN STRIP_ASSUME_TAC THEN
  (* the words of the unused space, and its end where the element
     goes *)
  W(fun (asl,gl) ->
    let bnd = grab asl (fun th ->
      try hd_is "<=" (concl th) &&
          hd_is "el_length" (lhand (concl th))
      with Failure _ -> false) in
    let e1 = REWRITE_RULE[BlockRep_def; el_length_def] bnd in
    let eq1 = MATCH_MP (ARITH_RULE
                `!k s:num. k + 1 <= s ==> (s - 1) + 1 = s`) e1 in
    let eq3 = MATCH_MP (ARITH_RULE
                `!k s:num. k + 1 <= s
                           ==> (k + 1) + (s - (k + 1)) = s`) e1 in
    let sep = grab asl (fun th ->
      try hd_is "STAR" (rator (concl th))
      with Failure _ -> false) in
    let sep1 = REWRITE_RULE[word_heap_APPEND; word_heap_def;
                 word_el_def; el_length_def; eq1] sep in
    let addr = el 0 (snd(strip_comb (find (fun t ->
                 hd_is "word_list_exists" t)
                 (facs (rator (concl sep1)))))) in
    let wle = REWRITE_RULE[eq3]
                (ISPECL [lhand (lhs (concl eq3));
                         rand (lhs (concl eq3)); addr]
                   word_list_exists_ADD) in
    let sep2 = REWRITE_RULE[wle; STAR_ASSOC] sep1 in
    ASSUME_TAC sep2) THEN
  (* the words of the element are as many as its roots, and its
     address is the end of the heap less them *)
  W(fun (asl,gl) ->
    let sep = grab asl (fun th ->
      try hd_is "STAR" (rator (concl th)) &&
          length (filter (hd_is "word_list_exists")
                   (facs (rator (concl th)))) = 2
      with Failure _ -> false) in
    let bnd = grab asl (fun th ->
      try hd_is "<=" (concl th) &&
          hd_is "el_length" (lhand (concl th))
      with Failure _ -> false) in
    let e1 = REWRITE_RULE[BlockRep_def; el_length_def] bnd in
    let rsl = rand (lhand (lhand (concl e1))) in
    let l1 = grab asl (fun th ->
      try is_eq (concl th) && lhs (concl th) =
            mk_icomb (`LENGTH`,rsl)
      with Failure _ -> false) in
    let l2 = grab asl (fun th ->
      try is_eq (concl th) && lhs (concl th) = rhs (concl l1) &&
          hd_is "LENGTH" (rhs (concl th))
      with Failure _ -> false) in
    let rw = TRANS l1 l2 in
    let xs = el 1 (snd(strip_comb (find_term
               (hd_is "data_to_word_memoryProof_store_list") gl))) in
    let lenq = prove (mk_eq (mk_binop `(+):num->num->num`
                  (rhs (concl rw)) `1`, mk_icomb (`LENGTH`,xs)),
                REWRITE_TAC[LENGTH] THEN ARITH_TAC) in
    let sep4 = REWRITE_RULE[lenq] (REWRITE_RULE[rw] sep) in
    let bnd2 = REWRITE_RULE[lenq] (REWRITE_RULE[rw] e1) in
    ASSUME_TAC sep4 THEN ASSUME_TAC bnd2 THEN
    REWRITE_TAC[lenq]) THEN
  (* which the store writes there *)
  W(fun (asl,gl) ->
    let iscell t = hd_is "word_list_exists" t &&
                   hd_is "LENGTH" (el 1 (snd(strip_comb t))) in
    let sep = grab asl (fun th ->
      try hd_is "STAR" (rator (concl th)) &&
          exists iscell (facs (rator (concl th)))
      with Failure _ -> false) in
    let cell = find iscell (facs (rator (concl sep))) in
    STRIP_ASSUME_TAC (MATCH_MP store_list_thm (front sep cell))) THEN
  (* the ends of the heap, and the memory that the store wrote *)
  W(fun (asl,gl) ->
    let flk n = grab asl (fun th ->
      try hd_is "FLOOKUP" (lhs (concl th)) &&
          fst (dest_const (rand (lhs (concl th)))) = n
      with Failure _ -> false) in
    let sl = grab asl (fun th ->
      try hd_is "data_to_word_memoryProof_store_list"
            (lhs (concl th))
      with Failure _ -> false) in
    MAP_EVERY EXISTS_TAC
      [rand (rand (rhs (concl (flk "NextFree"))));
       rand (rand (rhs (concl (flk "CurrHeap"))));
       rand (rhs (concl sl))]) THEN
  (* the address of the element is the end of the heap less the
     words it takes *)
  W(fun (asl,gl) ->
    let sl = find_term
               (hd_is "data_to_word_memoryProof_store_list") gl in
    let t1 = el 0 (snd(strip_comb sl)) in
    let iscell t = hd_is "misc_word_list" t &&
                   hd_is "CONS" (el 1 (snd(strip_comb t))) in
    let sep = grab asl (fun th ->
      try hd_is "STAR" (rator (concl th)) &&
          exists iscell (facs (rator (concl th)))
      with Failure _ -> false) in
    let t2 = el 0 (snd(strip_comb
               (find iscell (facs (rator (concl sep)))))) in
    let bnd = grab asl (fun th ->
      try hd_is "<=" (concl th) &&
          hd_is "LENGTH" (lhand (concl th))
      with Failure _ -> false) in
    let eq = MP (prove (mk_imp (concl bnd, mk_eq (t1,t2)),
                  DISCH_TAC THEN ASM_SIMP_TAC[WORD_SUB] THEN
                  REWRITE_TAC[WORD_ADD] THEN
                  CONV_TAC WORD_RULE)) bnd in
    REWRITE_TAC[eq]) THEN
  REPEAT CONJ_TAC THEN TRY (FIRST_ASSUM ACCEPT_TAC) THEN
  (* the roots of the element and the roots of the stack *)
  REPEAT (FIRST_X_ASSUM (fun e ->
    if not (try is_eq (concl e) && is_var (lhs (concl e)) &&
                hd_is "APPEND" (rhs (concl e))
            with Failure _ -> false) then fail() else
    SUBST_ALL_TAC e)) THEN
  W(fun (asl,gl) ->
    let a2 = grab asl (fun th ->
      hd_is "ALL2" (concl th) &&
      hd_is "APPEND" (el 1 (snd(strip_comb (concl th))))) in
    let rsl = lhand (el 1 (snd(strip_comb (concl a2)))) in
    let l1 = grab asl (fun th ->
      try is_eq (concl th) && lhs (concl th) =
            mk_icomb (`LENGTH`,rsl)
      with Failure _ -> false) in
    let l2 = grab asl (fun th ->
      try is_eq (concl th) && lhs (concl th) = rhs (concl l1) &&
          hd_is "LENGTH" (rhs (concl th))
      with Failure _ -> false) in
    STRIP_ASSUME_TAC
      (REWRITE_RULE[MATCH_MP all2app (TRANS l1 l2)] a2)) THEN

  (* the invariant with the new element in the heap *)
  REWRITE_TAC[memory_rel_def] THEN
  W(fun (asl,gl) ->
    let ai = grab asl (fun th ->
      hd_is "abs_ml_inv" (concl th) &&
      (try hd_is "CONS" (el 1 (snd(strip_comb (concl th))))
       with Failure _ -> false)) in
    let args = snd(strip_comb (concl ai)) in
    let ps = tparts (el 3 args) in
    MAP_EVERY EXISTS_TAC
      [el 1 ps; el 4 args; el 3 ps; el 4 ps; el 5 ps; el 6 ps]) THEN
  REPEAT CONJ_TAC THENL
   [ALL_TAC;
    (* the roots: the pointer of the new reference and the rest *)
    REWRITE_TAC[word_ml_inv_def] THEN
    W(fun (asl,gl) ->
      let ai = grab asl (fun th ->
        hd_is "abs_ml_inv" (concl th) &&
        (try hd_is "CONS" (el 1 (snd(strip_comb (concl th))))
         with Failure _ -> false)) in
      EXISTS_TAC
        (el 0 (tparts (el 3 (snd(strip_comb (concl ai))))))) THEN
    REWRITE_TAC[MAP; FST; SND; ALL2] THEN
    CONV_TAC (TOP_DEPTH_CONV BETA_CONV) THEN
    REPEAT CONJ_TAC THEN TRY (FIRST_ASSUM ACCEPT_TAC) THEN
    (* the word of the pointer is the one make_ptr builds *)
    W(fun (asl,gl) ->
      let mp = rhs gl in
      let sub = el 1 (snd(strip_comb mp)) in
      let aterm = lhand sub in
      let bwterm = rand aterm in
      let pt = lhand (rand (lhs gl)) in
      let mulp = mk_comb (rator bwterm,
                   mk_comb (rator (rand bwterm), pt)) in
      SUBST1_TAC (addreq asl sub mulp)) THEN
    W(fun (asl,gl) ->
      let gd = grab asl (fun th ->
        hd_is "good_dimindex" (concl th)) in
      REWRITE_TAC(word_addr_clauses ()) THEN
      REWRITE_TAC[make_cons_ptr_def; get_addr_def] THEN
      REWRITE_TAC[MATCH_MP bytes_in_word_mul_eq_shift gd;
                  WORD_SHL_COMPOSE] THEN
      ASM_SIMP_TAC[ARITH_RULE
        `!a b:num. a <= b ==> a + (b - a) = b`] THEN
      AP_TERM_TAC THEN
      GEN_REWRITE_TAC (LAND_CONV o ONCE_DEPTH_CONV)
        [get_lowerbits_or_1] THEN
      WORD_BITWISE_TAC);
    FIRST_ASSUM ACCEPT_TAC;
    W(fun (asl,gl) ->
      let spe = grab asl (fun th ->
        try hd_is "<=" (concl th) && is_var (lhand (concl th)) &&
            is_var (rand (concl th))
        with Failure _ -> false) in
      let les = mapfilter (fun (_,th) ->
        if (try is_eq (concl th) &&
                hd_is "LENGTH" (lhs (concl th)) &&
                hd_is "LENGTH" (rhs (concl th))
            with Failure _ -> false) then th else fail()) asl in
      MP_TAC (end_itlist CONJ (spe :: les))) THEN
    REWRITE_TAC[BlockRep_def; el_length_def; LENGTH; ADD1] THEN
    ARITH_TAC] THEN
  (* the store of the new heap: its length is the old one *)
  REWRITE_TAC[heap_in_memory_store_def] THEN
  W(fun (asl,gl) ->
    let hu = grab asl (fun th ->
      try hd_is "heap_store_unused_alt" (lhs (concl th))
      with Failure _ -> false) in
    REWRITE_TAC[MATCH_MP heap_store_unused_alt_IMP_length hu]) THEN
  W(fun (asl,gl) ->
    let dis = CONJUNCTS (distinctness "store_name") in
    REWRITE_TAC([FLOOKUP_UPDATE; FDOM_FUPDATE; IN_INSERT] @
                dis @ map GSYM dis)) THEN
  REPEAT CONJ_TAC THEN TRY (FIRST_ASSUM ACCEPT_TAC) THEN
  (* the two heaps of the store *)
  W(fun (asl,gl) ->
    let flk n = grab asl (fun th ->
      try hd_is "FLOOKUP" (lhs (concl th)) &&
          fst (dest_const (rand (lhs (concl th)))) = n
      with Failure _ -> false) in
    MAP_EVERY EXISTS_TAC
      [rand (rand (rhs (concl (flk "CurrHeap"))));
       rand (rand (rhs (concl (flk "OtherHeap"))))]) THEN
  REPEAT CONJ_TAC THEN TRY (FIRST_ASSUM ACCEPT_TAC) THEN
  TRY (wordeq THEN NO_TAC) THEN
  TRY (numeq THEN NO_TAC) THEN
  (* the heap with the new element, which the store wrote *)
  FIRST_ASSUM (fun h2 ->
    if not (try is_eq (concl h2) && hd_is "APPEND" (lhs (concl h2)) &&
                is_var (rhs (concl h2))
            with Failure _ -> false) then fail() else
    SUBST1_TAC (SYM h2)) THEN
  REWRITE_TAC[word_heap_APPEND; word_heap_heap_expand;
              word_heap_def; heap_length_APPEND;
              heap_length_heap_expand; BlockRep_def] THEN
  REWRITE_TAC[word_el_def] THEN
  CONV_TAC (TOP_DEPTH_CONV let_CONV) THEN
  REWRITE_TAC[word_payload_def] THEN
  CONV_TAC (TOP_DEPTH_CONV let_CONV) THEN
  REWRITE_TAC[word_list_def; LENGTH_MAP; el_length_def;
              heap_length_NIL; STAR_ASSOC; emp_STAR; STAR_emp] THEN
  (* the words of the element are the roots of the values, and its
     header is the one that encode_header gave *)
  W(fun (asl,gl) ->
    let a2 = grab asl (fun th ->
      try hd_is "ALL2" (concl th) &&
          not (hd_is "MAP" (el 2 (snd(strip_comb (concl th)))))
      with Failure _ -> false) in
    let a2args = snd(strip_comb (concl a2)) in
    let fterm = rator (lhs (snd(strip_abs (el 0 a2args)))) in
    let mapeq = EQ_MP (ISPECL [el 1 a2args; el 2 a2args; fterm]
                  EVERY2_f_EQ) a2 in
    let eh = grab asl (fun th ->
      try hd_is "encode_header" (lhs (concl th))
      with Failure _ -> false) in
    let mh = CONV_RULE NUM_REDUCE_CONV (MATCH_MP someif
               (REWRITE_RULE[encode_header_def] eh)) in
    let les = mapfilter (fun (_,th) ->
      if (try is_eq (concl th) &&
              hd_is "LENGTH" (lhs (concl th)) &&
              hd_is "LENGTH" (rhs (concl th))
          with Failure _ -> false) then th else fail()) asl in
    REWRITE_TAC(shl2 :: mapeq :: mh :: les)) THEN
  (* the condition of the payload, which the header's length says *)
  W(fun (asl,gl) ->
    let pred = rator gl in
    let fs = facs pred in
    let cell = find (hd_is "cond") fs in
    let rest = filter (fun t -> not (t = cell)) fs in
    let st = fst(strip_comb pred) in
    let mk a b = mk_comb(mk_comb(st,a),b) in
    SUBGOAL_THEN (mk_eq (pred, mk cell (end_itlist mk rest)))
      SUBST1_TAC THENL
     [REWRITE_TAC[STAR_AC; emp_STAR; STAR_emp]; ALL_TAC]) THEN
  REWRITE_TAC[cond_STAR] THEN
  CONJ_TAC THENL
   [W(fun (asl,gl) ->
      let eh = grab asl (fun th ->
        try hd_is "encode_header" (lhs (concl th))
        with Failure _ -> false) in
      let ls7 = grab asl (fun th ->
        try hd_is "<" (concl th) &&
            hd_is "+" (lhand (concl th)) &&
            hd_is "data_to_word_config_len_size"
              (lhand (lhand (concl th)))
        with Failure _ -> false) in
      let ls = MATCH_MP (ARITH_RULE
                 `!a b:num. a + 7 < b ==> a + 5 < b`) ls7 in
      let gd = grab asl (fun th ->
        hd_is "good_dimindex" (concl th)) in
      STRIP_ASSUME_TAC (MATCH_MP encode_header_IMP
        (CONJ eh (CONJ ls gd)))) THEN
    W(fun (asl,gl) ->
      let eh = grab asl (fun th ->
        try hd_is "encode_header" (lhs (concl th))
        with Failure _ -> false) in
      let mh = CONV_RULE NUM_REDUCE_CONV (MATCH_MP someif
                 (REWRITE_RULE[encode_header_def] eh)) in
      REWRITE_TAC[shl2; ARITH_RULE `!t:num. t * 4 = 4 * t`;
                  mh]) THEN
    ASM_REWRITE_TAC[];
    ALL_TAC] THEN
  (* and the words at the address the store wrote them to *)
  W(fun (asl,gl) ->
    let iscell t = hd_is "misc_word_list" t &&
                   hd_is "CONS" (el 1 (snd(strip_comb t))) in
    let sl = grab asl (fun th ->
      try hd_is "STAR" (rator (concl th)) &&
          exists iscell (facs (rator (concl th)))
      with Failure _ -> false) in
    let bnd = REWRITE_RULE[LENGTH; ADD1] (grab asl (fun th ->
      try hd_is "<=" (concl th) &&
          hd_is "LENGTH" (lhand (concl th))
      with Failure _ -> false)) in
    let arith = MATCH_MP (ARITH_RULE
                  `!l s:num. l <= s ==> l + (s - l) = s`) bnd in
    let sl2 = REWRITE_RULE[LENGTH; ADD1; word_list_def;
                word_heap_heap_expand; STAR_ASSOC; emp_STAR;
                STAR_emp; addsum] sl in
    REWRITE_TAC[heap_length_CONS; heap_length_NIL; el_length_def;
                ARITH_RULE `!n:num. n + 0 = n`; addsum;
                arith] THEN
    W(fun (asl2,gl2) ->
      let eq = prove (mk_eq (rator gl2, rator (concl sl2)),
                REWRITE_TAC[STAR_AC; emp_STAR; STAR_emp]) in
      ACCEPT_TAC (REWRITE_RULE[GSYM eq] sl2)))))
### finalise_cons_none
  (* the clauses of the definition decide on the value and on what
     the references hold under the pointer, and the recursion is on
     the references with that key deleted, so the induction is on
     their size (HOL4's finalise_cons_ind, which the port does not
     have) *)
  (* the size of a tree under a delete, which the measure needs:
     HOL4 has it as size_delete of sptreeTheory
     (sptreeScript.sml:1940) and that a tree something is in is not
     empty as lookup_zero of miscTheory (miscScript.sml:3977, which
     ml/misc/misc.ml assumes).  They stand here because this is the
     only proof of the port that needs them; the size of the two
     smart constructors is the size of the plain ones, as their
     lookup is (lookup_mk_BN of ml/lib/sptree.ml) *)
  (let size_mk_BN = prove
     (`!t1 (t2:(A)spt).
         sptree_size (mk_BN t1 t2) = sptree_size (BN t1 t2)`,
      REPEAT GEN_TAC THEN
      GEN_REWRITE_TAC (LAND_CONV o RAND_CONV) [mk_BN_def] THEN
      STRUCT_CASES_TAC(ISPEC `t1:(A)spt` (cases_of `:(A)spt`)) THEN
      STRUCT_CASES_TAC(ISPEC `t2:(A)spt` (cases_of `:(A)spt`)) THEN
      MATCH_REDUCE_TAC THEN REWRITE_TAC[size_def] THEN ARITH_TAC) in
   let size_mk_BS = prove
     (`!t1 (x:A) t2.
         sptree_size (mk_BS t1 x t2) = sptree_size (BS t1 x t2)`,
      REPEAT GEN_TAC THEN
      GEN_REWRITE_TAC (LAND_CONV o RAND_CONV) [mk_BS_def] THEN
      STRUCT_CASES_TAC(ISPEC `t1:(A)spt` (cases_of `:(A)spt`)) THEN
      STRUCT_CASES_TAC(ISPEC `t2:(A)spt` (cases_of `:(A)spt`)) THEN
      MATCH_REDUCE_TAC THEN REWRITE_TAC[size_def] THEN ARITH_TAC) in
   let lookup_zero = prove
     (`!(t:(A)spt) n x.
         sptree_lookup n t = SOME x ==> ~(sptree_size t = 0)`,
      MATCH_MP_TAC spt_INDUCT THEN REPEAT CONJ_TAC THENL
       [REWRITE_TAC[lookup_def; distinctness "option"];
        REPEAT GEN_TAC THEN REWRITE_TAC[lookup_def; size_def] THEN
        DISCH_TAC THEN ARITH_TAC;
        (* the key of a BN goes down one of the two subtrees, and
           the size of that one is not zero by its hypothesis *)
        REPEAT GEN_TAC THEN STRIP_TAC THEN REPEAT GEN_TAC THEN
        REWRITE_TAC[lookup_def; size_def] THEN
        COND_CASES_TAC THEN REWRITE_TAC[distinctness "option"] THEN
        COND_CASES_TAC THEN DISCH_TAC THEN
        FIRST_X_ASSUM (fun ih -> FIRST_ASSUM (fun lk ->
          MP_TAC (MATCH_MP (GEN_ALL ih) lk))) THEN ARITH_TAC;
        (* and a BS holds one itself *)
        REPEAT GEN_TAC THEN STRIP_TAC THEN REPEAT GEN_TAC THEN
        REWRITE_TAC[lookup_def; size_def] THEN
        DISCH_TAC THEN ARITH_TAC]) in
   let size_delete = prove
     (`!(t:(A)spt) n.
         sptree_size (sptree_delete n t) =
         (if sptree_lookup n t = NONE then sptree_size t
          else sptree_size t - 1)`,
      let FIN =
        W(fun (asl,w) ->
          CASES_ON_TAC (find_term (hd_is "sptree_lookup") w)) THEN
        REWRITE_TAC[distinctness "option"] THEN
        TRY (FIRST_ASSUM (fun th ->
          MP_TAC (MATCH_MP (GEN_ALL lookup_zero) th))) THEN
        ARITH_TAC in
      MATCH_MP_TAC spt_INDUCT THEN REPEAT CONJ_TAC THEN
      REPEAT STRIP_TAC THEN
      REWRITE_TAC[delete_def; lookup_def; size_def] THEN
      COND_CASES_TAC THEN
      ASM_REWRITE_TAC[size_def; distinctness "option"] THEN
      TRY ARITH_TAC THEN
      COND_CASES_TAC THEN
      ASM_REWRITE_TAC[size_mk_BN; size_mk_BS; size_def] THEN
      FIN) in
   let size_delete_LESS = prove
     (`!(t:(A)spt) n x.
         sptree_lookup n t = SOME x
         ==> sptree_size (sptree_delete n t) < sptree_size t`,
      REPEAT GEN_TAC THEN DISCH_TAC THEN
      ASM_SIMP_TAC[size_delete; distinctness "option"] THEN
      FIRST_ASSUM (fun th ->
        MP_TAC (MATCH_MP (GEN_ALL lookup_zero) th)) THEN
      ARITH_TAC) in
   let ref_rws =
     let ds = CONJUNCTS (distinctness "bvlSem_ref") in
     injectivity "option" :: distinctness "option" ::
     injectivity "bvlSem_ref" :: ds @ map GSYM ds in
   (* the equation of the definition, in the one assumption that is
      about the call: a rewrite of every assumption would open the
      call of the induction hypothesis as well *)
   let OPEN_FC =
     FIRST_X_ASSUM (fun fc ->
       let c = concl fc in
       if not (is_eq c) ||
          not (hd_is "dataSem_finalise_cons" (lhs c)) then fail() else
       ASSUME_TAC (ONCE_REWRITE_RULE[dataSem_finalise_cons_def] fc)) in
   (* a pattern that MATCH_CONV leaves as a guard is decided by the
      constructors of the reference, in both orders: the guard has
      the pattern on the left *)
   let TIDY =
     RULE_ASSUM_TRY (REWRITE_RULE ref_rws) THEN
     MATCH_TIDY_TAC THEN
     TRY SAFE_MATCH_REDUCE_ASM_TAC THEN
     MATCH_TIDY_TAC in
   let CLOSE_ARM = TRY (SOLVED (VAR_EQ_TAC THEN ASM_REWRITE_TAC[])) in
   let the_asm p (asl,w) =
     snd (find (fun (_,th) -> p (concl th)) asl) in
   (* the assumption that says what the call gives: a COND by its
      head constant, because the file redefines is_cond *)
   let big_asm = the_asm (fun c -> is_eq c && hd_is "COND" (lhand c)) in
   let SPLIT_LOOKUP =
     W(fun gl ->
       CASES_ON_TAC (find_term (hd_is "sptree_lookup")
                       (concl (big_asm gl)))) in
   let SPLIT_REF =
     W(fun gl ->
       let lk = the_asm (fun c -> is_eq c &&
                  hd_is "sptree_lookup" (lhand c) &&
                  hd_is "SOME" (rand c)) gl in
       CASES_ON_TAC (rand (rand (concl lk)))) in
   (* the result of the call is a triple, and the arm of the match
      only reduces once its components are there *)
   let SPLIT_PAIR_ARG =
     W(fun gl ->
       let fc = the_asm (fun c -> is_eq c &&
                  hd_is "dataSem_finalise_cons" (lhand c) &&
                  hd_is "SOME" (rand c)) gl in
       let rec pv t =
         if is_var t && prod_type (type_of t) then t
         else if hd_is "," t then pv (rand t)
         else failwith "pv" in
       CASES_ON_TAC (pv (rand (rand (concl fc))))) in
   let aux = prove
    (`!n v (refs:((dataSem_v)bvlSem_ref)spt) ts_opt v' refs' ts'.
        sptree_size refs = n /\
        dataSem_finalise_cons v refs ts_opt = SOME (v',refs',ts') /\
        sptree_lookup ptr refs = NONE
        ==> sptree_lookup ptr refs' = NONE`,
     MATCH_MP_TAC num_WF THEN
     X_GEN_TAC `n:num` THEN DISCH_TAC THEN
     REPEAT GEN_TAC THEN STRIP_TAC THEN
     (* a value that is not a pointer leaves the references alone *)
     CASES_ON_TAC `v:dataSem_v` THEN
     OPEN_FC THEN
     SAFE_MATCH_REDUCE_ASM_TAC THEN MATCH_TIDY_TAC THEN CLOSE_ARM THEN
     (* and so does a pointer at anything but an unfinalised
        MutBlock *)
     SPLIT_LOOKUP THEN TIDY THEN CLOSE_ARM THEN
     SPLIT_REF THEN TIDY THEN CLOSE_ARM THEN
     (* the block is not finalised yet, or the result would be
        NONE *)
     W(fun gl ->
       ASM_CASES_TAC (lhand (rator (lhand (concl (big_asm gl)))))) THEN
     ASM_FS_TAC THEN TIDY THEN CLOSE_ARM THEN
     (* and the call on its centre goes through *)
     W(fun gl ->
       CASES_ON_TAC (find_term (hd_is "dataSem_finalise_cons")
                       (concl (big_asm gl)))) THEN
                       TIDY THEN CLOSE_ARM THEN
     REPEAT SPLIT_PAIR_ARG THEN TIDY THEN CLOSE_ARM THEN
     (* the pointer is not the key of the block that is finalised,
        because the references have nothing under it *)
     VAR_EQ_TAC THEN
     ASM_REWRITE_TAC[lookup_insert] THEN
     COND_CASES_TAC THENL
      [POP_ASSUM_LIST (fun l -> MAP_EVERY ASSUME_TAC
         (filter (fun th -> not (is_forall (concl th))) l)) THEN
       ASM_MESON_TAC[distinctness "option"];
       ALL_TAC] THEN
     (* and the references of the call have nothing under it
        either *)
     W(fun gl ->
       let lk = the_asm (fun c -> is_eq c &&
                  hd_is "sptree_lookup" (lhand c) &&
                  hd_is "NONE" (rand c)) gl in
       let fc = the_asm (fun c -> is_eq c &&
                  hd_is "dataSem_finalise_cons" (lhand c)) gl in
       let dl = el 1 (snd (strip_comb (lhand (concl fc)))) in
       SUBGOAL_THEN (mk_eq (mk_comb (rator (lhand (concl lk)), dl),
                            rand (concl lk))) ASSUME_TAC THENL
        [ASM_REWRITE_TAC[lookup_delete]; ALL_TAC]) THEN
     (* so the hypothesis of the induction applies to the call: the
        delete makes the references smaller *)
     FIRST_X_ASSUM (fun ih ->
       if not (is_forall (concl ih)) then fail() else
       W(fun gl ->
         let fc = the_asm (fun c -> is_eq c &&
                    hd_is "dataSem_finalise_cons" (lhand c)) gl in
         let dl = el 1 (snd (strip_comb (lhand (concl fc)))) in
         MP_TAC (SPEC (list_mk_icomb "sptree_size" [dl]) ih))) THEN
     (ANTS_TAC THENL
       [FIRST_ASSUM (fun lk ->
          let c = concl lk in
          if not (is_eq c) || not (hd_is "sptree_lookup" (lhand c)) ||
             not (hd_is "SOME" (rand c)) then fail() else
          MP_TAC (MATCH_MP (GEN_ALL size_delete_LESS) lk)) THEN
        ASM_ARITH_TAC;
        ALL_TAC]) THEN
     DISCH_THEN MATCH_MP_TAC THEN
     ASM_MESON_TAC[]) in
   REPEAT GEN_TAC THEN STRIP_TAC THEN ASM_MESON_TAC[aux])
### bc_stack_ref_inv_MutBlock_centre
  (* the invariant of the longer stack holds of the same f and tf:
     the pointer of the reference is what v_inv gives (its Thunk
     cases are out because the reference is a MutBlock), the block
     is what bc_ref_inv gives for the reference, which is reachable
     from the stack, and the centre of the payload is the value at
     the index that the goal reads.  The three parts of the
     invariant that the longer stack changes are all_ts (which only
     grows), all_vs (where the centre is a value of the refs
     already) and the reachability (where the centre reaches no
     more than the pointer does) *)
  (let el_mid = prove
    (`!(l1:(A)list) c l2.
        EL (LENGTH l1) (APPEND l1 (CONS c l2)) = c`,
    LIST_INDUCT_TAC THEN REPEAT GEN_TAC THEN
    REWRITE_TAC[LENGTH; APPEND; EL; HD; TL] THEN
    ASM_REWRITE_TAC[]) in
   STRIP_TAC THEN
   FIRST_X_ASSUM (fun inv ->
     if not (hd_is "bc_stack_ref_inv" (concl inv)) then fail() else
     STRIP_ASSUME_TAC
       (REWRITE_RULE[bc_stack_ref_inv_def; ALL2] inv)) THEN
   CONV_TAC(TOP_DEPTH_CONV BETA_CONV) THEN
   RULE_ASSUM_TRY (CONV_RULE(TOP_DEPTH_CONV BETA_CONV)) THEN
   (* the pointer of the reference *)
   FIRST_ASSUM (fun lk ->
     if not (is_eq (concl lk) &&
             hd_is "bvlSem_MutBlock" (rand (rhs (concl lk))))
     then fail() else
     FIRST_ASSUM (fun vi ->
       if not (hd_is "v_inv" (concl vi)) then fail() else
       MP_TAC (REWRITE_RULE[lk; injectivity "option";
                            distinctness "bvlSem_ref"]
                 (ONCE_REWRITE_RULE[v_inv_def] vi)))) THEN
   STRIP_TAC THEN
   (* the reference is reachable from the stack, so the invariant
      holds of its block *)
   FIRST_ASSUM (fun rr ->
     let bod = snd (strip_forall (concl rr)) in
     if not (is_imp bod && hd_is "bc_ref_inv" (rand bod)) then fail()
     else MP_TAC (SPEC `ptr:num` rr)) THEN
   (ANTS_TAC THENL
    [CONJ_TAC THENL
      [REWRITE_TAC[reachable_refs_def] THEN
       EXISTS_TAC `RefPtr b ptr` THEN EXISTS_TAC `ptr:num` THEN
       REWRITE_TAC[MEM; get_refs_def] THEN
       MESON_TAC[RTC_RULES];
       FIRST_ASSUM ACCEPT_TAC];
     ALL_TAC]) THEN
   ASM_SIMP_TAC[bc_ref_inv_def; FLOOKUP_DEF] THEN
   MATCH_REDUCE_TAC THEN
   CONV_TAC(TOP_DEPTH_CONV let_CONV) THEN
   STRIP_TAC THEN
   (* the block, whose payload holds the centre *)
   FIRST_ASSUM (fun lr ->
     if not (hd_is "ALL2" (concl lr)) then fail() else
     MP_TAC (REWRITE_RULE[LIST_REL_EL_EQN] lr)) THEN
   REWRITE_TAC[LENGTH_APPEND; LENGTH] THEN
   CONV_TAC NUM_REDUCE_CONV THEN
   DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC
     (fun el -> MP_TAC (SPEC `LENGTH (left:(dataSem_v)list)` el))) THEN
   (ANTS_TAC THENL [ASM_ARITH_TAC; ALL_TAC]) THEN
   REWRITE_TAC[APPEND; el_mid] THEN
   CONV_TAC(TOP_DEPTH_CONV BETA_CONV) THEN
   STRIP_TAC THEN
   (* and then the invariant of the longer stack *)
   W(fun (asl,w) ->
     let hl = find (fun (_,th) -> is_eq (concl th) &&
                      hd_is "heap_lookup" (lhs (concl th))) asl in
     let ptr_n = rand (rator (lhs (concl (snd hl)))) in
     let zs = rand (rand (rand (concl (snd hl)))) in
     EXISTS_TAC ptr_n THEN EXISTS_TAC zs) THEN
   REPEAT CONJ_TAC THEN TRY (FIRST_ASSUM ACCEPT_TAC) THEN
   TRY ASM_ARITH_TAC THEN
   (W(fun (asl,w) ->
       let sub p = rand (lhand (concl (snd (find (fun (_,th) ->
         hd_is "SUBSET" (concl th) &&
         hd_is p (rand (concl th))) asl)))) in
       REWRITE_TAC[bc_stack_ref_inv_def] THEN
       EXISTS_TAC (sub "domain") THEN EXISTS_TAC (sub "all_ts")) THEN
     REWRITE_TAC[ALL2] THEN
     CONV_TAC(TOP_DEPTH_CONV BETA_CONV) THEN
     REPEAT CONJ_TAC THEN TRY (FIRST_ASSUM ACCEPT_TAC) THEN
     TRY (ASM_MESON_TAC[SUBSET_TRANS; GEN_ALL all_ts_CONS_SUBSET]) THEN
     TRY (ASM_MESON_TAC[blocks_unique_SUBSET;
                        GEN_ALL all_vs_MutBlock_centre]) THEN
     REPEAT STRIP_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
     ASM_MESON_TAC[GEN_ALL reachable_refs_MutBlock_centre]))
### bc_stack_ref_inv_MutBlock_F
  (* the attempt: the proof of the source names
     bc_stack_ref_inv_def, INJ_FUPDATE, v_inv_def,
     reachable_refs_def, bc_ref_inv_def, FLOOKUP_DEF.  What is here
     rewrites with them and closes by arithmetic, and the cheat is
     behind it until the proof is written.  A MESON over them is
     what the next round adds; it costs a load ten minutes to have
     it in every attempt and it closed none of them *)
  (ATTEMPT_TAC 2
    (REPEAT GEN_TAC THEN REPEAT STRIP_TAC THEN
     ASM_REWRITE_TAC[bc_stack_ref_inv_def; INJ_FUPDATE;
       v_inv_def; reachable_refs_def; bc_ref_inv_def;
       FLOOKUP_DEF] THEN
     TRY ASM_ARITH_TAC))
### bc_stack_ref_inv_FinaliseCons_lemma
  (* the attempt: the proof of the source names union_def,
     lookup_union, bc_stack_ref_inv_MutBlock_centre,
     bc_stack_ref_inv_union_del_ins_lemma, bc_stack_ref_inv_def,
     THE.  What is here rewrites with them and closes by arithmetic,
     and the cheat is behind it until the proof is written.  A MESON
     over them is what the next round adds; it costs a load ten
     minutes to have it in every attempt and it closed none of them *)
  (ATTEMPT_TAC 2
    (REPEAT GEN_TAC THEN REPEAT STRIP_TAC THEN
     ASM_REWRITE_TAC[union_def; lookup_union;
       bc_stack_ref_inv_MutBlock_centre;
       bc_stack_ref_inv_union_del_ins_lemma;
       bc_stack_ref_inv_def; THE] THEN
     TRY ASM_ARITH_TAC))
### memory_rel_Ref
(* the allocation of a reference in the unused space: new_ref_thm
   gives the invariant of the stack with the new pointer pushed and
   the store of the element into the unused space, and pop_thm takes
   the values that the element holds off that stack again, which is
   the invariant the statement wants.  Of the heap the condition of
   heap_store_unused says where the space is, so heap_lookup_SPLIT
   and heap_store_lemma make the new heap, and the words of the
   space split (word_list_exists_ADD) into what stays unused and the
   element's own words, which store_list_thm writes -- the header
   that encode_header gave (its length is the condition of the
   payload, by encode_header_IMP) and the roots of the values, which
   EVERY2_f_EQ says are the words of the statement.  The ends of the
   heap that the store holds move down by those words, and the
   pointer of the new reference is make_ptr of the offset: the shift
   of bytes_in_word_mul_eq_shift composed with the one of make_ptr
   is the shift of get_addr, and the lower bits of a zero
   annotation are the one bit *)
  ((let hd_is n t =
     (try fst(dest_const(fst(strip_comb t))) = n
      with Failure _ -> false) in
  let rec facs t =
    if hd_is "STAR" t then
      let args = snd(strip_comb t) in
      facs (el 0 args) @ facs (el 1 args)
    else [t] in
  let grab asl p =
    tryfind (fun (_,th) ->
      if (try p th with Failure _ -> false) then th else fail())
      asl in
  let front sp cell =
    let pred = rator (concl sp) in
    let fs = facs pred in
    let rest = filter (fun t -> not (t = cell)) fs in
    let st = fst(strip_comb pred) in
    let mk x y = mk_comb(mk_comb(st,x),y) in
    let target = mk cell (end_itlist mk rest) in
    let eq = prove (mk_eq (pred,target),
              REWRITE_TAC[STAR_AC; emp_STAR; STAR_emp]) in
    REWRITE_RULE[eq] sp in
  (* the bits of a zero word are zero *)
  let bits0 = prove
   (`!h l. word_bits h l ((n2w 0):(N)word) = n2w 0`,
    REWRITE_TAC[word_bits; WORD_EQ_BITS_ALT; BIT_WORD_SUBWORD;
                BIT_WORD_0] THEN
    CONV_TAC TAUT) in
  (* an ALL2 over two appends of matching lengths *)
  let all2app = prove
   (`!(P:A->B->bool) xs1 ys1 xs2 ys2.
       LENGTH xs1 = LENGTH ys1
       ==> (ALL2 P (xs1 ++ xs2) (ys1 ++ ys2) <=>
            ALL2 P xs1 ys1 /\ ALL2 P xs2 ys2)`,
    GEN_TAC THEN LIST_INDUCT_TAC THENL
     [X_GEN_TAC `ys1:(B)list` THEN
      STRUCT_CASES_TAC (ISPEC `ys1:(B)list` list_CASES) THEN
      REWRITE_TAC[LENGTH; APPEND; ALL2; NOT_SUC;
                  ARITH_RULE `~(0 = SUC n)`];
      X_GEN_TAC `ys1:(B)list` THEN
      STRUCT_CASES_TAC (ISPEC `ys1:(B)list` list_CASES) THEN
      REWRITE_TAC[LENGTH; APPEND; ALL2; NOT_SUC;
                  ARITH_RULE `~(SUC n = 0)`; SUC_INJ] THEN
      REPEAT GEN_TAC THEN DISCH_TAC THEN
      ASM_SIMP_TAC[] THEN CONV_TAC TAUT]) in
  (* an equation of two addresses, from the numeric facts *)
  let numfacts asl =
    mapfilter (fun (_,th) ->
      let c = concl th in
      if (try hd_is "<=" c || hd_is "<" c ||
              (is_eq c && hd_is "LENGTH" (lhs c) &&
               hd_is "LENGTH" (rhs c))
          with Failure _ -> false) then th else fail()) asl in
  (* two steps of an address in one *)
  let addsum = prove
   (`!(a:'a word) x y.
       a + bytes_in_word * n2w x + bytes_in_word * n2w y =
       a + bytes_in_word * n2w (x + y)`,
    REWRITE_TAC[WORD_ADD] THEN CONV_TAC WORD_RULE) in
  let someif = prove
   (`!p (x:A) y. (if p then SOME x else NONE) = SOME y ==> x = y`,
    REPEAT GEN_TAC THEN COND_CASES_TAC THEN
    REWRITE_TAC[distinctness "option"; injectivity "option"]) in
  let addreq asl t1 t2 =
      let fs = numfacts asl in
      let extra = (try
        let lt = grab asl (fun th ->
          try hd_is "<" (concl th) &&
              hd_is "LENGTH" (lhand (concl th))
          with Failure _ -> false) in
        let spe = grab asl (fun th ->
          try hd_is "<=" (concl th) && is_var (lhand (concl th)) &&
              is_var (rand (concl th))
          with Failure _ -> false) in
        [MATCH_MP (ARITH_RULE
           `!a b c:num. a < b /\ b <= c ==> a + 1 <= c`)
           (CONJ lt spe)]
        with Failure _ -> []) in
      let cnd = end_itlist CONJ (fs @ extra) in
      MP (prove (mk_imp (concl cnd, mk_eq (t1,t2)),
            DISCH_THEN (REPEAT_TCL CONJUNCTS_THEN
              (fun th -> ASSUME_TAC
                 (REWRITE_RULE[LENGTH; ADD1] th))) THEN
            ASM_REWRITE_TAC[LENGTH; ADD1] THEN
            REWRITE_TAC[WORD_SUB; WORD_ADD] THEN
            ASM_SIMP_TAC[ARITH_RULE
              `!l s h:num. l <= s ==> l <= h + s`;
              ARITH_RULE
              `!a b c:num. a <= b /\ b <= c ==> a <= c`] THEN
            CONV_TAC WORD_RULE)) cnd in
  let wordeq =
    W(fun (asl,gl) ->
      REWRITE_TAC[addreq asl (rand (rand (lhs gl)))
                    (rand (rand (rhs gl)))]) in
  CONV_TAC (TOP_DEPTH_CONV let_CONV) THEN
  DISCH_THEN (REPEAT_TCL CONJUNCTS_THEN ASSUME_TAC) THEN
  (* what the invariant says of the stack *)
  FIRST_ASSUM (fun mr ->
    if hd_is "memory_rel" (concl mr)
    then MP_TAC (REWRITE_RULE[memory_rel_def; word_ml_inv_def] mr)
    else fail()) THEN
  DISCH_THEN STRIP_ASSUME_TAC THEN
  (* the values and the words that the ZIP of the stack holds *)
  W(fun (asl,gl) ->
    let le = grab asl (fun th ->
      try is_eq (concl th) && hd_is "LENGTH" (lhs (concl th)) &&
          hd_is "LENGTH" (rhs (concl th))
      with Failure _ -> false) in
    RULE_ASSUM_TRY (REWRITE_RULE[MAP_APPEND;
      MATCH_MP MAP_FST_ZIP le; MATCH_MP MAP_SND_ZIP le])) THEN
  (* the store of the new reference *)
  W(fun (asl,gl) ->
    let ai = grab asl (fun th -> hd_is "abs_ml_inv" (concl th)) in
    let nd = grab asl (fun th ->
      try hd_is "IN" (dest_neg (concl th)) with Failure _ -> false) in
    let lt = grab asl (fun th ->
      try hd_is "<" (concl th) && hd_is "LENGTH" (lhand (concl th))
      with Failure _ -> false) in
    let le = grab asl (fun th ->
      try is_eq (concl th) && hd_is "LENGTH" (lhs (concl th)) &&
          hd_is "LENGTH" (rhs (concl th))
      with Failure _ -> false) in
    let spe = grab asl (fun th ->
      try hd_is "<=" (concl th) &&
          lhand (concl th) = rand (concl lt)
      with Failure _ -> false) in
    let bnd = MATCH_MP (ARITH_RULE
                `!a b c d:num. a = b /\ b < c /\ c <= d
                               ==> a + 1 <= d`)
                (CONJ le (CONJ lt spe)) in
    MP_TAC (MATCH_MP (GEN_ALL new_ref_thm)
      (CONJ ai (CONJ nd bnd)))) THEN
  DISCH_THEN STRIP_ASSUME_TAC THEN
  (* the ends of the heap that the store holds *)
  FIRST_ASSUM (fun hs ->
    if hd_is "heap_in_memory_store" (concl hs)
    then STRIP_ASSUME_TAC
           (REWRITE_RULE[heap_in_memory_store_def] hs)
    else fail()) THEN
  (* the unused space of the heap, where the element goes *)
  FIRST_ASSUM (fun hu ->
    if not (try hd_is "heap_store_unused" (lhs (concl hu))
            with Failure _ -> false) then fail() else
    MP_TAC (REWRITE_RULE[heap_store_unused_def] hu)) THEN
  COND_CASES_TAC THEN REWRITE_TAC[PAIR_EQ] THEN
  DISCH_THEN STRIP_ASSUME_TAC THEN
  FIRST_X_ASSUM (fun cnd ->
    if not (is_conj (concl cnd)) then fail() else
    if not (try hd_is "heap_lookup" (lhs (lhand (concl cnd)))
            with Failure _ -> false) then fail() else
    STRIP_ASSUME_TAC cnd) THEN
  (* so the heap splits there *)
  FIRST_ASSUM (fun hl ->
    if not (try hd_is "heap_lookup" (lhs (concl hl))
            with Failure _ -> false) then fail() else
    STRIP_ASSUME_TAC (MATCH_MP heap_lookup_SPLIT hl)) THEN
  REPEAT (FIRST_X_ASSUM (fun e ->
    if not (try is_eq (concl e) && is_var (lhs (concl e)) &&
                (hd_is "APPEND" (rhs (concl e)) ||
                 hd_is "heap_length" (rhs (concl e)))
            with Failure _ -> false) then fail() else
    SUBST_ALL_TAC e)) THEN
  (* and the store writes the element at the end of the space *)
  FIRST_ASSUM (fun hs ->
    if not (try hd_is "heap_store" (lhs (concl hs))
            with Failure _ -> false) then fail() else
    MP_TAC (REWRITE_RULE[heap_store_lemma; PAIR_EQ] hs)) THEN
  DISCH_THEN STRIP_ASSUME_TAC THEN
  (* the words of the unused space, and its end where the element
     goes *)
  W(fun (asl,gl) ->
    let bnd = grab asl (fun th ->
      try hd_is "<=" (concl th) &&
          hd_is "el_length" (lhand (concl th))
      with Failure _ -> false) in
    let e1 = REWRITE_RULE[RefBlock_def; el_length_def] bnd in
    let eq1 = MATCH_MP (ARITH_RULE
                `!k s:num. k + 1 <= s ==> (s - 1) + 1 = s`) e1 in
    let eq3 = MATCH_MP (ARITH_RULE
                `!k s:num. k + 1 <= s
                           ==> (s - (k + 1)) + (k + 1) = s`) e1 in
    let sep = grab asl (fun th ->
      try hd_is "STAR" (rator (concl th))
      with Failure _ -> false) in
    let sep1 = REWRITE_RULE[word_heap_APPEND; word_heap_def;
                 word_el_def; el_length_def; eq1] sep in
    let addr = el 0 (snd(strip_comb (find (fun t ->
                 hd_is "word_list_exists" t)
                 (facs (rator (concl sep1)))))) in
    let wle = REWRITE_RULE[eq3]
                (ISPECL [lhand (lhs (concl eq3));
                         rand (lhs (concl eq3)); addr]
                   word_list_exists_ADD) in
    let sep2 = REWRITE_RULE[wle; STAR_ASSOC] sep1 in
    ASSUME_TAC sep2) THEN
  (* the words of the element are as many as its roots, and its
     address is the end of the heap less them *)
  W(fun (asl,gl) ->
    let sep = grab asl (fun th ->
      try hd_is "STAR" (rator (concl th)) &&
          length (filter (hd_is "word_list_exists")
                   (facs (rator (concl th)))) = 2
      with Failure _ -> false) in
    let bnd = grab asl (fun th ->
      try hd_is "<=" (concl th) &&
          hd_is "el_length" (lhand (concl th))
      with Failure _ -> false) in
    let e1 = REWRITE_RULE[RefBlock_def; el_length_def] bnd in
    let rsl = rand (lhand (lhand (concl e1))) in
    let l1 = grab asl (fun th ->
      try is_eq (concl th) && lhs (concl th) =
            mk_icomb (`LENGTH`,rsl)
      with Failure _ -> false) in
    let l2 = grab asl (fun th ->
      try is_eq (concl th) && lhs (concl th) = rhs (concl l1) &&
          hd_is "LENGTH" (rhs (concl th))
      with Failure _ -> false) in
    let rw = TRANS l1 l2 in
    let xs = el 1 (snd(strip_comb (find_term
               (hd_is "data_to_word_memoryProof_store_list") gl))) in
    let lenq = prove (mk_eq (mk_binop `(+):num->num->num`
                  (rhs (concl rw)) `1`, mk_icomb (`LENGTH`,xs)),
                REWRITE_TAC[LENGTH] THEN ARITH_TAC) in
    let sep4 = REWRITE_RULE[lenq] (REWRITE_RULE[rw] sep) in
    let bnd2 = REWRITE_RULE[lenq] (REWRITE_RULE[rw] e1) in
    ASSUME_TAC sep4 THEN ASSUME_TAC bnd2 THEN
    REWRITE_TAC[lenq]) THEN
  (* which the store writes there *)
  W(fun (asl,gl) ->
    let iscell t = hd_is "word_list_exists" t &&
                   hd_is "LENGTH" (el 1 (snd(strip_comb t))) in
    let sep = grab asl (fun th ->
      try hd_is "STAR" (rator (concl th)) &&
          exists iscell (facs (rator (concl th)))
      with Failure _ -> false) in
    let cell = find iscell (facs (rator (concl sep))) in
    STRIP_ASSUME_TAC (MATCH_MP store_list_thm (front sep cell))) THEN
  (* the ends of the heap, and the memory that the store wrote *)
  W(fun (asl,gl) ->
    let flk n = grab asl (fun th ->
      try hd_is "FLOOKUP" (lhs (concl th)) &&
          fst (dest_const (rand (lhs (concl th)))) = n
      with Failure _ -> false) in
    let sl = grab asl (fun th ->
      try hd_is "data_to_word_memoryProof_store_list"
            (lhs (concl th))
      with Failure _ -> false) in
    MAP_EVERY EXISTS_TAC
      [rand (rand (rhs (concl (flk "EndOfHeap"))));
       rand (rand (rhs (concl (flk "CurrHeap"))));
       rand (rand (rhs (concl (flk "TriggerGC"))));
       rand (rhs (concl sl))]) THEN
  (* the address of the element is the end of the heap less the
     words it takes *)
  W(fun (asl,gl) ->
    let sl = find_term
               (hd_is "data_to_word_memoryProof_store_list") gl in
    let t1 = el 0 (snd(strip_comb sl)) in
    let iscell t = hd_is "misc_word_list" t &&
                   hd_is "CONS" (el 1 (snd(strip_comb t))) in
    let sep = grab asl (fun th ->
      try hd_is "STAR" (rator (concl th)) &&
          exists iscell (facs (rator (concl th)))
      with Failure _ -> false) in
    let t2 = el 0 (snd(strip_comb
               (find iscell (facs (rator (concl sep)))))) in
    let bnd = grab asl (fun th ->
      try hd_is "<=" (concl th) &&
          hd_is "LENGTH" (lhand (concl th))
      with Failure _ -> false) in
    let eq = MP (prove (mk_imp (concl bnd, mk_eq (t1,t2)),
                  DISCH_TAC THEN ASM_SIMP_TAC[WORD_SUB] THEN
                  REWRITE_TAC[WORD_ADD] THEN
                  CONV_TAC WORD_RULE)) bnd in
    REWRITE_TAC[eq]) THEN
  REPEAT CONJ_TAC THEN TRY (FIRST_ASSUM ACCEPT_TAC) THEN
  (* the roots of the element and the roots of the stack *)
  REPEAT (FIRST_X_ASSUM (fun e ->
    if not (try is_eq (concl e) && is_var (lhs (concl e)) &&
                hd_is "APPEND" (rhs (concl e))
            with Failure _ -> false) then fail() else
    SUBST_ALL_TAC e)) THEN
  W(fun (asl,gl) ->
    let a2 = grab asl (fun th ->
      hd_is "ALL2" (concl th) &&
      hd_is "APPEND" (el 1 (snd(strip_comb (concl th))))) in
    let rsl = lhand (el 1 (snd(strip_comb (concl a2)))) in
    let l1 = grab asl (fun th ->
      try is_eq (concl th) && lhs (concl th) =
            mk_icomb (`LENGTH`,rsl)
      with Failure _ -> false) in
    let l2 = grab asl (fun th ->
      try is_eq (concl th) && lhs (concl th) = rhs (concl l1) &&
          hd_is "LENGTH" (rhs (concl th))
      with Failure _ -> false) in
    STRIP_ASSUME_TAC
      (REWRITE_RULE[MATCH_MP all2app (TRANS l1 l2)] a2)) THEN
  (* the invariant of the stack without the values *)
  W(fun (asl,gl) ->
    let ai = grab asl (fun th ->
      hd_is "abs_ml_inv" (concl th) &&
      (try hd_is "sptree_insert"
             (el 2 (snd(strip_comb (concl th))))
       with Failure _ -> false)) in
    let l1 = grab asl (fun th ->
      try is_eq (concl th) && hd_is "LENGTH" (lhs (concl th)) &&
          hd_is "LENGTH" (rhs (concl th)) &&
          rand (lhs (concl th)) =
            lhand (el 0 (tparts (el 3 (snd(strip_comb (concl ai))))))
      with Failure _ -> false) in
    ASSUME_TAC (MATCH_MP (GEN_ALL pop_thm)
      (CONJ ai (SYM l1)))) THEN
  (* the invariant with the new element in the heap *)
  REWRITE_TAC[memory_rel_def] THEN
  W(fun (asl,gl) ->
    let ai = grab asl (fun th ->
      hd_is "abs_ml_inv" (concl th) &&
      (try hd_is "CONS" (el 1 (snd(strip_comb (concl th))))
       with Failure _ -> false)) in
    let args = snd(strip_comb (concl ai)) in
    let ps = tparts (el 3 args) in
    MAP_EVERY EXISTS_TAC
      [el 1 ps; el 4 args; el 3 ps; el 4 ps; el 5 ps; el 6 ps]) THEN
  REPEAT CONJ_TAC THENL
   [ALL_TAC;
    (* the roots: the pointer of the new reference and the rest *)
    REWRITE_TAC[word_ml_inv_def] THEN
    W(fun (asl,gl) ->
      let ai = grab asl (fun th ->
        hd_is "abs_ml_inv" (concl th) &&
        (try hd_is "CONS" (el 1 (snd(strip_comb (concl th))))
         with Failure _ -> false)) in
      EXISTS_TAC
        (el 0 (tparts (el 3 (snd(strip_comb (concl ai))))))) THEN
    REWRITE_TAC[MAP; FST; SND; ALL2] THEN
    CONV_TAC (TOP_DEPTH_CONV BETA_CONV) THEN
    REPEAT CONJ_TAC THEN TRY (FIRST_ASSUM ACCEPT_TAC) THEN
    (* the word of the pointer is the one make_ptr builds *)
    W(fun (asl,gl) ->
      let mp = rhs gl in
      let sub = el 1 (snd(strip_comb mp)) in
      let aterm = lhand sub in
      let bwterm = rand aterm in
      let pt = lhand (rand (lhs gl)) in
      let mulp = mk_comb (rator bwterm,
                   mk_comb (rator (rand bwterm), pt)) in
      let bnd = grab asl (fun th ->
        try hd_is "<=" (concl th) &&
            hd_is "LENGTH" (lhand (concl th))
        with Failure _ -> false) in
      let rsl = rand (lhand (rand pt)) in
      let l1 = grab asl (fun th ->
        try is_eq (concl th) && lhs (concl th) =
              mk_icomb (`LENGTH`,rsl)
        with Failure _ -> false) in
      let rw = (try let l2 = grab asl (fun th ->
                      try is_eq (concl th) &&
                          lhs (concl th) = rhs (concl l1) &&
                          hd_is "LENGTH" (rhs (concl th))
                      with Failure _ -> false) in
                    TRANS l1 l2
                with Failure _ -> l1) in
      let ar = MP (prove (mk_imp (mk_conj (concl bnd, concl rw),
                                  mk_eq (sub,mulp)),
                    DISCH_THEN (CONJUNCTS_THEN
                      (fun th -> ASSUME_TAC
                         (REWRITE_RULE[LENGTH; ADD1] th))) THEN
                    ASM_REWRITE_TAC[LENGTH; ADD1] THEN
                    REWRITE_TAC[WORD_SUB; WORD_ADD] THEN
                    ASM_SIMP_TAC[ARITH_RULE
                      `!l s h:num. l <= s ==> l <= h + s`] THEN
                    CONV_TAC WORD_RULE)) (CONJ bnd rw) in
      SUBST1_TAC ar) THEN
    W(fun (asl,gl) ->
      let gd = grab asl (fun th ->
        hd_is "good_dimindex" (concl th)) in
      REWRITE_TAC(word_addr_clauses ()) THEN
      REWRITE_TAC[make_ptr_def; get_addr_def; get_lowerbits_def] THEN
      MATCH_REDUCE_TAC THEN
      REWRITE_TAC[MATCH_MP bytes_in_word_mul_eq_shift gd;
                  WORD_SHL_COMPOSE; bits0] THEN
      ASM_SIMP_TAC[ARITH_RULE
        `!a b:num. a <= b ==> a + (b - a) = b`] THEN
      REWRITE_TAC[WORD_OR_0; WORD_ADD_0]);
    FIRST_ASSUM ACCEPT_TAC;
    W(fun (asl,gl) ->
      let spe = grab asl (fun th ->
        try hd_is "<=" (concl th) && is_var (lhand (concl th)) &&
            is_var (rand (concl th))
        with Failure _ -> false) in
      let les = mapfilter (fun (_,th) ->
        if (try is_eq (concl th) &&
                hd_is "LENGTH" (lhs (concl th)) &&
                hd_is "LENGTH" (rhs (concl th))
            with Failure _ -> false) then th else fail()) asl in
      MP_TAC (end_itlist CONJ (spe :: les))) THEN
    REWRITE_TAC[LENGTH; ADD1] THEN ARITH_TAC] THEN
  (* the store of the new heap: its length is the old one *)
  REWRITE_TAC[heap_in_memory_store_def] THEN
  W(fun (asl,gl) ->
    let hu = grab asl (fun th ->
      try hd_is "heap_store_unused" (lhs (concl th))
      with Failure _ -> false) in
    REWRITE_TAC[MATCH_MP heap_store_unused_IMP_length hu]) THEN
  W(fun (asl,gl) ->
    let dis = CONJUNCTS (distinctness "store_name") in
    REWRITE_TAC([FLOOKUP_UPDATE; FDOM_FUPDATE; IN_INSERT] @
                dis @ map GSYM dis)) THEN
  REPEAT CONJ_TAC THEN TRY (FIRST_ASSUM ACCEPT_TAC) THEN
  (* the two heaps of the store *)
  W(fun (asl,gl) ->
    let flk n = grab asl (fun th ->
      try hd_is "FLOOKUP" (lhs (concl th)) &&
          fst (dest_const (rand (lhs (concl th)))) = n
      with Failure _ -> false) in
    MAP_EVERY EXISTS_TAC
      [rand (rand (rhs (concl (flk "CurrHeap"))));
       rand (rand (rhs (concl (flk "OtherHeap"))))]) THEN
  REPEAT CONJ_TAC THEN TRY (FIRST_ASSUM ACCEPT_TAC) THEN
  TRY (wordeq THEN NO_TAC) THEN
  (* the heap with the new element, which the store wrote *)
  FIRST_ASSUM (fun h2 ->
    if not (try is_eq (concl h2) && hd_is "APPEND" (lhs (concl h2)) &&
                is_var (rhs (concl h2))
            with Failure _ -> false) then fail() else
    SUBST1_TAC (SYM h2)) THEN
  REWRITE_TAC[word_heap_APPEND; word_heap_heap_expand;
              word_heap_def; heap_length_APPEND;
              heap_length_heap_expand; RefBlock_def] THEN
  REWRITE_TAC[word_el_def] THEN
  CONV_TAC (TOP_DEPTH_CONV let_CONV) THEN
  REWRITE_TAC[word_payload_def] THEN
  CONV_TAC (TOP_DEPTH_CONV let_CONV) THEN
  REWRITE_TAC[word_list_def; LENGTH_MAP; el_length_def;
              heap_length_NIL; STAR_ASSOC; emp_STAR; STAR_emp] THEN
  (* the words of the element are the roots of the values, and its
     header is the one that encode_header gave *)
  W(fun (asl,gl) ->
    let a2 = grab asl (fun th ->
      try hd_is "ALL2" (concl th) &&
          not (hd_is "MAP" (el 2 (snd(strip_comb (concl th)))))
      with Failure _ -> false) in
    let a2args = snd(strip_comb (concl a2)) in
    let fterm = rator (lhs (snd(strip_abs (el 0 a2args)))) in
    let mapeq = EQ_MP (ISPECL [el 1 a2args; el 2 a2args; fterm]
                  EVERY2_f_EQ) a2 in
    let eh = grab asl (fun th ->
      try hd_is "encode_header" (lhs (concl th))
      with Failure _ -> false) in
    let mh = CONV_RULE NUM_REDUCE_CONV (MATCH_MP someif
               (REWRITE_RULE[encode_header_def] eh)) in
    let les = mapfilter (fun (_,th) ->
      if (try is_eq (concl th) &&
              hd_is "LENGTH" (lhs (concl th)) &&
              hd_is "LENGTH" (rhs (concl th))
          with Failure _ -> false) then th else fail()) asl in
    REWRITE_TAC(mapeq :: mh :: les)) THEN
  (* the condition of the payload, which the header's length says *)
  W(fun (asl,gl) ->
    let pred = rator gl in
    let fs = facs pred in
    let cell = find (hd_is "cond") fs in
    let rest = filter (fun t -> not (t = cell)) fs in
    let st = fst(strip_comb pred) in
    let mk a b = mk_comb(mk_comb(st,a),b) in
    SUBGOAL_THEN (mk_eq (pred, mk cell (end_itlist mk rest)))
      SUBST1_TAC THENL
     [REWRITE_TAC[STAR_AC; emp_STAR; STAR_emp]; ALL_TAC]) THEN
  REWRITE_TAC[cond_STAR] THEN
  CONJ_TAC THENL
   [W(fun (asl,gl) ->
      let eh = grab asl (fun th ->
        try hd_is "encode_header" (lhs (concl th))
        with Failure _ -> false) in
      let ls7 = grab asl (fun th ->
        try hd_is "<" (concl th) &&
            hd_is "+" (lhand (concl th)) &&
            hd_is "data_to_word_config_len_size"
              (lhand (lhand (concl th)))
        with Failure _ -> false) in
      let ls = MATCH_MP (ARITH_RULE
                 `!a b:num. a + 7 < b ==> a + 5 < b`) ls7 in
      let gd = grab asl (fun th ->
        hd_is "good_dimindex" (concl th)) in
      STRIP_ASSUME_TAC (MATCH_MP encode_header_IMP
        (CONJ eh (CONJ ls gd)))) THEN
    ASM_REWRITE_TAC[];
    ALL_TAC] THEN
  (* and the words at the address the store wrote them to *)
  W(fun (asl,gl) ->
    let iscell t = hd_is "misc_word_list" t &&
                   hd_is "CONS" (el 1 (snd(strip_comb t))) in
    let sl = grab asl (fun th ->
      try hd_is "STAR" (rator (concl th)) &&
          exists iscell (facs (rator (concl th)))
      with Failure _ -> false) in
    let bnd = REWRITE_RULE[LENGTH; ADD1] (grab asl (fun th ->
      try hd_is "<=" (concl th) &&
          hd_is "LENGTH" (lhand (concl th))
      with Failure _ -> false)) in
    let arith = MATCH_MP (ARITH_RULE
                  `!l s:num. l <= s ==> (s - l) + l = s`) bnd in
    let sl2 = REWRITE_RULE[LENGTH; ADD1; word_list_def;
                word_heap_heap_expand; STAR_ASSOC; emp_STAR;
                STAR_emp; addsum] sl in
    REWRITE_TAC[heap_length_CONS; heap_length_NIL; el_length_def;
                ARITH_RULE `!n:num. n + 0 = n`; addsum;
                arith] THEN
    W(fun (asl2,gl2) ->
      let eq = prove (mk_eq (rator gl2, rator (concl sl2)),
                REWRITE_TAC[STAR_AC; emp_STAR; STAR_emp]) in
      ACCEPT_TAC (REWRITE_RULE[GSYM eq] sl2)))))
### memory_rel_AllocThunk
(* the allocation of a thunk, which is the proof of memory_rel_Ref
   with an element of two words in place of one of the length of an
   array: new_thunk_thm gives the store of the element and the
   invariant with the pointer pushed, pop_thm takes the value off
   the stack again (the roots of the two are a cons, so the append
   of the one value is what pop_thm wants), and the words of the
   unused space split into what stays unused and the two words that
   store_list_thm writes -- the header and the root of the value.
   The mode of the thunk is what its header says, so the proof
   splits on it: thunk_tag_bits_lemma and its counterpart for a
   thunk that is not evaluated say that the bits of the mode with
   the six are the word that encode_header encoded, and the length
   of the payload is one, which is the condition of the payload
   that encode_header_IMP reads off the header *)
  ((let hd_is n t =
     (try fst(dest_const(fst(strip_comb t))) = n
      with Failure _ -> false) in
  let rec facs t =
    if hd_is "STAR" t then
      let args = snd(strip_comb t) in
      facs (el 0 args) @ facs (el 1 args)
    else [t] in
  let grab asl p =
    tryfind (fun (_,th) ->
      if (try p th with Failure _ -> false) then th else fail())
      asl in
  let front sp cell =
    let pred = rator (concl sp) in
    let fs = facs pred in
    let rest = filter (fun t -> not (t = cell)) fs in
    let st = fst(strip_comb pred) in
    let mk x y = mk_comb(mk_comb(st,x),y) in
    let target = mk cell (end_itlist mk rest) in
    let eq = prove (mk_eq (pred,target),
              REWRITE_TAC[STAR_AC; emp_STAR; STAR_emp]) in
    REWRITE_RULE[eq] sp in
  (* the bits of a zero word are zero *)
  let bits0 = prove
   (`!h l. word_bits h l ((n2w 0):(N)word) = n2w 0`,
    REWRITE_TAC[word_bits; WORD_EQ_BITS_ALT; BIT_WORD_SUBWORD;
                BIT_WORD_0] THEN
    CONV_TAC TAUT) in
  (* the bits of the header of a thunk that is not evaluated *)
  let notevbits = prove
   (`(thunk_tag_to_bits NotEvaluated << 3 || (n2w 6)) =
     ((n2w 6):'a word)`,
    REWRITE_TAC[thunk_tag_to_bits_def] THEN
    MATCH_REDUCE_TAC THEN
    WORD_NUM_BIT_TAC 4) in
  (* a cons as the append of its head *)
  let conapp = prove
   (`!(x:A) l. CONS x l = APPEND [x] l`,
    REWRITE_TAC[APPEND]) in
  (* an equation of two addresses, from the numeric facts *)
  let numfacts asl =
    mapfilter (fun (_,th) ->
      let c = concl th in
      if (try hd_is "<=" c || hd_is "<" c ||
              (is_eq c && hd_is "LENGTH" (lhs c) &&
               hd_is "LENGTH" (rhs c))
          with Failure _ -> false) then th else fail()) asl in
  (* two steps of an address in one *)
  let addsum = prove
   (`!(a:'a word) x y.
       a + bytes_in_word * n2w x + bytes_in_word * n2w y =
       a + bytes_in_word * n2w (x + y)`,
    REWRITE_TAC[WORD_ADD] THEN CONV_TAC WORD_RULE) in
  let someif = prove
   (`!p (x:A) y. (if p then SOME x else NONE) = SOME y ==> x = y`,
    REPEAT GEN_TAC THEN COND_CASES_TAC THEN
    REWRITE_TAC[distinctness "option"; injectivity "option"]) in
  let addreq asl t1 t2 =
      let fs = numfacts asl in
      let extra = (try
        let lt = grab asl (fun th ->
          try hd_is "<" (concl th) &&
              hd_is "LENGTH" (lhand (concl th))
          with Failure _ -> false) in
        let spe = grab asl (fun th ->
          try hd_is "<=" (concl th) && is_var (lhand (concl th)) &&
              is_var (rand (concl th))
          with Failure _ -> false) in
        [MATCH_MP (ARITH_RULE
           `!a b c:num. a < b /\ b <= c ==> a + 1 <= c`)
           (CONJ lt spe)]
        with Failure _ -> []) in
      let extra2 = (try
        let a = grab asl (fun th ->
          try hd_is "<=" (concl th) && is_var (rand (concl th)) &&
              not (is_var (lhand (concl th)))
          with Failure _ -> false) in
        let b = grab asl (fun th ->
          try hd_is "<=" (concl th) &&
              lhand (concl th) = rand (concl a)
          with Failure _ -> false) in
        [MATCH_MP (ARITH_RULE
           `!a b c:num. a <= b /\ b <= c ==> a <= c`)
           (CONJ a b)]
        with Failure _ -> []) in
      let cnd = end_itlist CONJ (fs @ extra @ extra2) in
      MP (prove (mk_imp (concl cnd, mk_eq (t1,t2)),
            DISCH_THEN (REPEAT_TCL CONJUNCTS_THEN
              (fun th -> ASSUME_TAC
                 (REWRITE_RULE[LENGTH; ADD1] th))) THEN
            ASM_REWRITE_TAC[LENGTH; ADD1] THEN
            TRY (CONV_TAC NUM_REDUCE_CONV) THEN
            REWRITE_TAC[WORD_SUB; WORD_ADD] THEN
            ASM_SIMP_TAC[ARITH_RULE
              `!l s h:num. l <= s ==> l <= h + s`;
              ARITH_RULE
              `!a b c:num. a <= b /\ b <= c ==> a <= c`] THEN
            CONV_TAC WORD_RULE)) cnd in
  let wordeq =
    W(fun (asl,gl) ->
      REWRITE_TAC[addreq asl (rand (rand (lhs gl)))
                    (rand (rand (rhs gl)))]) in
  CONV_TAC (TOP_DEPTH_CONV let_CONV) THEN
  DISCH_THEN (REPEAT_TCL CONJUNCTS_THEN ASSUME_TAC) THEN
  (* what the invariant says of the stack *)
  FIRST_ASSUM (fun mr ->
    if hd_is "memory_rel" (concl mr)
    then MP_TAC (REWRITE_RULE[memory_rel_def; word_ml_inv_def;
                              MAP; FST; SND] mr)
    else fail()) THEN
  DISCH_THEN STRIP_ASSUME_TAC THEN
  (* the store of the new thunk *)
  W(fun (asl,gl) ->
    let ai = grab asl (fun th -> hd_is "abs_ml_inv" (concl th)) in
    let nd = grab asl (fun th ->
      try hd_is "IN" (dest_neg (concl th))
      with Failure _ -> false) in
    let two = grab asl (fun th ->
      try hd_is "<=" (concl th) &&
          hd_is "NUMERAL" (lhand (concl th)) &&
          is_var (rand (concl th))
      with Failure _ -> false) in
    let spe = grab asl (fun th ->
      try hd_is "<=" (concl th) &&
          lhand (concl th) = rand (concl two)
      with Failure _ -> false) in
    let bnd = MATCH_MP (ARITH_RULE
                `!b c d:num. b <= c /\ c <= d ==> b <= d`)
                (CONJ two spe) in
    let dt = grab asl (fun th ->
      try is_imp (concl th) && is_eq (lhand (concl th))
      with Failure _ -> false) in
    MP_TAC (MATCH_MP (GEN_ALL new_thunk_thm)
      (CONJ ai (CONJ nd (CONJ bnd dt))))) THEN
  DISCH_THEN STRIP_ASSUME_TAC THEN
  (* the ends of the heap that the store holds *)
  FIRST_ASSUM (fun hs ->
    if hd_is "heap_in_memory_store" (concl hs)
    then STRIP_ASSUME_TAC
           (REWRITE_RULE[heap_in_memory_store_def] hs)
    else fail()) THEN
  (* the unused space of the heap, where the element goes *)
  FIRST_ASSUM (fun hu ->
    if not (try hd_is "heap_store_unused" (lhs (concl hu))
            with Failure _ -> false) then fail() else
    MP_TAC (REWRITE_RULE[heap_store_unused_def] hu)) THEN
  COND_CASES_TAC THEN REWRITE_TAC[PAIR_EQ] THEN
  DISCH_THEN STRIP_ASSUME_TAC THEN
  FIRST_X_ASSUM (fun cnd ->
    if not (is_conj (concl cnd)) then fail() else
    if not (try hd_is "heap_lookup" (lhs (lhand (concl cnd)))
            with Failure _ -> false) then fail() else
    STRIP_ASSUME_TAC cnd) THEN
  (* so the heap splits there *)
  FIRST_ASSUM (fun hl ->
    if not (try hd_is "heap_lookup" (lhs (concl hl))
            with Failure _ -> false) then fail() else
    STRIP_ASSUME_TAC (MATCH_MP heap_lookup_SPLIT hl)) THEN
  REPEAT (FIRST_X_ASSUM (fun e ->
    if not (try is_eq (concl e) && is_var (lhs (concl e)) &&
                (hd_is "APPEND" (rhs (concl e)) ||
                 hd_is "heap_length" (rhs (concl e)))
            with Failure _ -> false) then fail() else
    SUBST_ALL_TAC e)) THEN
  (* and the store writes the element at the end of the space *)
  FIRST_ASSUM (fun hs ->
    if not (try hd_is "heap_store" (lhs (concl hs))
            with Failure _ -> false) then fail() else
    MP_TAC (REWRITE_RULE[heap_store_lemma; PAIR_EQ] hs)) THEN
  DISCH_THEN STRIP_ASSUME_TAC THEN
  (* the words of the unused space, and its end where the element
     goes *)
  W(fun (asl,gl) ->
    let bnd = grab asl (fun th ->
      try hd_is "<=" (concl th) &&
          hd_is "el_length" (lhand (concl th))
      with Failure _ -> false) in
    let e1 = REWRITE_RULE[ThunkBlock_def; el_length_def] bnd in
    let eq1 = MATCH_MP (ARITH_RULE
                `!k s:num. k + 1 <= s ==> (s - 1) + 1 = s`) e1 in
    let eq3 = MATCH_MP (ARITH_RULE
                `!k s:num. k + 1 <= s
                           ==> (s - (k + 1)) + (k + 1) = s`) e1 in
    let sep = grab asl (fun th ->
      try hd_is "STAR" (rator (concl th))
      with Failure _ -> false) in
    let sep1 = REWRITE_RULE[word_heap_APPEND; word_heap_def;
                 word_el_def; el_length_def; eq1] sep in
    let addr = el 0 (snd(strip_comb (find (fun t ->
                 hd_is "word_list_exists" t)
                 (facs (rator (concl sep1)))))) in
    let wle = REWRITE_RULE[eq3]
                (ISPECL [lhand (lhs (concl eq3));
                         rand (lhs (concl eq3)); addr]
                   word_list_exists_ADD) in
    let sep2 = REWRITE_RULE[wle; STAR_ASSOC] sep1 in
    ASSUME_TAC sep2) THEN
  (* the words of the element are as many as its roots, and its
     address is the end of the heap less them *)
  W(fun (asl,gl) ->
    let sep = grab asl (fun th ->
      try hd_is "STAR" (rator (concl th)) &&
          length (filter (hd_is "word_list_exists")
                   (facs (rator (concl th)))) = 2
      with Failure _ -> false) in
    let bnd = grab asl (fun th ->
      try hd_is "<=" (concl th) &&
          hd_is "el_length" (lhand (concl th))
      with Failure _ -> false) in
    let e1 = REWRITE_RULE[ThunkBlock_def; el_length_def] bnd in
    let cells = filter (hd_is "word_list_exists")
                  (facs (rator (concl sep))) in
    let count = el 1 (snd(strip_comb (el 1 cells))) in
    let xs = el 1 (snd(strip_comb (find_term
               (hd_is "data_to_word_memoryProof_store_list") gl))) in
    let lenq = prove (mk_eq (count, mk_icomb (`LENGTH`,xs)),
                REWRITE_TAC[LENGTH] THEN ARITH_TAC) in
    let sep4 = REWRITE_RULE[lenq] sep in
    let bnd2 = REWRITE_RULE[lenq] e1 in
    ASSUME_TAC sep4 THEN ASSUME_TAC bnd2 THEN
    REWRITE_TAC[lenq]) THEN
  (* which the store writes there *)
  W(fun (asl,gl) ->
    let iscell t = hd_is "word_list_exists" t &&
                   hd_is "LENGTH" (el 1 (snd(strip_comb t))) in
    let sep = grab asl (fun th ->
      try hd_is "STAR" (rator (concl th)) &&
          exists iscell (facs (rator (concl th)))
      with Failure _ -> false) in
    let cell = find iscell (facs (rator (concl sep))) in
    STRIP_ASSUME_TAC (MATCH_MP store_list_thm (front sep cell))) THEN
  (* the two words of the element, counted *)
  RULE_ASSUM_TRY (REWRITE_RULE[LENGTH]) THEN
  RULE_ASSUM_TRY (CONV_RULE NUM_REDUCE_CONV) THEN
  REWRITE_TAC[LENGTH] THEN TRY (CONV_TAC NUM_REDUCE_CONV) THEN
  (* the ends of the heap, and the memory that the store wrote *)
  W(fun (asl,gl) ->
    let flk n = grab asl (fun th ->
      try hd_is "FLOOKUP" (lhs (concl th)) &&
          fst (dest_const (rand (lhs (concl th)))) = n
      with Failure _ -> false) in
    let sl = grab asl (fun th ->
      try hd_is "data_to_word_memoryProof_store_list"
            (lhs (concl th))
      with Failure _ -> false) in
    MAP_EVERY EXISTS_TAC
      [rand (rand (rhs (concl (flk "EndOfHeap"))));
       rand (rand (rhs (concl (flk "CurrHeap"))));
       rand (rand (rhs (concl (flk "TriggerGC"))));
       rand (rhs (concl sl))]) THEN
  (* the address of the element is the end of the heap less the
     words it takes *)
  W(fun (asl,gl) ->
    let sl = find_term
               (hd_is "data_to_word_memoryProof_store_list") gl in
    let t1 = el 0 (snd(strip_comb sl)) in
    let iscell t = hd_is "misc_word_list" t &&
                   hd_is "CONS" (el 1 (snd(strip_comb t))) in
    let sep = grab asl (fun th ->
      try hd_is "STAR" (rator (concl th)) &&
          exists iscell (facs (rator (concl th)))
      with Failure _ -> false) in
    let t2 = el 0 (snd(strip_comb
               (find iscell (facs (rator (concl sep)))))) in
    REWRITE_TAC[addreq asl t1 t2]) THEN
  REPEAT CONJ_TAC THEN TRY (FIRST_ASSUM ACCEPT_TAC) THEN
  (* the root of the value and the roots of the stack *)
  REPEAT (FIRST_X_ASSUM (fun e ->
    if not (try is_eq (concl e) && is_var (lhs (concl e)) &&
                hd_is "CONS" (rhs (concl e))
            with Failure _ -> false) then fail() else
    SUBST_ALL_TAC e)) THEN
  W(fun (asl,gl) ->
    let a2 = grab asl (fun th ->
      try hd_is "ALL2" (concl th) &&
          hd_is "CONS" (el 1 (snd(strip_comb (concl th))))
      with Failure _ -> false) in
    STRIP_ASSUME_TAC (REWRITE_RULE[ALL2] a2)) THEN
  (* the invariant of the stack without the value *)
  W(fun (asl,gl) ->
    let ai = grab asl (fun th ->
      hd_is "abs_ml_inv" (concl th) &&
      (try hd_is "sptree_insert"
             (el 2 (snd(strip_comb (concl th))))
       with Failure _ -> false)) in
    let ai2 = CONV_RULE (ONCE_DEPTH_CONV
                (REWR_CONV conapp)) ai in
    let lenq = prove (mk_eq (mk_icomb (`LENGTH`,
                  lhand (el 1 (snd(strip_comb (concl ai2))))),
                mk_icomb (`LENGTH`,
                  lhand (el 0 (tparts (el 3 (snd(strip_comb
                    (concl ai2)))))))),
                REWRITE_TAC[LENGTH]) in
    ASSUME_TAC (MATCH_MP (GEN_ALL pop_thm) (CONJ ai2 lenq))) THEN
  (* the invariant with the new element in the heap *)
  REWRITE_TAC[memory_rel_def] THEN
  W(fun (asl,gl) ->
    let ai = grab asl (fun th ->
      hd_is "abs_ml_inv" (concl th) &&
      (try hd_is "CONS" (el 1 (snd(strip_comb (concl th))))
       with Failure _ -> false)) in
    let args = snd(strip_comb (concl ai)) in
    let ps = tparts (el 3 args) in
    MAP_EVERY EXISTS_TAC
      [el 1 ps; el 4 args; el 3 ps; el 4 ps; el 5 ps; el 6 ps]) THEN
  REPEAT CONJ_TAC THENL
   [ALL_TAC;
    (* the roots: the pointer of the new reference and the rest *)
    REWRITE_TAC[word_ml_inv_def] THEN
    W(fun (asl,gl) ->
      let ai = grab asl (fun th ->
        hd_is "abs_ml_inv" (concl th) &&
        (try hd_is "CONS" (el 1 (snd(strip_comb (concl th))))
         with Failure _ -> false)) in
      EXISTS_TAC
        (el 0 (tparts (el 3 (snd(strip_comb (concl ai))))))) THEN
    REWRITE_TAC[MAP; FST; SND; ALL2] THEN
    CONV_TAC (TOP_DEPTH_CONV BETA_CONV) THEN
    REPEAT CONJ_TAC THEN TRY (FIRST_ASSUM ACCEPT_TAC) THEN
    (* the word of the pointer is the one make_ptr builds *)
    W(fun (asl,gl) ->
      let mp = rhs gl in
      let sub = el 1 (snd(strip_comb mp)) in
      let aterm = lhand sub in
      let bwterm = rand aterm in
      let pt = lhand (rand (lhs gl)) in
      let mulp = mk_comb (rator bwterm,
                   mk_comb (rator (rand bwterm), pt)) in
      SUBST1_TAC (addreq asl sub mulp)) THEN
    W(fun (asl,gl) ->
      let gd = grab asl (fun th ->
        hd_is "good_dimindex" (concl th)) in
      REWRITE_TAC(word_addr_clauses ()) THEN
      REWRITE_TAC[make_ptr_def; get_addr_def; get_lowerbits_def] THEN
      MATCH_REDUCE_TAC THEN
      REWRITE_TAC[MATCH_MP bytes_in_word_mul_eq_shift gd;
                  WORD_SHL_COMPOSE; bits0] THEN
      ASM_SIMP_TAC[ARITH_RULE
        `!a b:num. a <= b ==> a + (b - a) = b`] THEN
      REWRITE_TAC[WORD_OR_0; WORD_ADD_0]);
    FIRST_ASSUM ACCEPT_TAC;
    W(fun (asl,gl) ->
      let spe = grab asl (fun th ->
        try hd_is "<=" (concl th) && is_var (lhand (concl th)) &&
            is_var (rand (concl th))
        with Failure _ -> false) in
      let les = mapfilter (fun (_,th) ->
        if (try is_eq (concl th) &&
                hd_is "LENGTH" (lhs (concl th)) &&
                hd_is "LENGTH" (rhs (concl th))
            with Failure _ -> false) then th else fail()) asl in
      MP_TAC (end_itlist CONJ (spe :: les))) THEN
    REWRITE_TAC[LENGTH; ADD1] THEN ARITH_TAC] THEN
  (* the store of the new heap: its length is the old one *)
  REWRITE_TAC[heap_in_memory_store_def] THEN
  W(fun (asl,gl) ->
    let hu = grab asl (fun th ->
      try hd_is "heap_store_unused" (lhs (concl th))
      with Failure _ -> false) in
    REWRITE_TAC[MATCH_MP heap_store_unused_IMP_length hu]) THEN
  W(fun (asl,gl) ->
    let dis = CONJUNCTS (distinctness "store_name") in
    REWRITE_TAC([FLOOKUP_UPDATE; FDOM_FUPDATE; IN_INSERT] @
                dis @ map GSYM dis)) THEN
  REPEAT CONJ_TAC THEN TRY (FIRST_ASSUM ACCEPT_TAC) THEN
  (* the two heaps of the store *)
  W(fun (asl,gl) ->
    let flk n = grab asl (fun th ->
      try hd_is "FLOOKUP" (lhs (concl th)) &&
          fst (dest_const (rand (lhs (concl th)))) = n
      with Failure _ -> false) in
    MAP_EVERY EXISTS_TAC
      [rand (rand (rhs (concl (flk "CurrHeap"))));
       rand (rand (rhs (concl (flk "OtherHeap"))))]) THEN
  REPEAT CONJ_TAC THEN TRY (FIRST_ASSUM ACCEPT_TAC) THEN
  TRY (wordeq THEN NO_TAC) THEN
  (* the two modes of the thunk, which the header tells apart *)
  CASES_ON_NAME "ev" THEN
  RULE_ASSUM_TRY (CONV_RULE (TOP_DEPTH_CONV MATCH_CONV)) THEN
  RULE_ASSUM_TRY (CONV_RULE NUM_REDUCE_CONV) THEN
  (* the heap with the new element, which the store wrote *)
  FIRST_ASSUM (fun h2 ->
    if not (try is_eq (concl h2) && hd_is "APPEND" (lhs (concl h2)) &&
                is_var (rhs (concl h2))
            with Failure _ -> false) then fail() else
    SUBST1_TAC (SYM h2)) THEN
  REWRITE_TAC[word_heap_APPEND; word_heap_heap_expand;
              word_heap_def; heap_length_APPEND;
              heap_length_heap_expand; ThunkBlock_def] THEN
  REWRITE_TAC[word_el_def] THEN
  CONV_TAC (TOP_DEPTH_CONV let_CONV) THEN
  REWRITE_TAC[word_payload_def] THEN
  CONV_TAC (TOP_DEPTH_CONV let_CONV) THEN
  REWRITE_TAC[word_list_def; LENGTH_MAP; el_length_def;
              heap_length_NIL; thunk_tag_bits_lemma; notevbits;
              MAP; LENGTH; STAR_ASSOC; emp_STAR; STAR_emp] THEN
  TRY (CONV_TAC NUM_REDUCE_CONV) THEN
  (* the word of the value and the header that encode_header gave *)
  W(fun (asl,gl) ->
    let wr = grab asl (fun th ->
      try is_eq (concl th) && hd_is "word_addr" (lhs (concl th))
      with Failure _ -> false) in
    let eh = grab asl (fun th ->
      try hd_is "encode_header" (lhs (concl th))
      with Failure _ -> false) in
    let mh = CONV_RULE NUM_REDUCE_CONV (MATCH_MP someif
               (REWRITE_RULE[encode_header_def] eh)) in
    REWRITE_TAC[wr; mh]) THEN
  (* the condition of the payload, which the header's length says *)
  TRY (W(fun (asl,gl) ->
    let pred = rator gl in
    let fs = facs pred in
    let cell = find (hd_is "cond") fs in
    let rest = filter (fun t -> not (t = cell)) fs in
    let st = fst(strip_comb pred) in
    let mk a b = mk_comb(mk_comb(st,a),b) in
    SUBGOAL_THEN (mk_eq (pred, mk cell (end_itlist mk rest)))
      SUBST1_TAC THENL
     [REWRITE_TAC[STAR_AC; emp_STAR; STAR_emp]; ALL_TAC]) THEN
   REWRITE_TAC[cond_STAR] THEN
   CONJ_TAC THENL
    [W(fun (asl,gl) ->
       let eh = grab asl (fun th ->
         try hd_is "encode_header" (lhs (concl th))
         with Failure _ -> false) in
       let ls7 = grab asl (fun th ->
         try hd_is "<" (concl th) &&
             hd_is "+" (lhand (concl th)) &&
             hd_is "data_to_word_config_len_size"
               (lhand (lhand (concl th)))
         with Failure _ -> false) in
       let ls = MATCH_MP (ARITH_RULE
                  `!a b:num. a + 7 < b ==> a + 5 < b`) ls7 in
       let gd = grab asl (fun th ->
         hd_is "good_dimindex" (concl th)) in
       STRIP_ASSUME_TAC (MATCH_MP encode_header_IMP
         (CONJ eh (CONJ ls gd)))) THEN
     ASM_REWRITE_TAC[];
     ALL_TAC]) THEN
  (* and the words at the address the store wrote them to *)
  W(fun (asl,gl) ->
    let iscell t = hd_is "misc_word_list" t &&
                   hd_is "CONS" (el 1 (snd(strip_comb t))) in
    let sl = grab asl (fun th ->
      try hd_is "STAR" (rator (concl th)) &&
          exists iscell (facs (rator (concl th)))
      with Failure _ -> false) in
    let bnd = CONV_RULE NUM_REDUCE_CONV
                (REWRITE_RULE[LENGTH; ADD1] (grab asl (fun th ->
                   try hd_is "<=" (concl th) &&
                       (hd_is "LENGTH" (lhand (concl th)) ||
                        (hd_is "NUMERAL" (lhand (concl th)) &&
                         hd_is "+" (rand (concl th))))
                   with Failure _ -> false))) in
    let arith = MATCH_MP (ARITH_RULE
                  `!l s:num. l <= s ==> (s - l) + l = s`) bnd in
    let sl2 = REWRITE_RULE[LENGTH; ADD1; word_list_def;
                word_heap_heap_expand; STAR_ASSOC; emp_STAR;
                STAR_emp; addsum] sl in
    REWRITE_TAC[heap_length_CONS; heap_length_NIL; el_length_def;
                ARITH_RULE `!n:num. n + 0 = n`] THEN
    TRY (CONV_TAC NUM_REDUCE_CONV) THEN
    REWRITE_TAC[addsum; arith] THEN
    W(fun (asl2,gl2) ->
      let eq = prove (mk_eq (rator gl2, rator (concl sl2)),
                REWRITE_TAC[STAR_AC; emp_STAR; STAR_emp]) in
      ACCEPT_TAC (REWRITE_RULE[GSYM eq] sl2)))))
### memory_rel_write
(* the proof of the source names memory_rel_def,
   heap_in_memory_store_def, word_ml_inv_def, abs_ml_inv_def,
   unused_space_inv_def and heap_lookup_SPLIT, and writes the cell
   with HOL4's SEP_W_TAC.  Here the next free address is the one
   the store says and the space from it is the Unused element that
   unused_space_inv puts at the end of the data of the heap; a
   write below the space keeps the invariant, because nothing of it
   but the memory of heap_in_memory_store has the memory in it, and
   what that says of the written memory is the lemma below, which
   is read_fun2set and write_fun2set over a whole space *)
  ((* the factors of a separation predicate, and the predicate with
     the factor of a kind brought to the front *)
  let rec facs t =
    if hd_is "STAR" t then
      let args = snd (strip_comb t) in
      facs (el 0 args) @ facs (el 1 args)
    else [t] in
  let sfront nm sep =
    let pred = rator (concl sep) in
    let fs = facs pred in
    let cell = find (hd_is nm) fs in
    let rest = filter (fun t -> not (t = cell)) fs in
    let st = fst (strip_comb pred) in
    let mk x y = mk_comb (mk_comb (st,x),y) in
    let target = mk cell (end_itlist mk rest) in
    let eq = prove (mk_eq (pred,target), REWRITE_TAC[STAR_AC]) in
    REWRITE_RULE[eq] sep in
  let cfront = prove
   (`!(q:(A->bool)->bool) r c. (q * cond c) * r = cond c * (q * r)`,
    REWRITE_TAC[STAR_AC]) in
  let mswap = WORD_RULE
    `!(a:'a word) n.
       a + n2w n * bytes_in_word = a + bytes_in_word * n2w n` in
  let is_heapeq th =
    try is_eq (concl th) && is_var (lhs (concl th)) &&
        hd_is "APPEND" (rand (concl th))
    with Failure _ -> false in
  let is_aeq th =
    try is_eq (concl th) && is_var (lhs (concl th)) &&
        hd_is "heap_length" (rand (concl th))
    with Failure _ -> false in
  let is_sep th =
    try hd_is "STAR" (rator (concl th)) with Failure _ -> false in
  let sepof wv th =
    let th1 = (try SPEC wv th with Failure _ -> th) in
    let th2 = (try CONJUNCT2 th1 with Failure _ -> th1) in
    if is_sep th2 then th2 else failwith "sepof" in
  (* the port's own: a cell of an unused space of the heap is in
     the memory and can be written, and what the space says of the
     memory it says of the written one -- the list of the words of
     the space is the old list with one word replaced, which is as
     long as it was.  This is what HOL4's SEP_R_TAC and SEP_W_TAC
     do to the assumption, here as a lemma over the space *)
  let word_list_exists_write = prove
   (`!(a:'a word) k n p m dm w.
       (word_list_exists a k * p) (fun2set (m,dm)) /\ n < k ==>
       (a + bytes_in_word * n2w n) IN dm /\
       (word_list_exists a k * p)
         (fun2set (((a + bytes_in_word * n2w n) =+ w) m,dm))`,
    REPEAT GEN_TAC THEN
    REWRITE_TAC[word_list_exists_def; SEP_EXISTS_STAR;
                SEP_EXISTS_THM] THEN
    DISCH_THEN (CONJUNCTS_THEN2 MP_TAC ASSUME_TAC) THEN
    REWRITE_TAC[cfront; cond_STAR] THEN
    DISCH_THEN STRIP_ASSUME_TAC THEN
    FIRST_ASSUM (fun le ->
      if (try is_eq (concl le) && hd_is "LENGTH" (lhs (concl le))
          with Failure _ -> false)
      then FIRST_ASSUM (fun lt ->
             if (try hd_is "<" (concl lt) with Failure _ -> false)
             then STRIP_ASSUME_TAC (MATCH_MP LESS_LENGTH
                    (ONCE_REWRITE_RULE[GSYM le] lt))
             else fail())
      else fail()) THEN
    FIRST_X_ASSUM (fun eq ->
      if is_heapeq eq then SUBST_ALL_TAC eq else fail()) THEN
    FIRST_X_ASSUM (fun lne ->
      if (try is_eq (concl lne) &&
              hd_is "LENGTH" (lhs (concl lne)) &&
              is_var (rand (concl lne))
          with Failure _ -> false)
      then SUBST_ALL_TAC (SYM lne) else fail()) THEN
    RULE_ASSUM_TRY (REWRITE_RULE[word_list_APPEND; word_list_def;
                                 STAR_ASSOC; mswap]) THEN
    FIRST_ASSUM (fun sep ->
      if not (is_sep sep) then fail() else
      let sep' = sfront "set_sep_one" sep in
      STRIP_ASSUME_TAC (MATCH_MP read_fun2set sep') THEN
      STRIP_ASSUME_TAC (MATCH_MP write_fun2set sep')) THEN
    CONJ_TAC THEN TRY (FIRST_ASSUM ACCEPT_TAC) THEN
    W(fun (asl,gl) ->
      let bod = snd (dest_exists gl) in
      let pr = rand (rand (rand bod)) in
      let wv = rand (rator (fst (dest_pair pr))) in
      let sep = find (fun th ->
        (try is_sep th &&
             exists (hd_is "set_sep_one") (facs (rator (concl th)))
         with Failure _ -> false)) (map snd asl) in
      let fs = facs (rator (concl sep)) in
      let wls = filter (hd_is "misc_word_list") fs in
      EXISTS_TAC (list_mk_icomb "APPEND"
        [rand (el 0 wls);
         list_mk_icomb "CONS" [wv; rand (el 1 wls)]])) THEN
    CONJ_TAC THENL
     [RULE_ASSUM_TRY (REWRITE_RULE[LENGTH_APPEND; LENGTH]) THEN
      REWRITE_TAC[LENGTH_APPEND; LENGTH] THEN ASM_ARITH_TAC;
      REWRITE_TAC[word_list_APPEND; word_list_def; STAR_ASSOC;
                  mswap] THEN
      W(fun (asl,gl) ->
        let pred = rator gl in
        let wv = rand (rator (fst (dest_pair (rand (rand gl))))) in
        FIRST_ASSUM (fun wth ->
          let th = sepof wv wth in
          let eq = prove (mk_eq (pred,rator (concl th)),
                          REWRITE_TAC[STAR_AC]) in
          ACCEPT_TAC (REWRITE_RULE[GSYM eq] th)))]) in
  (* the next free address is the one the store says, and the space
     from it is the Unused element that unused_space_inv puts at the
     end of the data of the heap (heap_lookup_SPLIT splits the heap
     at it).  A write below the space keeps the invariant: nothing
     of it but the memory of heap_in_memory_store has the memory in
     it, and that is the lemma above *)
  STRIP_TAC THEN
  FIRST_ASSUM (fun mr ->
    if hd_is "memory_rel" (concl mr)
    then STRIP_ASSUME_TAC (REWRITE_RULE[memory_rel_def] mr)
    else fail()) THEN
  FIRST_ASSUM (fun h ->
    if hd_is "heap_in_memory_store" (concl h)
    then STRIP_ASSUME_TAC
           (REWRITE_RULE[heap_in_memory_store_def] h)
    else fail()) THEN
  ASM_EXISTS_TAC THEN CONJ_TAC THEN
  TRY (FIRST_ASSUM ACCEPT_TAC) THEN
  X_GEN_TAC `n:num` THEN DISCH_TAC THEN
  CONV_TAC (TOP_DEPTH_CONV let_CONV) THEN
  FIRST_ASSUM (fun wi ->
    if hd_is "word_ml_inv" (concl wi)
    then STRIP_ASSUME_TAC (REWRITE_RULE[word_ml_inv_def;
           abs_ml_inv_def; unused_space_inv_def] wi)
    else fail()) THEN
  FIRST_ASSUM (fun imp ->
    let c = concl imp in
    if is_imp c &&
       (try hd_is "heap_lookup" (lhs (rand c))
        with Failure _ -> false)
    then SUBGOAL_THEN (lhand c)
           (fun th -> STRIP_ASSUME_TAC (MP imp th)) THENL
          [ASM_ARITH_TAC; ALL_TAC]
    else fail()) THEN
  FIRST_ASSUM (fun hl ->
    if (try hd_is "heap_lookup" (lhs (concl hl))
        with Failure _ -> false)
    then STRIP_ASSUME_TAC (MATCH_MP heap_lookup_SPLIT hl)
    else fail()) THEN
  FIRST_ASSUM (fun heq ->
    if not (is_heapeq heq) then fail() else
    FIRST_ASSUM (fun aeq ->
      if not (is_aeq aeq) then fail() else
      FIRST_ASSUM (fun sep ->
        if not (is_sep sep) then fail() else
        ASSUME_TAC (REWRITE_RULE[heq; word_heap_APPEND;
          word_heap_def; word_el_def; el_length_def;
          STAR_ASSOC; GSYM aeq] sep)))) THEN
  FIRST_ASSUM (fun sep ->
    if not (is_sep sep) ||
       not (exists (hd_is "word_list_exists")
              (facs (rator (concl sep)))) then fail() else
    let sep' = sfront "word_list_exists" sep in
    let cell = find (hd_is "word_list_exists")
                 (facs (rator (concl sep'))) in
    let k = el 1 (snd (strip_comb cell)) in
    SUBGOAL_THEN (mk_binop `(<):num->num->bool` `n:num` k)
      (fun lt -> STRIP_ASSUME_TAC
         (MATCH_MP word_list_exists_write (CONJ sep' lt))) THENL
     [ASM_ARITH_TAC; ALL_TAC]) THEN
  CONJ_TAC THENL
   [FIRST_ASSUM (fun th -> ACCEPT_TAC (CONJUNCT1 (SPEC_ALL th)));
    ALL_TAC] THEN
  REWRITE_TAC[memory_rel_def] THEN
  FIRST_ASSUM (fun h ->
    if hd_is "heap_in_memory_store" (concl h)
    then let args = snd (strip_comb (concl h)) in
         MAP_EVERY EXISTS_TAC [el 0 args; el 9 args; el 1 args;
                               el 2 args; el 3 args; el 4 args]
    else fail()) THEN
  REPEAT CONJ_TAC THEN TRY (FIRST_ASSUM ACCEPT_TAC) THEN
  REWRITE_TAC[heap_in_memory_store_def] THEN
  REPEAT CONJ_TAC THEN TRY (FIRST_ASSUM ACCEPT_TAC) THEN
  FIRST_ASSUM (fun sep ->
    if not (is_sep sep) then fail() else
    let fs = facs (rator (concl sep)) in
    let whs = filter (hd_is "word_heap") fs in
    if not (length whs = 2) then fail() else
    MAP_EVERY EXISTS_TAC
      [el 0 (snd (strip_comb (el 0 whs)));
       el 0 (snd (strip_comb (el 1 whs)))]) THEN
  REPEAT CONJ_TAC THEN
  TRY (FIRST_ASSUM ACCEPT_TAC) THEN
  FIRST_ASSUM (fun heq ->
    if not (is_heapeq heq) then fail() else
    FIRST_ASSUM (fun aeq ->
      if not (is_aeq aeq) then fail() else
      REWRITE_TAC[heq; word_heap_APPEND; word_heap_def;
        word_el_def; el_length_def; STAR_ASSOC; GSYM aeq])) THEN
  W(fun (asl,gl) ->
    let pred = rator gl in
    let wv = rand (rator (fst (dest_pair (rand (rand gl))))) in
    FIRST_ASSUM (fun wth ->
      let th = sepof wv wth in
      let eq = prove (mk_eq (pred,rator (concl th)),
                      REWRITE_TAC[STAR_AC]) in
      ACCEPT_TAC (REWRITE_RULE[GSYM eq] th))))
### memory_rel_Cons_alt
(* the same allocation as memory_rel_Cons1, of which this is the
   statement for a memory that holds the words of the element
   already: so the proof is that one with
   word_list_AND_word_list_exists_IMP in place of store_list_thm --
   the words of the space that the element takes are the words the
   hypothesis says are there, and what is left of the space is
   empty (word_list_exists at zero is emp) *)
  ((let hd_is n t =
     (try fst(dest_const(fst(strip_comb t))) = n
      with Failure _ -> false) in
  let rec facs t =
    if hd_is "STAR" t then
      let args = snd(strip_comb t) in
      facs (el 0 args) @ facs (el 1 args)
    else [t] in
  let grab asl p =
    tryfind (fun (_,th) ->
      if (try p th with Failure _ -> false) then th else fail())
      asl in
  let front sp cell =
    let pred = rator (concl sp) in
    let fs = facs pred in
    let rest = filter (fun t -> not (t = cell)) fs in
    let st = fst(strip_comb pred) in
    let mk x y = mk_comb(mk_comb(st,x),y) in
    let target = mk cell (end_itlist mk rest) in
    let eq = prove (mk_eq (pred,target),
              REWRITE_TAC[STAR_AC; emp_STAR; STAR_emp]) in
    REWRITE_RULE[eq] sp in
  (* an ALL2 over two appends of matching lengths *)
  let all2app = prove
   (`!(P:A->B->bool) xs1 ys1 xs2 ys2.
       LENGTH xs1 = LENGTH ys1
       ==> (ALL2 P (xs1 ++ xs2) (ys1 ++ ys2) <=>
            ALL2 P xs1 ys1 /\ ALL2 P xs2 ys2)`,
    GEN_TAC THEN LIST_INDUCT_TAC THENL
     [X_GEN_TAC `ys1:(B)list` THEN
      STRUCT_CASES_TAC (ISPEC `ys1:(B)list` list_CASES) THEN
      REWRITE_TAC[LENGTH; APPEND; ALL2; NOT_SUC;
                  ARITH_RULE `~(0 = SUC n)`];
      X_GEN_TAC `ys1:(B)list` THEN
      STRUCT_CASES_TAC (ISPEC `ys1:(B)list` list_CASES) THEN
      REWRITE_TAC[LENGTH; APPEND; ALL2; NOT_SUC;
                  ARITH_RULE `~(SUC n = 0)`; SUC_INJ] THEN
      REPEAT GEN_TAC THEN DISCH_TAC THEN
      ASM_SIMP_TAC[] THEN CONV_TAC TAUT]) in
  (* two steps of an address in one *)
  let addsum = prove
   (`!(a:'a word) x y.
       a + bytes_in_word * n2w x + bytes_in_word * n2w y =
       a + bytes_in_word * n2w (x + y)`,
    REWRITE_TAC[WORD_ADD] THEN CONV_TAC WORD_RULE) in
  (* the shift of two that the tag of a block is encoded with *)
  let shl2 = prove
   (`!t. ((n2w t):(N)word) << 2 = n2w (4 * t)`,
    GEN_TAC THEN REWRITE_TAC[word_shl; VAL_WORD] THEN
    CONV_TAC NUM_REDUCE_CONV THEN
    REWRITE_TAC[WORD_EQ; CONG] THEN CONV_TAC MOD_DOWN_CONV THEN
    REWRITE_TAC[MULT_AC]) in
  let someif = prove
   (`!p (x:A) y. (if p then SOME x else NONE) = SOME y ==> x = y`,
    REPEAT GEN_TAC THEN COND_CASES_TAC THEN
    REWRITE_TAC[distinctness "option"; injectivity "option"]) in
  (* the numeric facts that the assumptions give *)
  let numfacts asl =
    mapfilter (fun (_,th) ->
      let c = concl th in
      if (try hd_is "<=" c || hd_is "<" c ||
              (is_eq c && hd_is "LENGTH" (lhs c) &&
               hd_is "LENGTH" (rhs c))
          with Failure _ -> false) then th else fail()) asl in
  let addreq asl t1 t2 =
      let fs = numfacts asl in
      let extra = (try
        let lt = grab asl (fun th ->
          try hd_is "<" (concl th) &&
              hd_is "LENGTH" (lhand (concl th))
          with Failure _ -> false) in
        let spe = grab asl (fun th ->
          try hd_is "<=" (concl th) && is_var (lhand (concl th)) &&
              is_var (rand (concl th))
          with Failure _ -> false) in
        [MATCH_MP (ARITH_RULE
           `!a b c:num. a < b /\ b <= c ==> a + 1 <= c`)
           (CONJ lt spe)]
        with Failure _ -> []) in
      let cnd = end_itlist CONJ (fs @ extra) in
      MP (prove (mk_imp (concl cnd, mk_eq (t1,t2)),
            DISCH_THEN (REPEAT_TCL CONJUNCTS_THEN
              (fun th -> ASSUME_TAC
                 (REWRITE_RULE[LENGTH; ADD1] th))) THEN
            ASM_REWRITE_TAC[BlockRep_def; el_length_def;
                            LENGTH; ADD1] THEN
            REWRITE_TAC[WORD_SUB; WORD_ADD] THEN
            ASM_SIMP_TAC[ARITH_RULE
              `!l s h:num. l <= s ==> l <= h + s`;
              ARITH_RULE
              `!a b c:num. a <= b /\ b <= c ==> a <= c`] THEN
            CONV_TAC WORD_RULE)) cnd in
  let wordeq =
    W(fun (asl,gl) ->
      REWRITE_TAC[addreq asl (rand (rand (lhs gl)))
                    (rand (rand (rhs gl)))]) in
  (* a store that says the same of a key, with the numbers of the
     new element in place of the old ones *)
  let numeq =
    W(fun (asl,gl) ->
      let fl = grab asl (fun th ->
        try hd_is "FLOOKUP" (lhs (concl th)) &&
            rand (lhs (concl th)) = rand (lhs gl) &&
            not (concl th = gl)
        with Failure _ -> false) in
      let isn t = (try hd_is "word" t &&
                       type_of (rand t) = `:num` &&
                       not (is_numeral (rand t))
                   with Failure _ -> false) in
      let ge = find_term isn (rhs gl) in
      let fe = find_term isn (rhs (concl fl)) in
      let fs = numfacts asl in
      let cnd = end_itlist CONJ fs in
      let eq = MP (prove (mk_imp (concl cnd,
                    mk_eq (rand ge, rand fe)),
                  DISCH_THEN (REPEAT_TCL CONJUNCTS_THEN
                    ASSUME_TAC) THEN
                  REWRITE_TAC[BlockRep_def; el_length_def;
                              LENGTH; ADD1] THEN
                  ASM_ARITH_TAC)) cnd in
      REWRITE_TAC[eq] THEN FIRST_ASSUM ACCEPT_TAC) in
  CONV_TAC (TOP_DEPTH_CONV let_CONV) THEN
  DISCH_THEN (REPEAT_TCL CONJUNCTS_THEN ASSUME_TAC) THEN
  (* what the invariant says of the stack *)
  FIRST_ASSUM (fun mr ->
    if hd_is "memory_rel" (concl mr)
    then MP_TAC (REWRITE_RULE[memory_rel_def; word_ml_inv_def] mr)
    else fail()) THEN
  DISCH_THEN STRIP_ASSUME_TAC THEN
  (* the values and the words that the ZIP of the stack holds *)
  W(fun (asl,gl) ->
    let le = grab asl (fun th ->
      try is_eq (concl th) && hd_is "LENGTH" (lhs (concl th)) &&
          hd_is "LENGTH" (rhs (concl th))
      with Failure _ -> false) in
    RULE_ASSUM_TRY (REWRITE_RULE[MAP_APPEND;
      MATCH_MP MAP_FST_ZIP le; MATCH_MP MAP_SND_ZIP le])) THEN
  (* the block that the cons makes of the values *)
  W(fun (asl,gl) ->
    let ai = grab asl (fun th -> hd_is "abs_ml_inv" (concl th)) in
    let ne = grab asl (fun th ->
      try hd_is "NIL" (rhs (dest_neg (concl th)))
      with Failure _ -> false) in
    let lt = grab asl (fun th ->
      try hd_is "<" (concl th) && hd_is "LENGTH" (lhand (concl th))
      with Failure _ -> false) in
    let le = grab asl (fun th ->
      try is_eq (concl th) && hd_is "LENGTH" (lhs (concl th)) &&
          hd_is "LENGTH" (rhs (concl th))
      with Failure _ -> false) in
    let spe = grab asl (fun th ->
      try hd_is "<=" (concl th) &&
          lhand (concl th) = rand (concl lt)
      with Failure _ -> false) in
    let bnd = MATCH_MP (ARITH_RULE
                `!a b c d:num. a = b /\ b < c /\ c <= d
                               ==> a < d`)
                (CONJ le (CONJ lt spe)) in
    let tg = el 2 (snd(strip_comb (find_term
               (hd_is "make_cons_ptr") gl))) in
    MP_TAC (SPEC tg (MATCH_MP (GEN_ALL cons_thm_alt)
      (CONJ ai (CONJ bnd ne))))) THEN
  DISCH_THEN STRIP_ASSUME_TAC THEN
  (* the ends of the heap that the store holds *)
  FIRST_ASSUM (fun hs ->
    if hd_is "heap_in_memory_store" (concl hs)
    then STRIP_ASSUME_TAC
           (REWRITE_RULE[heap_in_memory_store_def] hs)
    else fail()) THEN
  (* the unused space of the heap, where the element goes *)
  FIRST_ASSUM (fun hu ->
    if not (try hd_is "heap_store_unused_alt" (lhs (concl hu))
            with Failure _ -> false) then fail() else
    MP_TAC (REWRITE_RULE[heap_store_unused_alt_def] hu)) THEN
  COND_CASES_TAC THEN REWRITE_TAC[PAIR_EQ] THEN
  DISCH_THEN STRIP_ASSUME_TAC THEN
  FIRST_X_ASSUM (fun cnd ->
    if not (is_conj (concl cnd)) then fail() else
    if not (try hd_is "heap_lookup" (lhs (lhand (concl cnd)))
            with Failure _ -> false) then fail() else
    STRIP_ASSUME_TAC cnd) THEN
  (* so the heap splits there *)
  FIRST_ASSUM (fun hl ->
    if not (try hd_is "heap_lookup" (lhs (concl hl))
            with Failure _ -> false) then fail() else
    STRIP_ASSUME_TAC (MATCH_MP heap_lookup_SPLIT hl)) THEN
  REPEAT (FIRST_X_ASSUM (fun e ->
    if not (try is_eq (concl e) && is_var (lhs (concl e)) &&
                (hd_is "APPEND" (rhs (concl e)) ||
                 hd_is "heap_length" (rhs (concl e)))
            with Failure _ -> false) then fail() else
    SUBST_ALL_TAC e)) THEN
  (* and the store writes the element at the end of the space *)
  FIRST_ASSUM (fun hs ->
    if not (try hd_is "heap_store" (lhs (concl hs))
            with Failure _ -> false) then fail() else
    MP_TAC (REWRITE_RULE[heap_store_lemma; PAIR_EQ] hs)) THEN
  DISCH_THEN STRIP_ASSUME_TAC THEN
  (* the words of the unused space, and its end where the element
     goes *)
  W(fun (asl,gl) ->
    let bnd = grab asl (fun th ->
      try hd_is "<=" (concl th) &&
          hd_is "el_length" (lhand (concl th))
      with Failure _ -> false) in
    let e1 = REWRITE_RULE[BlockRep_def; el_length_def] bnd in
    let eq1 = MATCH_MP (ARITH_RULE
                `!k s:num. k + 1 <= s ==> (s - 1) + 1 = s`) e1 in
    let eq3 = MATCH_MP (ARITH_RULE
                `!k s:num. k + 1 <= s
                           ==> (k + 1) + (s - (k + 1)) = s`) e1 in
    let sep = grab asl (fun th ->
      try hd_is "STAR" (rator (concl th))
      with Failure _ -> false) in
    let sep1 = REWRITE_RULE[word_heap_APPEND; word_heap_def;
                 word_el_def; el_length_def; eq1] sep in
    let addr = el 0 (snd(strip_comb (find (fun t ->
                 hd_is "word_list_exists" t)
                 (facs (rator (concl sep1)))))) in
    let wle = REWRITE_RULE[eq3]
                (ISPECL [lhand (lhs (concl eq3));
                         rand (lhs (concl eq3)); addr]
                   word_list_exists_ADD) in
    let sep2 = REWRITE_RULE[wle; STAR_ASSOC] sep1 in
    ASSUME_TAC sep2) THEN
  (* the words of the element are as many as its roots, and its
     address is the end of the heap less them *)
  W(fun (asl,gl) ->
    let sep = grab asl (fun th ->
      try hd_is "STAR" (rator (concl th)) &&
          length (filter (hd_is "word_list_exists")
                   (facs (rator (concl th)))) = 2
      with Failure _ -> false) in
    let bnd = grab asl (fun th ->
      try hd_is "<=" (concl th) &&
          hd_is "el_length" (lhand (concl th))
      with Failure _ -> false) in
    let e1 = REWRITE_RULE[BlockRep_def; el_length_def] bnd in
    let rsl = rand (lhand (lhand (concl e1))) in
    let l1 = grab asl (fun th ->
      try is_eq (concl th) && lhs (concl th) =
            mk_icomb (`LENGTH`,rsl)
      with Failure _ -> false) in
    let l2 = grab asl (fun th ->
      try is_eq (concl th) && lhs (concl th) = rhs (concl l1) &&
          hd_is "LENGTH" (rhs (concl th))
      with Failure _ -> false) in
    let rw = TRANS l1 l2 in
    let xs = el 1 (snd(strip_comb (find_term
               (fun t -> hd_is "misc_word_list" t &&
                         hd_is "CONS"
                           (el 1 (snd(strip_comb t)))) gl))) in
    let lenq = prove (mk_eq (mk_binop `(+):num->num->num`
                  (rhs (concl rw)) `1`, mk_icomb (`LENGTH`,xs)),
                REWRITE_TAC[LENGTH] THEN ARITH_TAC) in
    let sep4 = REWRITE_RULE[lenq] (REWRITE_RULE[rw] sep) in
    let bnd2 = REWRITE_RULE[lenq] (REWRITE_RULE[rw] e1) in
    ASSUME_TAC sep4 THEN ASSUME_TAC bnd2 THEN
    REWRITE_TAC[lenq]) THEN
  (* the two ends of the heap that the store holds *)
  W(fun (asl,gl) ->
    let flk n = grab asl (fun th ->
      try hd_is "FLOOKUP" (lhs (concl th)) &&
          fst (dest_const (rand (lhs (concl th)))) = n
      with Failure _ -> false) in
    MAP_EVERY EXISTS_TAC
      [rand (rand (rhs (concl (flk "NextFree"))));
       rand (rand (rhs (concl (flk "CurrHeap"))))]) THEN
  REPEAT CONJ_TAC THEN TRY (FIRST_ASSUM ACCEPT_TAC) THEN
  (* the words that the memory holds at that address already *)
  DISCH_THEN (fun hyp ->
    W(fun (asl,gl) ->
      let iscell t = hd_is "word_list_exists" t &&
                     hd_is "LENGTH" (el 1 (snd(strip_comb t))) in
      let sep = grab asl (fun th ->
        try hd_is "STAR" (rator (concl th)) &&
            exists iscell (facs (rator (concl th)))
        with Failure _ -> false) in
      let cell = find iscell (facs (rator (concl sep))) in
      let n = el 1 (snd(strip_comb cell)) in
      let le = ARITH_RULE (mk_binop `(<=):num->num->bool` n n) in
      ASSUME_TAC (REWRITE_RULE[SUB_REFL;
        CONJUNCT1 word_list_exists_thm; emp_STAR; STAR_emp]
        (MATCH_MP word_list_AND_word_list_exists_IMP
          (CONJ hyp (CONJ (front sep cell) le)))))) THEN
  (* the roots of the element and the roots of the stack *)
  REPEAT (FIRST_X_ASSUM (fun e ->
    if not (try is_eq (concl e) && is_var (lhs (concl e)) &&
                hd_is "APPEND" (rhs (concl e))
            with Failure _ -> false) then fail() else
    SUBST_ALL_TAC e)) THEN
  W(fun (asl,gl) ->
    let a2 = grab asl (fun th ->
      hd_is "ALL2" (concl th) &&
      hd_is "APPEND" (el 1 (snd(strip_comb (concl th))))) in
    let rsl = lhand (el 1 (snd(strip_comb (concl a2)))) in
    let l1 = grab asl (fun th ->
      try is_eq (concl th) && lhs (concl th) =
            mk_icomb (`LENGTH`,rsl)
      with Failure _ -> false) in
    let l2 = grab asl (fun th ->
      try is_eq (concl th) && lhs (concl th) = rhs (concl l1) &&
          hd_is "LENGTH" (rhs (concl th))
      with Failure _ -> false) in
    STRIP_ASSUME_TAC
      (REWRITE_RULE[MATCH_MP all2app (TRANS l1 l2)] a2)) THEN

  (* the invariant with the new element in the heap *)
  REWRITE_TAC[memory_rel_def] THEN
  W(fun (asl,gl) ->
    let ai = grab asl (fun th ->
      hd_is "abs_ml_inv" (concl th) &&
      (try hd_is "CONS" (el 1 (snd(strip_comb (concl th)))) &&
           hd_is "dataSem_Block"
             (lhand (el 1 (snd(strip_comb (concl th)))))
       with Failure _ -> false)) in
    let args = snd(strip_comb (concl ai)) in
    let ps = tparts (el 3 args) in
    MAP_EVERY EXISTS_TAC
      [el 1 ps; el 4 args; el 3 ps; el 4 ps; el 5 ps; el 6 ps]) THEN
  REPEAT CONJ_TAC THENL
   [ALL_TAC;
    (* the roots: the pointer of the new reference and the rest *)
    REWRITE_TAC[word_ml_inv_def] THEN
    W(fun (asl,gl) ->
      let ai = grab asl (fun th ->
        hd_is "abs_ml_inv" (concl th) &&
        (try hd_is "CONS" (el 1 (snd(strip_comb (concl th)))) &&
             hd_is "dataSem_Block"
               (lhand (el 1 (snd(strip_comb (concl th)))))
         with Failure _ -> false)) in
      EXISTS_TAC
        (el 0 (tparts (el 3 (snd(strip_comb (concl ai))))))) THEN
    REWRITE_TAC[MAP; FST; SND; ALL2] THEN
    CONV_TAC (TOP_DEPTH_CONV BETA_CONV) THEN
    REPEAT CONJ_TAC THEN TRY (FIRST_ASSUM ACCEPT_TAC) THEN
    (* the word of the pointer is the one make_ptr builds *)
    W(fun (asl,gl) ->
      let mp = rhs gl in
      let sub = el 1 (snd(strip_comb mp)) in
      let aterm = lhand sub in
      let bwterm = rand aterm in
      let pt = lhand (rand (lhs gl)) in
      let mulp = mk_comb (rator bwterm,
                   mk_comb (rator (rand bwterm), pt)) in
      SUBST1_TAC (addreq asl sub mulp)) THEN
    W(fun (asl,gl) ->
      let gd = grab asl (fun th ->
        hd_is "good_dimindex" (concl th)) in
      REWRITE_TAC(word_addr_clauses ()) THEN
      REWRITE_TAC[make_cons_ptr_def; get_addr_def] THEN
      REWRITE_TAC[MATCH_MP bytes_in_word_mul_eq_shift gd;
                  WORD_SHL_COMPOSE] THEN
      ASM_SIMP_TAC[ARITH_RULE
        `!a b:num. a <= b ==> a + (b - a) = b`] THEN
      AP_TERM_TAC THEN
      GEN_REWRITE_TAC (LAND_CONV o ONCE_DEPTH_CONV)
        [get_lowerbits_or_1] THEN
      WORD_BITWISE_TAC);
    FIRST_ASSUM ACCEPT_TAC;
    W(fun (asl,gl) ->
      let spe = grab asl (fun th ->
        try hd_is "<=" (concl th) && is_var (lhand (concl th)) &&
            is_var (rand (concl th))
        with Failure _ -> false) in
      let les = mapfilter (fun (_,th) ->
        if (try is_eq (concl th) &&
                hd_is "LENGTH" (lhs (concl th)) &&
                hd_is "LENGTH" (rhs (concl th))
            with Failure _ -> false) then th else fail()) asl in
      MP_TAC (end_itlist CONJ (spe :: les))) THEN
    REWRITE_TAC[BlockRep_def; el_length_def; LENGTH; ADD1] THEN
    ARITH_TAC] THEN
  (* the store of the new heap: its length is the old one *)
  REWRITE_TAC[heap_in_memory_store_def] THEN
  W(fun (asl,gl) ->
    let hu = grab asl (fun th ->
      try hd_is "heap_store_unused_alt" (lhs (concl th))
      with Failure _ -> false) in
    REWRITE_TAC[MATCH_MP heap_store_unused_alt_IMP_length hu]) THEN
  W(fun (asl,gl) ->
    let dis = CONJUNCTS (distinctness "store_name") in
    REWRITE_TAC([FLOOKUP_UPDATE; FDOM_FUPDATE; IN_INSERT] @
                dis @ map GSYM dis)) THEN
  REPEAT CONJ_TAC THEN TRY (FIRST_ASSUM ACCEPT_TAC) THEN
  (* the two heaps of the store *)
  W(fun (asl,gl) ->
    let flk n = grab asl (fun th ->
      try hd_is "FLOOKUP" (lhs (concl th)) &&
          fst (dest_const (rand (lhs (concl th)))) = n
      with Failure _ -> false) in
    MAP_EVERY EXISTS_TAC
      [rand (rand (rhs (concl (flk "CurrHeap"))));
       rand (rand (rhs (concl (flk "OtherHeap"))))]) THEN
  REPEAT CONJ_TAC THEN TRY (FIRST_ASSUM ACCEPT_TAC) THEN
  TRY (wordeq THEN NO_TAC) THEN
  TRY (numeq THEN NO_TAC) THEN
  (* the heap with the new element, which the store wrote *)
  FIRST_ASSUM (fun h2 ->
    if not (try is_eq (concl h2) && hd_is "APPEND" (lhs (concl h2)) &&
                is_var (rhs (concl h2))
            with Failure _ -> false) then fail() else
    SUBST1_TAC (SYM h2)) THEN
  REWRITE_TAC[word_heap_APPEND; word_heap_heap_expand;
              word_heap_def; heap_length_APPEND;
              heap_length_heap_expand; BlockRep_def] THEN
  REWRITE_TAC[word_el_def] THEN
  CONV_TAC (TOP_DEPTH_CONV let_CONV) THEN
  REWRITE_TAC[word_payload_def] THEN
  CONV_TAC (TOP_DEPTH_CONV let_CONV) THEN
  REWRITE_TAC[word_list_def; LENGTH_MAP; el_length_def;
              heap_length_NIL; STAR_ASSOC; emp_STAR; STAR_emp] THEN
  (* the words of the element are the roots of the values, and its
     header is the one that encode_header gave *)
  W(fun (asl,gl) ->
    let a2 = grab asl (fun th ->
      try hd_is "ALL2" (concl th) &&
          not (hd_is "MAP" (el 2 (snd(strip_comb (concl th)))))
      with Failure _ -> false) in
    let a2args = snd(strip_comb (concl a2)) in
    let fterm = rator (lhs (snd(strip_abs (el 0 a2args)))) in
    let mapeq = EQ_MP (ISPECL [el 1 a2args; el 2 a2args; fterm]
                  EVERY2_f_EQ) a2 in
    let eh = grab asl (fun th ->
      try hd_is "encode_header" (lhs (concl th))
      with Failure _ -> false) in
    let mh = CONV_RULE NUM_REDUCE_CONV (MATCH_MP someif
               (REWRITE_RULE[encode_header_def] eh)) in
    let les = mapfilter (fun (_,th) ->
      if (try is_eq (concl th) &&
              hd_is "LENGTH" (lhs (concl th)) &&
              hd_is "LENGTH" (rhs (concl th))
          with Failure _ -> false) then th else fail()) asl in
    REWRITE_TAC(shl2 :: mapeq :: mh :: les)) THEN
  (* the condition of the payload, which the header's length says *)
  W(fun (asl,gl) ->
    let pred = rator gl in
    let fs = facs pred in
    let cell = find (hd_is "cond") fs in
    let rest = filter (fun t -> not (t = cell)) fs in
    let st = fst(strip_comb pred) in
    let mk a b = mk_comb(mk_comb(st,a),b) in
    SUBGOAL_THEN (mk_eq (pred, mk cell (end_itlist mk rest)))
      SUBST1_TAC THENL
     [REWRITE_TAC[STAR_AC; emp_STAR; STAR_emp]; ALL_TAC]) THEN
  REWRITE_TAC[cond_STAR] THEN
  CONJ_TAC THENL
   [W(fun (asl,gl) ->
      let eh = grab asl (fun th ->
        try hd_is "encode_header" (lhs (concl th))
        with Failure _ -> false) in
      let ls7 = grab asl (fun th ->
        try hd_is "<" (concl th) &&
            hd_is "+" (lhand (concl th)) &&
            hd_is "data_to_word_config_len_size"
              (lhand (lhand (concl th)))
        with Failure _ -> false) in
      let ls = MATCH_MP (ARITH_RULE
                 `!a b:num. a + 7 < b ==> a + 5 < b`) ls7 in
      let gd = grab asl (fun th ->
        hd_is "good_dimindex" (concl th)) in
      STRIP_ASSUME_TAC (MATCH_MP encode_header_IMP
        (CONJ eh (CONJ ls gd)))) THEN
    W(fun (asl,gl) ->
      let eh = grab asl (fun th ->
        try hd_is "encode_header" (lhs (concl th))
        with Failure _ -> false) in
      let mh = CONV_RULE NUM_REDUCE_CONV (MATCH_MP someif
                 (REWRITE_RULE[encode_header_def] eh)) in
      REWRITE_TAC[shl2; ARITH_RULE `!t:num. t * 4 = 4 * t`;
                  mh]) THEN
    ASM_REWRITE_TAC[];
    ALL_TAC] THEN
  (* and the words at the address the store wrote them to *)
  W(fun (asl,gl) ->
    let iscell t = hd_is "misc_word_list" t &&
                   hd_is "CONS" (el 1 (snd(strip_comb t))) in
    let sl = grab asl (fun th ->
      try hd_is "STAR" (rator (concl th)) &&
          exists iscell (facs (rator (concl th)))
      with Failure _ -> false) in
    let bnd = REWRITE_RULE[LENGTH; ADD1] (grab asl (fun th ->
      try hd_is "<=" (concl th) &&
          hd_is "LENGTH" (lhand (concl th))
      with Failure _ -> false)) in
    let arith = MATCH_MP (ARITH_RULE
                  `!l s:num. l <= s ==> l + (s - l) = s`) bnd in
    let sl2 = REWRITE_RULE[LENGTH; ADD1; word_list_def;
                word_heap_heap_expand; STAR_ASSOC; emp_STAR;
                STAR_emp; addsum] sl in
    REWRITE_TAC[heap_length_CONS; heap_length_NIL; el_length_def;
                ARITH_RULE `!n:num. n + 0 = n`; addsum;
                arith] THEN
    W(fun (asl2,gl2) ->
      let eq = prove (mk_eq (rator gl2, rator (concl sl2)),
                REWRITE_TAC[STAR_AC; emp_STAR; STAR_emp]) in
      ACCEPT_TAC (REWRITE_RULE[GSYM eq] sl2)))))
### bytes_to_word_eq_lemma
(* the bytes of a list written into a word leave the bits of the
   word that no byte of the list covers, and cover the others with
   the bytes: so whether two words that the same list was written
   into are equal depends on the bits that no byte covers, which
   is where the two words have to agree, and not on the bytes
   themselves -- the key lemma says it of one bit at a time
   (WORD_EQ_BITS_ALT, and set_byte_eq_ARB's own step that the bit
   of a set_byte is the byte's inside the byte and the word's
   outside it), by the induction on the number of words that
   bytes_to_word takes, where a list of as many bytes splits the
   same way (LENGTH_EQ_NIL, LENGTH_EQ_CONS) *)
  ((let hd_is n t =
     (try fst(dest_const(fst(strip_comb t))) = n
      with Failure _ -> false) in
  let grab asl p =
    tryfind (fun (_,th) ->
      if (try p th with Failure _ -> false) then th else fail())
      asl in
  (* the bit of a set_byte is the byte's bit inside the byte and
     the word's outside it (set_byte_eq_ARB) *)
  let bsb = prove
   (`!a b (h:(N)word) bb j.
       byte_index a bb + 8 <= dimindex (:N) /\ j < dimindex (:N)
       ==> (bit j (set_byte a b h bb) <=>
            (if byte_index a bb <= j /\ j < byte_index a bb + 8
             then bit (j - byte_index a bb) b else bit j h))`,
    REPEAT GEN_TAC THEN STRIP_TAC THEN
    REWRITE_TAC[set_byte_def] THEN
    CONV_TAC(TOP_DEPTH_CONV let_CONV) THEN
    ASM_SIMP_TAC[BIT_WORD_OR; BIT_WORD_SLICE_ALT;
                 ARITH_RULE `0 <= (i:num)`;
                 BIT_WORD_SHL; BIT_WORD_ZX; DIMINDEX_8] THEN
    MP_TAC(REWRITE_RULE[DIMINDEX_8]
      (ISPECL [`b:(8)word`; `j - byte_index (a:(N)word) bb`]
         BIT_TRIVIAL)) THEN
    ASM_CASES_TAC `byte_index (a:(N)word) bb <= j` THEN
    ASM_CASES_TAC `j < byte_index (a:(N)word) bb + 8` THEN
    ASM_CASES_TAC `bit j (h:(N)word)` THEN
    ASM_CASES_TAC
      `bit (j - byte_index (a:(N)word) bb) (b:(8)word)` THEN
    ASM_REWRITE_TAC[] THEN ARITH_NO_BIT_TAC) in
  (* and a byte of a word of the machine is a byte of it *)
  let bib = prove
   (`!(a:'a word) bb. good_dimindex (:'a)
       ==> byte_index a bb + 8 <= dimindex (:'a)`,
    REPEAT GEN_TAC THEN
    REWRITE_TAC[byte_index_def] THEN
    CONV_TAC(TOP_DEPTH_CONV let_CONV) THEN
    REWRITE_TAC[good_dimindex_def] THEN
    DISCH_THEN(DISJ_CASES_THEN (fun th -> SUBST1_TAC th)) THEN
    CONV_TAC NUM_REDUCE_CONV THEN
    MP_TAC(SPEC `w2n (a:'a word)`
      (MATCH_MP DIVISION (ARITH_RULE `~(4 = 0)`))) THEN
    MP_TAC(SPEC `w2n (a:'a word)`
      (MATCH_MP DIVISION (ARITH_RULE `~(8 = 0)`))) THEN
    COND_CASES_TAC THEN ARITH_TAC) in
  (* so whether a bit of the words that two lists of bytes are
     written into is the same bit does not depend on the bytes,
     but only on how many there are: inside a byte that the list
     wrote the bit is the byte's and the two agree, and outside
     every byte the bit is the word's *)
  let key = prove
   (`good_dimindex (:'a)
     ==> !k bs bs' a (h:'a word) h' bb j.
           LENGTH bs = LENGTH bs' /\ j < dimindex (:'a)
           ==> ((bit j (bytes_to_word k a bs h bb) <=>
                 bit j (bytes_to_word k a bs h' bb)) <=>
                (bit j (bytes_to_word k a bs' h bb) <=>
                 bit j (bytes_to_word k a bs' h' bb)))`,
    DISCH_TAC THEN INDUCT_TAC THEN REPEAT GEN_TAC THEN
    STRIP_TAC THEN
    ONCE_REWRITE_TAC[bytes_to_word_def] THEN
    REWRITE_TAC[NOT_SUC; SUC_SUB1] THEN
    (* the words of no byte are the words themselves, which the
       rewrite closed; the step writes the first byte *)
    DISJ_CASES_THEN2 SUBST_ALL_TAC
      (X_CHOOSE_THEN `b0:word8`
         (X_CHOOSE_THEN `t0:word8 list` SUBST_ALL_TAC))
      (ISPEC `bs:word8 list` list_CASES) THEN
    (* the other list has as many bytes, so it splits the same way
       (LENGTH_EQ_NIL, LENGTH_EQ_CONS) *)
    FIRST_X_ASSUM (fun le ->
      if not (try hd_is "LENGTH" (lhs (concl le))
              with Failure _ -> false) then fail() else
      REPEAT_TCL CHOOSE_THEN
        (REPEAT_TCL CONJUNCTS_THEN
           (fun c ->
              if (try is_var (lhs (concl c))
                  with Failure _ -> false)
              then SUBST_ALL_TAC c else ASSUME_TAC c))
        (REWRITE_RULE[LENGTH; LENGTH_EQ_NIL; LENGTH_EQ_CONS]
           (SYM le))) THEN
    SAFE_MATCH_REDUCE_TAC THEN REWRITE_TAC[] THEN
    W(fun (asl,gl) ->
      let gd = grab asl (fun th ->
        hd_is "good_dimindex" (concl th)) in
      let jlt = grab asl (fun th ->
        try hd_is "<" (concl th) &&
            hd_is "dimindex" (rand (concl th))
        with Failure _ -> false) in
      let sb = find_term (hd_is "set_byte") gl in
      let a = el 0 (snd (strip_comb sb)) in
      let bb = el 3 (snd (strip_comb sb)) in
      let bi = MP (SPECL [a; bb] bib) gd in
      ASM_SIMP_TAC[bsb; bi; jlt]) THEN
    COND_CASES_TAC THEN REWRITE_TAC[] THEN
    FIRST_X_ASSUM (fun ih ->
      if not (is_forall (concl ih)) then fail() else
      W(fun (asl,gl) ->
        let le = grab asl (fun th ->
          try is_eq (concl th) &&
              hd_is "LENGTH" (lhs (concl th))
          with Failure _ -> false) in
        let jlt = grab asl (fun th ->
          try hd_is "<" (concl th) &&
              hd_is "dimindex" (rand (concl th))
          with Failure _ -> false) in
        let p = lhand gl and q = rand gl in
        let args = snd (strip_comb (rand (lhand p))) in
        let args2 = snd (strip_comb (rand (lhand q))) in
        let inst = SPECL [el 2 args; el 2 args2; el 1 args;
                          el 3 args;
                          el 3 (snd (strip_comb (rand (rand p))));
                          el 4 args; lhand (concl jlt)] ih in
        let eqn = lhand (lhand (concl inst)) in
        let le2 = if concl le = eqn then le else SYM le in
        ACCEPT_TAC (MP inst (CONJ le2 jlt))))) in
  (* the theorem: the two sides of the hypothesis agree in a bit
     exactly when the two sides of the goal do *)
  REWRITE_TAC[WORD_EQ_BITS_ALT] THEN
  DISCH_THEN (REPEAT_TCL CONJUNCTS_THEN ASSUME_TAC) THEN
  X_GEN_TAC `j:num` THEN DISCH_TAC THEN
  W(fun (asl,gl) ->
    let gd = grab asl (fun th ->
      hd_is "good_dimindex" (concl th)) in
    let le = grab asl (fun th ->
      try is_eq (concl th) && hd_is "LENGTH" (lhs (concl th))
      with Failure _ -> false) in
    let jlt = grab asl (fun th ->
      try hd_is "<" (concl th) &&
          hd_is "dimindex" (rand (concl th))
      with Failure _ -> false) in
    let hb = grab asl (fun th -> is_forall (concl th)) in
    let hj = MP (SPEC `j:num` hb) jlt in
    let args = snd (strip_comb (rand (lhand gl))) in
    let args' = snd (strip_comb (rand (rand gl))) in
    let args2 = snd (strip_comb (rand (lhand (concl hj)))) in
    let inst = SPECL [el 0 args; el 2 args2; el 2 args;
                      el 1 args; el 3 args; el 3 args';
                      el 4 args; `j:num`]
                 (MATCH_MP key gd) in
    let eqn = lhand (lhand (concl inst)) in
    let le2 = if concl le = eqn then le else SYM le in
    ACCEPT_TAC (EQ_MP (MP inst (CONJ le2 jlt)) hj))))
### write_bytes_change_extra
  (* the induction of the source over the list of words: there are
     more words to fill than the list has, so the bytes fill the
     first word and what the word was does not matter (cover, which
     is the source's set_byte_all_32 and set_byte_all_64 after the
     bytes of a word are taken off the list), and the induction
     hypothesis says it of the rest, whose count is one less
     (DIV_SUB_STEP) *)
  (let rec ntimes k t =
     if k <= 0 then ALL_TAC else t THEN ntimes (k - 1) t in
   (* take the bytes of one more byte of the word off the list, and
      drop the case where the list is too short for it *)
   let SPLIT1 =
     W(fun (asl,w) ->
       let bw = find_term (hd_is "bytes_to_word") w in
       let rec tlv t = if is_var t then t
                       else if hd_is "CONS" t then tlv (rand t)
                       else failwith "tlv" in
       STRUCT_CASES_TAC (ISPEC (tlv (el 2 (snd (strip_comb bw))))
                           list_CASES)) THEN
     REWRITE_TAC[LENGTH; ADD1] THEN
     CONV_TAC NUM_REDUCE_CONV THEN REWRITE_TAC[] in
   let UNFOLD1 =
     ONCE_REWRITE_TAC[bytes_to_word_def] THEN
     CONV_TAC NUM_REDUCE_CONV THEN REWRITE_TAC[] THEN
     MATCH_REDUCE_TAC THEN
     REWRITE_TAC[GSYM WORD_ADD] THEN CONV_TAC NUM_REDUCE_CONV in
   let cover = prove
    (`!bs (w:'a word) w' be'.
        good_dimindex (:'a)
        ==> dimindex (:'a) DIV 8 <= LENGTH bs
        ==> bytes_to_word (dimindex (:'a) DIV 8) (n2w 0) bs w be' =
            bytes_to_word (dimindex (:'a) DIV 8) (n2w 0) bs w' be'`,
     REPEAT GEN_TAC THEN
     REWRITE_TAC[good_dimindex_def] THEN
     DISCH_THEN(DISJ_CASES_THEN (fun eq ->
       let n = dest_small_numeral (rand (concl eq)) / 8 in
       let all = if n = 4 then set_byte_all_32
                 else set_byte_all_64 in
       SUBST1_TAC eq THEN CONV_TAC NUM_REDUCE_CONV THEN
       ntimes n SPLIT1 THEN ntimes (n + 1) UNFOLD1 THEN
       DISCH_THEN (K ALL_TAC) THEN
       MATCH_ACCEPT_TAC
         (GEN_ALL (MATCH_MP (GEN_ALL all) eq))))) in
   LIST_INDUCT_TAC THEN REPEAT GEN_TAC THEN
   LIST_CASES_TAC ["ws'"] THEN
   REWRITE_TAC[LENGTH; write_bytes_def;
               ARITH_RULE `(0 = SUC n) <=> F`;
               ARITH_RULE `(SUC n = 0) <=> F`] THEN
   CONV_TAC(DEPTH_CONV let_CONV) THEN
   REWRITE_TAC[CONS_11] THEN
   STRIP_TAC THEN
   (* the bytes fill the first word, because there are more words to
      fill than the list of words has *)
   W(fun (asl,w) ->
     let dd = find_term (hd_is "DIV")
                (list_mk_conj (w :: map (concl o snd) asl)) in
     let bw = find_term (fun tm -> hd_is "bytes_to_word" tm) w in
     let bs = el 2 (snd (strip_comb bw)) in
     SUBGOAL_THEN (mk_binop `(<=):num->num->bool` dd
                     (list_mk_icomb "LENGTH" [bs])) ASSUME_TAC THENL
      [FIRST_X_ASSUM (fun bl ->
         if hd_is "byte_len" (rand (concl bl)) then MP_TAC bl
         else fail()) THEN
       FIRST_ASSUM (fun gd ->
         DISJ_CASES_THEN (fun eq ->
           REWRITE_TAC[byte_len_def; eq] THEN SUBST1_TAC eq)
           (REWRITE_RULE[good_dimindex_def] gd)) THEN
       CONV_TAC NUM_REDUCE_CONV THEN REWRITE_TAC[] THEN
       W(fun (asl,w) ->
         let dv = find_term (hd_is "DIV") w in
         MP_TAC (SPECL [rand dv; lhand dv; `1`] LE_RDIV_EQ)) THEN
       CONV_TAC NUM_REDUCE_CONV THEN REWRITE_TAC[] THEN
       ASM_ARITH_TAC;
       ALL_TAC]) THEN
   CONJ_TAC THENL
    [FIRST_ASSUM (fun gd ->
       if not (hd_is "good_dimindex" (concl gd)) then fail() else
       FIRST_ASSUM (fun le ->
         MATCH_ACCEPT_TAC (GEN_ALL (MATCH_MP (MATCH_MP
           (GEN_ALL cover) gd) le))));
     FIRST_X_ASSUM MATCH_MP_TAC THEN
     REPEAT CONJ_TAC THEN TRY (FIRST_ASSUM ACCEPT_TAC) THENL
      [ASM_ARITH_TAC;
       REWRITE_TAC[byte_len_def; LENGTH_DROP] THEN
       FIRST_X_ASSUM (fun bl ->
         if hd_is "byte_len" (rand (concl bl)) then MP_TAC bl
         else fail()) THEN
       REWRITE_TAC[byte_len_def] THEN
       FIRST_ASSUM (fun gd ->
         DISJ_CASES_THEN (fun eq ->
           RULE_ASSUM_TAC(REWRITE_RULE[eq]) THEN
           REWRITE_TAC[eq] THEN SUBST1_TAC eq)
           (REWRITE_RULE[good_dimindex_def] gd)) THEN
       CONV_TAC NUM_REDUCE_CONV THEN REWRITE_TAC[] THEN
       ASM_SIMP_TAC[DIV_SUB_STEP; ARITH_RULE `0 < 4 /\ 0 < 8`] THEN
       ASM_ARITH_TAC]])
### memory_rel_RefByte_content
(* the content of a new byte array: new_byte_alt_thm writes the
   element Bytes of the bytes into the unused space of the heap --
   its words are the words of the statement (bytes_def), as many as
   byte_len counts (LENGTH_write_bytes, LENGTH_REPLICATE), and one
   more for the header -- and gives the invariant with the array in
   the references and its pointer on the stack.  What is left is
   that the store of the statement writes those words where the
   element went: heap_store_unused_alt splits the space
   (heap_lookup_SPLIT, heap_store_lemma), word_list_exists_ADD cuts
   the words of the element off the front of it, store_list_thm
   writes them there, and the heap of the new element is its header
   and its words (word_payload_def).  The condition of the payload
   is the length that decode_length reads off the header, which
   decode_length_byte_header says, and the pointer is make_ptr of
   the offset of the address (bytes_in_word_mul_eq_shift,
   get_lowerbits_def) *)
  ((let hd_is n t =
     (try fst(dest_const(fst(strip_comb t))) = n
      with Failure _ -> false) in
  let rec facs t =
    if hd_is "STAR" t then
      let args = snd(strip_comb t) in
      facs (el 0 args) @ facs (el 1 args)
    else [t] in
  let grab asl p =
    tryfind (fun (_,th) ->
      if (try p th with Failure _ -> false) then th else fail())
      asl in
  let front sp cell =
    let pred = rator (concl sp) in
    let fs = facs pred in
    let rest = filter (fun t -> not (t = cell)) fs in
    let st = fst(strip_comb pred) in
    let mk x y = mk_comb(mk_comb(st,x),y) in
    let target = mk cell (end_itlist mk rest) in
    let eq = prove (mk_eq (pred,target),
              REWRITE_TAC[STAR_AC; emp_STAR; STAR_emp]) in
    REWRITE_RULE[eq] sp in
  (* two steps of an address in one *)
  let addsum = prove
   (`!(a:'a word) x y.
       a + bytes_in_word * n2w x + bytes_in_word * n2w y =
       a + bytes_in_word * n2w (x + y)`,
    REWRITE_TAC[WORD_ADD] THEN CONV_TAC WORD_RULE) in
  (* the bits of a zero word are zero *)
  let bits0 = prove
   (`!h l. word_bits h l ((n2w 0):(N)word) = n2w 0`,
    REWRITE_TAC[word_bits; WORD_EQ_BITS_ALT; BIT_WORD_SUBWORD;
                BIT_WORD_0] THEN
    CONV_TAC TAUT) in
  (* the numeric facts that the assumptions give *)
  let numfacts asl =
    mapfilter (fun (_,th) ->
      let c = concl th in
      if (try hd_is "<=" c || hd_is "<" c ||
              (is_eq c && hd_is "LENGTH" (lhs c) &&
               hd_is "LENGTH" (rhs c))
          with Failure _ -> false) then th else fail()) asl in
  let addreq asl t1 t2 =
      let fs = numfacts asl in
      let extra = (try
        let lt = grab asl (fun th ->
          try hd_is "<" (concl th) &&
              hd_is "LENGTH" (lhand (concl th))
          with Failure _ -> false) in
        let spe = grab asl (fun th ->
          try hd_is "<=" (concl th) && is_var (lhand (concl th)) &&
              is_var (rand (concl th))
          with Failure _ -> false) in
        [MATCH_MP (ARITH_RULE
           `!a b c:num. a < b /\ b <= c ==> a + 1 <= c`)
           (CONJ lt spe)]
        with Failure _ -> []) in
      let cnd = end_itlist CONJ (fs @ extra) in
      MP (prove (mk_imp (concl cnd, mk_eq (t1,t2)),
            DISCH_THEN (REPEAT_TCL CONJUNCTS_THEN
              (fun th -> ASSUME_TAC
                 (REWRITE_RULE[LENGTH; ADD1] th))) THEN
            ASM_REWRITE_TAC[el_length_def; LENGTH; LENGTH_MAP;
                            LENGTH_write_bytes;
                            LENGTH_REPLICATE; ADD1] THEN
            REWRITE_TAC[WORD_SUB; WORD_ADD] THEN
            ASM_SIMP_TAC[ARITH_RULE
              `!l s h:num. l <= s ==> l <= h + s`;
              ARITH_RULE
              `!a b c:num. a <= b /\ b <= c ==> a <= c`] THEN
            CONV_TAC WORD_RULE)) cnd in
  let wordeq =
    W(fun (asl,gl) ->
      REWRITE_TAC[addreq asl (rand (rand (lhs gl)))
                    (rand (rand (rhs gl)))]) in
  (* a store that says the same of a key, with the numbers of the
     new element in place of the old ones *)
  let numeq =
    W(fun (asl,gl) ->
      let fl = grab asl (fun th ->
        try hd_is "FLOOKUP" (lhs (concl th)) &&
            rand (lhs (concl th)) = rand (lhs gl) &&
            not (concl th = gl)
        with Failure _ -> false) in
      let isn t = (try hd_is "word" t &&
                       type_of (rand t) = `:num` &&
                       not (is_numeral (rand t))
                   with Failure _ -> false) in
      let ge = find_term isn (rhs gl) in
      let fe = find_term isn (rhs (concl fl)) in
      let fs = numfacts asl in
      let cnd = end_itlist CONJ fs in
      let eq = MP (prove (mk_imp (concl cnd,
                    mk_eq (rand ge, rand fe)),
                  DISCH_THEN (REPEAT_TCL CONJUNCTS_THEN
                    ASSUME_TAC) THEN
                  REWRITE_TAC[el_length_def; LENGTH; LENGTH_MAP;
                              LENGTH_write_bytes;
                              LENGTH_REPLICATE; ADD1] THEN
                  ASM_ARITH_TAC)) cnd in
      REWRITE_TAC[eq] THEN FIRST_ASSUM ACCEPT_TAC) in
  CONV_TAC (TOP_DEPTH_CONV let_CONV) THEN
  DISCH_THEN (REPEAT_TCL CONJUNCTS_THEN ASSUME_TAC) THEN
  (* the count of the bytes is the length of the list *)
  TRY (FIRST_X_ASSUM (fun e ->
    if not (try is_eq (concl e) && is_var (lhs (concl e)) &&
                hd_is "LENGTH" (rhs (concl e))
            with Failure _ -> false) then fail() else
    SUBST_ALL_TAC e)) THEN
  (* what the invariant says of the stack *)
  FIRST_ASSUM (fun mr ->
    if hd_is "memory_rel" (concl mr)
    then MP_TAC (REWRITE_RULE[memory_rel_def; word_ml_inv_def] mr)
    else fail()) THEN
  DISCH_THEN STRIP_ASSUME_TAC THEN
  (* the element that holds the bytes *)
  W(fun (asl,gl) ->
    let ai = grab asl (fun th -> hd_is "abs_ml_inv" (concl th)) in
    let lt = grab asl (fun th ->
      try hd_is "<" (concl th) &&
          hd_is "byte_len" (lhand (concl th)) &&
          is_var (rand (concl th))
      with Failure _ -> false) in
    let spe = grab asl (fun th ->
      try hd_is "<=" (concl th) &&
          lhand (concl th) = rand (concl lt)
      with Failure _ -> false) in
    let gd = grab asl (fun th ->
      hd_is "good_dimindex" (concl th)) in
    let nd = grab asl (fun th ->
      try hd_is "IN" (dest_neg (concl th))
      with Failure _ -> false) in
    let bl = lhand (concl lt) in
    let nb = rand bl in
    let bnd = MATCH_MP (ARITH_RULE
                `!b c d:num. b < c /\ c <= d ==> b + 1 <= d`)
                (CONJ lt spe) in
    let abb = MP (prove (mk_imp (concl gd,
                  mk_comb (`Abbrev`, mk_eq (bl,
                    mk_binop `(+):num->num->num`
                      (mk_binop `(DIV):num->num->num` nb
                         (mk_binop `(DIV):num->num->num`
                            (mk_icomb (`dimindex`,
                               rand (concl gd))) `8`))
                      `1`))),
                REWRITE_TAC[abbrev_def; byte_len_def;
                            good_dimindex_def] THEN
                STRIP_TAC THEN ASM_REWRITE_TAC[] THEN
                CONV_TAC NUM_REDUCE_CONV)) gd in
    let bv = find (fun v -> fst (dest_var v) = "b")
               (frees (concl new_byte_alt_thm)) in
    let flt = el 1 (snd(strip_comb (find_term
                (hd_is "make_byte_header") gl))) in
    let nba = INST [`T`,bv] new_byte_alt_thm in
    MP_TAC (SPEC flt (MATCH_MP (GEN_ALL nba)
      (CONJ ai (CONJ abb (CONJ nd bnd)))))) THEN
  DISCH_THEN STRIP_ASSUME_TAC THEN
  (* the element holds the bytes written into its words *)
  RULE_ASSUM_TRY (REWRITE_RULE[bytes_def]) THEN
  RULE_ASSUM_TRY (CONV_RULE (TOP_DEPTH_CONV let_CONV)) THEN
  REWRITE_TAC[bytes_def] THEN
  CONV_TAC (TOP_DEPTH_CONV let_CONV) THEN
  RULE_ASSUM_TRY (REWRITE_RULE[LENGTH_write_bytes;
                               LENGTH_REPLICATE]) THEN
  REWRITE_TAC[LENGTH_write_bytes; LENGTH_REPLICATE] THEN
  (* the ends of the heap that the store holds *)
  FIRST_ASSUM (fun hs ->
    if hd_is "heap_in_memory_store" (concl hs)
    then STRIP_ASSUME_TAC
           (REWRITE_RULE[heap_in_memory_store_def] hs)
    else fail()) THEN
  (* the unused space of the heap, where the element goes *)
  FIRST_ASSUM (fun hu ->
    if not (try hd_is "heap_store_unused_alt" (lhs (concl hu))
            with Failure _ -> false) then fail() else
    MP_TAC (REWRITE_RULE[heap_store_unused_alt_def] hu)) THEN
  COND_CASES_TAC THEN REWRITE_TAC[PAIR_EQ] THEN
  DISCH_THEN STRIP_ASSUME_TAC THEN
  FIRST_X_ASSUM (fun cnd ->
    if not (is_conj (concl cnd)) then fail() else
    if not (try hd_is "heap_lookup" (lhs (lhand (concl cnd)))
            with Failure _ -> false) then fail() else
    STRIP_ASSUME_TAC cnd) THEN
  (* so the heap splits there *)
  FIRST_ASSUM (fun hl ->
    if not (try hd_is "heap_lookup" (lhs (concl hl))
            with Failure _ -> false) then fail() else
    STRIP_ASSUME_TAC (MATCH_MP heap_lookup_SPLIT hl)) THEN
  REPEAT (FIRST_X_ASSUM (fun e ->
    if not (try is_eq (concl e) && is_var (lhs (concl e)) &&
                (hd_is "APPEND" (rhs (concl e)) ||
                 hd_is "heap_length" (rhs (concl e)))
            with Failure _ -> false) then fail() else
    SUBST_ALL_TAC e)) THEN
  (* and the store writes the element at the end of the space *)
  FIRST_ASSUM (fun hs ->
    if not (try hd_is "heap_store" (lhs (concl hs))
            with Failure _ -> false) then fail() else
    MP_TAC (REWRITE_RULE[heap_store_lemma; PAIR_EQ] hs)) THEN
  DISCH_THEN STRIP_ASSUME_TAC THEN
  (* the words of the unused space, and its end where the element
     goes *)
  W(fun (asl,gl) ->
    let bnd = grab asl (fun th ->
      try hd_is "<=" (concl th) &&
          hd_is "el_length" (lhand (concl th))
      with Failure _ -> false) in
    let e1 = CONV_RULE NUM_REDUCE_CONV
               (REWRITE_RULE[el_length_def] bnd) in
    let eq1 = MATCH_MP (ARITH_RULE
                `!k s:num. k + 1 <= s ==> (s - 1) + 1 = s`) e1 in
    let eq3 = MATCH_MP (ARITH_RULE
                `!k s:num. k + 1 <= s
                           ==> (k + 1) + (s - (k + 1)) = s`) e1 in
    let sep = grab asl (fun th ->
      try hd_is "STAR" (rator (concl th))
      with Failure _ -> false) in
    let sep1 = REWRITE_RULE[word_heap_APPEND; word_heap_def;
                 word_el_def; el_length_def; eq1] sep in
    let addr = el 0 (snd(strip_comb (find (fun t ->
                 hd_is "word_list_exists" t)
                 (facs (rator (concl sep1)))))) in
    let wle = REWRITE_RULE[eq3]
                (ISPECL [lhand (lhs (concl eq3));
                         rand (lhs (concl eq3)); addr]
                   word_list_exists_ADD) in
    let sep2 = REWRITE_RULE[wle; STAR_ASSOC] sep1 in
    ASSUME_TAC sep2) THEN
  (* the words of the element are as many as its roots, and its
     address is the end of the heap less them *)
  W(fun (asl,gl) ->
    let sep = grab asl (fun th ->
      try hd_is "STAR" (rator (concl th)) &&
          length (filter (hd_is "word_list_exists")
                   (facs (rator (concl th)))) = 2
      with Failure _ -> false) in
    let bnd = grab asl (fun th ->
      try hd_is "<=" (concl th) &&
          hd_is "el_length" (lhand (concl th))
      with Failure _ -> false) in
    let e1 = CONV_RULE NUM_REDUCE_CONV
               (REWRITE_RULE[el_length_def] bnd) in
    let cells = filter (hd_is "word_list_exists")
                  (facs (rator (concl sep))) in
    let count = el 1 (snd(strip_comb (el 0 cells))) in
    let xs = el 1 (snd(strip_comb (find_term
               (hd_is "data_to_word_memoryProof_store_list") gl))) in
    let lenq = prove (mk_eq (count, mk_icomb (`LENGTH`,xs)),
                REWRITE_TAC[LENGTH; LENGTH_MAP;
                            LENGTH_write_bytes;
                            LENGTH_REPLICATE] THEN
                ARITH_TAC) in
    let sep4 = REWRITE_RULE[lenq] sep in
    let bnd2 = REWRITE_RULE[lenq] e1 in
    ASSUME_TAC sep4 THEN ASSUME_TAC bnd2 THEN
    REWRITE_TAC[lenq]) THEN
  (* which the store writes there *)
  W(fun (asl,gl) ->
    let iscell t = hd_is "word_list_exists" t &&
                   hd_is "LENGTH" (el 1 (snd(strip_comb t))) in
    let sep = grab asl (fun th ->
      try hd_is "STAR" (rator (concl th)) &&
          exists iscell (facs (rator (concl th)))
      with Failure _ -> false) in
    let cell = find iscell (facs (rator (concl sep))) in
    STRIP_ASSUME_TAC (MATCH_MP store_list_thm (front sep cell))) THEN
  (* the ends of the heap, and the memory that the store wrote *)
  W(fun (asl,gl) ->
    let flk n = grab asl (fun th ->
      try hd_is "FLOOKUP" (lhs (concl th)) &&
          fst (dest_const (rand (lhs (concl th)))) = n
      with Failure _ -> false) in
    let sl = grab asl (fun th ->
      try hd_is "data_to_word_memoryProof_store_list"
            (lhs (concl th))
      with Failure _ -> false) in
    MAP_EVERY EXISTS_TAC
      [rand (rand (rhs (concl (flk "NextFree"))));
       rand (rand (rhs (concl (flk "CurrHeap"))));
       rand (rhs (concl sl))]) THEN
  (* the address of the element is the end of the heap less the
     words it takes *)
  W(fun (asl,gl) ->
    let sl = find_term
               (hd_is "data_to_word_memoryProof_store_list") gl in
    let t1 = el 0 (snd(strip_comb sl)) in
    let iscell t = hd_is "misc_word_list" t &&
                   hd_is "CONS" (el 1 (snd(strip_comb t))) in
    let sep = grab asl (fun th ->
      try hd_is "STAR" (rator (concl th)) &&
          exists iscell (facs (rator (concl th)))
      with Failure _ -> false) in
    let t2 = el 0 (snd(strip_comb
               (find iscell (facs (rator (concl sep)))))) in
    let bnd = grab asl (fun th ->
      try hd_is "<=" (concl th) &&
          hd_is "LENGTH" (lhand (concl th))
      with Failure _ -> false) in
    let eq = MP (prove (mk_imp (concl bnd, mk_eq (t1,t2)),
                  DISCH_TAC THEN ASM_SIMP_TAC[WORD_SUB] THEN
                  REWRITE_TAC[WORD_ADD] THEN
                  CONV_TAC WORD_RULE)) bnd in
    REWRITE_TAC[eq]) THEN
  REPEAT CONJ_TAC THEN TRY (FIRST_ASSUM ACCEPT_TAC) THEN
  (* the invariant with the new element in the heap *)
  REWRITE_TAC[memory_rel_def] THEN
  W(fun (asl,gl) ->
    let ai = grab asl (fun th ->
      hd_is "abs_ml_inv" (concl th) &&
      (try hd_is "CONS" (el 1 (snd(strip_comb (concl th))))
       with Failure _ -> false)) in
    let args = snd(strip_comb (concl ai)) in
    let ps = tparts (el 3 args) in
    MAP_EVERY EXISTS_TAC
      [el 1 ps; el 4 args; el 3 ps; el 4 ps; el 5 ps; el 6 ps]) THEN
  REPEAT CONJ_TAC THENL
   [ALL_TAC;
    (* the roots: the pointer of the new reference and the rest *)
    REWRITE_TAC[word_ml_inv_def] THEN
    W(fun (asl,gl) ->
      let ai = grab asl (fun th ->
        hd_is "abs_ml_inv" (concl th) &&
        (try hd_is "CONS" (el 1 (snd(strip_comb (concl th))))
         with Failure _ -> false)) in
      EXISTS_TAC
        (el 0 (tparts (el 3 (snd(strip_comb (concl ai))))))) THEN
    REWRITE_TAC[MAP; FST; SND; ALL2] THEN
    CONV_TAC (TOP_DEPTH_CONV BETA_CONV) THEN
    REPEAT CONJ_TAC THEN TRY (FIRST_ASSUM ACCEPT_TAC) THEN
    (* the word of the pointer is the one make_ptr builds *)
    W(fun (asl,gl) ->
      let mp = rhs gl in
      let sub = el 1 (snd(strip_comb mp)) in
      let aterm = lhand sub in
      let bwterm = rand aterm in
      let pt = lhand (rand (lhs gl)) in
      let mulp = mk_comb (rator bwterm,
                   mk_comb (rator (rand bwterm), pt)) in
      SUBST1_TAC (addreq asl sub mulp)) THEN
    W(fun (asl,gl) ->
      let gd = grab asl (fun th ->
        hd_is "good_dimindex" (concl th)) in
      REWRITE_TAC(word_addr_clauses ()) THEN
      REWRITE_TAC[make_ptr_def; get_addr_def;
                  get_lowerbits_def] THEN
      MATCH_REDUCE_TAC THEN
      REWRITE_TAC[MATCH_MP bytes_in_word_mul_eq_shift gd;
                  WORD_SHL_COMPOSE; bits0] THEN
      ASM_SIMP_TAC[ARITH_RULE
        `!a b:num. a <= b ==> a + (b - a) = b`] THEN
      REWRITE_TAC[WORD_OR_0; WORD_ADD_0]);
    FIRST_ASSUM ACCEPT_TAC;
    W(fun (asl,gl) ->
      let spe = grab asl (fun th ->
        try hd_is "<=" (concl th) && is_var (lhand (concl th)) &&
            is_var (rand (concl th))
        with Failure _ -> false) in
      let les = mapfilter (fun (_,th) ->
        if (try is_eq (concl th) &&
                hd_is "LENGTH" (lhs (concl th)) &&
                hd_is "LENGTH" (rhs (concl th))
            with Failure _ -> false) then th else fail()) asl in
      MP_TAC (end_itlist CONJ (spe :: les))) THEN
    REWRITE_TAC[el_length_def; LENGTH; LENGTH_MAP;
                LENGTH_write_bytes; LENGTH_REPLICATE; ADD1] THEN
    ARITH_TAC] THEN
  (* the store of the new heap: its length is the old one *)
  REWRITE_TAC[heap_in_memory_store_def] THEN
  W(fun (asl,gl) ->
    let hu = grab asl (fun th ->
      try hd_is "heap_store_unused_alt" (lhs (concl th))
      with Failure _ -> false) in
    REWRITE_TAC[MATCH_MP heap_store_unused_alt_IMP_length hu]) THEN
  W(fun (asl,gl) ->
    let dis = CONJUNCTS (distinctness "store_name") in
    REWRITE_TAC([FLOOKUP_UPDATE; FDOM_FUPDATE; IN_INSERT] @
                dis @ map GSYM dis)) THEN
  REPEAT CONJ_TAC THEN TRY (FIRST_ASSUM ACCEPT_TAC) THEN
  (* the two heaps of the store *)
  W(fun (asl,gl) ->
    let flk n = grab asl (fun th ->
      try hd_is "FLOOKUP" (lhs (concl th)) &&
          fst (dest_const (rand (lhs (concl th)))) = n
      with Failure _ -> false) in
    MAP_EVERY EXISTS_TAC
      [rand (rand (rhs (concl (flk "CurrHeap"))));
       rand (rand (rhs (concl (flk "OtherHeap"))))]) THEN
  REPEAT CONJ_TAC THEN TRY (FIRST_ASSUM ACCEPT_TAC) THEN
  TRY (wordeq THEN NO_TAC) THEN
  TRY (numeq THEN NO_TAC) THEN
  (* the heap with the new element, which the store wrote *)
  FIRST_ASSUM (fun h2 ->
    if not (try is_eq (concl h2) && hd_is "APPEND" (lhs (concl h2)) &&
                is_var (rhs (concl h2))
            with Failure _ -> false) then fail() else
    SUBST1_TAC (SYM h2)) THEN
  REWRITE_TAC[word_heap_APPEND; word_heap_heap_expand;
              word_heap_def; heap_length_APPEND;
              heap_length_heap_expand] THEN
  REWRITE_TAC[word_el_def] THEN
  CONV_TAC (TOP_DEPTH_CONV let_CONV) THEN
  REWRITE_TAC[word_payload_def] THEN
  CONV_TAC (TOP_DEPTH_CONV let_CONV) THEN
  REWRITE_TAC[word_list_def; LENGTH_MAP; el_length_def;
              heap_length_NIL; STAR_ASSOC; emp_STAR; STAR_emp] THEN
  (* the words of the element are the roots of the values, and its
     header is the one that encode_header gave *)
  W(fun (asl,gl) ->
    let les = mapfilter (fun (_,th) ->
      if (try is_eq (concl th) &&
              hd_is "LENGTH" (lhs (concl th)) &&
              hd_is "LENGTH" (rhs (concl th))
          with Failure _ -> false) then th else fail()) asl in
    REWRITE_TAC les) THEN
  (* the condition of the payload, which the header's length says *)
  W(fun (asl,gl) ->
    let pred = rator gl in
    let fs = facs pred in
    let cell = find (hd_is "cond") fs in
    let rest = filter (fun t -> not (t = cell)) fs in
    let st = fst(strip_comb pred) in
    let mk a b = mk_comb(mk_comb(st,a),b) in
    SUBGOAL_THEN (mk_eq (pred, mk cell (end_itlist mk rest)))
      SUBST1_TAC THENL
     [REWRITE_TAC[STAR_AC; emp_STAR; STAR_emp]; ALL_TAC]) THEN
  REWRITE_TAC[cond_STAR] THEN
  CONJ_TAC THENL
   [(* the length of the words, which the header of the bytes
        says, and the bound of the count that it asks for *)
    REWRITE_TAC[LENGTH_write_bytes; LENGTH_REPLICATE] THEN
    W(fun (asl,gl) ->
      let gd = grab asl (fun th ->
        hd_is "good_dimindex" (concl th)) in
      let ls7 = grab asl (fun th ->
        try hd_is "<" (concl th) && hd_is "+" (lhand (concl th)) &&
            hd_is "data_to_word_config_len_size"
              (lhand (lhand (concl th)))
        with Failure _ -> false) in
      let bls = grab asl (fun th ->
        try hd_is "<" (concl th) &&
            hd_is "byte_len" (lhand (concl th)) &&
            hd_is "EXP" (rand (concl th)) &&
            hd_is "data_to_word_config_len_size"
              (rand (rand (concl th)))
        with Failure _ -> false) in
      let kbt = last (conjuncts gl) in
      let kb = MP (prove (mk_imp (mk_conj (concl gd, concl bls),
                    kbt),
                  REWRITE_TAC[good_dimindex_def; byte_len_def] THEN
                  DISCH_THEN (fun th ->
                    MP_TAC (CONJUNCT2 th) THEN
                    DISJ_CASES_THEN SUBST_ALL_TAC
                      (CONJUNCT1 th)) THEN
                  CONV_TAC NUM_REDUCE_CONV THEN
                  REWRITE_TAC[EXP_ADD] THEN
                  CONV_TAC NUM_REDUCE_CONV THEN
                  MP_TAC (SPEC (rand (lhand (concl bls)))
                    (MATCH_MP DIVISION (ARITH_RULE `~(4 = 0)`))) THEN
                  MP_TAC (SPEC (rand (lhand (concl bls)))
                    (MATCH_MP DIVISION (ARITH_RULE `~(8 = 0)`))) THEN
                  ARITH_TAC)) (CONJ gd bls) in
      let dl = MATCH_MP decode_length_byte_header
                 (CONJ gd (CONJ ls7
                    (REWRITE_RULE[GSYM word_shift_def] kb))) in
      REWRITE_TAC[dl; kb]) THEN
    ASM_REWRITE_TAC[];
    ALL_TAC] THEN
  (* and the words at the address the store wrote them to *)
  W(fun (asl,gl) ->
    let iscell t = hd_is "misc_word_list" t &&
                   hd_is "CONS" (el 1 (snd(strip_comb t))) in
    let sl = grab asl (fun th ->
      try hd_is "STAR" (rator (concl th)) &&
          exists iscell (facs (rator (concl th)))
      with Failure _ -> false) in
    let bnd = REWRITE_RULE[LENGTH; ADD1; LENGTH_MAP;
                LENGTH_write_bytes; LENGTH_REPLICATE]
                (grab asl (fun th ->
      try hd_is "<=" (concl th) &&
          hd_is "LENGTH" (lhand (concl th))
      with Failure _ -> false)) in
    let arith = MATCH_MP (ARITH_RULE
                  `!l s:num. l <= s ==> l + (s - l) = s`) bnd in
    let sl2 = REWRITE_RULE[LENGTH; ADD1; LENGTH_MAP;
                LENGTH_write_bytes; LENGTH_REPLICATE; word_list_def;
                word_heap_heap_expand; STAR_ASSOC; emp_STAR;
                STAR_emp; addsum] sl in
    REWRITE_TAC[heap_length_CONS; heap_length_NIL; el_length_def;
                ARITH_RULE `!n:num. n + 0 = n`; addsum;
                arith] THEN
    W(fun (asl2,gl2) ->
      say ("  GOALP " ^ string_of_term (rator gl2) ^ "\n");
      say ("  SEPP " ^ string_of_term (rator (concl sl2)) ^ "\n");
      let eq = prove (mk_eq (rator gl2, rator (concl sl2)),
                REWRITE_TAC[STAR_AC; emp_STAR; STAR_emp]) in
      ACCEPT_TAC (REWRITE_RULE[GSYM eq] sl2)))))
### memory_rel_RefByte_alt
(* a new byte array of the same byte over and over: the words that
   the statement writes are the array written into as many words
   of zero (the local lemma, from write_bytes_REPLICATE for the
   words before the last and
   last_bytes_bytes_to_word_REPLICATE for the bytes that are left
   in the last one), and from there the proof is the one of
   memory_rel_RefByte_content -- new_byte_alt_thm writes the
   element Bytes into the unused space of the heap and gives the
   invariant with the array in the references,
   heap_store_unused_alt splits the space (heap_lookup_SPLIT,
   heap_store_lemma), word_list_exists_ADD cuts the words of the
   element off the front of it, store_list_thm writes them there,
   the condition of the payload is what decode_length reads off
   the header (decode_length_byte_header) and the pointer is
   make_ptr of the offset of the address *)
  ((let hd_is n t =
     (try fst(dest_const(fst(strip_comb t))) = n
      with Failure _ -> false) in
  let rec facs t =
    if hd_is "STAR" t then
      let args = snd(strip_comb t) in
      facs (el 0 args) @ facs (el 1 args)
    else [t] in
  let grab asl p =
    tryfind (fun (_,th) ->
      if (try p th with Failure _ -> false) then th else fail())
      asl in
  let front sp cell =
    let pred = rator (concl sp) in
    let fs = facs pred in
    let rest = filter (fun t -> not (t = cell)) fs in
    let st = fst(strip_comb pred) in
    let mk x y = mk_comb(mk_comb(st,x),y) in
    let target = mk cell (end_itlist mk rest) in
    let eq = prove (mk_eq (pred,target),
              REWRITE_TAC[STAR_AC; emp_STAR; STAR_emp]) in
    REWRITE_RULE[eq] sp in
  let drop0 = prove
   (`!l:A list. DROP 0 l = l`,
    LIST_INDUCT_TAC THEN REWRITE_TAC[DROP]) in

  let drop_rep = prove
   (`!k m (x:A). DROP k (REPLICATE m x) = REPLICATE (m - k) x`,
    INDUCT_TAC THENL
     [REWRITE_TAC[drop0; SUB_0];
      REPEAT GEN_TAC THEN
      STRUCT_CASES_TAC(ISPEC `m:num` num_CASES) THEN
      ASM_REWRITE_TAC[REPLICATE; DROP; NOT_SUC; SUC_SUB1; SUB_0;
                      SUB_SUC; ARITH_RULE `0 - SUC k = 0`]]) in

  (* a list of one more of the same, the list and the one *)
  let rep_add = prove
   (`!a b (x:A).
        REPLICATE (a + b) x = REPLICATE a x ++ REPLICATE b x`,
    INDUCT_TAC THEN
    ASM_REWRITE_TAC[REPLICATE; APPEND; ADD_CLAUSES]) in

  let rep_add1 = prove
   (`!n (x:A). REPLICATE (n + 1) x = REPLICATE n x ++ [x]`,
    REWRITE_TAC[rep_add; ONE; REPLICATE; APPEND]) in

  let map_rep = prove
   (`!n (x:A) (f:A->B). MAP f (REPLICATE n x) = REPLICATE n (f x)`,
    INDUCT_TAC THEN ASM_REWRITE_TAC[REPLICATE; MAP]) in

  (* the bytes of a word, of which there are some *)
  let dpos = prove
   (`good_dimindex (:'a) ==> ~(dimindex (:'a) DIV 8 = 0)`,
    REWRITE_TAC[good_dimindex_def] THEN STRIP_TAC THEN
    ASM_REWRITE_TAC[] THEN CONV_TAC NUM_REDUCE_CONV) in

  (* and the words that the bytes of an array take *)
  let blen = prove
   (`good_dimindex (:'a)
     ==> !n. byte_len (:'a) n = n DIV (dimindex (:'a) DIV 8) + 1`,
    REWRITE_TAC[good_dimindex_def; byte_len_def] THEN STRIP_TAC THEN
    ASM_REWRITE_TAC[] THEN CONV_TAC NUM_REDUCE_CONV) in

  (* the words of the statement, which are a replicated word with
     the bytes of the last one written into it, are the bytes of the
     array written into as many words of zero: the words before the
     last hold the byte over and over (write_bytes_REPLICATE, and
     write_bytes_change_extra because what the word was does not
     matter while there are bytes left), and the last one holds the
     bytes that are left, which is what last_bytes writes
     (last_bytes_bytes_to_word_REPLICATE) *)
  let wseq = prove
   (cake_as_vars (fun () ->
      `good_dimindex (:'a)
     ==> LUPDATE (wordLang_Word
                    (last_bytes (n MOD (dimindex (:'a) DIV 8))
                       (w:(8)word) ((n2w 0):'a word)
                       ((n2w 0):'a word) be))
           (byte_len (:'a) n - 1)
           (REPLICATE (byte_len (:'a) n)
              (wordLang_Word
                 (word_of_byte ((w2w (w:(8)word)):'a word)))) =
         MAP wordLang_Word
           (write_bytes (REPLICATE n (w:(8)word))
              (REPLICATE (byte_len (:'a) n) ((n2w 0):'a word)) be)`),
    DISCH_TAC THEN
    FIRST_ASSUM (fun gd -> REWRITE_TAC[MATCH_MP blen gd]) THEN
    REWRITE_TAC[ARITH_RULE `!k:num. (k + 1) - 1 = k`] THEN
    REWRITE_TAC[rep_add1; write_bytes_APPEND; MAP_APPEND;
                LUPDATE_APPEND; LENGTH_REPLICATE; LT_REFL; SUB_REFL;
                LUPDATE] THEN
    BINOP_TAC THENL
     [(* the words before the last hold the byte over and over *)
      W(fun (asl,gl) ->
        let gd = tryfind (fun (_,th) ->
          if hd_is "good_dimindex" (concl th) then th else fail())
          asl in
        let args = snd (strip_comb (rand (rhs gl))) in
        let bs = el 0 args and ws = el 1 args and bb = el 2 args in
        let ws' = mk_comb (rator ws, rand (rand (lhs gl))) in
        let ce = SPECL [ws; bs; bb; ws'] write_bytes_change_extra in
        let hyp = MP (prove (mk_imp (concl gd, lhand (concl ce)),
                       DISCH_THEN (fun g ->
                         REWRITE_TAC[g; LENGTH_REPLICATE;
                                     MATCH_MP blen g]) THEN
                       ARITH_TAC)) gd in
        let wbr = MP (SPECL [rand (rator ws); rand (rator bs)]
                        write_bytes_REPLICATE) gd in
        REWRITE_TAC[MP ce hyp; wbr; map_rep]);
      (* and the last one holds the bytes that are left *)
      REWRITE_TAC[drop_rep; write_bytes_def] THEN
      CONV_TAC (TOP_DEPTH_CONV let_CONV) THEN
      W(fun (asl,gl) ->
        let gd = tryfind (fun (_,th) ->
          if hd_is "good_dimindex" (concl th) then th else fail())
          asl in
        let btw = find_term (hd_is "bytes_to_word") gl in
        let bargs = snd (strip_comb btw) in
        let rr = el 2 bargs in
        let byte = rand rr in
        let lbt = find_term (hd_is "last_bytes") gl in
        let lb = SPECL [el 0 (snd (strip_comb lbt));
                        rand (rator rr); el 0 bargs; el 1 bargs;
                        el 3 bargs]
                   (INST [byte,mk_var("b1",type_of byte);
                          byte,mk_var("b2",type_of byte)]
                      last_bytes_bytes_to_word_REPLICATE) in
        let cnd = MP (prove (mk_imp (concl gd, lhand (concl lb)),
                       DISCH_THEN (fun g ->
                         MP_TAC (SPEC (lhand (el 0 (snd (strip_comb
                                   lbt))))
                           (MATCH_MP DIVISION (MATCH_MP dpos g)))) THEN
                       ARITH_TAC)) gd in
        REWRITE_TAC[MP lb cnd; MAP])]) in
  (* two steps of an address in one *)
  let addsum = prove
   (`!(a:'a word) x y.
       a + bytes_in_word * n2w x + bytes_in_word * n2w y =
       a + bytes_in_word * n2w (x + y)`,
    REWRITE_TAC[WORD_ADD] THEN CONV_TAC WORD_RULE) in
  (* the bits of a zero word are zero *)
  let bits0 = prove
   (`!h l. word_bits h l ((n2w 0):(N)word) = n2w 0`,
    REWRITE_TAC[word_bits; WORD_EQ_BITS_ALT; BIT_WORD_SUBWORD;
                BIT_WORD_0] THEN
    CONV_TAC TAUT) in
  (* the numeric facts that the assumptions give *)
  let numfacts asl =
    mapfilter (fun (_,th) ->
      let c = concl th in
      if (try hd_is "<=" c || hd_is "<" c ||
              (is_eq c && hd_is "LENGTH" (lhs c) &&
               hd_is "LENGTH" (rhs c))
          with Failure _ -> false) then th else fail()) asl in
  let addreq asl t1 t2 =
      let fs = numfacts asl in
      let extra = (try
        let lt = grab asl (fun th ->
          try hd_is "<" (concl th) &&
              hd_is "LENGTH" (lhand (concl th))
          with Failure _ -> false) in
        let spe = grab asl (fun th ->
          try hd_is "<=" (concl th) && is_var (lhand (concl th)) &&
              is_var (rand (concl th))
          with Failure _ -> false) in
        [MATCH_MP (ARITH_RULE
           `!a b c:num. a < b /\ b <= c ==> a + 1 <= c`)
           (CONJ lt spe)]
        with Failure _ -> []) in
      let cnd = end_itlist CONJ (fs @ extra) in
      MP (prove (mk_imp (concl cnd, mk_eq (t1,t2)),
            DISCH_THEN (REPEAT_TCL CONJUNCTS_THEN
              (fun th -> ASSUME_TAC
                 (REWRITE_RULE[LENGTH; ADD1] th))) THEN
            ASM_REWRITE_TAC[el_length_def; LENGTH; LENGTH_MAP;
                            LENGTH_write_bytes;
                            LENGTH_REPLICATE; ADD1] THEN
            REWRITE_TAC[WORD_SUB; WORD_ADD] THEN
            ASM_SIMP_TAC[ARITH_RULE
              `!l s h:num. l <= s ==> l <= h + s`;
              ARITH_RULE
              `!a b c:num. a <= b /\ b <= c ==> a <= c`] THEN
            CONV_TAC WORD_RULE)) cnd in
  let wordeq =
    W(fun (asl,gl) ->
      REWRITE_TAC[addreq asl (rand (rand (lhs gl)))
                    (rand (rand (rhs gl)))]) in
  (* a store that says the same of a key, with the numbers of the
     new element in place of the old ones *)
  let numeq =
    W(fun (asl,gl) ->
      let fl = grab asl (fun th ->
        try hd_is "FLOOKUP" (lhs (concl th)) &&
            rand (lhs (concl th)) = rand (lhs gl) &&
            not (concl th = gl)
        with Failure _ -> false) in
      let isn t = (try hd_is "word" t &&
                       type_of (rand t) = `:num` &&
                       not (is_numeral (rand t))
                   with Failure _ -> false) in
      let ge = find_term isn (rhs gl) in
      let fe = find_term isn (rhs (concl fl)) in
      let fs = numfacts asl in
      let cnd = end_itlist CONJ fs in
      let eq = MP (prove (mk_imp (concl cnd,
                    mk_eq (rand ge, rand fe)),
                  DISCH_THEN (REPEAT_TCL CONJUNCTS_THEN
                    ASSUME_TAC) THEN
                  REWRITE_TAC[el_length_def; LENGTH; LENGTH_MAP;
                              LENGTH_write_bytes;
                              LENGTH_REPLICATE; ADD1] THEN
                  ASM_ARITH_TAC)) cnd in
      REWRITE_TAC[eq] THEN FIRST_ASSUM ACCEPT_TAC) in
  CONV_TAC (TOP_DEPTH_CONV let_CONV) THEN
  DISCH_THEN (REPEAT_TCL CONJUNCTS_THEN ASSUME_TAC) THEN
  (* the words of the statement are the bytes of the array
     written into as many words of zero *)
  FIRST_ASSUM (fun gd ->
    if not (hd_is "good_dimindex" (concl gd)) then fail() else
    REWRITE_TAC[MATCH_MP wseq gd]) THEN
  (* the count of the bytes is the length of the list *)
  TRY (FIRST_X_ASSUM (fun e ->
    if not (try is_eq (concl e) && is_var (lhs (concl e)) &&
                hd_is "LENGTH" (rhs (concl e))
            with Failure _ -> false) then fail() else
    SUBST_ALL_TAC e)) THEN
  (* what the invariant says of the stack *)
  FIRST_ASSUM (fun mr ->
    if hd_is "memory_rel" (concl mr)
    then MP_TAC (REWRITE_RULE[memory_rel_def; word_ml_inv_def] mr)
    else fail()) THEN
  DISCH_THEN STRIP_ASSUME_TAC THEN
  (* the element that holds the bytes *)
  W(fun (asl,gl) ->
    let ai = grab asl (fun th -> hd_is "abs_ml_inv" (concl th)) in
    let lt = grab asl (fun th ->
      try hd_is "<" (concl th) &&
          hd_is "byte_len" (lhand (concl th)) &&
          is_var (rand (concl th))
      with Failure _ -> false) in
    let spe = grab asl (fun th ->
      try hd_is "<=" (concl th) &&
          lhand (concl th) = rand (concl lt)
      with Failure _ -> false) in
    let gd = grab asl (fun th ->
      hd_is "good_dimindex" (concl th)) in
    let nd = grab asl (fun th ->
      try hd_is "IN" (dest_neg (concl th))
      with Failure _ -> false) in
    let bl = lhand (concl lt) in
    let nb = mk_icomb (`LENGTH`,
               find_term (fun t ->
                 hd_is "REPLICATE" t &&
                 type_of (rand t) = `:(8)word`) gl) in
    let bnd = MATCH_MP (ARITH_RULE
                `!b c d:num. b < c /\ c <= d ==> b + 1 <= d`)
                (CONJ lt spe) in
    let abb = MP (prove (mk_imp (concl gd,
                  mk_comb (`Abbrev`, mk_eq (bl,
                    mk_binop `(+):num->num->num`
                      (mk_binop `(DIV):num->num->num` nb
                         (mk_binop `(DIV):num->num->num`
                            (mk_icomb (`dimindex`,
                               rand (concl gd))) `8`))
                      `1`))),
                REWRITE_TAC[abbrev_def; byte_len_def;
                            LENGTH_REPLICATE;
                            good_dimindex_def] THEN
                STRIP_TAC THEN ASM_REWRITE_TAC[] THEN
                CONV_TAC NUM_REDUCE_CONV)) gd in
    let bv = find (fun v -> fst (dest_var v) = "b")
               (frees (concl new_byte_alt_thm)) in
    let flt = el 1 (snd(strip_comb (find_term
                (hd_is "make_byte_header") gl))) in
    let nba = INST [`T`,bv] new_byte_alt_thm in
    MP_TAC (SPEC flt (MATCH_MP (GEN_ALL nba)
      (CONJ ai (CONJ abb (CONJ nd bnd)))))) THEN
  DISCH_THEN STRIP_ASSUME_TAC THEN
  (* the element holds the bytes written into its words *)
  RULE_ASSUM_TRY (REWRITE_RULE[bytes_def]) THEN
  RULE_ASSUM_TRY (CONV_RULE (TOP_DEPTH_CONV let_CONV)) THEN
  REWRITE_TAC[bytes_def] THEN
  CONV_TAC (TOP_DEPTH_CONV let_CONV) THEN
  RULE_ASSUM_TRY (REWRITE_RULE[LENGTH_write_bytes;
                               LENGTH_REPLICATE]) THEN
  REWRITE_TAC[LENGTH_write_bytes; LENGTH_REPLICATE] THEN
  (* the ends of the heap that the store holds *)
  FIRST_ASSUM (fun hs ->
    if hd_is "heap_in_memory_store" (concl hs)
    then STRIP_ASSUME_TAC
           (REWRITE_RULE[heap_in_memory_store_def] hs)
    else fail()) THEN
  (* the unused space of the heap, where the element goes *)
  FIRST_ASSUM (fun hu ->
    if not (try hd_is "heap_store_unused_alt" (lhs (concl hu))
            with Failure _ -> false) then fail() else
    MP_TAC (REWRITE_RULE[heap_store_unused_alt_def] hu)) THEN
  COND_CASES_TAC THEN REWRITE_TAC[PAIR_EQ] THEN
  DISCH_THEN STRIP_ASSUME_TAC THEN
  FIRST_X_ASSUM (fun cnd ->
    if not (is_conj (concl cnd)) then fail() else
    if not (try hd_is "heap_lookup" (lhs (lhand (concl cnd)))
            with Failure _ -> false) then fail() else
    STRIP_ASSUME_TAC cnd) THEN
  (* so the heap splits there *)
  FIRST_ASSUM (fun hl ->
    if not (try hd_is "heap_lookup" (lhs (concl hl))
            with Failure _ -> false) then fail() else
    STRIP_ASSUME_TAC (MATCH_MP heap_lookup_SPLIT hl)) THEN
  REPEAT (FIRST_X_ASSUM (fun e ->
    if not (try is_eq (concl e) && is_var (lhs (concl e)) &&
                (hd_is "APPEND" (rhs (concl e)) ||
                 hd_is "heap_length" (rhs (concl e)))
            with Failure _ -> false) then fail() else
    SUBST_ALL_TAC e)) THEN
  (* and the store writes the element at the end of the space *)
  FIRST_ASSUM (fun hs ->
    if not (try hd_is "heap_store" (lhs (concl hs))
            with Failure _ -> false) then fail() else
    MP_TAC (REWRITE_RULE[heap_store_lemma; PAIR_EQ] hs)) THEN
  DISCH_THEN STRIP_ASSUME_TAC THEN
  (* the words of the unused space, and its end where the element
     goes *)
  W(fun (asl,gl) ->
    let bnd = grab asl (fun th ->
      try hd_is "<=" (concl th) &&
          hd_is "el_length" (lhand (concl th))
      with Failure _ -> false) in
    let e1 = CONV_RULE NUM_REDUCE_CONV
               (REWRITE_RULE[el_length_def] bnd) in
    let eq1 = MATCH_MP (ARITH_RULE
                `!k s:num. k + 1 <= s ==> (s - 1) + 1 = s`) e1 in
    let eq3 = MATCH_MP (ARITH_RULE
                `!k s:num. k + 1 <= s
                           ==> (k + 1) + (s - (k + 1)) = s`) e1 in
    let sep = grab asl (fun th ->
      try hd_is "STAR" (rator (concl th))
      with Failure _ -> false) in
    let sep1 = REWRITE_RULE[word_heap_APPEND; word_heap_def;
                 word_el_def; el_length_def; eq1] sep in
    let addr = el 0 (snd(strip_comb (find (fun t ->
                 hd_is "word_list_exists" t)
                 (facs (rator (concl sep1)))))) in
    let wle = REWRITE_RULE[eq3]
                (ISPECL [lhand (lhs (concl eq3));
                         rand (lhs (concl eq3)); addr]
                   word_list_exists_ADD) in
    let sep2 = REWRITE_RULE[wle; STAR_ASSOC] sep1 in
    ASSUME_TAC sep2) THEN
  (* the words of the element are as many as its roots, and its
     address is the end of the heap less them *)
  W(fun (asl,gl) ->
    let sep = grab asl (fun th ->
      try hd_is "STAR" (rator (concl th)) &&
          length (filter (hd_is "word_list_exists")
                   (facs (rator (concl th)))) = 2
      with Failure _ -> false) in
    let bnd = grab asl (fun th ->
      try hd_is "<=" (concl th) &&
          hd_is "el_length" (lhand (concl th))
      with Failure _ -> false) in
    let e1 = CONV_RULE NUM_REDUCE_CONV
               (REWRITE_RULE[el_length_def] bnd) in
    let cells = filter (hd_is "word_list_exists")
                  (facs (rator (concl sep))) in
    let count = el 1 (snd(strip_comb (el 0 cells))) in
    let xs = el 1 (snd(strip_comb (find_term
               (hd_is "data_to_word_memoryProof_store_list") gl))) in
    let lenq = prove (mk_eq (count, mk_icomb (`LENGTH`,xs)),
                REWRITE_TAC[LENGTH; LENGTH_MAP;
                            LENGTH_write_bytes;
                            LENGTH_REPLICATE] THEN
                ARITH_TAC) in
    let sep4 = REWRITE_RULE[lenq] sep in
    let bnd2 = REWRITE_RULE[lenq] e1 in
    ASSUME_TAC sep4 THEN ASSUME_TAC bnd2 THEN
    REWRITE_TAC[lenq]) THEN
  (* which the store writes there *)
  W(fun (asl,gl) ->
    let iscell t = hd_is "word_list_exists" t &&
                   hd_is "LENGTH" (el 1 (snd(strip_comb t))) in
    let sep = grab asl (fun th ->
      try hd_is "STAR" (rator (concl th)) &&
          exists iscell (facs (rator (concl th)))
      with Failure _ -> false) in
    let cell = find iscell (facs (rator (concl sep))) in
    STRIP_ASSUME_TAC (MATCH_MP store_list_thm (front sep cell))) THEN
  (* the ends of the heap, and the memory that the store wrote *)
  W(fun (asl,gl) ->
    let flk n = grab asl (fun th ->
      try hd_is "FLOOKUP" (lhs (concl th)) &&
          fst (dest_const (rand (lhs (concl th)))) = n
      with Failure _ -> false) in
    let sl = grab asl (fun th ->
      try hd_is "data_to_word_memoryProof_store_list"
            (lhs (concl th))
      with Failure _ -> false) in
    MAP_EVERY EXISTS_TAC
      [rand (rand (rhs (concl (flk "NextFree"))));
       rand (rand (rhs (concl (flk "CurrHeap"))));
       rand (rhs (concl sl))]) THEN
  (* the address of the element is the end of the heap less the
     words it takes *)
  W(fun (asl,gl) ->
    let sl = find_term
               (hd_is "data_to_word_memoryProof_store_list") gl in
    let t1 = el 0 (snd(strip_comb sl)) in
    let iscell t = hd_is "misc_word_list" t &&
                   hd_is "CONS" (el 1 (snd(strip_comb t))) in
    let sep = grab asl (fun th ->
      try hd_is "STAR" (rator (concl th)) &&
          exists iscell (facs (rator (concl th)))
      with Failure _ -> false) in
    let t2 = el 0 (snd(strip_comb
               (find iscell (facs (rator (concl sep)))))) in
    let bnd = grab asl (fun th ->
      try hd_is "<=" (concl th) &&
          hd_is "LENGTH" (lhand (concl th))
      with Failure _ -> false) in
    let eq = MP (prove (mk_imp (concl bnd, mk_eq (t1,t2)),
                  DISCH_TAC THEN ASM_SIMP_TAC[WORD_SUB] THEN
                  REWRITE_TAC[WORD_ADD] THEN
                  CONV_TAC WORD_RULE)) bnd in
    REWRITE_TAC[eq]) THEN
  REPEAT CONJ_TAC THEN TRY (FIRST_ASSUM ACCEPT_TAC) THEN
  (* the invariant with the new element in the heap *)
  REWRITE_TAC[memory_rel_def] THEN
  W(fun (asl,gl) ->
    let ai = grab asl (fun th ->
      hd_is "abs_ml_inv" (concl th) &&
      (try hd_is "CONS" (el 1 (snd(strip_comb (concl th))))
       with Failure _ -> false)) in
    let args = snd(strip_comb (concl ai)) in
    let ps = tparts (el 3 args) in
    MAP_EVERY EXISTS_TAC
      [el 1 ps; el 4 args; el 3 ps; el 4 ps; el 5 ps; el 6 ps]) THEN
  REPEAT CONJ_TAC THENL
   [ALL_TAC;
    (* the roots: the pointer of the new reference and the rest *)
    REWRITE_TAC[word_ml_inv_def] THEN
    W(fun (asl,gl) ->
      let ai = grab asl (fun th ->
        hd_is "abs_ml_inv" (concl th) &&
        (try hd_is "CONS" (el 1 (snd(strip_comb (concl th))))
         with Failure _ -> false)) in
      EXISTS_TAC
        (el 0 (tparts (el 3 (snd(strip_comb (concl ai))))))) THEN
    REWRITE_TAC[MAP; FST; SND; ALL2] THEN
    CONV_TAC (TOP_DEPTH_CONV BETA_CONV) THEN
    REPEAT CONJ_TAC THEN TRY (FIRST_ASSUM ACCEPT_TAC) THEN
    (* the word of the pointer is the one make_ptr builds *)
    W(fun (asl,gl) ->
      let mp = rhs gl in
      let sub = el 1 (snd(strip_comb mp)) in
      let aterm = lhand sub in
      let bwterm = rand aterm in
      let pt = lhand (rand (lhs gl)) in
      let mulp = mk_comb (rator bwterm,
                   mk_comb (rator (rand bwterm), pt)) in
      SUBST1_TAC (addreq asl sub mulp)) THEN
    W(fun (asl,gl) ->
      let gd = grab asl (fun th ->
        hd_is "good_dimindex" (concl th)) in
      REWRITE_TAC(word_addr_clauses ()) THEN
      REWRITE_TAC[make_ptr_def; get_addr_def;
                  get_lowerbits_def] THEN
      MATCH_REDUCE_TAC THEN
      REWRITE_TAC[MATCH_MP bytes_in_word_mul_eq_shift gd;
                  WORD_SHL_COMPOSE; bits0] THEN
      ASM_SIMP_TAC[ARITH_RULE
        `!a b:num. a <= b ==> a + (b - a) = b`] THEN
      REWRITE_TAC[WORD_OR_0; WORD_ADD_0]);
    FIRST_ASSUM ACCEPT_TAC;
    W(fun (asl,gl) ->
      let spe = grab asl (fun th ->
        try hd_is "<=" (concl th) && is_var (lhand (concl th)) &&
            is_var (rand (concl th))
        with Failure _ -> false) in
      let les = mapfilter (fun (_,th) ->
        if (try is_eq (concl th) &&
                hd_is "LENGTH" (lhs (concl th)) &&
                hd_is "LENGTH" (rhs (concl th))
            with Failure _ -> false) then th else fail()) asl in
      MP_TAC (end_itlist CONJ (spe :: les))) THEN
    REWRITE_TAC[el_length_def; LENGTH; LENGTH_MAP;
                LENGTH_write_bytes; LENGTH_REPLICATE; ADD1] THEN
    ARITH_TAC] THEN
  (* the store of the new heap: its length is the old one *)
  REWRITE_TAC[heap_in_memory_store_def] THEN
  W(fun (asl,gl) ->
    let hu = grab asl (fun th ->
      try hd_is "heap_store_unused_alt" (lhs (concl th))
      with Failure _ -> false) in
    REWRITE_TAC[MATCH_MP heap_store_unused_alt_IMP_length hu]) THEN
  W(fun (asl,gl) ->
    let dis = CONJUNCTS (distinctness "store_name") in
    REWRITE_TAC([FLOOKUP_UPDATE; FDOM_FUPDATE; IN_INSERT] @
                dis @ map GSYM dis)) THEN
  REPEAT CONJ_TAC THEN TRY (FIRST_ASSUM ACCEPT_TAC) THEN
  (* the two heaps of the store *)
  W(fun (asl,gl) ->
    let flk n = grab asl (fun th ->
      try hd_is "FLOOKUP" (lhs (concl th)) &&
          fst (dest_const (rand (lhs (concl th)))) = n
      with Failure _ -> false) in
    MAP_EVERY EXISTS_TAC
      [rand (rand (rhs (concl (flk "CurrHeap"))));
       rand (rand (rhs (concl (flk "OtherHeap"))))]) THEN
  REPEAT CONJ_TAC THEN TRY (FIRST_ASSUM ACCEPT_TAC) THEN
  TRY (wordeq THEN NO_TAC) THEN
  TRY (numeq THEN NO_TAC) THEN
  (* the heap with the new element, which the store wrote *)
  FIRST_ASSUM (fun h2 ->
    if not (try is_eq (concl h2) && hd_is "APPEND" (lhs (concl h2)) &&
                is_var (rhs (concl h2))
            with Failure _ -> false) then fail() else
    SUBST1_TAC (SYM h2)) THEN
  REWRITE_TAC[word_heap_APPEND; word_heap_heap_expand;
              word_heap_def; heap_length_APPEND;
              heap_length_heap_expand] THEN
  REWRITE_TAC[word_el_def] THEN
  CONV_TAC (TOP_DEPTH_CONV let_CONV) THEN
  REWRITE_TAC[word_payload_def] THEN
  CONV_TAC (TOP_DEPTH_CONV let_CONV) THEN
  REWRITE_TAC[word_list_def; LENGTH_MAP; el_length_def;
              heap_length_NIL; STAR_ASSOC; emp_STAR; STAR_emp] THEN
  (* the words of the element are the roots of the values, and its
     header is the one that encode_header gave *)
  W(fun (asl,gl) ->
    let les = mapfilter (fun (_,th) ->
      if (try is_eq (concl th) &&
              hd_is "LENGTH" (lhs (concl th)) &&
              hd_is "LENGTH" (rhs (concl th))
          with Failure _ -> false) then th else fail()) asl in
    REWRITE_TAC les) THEN
  (* the condition of the payload, which the header's length says *)
  W(fun (asl,gl) ->
    let pred = rator gl in
    let fs = facs pred in
    let cell = find (hd_is "cond") fs in
    let rest = filter (fun t -> not (t = cell)) fs in
    let st = fst(strip_comb pred) in
    let mk a b = mk_comb(mk_comb(st,a),b) in
    SUBGOAL_THEN (mk_eq (pred, mk cell (end_itlist mk rest)))
      SUBST1_TAC THENL
     [REWRITE_TAC[STAR_AC; emp_STAR; STAR_emp]; ALL_TAC]) THEN
  REWRITE_TAC[cond_STAR] THEN
  CONJ_TAC THENL
   [(* the length of the words, which the header of the bytes
        says, and the bound of the count that it asks for *)
    REWRITE_TAC[LENGTH_write_bytes; LENGTH_REPLICATE] THEN
    W(fun (asl,gl) ->
      let gd = grab asl (fun th ->
        hd_is "good_dimindex" (concl th)) in
      let ls7 = grab asl (fun th ->
        try hd_is "<" (concl th) && hd_is "+" (lhand (concl th)) &&
            hd_is "data_to_word_config_len_size"
              (lhand (lhand (concl th)))
        with Failure _ -> false) in
      let bls = grab asl (fun th ->
        try hd_is "<" (concl th) &&
            hd_is "byte_len" (lhand (concl th)) &&
            hd_is "EXP" (rand (concl th)) &&
            hd_is "data_to_word_config_len_size"
              (rand (rand (concl th)))
        with Failure _ -> false) in
      let kbt = last (conjuncts gl) in
      let kb = MP (prove (mk_imp (mk_conj (concl gd, concl bls),
                    kbt),
                  REWRITE_TAC[good_dimindex_def; byte_len_def] THEN
                  DISCH_THEN (fun th ->
                    MP_TAC (CONJUNCT2 th) THEN
                    DISJ_CASES_THEN SUBST_ALL_TAC
                      (CONJUNCT1 th)) THEN
                  CONV_TAC NUM_REDUCE_CONV THEN
                  REWRITE_TAC[EXP_ADD] THEN
                  CONV_TAC NUM_REDUCE_CONV THEN
                  MP_TAC (SPEC (rand (lhand (concl bls)))
                    (MATCH_MP DIVISION (ARITH_RULE `~(4 = 0)`))) THEN
                  MP_TAC (SPEC (rand (lhand (concl bls)))
                    (MATCH_MP DIVISION (ARITH_RULE `~(8 = 0)`))) THEN
                  ARITH_TAC)) (CONJ gd bls) in
      let dl = MATCH_MP decode_length_byte_header
                 (CONJ gd (CONJ ls7
                    (REWRITE_RULE[GSYM word_shift_def] kb))) in
      REWRITE_TAC[dl; kb]) THEN
    ASM_REWRITE_TAC[];
    ALL_TAC] THEN
  (* and the words at the address the store wrote them to *)
  W(fun (asl,gl) ->
    let iscell t = hd_is "misc_word_list" t &&
                   hd_is "CONS" (el 1 (snd(strip_comb t))) in
    let sl = grab asl (fun th ->
      try hd_is "STAR" (rator (concl th)) &&
          exists iscell (facs (rator (concl th)))
      with Failure _ -> false) in
    let bnd = REWRITE_RULE[LENGTH; ADD1; LENGTH_MAP;
                LENGTH_write_bytes; LENGTH_REPLICATE]
                (grab asl (fun th ->
      try hd_is "<=" (concl th) &&
          hd_is "LENGTH" (lhand (concl th))
      with Failure _ -> false)) in
    let arith = MATCH_MP (ARITH_RULE
                  `!l s:num. l <= s ==> l + (s - l) = s`) bnd in
    let sl2 = REWRITE_RULE[LENGTH; ADD1; LENGTH_MAP;
                LENGTH_write_bytes; LENGTH_REPLICATE; word_list_def;
                word_heap_heap_expand; STAR_ASSOC; emp_STAR;
                STAR_emp; addsum] sl in
    REWRITE_TAC[heap_length_CONS; heap_length_NIL; el_length_def;
                ARITH_RULE `!n:num. n + 0 = n`; addsum;
                arith] THEN
    W(fun (asl2,gl2) ->
      say ("  GOALP " ^ string_of_term (rator gl2) ^ "\n");
      say ("  SEPP " ^ string_of_term (rator (concl sl2)) ^ "\n");
      let eq = prove (mk_eq (rator gl2, rator (concl sl2)),
                REWRITE_TAC[STAR_AC; emp_STAR; STAR_emp]) in
      ACCEPT_TAC (REWRITE_RULE[GSYM eq] sl2)))))
### memory_rel_FromList
  (* the attempt: the proof of the source names FLOOKUP,
     memory_rel_def, heap_in_memory_store_def,
     memory_rel_IMP_word_list_exists, memory_rel_Cons_alt.  What is
     here rewrites with them and closes by arithmetic, and the cheat
     is behind it until the proof is written.  A MESON over them is
     what the next round adds; it costs a load ten minutes to have
     it in every attempt and it closed none of them *)
  (ATTEMPT_TAC 2
    (REPEAT GEN_TAC THEN REPEAT STRIP_TAC THEN
     ASM_REWRITE_TAC[FLOOKUP; memory_rel_def;
       heap_in_memory_store_def; memory_rel_IMP_word_list_exists;
       memory_rel_Cons_alt] THEN
     TRY ASM_ARITH_TAC))
### memory_rel_Thunk_IMP
  (* the attempt: the proof of the source names memory_rel_def,
     word_ml_inv_def, abs_ml_inv_def, bc_stack_ref_inv_def,
     v_inv_def, word_addr_def.  What is here rewrites with them and
     closes by arithmetic, and the cheat is behind it until the
     proof is written.  A MESON over them is what the next round
     adds; it costs a load ten minutes to have it in every attempt
     and it closed none of them *)
  (ATTEMPT_TAC 2
    (REPEAT GEN_TAC THEN REPEAT STRIP_TAC THEN
     ASM_REWRITE_TAC[memory_rel_def; word_ml_inv_def;
       abs_ml_inv_def; bc_stack_ref_inv_def; v_inv_def;
       word_addr_def] THEN
     TRY ASM_ARITH_TAC))
### memory_rel_Thunk_inlined
(* the invariant of the source names memory_rel_Thunk_IMP for the
   first conjunct and the chain of the definitions of the invariant
   for the second.  Here the first is that lemma, whose other case
   has the value a word with its lowest bit set and the hypothesis
   says it has not; and the second is the invariant rebuilt on the
   same heap, the same roots and the same two maps, where the
   clause of v_inv that inlines the thunk gives the root of its
   value.  What the rebuilding leaves is that the timestamps and
   the blocks of the new stack are those of the old one and that a
   reference the value reaches was reached by the pointer *)
  ((* a RefPtr is not a Block, so it has no timestamps of its own *)
  let vats_refptr = prove
   (`!bl p. v_all_ts (RefPtr bl p:dataSem_v) = []`,
    REPEAT GEN_TAC THEN
    GEN_REWRITE_TAC LAND_CONV [v_all_ts_def] THEN
    MATCH_REDUCE_TAC THEN REWRITE_TAC[]) in
  let no_ts = prove
   (`!t bl p. ~MEM (t:num) (v_all_ts (RefPtr bl p:dataSem_v))`,
    REWRITE_TAC[vats_refptr; MEM]) in
  (* so a stack with a RefPtr in front has no more timestamps
     than the same stack with any other value in front *)
  let all_ts_sub = prove
   (`!refs bl p vs (y:dataSem_v).
       all_ts refs (CONS (RefPtr bl p) vs) SUBSET
       all_ts refs (CONS y vs)`,
    REPEAT GEN_TAC THEN REWRITE_TAC[all_ts_def] THEN
    CONV_TAC (TOP_DEPTH_CONV let_CONV) THEN
    REWRITE_TAC[SUBSET; IN_ELIM_THM; MEM] THEN
    MESON_TAC[no_ts]) in
  (* a reference that the value of a thunk reaches is one that the
     pointer to the thunk reaches, in one step of ref_edge more *)
  let reach_thunk = prove
   (`!refs p ev z vs n bl.
       lookup p refs = SOME (Thunk ev z) /\
       reachable_refs (CONS z vs) refs n ==>
       reachable_refs (CONS (RefPtr bl p:dataSem_v) vs) refs n`,
    REPEAT GEN_TAC THEN REWRITE_TAC[reachable_refs_def] THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC
      (REPEAT_TCL CHOOSE_THEN STRIP_ASSUME_TAC)) THEN
    FIRST_X_ASSUM (fun mm ->
      DISJ_CASES_THEN2 SUBST_ALL_TAC ASSUME_TAC
        (REWRITE_RULE[MEM] mm)) THENL
     [EXISTS_TAC `RefPtr bl p:dataSem_v` THEN
      EXISTS_TAC `p:num` THEN
      REWRITE_TAC[MEM; get_refs_def] THEN
      MATCH_MP_TAC (CONJUNCT2 (SPEC_ALL RTC_RULES)) THEN
      FIRST_ASSUM (fun rt ->
        if hd_is "RTC" (concl rt)
        then EXISTS_TAC (rand (rator (concl rt))) else fail()) THEN
      ASM_REWRITE_TAC[ref_edge_def] THEN MATCH_REDUCE_TAC THEN
      REWRITE_TAC[get_refs_def; MAP; FLAT; APPEND_NIL] THEN
      FIRST_ASSUM ACCEPT_TAC;
      ASM_REWRITE_TAC[MEM] THEN ASM_MESON_TAC[]]) in
  (* the thunk is evaluated: of the two cases of
     memory_rel_Thunk_IMP the one that does not say so has the
     value a word with its lowest bit set, and the hypothesis
     says it is a code pointer or has that bit clear *)
  let ev_tac =
    FIRST_ASSUM (fun mr -> FIRST_ASSUM (fun lk ->
      FIRST_ASSUM (fun gd ->
        DISJ_CASES_THEN STRIP_ASSUME_TAC
          (MATCH_MP memory_rel_Thunk_IMP
            (CONJ mr (CONJ lk gd)))))) THEN
    (FIRST_ASSUM ACCEPT_TAC ORELSE
     (REPEAT SUBST_LHS_TAC THEN
      RULE_ASSUM_TAC (REWRITE_RULE[distinctness "word_loc";
                                   injectivity "word_loc"]) THEN
      TRY (FIRST_X_ASSUM CONTR_TAC) THEN
      REPEAT SUBST_LHS_TAC THEN CONTRA_TAC)) in
  (* the conjuncts of the invariant that are what they were *)
  let close_tac =
    REPEAT CONJ_TAC THEN REWRITE_TAC[MAP] THEN
    TRY (FIRST_ASSUM ACCEPT_TAC) THEN
    TRY (REWRITE_TAC[MAP; ALL2] THEN ASM_REWRITE_TAC[] THEN
         NO_TAC) in
  (* the two maps of the invariant are the two of the clause of
     v_inv that the value of the thunk is related by *)
  let exists_f_tf =
    FIRST_ASSUM (fun vi ->
      let c = concl vi in
      if hd_is "v_inv" c then
        let tup = el 3 (snd (strip_comb c)) in
        let _,r1 = dest_pair tup in
        let f,r2 = dest_pair r1 in
        let tf,_ = dest_pair r2 in
        MAP_EVERY EXISTS_TAC [f; tf]
      else fail()) in
  (* the invariant with the value of the thunk in place of the
     pointer to it: the same heap, the same roots and the same
     two maps.  Of the three clauses of v_inv for a RefPtr the
     first says the reference is not a thunk, which the lookup
     denies, and the second has a ThunkBlock in the heap and the
     pointer to it for a root, whose word is odd (get_addr_0) and
     the hypothesis says the value is not; so the third is the
     one, and it gives the root of the value of the thunk *)
  let rebuild_tac =
    FIRST_X_ASSUM (fun mr ->
      if hd_is "memory_rel" (concl mr)
      then STRIP_ASSUME_TAC (REWRITE_RULE[memory_rel_def;
             word_ml_inv_def; abs_ml_inv_def;
             bc_stack_ref_inv_def] mr)
      else fail()) THEN
    SPLIT_ROOTS_TAC THEN
    V_INV_TAC v_inv_def THEN
    TRY (FIRST_X_ASSUM (fun eq ->
      if (try is_eq (concl eq) && is_var (rand (concl eq)) &&
              hd_is "get_addr" (lhs (concl eq))
          with Failure _ -> false)
      then SUBST_ALL_TAC (SYM eq) else fail())) THEN
    RULE_ASSUM_TRY (REWRITE_RULE[get_addr_0]) THEN
    TRY (FIRST_X_ASSUM CONTR_TAC) THEN
    TRY (FIRST_ASSUM (fun neg ->
      let nt = (try let _,bod = strip_forall (concl neg) in
                    is_neg bod && hd_is "sptree_lookup"
                      (lhs (dest_neg bod))
                with Failure _ -> false) in
      if nt then
        FIRST_ASSUM (fun lk ->
          if (try hd_is "sptree_lookup" (lhs (concl lk))
              with Failure _ -> false)
          then MP_TAC neg THEN
               REWRITE_TAC[lk; injectivity "option";
                           injectivity "bvlSem_ref"] THEN
               MESON_TAC[]
          else fail())
      else fail())) THEN
    TRY (FIRST_ASSUM (fun lk1 -> FIRST_ASSUM (fun lk2 ->
      if concl lk1 = concl lk2 then fail() else
      STRIP_ASSUME_TAC (REWRITE_RULE[injectivity "option";
                          injectivity "bvlSem_ref"]
                          (TRANS (SYM lk1) lk2))))) THEN
    REPEAT SUBST_LHS_TAC THEN
    REWRITE_TAC[memory_rel_def; word_ml_inv_def; abs_ml_inv_def;
                bc_stack_ref_inv_def] THEN
    ASM_EXISTS_TAC THEN close_tac THEN
    TRY ASM_EXISTS_TAC THEN close_tac THEN
    TRY exists_f_tf THEN close_tac THEN
    FIRST
     [(* the timestamps of the new stack are the old ones *)
      FIRST_ASSUM (fun sb ->
        if hd_is "SUBSET" (concl sb) &&
           hd_is "all_ts" (rand (concl sb))
        then MATCH_MP_TAC SUBSET_TRANS THEN
             EXISTS_TAC (rand (concl sb)) THEN
             CONJ_TAC THENL
              [ACCEPT_TAC sb; MATCH_ACCEPT_TAC all_ts_sub]
        else fail());
      (* and so are its blocks *)
      FIRST_ASSUM (fun lk -> FIRST_ASSUM (fun bu ->
        ACCEPT_TAC (MATCH_MP (GEN_ALL blocks_unique_Thunk)
                      (CONJ lk bu))));
      (* and a reference it reaches was reached before *)
      GEN_TAC THEN STRIP_TAC THEN FIRST_ASSUM MATCH_MP_TAC THEN
      CONJ_TAC THEN TRY (FIRST_ASSUM ACCEPT_TAC) THEN
      MATCH_MP_TAC reach_thunk THEN ASM_EXISTS_TAC THEN
      CONJ_TAC THEN FIRST_ASSUM ACCEPT_TAC] in
  STRIP_TAC THEN CONJ_TAC THENL
   [ev_tac; rebuild_tac; ev_tac; rebuild_tac])
### get_byte_bytes_to_word
  (* the source takes the list of bytes apart into the four or the
     eight bytes of a word.  Here one lemma does it for every
     length, by the induction of bytes_to_word over the list: the
     byte at the address of the first set_byte is the head of the
     list (good_dimindex_get_byte_set_byte), and a byte further on
     is the byte of the word that the rest of the list makes
     (get_byte_set_byte_alt, whose two addresses align to the same
     word by align_small).  The lemma is about the word at an
     offset, because that is what the recursive call of
     bytes_to_word is about *)
  (let aux = prove
    (`!ls n m i (t:'a word) be'.
        i < n /\ i < LENGTH ls /\ m + n <= dimindex (:'a) DIV 8 /\
        good_dimindex (:'a)
        ==> get_byte (n2w (m + i))
              (bytes_to_word n (n2w m) ls t be') be' = EL i ls`,
     LIST_INDUCT_TAC THENL
      [REPEAT GEN_TAC THEN REWRITE_TAC[LENGTH; CONJUNCT1 LT];
       ALL_TAC] THEN
     REPEAT GEN_TAC THEN
     STRUCT_CASES_TAC (SPEC `n:num` num_CASES) THENL
      [REWRITE_TAC[CONJUNCT1 LT]; ALL_TAC] THEN
     REWRITE_TAC[LENGTH] THEN
     STRUCT_CASES_TAC (SPEC `i:num` num_CASES) THENL
      [(* the byte that the first set_byte of the word sets *)
       REWRITE_TAC[ADD_CLAUSES; EL; HD] THEN
       STRIP_TAC THEN
       ONCE_REWRITE_TAC[bytes_to_word_def] THEN
       REWRITE_TAC[NOT_SUC; SUC_SUB1] THEN MATCH_REDUCE_TAC THEN
       FIRST_ASSUM (fun gd ->
         MATCH_ACCEPT_TAC (GEN_ALL
           (MATCH_MP good_dimindex_get_byte_set_byte gd)));
       (* or a byte further on, which the set_byte does not touch *)
       REWRITE_TAC[EL; TL] THEN
       STRIP_TAC THEN
       ONCE_REWRITE_TAC[bytes_to_word_def] THEN
       REWRITE_TAC[NOT_SUC; SUC_SUB1] THEN MATCH_REDUCE_TAC THEN
       (* both addresses are bytes of the same word *)
       W(fun (asl,w) ->
         let gb = find_term (hd_is "get_byte") w in
         let a1 = rand (el 0 (snd (strip_comb gb))) in
         let sb = find_term (hd_is "set_byte") w in
         let a2 = rand (el 0 (snd (strip_comb sb))) in
         let dd = find_term (hd_is "DIV")
                    (list_mk_conj (map (concl o snd) asl)) in
         MAP_EVERY (fun a ->
           SUBGOAL_THEN (mk_binop `(<):num->num->bool` a dd)
             ASSUME_TAC THENL [ASM_ARITH_TAC; ALL_TAC]) [a1; a2]) THEN
       MATCH_MP_TAC (GEN_ALL get_byte_set_byte_alt) THEN
       REPEAT CONJ_TAC THENL
        [FIRST_ASSUM ACCEPT_TAC;
         MATCH_MP_TAC ne_small THEN
         REPEAT CONJ_TAC THEN TRY (FIRST_ASSUM ACCEPT_TAC) THEN
         ASM_ARITH_TAC;
         ASM_SIMP_TAC[align_small];
         REWRITE_TAC[GSYM WORD_ADD] THEN
         ONCE_REWRITE_TAC[ARITH_RULE `m + SUC j = (m + 1) + j`] THEN
         FIRST_X_ASSUM MATCH_MP_TAC THEN
         REPEAT CONJ_TAC THEN TRY (FIRST_ASSUM ACCEPT_TAC) THEN
         ASM_ARITH_TAC]]) in
   REPEAT STRIP_TAC THEN
   W(fun (asl,w) ->
     let gargs = snd (strip_comb (lhs w)) in
     let i = rand (el 0 gargs) in
     let bargs = snd (strip_comb (el 1 gargs)) in
     MP_TAC (SPECL [el 2 bargs; el 0 bargs; `0`; i; el 3 bargs;
                    el 2 gargs] aux)) THEN
   REWRITE_TAC[ADD_CLAUSES] THEN
   DISCH_THEN MATCH_MP_TAC THEN
   REPEAT CONJ_TAC THEN TRY (FIRST_ASSUM ACCEPT_TAC) THEN
   ASM_ARITH_TAC)
### set_byte_bytes_to_word
  (* the source takes the list of bytes apart into the four or the
     eight bytes of a word and sorts the set_bytes of each case.
     Here one lemma does it for every length, by the induction of
     bytes_to_word over the list: the byte that the first set_byte
     of the word sets is the head, and a byte further on commutes
     with it (set_byte_sort), where the induction hypothesis sets it
     in the rest.  The lemma is about the word at an offset, because
     that is what the recursive call of bytes_to_word is about, and
     it is stated with the type variable of the statement, because
     SPECL instantiates the term variables of a theorem and not its
     types *)
  (let aux = prove
    (`!ls n m i b (t:'a word) be'.
        i < n /\ i < LENGTH ls /\ m + n <= dimindex (:'a) DIV 8 /\
        good_dimindex (:'a)
        ==> set_byte (n2w (m + i)) b
              (bytes_to_word n (n2w m) ls t be') be' =
            bytes_to_word n (n2w m) (LUPDATE b i ls) t be'`,
     LIST_INDUCT_TAC THENL
      [REPEAT GEN_TAC THEN REWRITE_TAC[LENGTH; CONJUNCT1 LT];
       ALL_TAC] THEN
     REPEAT GEN_TAC THEN
     STRUCT_CASES_TAC (SPEC `n:num` num_CASES) THENL
      [REWRITE_TAC[CONJUNCT1 LT]; ALL_TAC] THEN
     REWRITE_TAC[LENGTH] THEN
     STRUCT_CASES_TAC (SPEC `i:num` num_CASES) THENL
      [(* the byte that the first set_byte of the word sets *)
       REWRITE_TAC[ADD_CLAUSES; LUPDATE] THEN
       STRIP_TAC THEN
       ONCE_REWRITE_TAC[bytes_to_word_def] THEN
       REWRITE_TAC[NOT_SUC; SUC_SUB1] THEN MATCH_REDUCE_TAC THEN
       ONCE_REWRITE_TAC[GEN_ALL set_byte_sort] THEN
       REWRITE_TAC[];
       (* or a byte further on, where the two set_bytes commute *)
       REWRITE_TAC[LUPDATE; NOT_SUC; SUC_SUB1] THEN
       STRIP_TAC THEN
       ONCE_REWRITE_TAC[bytes_to_word_def] THEN
       REWRITE_TAC[NOT_SUC; SUC_SUB1] THEN MATCH_REDUCE_TAC THEN
       ONCE_REWRITE_TAC[GEN_ALL set_byte_sort] THEN
       COND_CASES_TAC THENL
        [SUBGOAL_THEN `F` CONTR_TAC THEN ASM_ARITH_TAC; ALL_TAC] THEN
       COND_CASES_TAC THENL
        [ALL_TAC;
         SUBGOAL_THEN `F` CONTR_TAC THEN
         FIRST_X_ASSUM MP_TAC THEN ASM_REWRITE_TAC[] THEN
         ASM_ARITH_TAC] THEN
       AP_THM_TAC THEN AP_TERM_TAC THEN
       REWRITE_TAC[GSYM WORD_ADD] THEN
       ONCE_REWRITE_TAC[ARITH_RULE `m + SUC j = (m + 1) + j`] THEN
       FIRST_X_ASSUM MATCH_MP_TAC THEN
       REPEAT CONJ_TAC THEN TRY (FIRST_ASSUM ACCEPT_TAC) THEN
       ASM_ARITH_TAC]) in
   REPEAT STRIP_TAC THEN
   W(fun (asl,w) ->
     let sargs = snd (strip_comb (lhs w)) in
     let i = rand (el 0 sargs) in
     let bb = el 1 sargs in
     let bargs = snd (strip_comb (el 2 sargs)) in
     MP_TAC (SPECL [el 2 bargs; el 0 bargs; `0`; i; bb; el 3 bargs;
                    el 3 sargs] aux)) THEN
   REWRITE_TAC[ADD_CLAUSES] THEN
   DISCH_THEN MATCH_MP_TAC THEN
   REPEAT CONJ_TAC THEN TRY (FIRST_ASSUM ACCEPT_TAC) THEN
   ASM_ARITH_TAC)
### heap_in_memory_store_UpdateByte
  (* the attempt: the proof of the source names
     heap_in_memory_store_def, heap_length_APPEND, byte_aligned_def,
     byte_align_def, align_def, bytes_in_word_def.  What is here
     rewrites with them and closes by arithmetic, and the cheat is
     behind it until the proof is written.  A MESON over them is
     what the next round adds; it costs a load ten minutes to have
     it in every attempt and it closed none of them *)
  (ATTEMPT_TAC 2
    (REPEAT GEN_TAC THEN REPEAT STRIP_TAC THEN
     ASM_REWRITE_TAC[heap_in_memory_store_def;
       heap_length_APPEND; byte_aligned_def; byte_align_def;
       align_def; bytes_in_word_def] THEN
     TRY ASM_ARITH_TAC))
### memory_rel_ByteArray_IMP
  (* the attempt: the proof of the source names hide_memory_rel_def,
     make_byte_header_def, memory_rel_def, word_ml_inv_def,
     bc_stack_ref_inv_def, v_inv_def.  What is here rewrites with
     them and closes by arithmetic, and the cheat is behind it until
     the proof is written.  A MESON over them is what the next round
     adds; it costs a load ten minutes to have it in every attempt
     and it closed none of them *)
  (ATTEMPT_TAC 2
    (REPEAT GEN_TAC THEN REPEAT STRIP_TAC THEN
     ASM_REWRITE_TAC[hide_memory_rel_def; make_byte_header_def;
       memory_rel_def; word_ml_inv_def; bc_stack_ref_inv_def;
       v_inv_def] THEN
     TRY ASM_ARITH_TAC))
### memory_rel_RefPtr_gen_IMP
(* the proof of the source takes the kind of the reference out of
   the lookup (memory_rel_RefPtr_IMP_lemma) and then has a case for
   each: an array of values has bit 3 of its header set and bit 2
   clear, an array of bytes the other way round, a MutBlock is the
   case the statement leaves trivial, and a thunk is the one real
   case.  For an evaluated one memory_rel_Thunk_IMP either says
   what the pattern wants or says that bit 5 of the header is set,
   which says it too (and60_ne24); for one that is not evaluated
   the first of its two cases says it is, so the second is the one *)
  ((* the lemma of a kind of reference, at this memory and this
     lookup *)
  let use_lemma th =
    FIRST_ASSUM (fun mr -> FIRST_ASSUM (fun lk ->
      FIRST_ASSUM (fun gd ->
        STRIP_ASSUME_TAC (MATCH_MP th (CONJ mr (CONJ lk gd)))))) in
  (* the word of the value, the address it points at and what the
     memory holds there, out of the assumptions *)
  let pick n =
    W(fun (asl,gw as gl) ->
      let vs = fst (strip_exists gw) in
      let wty = type_of (el 0 vs) in
      let mm = var_by_name "m" gl in
      let ad = rand (rand (concl (the_asm (fun c ->
                 try is_eq c && type_of (rand (rand c)) = wty &&
                     fst (dest_const (rator (rand c))) = "SOME"
                 with Failure _ -> false) gl))) in
      let xd = rand (rand (concl (the_asm (fun c ->
                 try is_eq c && rator (lhs c) = mm
                 with Failure _ -> false) gl))) in
      if n = 2 then MAP_EVERY EXISTS_TAC [ad; xd] else
      let vv = var_by_name "v" gl in
      let wd = rand (rand (concl (the_asm (fun c ->
                 try is_eq c && lhs c = vv
                 with Failure _ -> false) gl))) in
      MAP_EVERY EXISTS_TAC [wd; ad; xd]) in
  STRIP_TAC THEN
  FIRST_ASSUM (fun mr ->
    STRIP_ASSUME_TAC (MATCH_MP memory_rel_RefPtr_IMP_lemma mr)) THEN
  FIRST_ASSUM (fun lk ->
    EXISTS_TAC (rand (rand (concl lk)))) THEN
  ASM_REWRITE_TAC[] THEN
  W(fun gl -> CASES_ON_TAC (var_by_name "res" gl)) THEN
  TRY SAFE_MATCH_REDUCE_TAC THENL
   [(* an array of values: its header has bit 3 set and bit 2
        clear *)
    use_lemma memory_rel_ValueArray_IMP THEN pick 3 THEN
    ASM_REWRITE_TAC[];
    (* an array of bytes: the other way round *)
    use_lemma memory_rel_ByteArray_IMP THEN pick 3 THEN
    ASM_REWRITE_TAC[];
    (* a thunk, and the two modes of one *)
    W(fun gl -> CASES_ON_TAC (var_by_name "a0" gl)) THEN
    REWRITE_TAC[distinctness "thunk_mode"] THEN
    TRY SAFE_MATCH_REDUCE_TAC THENL
     [(* an evaluated thunk: the lemma either says what the
          pattern wants or says that bit 5 of the header is set,
          which says it too *)
      GEN_TAC THEN DISCH_TAC THEN
      use_lemma memory_rel_Thunk_IMP THENL
       [FIRST_ASSUM (fun h -> FIRST_ASSUM (fun th ->
          MP_TAC (MATCH_MP th h))) THEN
        STRIP_TAC THEN pick 2 THEN ASM_REWRITE_TAC[];
        FIRST_ASSUM (fun h ->
          let e0 = CONJUNCT1 h in
          FIRST_ASSUM (fun e1 ->
            if concl e1 = concl e0 then fail() else
            SUBST_ALL_TAC (REWRITE_RULE[injectivity "word_loc"]
              (TRANS (SYM e1) e0)))) THEN
        pick 2 THEN ASM_REWRITE_TAC[] THEN
        CONV_TAC NUM_REDUCE_CONV THEN
        MATCH_MP_TAC and60_ne24 THEN CONJ_TAC THENL
         [MATCH_MP_TAC dim5 THEN FIRST_ASSUM ACCEPT_TAC;
          ASM_REWRITE_TAC[]]];
      (* a thunk that is not evaluated: the first of the lemma's
         two cases says it is, so the second one is the one *)
      use_lemma memory_rel_Thunk_IMP THENL
       [RULE_ASSUM_TAC (REWRITE_RULE[distinctness "thunk_mode";
          GSYM (distinctness "thunk_mode")]) THEN
        FIRST_X_ASSUM CONTR_TAC;
        pick 3 THEN ASM_REWRITE_TAC[]]]])
### memory_rel_Number_bignum_IMP_ALT
(* the proof of the source is the template of
   memory_rel_ValueArray_IMP at a Bignum, and the three things it
   needs beyond it are above the statement: the payload has a first
   word (n2mw_cons, abs_nonzero), the header's bits come off
   make_header as they do there, and what the statement writes as
   an AND with a power of two is a bit of the header
   (and_pow2_zero).  The frame of the separating conjunction that
   the statement leaves existential is what is left of the heap
   when the word_list of the payload is taken out of it *)
  (let hd_is n t =
    (try fst(dest_const(fst(strip_comb t))) = n
     with Failure _ -> false) in
  let rec facs t =
    if hd_is "STAR" t then
      let args = snd(strip_comb t) in
      facs (el 0 args) @ facs (el 1 args)
    else [t] in
  let grab asl p =
    tryfind (fun (_,th) ->
      if (try p th with Failure _ -> false) then th else fail()) asl in
  let is_hl th = hd_is "heap_lookup" (lhs (concl th)) in
  let sepfront names =
    W(fun (asl,w) ->
      let pred = rator (lhand w) in
      let fs = facs pred in
      let picked = map (fun n -> find (hd_is n) fs) names in
      let rest = filter (fun t -> not (mem t picked)) fs in
      let st = fst(strip_comb pred) in
      let mk a b = mk_comb(mk_comb(st,a),b) in
      let target = itlist mk picked (end_itlist mk rest) in
      SUBGOAL_THEN (mk_eq(pred,target)) SUBST1_TAC THENL
       [REWRITE_TAC[STAR_AC]; ALL_TAC]) in
  MEMORY_REL_TAC THEN V_INV_TAC v_inv_def THEN
  FIRST_ASSUM(fun e ->
    let c = concl e in
    if is_eq c && is_var (rand c) && hd_is "wordLang_Word" (lhs c)
    then SUBST1_TAC (SYM e) else fail()) THEN
  REWRITE_TAC[injectivity "word_loc"] THEN
  CONV_TAC(REDEPTH_CONV UNWIND_CONV) THEN
  FIRST_X_ASSUM(fun th ->
    if hd_is "heap_in_memory_store" (concl th)
    then MP_TAC(REWRITE_RULE[heap_in_memory_store_def] th)
    else fail()) THEN
  STRIP_TAC THEN
  W(fun (asl,w) ->
    MP_TAC(MATCH_MP heap_lookup_SPLIT (grab asl is_hl))) THEN
  DISCH_THEN STRIP_ASSUME_TAC THEN
  VAR_EQ_TAC THEN
   W(fun (asl,w) ->
     let hl = grab asl is_hl in
     let hlen = grab asl (fun th ->
       hd_is "heap_length" (lhand (concl th))) in
     let cu = grab asl (fun th ->
       hd_is "FLOOKUP" (lhs (concl th)) &&
       fst(dest_const(rand(lhs(concl th)))) = "CurrHeap") in
     let gd = grab asl (fun th -> concl th = `good_dimindex (:'a)`) in
     let gat = tryfind (fun t ->
       find_term (fun u ->
         hd_is "get_addr" u && length (snd(strip_comb u)) = 3) t)
       (w :: map (fun (_,th) -> concl th) asl) in
     let th = SPEC (last (snd(strip_comb gat)))
       (GEN `w:('a)word_loc`
         (MATCH_MP get_real_addr_get_addr
           (CONJ hlen (CONJ hl (CONJ cu gd))))) in
     let r = rhs (concl (CONJUNCT1 th)) in
     let a = rand r in
     let args = snd(strip_comb (rand a)) in
     let mul = fst(strip_comb (rand a)) in
     let swap = mk_comb(rator a,
                  mk_comb(mk_comb(mul,el 1 args),el 0 args)) in
     let sw = WORD_RULE (mk_eq(a,swap)) in
     STRIP_ASSUME_TAC(REWRITE_RULE[sw] th)) THEN
  (* the payload of the bignum has a first word *)
  W(fun gl ->
    let gd = the_asm (fun c -> c = `good_dimindex (:'a)`) gl in
    let si = the_asm (fun c ->
               try is_neg c && hd_is "small_int" (rand c)
               with Failure _ -> false) gl in
    STRIP_ASSUME_TAC (MATCH_MP n2mw_cons
      (MATCH_MP abs_nonzero (CONJ gd si)))) THEN
  (* the cells of the heap at the bignum *)
  FIRST_X_ASSUM(fun th ->
    if (try hd_is "STAR" (rator (concl th)) with Failure _ -> false)
    then MP_TAC th else fail()) THEN
  REWRITE_TAC[word_heap_APPEND; word_heap_def; bignum_def;
              i2mw_def] THEN
  CONV_TAC(TOP_DEPTH_CONV let_CONV) THEN
  REWRITE_TAC[word_el_def] THEN
  CONV_TAC(TOP_DEPTH_CONV let_CONV) THEN
  REWRITE_TAC[word_payload_def] THEN
  CONV_TAC(TOP_DEPTH_CONV let_CONV) THEN
  REWRITE_TAC[LENGTH_MAP] THEN
  sepfront ["cond"] THEN
  REWRITE_TAC[cond_STAR] THEN
  DISCH_THEN(CONJUNCTS_THEN2 STRIP_ASSUME_TAC MP_TAC) THEN
  FIRST_X_ASSUM (fun cons ->
    if not (try is_eq (concl cons) &&
                hd_is "CONS" (rand (concl cons)) &&
                length (snd (strip_comb (lhs (concl cons)))) = 1
            with Failure _ -> false)
    then fail() else
    DISCH_THEN (fun sep ->
      let front th cell =
        let p = rator (concl th) in
        let fs = facs p in
        let st = fst (strip_comb p) in
        let mk a b = mk_comb (mk_comb (st, a), b) in
        let rest = filter (fun t -> not (t = cell)) fs in
        let target = mk cell (end_itlist mk rest) in
        let eq = prove (mk_eq (p, target), REWRITE_TAC[STAR_AC]) in
        MATCH_MP read_fun2set (REWRITE_RULE[eq] th) in
      let sep2 = REWRITE_RULE[cons; MAP; word_list_def] sep in
      let cells th =
        map (front th) (filter (hd_is "set_sep_one") (facs
          (rator (concl th)))) in
      let rds2 = cells sep2 in
      let sep1 = REWRITE_RULE[word_list_def] sep in
      let rds1 = cells sep1 in
      let hdr = hd rds1 in
      let x = rand (rhs (concl (CONJUNCT1 hdr))) in
      let a = rand (lhs (concl (CONJUNCT1 hdr))) in
      let p1 = rator (concl sep1) in
      let fs1 = facs p1 in
      let st1 = fst (strip_comb p1) in
      let mk1 u v = mk_comb (mk_comb (st1, u), v) in
      let wl = find (hd_is "misc_word_list") fs1 in
      let rest1 = filter (fun t -> not (t = wl)) fs1 in
      let eq1 = prove (mk_eq (p1, mk1 wl (end_itlist mk1 rest1)),
                  REWRITE_TAC[STAR_AC]) in
      let sep3 = REWRITE_RULE[eq1] sep1 in
      MAP_EVERY EXISTS_TAC [rand (rator (concl sep3)); x; a] THEN
      MAP_EVERY STRIP_ASSUME_TAC
        (sep3 :: (rds1 @ rds2)))) THEN
  (* the bits of the header, off make_header *)
  SUBGOAL_THEN `3 < dimindex (:'a) /\ 4 < dimindex (:'a)`
    STRIP_ASSUME_TAC THENL
   [UNDISCH_TAC
      `data_to_word_config_len_size c + 7 < dimindex (:'a)` THEN
    ARITH_TAC;
    ALL_TAC] THEN
  SUBGOAL_THEN `2 EXP (dimindex (:'a) - 4) <= dimword (:'a)`
    ASSUME_TAC THENL
   [REWRITE_TAC[dimword; LE_EXP] THEN
    CONV_TAC NUM_REDUCE_CONV THEN ARITH_TAC;
    ALL_TAC] THEN
  ASM_REWRITE_TAC[and1_bit0;
    REWRITE_RULE[word_index] get_addr_0] THEN
  ASM_SIMP_TAC[ARITH_RULE `8 = 2 EXP 3`;
               ARITH_RULE `16 = 2 EXP 4`; and_pow2_zero] THEN
  REPEAT CONJ_TAC THEN
  TRY (SOLVED (FIRST_ASSUM ACCEPT_TAC)) THEN
  REWRITE_TAC[make_header_def; b2w_def] THEN
  CONV_TAC(TOP_DEPTH_CONV let_CONV) THEN
  ASM_CASES_TAC `(i:int) < &0` THEN
  FIRST
   [SUBGOAL_THEN `((&0:int) <= i) <=> F`
      (fun e -> REWRITE_TAC[e]) THENL
     [ASM_INT_ARITH_TAC; ALL_TAC];
    SUBGOAL_THEN `((&0:int) <= i) <=> T`
      (fun e -> REWRITE_TAC[e]) THENL
     [ASM_INT_ARITH_TAC; ALL_TAC]] THEN
  ASM_REWRITE_TAC[b2n_def] THEN
  REWRITE_TAC[WORD_EQ_BITS_ALT; BIT_WORD_AND; BIT_WORD_0;
              BIT_WORD_OR; BIT_WORD_SHL; BIT_WORD] THEN
  CONV_TAC NUM_REDUCE_CONV THEN
  TRY (W(fun gl ->
    UNDISCH_TAC (concl (the_asm (fun c ->
      try is_binop `(<):num->num->bool` c &&
          hd_is "LENGTH" (lhand c)
      with Failure _ -> false) gl)))) THEN
  TRY (UNDISCH_TAC
    `2 EXP (dimindex (:'a) - 4) <= dimword (:'a)`) THEN
  UNDISCH_TAC `4 < dimindex (:'a)` THEN
  UNDISCH_TAC `3 < dimindex (:'a)` THEN
  UNDISCH_TAC
    `data_to_word_config_len_size c + 7 < dimindex (:'a)` THEN
  ARITH_TAC)
### memory_rel_bignum_cmp
  (* the steps are above the statement (tools/overrides.py).  Of
     each of the two numbers the invariant gives the element of the
     heap as its header (bignum_header), and the header is the sign
     and the length of each: if the lengths are one and the signs
     are one then the headers are one, which the elements of the
     two are not (bignum_cmp_sign) *)
  (STRIP_TAC THEN SPLIT_ASM_TAC THEN
    (* what the invariant says of each of the two numbers *)
    W(fun gl ->
      let mr = the_asm (hd_is "memory_rel") gl in
      let gd = the_asm (hd_is "good_dimindex") gl in
      let lst = el 8 (snd (strip_comb (concl mr))) in
      let num t = rand (lhand (lhand t)) in
      let ns i = the_asm (fun c -> is_neg c &&
                   hd_is "small_int" (rand c) &&
                   el 1 (snd (strip_comb (rand c))) = i) gl in
      MAP_EVERY STRIP_ASSUME_TAC
        [MATCH_MP bignum_header (CONJ mr (CONJ (ns (num lst)) gd));
         MATCH_MP bignum_header
           (CONJ (MATCH_MP memory_rel_tail mr)
             (CONJ (ns (num (rand lst))) gd))]) THEN
    (* the witnesses: the root, the address and the element of each *)
    W(fun (asl,gw as gl) ->
      let mr = the_asm (hd_is "memory_rel") gl in
      let lst = el 8 (snd (strip_comb (concl mr))) in
      let pieces vt =
        let vw = the_asm (fun c -> is_eq c && lhand c = vt &&
                   hd_is "wordLang_Word" (rand c)) gl in
        let wv = rand (rand (concl vw)) in
        let ga = the_asm (fun c -> is_eq c &&
                   hd_is "get_real_addr" (lhand c) &&
                   el 2 (snd (strip_comb (lhand c))) = wv) gl in
        let a = rand (rand (concl ga)) in
        let ma = the_asm (fun c -> is_eq c && is_comb (lhand c) &&
                   rand (lhand c) = a &&
                   hd_is "wordLang_Word" (rand c)) gl in
        let x = rand (rand (concl ma)) in
        let he = the_asm (fun c -> is_eq c && lhand c = x &&
                   hd_is "make_header" (rand c)) gl in
        let dl = the_asm (fun c -> is_eq c &&
                   hd_is "decode_length" (lhand c) &&
                   rand (lhand c) = x) gl in
        let l = rand (rand (concl dl)) in
        let bd = the_asm (fun c -> hd_is "<" c && lhand c = l &&
                   hd_is "dimword" (rand c)) gl in
        let sg = the_asm (fun c -> is_eq c &&
                   type_of (lhand c) = bool_ty &&
                   is_eq (lhand c) &&
                   can (find_term (fun t -> t = x)) (lhand c)) gl in
        (wv,a,x,he,dl,bd,sg) in
      let (w1,a1,x1,he1,dl1,bd1,sg1) = pieces (rand (lhand lst)) in
      let (w2,a2,x2,he2,dl2,bd2,sg2) =
        pieces (rand (lhand (rand lst))) in
      MAP_EVERY EXISTS_TAC [w1; w2; a1; a2; x1; x2] THEN
      REPEAT CONJ_TAC THEN
      TRY (SOLVED (FIRST_ASSUM ACCEPT_TAC)) THEN
      MATCH_ACCEPT_TAC (MATCH_MP bignum_cmp_sign
        (CONJ he1 (CONJ he2 (CONJ dl1 (CONJ dl2 (CONJ bd1 (CONJ bd2
          (CONJ sg1 sg2))))))))))
### memory_rel_Word64_IMP
(* the proof of the source is the one of memory_rel_ValueArray_IMP
   with Word64Rep in place of the RefBlock: v_inv gives the heap
   lookup at the pointer, heap_in_memory_store and
   get_real_addr_get_addr give the address, and the heap split
   there lets word_heap be unfolded down to the three cells (two on
   a 64-bit target) that the statement reads.  The two word sizes
   are one case split, because Word64Rep is a conditional on the
   same test the statement has, and the bits of the header come off
   make_header as they do there *)
  (let hd_is n t =
    (try fst(dest_const(fst(strip_comb t))) = n
     with Failure _ -> false) in
  let rec facs t =
    if hd_is "STAR" t then
      let args = snd(strip_comb t) in
      facs (el 0 args) @ facs (el 1 args)
    else [t] in
  let grab asl p =
    tryfind (fun (_,th) ->
      if (try p th with Failure _ -> false) then th else fail()) asl in
  let is_hl th = hd_is "heap_lookup" (lhs (concl th)) in
  let sepfront names =
    W(fun (asl,w) ->
      let pred = rator (lhand w) in
      let fs = facs pred in
      let picked = map (fun n -> find (hd_is n) fs) names in
      let rest = filter (fun t -> not (mem t picked)) fs in
      let st = fst(strip_comb pred) in
      let mk a b = mk_comb(mk_comb(st,a),b) in
      let target = itlist mk picked (end_itlist mk rest) in
      SUBGOAL_THEN (mk_eq(pred,target)) SUBST1_TAC THENL
       [REWRITE_TAC[STAR_AC]; ALL_TAC]) in
  MEMORY_REL_TAC THEN V_INV_TAC v_inv_def THEN
  W(fun gl -> EXISTS_TAC (var_by_name "ptr" gl)) THEN
  FIRST_X_ASSUM(fun th ->
    if hd_is "heap_in_memory_store" (concl th)
    then MP_TAC(REWRITE_RULE[heap_in_memory_store_def] th)
    else fail()) THEN
  STRIP_TAC THEN
  W(fun (asl,w) ->
    MP_TAC(MATCH_MP heap_lookup_SPLIT (grab asl is_hl))) THEN
  DISCH_THEN STRIP_ASSUME_TAC THEN
  VAR_EQ_TAC THEN
  W(fun (asl,w) ->
    let hl = grab asl is_hl in
    let hlen = grab asl (fun th ->
      hd_is "heap_length" (lhand (concl th))) in
    let cu = grab asl (fun th ->
      hd_is "FLOOKUP" (lhs (concl th)) &&
      fst(dest_const(rand(lhs(concl th)))) = "CurrHeap") in
    let gd = grab asl (fun th -> concl th = `good_dimindex (:'a)`) in
    let gat = tryfind (fun t ->
      find_term (fun u ->
        hd_is "get_addr" u && length (snd(strip_comb u)) = 3) t)
      (w :: map (fun (_,th) -> concl th) asl) in
    let th = SPEC (last (snd(strip_comb gat)))
      (GEN `w:('a)word_loc`
        (MATCH_MP get_real_addr_get_addr
          (CONJ hlen (CONJ hl (CONJ cu gd))))) in
    let r = rhs (concl (CONJUNCT1 th)) in
    let a = rand r in
    let args = snd(strip_comb (rand a)) in
    let mul = fst(strip_comb (rand a)) in
    let swap = mk_comb(rator a,
                 mk_comb(mk_comb(mul,el 1 args),el 0 args)) in
    let sw = WORD_RULE (mk_eq(a,swap)) in
    EXISTS_TAC swap THEN
    STRIP_ASSUME_TAC(REWRITE_RULE[sw] th)) THEN
  FIRST_X_ASSUM(fun th ->
    if (try hd_is "STAR" (rator (concl th)) with Failure _ -> false)
    then MP_TAC th else fail()) THEN
  REWRITE_TAC[word_heap_APPEND; word_heap_def; Word64Rep_def] THEN
  COND_CASES_TAC THEN
  REWRITE_TAC[] THEN
  CONV_TAC(TOP_DEPTH_CONV let_CONV) THEN
  REWRITE_TAC[word_el_def] THEN
  CONV_TAC(TOP_DEPTH_CONV let_CONV) THEN
  REWRITE_TAC[word_payload_def] THEN
  CONV_TAC(TOP_DEPTH_CONV let_CONV) THEN
  REWRITE_TAC[word_list_def; LENGTH_MAP] THEN
  sepfront ["cond"] THEN
  REWRITE_TAC[cond_STAR] THEN
  DISCH_THEN(CONJUNCTS_THEN2 STRIP_ASSUME_TAC MP_TAC) THEN
  DISCH_THEN (fun sep ->
    let p = rator (concl sep) in
    let fs = facs p in
    let st = fst (strip_comb p) in
    let mk a b = mk_comb (mk_comb (st, a), b) in
    let front cell =
      let rest = filter (fun t -> not (t = cell)) fs in
      let target = mk cell (end_itlist mk rest) in
      let eq = prove (mk_eq (p, target), REWRITE_TAC[STAR_AC]) in
      MATCH_MP read_fun2set (REWRITE_RULE[eq] sep) in
    let rds = map front (filter (hd_is "set_sep_one") fs) in
    EXISTS_TAC (rand (rhs (concl (CONJUNCT1 (hd rds))))) THEN
    MAP_EVERY STRIP_ASSUME_TAC rds) THEN
  REWRITE_TAC[shl1_add; WORD_ADD_ASSOC] THEN
  ASM_REWRITE_TAC[LENGTH] THEN
  CONV_TAC NUM_REDUCE_CONV THEN
  REWRITE_TAC[make_header_def] THEN
  CONV_TAC(TOP_DEPTH_CONV let_CONV) THEN
  REWRITE_TAC[BIT_WORD_OR; BIT_WORD_SHL; BIT_WORD] THEN
  CONV_TAC NUM_REDUCE_CONV THEN
  UNDISCH_TAC
    `data_to_word_config_len_size c + 7 < dimindex (:'a)` THEN
  ARITH_TAC)
### memory_rel_RefPtr_EQ
  (* the invariant gives the heap and the roots, and ref_eq_thm
     gives the two roots as pointers with a zero annotation and
     says that the two references are the same exactly when the two
     roots are.  So the words of the statement are the two
     addresses, and they determine the pointers
     (memory_rel_RefPtr_EQ_lemma): a pointer of the roots is an
     element of the heap (roots_ok, heap_lookup_LESS), and the heap
     is short enough for the shift not to wrap
     (heap_in_memory_store) *)
  (let rec ntimes k t =
     if k <= 0 then ALL_TAC else t THEN ntimes (k-1) t in
  let SPLIT_ROOT =
    W(fun (asl,w) ->
      let lr = snd (find (fun (_,th) -> hd_is "ALL2" (concl th)) asl) in
      let hs = el 1 (snd (strip_comb (concl lr))) in
      if is_var hs then CASES_ON_TAC hs else fail()) THEN
    RULE_ASSUM_TRY (REWRITE_RULE[ALL2]) THEN
    TRY (FIRST_ASSUM CONTR_TAC) THEN
    RULE_ASSUM_TRY (CONV_RULE(TOP_DEPTH_CONV BETA_CONV)) THEN
    SPLIT_ASM_TAC in
   STRIP_TAC THEN
   FIRST_X_ASSUM (fun mr ->
     if not (hd_is "memory_rel" (concl mr)) then fail() else
     STRIP_ASSUME_TAC (REWRITE_RULE[memory_rel_def; word_ml_inv_def;
                                    MAP] mr)) THEN
   ntimes 2 SPLIT_ROOT THEN
   (* the two roots are pointers, and the references are the same
      exactly when they are (ref_eq_thm) *)
   FIRST_ASSUM (fun ai ->
     if not (hd_is "abs_ml_inv" (concl ai)) then fail() else
     STRIP_ASSUME_TAC (MATCH_MP (GEN_ALL ref_eq_thm) ai)) THEN
   VAR_EQ_TAC THEN
   REWRITE_TAC[word_addr_def] THEN MATCH_REDUCE_TAC THEN
   REWRITE_TAC[injectivity "word_loc"] THEN
   W(fun (asl,w) ->
     let vs,bod = strip_exists w in
     let cs = conjuncts bod in
     MAP_EVERY EXISTS_TAC [lhs (el 0 cs); lhs (el 1 cs)]) THEN
   REWRITE_TAC[] THEN
   (* so the goal is that the two addresses are the same exactly
      when the two pointers are *)
   FIRST_ASSUM (fun eq ->
     if not (is_iff (concl eq)) then fail() else
     REWRITE_TAC[eq; injectivity "heap_address"]) THEN
   EQ_TAC THENL
    [ALL_TAC;
     DISCH_THEN SUBST1_TAC THEN REFL_TAC] THEN
   (* the addresses are the pointers shifted up with a one in the
      lowest bit, so they determine the pointers *)
   REWRITE_TAC[get_addr_def; get_lowerbits_def] THEN
   MATCH_REDUCE_TAC THEN
   REWRITE_TAC[word_bits; WORD_SUBWORD_0; WORD_OR_0] THEN
   DISCH_TAC THEN
   MATCH_MP_TAC (GEN_ALL memory_rel_RefPtr_EQ_lemma) THEN
   EXISTS_TAC `shift_length c` THEN
   REPEAT CONJ_TAC THEN TRY (FIRST_ASSUM ACCEPT_TAC) THEN
   TRY (REWRITE_TAC[shift_length_def] THEN ARITH_TAC) THEN
   (* a pointer of the roots is an element of the heap, and the heap
      is short enough for the shift not to wrap *)
   W(fun (asl,w) ->
     let p = lhand (lhand w) in
     let tp = rand (lhand w) in
     let dw = rand w in
     FIRST_ASSUM (fun ai ->
       if not (hd_is "abs_ml_inv" (concl ai)) then fail() else
       let rk = REWRITE_RULE[roots_ok_def]
                  (CONJUNCT1 (REWRITE_RULE[abs_ml_inv_def] ai)) in
       MP_TAC (SPEC p rk)) THEN
     REWRITE_TAC[MEM; isSomeDataElement_def] THEN
     DISCH_THEN (fun th ->
       MP_TAC (REWRITE_RULE[] (SPEC `wordLang_Word ((n2w 0):'a word)`
                                th))) THEN
     REWRITE_TAC[] THEN
     DISCH_THEN (REPEAT_TCL CHOOSE_THEN (fun hl ->
       ASSUME_TAC (MATCH_MP (GEN_ALL heap_lookup_LESS) hl))) THEN
     FIRST_ASSUM (fun hm ->
       if not (hd_is "heap_in_memory_store" (concl hm)) then fail()
       else
       ASSUME_TAC (CONJUNCT1
         (REWRITE_RULE[heap_in_memory_store_def] hm))) THEN
     MP_TAC (SPECL [tp; dw; p] LDIV_LT_EQ) THEN
     REWRITE_TAC[EXP_EQ_0; ARITH_RULE `~(2 = 0)`] THEN
     DISCH_THEN (fun iff ->
       SUBGOAL_THEN (lhs (concl iff)) (fun lt ->
         MP_TAC (EQ_MP iff lt)) THENL
        [ASM_ARITH_TAC; ALL_TAC]) THEN
     REWRITE_TAC[LEFT_ADD_DISTRIB; MULT_CLAUSES; MULT_AC] THEN
     ASM_ARITH_TAC))
### smallnum_test
(* the proof of the source splits the two word sizes and reads the
   bits of the number off BITS.  Here the and with the top two bits
   says that the value is below two to the dimindex less two (the
   first two lemmas: the mask of the source is the complement of
   the mask of the lower bits, and what the and with that leaves is
   what HOL Light's VAL_WORD_AND_NOT_MASK_WORD says).  Of a
   negative number the value is the word size less four times it,
   and small_int keeps that above half the word size, which is too
   big; so the number is not negative, four times it is the value,
   and a quarter of the bound is the bound of the statement *)
  (let mask_shl = prove
   (`!k. (--(word 1):'a word) << k = word_not (word (2 EXP k - 1))`,
    GEN_TAC THEN
    REWRITE_TAC[WORD_EQ_BITS_ALT; BIT_WORD_SHL; WORD_NEG_1;
                BIT_WORD_NOT; BIT_WORD_0; GSYM WORD_OF_BITS_MASK;
                BIT_WORD_OF_BITS; IN_ELIM_THM] THEN
    REPEAT STRIP_TAC THEN ASM_ARITH_TAC) in
  let top_bits = prove
   (`!(w:'a word) k. (w && --(word 1) << k) = word 0 ==>
       val w < 2 EXP k`,
    REPEAT GEN_TAC THEN REWRITE_TAC[mask_shl] THEN
    DISCH_THEN (MP_TAC o REWRITE_RULE[GSYM VAL_EQ]) THEN
    REWRITE_TAC[VAL_WORD_AND_NOT_MASK_WORD; VAL_WORD_0] THEN
    SIMP_TAC[MULT_EQ_0; EXP_EQ_0; ARITH_EQ; DIV_EQ_0]) in
  let e16 = prove
   (`!x. 2 EXP (x + 4) = 16 * 2 EXP x /\
         2 EXP (x + 4) DIV 8 = 2 * 2 EXP x /\
         2 EXP (x + 2) = 4 * 2 EXP x`,
    GEN_TAC THEN REWRITE_TAC[EXP_ADD] THEN
    CONV_TAC NUM_REDUCE_CONV THEN
    SIMP_TAC[ARITH_RULE `2 EXP x * 16 = 8 * (2 * 2 EXP x)`;
             DIV_MULT; ARITH_EQ] THEN ARITH_TAC) in
  let div16 = prove
   (`!y. (16 * y) DIV 8 = 2 * y`,
    GEN_TAC THEN ONCE_REWRITE_TAC[ARITH_RULE `16 * y = 8 * (2 * y)`]
    THEN SIMP_TAC[DIV_MULT; ARITH_EQ]) in
  STRIP_TAC THEN
  FIRST_ASSUM (fun c ->
    if (try hd_is "word_and" (lhs (concl c))
        with Failure _ -> false)
    then ASSUME_TAC (MATCH_MP top_bits c) else fail()) THEN
  SUBGOAL_THEN `?x. dimindex (:'a) = x + 4` MP_TAC THENL
   [EXISTS_TAC `dimindex (:'a) - 4` THEN
    FIRST_ASSUM (fun gd ->
      if hd_is "good_dimindex" (concl gd)
      then MP_TAC (REWRITE_RULE[good_dimindex_def] gd)
      else fail()) THEN ARITH_TAC;
    ALL_TAC] THEN
  DISCH_THEN (CHOOSE_THEN (fun eq ->
    SUBST_ALL_TAC eq THEN ASSUME_TAC eq)) THEN
  RULE_ASSUM_TRY (REWRITE_RULE[ARITH_RULE `(x + 4) - 2 = x + 2`;
                               ARITH_RULE `(x + 4) - 4 = x`]) THEN
  REWRITE_TAC[ARITH_RULE `(x + 4) - 4 = x`] THEN
  DISJ_CASES_THEN (X_CHOOSE_THEN `n:num` SUBST_ALL_TAC)
    (SPEC `i:int` INT_IMAGE) THENL
   [(* the number is not negative *)
    RULE_ASSUM_TRY (REWRITE_RULE[smallnum_def; small_int_def;
      INT_OF_NUM_LT; INT_OF_NUM_MUL; NUM_OF_INT_OF_NUM;
      ARITH_RULE `~(m < 0)`; dimword; VAL_WORD; e16]) THEN
    REWRITE_TAC[INT_OF_NUM_LT; ARITH_RULE `~(m < 0)`] THEN
    FIRST_ASSUM (fun b ->
      if not (try hd_is "MOD" (lhand (concl b))
              with Failure _ -> false) then fail() else
      SUBGOAL_THEN (mk_binop `(<):num->num->bool`
                      (lhand (lhand (concl b)))
                      (rand (lhand (concl b))))
        (fun lt -> MP_TAC (REWRITE_RULE[MATCH_MP MOD_LT lt] b))
      THENL [ASM_ARITH_TAC; ALL_TAC]) THEN
    ASM_ARITH_TAC;
    (* the number is negative, which the top bits deny *)
    ASM_CASES_TAC `0 < n` THENL
     [RULE_ASSUM_TRY (REWRITE_RULE[smallnum_def; small_int_def;
        INT_NEG_LT0; INT_OF_NUM_LT; INT_OF_NUM_LE; INT_LE_NEG2;
        INT_SUB_LZERO; INT_NEG_NEG; INT_OF_NUM_MUL;
        NUM_OF_INT_OF_NUM; WORD_SUB_LZERO; dimword]) THEN
      FIRST_ASSUM (fun pos ->
        if not (try concl pos = `0 < n`
                with Failure _ -> false) then fail() else
        RULE_ASSUM_TRY (REWRITE_RULE[pos]) THEN ASSUME_TAC pos) THEN
      FIRST_ASSUM (fun eq ->
        if (try hd_is "dimindex" (lhs (concl eq))
            with Failure _ -> false)
        then RULE_ASSUM_TRY (REWRITE_RULE[VAL_WORD_NEG_CASES;
               VAL_WORD; eq; e16; div16]) else fail())
      THEN
      SUBGOAL_THEN `4 * n < 16 * 2 EXP x` ASSUME_TAC THENL
       [ASM_ARITH_TAC; ALL_TAC] THEN
      FIRST_ASSUM (fun lt ->
        if not (try concl lt = `4 * n < 16 * 2 EXP x`
                with Failure _ -> false) then fail() else
        RULE_ASSUM_TRY (REWRITE_RULE[MATCH_MP MOD_LT lt])) THEN
      FIRST_ASSUM (fun pos ->
        if not (try concl pos = `0 < n`
                with Failure _ -> false) then fail() else
        RULE_ASSUM_TRY (REWRITE_RULE[EQF_INTRO (MATCH_MP
          (ARITH_RULE `0 < n ==> ~(4 * n = 0)`) pos)])) THEN
      ASM_ARITH_TAC;
      SUBGOAL_THEN `n = 0` SUBST_ALL_TAC THENL
       [ASM_ARITH_TAC; ALL_TAC] THEN
      REWRITE_TAC[INT_NEG_0; INT_OF_NUM_LT; INT_LT_REFL] THEN
      SIMP_TAC[LT_NZ; EXP_EQ_0; ARITH_EQ]]])
### word_cmp_loop_thm
  (* the first proof of the word level, and the shape the thirty
     others of this file have.  The induction is the complete one
     on the length of the two lists, which is what mw_cmp recurses
     on (PORTING-GUIDE.md entry 44, since the port has no
     mw_cmp_ind); the loop starts at the last cell of each list, so
     each list is taken apart at its end (SNOC_CASES) and the cell
     of its last element comes out of the memory by the steps above
     the statement -- star_front and read_fun2set, which is what
     HOL4's SEP_R_TAC does; the addresses and the counter of the
     step back are the three word equations of the block; and the
     hypothesis at the two fronts is what the branch where the two
     last elements agree leaves *)
  ((* the complete induction on the length of the two lists, which
     is what mw_cmp recurses on *)
  SUBGOAL_THEN
   `!k xs1 (xs2:('a word) list) f1 f2 (a1:'a word) a2.
      LENGTH xs1 <= k /\ LENGTH xs1 = LENGTH xs2 /\
      LENGTH xs1 < dimword (:'a) /\
      (misc_word_list (a1 + bytes_in_word) (MAP wordLang_Word xs1) *
        f1) (fun2set (m,dm)) /\
      (misc_word_list (a2 + bytes_in_word) (MAP wordLang_Word xs2) *
        f2) (fun2set (m,dm))
      ==> word_cmp_loop (n2w (LENGTH xs1))
            (a1 + bytes_in_word * n2w (LENGTH xs1))
            (a2 + bytes_in_word * n2w (LENGTH xs1)) dm m =
          SOME (match mw_cmp xs1 xs2 with NONE -> (n2w 1)
                | SOME T -> (n2w 0) | SOME F -> (n2w 2))`
   (fun th ->
      REPEAT GEN_TAC THEN DISCH_TAC THEN
      MP_TAC (SPEC `LENGTH (xs1:('a word) list)` th) THEN
      ASM_MESON_TAC[LE_REFL]) THEN
  MATCH_MP_TAC num_WF THEN GEN_TAC THEN DISCH_TAC THEN
  REPEAT GEN_TAC THEN STRIP_TAC THEN
  (* of two empty lists the loop stops at once *)
  ASM_CASES_TAC `xs1:('a word) list = []` THENL
   [FIRST_X_ASSUM SUBST_ALL_TAC THEN
    RULE_ASSUM_TRY (REWRITE_RULE[LENGTH]) THEN
    SUBGOAL_THEN `xs2:('a word) list = []` SUBST_ALL_TAC THENL
     [REWRITE_TAC[GSYM LENGTH_EQ_NIL] THEN
      FIRST_ASSUM (ACCEPT_TAC o SYM);
      ALL_TAC] THEN
    ONCE_REWRITE_TAC[word_cmp_loop_def; mw_cmp_def] THEN
    REWRITE_TAC[LENGTH] THEN
    TRY SAFE_MATCH_REDUCE_TAC THEN
    REWRITE_TAC[];
    ALL_TAC] THEN
  (* and of two lists that end in an element: the two elements *)
  W(fun gl ->
    let x1 = var_by_name "xs1" gl in
    STRIP_ASSUME_TAC (MATCH_MP SNOC_CASES
      (the_asm (fun c -> is_neg c && is_eq (rand c) &&
         lhand (rand c) = x1) gl))) THEN
  FIRST_X_ASSUM SUBST_ALL_TAC THEN
  (* and so does the other list, because they are of one length *)
  W(fun gl ->
    let x2 = var_by_name "xs2" gl in
    let ety = hd (snd (dest_type (type_of x2))) in
    SUBGOAL_THEN (mk_neg (mk_eq (x2,
        mk_const ("NIL", [ety,`:A`]))))
      (fun ne -> STRIP_ASSUME_TAC (MATCH_MP SNOC_CASES ne))) THENL
   [REWRITE_TAC[GSYM LENGTH_EQ_NIL] THEN
    RULE_ASSUM_TRY (REWRITE_RULE[LENGTH_SNOC]) THEN
    ASM_ARITH_TAC;
    ALL_TAC] THEN
  FIRST_X_ASSUM SUBST_ALL_TAC THEN
  (* the cell of each last element, taken out of the memory *)
  RULE_ASSUM_TRY (REWRITE_RULE[SNOC_APPEND; MAP_APPEND; MAP;
                               word_list_SNOC; LENGTH_MAP]) THEN
  RULE_ASSUM_TRY (REWRITE_RULE[LENGTH_SNOC; LENGTH_APPEND;
                               LENGTH]) THEN
  REWRITE_TAC[LENGTH_SNOC] THEN
  (* the two lists are of one length, and the counter is a sum *)
  W(fun (asl,w as gl) ->
    let y = var_by_name "y" gl and y' = var_by_name "y'" gl in
    SUBGOAL_THEN (mk_eq (list_mk_icomb "LENGTH" [y'],
                         list_mk_icomb "LENGTH" [y]))
      (fun e -> RULE_ASSUM_TRY (REWRITE_RULE[e]) THEN
                ASSUME_TAC e)) THENL
   [ASM_ARITH_TAC; ALL_TAC] THEN
  RULE_ASSUM_TRY (CONV_RULE NUM_REDUCE_CONV) THEN
  (* the two cells, out of the memory *)
  W(fun (asl,_) ->
    MAP_EVERY (fun th -> TRY (STRIP_ASSUME_TAC th))
      (mapfilter (fun (_,t) ->
         MATCH_MP sep_read (MATCH_MP star_front t)) asl)) THEN
  (* the address of the last cell is where the loop starts *)
  REWRITE_TAC[addr_step] THEN
  (* the loop and the comparison, one step each *)
  ONCE_REWRITE_TAC[word_cmp_loop_def] THEN
  ONCE_REWRITE_TAC[mw_cmp_def] THEN
  REWRITE_TAC[NOT_SNOC_NIL; LAST_SNOC; FRONT_SNOC] THEN
  (* the counter is not zero, because the lists are not empty *)
  W(fun (asl,w as gl) ->
    let lt = the_asm (fun c ->
               is_binop `(<):num->num->bool` c &&
               hd_is "dimword" (rand c)) gl in
    REWRITE_TAC[MATCH_MP WORD_EQ_0 (REWRITE_RULE[dimword] lt)]) THEN
  REWRITE_TAC[ADD_EQ_0; ARITH_EQ] THEN
  (* the two addresses are in the domain and hold the two last
     elements *)
  ASM_REWRITE_TAC[] THEN
  TRY SAFE_MATCH_REDUCE_TAC THEN
  (* the step back to the cell before the last, and the counter *)
  REWRITE_TAC[addr_prev; len_step] THEN
  (* the rest of the two lists, for the hypothesis *)
  RULE_ASSUM_TRY (REWRITE_RULE[GSYM STAR_ASSOC]) THEN
  (* where the two last elements differ the loop stops *)
  TRY (SOLVED (COND_CASES_TAC THEN REWRITE_TAC[])) THEN
  (* the front of the list is shorter than the whole of it *)
  W(fun (asl,w as gl) ->
    let y = var_by_name "y" gl in
    let lt = the_asm (fun c ->
               is_binop `(<):num->num->bool` c &&
               hd_is "dimword" (rand c)) gl in
    SUBGOAL_THEN (mk_binop `(<):num->num->bool`
        (list_mk_icomb "LENGTH" [y]) (rand (concl lt)))
       ASSUME_TAC) THENL
   [ASM_ARITH_TAC; ALL_TAC] THEN
  (* and where they agree it goes on, which is the hypothesis at
     the two fronts *)
  W(fun (asl,w as gl) ->
    let y = var_by_name "y" gl in
    let ih = the_asm (fun c -> is_forall c &&
               (try hd_is "<" (lhand (snd (strip_forall c)))
                with Failure _ -> false)) gl in
    let kk = rand (lhand (snd (strip_forall (concl ih)))) in
    SUBGOAL_THEN (mk_binop `(<):num->num->bool`
        (list_mk_icomb "LENGTH" [y]) kk)
      (fun lt -> MP_TAC (MP (SPEC (list_mk_icomb "LENGTH" [y]) ih)
                            lt))) THENL
   [ASM_ARITH_TAC; ALL_TAC] THEN
  DISCH_THEN (fun th ->
    W(fun (asl,w as gl) ->
      let y = var_by_name "y" gl and y' = var_by_name "y'" gl in
      let lst c = rand (el 1 (snd (strip_comb
                    (lhand (rator c))))) in
      let w1 = the_asm (fun c ->
                 (try lst c = y with Failure _ -> false)) gl in
      let w2 = the_asm (fun c ->
                 (try lst c = y' with Failure _ -> false)) gl in
      let f1 = rand (rator (concl w1)) in
      let f2 = rand (rator (concl w2)) in
      let adr c = lhand (el 0 (snd (strip_comb
                    (lhand (rator c))))) in
      let a1 = adr (concl w1) in
      let a2 = adr (concl w2) in
      MP_TAC (SPECL [y; y'; f1; f2; a1; a2] th))) THEN
  (* its hypotheses are the branch's own *)
  ASM_REWRITE_TAC[LE_REFL] THEN
  DISCH_THEN (fun th -> REWRITE_TAC[th]) THEN
  (* and the two last elements decide the one step *)
  COND_CASES_TAC THEN
  ASM_REWRITE_TAC[] THEN
  TRY SAFE_MATCH_REDUCE_TAC THEN
  TRY (SOLVED (REWRITE_TAC[])) THEN
  COND_CASES_TAC THEN
  ASM_REWRITE_TAC[] THEN
  TRY SAFE_MATCH_REDUCE_TAC THEN
  REWRITE_TAC[distinctness "option"; injectivity "option"])
### memory_rel_Number_cmp
  (* the attempt: the proof of the source names
     memory_rel_Number_IMP_Word_2, small_int_def,
     memory_rel_any_Number_IMP, memory_rel_tail,
     memory_rel_Number_EQ, memory_rel_Number_LESS.  What is here
     rewrites with them and closes by arithmetic, and the cheat is
     behind it until the proof is written.  A MESON over them is
     what the next round adds; it costs a load ten minutes to have
     it in every attempt and it closed none of them *)
  (ATTEMPT_TAC 2
    (REPEAT GEN_TAC THEN REPEAT STRIP_TAC THEN
     ASM_REWRITE_TAC[memory_rel_Number_IMP_Word_2; small_int_def;
       memory_rel_any_Number_IMP; memory_rel_tail;
       memory_rel_Number_EQ; memory_rel_Number_LESS] THEN
     TRY ASM_ARITH_TAC))
### memory_rel_depth_limit
(* the proof of the source is the induction of the values, with
   NULL_EQ, MAX_LIST, memory_rel_Block_MEM and LESS_LENGTH.  Here
   the induction is HOL Light's for the type, with the hypothesis
   of a Block over its list (the first lemma below), and a value
   that is not a Block has depth nought and wants no stack.  For a
   Block the deepest of its elements is one of them (the second
   lemma), and that element with its root is what the stack gains:
   memory_rel_Block_MEM puts the element in front of the Block, the
   element of the induction hypothesis gives the stack of it, and
   elements_list of the two says that the element is one of the
   Block's *)
  (let v_ind = prove
   (`!P. (!i. P (Number i)) /\ (!w. P (Word64 w)) /\
         (!ts t l. ALL P l ==> P (Block ts t l)) /\
         (!n. P (CodePtr n)) /\ (!b n. P (RefPtr b n)) ==>
         (!v. P (v:dataSem_v))`,
    GEN_TAC THEN DISCH_TAC THEN
    MP_TAC (ISPECL [`P:dataSem_v->bool`; `ALL (P:dataSem_v->bool)`]
              dataSem_v_INDUCT) THEN
    ASM_REWRITE_TAC[ALL] THEN
    DISCH_THEN (ACCEPT_TAC o CONJUNCT1)) in
  let MAX_LIST_MEM = prove
   (`!l. ~(l = []) ==> MEM (MAX_LIST l) l`,
    LIST_INDUCT_TAC THEN
    REWRITE_TAC[NOT_CONS_NIL; MEM; MAX_LIST] THEN
    ASM_CASES_TAC `t:num list = []` THENL
     [ASM_REWRITE_TAC[MAX_LIST; ARITH_RULE `MAX h 0 = h`];
      DISJ_CASES_TAC (ARITH_RULE
        `MAX h (MAX_LIST t) = h \/ MAX h (MAX_LIST t) = MAX_LIST t`)
      THEN ASM_REWRITE_TAC[] THEN ASM_SIMP_TAC[]]) in
  let depth_conv =
    GEN_REWRITE_TAC LAND_CONV [v_depth_def] THEN
    MATCH_REDUCE_TAC in
  let nb =
    REPEAT GEN_TAC THEN STRIP_TAC THEN
    EXISTS_TAC `[]:(dataSem_v # ('a word_loc)) list` THEN
    REWRITE_TAC[APPEND; MAP; LENGTH] THEN
    REPEAT CONJ_TAC THEN TRY (FIRST_ASSUM ACCEPT_TAC) THEN
    depth_conv THEN REWRITE_TAC[] in
  W(fun (asl,gl) ->
    let v,bod = dest_forall gl in
    MATCH_MP_TAC (CONV_RULE (TOP_DEPTH_CONV BETA_CONV)
                    (ISPEC (mk_abs (v,bod)) v_ind))) THEN
  REPEAT CONJ_TAC THENL
   [nb; nb;
    REPEAT GEN_TAC THEN DISCH_TAC THEN REPEAT GEN_TAC THEN
    STRIP_TAC THEN
    ASM_CASES_TAC `l:(dataSem_v) list = []` THENL
     [EXISTS_TAC `[]:(dataSem_v # ('a word_loc)) list` THEN
      REWRITE_TAC[APPEND; MAP; LENGTH] THEN
      REPEAT CONJ_TAC THEN TRY (FIRST_ASSUM ACCEPT_TAC) THEN
      depth_conv THEN
      ASM_REWRITE_TAC[NULL; MAP; MAX_LIST] THEN ARITH_TAC;
      ALL_TAC] THEN
    SUBGOAL_THEN `~(MAP v_depth (l:(dataSem_v)list) = [])`
      (fun th -> MP_TAC (MATCH_MP MAX_LIST_MEM th)) THENL
     [ASM_REWRITE_TAC[MAP_EQ_NIL]; ALL_TAC] THEN
    REWRITE_TAC[MEM_MAP] THEN
    DISCH_THEN (X_CHOOSE_THEN `e:dataSem_v`
                 STRIP_ASSUME_TAC) THEN
    FIRST_ASSUM (fun mm ->
      if hd_is "MEM" (concl mm)
      then STRIP_ASSUME_TAC
             (REWRITE_RULE[MEM_APPEND_DECOMPOSE] mm)
      else fail()) THEN
    SUBGOAL_THEN
      `LENGTH (l1:(dataSem_v)list) < LENGTH (l:(dataSem_v)list)`
      ASSUME_TAC THENL
     [ASM_REWRITE_TAC[LENGTH_APPEND; LENGTH] THEN ARITH_TAC;
      ALL_TAC] THEN
    SUBGOAL_THEN
      `EL (LENGTH (l1:(dataSem_v)list)) l = (e:dataSem_v)`
      ASSUME_TAC THENL
     [ASM_REWRITE_TAC[EL_APPEND; LT_REFL; SUB_REFL; EL; HD];
      ALL_TAC] THEN
    FIRST_ASSUM (fun mr ->
      if hd_is "memory_rel" (concl mr)
      then FIRST_ASSUM (fun lt ->
             if (try hd_is "<" (concl lt) with Failure _ -> false)
             then FIRST_ASSUM (fun gd ->
                    if hd_is "good_dimindex" (concl gd)
                    then STRIP_ASSUME_TAC
                           (MATCH_MP (GEN_ALL memory_rel_Block_MEM)
                             (CONJ mr (CONJ lt gd)))
                    else fail())
             else fail())
      else fail()) THEN
    FIRST_ASSUM (fun elq ->
      if (try is_eq (concl elq) && hd_is "EL" (lhs (concl elq))
          with Failure _ -> false)
      then RULE_ASSUM_TRY (REWRITE_RULE[elq]) else fail()) THEN
    SUBGOAL_THEN `elements_list ((e:dataSem_v) ::
                    MAP FST ((Block ts' t l,(w:'a word_loc)) ::
                      (vars':(dataSem_v # ('a word_loc))list)))`
      ASSUME_TAC THENL
     [REWRITE_TAC[MAP; FST; elements_list_def] THEN
      MAP_EVERY EXISTS_TAC
        [`ts':num`; `t:num`; `l1:(dataSem_v)list`;
         `l2:(dataSem_v)list`] THEN
      ASM_REWRITE_TAC[APPEND];
      ALL_TAC] THEN
    FIRST_ASSUM (fun ih ->
      if not (hd_is "ALL" (concl ih)) then fail() else
      FIRST_ASSUM (fun mm ->
        if not (try hd_is "MEM" (concl mm)
                with Failure _ -> false) then fail() else
        let ihe = MATCH_MP (REWRITE_RULE[GSYM ALL_MEM] ih) mm in
        FIRST_ASSUM (fun mr ->
          if not (hd_is "memory_rel" (concl mr)) then fail() else
          FIRST_ASSUM (fun elm ->
            if not (hd_is "elements_list" (concl elm)) then fail()
            else FIRST_ASSUM (fun gd ->
              if not (hd_is "good_dimindex" (concl gd)) then fail()
              else STRIP_ASSUME_TAC (MATCH_MP ihe
                     (CONJ mr (CONJ elm gd)))))))) THEN
    RULE_ASSUM_TRY (REWRITE_RULE[MAP; FST]) THEN
    FIRST_ASSUM (fun mr ->
      if not (hd_is "memory_rel" (concl mr)) then fail() else
      let stack = last (snd (strip_comb (concl mr))) in
      if not (hd_is "APPEND" stack) then fail() else
      let args = snd (strip_comb stack) in
      let pair = hd (snd (strip_comb (el 1 args))) in
      EXISTS_TAC (list_mk_icomb "APPEND"
        [el 0 args; mk_list ([pair], type_of pair)])) THEN
    REPEAT CONJ_TAC THENL
     [REWRITE_TAC[GSYM APPEND_ASSOC; APPEND] THEN
      FIRST_ASSUM ACCEPT_TAC;
      depth_conv THEN
      ASM_REWRITE_TAC[NULL_EQ; LENGTH_APPEND; LENGTH] THEN
      ARITH_TAC;
      REWRITE_TAC[MAP_APPEND; MAP; FST; GSYM APPEND_ASSOC;
                  APPEND] THEN
      FIRST_ASSUM ACCEPT_TAC];
    nb; nb])
### memory_rel_Block_ptr_eq
(* the proof of the source takes the roots of the two Blocks apart.
   An empty Block has the Data of the BlockNil of its tag for a
   root, and the and with the complement of one leaves that alone
   (the lemmas below are the ones of memory_rel_Block_IMP), so the
   tags are equal -- sixteen times a tag and two is below the word
   size, which is what makes the BlockNil of a tag tell the tag.  A
   non-empty one has a pointer, whose word is odd, so the two cases
   do not meet (word_addr_Data_NE_get_addr).  Two pointers that
   make the same word have the same address: the lower bits go in
   the shift (get_lowerbits_shift_length) and what is left is the
   address shifted up and down again (shift_shift), which is itself
   because an address of the heap is below the word size divided by
   the shift.  Then the timestamps are equal, because tf takes them
   to the one address and is injective, and blocks_unique says that
   two Blocks of one timestamp among the values are equal *)
  (let shl16 = prove
   (`!(v:(N)word). word 16 * v = word_shl v 4`,
    REWRITE_TAC[word_shl; GSYM VAL_EQ; VAL_WORD_MUL; VAL_WORD] THEN
    CONV_TAC MOD_DOWN_CONV THEN CONV_TAC NUM_REDUCE_CONV THEN
    REWRITE_TAC[MULT_AC]) in
  let shl1 = prove
   (`!(v:(N)word). word_shl v 1 = word 2 * v`,
    REWRITE_TAC[word_shl; GSYM VAL_EQ; VAL_WORD_MUL; VAL_WORD] THEN
    CONV_TAC MOD_DOWN_CONV THEN CONV_TAC NUM_REDUCE_CONV THEN
    REWRITE_TAC[MULT_AC]) in
  let andid = prove
   (`!(x:(N)word).
       word_and (word_shl x 4 + word 2) (word_not (word 1)) =
       x * word 16 + word 2`,
    GEN_TAC THEN
    SUBGOAL_THEN
      `word_shl (x:(N)word) 4 + word 2 = x * word 16 + word 2`
      SUBST1_TAC THENL
     [REWRITE_TAC[shl16] THEN CONV_TAC WORD_RULE; ALL_TAC] THEN
    SUBGOAL_THEN `~(bit 0 ((x:(N)word) * word 16 + word 2))`
      MP_TAC THENL
     [SUBGOAL_THEN `(x:(N)word) * word 16 + word 2 =
                    word_shl (word 8 * x + word 1) 1` SUBST1_TAC THENL
       [REWRITE_TAC[shl1] THEN CONV_TAC WORD_RULE; ALL_TAC] THEN
      REWRITE_TAC[BIT_WORD_SHL] THEN CONV_TAC NUM_REDUCE_CONV;
      ALL_TAC] THEN
    DISCH_TAC THEN
    REWRITE_TAC[WORD_EQ_BITS_ALT; BIT_WORD_AND; BIT_WORD_NOT;
                BIT_WORD_1] THEN
    X_GEN_TAC `i:num` THEN DISCH_TAC THEN
    ASM_CASES_TAC `(i:num) = 0` THEN ASM_REWRITE_TAC[] THEN
    CONV_TAC TAUT) in
  (* the tag of an empty Block is what its root says *)
  let bnil_inj = prove
   (`!a1 a2. (n2w a1 * word 16 + word 2:'a word) =
             n2w a2 * word 16 + word 2 /\
             a1 < dimword (:'a) DIV 16 /\
             a2 < dimword (:'a) DIV 16 ==> a1 = a2`,
    REPEAT GEN_TAC THEN STRIP_TAC THEN
    SUBGOAL_THEN
      `a1 * 16 + 2 < dimword (:'a) /\ a2 * 16 + 2 < dimword (:'a)`
      STRIP_ASSUME_TAC THENL
     [MP_TAC (SPECL [`dimword (:'a)`; `16`] DIVISION) THEN
      CONV_TAC NUM_REDUCE_CONV THEN ASM_ARITH_TAC; ALL_TAC] THEN
    FIRST_X_ASSUM (fun eq ->
      if not (try hd_is "word_add" (lhs (concl eq))
              with Failure _ -> false) then fail() else
      MP_TAC (REWRITE_RULE[GSYM VAL_EQ; VAL_WORD_ADD; VAL_WORD_MUL;
                           VAL_WORD; GSYM dimword] eq)) THEN
    CONV_TAC MOD_DOWN_CONV THEN
    ASM_SIMP_TAC[MOD_LT] THEN ARITH_TAC) in
  (* a pointer below the heap is below the words *)
  let mul_lt = prove
   (`!p h d k. p < h /\ h <= d DIV k /\ ~(k = 0) ==> p * k < d`,
    REPEAT GEN_TAC THEN STRIP_TAC THEN
    MATCH_MP_TAC LTE_TRANS THEN
    EXISTS_TAC `(d DIV k) * k` THEN CONJ_TAC THENL
     [ASM_REWRITE_TAC[LT_MULT_RCANCEL] THEN ASM_ARITH_TAC;
      MP_TAC (SPECL [`d:num`; `k:num`] DIVISION) THEN
      ASM_REWRITE_TAC[] THEN ARITH_TAC]) in
  let n2w_inj = prove
   (`!a b. (n2w a:'a word) = n2w b /\ a < dimword (:'a) /\
           b < dimword (:'a) ==> a = b`,
    REPEAT GEN_TAC THEN STRIP_TAC THEN
    FIRST_X_ASSUM (fun eq ->
      if not (try is_eq (concl eq) && hd_is "word" (lhs (concl eq))
              with Failure _ -> false) then fail() else
      MP_TAC (REWRITE_RULE[GSYM VAL_EQ; VAL_WORD; GSYM dimword]
                eq)) THEN
    ASM_SIMP_TAC[MOD_LT]) in
  let exp2_nz = prove
   (`!n. ~(2 EXP n = 0)`,
    REWRITE_TAC[EXP_EQ_0; ARITH_EQ]) in
  let lt_mul = prove
   (`!p k d. p * k < d /\ ~(k = 0) ==> p < d`,
    REPEAT GEN_TAC THEN STRIP_TAC THEN
    MATCH_MP_TAC LET_TRANS THEN EXISTS_TAC `(p:num) * k` THEN
    ASM_REWRITE_TAC[] THEN
    SUBGOAL_THEN `(p:num) * 1 <= p * k` MP_TAC THENL
     [REWRITE_TAC[LE_MULT_LCANCEL] THEN ASM_ARITH_TAC;
      ARITH_TAC]) in
  (* two timestamps that the map takes to one address are one *)
  let flookup_inj = prove
   (`!(f:(num,num)fmap) s x y p.
       INJ (FAPPLY f) (FDOM f) s /\ FLOOKUP f x = SOME p /\
       FLOOKUP f y = SOME p ==> x = y`,
    REWRITE_TAC[INJ; FLOOKUP_DEF] THEN REPEAT GEN_TAC THEN
    REPEAT COND_CASES_TAC THEN
    REWRITE_TAC[distinctness "option"; injectivity "option"] THEN
    ASM_MESON_TAC[]) in
  let tl_hd = MATCH_MP (GEN_ALL IN_all_vs_TL) IN_all_vs_HD in
  MEMORY_REL_TAC THEN SPLIT_ROOTS_TAC THEN
  RULE_ASSUM_TRY (REWRITE_RULE[v_inv_def]) THEN
  ASM_CASES_TAC `b1:(dataSem_v)list = []` THEN
  FIRST_ASSUM (fun e ->
    RULE_ASSUM_TRY (REWRITE_RULE[e]) THEN ASSUME_TAC e) THEN
  ASM_CASES_TAC `b2:(dataSem_v)list = []` THEN
  FIRST_ASSUM (fun e ->
    RULE_ASSUM_TRY (REWRITE_RULE[e]) THEN ASSUME_TAC e) THEN
  REPEAT (FIRST_X_ASSUM (CONJUNCTS_THEN ASSUME_TAC)) THEN
  REPEAT (FIRST_X_ASSUM (fun th ->
    if is_exists (concl th) then CHOOSE_TAC th else fail())) THEN
  REPEAT (FIRST_X_ASSUM (CONJUNCTS_THEN ASSUME_TAC)) THEN
  REPEAT SUBST_LHS_TAC THEN
  RULE_ASSUM_TRY (REWRITE_RULE (word_addr_clauses () @
    [distinctness "word_loc"; injectivity "word_loc"])) THEN
  TRY (FIRST_ASSUM (fun eq ->
    if (try is_eq (concl eq) && is_var (rand (concl eq)) &&
            not (is_var (lhs (concl eq)))
        with Failure _ -> false)
    then SUBST_ALL_TAC (SYM eq) else fail())) THEN
  RULE_ASSUM_TRY (REWRITE_RULE[injectivity "word_loc";
                               distinctness "word_loc"]) THENL
   [(* both Blocks are empty: their roots are the BlockNils of the
       tags, whose and with the complement of one is themselves *)
    FIRST_ASSUM (fun eq ->
      if not (try hd_is "word_and" (lhs (concl eq))
              with Failure _ -> false) then fail() else
      let eq' = REWRITE_RULE[BlockNil_def; andid] eq in
      FIRST_ASSUM (fun lt1 ->
        FIRST_ASSUM (fun lt2 ->
          if concl lt1 = concl lt2 then fail() else
          STRIP_ASSUME_TAC (MATCH_MP bnil_inj
            (CONJ eq' (CONJ lt1 lt2)))))) THEN
    ASM_REWRITE_TAC[];
    (* one is empty and the other is not: a Data is not the word
       of an address, whose lowest bit is set *)
    FIRST_ASSUM (fun eq ->
      let mk side rl =
        let ga = PART_MATCH (rand o rator) (GEN_ALL get_addr_0)
                   (side (concl eq)) in
        REWRITE_RULE[rl eq; word_index; BIT_WORD_AND; BIT_WORD_NOT;
                     BIT_WORD_1] ga in
      let th = (try mk rand GSYM
                with Failure _ -> mk lhs (fun t -> t)) in
      if concl th = `F` then CONTR_TAC th else fail());
    FIRST_ASSUM (fun eq ->
      let mk side rl =
        let ga = PART_MATCH (rand o rator) (GEN_ALL get_addr_0)
                   (side (concl eq)) in
        REWRITE_RULE[rl eq; word_index; BIT_WORD_AND; BIT_WORD_NOT;
                     BIT_WORD_1] ga in
      let th = (try mk rand GSYM
                with Failure _ -> mk lhs (fun t -> t)) in
      if concl th = `F` then CONTR_TAC th else fail());
    (* both are pointers, and the addresses they shift up are the
       same, so the timestamps that the map takes to them are the
       same, and then blocks_unique says the Blocks are *)
    FIRST_ASSUM (fun h ->
      if hd_is "heap_in_memory_store" (concl h)
      then STRIP_ASSUME_TAC
             (REWRITE_RULE[heap_in_memory_store_def] h)
      else fail()) THEN
    ASSUM_LIST (fun asl ->
      let mkbound hl =
        FIRST_ASSUM (fun hb ->
          if not (try hd_is "heap_length" (lhand (concl hb)) &&
                      hd_is "DIV" (rand (concl hb))
                  with Failure _ -> false) then fail() else
          let k = rand (rand (concl hb)) in
          let th = MATCH_MP mul_lt
            (CONJ (MATCH_MP (GEN_ALL heap_lookup_LESS) hl)
                  (CONJ hb (SPEC (rand k) exp2_nz))) in
          STRIP_ASSUME_TAC th THEN
          STRIP_ASSUME_TAC (MATCH_MP lt_mul
            (CONJ th (SPEC (rand k) exp2_nz)))) in
      MAP_EVERY mkbound (filter (fun th ->
        try hd_is "heap_lookup" (lhs (concl th))
        with Failure _ -> false) asl)) THEN
    FIRST_ASSUM (fun eq ->
      if not (try hd_is "get_addr" (lhs (concl eq)) &&
                  hd_is "get_addr" (rand (concl eq))
              with Failure _ -> false) then fail() else
      let slt = cake_as_vars (fun () -> `shift_length c`) in
      let v = mk_var ("w", type_of (lhs (concl eq))) in
      let f = mk_abs (v, list_mk_icomb "word_ushr" [v; slt]) in
      MP_TAC (CONV_RULE (TOP_DEPTH_CONV BETA_CONV)
                (AP_TERM f (REWRITE_RULE[get_addr_def] eq)))) THEN
    REWRITE_TAC[MATCH_MP (GEN_ALL get_lowerbits_shift_length)
                  get_lowerbits_LSL_shift_length] THEN
    ASM_SIMP_TAC[shift_shift] THEN
    DISCH_THEN (fun eq ->
      FIRST_ASSUM (fun lt1 ->
        FIRST_ASSUM (fun lt2 ->
          if concl lt1 = concl lt2 then fail() else
          SUBST_ALL_TAC (MATCH_MP n2w_inj
            (CONJ eq (CONJ lt1 lt2)))))) THEN
    FIRST_ASSUM (fun inj ->
      if not (try hd_is "INJ" (concl inj) with Failure _ -> false)
      then fail() else
      FIRST_ASSUM (fun f1 ->
        if not (try hd_is "FLOOKUP" (lhs (concl f1))
                with Failure _ -> false) then fail() else
        FIRST_ASSUM (fun f2 ->
          if concl f1 = concl f2 then fail() else
          SUBST_ALL_TAC (MATCH_MP flookup_inj
            (CONJ inj (CONJ f1 f2)))))) THEN
    W(fun (asl,gl) ->
      let bl1 = lhs gl and bl2 = rand gl in
      let a1 = snd (strip_comb bl1) and a2 = snd (strip_comb bl2) in
      FIRST_ASSUM (fun bu ->
        if not (hd_is "blocks_unique" (concl bu)) then fail() else
        MP_TAC (SPECL [el 0 a1; el 1 a1; el 2 a1; el 1 a2; el 2 a2]
                  (REWRITE_RULE[blocks_unique_def] bu)))) THEN
    ASM_REWRITE_TAC[IN_all_vs_HD; tl_hd] THEN
    DISCH_THEN (fun th -> ASM_REWRITE_TAC[th])])
### memory_rel_elements_list_distinct_lemma
(* the proof of the source is by contradiction:
   not_all_distinct_map_snd gives two pairs of the stack with the
   same word, elements_list_all_blocks says the values are blocks
   and sorted by their size, so the earlier of the two is the
   smaller (sorted_pair above), and memory_rel_Block_ptr_eq says
   that two blocks the memory holds the same word for are the same
   block -- which the two sizes say they are not *)
  (let hd_of n t =
    (try fst (dest_const (fst (strip_comb t))) = n
     with Failure _ -> false) in
  REPEAT GEN_TAC THEN STRIP_TAC THEN
  (* by contradiction: two pairs of the stack with the same word *)
  MATCH_MP_TAC (TAUT `(~p ==> F) ==> p`) THEN DISCH_TAC THEN
  FIRST_ASSUM (fun nd ->
    STRIP_ASSUME_TAC (MATCH_MP not_all_distinct_map_snd nd)) THEN
  REPEAT (FIRST_X_ASSUM (fun th ->
    if (try is_eq (concl th) && is_var (lhs (concl th)) &&
            not (is_var (rand (concl th)))
        with Failure _ -> false)
    then SUBST_ALL_TAC th else fail())) THEN
  (* the values of the stack are blocks, and sorted by their
     size *)
  W(fun gl ->
    let e1 = the_asm (hd_of "elements_list") gl in
    let e2 = the_asm (fun c ->
               try is_neg c && is_eq (rand c) &&
                   hd_of "MAP" (lhand (rand c))
               with Failure _ -> false) gl in
    let hh = the_asm (fun c ->
               try is_eq c && hd_of "HD" (lhs c)
               with Failure _ -> false) gl in
    let ps = snd (strip_comb (rand (concl hh))) in
    let vs = map (fun t -> genvar (type_of t)) ps in
    let ex = list_mk_exists (vs,
               mk_eq (lhs (concl hh),
                 list_mk_comb (fst (strip_comb (rand (concl hh))),
                   vs))) in
    SUBGOAL_THEN ex (fun e ->
      STRIP_ASSUME_TAC (MATCH_MP elements_list_all_blocks
        (CONJ e1 (CONJ e2 e)))) THENL
     [MAP_EVERY EXISTS_TAC ps THEN ACCEPT_TAC hh; ALL_TAC]) THEN
  (* the two words of the two pairs, and the size of the first is
     below the size of the second *)
  RULE_ASSUM_TRY (REWRITE_RULE[MAP_APPEND; MAP; FST;
                               ALL_APPEND; ALL]) THEN
  REPEAT (FIRST_X_ASSUM (fun th ->
    if is_conj (concl th) || is_exists (concl th)
    then STRIP_ASSUME_TAC th else fail())) THEN
  W(fun gl ->
    let so = the_asm (hd_of "SORTED") gl in
    let r = el 0 (snd (strip_comb (concl so))) in
    let ty = hd (snd (dest_type (type_of r))) in
    let a = mk_var ("a",ty) and b = mk_var ("b",ty)
    and c = mk_var ("c",ty) in
    let ap x y = mk_comb (mk_comb (r,x), y) in
    let tr = prove (list_mk_forall ([a;b;c],
               mk_imp (mk_conj (ap a b, ap b c), ap a c)),
               REWRITE_TAC[] THEN ARITH_TAC) in
    ASSUME_TAC (REWRITE_RULE[]
      (MATCH_MP sorted_pair (CONJ tr so)))) THEN
  (* both of them are blocks *)
  REPEAT (FIRST_X_ASSUM (fun th ->
    if (try is_eq (concl th) && is_var (lhs (concl th)) &&
            hd_of "dataSem_Block" (rand (concl th))
        with Failure _ -> false)
    then SUBST_ALL_TAC th else fail())) THEN
  (* so the memory holds the same word for two blocks, and
     memory_rel_Block_ptr_eq says they are the same block *)
  W(fun gl ->
    let mr = the_asm (fun c ->
               try length (snd (strip_comb c)) = 9 && not (is_eq c)
               with Failure _ -> false) gl in
    let lst = last (snd (strip_comb (concl mr))) in
    let p1 = hd (dest_list (lhand (rand lst))) in
    let p2 = hd (dest_list (lhand (rand (rand (rand lst))))) in
    SUBGOAL_THEN (mk_comb (rator (concl mr),
                    mk_list ([p1; p2], type_of p1))) ASSUME_TAC THENL
     [MP_TAC mr THEN MATCH_MP_TAC memory_rel_rearrange THEN
      REWRITE_TAC[MEM; MEM_APPEND] THEN MESON_TAC[];
      ALL_TAC]) THEN
  W(fun gl ->
    let mr2 = the_asm (fun c ->
                try length (dest_list (last (snd (strip_comb c))))
                    = 2
                with Failure _ -> false) gl in
    let gd = the_asm (fun c -> c = `good_dimindex (:'a)`) gl in
    MP_TAC (MATCH_MP memory_rel_Block_ptr_eq (CONJ mr2 gd))) THEN
  DISCH_THEN (fun e -> RULE_ASSUM_TRY (REWRITE_RULE[e])) THEN
  W(fun gl ->
    MP_TAC (the_asm (fun c ->
      try is_binop `(<):num->num->bool` c with Failure _ -> false)
      gl)) THEN
  ARITH_TAC)
### memory_rel_depth_size_limit
  (* the attempt: the proof of the source names vb_size_def,
     NULL_EQ, memory_rel_Block_IMP, dimword, good_dimindex_def,
     MAX_LIST.  What is here rewrites with them and closes by
     arithmetic, and the cheat is behind it until the proof is
     written.  A MESON over them is what the next round adds; it
     costs a load ten minutes to have it in every attempt and it
     closed none of them *)
  (ATTEMPT_TAC 2
    (REPEAT GEN_TAC THEN REPEAT STRIP_TAC THEN
     ASM_REWRITE_TAC[vb_size_def; NULL_EQ; memory_rel_Block_IMP;
       dimword; good_dimindex_def; MAX_LIST] THEN
     TRY ASM_ARITH_TAC))
### vb_eq_size_IMP_vb_size
  (* the complete induction on the size of the value that the
     definition recurses on (PORTING-GUIDE.md entry 44), with
     the measure bounded so that the hypothesis is about the
     measure of a sub-term.  What a value of the two functions
     can be is above the statement (tools/overrides.py): of a
     value one word or one more than what the payloads of two
     Blocks took, of a list nothing or the element and then the
     rest.  The payload of a Block is smaller than the Block
     (vb_size_Block) and so are an element of a list and the
     rest of it, which is what the bound of each use of the
     hypothesis comes to; the leaves are arithmetic *)
  ((* the measure of a list of values: what the statement about the
     list function bounds its value by *)
  let meas l = mk_binop `(+):num->num->num`
      (list_mk_icomb "SUM" [list_mk_icomb "MAP" [`vb_size`; l]])
      (list_mk_icomb "LENGTH" [l]) in
  (* the hypothesis of the complete induction at a measure, used
     on an equation of the assumptions: the bound is the first
     goal, and the value of the sub-term is bounded in the second *)
  let use_ih which t eq (asl,w as gl) =
    let ih = the_asm (fun c -> is_forall c &&
               (try hd_is "<" (lhand (snd (strip_forall c)))
                with Failure _ -> false)) gl in
    let kk = rand (lhand (snd (strip_forall (concl ih)))) in
    (SUBGOAL_THEN (mk_binop `(<):num->num->bool` t kk)
       (fun lt -> MP_TAC (MATCH_MP (which (MP (SPEC t ih) lt))
                            (CONJ (SPEC t LE_REFL) eq)))) gl in
  (* the equation of the assumptions that a function left, with
     the sub-term it is about *)
  let the_eq nm vr gl =
    let eq = the_asm (fun c -> is_eq c && hd_is nm (lhand c) &&
               (not vr ||
                (try is_var (el 1 (snd (strip_comb (lhand c))))
                 with Failure _ -> false))) gl in
    eq,el 1 (snd (strip_comb (lhand (concl eq)))) in
  (* the statement of the induction, with the measure bounded, so
     that the hypothesis is about the measure of a sub-term and not
     about the bound (PORTING-GUIDE.md entry 5) *)
  SUBGOAL_THEN
   `!k. (!(refs:('a bvlSem_ref) spt) v1 v2 n b.
           vb_size v1 <= k /\ vb_eq_size refs v1 v2 = SOME (n,b)
           ==> n <= vb_size v1) /\
        (!(refs:('a bvlSem_ref) spt) v1 v2 n b.
           SUM (MAP vb_size v1) + LENGTH v1 <= k /\
           vb_eq_size_list refs v1 v2 = SOME (n,b)
           ==> n <= SUM (MAP vb_size v1) + LENGTH v1)`
   (fun th ->
      CONJ_TAC THEN REPEAT GEN_TAC THEN DISCH_TAC THENL
       [MP_TAC (CONJUNCT1 (SPEC `vb_size (v1:dataSem_v)` th));
        MP_TAC (CONJUNCT2 (SPEC
          `SUM (MAP vb_size (v1:dataSem_v list)) +
           LENGTH (v1:dataSem_v list)` th))] THEN
      ASM_MESON_TAC[LE_REFL]) THEN
  MATCH_MP_TAC num_WF THEN GEN_TAC THEN DISCH_TAC THEN
  CONJ_TAC THEN REPEAT GEN_TAC THEN STRIP_TAC THENL
   [(* a value: its size is one word, or one more than what the
       payloads of two Blocks took *)
    FIRST_ASSUM (fun eq ->
      if not (is_eq (concl eq) &&
              hd_is "vb_eq_size" (lhand (concl eq))) then fail()
      else STRIP_ASSUME_TAC (MATCH_MP vb_eq_size_cases eq)) THEN
    TRY (SOLVED (ASM_REWRITE_TAC[vb_size_ge_1])) THEN
    REPEAT (FIRST_X_ASSUM (fun th ->
      let c = concl th in
      if is_eq c && is_var (lhand c) &&
         not (vfree_in (lhand c) (rand c))
      then SUBST_ALL_TAC th else fail())) THEN
    RULE_ASSUM_TRY (REWRITE_RULE[vb_size_Block]) THEN
    REWRITE_TAC[vb_size_Block] THEN
    (* the payload is smaller than the Block it is in *)
    W(fun gl ->
      let lk,l1 = the_eq "vb_eq_size_list" false gl in
      use_ih CONJUNCT2 (meas l1) lk) THEN
    TRY (SOLVED ARITH_ASM_TAC) THEN
    ARITH_TAC;
    (* a list of values: nothing, or its first element and the
       rest of the list *)
    FIRST_ASSUM (fun eq ->
      if not (is_eq (concl eq) &&
              hd_is "vb_eq_size_list" (lhand (concl eq)))
      then fail()
      else STRIP_ASSUME_TAC (MATCH_MP vb_eq_size_list_cases eq)) THEN
    TRY (SOLVED (ASM_REWRITE_TAC[LE_0])) THEN
    REPEAT (FIRST_X_ASSUM (fun th ->
      let c = concl th in
      if is_eq c && is_var (lhand c) &&
         not (vfree_in (lhand c) (rand c))
      then SUBST_ALL_TAC th else fail())) THEN
    RULE_ASSUM_TRY (REWRITE_RULE[MAP; LENGTH; vb_sum_clauses]) THEN
    REWRITE_TAC[MAP; LENGTH; vb_sum_clauses] THEN
    (* the element is smaller than the list it is in *)
    W(fun gl ->
      let eq,x1 = the_eq "vb_eq_size" false gl in
      use_ih CONJUNCT1 (list_mk_icomb "vb_size" [x1]) eq) THEN
    TRY (SOLVED ARITH_ASM_TAC) THEN
    (* and so is the rest of it, where the value of the element
       left one *)
    TRY (W(fun gl ->
           let lk,t1 = the_eq "vb_eq_size_list" true gl in
           use_ih CONJUNCT2 (meas t1) lk)) THEN
    TRY (SOLVED ARITH_ASM_TAC) THEN
    ARITH_TAC])
### memory_rel_limit
(* the proof of the source bounds the size by
   memory_rel_depth_size_limit and vb_eq_size_IMP_vb_size, and the
   depth by the stack that memory_rel_depth_limit gives: its roots
   are distinct (memory_rel_elements_list_distinct) words
   (memory_rel_elements_list_words), so there are no more of them
   than there are words (word_list_limit).  What is left is the
   arithmetic, which is the lemma below: the size is at most the
   word size to the depth and one more, the depth at most the word
   size, and the limit of the source has the word size to the word
   size to the word size in it *)
  (let mtl = prove
   (`!n d l. 2 <= d /\ n <= d EXP (l + 1) /\ l <= d ==>
       n * d < (2 * d + d * d + d EXP d + d EXP d EXP d) - d`,
    REPEAT GEN_TAC THEN STRIP_TAC THEN
    SUBGOAL_THEN `~(d = 0) /\ ~(d = 1)` STRIP_ASSUME_TAC THENL
     [ASM_ARITH_TAC; ALL_TAC] THEN
    MATCH_MP_TAC (ARITH_RULE
      `!p q r s t. 1 <= q /\ p <= t
                   ==> p < (2 * q + r + s + t) - q`) THEN
    CONJ_TAC THENL [ASM_ARITH_TAC; ALL_TAC] THEN
    MATCH_MP_TAC LE_TRANS THEN EXISTS_TAC `d EXP (l + 2)` THEN
    CONJ_TAC THENL
     [RULE_ASSUM_TRY (REWRITE_RULE[EXP_ADD; EXP_1]) THEN
      ONCE_REWRITE_TAC[ARITH_RULE `l + 2 = (l + 1) + 1`] THEN
      REWRITE_TAC[EXP_ADD; EXP_1] THEN
      MATCH_MP_TAC LE_MULT2 THEN ASM_REWRITE_TAC[LE_REFL];
      MATCH_MP_TAC LE_TRANS THEN EXISTS_TAC `d EXP (d + 2)` THEN
      CONJ_TAC THENL
       [ASM_REWRITE_TAC[LE_EXP] THEN ASM_ARITH_TAC;
        REWRITE_TAC[GSYM EXP_MULT] THEN
        ASM_REWRITE_TAC[LE_EXP] THEN
        MATCH_MP_TAC LE_TRANS THEN EXISTS_TAC `(d:num) * 2` THEN
        CONJ_TAC THENL
         [ASM_ARITH_TAC; ASM_REWRITE_TAC[LE_MULT_LCANCEL]]]]) in
  REPEAT GEN_TAC THEN STRIP_TAC THEN
  SUBGOAL_THEN `2 <= dimword (:'a)` ASSUME_TAC THENL
   [FIRST_ASSUM (fun gd ->
      if hd_is "good_dimindex" (concl gd)
      then MP_TAC (REWRITE_RULE[good_dimindex_def] gd)
      else fail()) THEN
    STRIP_TAC THEN ASM_REWRITE_TAC[dimword] THEN
    CONV_TAC NUM_REDUCE_CONV;
    ALL_TAC] THEN
  FIRST_ASSUM (fun vb ->
    if (try hd_is "vb_eq_size" (lhs (concl vb))
        with Failure _ -> false)
    then STRIP_ASSUME_TAC
           (MATCH_MP (CONJUNCT1 vb_eq_size_IMP_vb_size) vb)
    else fail()) THEN
  FIRST_ASSUM (fun mr ->
    if not (hd_is "memory_rel" (concl mr)) then fail() else
    FIRST_ASSUM (fun gd ->
      if not (hd_is "good_dimindex" (concl gd)) then fail() else
      STRIP_ASSUME_TAC (MATCH_MP (GEN_ALL
        memory_rel_depth_size_limit) (CONJ mr gd)))) THEN
  SUBGOAL_THEN (cake_as_vars (fun () ->
    `memory_rel c be ts refs sp st m dm
       [(v1,(w1:'a word_loc))]`)) ASSUME_TAC THENL
   [FIRST_ASSUM (fun mr ->
      if not (hd_is "memory_rel" (concl mr)) then fail() else
      MP_TAC mr THEN MATCH_MP_TAC memory_rel_rearrange THEN
      REWRITE_TAC[MEM] THEN MESON_TAC[]);
    ALL_TAC] THEN
  FIRST_ASSUM (fun mr1 ->
    if not (hd_is "memory_rel" (concl mr1)) then fail() else
    let stack = last (snd (strip_comb (concl mr1))) in
    if not (length (dest_list stack) = 1) then fail() else
    FIRST_ASSUM (fun gd ->
      if not (hd_is "good_dimindex" (concl gd)) then fail() else
      let el1 = prove
        (`elements_list (CONS (v1:dataSem_v)
            (MAP FST ([]:(dataSem_v # ('a word_loc))list)))`,
         REWRITE_TAC[MAP; elements_list_def]) in
      STRIP_ASSUME_TAC (MATCH_MP (GEN_ALL memory_rel_depth_limit)
        (CONJ mr1 (CONJ el1 gd))))) THEN
  RULE_ASSUM_TRY (REWRITE_RULE[MAP]) THEN
  MP_TAC (ISPECL
    [`MAP FST (ls:(dataSem_v # ('a word_loc))list) ++ [v1]`;
     `(ls:(dataSem_v # ('a word_loc))list) ++ [v1,(w1:'a word_loc)]`]
    memory_rel_elements_list_distinct) THEN
  ASM_REWRITE_TAC[MAP_APPEND; MAP; FST] THEN DISCH_TAC THEN
  MP_TAC (ISPECL
    [`MAP FST (ls:(dataSem_v # ('a word_loc))list) ++ [v1]`;
     `(ls:(dataSem_v # ('a word_loc))list) ++ [v1,(w1:'a word_loc)]`]
    memory_rel_elements_list_words) THEN
  ASM_REWRITE_TAC[MAP_APPEND; MAP; FST; APPEND_EQ_NIL;
                  NOT_CONS_NIL] THEN
  DISCH_TAC THEN
  SUBGOAL_THEN `LENGTH (ls:(dataSem_v # ('a word_loc))list)
                  <= dimword (:'a)` ASSUME_TAC THENL
   [ASM_CASES_TAC `ls:(dataSem_v # ('a word_loc))list = []` THENL
     [ASM_REWRITE_TAC[LENGTH] THEN ASM_ARITH_TAC; ALL_TAC] THEN
    MP_TAC (ISPEC `ls:(dataSem_v # ('a word_loc))list`
              list_CASES) THEN
    ASM_REWRITE_TAC[] THEN
    DISCH_THEN (REPEAT_TCL CHOOSE_THEN SUBST_ALL_TAC) THEN
    RULE_ASSUM_TRY (REWRITE_RULE[APPEND; MAP; MAP_APPEND; FST;
                                 SND; hol4_TL]) THEN
    FIRST_ASSUM (fun ev ->
      if not (hd_is "ALL" (concl ev)) then fail() else
      FIRST_ASSUM (fun ad ->
        if not (hd_is "ALL_DISTINCT" (concl ad)) then fail() else
        MP_TAC (MATCH_MP (GEN_ALL word_list_limit)
