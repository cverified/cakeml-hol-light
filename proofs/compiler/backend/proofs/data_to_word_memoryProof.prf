     REWRITE_TAC[cake_def "ADDR_MAP"; ALL2_DEF] THEN
     CASES_BY_NAME "h" THEN
     REWRITE_TAC[cake_def "ADDR_MAP"; cake_def "ADDR_APPLY";
                 ALL2_DEF] THEN
