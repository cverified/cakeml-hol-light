### list_to_BlockReps_Pointer_lem
  (* the induction of the source over the list.  The element is a
     block of the rest of the list, which the induction hypothesis
     is about, or the block that points at the next one (and then
     the pointer is the address of the next block, which
     list_to_BlockReps_heap_lookup_0 says is an element), or the
     last block, which holds the tail of the list *)
  (LIST_INDUCT_TAC THEN REPEAT GEN_TAC THEN
   CONV_TAC(DEPTH_CONV let_CONV) THEN
   REWRITE_TAC[NOT_CONS_NIL] THEN
   CASES_ON_NAME "t" THENL
    [(* one element, whose block holds the head and the tail *)
     ONCE_REWRITE_TAC[list_to_BlockReps_def] THEN
     MATCH_REDUCE_TAC THEN
     REWRITE_TAC[MEM; BlockRep_def; injectivity "heap_element"] THEN
     STRIP_TAC THEN VAR_EQ_TAC THEN
     RULE_ASSUM_TAC(REWRITE_RULE[MEM]) THEN
     ASM_REWRITE_TAC[MEM] THEN ASM_MESON_TAC[];
     ALL_TAC] THEN
   STRIP_TAC THEN
   (* the block of the element is one of the three that
      list_to_BlockReps_MEM gives *)
   FIRST_ASSUM (fun a1 ->
     if not (hd_is "MEM" (concl a1) &&
             hd_is "list_to_BlockReps" (rand (concl a1))) then fail()
     else STRIP_ASSUME_TAC
            (MATCH_MP (GEN_ALL list_to_BlockReps_MEM) a1)) THENL
    [(* a block of the rest, which the induction hypothesis is
         about *)
     FIRST_X_ASSUM (fun ih ->
       if not (is_forall (concl ih)) then fail() else
       let ih2 = REWRITE_RULE[NOT_CONS_NIL]
                   (CONV_RULE(DEPTH_CONV let_CONV) ih) in
       FIRST_ASSUM (fun a1 -> FIRST_ASSUM (fun a2 ->
         MP_TAC (MATCH_MP ih2 (CONJ a1 a2))))) THEN
     STRIP_TAC THENL
      [ASM_MESON_TAC[];
       ASM_REWRITE_TAC[MEM] THEN ASM_MESON_TAC[];
       DISJ2_TAC THEN DISJ2_TAC THEN
       ONCE_REWRITE_TAC[list_to_BlockReps_def] THEN
       MATCH_REDUCE_TAC THEN
       REWRITE_TAC[heap_length_CONS; BlockRep_def; el_length_def;
                   LENGTH; heap_lookup_def] THEN
       CONV_TAC NUM_REDUCE_CONV THEN
       REPEAT CONJ_TAC THENL
        [ASM_ARITH_TAC;
         ASM_ARITH_TAC;
         ASM_SIMP_TAC[ARITH_RULE
                        `ptr > len + 3 ==> ~(ptr - len = 0)`;
                      ARITH_RULE
                        `ptr > len + 3 ==> ~(ptr - len < 3)`;
                      ARITH_RULE
                        `ptr > len + 3
                         ==> ptr - len - 3 = ptr - (len + 3)`] THEN
         FIRST_ASSUM ACCEPT_TAC]];
     (* or the block that points at the next one *)
     RULE_ASSUM_TAC(REWRITE_RULE[BlockRep_def;
                                 injectivity "heap_element"]) THEN
     SPLIT_ASM_TAC THEN VAR_EQ_TAC THEN
     RULE_ASSUM_TAC(REWRITE_RULE[MEM]) THEN
     FIRST_X_ASSUM (fun mm ->
       if not (is_disj (concl mm)) then fail() else
       DISJ_CASES_THEN2 (fun e -> REWRITE_TAC[MEM] THEN
                                  MESON_TAC[e])
         (fun e ->
           MP_TAC (REWRITE_RULE[injectivity "heap_address"] e))
         mm) THEN
     STRIP_TAC THEN VAR_EQ_TAC THEN
     DISJ2_TAC THEN DISJ2_TAC THEN
     REPEAT CONJ_TAC THENL
      [ASM_SIMP_TAC[GEN_ALL list_to_BlockReps_heap_length;
                    NOT_CONS_NIL; LENGTH] THEN
       ARITH_TAC;
       ARITH_TAC;
       ONCE_REWRITE_TAC[list_to_BlockReps_def] THEN
       MATCH_REDUCE_TAC THEN
       REWRITE_TAC[heap_lookup_def; BlockRep_def; el_length_def;
                   LENGTH] THEN
       CONV_TAC NUM_REDUCE_CONV THEN
       REWRITE_TAC[ARITH_RULE `(len + 3) - len = 3`] THEN
       CONV_TAC NUM_REDUCE_CONV THEN
       MATCH_MP_TAC (GEN_ALL list_to_BlockReps_heap_lookup_0) THEN
       REWRITE_TAC[NOT_CONS_NIL]];
     (* or the block that holds the tail *)
     RULE_ASSUM_TAC(REWRITE_RULE[BlockRep_def;
                                 injectivity "heap_element"]) THEN
     SPLIT_ASM_TAC THEN VAR_EQ_TAC THEN
     RULE_ASSUM_TAC(REWRITE_RULE[MEM]) THEN
     ASM_REWRITE_TAC[MEM] THEN ASM_MESON_TAC[]])
