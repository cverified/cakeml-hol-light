    (`!(l1:(A)list) c l2.
        EL (LENGTH l1) (APPEND l1 (CONS c l2)) = c`,
    LIST_INDUCT_TAC THEN REPEAT GEN_TAC THEN
    REWRITE_TAC[LENGTH; APPEND; EL; HD; TL] THEN
    ASM_REWRITE_TAC[]) in
   STRIP_TAC THEN
   FIRST_X_ASSUM (fun inv ->
     if not (hd_is "bc_stack_ref_inv" (concl inv)) then fail() else
     STRIP_ASSUME_TAC
       (REWRITE_RULE[bc_stack_ref_inv_def; ALL2] inv)) THEN
   CONV_TAC(TOP_DEPTH_CONV BETA_CONV) THEN
   RULE_ASSUM_TRY (CONV_RULE(TOP_DEPTH_CONV BETA_CONV)) THEN
   (* the pointer of the reference *)
   FIRST_ASSUM (fun lk ->
     if not (is_eq (concl lk) &&
             hd_is "bvlSem_MutBlock" (rand (rhs (concl lk))))
     then fail() else
     FIRST_ASSUM (fun vi ->
       if not (hd_is "v_inv" (concl vi)) then fail() else
       MP_TAC (REWRITE_RULE[lk; injectivity "option";
                            distinctness "bvlSem_ref"]
                 (ONCE_REWRITE_RULE[v_inv_def] vi)))) THEN
   STRIP_TAC THEN
   (* the reference is reachable from the stack, so the invariant
      holds of its block *)
   FIRST_ASSUM (fun rr ->
     let bod = snd (strip_forall (concl rr)) in
     if not (is_imp bod && hd_is "bc_ref_inv" (rand bod)) then fail()
     else MP_TAC (SPEC `ptr:num` rr)) THEN
   (ANTS_TAC THENL
    [CONJ_TAC THENL
      [REWRITE_TAC[reachable_refs_def] THEN
       EXISTS_TAC `RefPtr b ptr` THEN EXISTS_TAC `ptr:num` THEN
       REWRITE_TAC[MEM; get_refs_def] THEN
       MESON_TAC[RTC_RULES];
       FIRST_ASSUM ACCEPT_TAC];
     ALL_TAC]) THEN
   ASM_SIMP_TAC[bc_ref_inv_def; FLOOKUP_DEF] THEN
   MATCH_REDUCE_TAC THEN
   CONV_TAC(TOP_DEPTH_CONV let_CONV) THEN
   STRIP_TAC THEN
   (* the block, whose payload holds the centre *)
   FIRST_ASSUM (fun lr ->
     if not (hd_is "ALL2" (concl lr)) then fail() else
     MP_TAC (REWRITE_RULE[LIST_REL_EL_EQN] lr)) THEN
   REWRITE_TAC[LENGTH_APPEND; LENGTH] THEN
   CONV_TAC NUM_REDUCE_CONV THEN
   DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC
     (fun el -> MP_TAC (SPEC `LENGTH (left:(dataSem_v)list)` el))) THEN
   (ANTS_TAC THENL [ASM_ARITH_TAC; ALL_TAC]) THEN
   REWRITE_TAC[APPEND; el_mid] THEN
   CONV_TAC(TOP_DEPTH_CONV BETA_CONV) THEN
   STRIP_TAC THEN
   (* and then the invariant of the longer stack *)
   W(fun (asl,w) ->
     let hl = find (fun (_,th) -> is_eq (concl th) &&
                      hd_is "heap_lookup" (lhs (concl th))) asl in
     let ptr_n = rand (rator (lhs (concl (snd hl)))) in
     let zs = rand (rand (rand (concl (snd hl)))) in
     EXISTS_TAC ptr_n THEN EXISTS_TAC zs) THEN
   REPEAT CONJ_TAC THEN TRY (FIRST_ASSUM ACCEPT_TAC) THEN
   TRY ASM_ARITH_TAC THEN
   (W(fun (asl,w) ->
       let sub p = rand (lhand (concl (snd (find (fun (_,th) ->
         hd_is "SUBSET" (concl th) &&
         hd_is p (rand (concl th))) asl)))) in
       REWRITE_TAC[bc_stack_ref_inv_def] THEN
       EXISTS_TAC (sub "domain") THEN EXISTS_TAC (sub "all_ts")) THEN
     REWRITE_TAC[ALL2] THEN
     CONV_TAC(TOP_DEPTH_CONV BETA_CONV) THEN
     REPEAT CONJ_TAC THEN TRY (FIRST_ASSUM ACCEPT_TAC) THEN
     TRY (ASM_MESON_TAC[SUBSET_TRANS; GEN_ALL all_ts_CONS_SUBSET]) THEN
     TRY (ASM_MESON_TAC[blocks_unique_SUBSET;
                        GEN_ALL all_vs_MutBlock_centre]) THEN
     REPEAT STRIP_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
     ASM_MESON_TAC[GEN_ALL reachable_refs_MutBlock_centre]))
