#!/bin/sh
# quotes <session> <mlfile> : parse the quotations of an ml file of
# the port one by one in a session (which may have the file loaded
# already) and report the ones that do not parse, in tmp/mark.txt
PATH=/home/freek/claude/hol-light/bin:/home/freek/claude/hol-light/cakeml/tools/bin:$PATH
C=/home/freek/claude/hol-light/cakeml
s="$1"
f="$2"
case "$f" in /*) ;; *) f="$C/ml/$f";; esac
python3 -I $C/tools/quotes.py "$f" $C/tmp/quotes.ml > /dev/null
: > $C/tmp/mark.txt
TIMEOUT=${TIMEOUT:-1800} repl-step $s "#use \"$C/tmp/quotes.ml\";;" \
  > /dev/null 2>&1
cat $C/tmp/mark.txt
