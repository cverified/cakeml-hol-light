#!/bin/sh
# runbase : a session hol-runbase that holds the files of the load
# order up to the last definition theory, for tools/bin/fastrun to
# clone.
#
# A run loads the whole load order from cold and takes an hour and
# a quarter, and the first 180 files of it -- every file of
# ml/lib, every definition theory, and the five proof theories
# that a definition theory needs (targetSem needs evaluateProps
# and asmProps) -- are 57 minutes of that.  Those files do not
# change while a round of statement fixes goes on, so this holds
# them once and fastrun clones it: the inner loop is then the 90
# proof theories and about half an hour.
#
# A clone is a fork and costs the parent's heap again (the port is
# 1.1 GB live), so there is room for this and one clone and no
# more: kill the working sessions first.
#
# This is NOT the authority.  A run from cold (tools/bin/runall)
# is, because a base cannot report a regression in what it already
# holds.  Rebuild it after any change to ml/lib or to a definition
# theory, and finish a round with a cold run.
C=/home/freek/claude/hol-light/cakeml
PATH=/home/freek/claude/hol-light/bin:$C/tools/bin:$PATH
cd $C
. tools/holenv.sh > /dev/null 2>&1
[ -f tmp/cs.out ] && grep -q FINISHED tmp/cs.out || {
  tmux has -t hol-seq 2> /dev/null && {
    echo "runbase: a run is going (hol-seq); not now"; exit 1; }; }
python3 -I tools/loadorder.py > tools/load.txt
python3 -I - > tmp/runbase-files.txt <<'PY'
load = [l.strip() for l in open('tools/load.txt') if l.strip()]
isp = lambda f: '/proofs/' in f or 'Proof' in f or 'Props' in f
last = max(i for i, f in enumerate(load) if not isp(f))
print('\n'.join(load[:last + 1]))
PY
n=$(wc -l < tmp/runbase-files.txt)
echo "runbase: $n files of the load order into hol-runbase"
repl-kill runbase > /dev/null 2>&1
: > tmp/unstated-base.txt
cp tmp/unstated-base.txt tmp/unstated.txt
MARK=1 TOLERANT=1 CSSESSION=runbase TIMEOUT=${TIMEOUT:-900} \
  checkseq $(cat tmp/runbase-files.txt) > tmp/cs-base.out 2>&1
cp tmp/unstated.txt tmp/unstated-base.txt
date +%s > tmp/runbase-stamp.txt
f=$(grep -cE 'Exception|Error:|TOO SLOW' tmp/cs-base.out)
echo "runbase: $n files, $f failures, $(wc -l < tmp/unstated-base.txt) unread"
[ "$f" = 0 ] || echo "runbase: the base has failures; fastrun on it is blind to them"
