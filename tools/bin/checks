#!/bin/sh
# checks : the checks of the port that do not need a session, so
# that a cycle can run them after every re-port
#   coverage  every definition of every ported source has a port
#   fidelity  no name of a definition is missing from its port
#   literals  the strings and the numerals of a definition survive
#   lets      a let that binds a function abstracts its arguments
#   lines     no line of ml/ is longer than 72 characters
C=/home/freek/claude/hol-light/cakeml
cd $C
echo "=== coverage"
python3 -I tools/coverage.py 2>&1 | tail -3
echo "=== fidelity"
python3 -I tools/fidelity.py 2>&1 | tail -3
echo "=== literals"
python3 -I tools/literals.py 2>&1 | tail -3
echo "=== a let that binds a function without abstracting it"
# HOL Light takes the left hand side of a let binding for a
# pattern, so a function that a let binds needs an abstraction
grep -rnoE '(^|[^a-zA-Z_0-9])let [a-zA-Z_][a-zA-Z_0-9'"'"']*( [a-zA-Z_][a-zA-Z_0-9'"'"']*)+ =' \
  ml --include='*.ml' | grep -vE 'let (val|fun) ' | head -5
echo "=== lines over 72 characters"
find ml -name '*.ml' |
  xargs awk 'length>72 {print FILENAME" "FNR": "length}' | head -5
