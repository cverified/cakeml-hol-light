#!/bin/sh
# checks : the checks of the port that do not need a session, so
# that a cycle can run them after every re-port
#   coverage  every definition of every ported source has a port,
#             and every theorem of one that the port does not
#             state has a pointer that names it
#   fidelity  no name of a definition is missing from its port
#   literals  the strings and the numerals of a definition survive
#   lets      a let that binds a function abstracts its arguments
#   nohol4    no HOL4 code is in the port, not even in a comment
#   overloads every Overload and every Type of a source has a
#             counterpart in the port (one of HOL Light or a
#             pointer at the source)
#   libnames  a name of HOL4's own libraries that a statement uses
#             and that the port has not (a free variable then)
#   stmtnames every constant of a statement of a source is in the
#             statement that the port has for it
#   comments  every comment of a source is in its port, or a
#             pointer says where the code in it is
#   order     the blocks of a port are in the order of the source
#   attrs     a statement has the attributes of its theorem
#   stmtshape a statement has the connectives of the source's
#   defshape  a definition has the connectives of the source's
#   freenames a name of the shape of an accessor that the port
#             has no constant of (needs tools/constants.txt)
#   lines     no line of ml/ outside a comment is longer than 72
#             characters (a comment of a source is unaltered)
#   stale     every entry of an override table still names a
#             block that the source it is about has
#   proofs    every proof of proofs/ names a theorem that the port
#             states, and no line of one is over 72 characters
C=/home/freek/claude/hol-light/cakeml
cd $C
echo "=== coverage"
python3 -I tools/coverage.py 2>&1 | tail -3
echo "=== fidelity"
python3 -I tools/fidelity.py 2>&1 | tail -3
echo "=== literals"
python3 -I tools/literals.py 2>&1 | tail -3
echo "=== lets"
python3 -I tools/lets.py 2>&1 | tail -3
echo "=== HOL4 code in the port"
python3 -I tools/nohol4.py 2>&1 | tail -4
echo "=== the overloads and the types of the sources"
python3 -I tools/overloads.py 2>&1 | tail -2
echo "=== the names of HOL4's libraries that the port has not"
python3 -I tools/libnames.py 2>&1 | head -1
echo "=== the constants of the statements"
python3 -I tools/stmtnames.py 2>&1 | tail -2
echo "=== the comments of the sources"
python3 -I tools/comments.py 2>&1 | tail -2
echo "=== the order of the blocks"
python3 -I tools/order.py 2>&1 | tail -3
echo "=== the attributes of the statements"
python3 -I tools/attrs.py 2>&1 | tail -3
echo "=== the connectives of the statements"
python3 -I tools/stmtshape.py 2>&1 | tail -3
echo "=== the connectives of the definitions"
python3 -I tools/defshape.py 2>&1 | tail -3
echo "=== the names that look like an accessor"
python3 -I tools/freenames.py 2>&1 | tail -4
echo "=== lines over 72 characters"
python3 -I tools/lines.py 2>&1 | tail -6
echo "=== the entries of the override tables"
python3 -I tools/stale.py 2>&1 | tail -3
echo "=== the proofs of phase three"
python3 -I tools/proofs.py 2>&1 | tail -2
