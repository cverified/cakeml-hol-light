#!/bin/sh
# abstract [session] [file] : load the port into a session as an
# abstract -- every definition makes its constant and assumes its
# equations, every induction theorem is its statement assumed, and
# every proof is skipped.  About ten minutes against the two hours
# a real load takes.
#
# With a file (a path as tools/load.txt writes it) it stops in
# front of that one and does not load it, which is how to develop
# a proof of it: the port it stands on is there in a few minutes,
# and the file itself is then loaded for real.  The ways of making
# a definition and prove get their own names back there
# (ml/lib/real.ml), so what is loaded after that is proved.
#
# With TOLERANT=1 a statement that HOL Light does not read is
# logged and the file goes on, so one bad statement does not take
# the files after it with it.
#
# NOTHING IS PROVED in such a session, and length (axioms ()) says
# nothing about the port while it is on.  It is for developing the
# next proof against the port, and for reading a statement; what
# makes it safe to rely on is that the statements are the same
# terms either way (ml/lib/fast.ml).
C=/home/freek/claude/hol-light/cakeml
PATH=/home/freek/claude/hol-light/bin:$C/tools/bin:$PATH
. $C/tools/holenv.sh > /dev/null 2>&1
s=${1:-abs}
upto=$2
repl-kill $s > /dev/null 2>&1
rm -f /home/freek/claude/hol-light/bin/fifo/hol-$s
repl-clone hol-template-cakeml $s > /dev/null 2>&1 || {
  echo "abstract: cannot clone the template"; exit 1; }
repl-step $s "loadt \"$C/ml/lib/fast.ml\";;" > /dev/null 2>&1
python3 -I $C/tools/loadorder.py > $C/tools/load.txt
for f in $(cat $C/tools/load.txt); do
  [ -n "$upto" ] && [ "$f" = "$upto" ] && break
  g=$C/ml/$f
  h=$g
  # a statement that HOL Light does not read would stop the file
  # and every file that needs it, which is the whole point of an
  # abstract gone: with TOLERANT=1 each theorem is loaded in a try
  # and the file goes on, as a harvest does (tools/bin/checkseq)
  # its own copy, not tmp/locate.ml: a run writes that one, and a
  # run may be going while this is
  [ "$TOLERANT" = 1 ] && {
    python3 -I $C/tools/tolerant.py "$g" $C/tmp/abstract-$s.ml \
      > /dev/null
    h=$C/tmp/abstract-$s.ml; }
  TIMEOUT=${TIMEOUT:-300} repl-step $s "loadt \"$h\";;" \
    2>&1 | grep -E "Exception|Error in" | sed "s|^|$f: |"
  # the file was loaded under the name of the instrumented copy,
  # so it is registered under its own name, or a needs of it would
  # load it a second time
  [ "$TOLERANT" = 1 ] && repl-step $s \
    "loaded_files :=
       (Filename.basename \"$g\",Digest.file \"$g\") ::
         !loaded_files;;" > /dev/null 2>&1
done
# in front of a file the session goes back to proving, so that
# the file can be loaded for real
[ -n "$upto" ] && repl-step $s "loadt \"$C/ml/lib/real.ml\";;" \
  > /dev/null 2>&1
repl-step $s "print_string (\"ABSTRACT \" ^
  string_of_int (length (cake_defs ())) ^ \" definitions\n\");;" \
  2>&1 | tail -2
