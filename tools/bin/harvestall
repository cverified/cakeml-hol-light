#!/bin/sh
# harvestall : load the whole port with every theorem in a try, so
# that every statement HOL Light cannot read is logged to
# tmp/unstated.txt (and the files load on).  The report goes to
# tmp/cs.out, as a run's does.  This is a _run_: it takes over an
# hour, hol-seq is its session, and nothing may write into ml/
# while it goes.
C=/home/freek/claude/hol-light/cakeml
PATH=/home/freek/claude/hol-light/bin:$C/tools/bin:$PATH
cd $C
. tools/holenv.sh > /dev/null 2>&1
python3 -I tools/loadorder.py > tools/load.txt
: > tmp/unstated.txt
TOLERANT=1 MARK=1 TIMEOUT=${TIMEOUT:-240} \
  checkseq $(cat tools/load.txt) > tmp/cs.out 2>&1
echo FINISHED >> tmp/cs.out
