#!/bin/sh
# timings : write ml/TIMINGS.md from tools/checkseq.log
log=/home/freek/claude/hol-light/cakeml/tools/checkseq.log
out=/home/freek/claude/hol-light/cakeml/ml/TIMINGS.md
{
  echo "# How long the files of the port take to load"
  echo
  echo "Generated by \`tools/bin/timings\` from the last"
  echo "\`tools/bin/checkseq\` run (the time is the CPU time that the"
  echo "file itself takes, with everything it needs already loaded)."
  echo
  echo "| file | seconds | axioms | first failure |"
  echo "|---|---|---|---|"
  awk '{ f = $1;
         t = $2; gsub(/[(,]/, "", t);
         a = $3; gsub(/[),]/, "", a);
         e = "";
         for (i = 4; i <= NF; i++) e = e (i > 4 ? " " : "") $i;
         gsub(/\|/, "", e);
         tot += t;
         printf "| `%s` | %.2f | %s | %s |\n", f, t, a, e }
       END { printf "| **total** | **%.1f** | | |\n", tot }' "$log"
} > $out
echo "wrote $out"
