#!/bin/sh
# rebuild the hol-template-cakeml session from hol-base (and hol-base
# itself if it is gone), and report any error in the preamble
# A clone is a fork of the session it comes from, so killing one
# kills its clones: rebuilding the template takes the whole tree
# with it, and the frontier (8 to 94 minutes of loading) with it.
# KEEP=1 leaves the other sessions alone -- what to do when only a
# tactic or a lemma changed, which tools/bin/reload puts into a
# running session in a second.
PATH=/home/freek/claude/hol-light/bin:/home/freek/claude/hol-light/cakeml/tools/bin:$PATH
[ -z "$KEEP" ] && holclean > /dev/null 2>&1
tmux has -t hol-base 2> /dev/null || {
  rm -f /home/freek/claude/hol-light/bin/fifo/hol-base
  repl-new-template base > /dev/null 2>&1; }
repl-kill template-cakeml > /dev/null 2>&1
rm -f /home/freek/claude/hol-light/bin/fifo/hol-template-cakeml
repl-clone hol-base template-cakeml > /dev/null 2>&1 || {
  echo "retemplate: cannot clone hol-base"; exit 1; }
TIMEOUT=900 repl-step template-cakeml \
  'loadt "/home/freek/claude/hol-light/cakeml/ml/lib/preamble.ml";;' \
  > /dev/null 2>&1
tmux capture-pane -p -J -S - -t hol-template-cakeml |
  sed -e 's/\x1b\[[0-9;?]*[a-zA-Z]//g' -e 's/\r//g' |
  grep -B3 -E '^(Error|Exception)' | head -12
