#!/bin/sh
# thms [session] : the theorems of phase two that the session
# (hol-seq by default) has, the ones whose statement the port
# cannot state yet, and the ones whose statement uses the name of
# a record field for a variable of its own
PATH=/home/freek/claude/hol-light/bin:/home/freek/claude/hol-light/cakeml/tools/bin:$PATH
C=/home/freek/claude/hol-light/cakeml
s=${1:-seq}
TIMEOUT=180 repl-step $s \
  "let cake_out = open_out \"$C/tmp/unstated.txt\" in
   do_list (fun (n,w) ->
     output_string cake_out (n ^ \"\\t\" ^ w ^ \"\\n\"))
     (cake_unstated ());
   close_out cake_out;
   (length (cake_theorems ()), length (cake_unstated ()),
    length (cake_fieldvars ()));;" \
  2>&1 | tail -2
python3 -I $C/tools/thms.py
