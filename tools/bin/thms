#!/bin/sh
# thms [file of the port] : how many theorems the port states and
# how many of them still have a cheat for a proof.  The shape of a
# theorem is HOL Light's (let foo = prove (`...`, tac);;), so this
# is a count of the files and needs no session.
C=/home/freek/claude/hol-light/cakeml
python3 -I $C/tools/thms.py "$@"
