#!/bin/sh
# checkseq <file>... : load the files one after the other in one
# session and report the time, the axioms and the first failure of
# each; the session hol-seq stays, so a run can be continued
PATH=/home/freek/claude/hol-light/bin:/home/freek/claude/hol-light/cakeml/tools/bin:$PATH
C=/home/freek/claude/hol-light/cakeml
ML=$C/ml
s=seq
log=/home/freek/claude/hol-light/cakeml/tools/checkseq.log
[ "$KEEP" = 1 ] && tmux has -t hol-$s 2> /dev/null || {
  repl-kill $s > /dev/null 2>&1
  rm -f /home/freek/claude/hol-light/bin/fifo/hol-$s
  repl-clone hol-template-cakeml $s > /dev/null 2>&1 || {
    echo "checkseq: cannot clone the template"; exit 1; }
  # with CAKE_TIMEOUT the definitions get another budget than the
  # thirty seconds of the library: a run that only has to say
  # which files fail is much faster with a small one
  [ -n "$CAKE_TIMEOUT" ] && repl-step $s \
    "cake_timeout := $CAKE_TIMEOUT;;" > /dev/null 2>&1
  : > $log; : > $C/tools/conjfail.log; }
for f in "$@"; do
  case "$f" in /*) g="$f";; *) g="$ML/$f";; esac
  repl-step $s "let cake_t0 = Sys.time();; print_string \"CHECKSEQ\";;" \
    > /dev/null 2>&1
  # with MARK=1 the file is loaded with a marker before every
  # phrase, so that the report says which phrase fails
  h="$g"
  nph=
  [ "$MARK" = 1 ] && {
    nph=$(python3 -I $C/tools/locate.py "$g" $C/tmp/locate.ml)
    : > $C/tmp/mark.txt
    h=$C/tmp/locate.ml; }
  # a file that takes too long is interrupted, so that the session
  # is free for the files after it
  slow=
  TIMEOUT=${TIMEOUT:-1800} repl-step $s "loadt \"$h\";;" 2>&1 |
    grep -qi timeout && slow=yes
  [ -n "$slow" ] && { repl-int $s > /dev/null 2>&1; sleep 1; }
  # the file was loaded under the name of the instrumented copy, so
  # it is registered under its own name, or the files that need it
  # would load it a second time
  [ "$MARK" = 1 ] && repl-step $s \
    "loaded_files :=
       (Filename.basename \"$g\",Digest.file \"$g\") ::
         !loaded_files;;" > /dev/null 2>&1
  TIMEOUT=120 repl-step $s \
    "(Sys.time() -. cake_t0,length(axioms()));;" > /dev/null 2>&1
  # -J joins the lines that the pane wrapped, so that a long path
  # in an error message is not cut in two
  # only what follows the LAST marker belongs to this file: the
  # scrollback of the pane holds the output of the files before it
  # as well
  out=$(tmux capture-pane -p -J -S - -t hol-$s |
        sed -e 's/\x1b\[[0-9;?]*[a-zA-Z]//g' -e 's/\r//g' |
        awk '/CHECKSEQ/ { b = "" } { b = b $0 "\n" }
             END { printf "%s", b }')
  r=$(printf '%s' "$out" |
      grep -oE '\(?[0-9]+(\.[0-9]+)?(e-[0-9]+)?, *[0-9]+\)?' | tail -1)
  # an error of a file that this one needs was reported when that
  # file was checked, so only the errors of this file are kept
  e=$(printf '%s' "$out" |
      python3 -I $C/tools/cserr.py "$h")
  [ "$MARK" = 1 ] && [ -n "$e" ] && \
    e="$e [at $(tail -1 $C/tmp/mark.txt) of $nph]"
  # the clauses that did not fit together are a bug of the port,
  # so they are logged (the report only has room for the first
  # failure of a file)
  printf '%s' "$out" | grep '^cake_conj_list failed' |
    sed "s|^|$f: |" >> $C/tools/conjfail.log
  [ -n "$slow" ] && e="TOO SLOW (interrupted) $e"
  printf '%-44s %-24s %s\n' "$f" "$r" "$e" | tee -a $log
  # the scrollback is cleared after every file: one that grows
  # with the run makes the capture slower than the file itself
  tmux clear-history -t hol-$s 2> /dev/null
done
