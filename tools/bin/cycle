#!/bin/sh
# cycle : everything between two runs, in the order in which it
# has to happen.  Run it when a run has finished (hol-seq holds
# its state) and it leaves a fresh run going.
#   1 the reports of the run that finished (they talk to hol-seq,
#     so they go before the retemplate), and the table of the
#     arguments of the constants whose type is int
#   2 the cheat list from ml/CHEATS.md, which says where the port
#     writes a CHEAT_TAC
#   3 the port, with that list
#   4 the checks that need no session
#   5 the template (the library layer may have changed) and the
#     smoke test on it
#   6 the next run
# With NORUN=1 it stops after the smoke test, which is what to use
# when the port still has to be changed before the next run.
# It clones the session of the run to hol-try first, which the
# reports can then not lose (tools/bin/diag try, S=try
# tools/bin/trydef) -- but a clone is a child of the process it is
# forked from, so the retemplate of step 5 takes hol-try with
# hol-seq and the template: a diagnosis that needs the port
# loaded has to happen BEFORE the cycle (or between its steps).
B=/home/freek/claude/hol-light
PATH=$B/bin:$B/cakeml/tools/bin:$PATH
C=/home/freek/claude/hol-light/cakeml
cd $C
. tools/holenv.sh > /dev/null 2>&1
ps -eo args --no-headers | grep -q '[c]heckseq' && {
  echo "cycle: a run is going"; exit 1; }
# the reports are heavy enough to lose the session of the run
# (hol-seq died of the free variables once), and the next run
# kills it, so the cycle always keeps a clone of it
# a clone of the session of the run, which the reports cannot
# lose: tools/bin/diag and tools/bin/trydef take it (S=try).  The
# retemplate below does take it, so a diagnosis goes before the
# cycle
repl-kill try > /dev/null 2>&1
rm -f /home/freek/claude/hol-light/bin/fifo/hol-try
repl-clone hol-seq try > /dev/null 2>&1 &&
  echo "hol-try is a clone of the session of the run"
echo "=== the reports of the run"
postrun > tmp/report.txt 2>&1
sed -n '/=== axioms and cheats/,/=== timings/p' tmp/report.txt |
  head -14
sed -n '/=== clauses that do not typecheck apart/,/=== types/p' \
  tmp/report.txt | head -8
echo "=== the integer arguments of the constants"
# the table that says which argument of a constant is an int (a
# numeral there is &n), out of the session of the run, which has
# the port loaded; it has to happen before the retemplate
intargs
echo "=== the cheat list"
python3 -I tools/mkcheats.py > tmp/cheats.txt 2> tmp/mkcheats.err
cat tmp/mkcheats.err
mv tmp/cheats.txt tools/cheats.txt
echo "=== the port"
python3 -I tools/portall.py 2>&1 | grep -E 'FAILED|files,|prefaces'
python3 -I tools/loadorder.py > tools/load.txt
checks
echo "=== the template and the smoke test"
retemplate
repl-kill smoke > /dev/null 2>&1
repl-clone hol-template-cakeml smoke > /dev/null 2>&1
TIMEOUT=600 repl-step smoke \
  "loadt \"$C/tools/smoke.ml\";;" > /dev/null 2>&1
tmux capture-pane -p -t hol-smoke -S -40 |
  grep -E 'SMOKEALL|SMOKECHEAT|SMOKETHM|SMOKEVARS|SMOKELIB|Exception|Error' |
  tail -6
[ "$NORUN" = 1 ] && exit 0
echo "=== the next run"
nohup env TIMEOUT=900 CAKE_DEBUG=1 runall \
  > tmp/run.log 2>&1 &
sleep 10
ps -eo args --no-headers | grep -q '[c]heckseq' &&
  echo "the run of $(date -u +%H:%M) is going"
