#!/bin/sh
# verifyfile <file of the port> [prefix] : load the file in a
# closure built fresh from the template, in the file's own needs
# order, and say what it costs.  The prefix is the one that the
# file's constants have, for the count of its own axioms (the
# default is the file's name).  No retemplate: when ml/lib has
# changed, run tools/bin/retemplate first, or the clone is of a
# template that still holds the old one.
C=/home/freek/claude/hol-light/cakeml
. $C/tools/holenv.sh
f="$1"
case "$f" in /*) ;; *) f="$C/ml/$f";; esac
p="${2:-$(basename "$f" .ml)_}"
date +%s > $C/tmp/vstart.txt
grep '^needs "' "$f" > $C/tmp/pfprefix.ml
repl-kill pfv > /dev/null 2>&1
repl-clone hol-template-cakeml pfv > /dev/null 2>&1
TIMEOUT=5400 repl-step pfv "#use \"$C/tmp/pfprefix.ml\";;" \
  > /dev/null 2>&1
echo "CLOSURE $(( $(date +%s) - $(cat $C/tmp/vstart.txt) ))s"
cat > $C/tmp/vfile.ml <<ML
let a0 = length(axioms());;
loadt "$f";;
print_string ("AXIOMS-ADDED " ^ string_of_int (length(axioms()) - a0)
              ^ "\n");;
print_string ("FIELDVARS " ^ string_of_int (length(cake_fieldvars ()))
              ^ "\n");;
let pre p t = is_const t &&
  (let n = fst(dest_const t) in
   String.length n > String.length p &&
   String.sub n 0 (String.length p) = p);;
print_string ("OWN-AXIOMS " ^ string_of_int (length
  (filter (fun th -> can (find_term (pre "$p")) (concl th))
          (axioms()))) ^ "\n");;
ML
TIMEOUT=1800 repl-step pfv "#use \"$C/tmp/vfile.ml\";;" \
  > /dev/null 2>&1
while ! tmux capture-pane -p -J -S - -t hol-pfv |
      grep -qE 'OWN-AXIOMS|Error'
do sleep 20; done
tmux capture-pane -p -J -S - -t hol-pfv |
  sed -e 's/\x1b\[[0-9;?]*[a-zA-Z]//g' -e 's/\r//g' |
  grep -E 'AXIOMS-ADDED|FIELDVARS|OWN-AXIOMS|NOT PROVED|NOT STATED|CHEATED|Error|Warning' |
  tail -14
echo "verify: $(( $(date +%s) - $(cat $C/tmp/vstart.txt) ))s"
